        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[--!strict
-- A new player's first match (2026-10-04: an updated tutorial for new players, designed for phones
-- first, since 90% of the players are on a phone, with its steps drawn from the analytics funnels).
-- The onboarding funnel of the 28 days before it (202,158 new players):
--
--   Joined 100% -> Title 99% -> Match Started 85% -> Spawned 81% -> First Attack 66%
--   -> Survived 3 Min 32% -> Survived 10 Min 24% -> Second Match 21%
--
--   * 14% never start a match: the first match starts by itself, on this device, at once;
--   * 5% never pick a start: a spot is pointed out, and taken for them after AUTO_SPAWN_S;
--   * 19% spawn and never attack: the first step is the first tap, with the place to tap marked;
--   * half of those who attack are gone within 3 minutes, while the AI may not even attack them
--     yet (Rules.HUMAN_GRACE_TICKS): they leave with nothing to do. So the first minutes are a list
--     of small goals with a reward at the end, on a match with fewer tribes in the way (TRIBES)
--     and the gentlest AI (DIFFICULTY).
--
-- The match is an ordinary solo match otherwise: it goes on after the last step. client/UI/Tutorial
-- runs the steps; server/Analytics logs them as the "Tutorial" funnel (FUNNEL); the Stars are paid
-- once per player (server/Purchases.tutorial_bonus).
local Tutorial = {}

--- Stars for finishing it (5% of the cheapest Arsenal unlock: the bar on its card moves).
Tutorial.STARS = 1000
--- Tribes on the tutorial's map (a normal match has Rules.DEFAULT_TRIBES, 400): room to grow fast.
Tutorial.TRIBES = 60
Tutorial.DIFFICULTY = 0
--- Ticks (10 a second) from placing the capital to the match starting. A solo match waits 50, but
--- (2026-10-04) a 5 s wait after placing the capital confused new players, so the tutorial's round
--- starts much sooner.
Tutorial.COUNTDOWN_TICKS = 10
--- The Attack bar while the tutorial runs: it starts at the default and stops at RATIO_CAP (the
--- player's saved setting could leave it at about 85%, which is too much; 2026-10-04).
Tutorial.RATIO_CAP = 0.5
--- Keeps players from going too low in troop count (2026-10-04): while the tutorial
--- runs an order leaves at least TROOP_FLOOR of the army's cap at home (it is trimmed to what may go,
--- and refused when nothing may). The floor holds from the first time the army reaches FLOOR_ARM of
--- its cap (a new nation starts below it), or from FLOOR_ARM_S seconds into play, whichever comes
--- first (floor_armed).
---   * The seconds since 2026-10-27: a new nation starts at about a fifth of its cap, so a player who
---     sent every troop as it came never reached FLOOR_ARM, and the floor never held for the very
---     players it is for.
---   * Not before the FLOOR_FROM step (2026-10-27): on "grow" it refused taps the card asked for
---     ("Troops low. Let them grow back" under the card's "Keep tapping empty land to grow"), since
---     the cap climbs with every tile taken. Grow lost 11.6% of the players who reached it, the most
---     of any step, and 110,302 of its 175,898 left with Skip (the week to 2026-10-26). Before the
---     first neighbour there is nobody to fear, and the Attack bar's cap (RATIO_CAP) still holds.
Tutorial.TROOP_FLOOR = 0.25
Tutorial.FLOOR_ARM = 0.35
Tutorial.FLOOR_ARM_S = 10
Tutorial.FLOOR_FROM = "attack"
Tutorial.FLOOR_REASON = "Troops low. Let them grow back"
--- A new player's first ROOKIE_MATCHES matches (the tutorial's among them) keep a floor under the
--- army after the tutorial too (2026-10-27): an order leaves ROOKIE_FLOOR of the army's cap at home,
--- from the time it arms (floor_armed; client/UI/UIAdvisor.check_floor). An army
--- spent below a fifth of its cap all but loses the match, and 23% of matches ended within their
--- first 3 minutes (Match funnel, the week to 2026-10-26). The first order held back in a match
--- says why (Coach "floor").
Tutorial.ROOKIE_MATCHES = 5
Tutorial.ROOKIE_FLOOR = 0.2

--- True while a player with `matches_before` matches before this one is still a new player.
function Tutorial.rookie(matches_before: number): boolean
	return matches_before < Tutorial.ROOKIE_MATCHES
end

--- True once the floor under a new player's army holds: the army has `troops` of its `cap`, at
--- FLOOR_ARM of it or more, or the match has been played `played_s` seconds, FLOOR_ARM_S or more.
function Tutorial.floor_armed(troops: number, cap: number, played_s: number): boolean
	return played_s >= Tutorial.FLOOR_ARM_S or (cap > 0 and troops >= Tutorial.FLOOR_ARM * cap)
end
--- Seconds on the spawn step before a start is picked for the player.
Tutorial.AUTO_SPAWN_S = 12
--- "grow": one expansion, and the card teaches the rhythm: let the troops refill, then expand. Never
--- "keep tapping" (2026-10-27: the card said "Keep tapping empty land to grow", which is bad advice:
--- an order sent on an emptied army leaves the nation open, and a small army regrows slowly). While
--- the army is under GROW_READY of its cap the card says to let the troops refill, its bar fills
--- towards ready (Tutorial.refill: about 7 s after the "expand" step's order on open land) and the
--- mark is on the troop count; once ready it asks for the expansion. One sent before the bar is full
--- counts too, and its green card says `early` (let the bar fill next time) for EARLY_S.
---   * v111 (2026-10-27) asked for GROW_TAPS = 2 expansions sent ready, and 3x the land, with no bar
---     while the troops refilled: Skip on this step went up by about 60% a match (06:00-16:00 UTC
---     against the day before).
---   * v112 (2026-10-27) asked for one, sent with the bar full; one sent before spent the refill and
---     did not count. Of the players who made the first tap, 79% finished the step (88% before
---     v111) and 58% finished the tutorial (63%) (Tutorial funnel, Oct 28-29 against Oct 24-26):
---     a wait the player can't get past loses them. So since 2026-10-30 the wait is advice.
Tutorial.GROW_TAPS = 1
Tutorial.GROW_READY = 0.3
Tutorial.EARLY_S = 2.0
--- "attack": passed over when nobody borders the player this long after the step began.
Tutorial.CONTACT_WAIT_S = 25
--- The Attack bar's step asks for one stop of it, RATIO_GOAL (the next one up from where the bar
--- starts), left there for RATIO_HOLD_S: one tap on the stop the mark points at. Never more: since
--- 2026-10-04 the tutorial never encourages a 100% attack (an attack with everything leaves the
--- nation empty). Above RATIO_HIGH the card says to go back.
---   * Until 2026-10-08 it asked for 27% to 45% of a slider that ran from 1% to 100%, held for half
---     a second: on a phone that was 17 px of a 96 px track. 19.4% of the players who reached the
---     step left on it, the most of any step (Tutorial funnel, 2026-10-07), so the
---     step was made easier.
---   * Nobody waits on it past RATIO_MAX_S (the other steps: STEP_MAX_S).
Tutorial.RATIO_GOAL = 0.35
Tutorial.RATIO_LOW = 0.3
Tutorial.RATIO_HIGH = 0.4
Tutorial.RATIO_HOLD_S = 0.2
Tutorial.RATIO_MAX_S = 30
Tutorial.RATIO_TOO_MUCH = "Too many! Tap 35%"
--- A step nobody finishes in this long is passed over (the player is never stuck on one).
Tutorial.STEP_MAX_S = 75
--- With no order for this long the pointer shows where to tap again.
Tutorial.NUDGE_S = 5

--- The steps, in order. `touch` / `desktop`: what the card says; `%s` is the neighbour's name.
Tutorial.STEPS = {
	{ id = "spawn", touch = "Tap the map to start your nation", desktop = "Click the map to start your nation" },
	{ id = "expand", touch = "Tap the land next to you to take it", desktop = "Click the land next to you to take it" },
	{
		id = "grow",
		touch = "Tap empty land to expand",
		desktop = "Click empty land to expand",
		wait = "Now let your troops refill",
		-- (the green card of an expansion sent while they refilled)
		early = "Done! Next time, let the bar fill",
		bar = true,
	},
	-- (the neighbour before the slider: a first attack at the slider's 20% leaves an army at home; in
	-- the first order of steps a new player dragged it to 100% and sent everything)
	{
		id = "attack",
		touch = "Tap %s, then tap again to attack",
		desktop = "Click %s's land to attack them",
	},
	{
		id = "ratio",
		touch = "Tap 35% below. Keep troops home!",
		desktop = "Click 35% on the Attack bar. Keep troops home!",
		max_s = Tutorial.RATIO_MAX_S,
	},
	{
		id = "city",
		touch = "Open BUILD, pick City, tap your land",
		desktop = "Pick City (1) and click your land",
		note = "Here is gold for your first City",
	},
}

--- The "Tutorial" funnel's steps (Creator Dashboard): 1 is the match starting, then one a step,
--- then finishing. A step passed over is not logged.
Tutorial.FUNNEL = { "Started", "Spawned", "First Tap", "Grew", "Attacked", "Used Slider", "Built City", "Completed" }

--- The funnel step of finishing step `id` (2..7), or nil.
function Tutorial.funnel_step(id: string): number?
	for i, s in Tutorial.STEPS do
		if s.id == id then
			return i + 1
		end
	end
	return nil
end

--- True for a player who has never played: no tutorial state, no match counted, no tip seen.
--- `ui` is the saved [ui] settings, `stats` the saved [stats] ({ matches }).
function Tutorial.is_new(ui: any, stats: any): boolean
	local u = if type(ui) == "table" then ui else {}
	local s = if type(stats) == "table" then stats else {}
	if type(u.tutorial) == "string" and u.tutorial ~= "" then
		return false
	end
	if (tonumber(s.matches) or 0) > 0 then
		return false
	end
	if type(u.tips_seen) == "table" and next(u.tips_seen) ~= nil then
		return false
	end
	return true
end

--- "grow"'s bar while the army refills: how far `troops` are towards GROW_READY of `cap` (0..1), and
--- never below `shown` (what the bar already shows): the cap climbs as the expansion's land comes in,
--- and a bar that slides back while nobody did anything reads as broken. (An order sent meanwhile
--- does empty it: the client passes no `shown` then.)
function Tutorial.refill(troops: number, cap: number, shown: number?): number
	local need = Tutorial.GROW_READY * cap
	local f = if need > 0 then math.clamp(troops / need, 0, 1) else 1
	return math.max(f, shown or 0)
end

--- Where step `id` is in STEPS, or nil.
function Tutorial.step_index(id: string): number?
	for i, s in Tutorial.STEPS do
		if s.id == id then
			return i
		end
	end
	return nil
end

return Tutorial
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="67">
        <Properties>
          <string name="Name">Net</string>
        </Properties>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Coop</string>
            <string name="Source"><![CDATA[--!strict
-- Cooperative time-slicing for long synchronous work (match construction, snapshot decoding).
--
-- session.gd built local matches on a WorkerThreadPool task so the UI never froze. Roblox gives game
-- scripts no worker threads for this, so the Session runs such work inside a Coop job: a coroutine that
-- is resumed once per frame with a time budget. Long loops call `Coop.check()` every few thousand
-- iterations; it yields back to the frame only when the job's budget is spent, and is a cheap no-op
-- outside a job (plain calls, Lune tests, the server).
--
--   local job = Coop.job(function() return build_match() end)
--   RunService.Heartbeat:Connect(function() if not job.done then job:step(0.004) end end)
--   -- job.done / job.ok / job.result (first return value) / job.err (message with traceback)

local Coop = {}

local clock = os.clock
local current: thread? = nil
local deadline = 0.0

--- Yields the running Coop job if its frame budget is spent. Safe to call from anywhere.
function Coop.check()
	if current ~= nil and clock() >= deadline and coroutine.running() == current then
		coroutine.yield()
	end
end

--- True when called from inside a Coop job (callers may pick a chunkier loop).
function Coop.active(): boolean
	return current ~= nil and coroutine.running() == current
end

export type Job = {
	done: boolean,
	ok: boolean,
	result: any,
	err: string?,
	slices: number,
	step: (self: Job, budget_s: number) -> boolean,
	finish: (self: Job) -> (),
}

local Job = {}
Job.__index = Job

function Coop.job(fn: (...any) -> any, ...: any): Job
	local args = table.pack(...)
	local self: any = setmetatable({ done = false, ok = false, result = nil, err = nil, slices = 0 }, Job)
	self._co = coroutine.create(function()
		local ok, res = xpcall(function()
			return fn(table.unpack(args, 1, args.n))
		end, function(e)
			return debug.traceback(tostring(e), 2)
		end)
		return ok, res
	end)
	return self
end

--- Runs the job for at most ~budget_s seconds (the current slice always finishes the check it is in).
--- Returns true once the job has finished (successfully or not).
function Job.step(self: any, budget_s: number): boolean
	if self.done then
		return true
	end
	local prev, prev_deadline = current, deadline
	current = self._co
	deadline = clock() + budget_s
	self.slices += 1
	local resumed, ok, res = coroutine.resume(self._co)
	current, deadline = prev, prev_deadline
	if coroutine.status(self._co) == "dead" then
		self.done = true
		if not resumed then
			self.ok = false
			self.err = tostring(ok)
		elseif ok then
			self.ok = true
			self.result = res
		else
			self.ok = false
			self.err = tostring(res)
		end
	end
	return self.done
end

--- Runs the job to completion synchronously (tests, or when the caller must block).
function Job.finish(self: any)
	while not self.done do
		self:step(math.huge)
	end
end

return Coop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">MapFetch</string>
            <string name="Source"><![CDATA[--!strict
-- Map data transfer. Terrain of the non-default maps lives on the server only
-- (ServerScriptService.AirfrontServer.MapData, ~19-54 MB for all of them — too much to replicate),
-- so a client that needs one (solo on another map, a multiplayer match on another map) asks the
-- server for it by id:
--
--   server: MapFetch.serve(net_folder, load_data)   -- RemoteFunction net_folder.GetMap
--   client: local ok, err = MapFetch.fetch(id)      -- yields; then WorldMap.get(id) works
--
-- Wire: InvokeServer(id, chunk) → { id, name, width, height, k_lin, nations, size, chunks, chunk }
-- where `chunk` is a buffer slice (CHUNK_BYTES) of the map's zstd-compressed tile bytes; the client
-- joins the slices and hands WorldMap the data (codec "zstd"). The default map (MapList.DEFAULT) is
-- replicated and never fetched. Maps already available locally return at once.
local MapFetch = {}

MapFetch.CHUNK_BYTES = 192 * 1024
--- Server: GetMap calls per player per 10 s.
MapFetch.MAX_CALLS_PER_10S = 60
MapFetch.REMOTE_NAME = "GetMap"

local function shared_root(): any
	return (game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront")
end

local function core(name: string): any
	return (require :: any)(shared_root():WaitForChild("Core"):WaitForChild(name))
end

-- =============================================================================================
-- Server
-- =============================================================================================

--- Creates the GetMap RemoteFunction under `folder` and answers it with `load_data(id)` (a map
--- data table as written by tools/maps/import_maps.py).
function MapFetch.serve(folder: Instance, load_data: (string) -> { [string]: any }?)
	local MapCodec = core("MapCodec")
	local MapList = (require :: any)(shared_root():WaitForChild("Data"):WaitForChild("MapList"))
	local rf = Instance.new("RemoteFunction")
	rf.Name = MapFetch.REMOTE_NAME
	rf.Parent = folder
	-- id → { meta = {...}, z = buffer (zstd bytes) }
	local cache: { [string]: any } = {}
	local calls: { [any]: { n: number, t: number } } = {}
	local function entry(id: string): any
		local e = cache[id]
		if e ~= nil then
			return e
		end
		local data = load_data(id)
		if type(data) ~= "table" or type(data.terrain) ~= "string" then
			return nil
		end
		local z = MapCodec.b64decode_luau(data.terrain)
		local nations = {}
		for i, n in data.nations or {} do
			nations[i] = { name = n.name, region = n.region, flag = n.flag, x = n.x, y = n.y }
		end
		e = {
			meta = {
				id = id,
				name = data.name,
				width = data.width,
				height = data.height,
				k_lin = data.k_lin,
				land_tiles = data.land_tiles,
				nations = nations,
				codec = if data.codec == "rle+base64" then "rle" else "zstd",
				size = data.size or (data.width * data.height),
			},
			z = z,
		}
		cache[id] = e
		return e
	end
	rf.OnServerInvoke = function(player: any, id: any, chunk: any): any
		if type(id) ~= "string" or MapList.get(id) == nil then
			return nil
		end
		local now = os.clock()
		local c = calls[player]
		if c == nil or now - c.t > 10 then
			c = { n = 0, t = now }
			calls[player] = c
		end
		c.n += 1
		if c.n > MapFetch.MAX_CALLS_PER_10S then
			return nil
		end
		local ok, e = pcall(entry, id)
		if not ok or e == nil then
			return nil
		end
		local zlen = buffer.len(e.z)
		local chunks = math.max(1, math.ceil(zlen / MapFetch.CHUNK_BYTES))
		local k = math.floor(tonumber(chunk) or 0)
		if k < 0 or k >= chunks then
			return nil
		end
		local from = k * MapFetch.CHUNK_BYTES
		local len = math.min(MapFetch.CHUNK_BYTES, zlen - from)
		local part = buffer.create(len)
		buffer.copy(part, 0, e.z, from, len)
		local out = table.clone(e.meta)
		out.chunks = chunks
		out.zsize = zlen
		out.chunk = part
		return out
	end
	(game :: any):GetService("Players").PlayerRemoving:Connect(function(p: any)
		calls[p] = nil
	end)
end

-- =============================================================================================
-- Client
-- =============================================================================================

local inflight: { [string]: { any } } = {}

--- Makes map `id` available to WorldMap.get (yields while downloading). Returns true, or false
--- and an error message.
function MapFetch.fetch(id: string): (boolean, string?)
	local WorldMap = core("WorldMap")
	-- a smaller build ("world@80") is made from its map's data
	id = (WorldMap.split_id(id))
	if WorldMap.available(id) then
		return true, nil
	end
	local waiting = inflight[id]
	if waiting ~= nil then
		-- Another caller is downloading it: wait for that one.
		table.insert(waiting, coroutine.running())
		return coroutine.yield()
	end
	inflight[id] = {}
	local ok, err = pcall(function()
		local folder = (game :: any):GetService("ReplicatedStorage"):WaitForChild("AirfrontNet", 30)
		local rf = folder and folder:WaitForChild(MapFetch.REMOTE_NAME, 30)
		if rf == nil then
			error("map service unavailable")
		end
		local first = rf:InvokeServer(id, 0)
		if type(first) ~= "table" or typeof(first.chunk) ~= "buffer" then
			error("server has no map '" .. id .. "'")
		end
		local z = buffer.create(first.zsize)
		buffer.copy(z, 0, first.chunk, 0, buffer.len(first.chunk))
		local at = buffer.len(first.chunk)
		for k = 1, first.chunks - 1 do
			local part = rf:InvokeServer(id, k)
			if type(part) ~= "table" or typeof(part.chunk) ~= "buffer" then
				error("map download interrupted")
			end
			buffer.copy(z, at, part.chunk, 0, buffer.len(part.chunk))
			at += buffer.len(part.chunk)
		end
		if at ~= first.zsize then
			error("map download size mismatch")
		end
		WorldMap.put_data(id, {
			id = id,
			name = first.name,
			width = first.width,
			height = first.height,
			k_lin = first.k_lin,
			land_tiles = first.land_tiles,
			nations = first.nations,
			size = first.size,
			codec = first.codec or "zstd",
			terrain = z,
		})
	end)
	local waiters = inflight[id] or {}
	inflight[id] = nil
	local msg = if ok then nil else tostring(err)
	for _, co in waiters do
		task.spawn(co, ok, msg)
	end
	return ok, msg
end

--- Starts downloading map `id` in the background (no-op when it is available or in flight).
function MapFetch.prefetch(id: string)
	id = string.match(id, "^(.-)@%d+$") or id
	if inflight[id] ~= nil then
		return
	end
	task.spawn(function()
		MapFetch.fetch(id)
	end)
end

return MapFetch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">Protocol</string>
            <string name="Source"><![CDATA[--!native
--!strict
-- Wire protocol for the multiplayer match: compact `buffer` encodings of Sim deltas, snapshots and
-- intents. Replaces session.gd's `var_to_bytes()` + zstd transport (DESIGN.md §9, PORT.md §9).
--
-- Every encoded message starts with an envelope byte:
--   0  raw        → body follows
--   1  zstd       → varuint raw_size, then EncodingService zstd frame of the body
-- `Protocol.compress(msg)` turns a raw message into a zstd one when that is worth it (> 1200 bytes, as
-- session.gd's COMPRESS_OVER_BYTES); `Protocol.open(msg)` undoes it. Without EncodingService (Lune, or
-- an engine without it) messages stay raw — every decoder handles both.
--
-- Primitive encodings: varuint = LEB128 (7 bits per byte, < 2^53); zz = zigzag varint for signed ints.
--
-- Generic values (events, snapshot rows, extra fields) are tagged:
--   0 nil  1 false  2 true  3 uint(varuint)  4 negint(varuint -v-1)  5 f64  6 string(varuint len+bytes)
--   7 array(varuint n, n values)  8 int array(varuint n, zz deltas from the previous element)
--   9 dense tile path(varuint n, varuint grid width, varuint first, (n-1) 4-bit step codes, then zz
--     deltas for escapes)
--   10 map(varuint n, n×(string key, value))  11 buffer(varuint len, bytes)  12 empty table
--   13 grid buffer RLE(u8 width 1|2|4, varuint cells, runs of (varuint value, varuint len))
--   14 int array RLE(varuint n, runs of (zz value, varuint len))
--   16..255 small uint 0..239 in the tag itself
-- Tile paths (units' water/road paths) are dense: each step moves to one of the 8 neighbours, so a
-- 4-bit code per step ((dy+1)*3 + dx+1, 15 = escape) makes them ~0.5 byte per tile. The map is a flat
-- grid of any size: the encoder needs its width (encode_delta's `grid_w`, the snapshot's map_w) and
-- writes it into each path; without it paths travel as plain int arrays (tag 8). Owner / flag grids
-- are recognised by the snapshot's map_w x map_h cell count (tag 13).
--
-- Delta body: u8 KIND_DELTA, u8 mask (1 tiles, 2 flags, 4 stats, 8 ev, 16 extra, 32 t), [varuint t],
--   tiles: u8 repr (0 table, 1 buffer of i32), varuint n, runs (varuint owner, varuint len, len × zz Δtile)
--   flags: same layout with (tile << 8 | flags) entries
--   stats: u8 repr, varuint n, n × zz
--   ev:    varuint n, n values (each event is an array value)
--   extra: map value with any other keys (future fields survive the trip)
-- Private events (MSG to one owner) travel in a per-recipient tail message so the shared delta is
-- encoded and compressed once per tick (session.gd re-encoded the whole delta per participant):
--   tail body: u8 KIND_TAIL, varuint n, n × (varuint position in the recipient's event list, value)
-- Snapshot body: u8 KIND_SNAPSHOT, then one map value (grids become tag 13/14 RLE automatically).
-- Intent body: u8 KIND_INTENT, u8 type index (INTENT_TYPES), u8 field mask, fields in mask order.

local Coop = require("./Coop")

local Protocol = {}

--- Owner ids are packed as tile * MAX_OWNERS + owner in tile lists.
local MAX_OWNERS = 1024
--- Upper bound for decoded grids / lists / tile indices (untrusted input guard): 16.7M cells.
local MAX_CELLS = 16777216
Protocol.MAX_CELLS = MAX_CELLS

Protocol.VERSION = 2
Protocol.COMPRESS_OVER_BYTES = 1200
Protocol.MAX_INTENT_BYTES = 128

Protocol.KIND_DELTA = 1
Protocol.KIND_SNAPSHOT = 2
Protocol.KIND_TAIL = 3
Protocol.KIND_INTENT = 4

--- RemoteEvent op codes (first argument of every ToServer / ToClient event).
Protocol.OP = {
	-- client → server
	HELLO = 1, -- client scripts are listening; start sending lobby info
	JOIN = 2, -- (display_name: string) queue for / join the match
	LEAVE = 3,
	INTENT = 4, -- (intent: buffer)
	SETTING = 5, -- (section: string, values: table) persist a per-player settings section (Net/Settings)
	RESYNC = 6, -- the client's mirror failed to decode / apply a delta: send me a fresh snapshot
	ACTIVE = 7, -- the player is at the controls (throttled; keeps watchers from being idle-dropped)
	JOIN_LOBBY = 8, -- (lobby_id: string) hub: teleport me to that public lobby's match server
	SPECTATE_LOBBY = 9, -- (lobby_id: string) hub: teleport me to that running match to watch it
	VOTE_START = 10, -- toggle my vote to start the waiting public match early
	ANALYTICS = 11, -- (kind: string, a, b, c) a milestone for the Creator Dashboard (server/Analytics)
	OPEN_CRATE = 13, -- open one bought crate (reply CRATE_RESULT; server/Purchases.open_crate)
	EQUIP = 14, -- (slot: "skin" | "flag", item_id: string | false) wear an owned cosmetic (or none)
	USE_CREDIT = 12, -- (kind: string, target: number?) spend one bought credit (Data/Products; reply
	-- CREDIT_RESULT); a public match's server takes over `target` for the player itself
	BUY_UNLOCK = 15, -- (key: string) unlock an Arsenal item with Stars (Data/Arsenal; reply UNLOCK_RESULT)
	SOLO_RESULT = 16, -- (report: table) a solo match's result, for its Stars (server/Rewards; reply STARS)
	SOLO_HOP = 17, -- (difficulty: number, map_id: string?) hub: I am starting a solo match and this server
	-- is outdated: teleport me to a fresh one to play it there (server/FreshServers; reply HOP_RESULT)
	NEW_PLAYER = 18, -- Rofront Staging / Studio, and game admins: make me a new player again (matches
	-- counted, the tutorial's Stars, the first crate's price); the settings and the inventory follow
	PARTY = 19, -- (action: "invite" | "accept" | "decline" | "leave" | "kick", user_id: number?) hub, team
	-- games on (ServerMain.team_games): server/Party (reply PARTY_STATE)
	-- server → client
	LOBBY = 20, -- (info: table)
	SNAPSHOT = 21, -- (owner_id: number, snapshot: buffer)
	DELTA = 22, -- (delta: buffer, tail: buffer?)
	NOTICE = 23, -- (text: string, severity: number)
	MATCH_CLOSED = 24, -- (reason: string)
	SETTINGS = 25, -- (settings: table) the player's saved settings
	LOBBIES = 26, -- (list: { {id, map, map_name, max, players, starts_in, joinable, live, elapsed, watchable} },
	-- kinds: { "ffa" | "team" | "world" }?) kinds: the public matches Quick Play offers here (JOIN_PUBLIC)
	JOIN_RESULT = 27, -- (ok: boolean, reason: string?) hub: a JOIN_LOBBY that did not teleport
	ADMIN_BOTS = 28, -- (bot_owner_ids: { number }) game admins only: which "players" are bot players
	CREDITS = 29, -- (credits: { [kind]: number }) the player's bought, unspent credits (server/Purchases)
	CREDIT_RESULT = 30, -- (kind: string, ok: boolean, reason: string?) a USE_CREDIT's answer
	OWNER_CHANGED = 31, -- (owner_id: number) public match: you now command this nation (a takeover)
	INVENTORY = 32, -- ({ owned = { id }, equipped = { skin?, flag? }, crates_bought, crates_allowed, stars,
	-- unlocks = { key }, starter = false | { state = "ready" } | { state = "active", left = s } })
	CRATE_RESULT = 33, -- (ok: boolean, item_id_or_reason: string) an OPEN_CRATE's answer
	COSMETICS = 34, -- ({ [owner_id] = { skin?, flag?, face? } }) the match's equipped cosmetics, whole map
	STARS = 35, -- ({ lines = { {key, amount} }, total, balance, double }) Stars paid for a match
	UNLOCK_RESULT = 36, -- (key: string, ok: boolean, reason: string?) a BUY_UNLOCK's answer
	HOP_RESULT = 37, -- (going: boolean) a SOLO_HOP's answer: true = the teleport is on its way, false =
	-- play here (no fresh server with room, or the teleport failed)
	PARTY_STATE = 38, -- ({ members = { {uid, name, leader} }, leader: boolean, invites = { {uid, name} },
	-- max }) the player's party (server/Party.state)
	-- Quick Play (2026-10-11; docs/lobby-service.md "Quick Play")
	JOIN_PUBLIC = 39, -- client → hub: (mode: "ffa" | "team" | "world" | false) a seat in the soonest public match of
	-- that kind (a party leader: for the party), or false to leave the line
	PUBLIC_STATE = 40, -- hub → client: (state: "joining" | "line" | "going" | "idle", mode: string?,
	-- info: { map, map_name }?) asking / waiting in line for a free seat / seated, on the way / neither
	STARTER_SEEN = 41, -- client → server: the starter pack's offer is on my screen: start its clock (once;
	-- server/Purchases.starter_seen; the INVENTORY that follows carries `starter`)
	GENERAL = 42, -- server → client: ({ on: boolean, given: { crate: boolean?, stars: number?, skin: string? }? })
	-- RoWorld General (Data/Subscription; server/General): subscribed or not, and what it just gave
}

Protocol.INTENT_TYPES = {
	"spawn",
	"attack",
	"boat",
	"build",
	"nuke",
	"retreat",
	"move_warship",
	"ally_request",
	"ally_reply",
	"ally_break",
	"donate",
	"ally_extend", -- {target}: ask to renew the alliance with `target` (last 30 s before it expires)
	"reinforce", -- {}: the Arsenal's Reinforcements (gold for troops; Sim.reinforce)
}
local INTENT_INDEX: { [string]: number } = {}
for i, name in Protocol.INTENT_TYPES do
	INTENT_INDEX[name] = i
end
-- Integer intent fields in wire order (mask bits 1, 2, 4, 8, 16), then ratio (32), kind (64), accept (128).
-- An optional trailing byte is `amount` (build / nuke several at once: bulk upgrades and
-- stacked atom bombs, 1..MAX_INTENT_AMOUNT).
local INTENT_INT_FIELDS = { "tile", "target", "attack_id", "troops", "uid" }
--- The most levels (or bombs) one intent may ask for.
Protocol.MAX_INTENT_AMOUNT = 50

-- =============================================================================================
-- Compression (EncodingService zstd when available)
-- =============================================================================================

type Codec = { compress: (buffer) -> buffer, decompress: (buffer, number) -> buffer }
local codec: Codec? = nil

do
	local ok, es = pcall(function()
		return (game :: any):GetService("EncodingService")
	end)
	if ok and es ~= nil then
		local algo = (Enum :: any).CompressionAlgorithm.Zstd
		local probe_ok = pcall(function()
			local z = es:CompressBuffer(buffer.fromstring("airfront"), algo, 3)
			assert(buffer.tostring(es:DecompressBuffer(z, algo)) == "airfront", "zstd round trip")
		end)
		if probe_ok then
			codec = {
				compress = function(b: buffer): buffer
					return es:CompressBuffer(b, algo, 3)
				end,
				decompress = function(b: buffer, _raw_size: number): buffer
					return es:DecompressBuffer(b, algo)
				end,
			}
		end
	end
end

--- Plug a compressor (Lune tests use @lune/serde zstd). Pass nil to disable compression.
function Protocol.set_codec(c: Codec?)
	codec = c
end

function Protocol.has_codec(): boolean
	return codec ~= nil
end

-- =============================================================================================
-- Writer / reader
-- =============================================================================================

--- gw: grid width for tile paths (0 = unknown: paths go as int arrays); cells: grid cell count
--- for owner / flag grid detection (0 = none).
export type Writer = { b: buffer, n: number, gw: number, cells: number }
export type Reader = { b: buffer, n: number, len: number }

local function w_new(cap: number): Writer
	return { b = buffer.create(cap), n = 0, gw = 0, cells = 0 }
end

local function w_ensure(w: Writer, extra: number)
	local need = w.n + extra
	local cap = buffer.len(w.b)
	if need > cap then
		local nc = cap * 2
		while nc < need do
			nc *= 2
		end
		local nb = buffer.create(nc)
		buffer.copy(nb, 0, w.b, 0, w.n)
		w.b = nb
	end
end

local function w_u8(w: Writer, v: number)
	w_ensure(w, 1)
	buffer.writeu8(w.b, w.n, v)
	w.n += 1
end

local function w_var(w: Writer, v: number)
	w_ensure(w, 8)
	local b, n = w.b, w.n
	while v >= 128 do
		buffer.writeu8(b, n, v % 128 + 128)
		n += 1
		v = v // 128
	end
	buffer.writeu8(b, n, v)
	w.n = n + 1
end

local function w_zz(w: Writer, v: number)
	if v >= 0 then
		w_var(w, v * 2)
	else
		w_var(w, -v * 2 - 1)
	end
end

local function w_f64(w: Writer, v: number)
	w_ensure(w, 8)
	buffer.writef64(w.b, w.n, v)
	w.n += 8
end

local function w_str(w: Writer, s: string)
	local len = #s
	w_var(w, len)
	w_ensure(w, len)
	buffer.writestring(w.b, w.n, s)
	w.n += len
end

local function w_bytes(w: Writer, src: buffer, offset: number, len: number)
	w_ensure(w, len)
	buffer.copy(w.b, w.n, src, offset, len)
	w.n += len
end

local function w_finish(w: Writer): buffer
	local out = buffer.create(w.n)
	buffer.copy(out, 0, w.b, 0, w.n)
	return out
end

local function r_new(b: buffer, offset: number): Reader
	return { b = b, n = offset, len = buffer.len(b) }
end

local function r_u8(r: Reader): number
	local v = buffer.readu8(r.b, r.n)
	r.n += 1
	return v
end

local function r_var(r: Reader): number
	local b, n = r.b, r.n
	local v, mul = 0, 1
	while true do
		local byte = buffer.readu8(b, n)
		n += 1
		if byte < 128 then
			v += byte * mul
			break
		end
		v += (byte - 128) * mul
		mul *= 128
		if mul > 2 ^ 56 then
			error("Protocol: varint too long")
		end
	end
	r.n = n
	return v
end

local function r_zz(r: Reader): number
	local u = r_var(r)
	if u % 2 == 0 then
		return u // 2
	end
	return -(u + 1) // 2
end

local function r_f64(r: Reader): number
	local v = buffer.readf64(r.b, r.n)
	r.n += 8
	return v
end

local function r_str(r: Reader): string
	local len = r_var(r)
	if r.n + len > r.len then
		error("Protocol: string past end")
	end
	local s = buffer.readstring(r.b, r.n, len)
	r.n += len
	return s
end

-- =============================================================================================
-- Generic values
-- =============================================================================================

local TWO53 = 2 ^ 53
local TWO52 = 2 ^ 52
local floor = math.floor

local function step_code(W: number, prev: number, cur: number): number
	local dx = cur % W - prev % W
	local dy = cur // W - prev // W
	if dx >= -1 and dx <= 1 and dy >= -1 and dy <= 1 then
		return (dy + 1) * 3 + dx + 1
	end
	return 15
end

-- Is this all-integer array a dense tile path worth the path encoding?
local function path_escapes(W: number, v: { number }, n: number): number
	local esc = 0
	local prev = v[1]
	if prev < 0 or prev >= MAX_CELLS then
		return n
	end
	for i = 2, n do
		local cur = v[i]
		if cur < 0 or cur >= MAX_CELLS then
			return n
		end
		if step_code(W, prev, cur) == 15 then
			esc += 1
		end
		prev = cur
	end
	return esc
end

local function write_path(w: Writer, v: { number }, n: number)
	local W = w.gw
	w_u8(w, 9)
	w_var(w, n)
	w_var(w, W)
	w_var(w, v[1])
	local steps = n - 1
	local nbytes = (steps + 1) // 2
	w_ensure(w, nbytes)
	local b, base = w.b, w.n
	local escapes: { number }? = nil
	local prev = v[1]
	local byte = 0
	for i = 1, steps do
		local cur = v[i + 1]
		local code = step_code(W, prev, cur)
		if code == 15 then
			if escapes == nil then
				escapes = {}
			end
			table.insert(escapes :: { number }, cur - prev)
		end
		if i % 2 == 1 then
			byte = code
		else
			buffer.writeu8(b, base + (i // 2) - 1, byte + code * 16)
		end
		prev = cur
	end
	if steps % 2 == 1 then
		buffer.writeu8(b, base + nbytes - 1, byte)
	end
	w.n = base + nbytes
	if escapes then
		for _, d in escapes do
			w_zz(w, d)
		end
	end
end

local function read_path(r: Reader): { number }
	local n = r_var(r)
	local W = r_var(r)
	if W < 1 or n > MAX_CELLS then
		error("Protocol: bad path")
	end
	local first = r_var(r)
	local out = table.create(n)
	out[1] = first
	local steps = n - 1
	local nbytes = (steps + 1) // 2
	if r.n + nbytes > r.len then
		error("Protocol: path past end")
	end
	local codes_at = r.n
	r.n += nbytes
	local x, y = first % W, first // W
	local b = r.b
	for i = 1, steps do
		local byte = buffer.readu8(b, codes_at + (i - 1) // 2)
		local code = if i % 2 == 1 then byte % 16 else byte // 16
		if code == 15 then
			local t = out[i] + r_zz(r)
			out[i + 1] = t
			x, y = t % W, t // W
		else
			local dy = code // 3 - 1
			local dx = code % 3 - 1
			x += dx
			y += dy
			out[i + 1] = y * W + x
		end
	end
	return out
end

local write_value: (w: Writer, v: any) -> ()

local function write_table(w: Writer, v: { [any]: any })
	local n = #v
	if n == 0 then
		if next(v) == nil then
			w_u8(w, 12)
			return
		end
		-- string-keyed map
		local count = 0
		for k in v do
			if type(k) ~= "string" then
				error("Protocol: unsupported table key type " .. typeof(k))
			end
			count += 1
		end
		w_u8(w, 10)
		w_var(w, count)
		for k, x in v do
			w_str(w, k :: string)
			write_value(w, x)
		end
		return
	end
	local count = 0
	for _ in v do
		count += 1
	end
	if count ~= n then
		error("Protocol: mixed array/map tables are not supported")
	end
	local all_int = n >= 2
	if all_int then
		for i = 1, n do
			local x = v[i]
			if type(x) ~= "number" or x ~= floor(x) or x >= TWO52 or x <= -TWO52 then
				all_int = false
				break
			end
		end
	end
	if not all_int then
		w_u8(w, 7)
		w_var(w, n)
		for i = 1, n do
			write_value(w, v[i])
		end
		return
	end
	if n >= 4096 then
		-- big grid-like arrays: run-length encode when runs are long
		local runs = 1
		for i = 2, n do
			if v[i] ~= v[i - 1] then
				runs += 1
			end
		end
		if runs * 4 < n then
			w_u8(w, 14)
			w_var(w, n)
			local i = 1
			while i <= n do
				local x = v[i]
				local j = i + 1
				while j <= n and v[j] == x do
					j += 1
				end
				w_zz(w, x)
				w_var(w, j - i)
				i = j
			end
			return
		end
	end
	if n >= 4 and w.gw > 0 and path_escapes(w.gw, v, n) * 4 <= n then
		write_path(w, v, n)
		return
	end
	w_u8(w, 8)
	w_var(w, n)
	local prev = 0
	for i = 1, n do
		local x = v[i]
		w_zz(w, x - prev)
		prev = x
	end
end

local function write_grid_rle(w: Writer, b: buffer, width: number)
	local cells = buffer.len(b) // width
	w_u8(w, 13)
	w_u8(w, width)
	w_var(w, cells)
	-- Direct buffer.* calls (not an aliased local) so Luau uses its builtin fast paths.
	if width == 4 then
		local len = cells * 4
		local i = 0
		while i < len do
			local x = buffer.readu32(b, i)
			local j = i + 4
			while j < len and buffer.readu32(b, j) == x do
				j += 4
			end
			w_var(w, x)
			w_var(w, (j - i) // 4)
			i = j
		end
	elseif width == 1 then
		local i = 0
		while i < cells do
			local x = buffer.readu8(b, i)
			local j = i + 1
			while j < cells and buffer.readu8(b, j) == x do
				j += 1
			end
			w_var(w, x)
			w_var(w, j - i)
			i = j
		end
	else
		local i = 0
		while i < cells do
			local x = buffer.readu16(b, i * 2)
			local j = i + 1
			while j < cells and buffer.readu16(b, j * 2) == x do
				j += 1
			end
			w_var(w, x)
			w_var(w, j - i)
			i = j
		end
	end
end

write_value = function(w: Writer, v: any)
	local t = type(v)
	if t == "number" then
		if v == floor(v) and v < TWO53 and v > -TWO53 then
			if v >= 0 then
				if v < 240 then
					w_u8(w, 16 + v)
				else
					w_u8(w, 3)
					w_var(w, v)
				end
			else
				w_u8(w, 4)
				w_var(w, -v - 1)
			end
		else
			w_u8(w, 5)
			w_f64(w, v)
		end
	elseif t == "string" then
		w_u8(w, 6)
		w_str(w, v)
	elseif t == "boolean" then
		w_u8(w, if v then 2 else 1)
	elseif t == "table" then
		write_table(w, v)
	elseif t == "nil" then
		w_u8(w, 0)
	elseif t == "buffer" then
		local len = buffer.len(v)
		local cells = w.cells
		if
			cells > 0
			and len >= 4096
			and len % cells == 0
			and (len // cells == 1 or len // cells == 2 or len // cells == 4)
		then
			write_grid_rle(w, v, len // cells)
		else
			w_u8(w, 11)
			w_var(w, len)
			w_bytes(w, v, 0, len)
		end
	else
		error("Protocol: unsupported value type " .. typeof(v))
	end
end

local read_value: (r: Reader, depth: number) -> any

read_value = function(r: Reader, depth: number): any
	if depth > 32 then
		error("Protocol: nesting too deep")
	end
	local tag = r_u8(r)
	if tag >= 16 then
		return tag - 16
	elseif tag == 3 then
		return r_var(r)
	elseif tag == 7 then
		local n = r_var(r)
		if n > r.len then
			error("Protocol: array too long")
		end
		local out = table.create(n)
		for i = 1, n do
			out[i] = read_value(r, depth + 1)
		end
		return out
	elseif tag == 6 then
		return r_str(r)
	elseif tag == 9 then
		return read_path(r)
	elseif tag == 8 then
		local n = r_var(r)
		if n > r.len then
			error("Protocol: array too long")
		end
		local out = table.create(n)
		local prev = 0
		for i = 1, n do
			prev += r_zz(r)
			out[i] = prev
		end
		return out
	elseif tag == 4 then
		return -r_var(r) - 1
	elseif tag == 1 then
		return false
	elseif tag == 2 then
		return true
	elseif tag == 0 then
		return nil
	elseif tag == 5 then
		return r_f64(r)
	elseif tag == 10 then
		local n = r_var(r)
		local out = {}
		for _ = 1, n do
			local k = r_str(r)
			out[k] = read_value(r, depth + 1)
		end
		return out
	elseif tag == 12 then
		return {}
	elseif tag == 11 then
		local len = r_var(r)
		if r.n + len > r.len then
			error("Protocol: buffer past end")
		end
		local out = buffer.create(len)
		buffer.copy(out, 0, r.b, r.n, len)
		r.n += len
		return out
	elseif tag == 13 then
		local width = r_u8(r)
		local cells = r_var(r)
		if width ~= 1 and width ~= 2 and width ~= 4 then
			error("Protocol: bad grid width")
		end
		if cells > MAX_CELLS then
			error("Protocol: grid too large")
		end
		local out = buffer.create(cells * width)
		local i = 0
		local runs = 0
		while i < cells do
			local x = r_var(r)
			local len = r_var(r)
			if i + len > cells then
				error("Protocol: grid run past end")
			end
			if x ~= 0 then
				if width == 1 then
					buffer.fill(out, i, x, len)
				elseif width == 4 then
					for k = i, i + len - 1 do
						buffer.writeu32(out, k * 4, x)
					end
				else
					for k = i, i + len - 1 do
						buffer.writeu16(out, k * 2, x)
					end
				end
			end
			i += len
			runs += 1
			if runs % 512 == 0 then
				Coop.check()
			end
		end
		return out
	elseif tag == 14 then
		local n = r_var(r)
		if n > MAX_CELLS then
			error("Protocol: array too long")
		end
		local out = table.create(n)
		local i = 1
		local runs = 0
		while i <= n do
			local x = r_zz(r)
			local len = r_var(r)
			if i + len - 1 > n then
				error("Protocol: run past end")
			end
			for k = i, i + len - 1 do
				out[k] = x
			end
			i += len
			runs += 1
			if runs % 512 == 0 then
				Coop.check()
			end
		end
		return out
	end
	error("Protocol: bad tag " .. tag)
end

-- =============================================================================================
-- Envelope
-- =============================================================================================

--- Returns the body buffer and the offset its first byte is at.
function Protocol.open(msg: buffer): (buffer, number)
	local mode = buffer.readu8(msg, 0)
	if mode == 0 then
		return msg, 1
	elseif mode == 1 then
		local c = codec
		if c == nil then
			error("Protocol: compressed message but no codec")
		end
		local r = r_new(msg, 1)
		local raw_size = r_var(r)
		local z = buffer.create(buffer.len(msg) - r.n)
		buffer.copy(z, 0, msg, r.n, buffer.len(z))
		local body = c.decompress(z, raw_size)
		if buffer.len(body) ~= raw_size then
			error("Protocol: decompressed size mismatch")
		end
		return body, 0
	end
	error("Protocol: bad envelope " .. mode)
end

--- Compresses a raw message (envelope 0) when it is larger than `threshold` bytes and zstd helps.
function Protocol.compress(msg: buffer, threshold: number?): buffer
	local len = buffer.len(msg)
	local c = codec
	if c == nil or len <= (threshold or Protocol.COMPRESS_OVER_BYTES) or buffer.readu8(msg, 0) ~= 0 then
		return msg
	end
	local body = buffer.create(len - 1)
	buffer.copy(body, 0, msg, 1, len - 1)
	local z = c.compress(body)
	local w = w_new(buffer.len(z) + 10)
	w_u8(w, 1)
	w_var(w, len - 1)
	w_bytes(w, z, 0, buffer.len(z))
	if w.n >= len then
		return msg
	end
	return w_finish(w)
end

-- =============================================================================================
-- Delta
-- =============================================================================================

local function packed_len(v: any): number
	if type(v) == "buffer" then
		return buffer.len(v) // 4
	end
	return #v
end

local function packed_get(v: any, i: number): number
	-- 1-based index for both representations
	if type(v) == "buffer" then
		return buffer.readi32(v, (i - 1) * 4)
	end
	return v[i]
end

-- (tile << shift | value) lists: runs of equal value, zigzag deltas of the tile index.
local function write_tile_list(w: Writer, v: any, base: number)
	local n = packed_len(v)
	w_u8(w, if type(v) == "buffer" then 1 else 0)
	w_var(w, n)
	local prev_tile = 0
	local i = 1
	while i <= n do
		local x = packed_get(v, i)
		local val = x % base
		local j = i + 1
		while j <= n and packed_get(v, j) % base == val do
			j += 1
		end
		w_var(w, val)
		w_var(w, j - i)
		for k = i, j - 1 do
			local tile = packed_get(v, k) // base
			w_zz(w, tile - prev_tile)
			prev_tile = tile
		end
		i = j
	end
end

local function read_tile_list(r: Reader, base: number): any
	local repr = r_u8(r)
	local n = r_var(r)
	if n > MAX_CELLS then
		error("Protocol: tile list too long")
	end
	local out: any = if repr == 1 then buffer.create(n * 4) else table.create(n)
	local prev_tile = 0
	local i = 1
	while i <= n do
		local val = r_var(r)
		local len = r_var(r)
		if i + len - 1 > n then
			error("Protocol: tile run past end")
		end
		for k = i, i + len - 1 do
			prev_tile += r_zz(r)
			local x = prev_tile * base + val
			if repr == 1 then
				buffer.writei32(out, (k - 1) * 4, x)
			else
				out[k] = x
			end
		end
		i += len
	end
	return out
end

local function write_int_list(w: Writer, v: any)
	local n = packed_len(v)
	w_u8(w, if type(v) == "buffer" then 1 else 0)
	w_var(w, n)
	for i = 1, n do
		w_zz(w, packed_get(v, i))
	end
end

local function read_int_list(r: Reader): any
	local repr = r_u8(r)
	local n = r_var(r)
	if n > r.len * 2 then
		error("Protocol: int list too long")
	end
	if repr == 1 then
		local out = buffer.create(n * 4)
		for i = 0, n - 1 do
			buffer.writei32(out, i * 4, r_zz(r))
		end
		return out
	end
	local out = table.create(n)
	for i = 1, n do
		out[i] = r_zz(r)
	end
	return out
end

local DELTA_KEYS = { t = true, tiles = true, flags = true, stats = true, ev = true }

--- Encodes a Sim delta. `ev` (optional) replaces delta.ev (the server passes the public events);
--- `grid_w` is the map width (sim.W) so unit paths use the compact path encoding.
function Protocol.encode_delta(d: { [string]: any }, ev: { any }?, grid_w: number?): buffer
	local w = w_new(256)
	w.gw = grid_w or 0
	w_u8(w, 0)
	w_u8(w, Protocol.KIND_DELTA)
	local events = if ev ~= nil then ev else d.ev
	local extra: { [string]: any }? = nil
	for k, x in d do
		if not DELTA_KEYS[k] then
			if extra == nil then
				extra = {}
			end
			(extra :: any)[k] = x
		end
	end
	local mask = 0
	if d.tiles ~= nil then
		mask += 1
	end
	if d.flags ~= nil then
		mask += 2
	end
	if d.stats ~= nil then
		mask += 4
	end
	if events ~= nil then
		mask += 8
	end
	if extra ~= nil then
		mask += 16
	end
	if d.t ~= nil then
		mask += 32
	end
	w_u8(w, mask)
	if d.t ~= nil then
		w_var(w, d.t)
	end
	if d.tiles ~= nil then
		write_tile_list(w, d.tiles, 1024)
	end
	if d.flags ~= nil then
		write_tile_list(w, d.flags, 256)
	end
	if d.stats ~= nil then
		write_int_list(w, d.stats)
	end
	if events ~= nil then
		local list = events :: { any }
		w_var(w, #list)
		for _, e in list do
			write_value(w, e)
		end
	end
	if extra ~= nil then
		write_value(w, extra)
	end
	return w_finish(w)
end

--- Per-recipient private events: list of {position, event} (position = index in that recipient's
--- event list, ascending).
function Protocol.encode_tail(list: { { any } }, grid_w: number?): buffer
	local w = w_new(64)
	w.gw = grid_w or 0
	w_u8(w, 0)
	w_u8(w, Protocol.KIND_TAIL)
	w_var(w, #list)
	for _, pe in list do
		w_var(w, pe[1])
		write_value(w, pe[2])
	end
	return w_finish(w)
end

function Protocol.decode_delta(msg: buffer, tail: buffer?): { [string]: any }
	local body, off = Protocol.open(msg)
	local r = r_new(body, off)
	if r_u8(r) ~= Protocol.KIND_DELTA then
		error("Protocol: not a delta")
	end
	local mask = r_u8(r)
	local d: { [string]: any } = {}
	if mask // 32 % 2 == 1 then
		d.t = r_var(r)
	end
	if mask % 2 == 1 then
		d.tiles = read_tile_list(r, 1024)
	end
	if mask // 2 % 2 == 1 then
		d.flags = read_tile_list(r, 256)
	end
	if mask // 4 % 2 == 1 then
		d.stats = read_int_list(r)
	end
	if mask // 8 % 2 == 1 then
		local n = r_var(r)
		local evs = table.create(n)
		for i = 1, n do
			evs[i] = read_value(r, 1)
		end
		d.ev = evs
	end
	if mask // 16 % 2 == 1 then
		local extra = read_value(r, 1)
		for k, x in extra do
			d[k] = x
		end
	end
	if tail ~= nil then
		local tb, toff = Protocol.open(tail)
		local tr = r_new(tb, toff)
		if r_u8(tr) ~= Protocol.KIND_TAIL then
			error("Protocol: not a tail")
		end
		local n = r_var(tr)
		if n > 0 then
			local evs = d.ev
			if evs == nil then
				evs = {}
				d.ev = evs
			end
			for _ = 1, n do
				local pos = r_var(tr)
				local e = read_value(tr, 1)
				table.insert(evs, math.clamp(pos, 1, #evs + 1), e)
			end
		end
	end
	return d
end

--- Splits a delta's events into the shared list (everything but owner-addressed events) and the
--- private events per recipient owner with their positions in that recipient's list.
--- `is_private(ev) -> owner?` returns the recipient for a private event, nil for a public one.
function Protocol.split_events(evs: { any }?, is_private: (any) -> number?): ({ any }, { [number]: { { any } } }?)
	if evs == nil then
		return {}, nil
	end
	local public = {}
	local privates: { [number]: { { any } } }? = nil
	local private_count: { [number]: number } = {}
	for _, e in evs do
		local to = is_private(e)
		if to == nil then
			table.insert(public, e)
		else
			if privates == nil then
				privates = {}
			end
			local p = privates :: { [number]: { { any } } }
			local list = p[to]
			if list == nil then
				list = {}
				p[to] = list
			end
			local k = (private_count[to] or 0) + 1
			private_count[to] = k
			table.insert(list, { #public + k, e })
		end
	end
	return public, privates
end

-- =============================================================================================
-- Snapshot
-- =============================================================================================

--- Encodes a Sim.snapshot(); its map_w / map_h give the path width and the grid cell count.
function Protocol.encode_snapshot(snap: { [string]: any }): buffer
	local w = w_new(64 * 1024)
	local mw = tonumber(snap.map_w) or 0
	local mh = tonumber(snap.map_h) or 0
	w.gw = mw
	w.cells = mw * mh
	w_u8(w, 0)
	w_u8(w, Protocol.KIND_SNAPSHOT)
	write_value(w, snap)
	return w_finish(w)
end

--- Decodes a snapshot. Grid decoding calls Coop.check(), so inside a Coop job it spreads over frames.
function Protocol.decode_snapshot(msg: buffer): { [string]: any }
	local body, off = Protocol.open(msg)
	local r = r_new(body, off)
	if r_u8(r) ~= Protocol.KIND_SNAPSHOT then
		error("Protocol: not a snapshot")
	end
	local snap = read_value(r, 0)
	if type(snap) ~= "table" then
		error("Protocol: bad snapshot")
	end
	return snap
end

-- =============================================================================================
-- Intents (client → server; untrusted on decode)
-- =============================================================================================

local function as_int(v: any): number?
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge or math.abs(v) >= 2147483647 then
		return nil
	end
	-- GDScript int(): truncate toward zero
	return if v >= 0 then floor(v) else -floor(-v)
end

--- Encodes an intent dictionary; returns nil for an unknown type or unusable field (never sent).
function Protocol.encode_intent(intent: { [string]: any }): buffer?
	local idx = INTENT_INDEX[tostring(intent.type)]
	if idx == nil then
		return nil
	end
	local w = w_new(32)
	w_u8(w, 0)
	w_u8(w, Protocol.KIND_INTENT)
	w_u8(w, idx)
	local mask = 0
	local ints = {}
	for bit, key in INTENT_INT_FIELDS do
		local v = intent[key]
		if v ~= nil then
			local iv = as_int(v)
			if iv == nil then
				return nil
			end
			mask += 2 ^ (bit - 1)
			ints[bit] = iv
		end
	end
	local ratio = intent.ratio
	if ratio ~= nil then
		if type(ratio) ~= "number" or ratio ~= ratio or math.abs(ratio) == math.huge then
			return nil
		end
		mask += 32
	end
	local kind = intent.kind
	if kind ~= nil then
		if type(kind) ~= "string" then
			return nil
		end
		mask += 64
	end
	local accept = intent.accept
	if accept ~= nil then
		if type(accept) ~= "boolean" then
			return nil
		end
		mask += 128
	end
	w_u8(w, mask)
	for bit = 1, #INTENT_INT_FIELDS do
		if ints[bit] ~= nil then
			w_zz(w, ints[bit])
		end
	end
	if ratio ~= nil then
		w_f64(w, ratio)
	end
	if kind ~= nil then
		w_str(w, string.sub(kind, 1, 16))
	end
	if accept ~= nil then
		w_u8(w, if accept then 1 else 0)
	end
	local amount = intent.amount
	if amount ~= nil then
		local av = as_int(amount)
		if av == nil or av < 1 or av > Protocol.MAX_INTENT_AMOUNT then
			return nil
		end
		w_u8(w, av)
	end
	return w_finish(w)
end

--- Decodes and sanitizes an intent from a client (port of session.gd `_sanitize_intent`): strict
--- whitelist, only known types and fields, finite numbers, tiles on the map, targets in range.
--- Returns nil for anything malformed. Never errors.
function Protocol.decode_intent(msg: any): { [string]: any }?
	if type(msg) ~= "buffer" then
		return nil
	end
	local len = buffer.len(msg)
	if len < 4 or len > Protocol.MAX_INTENT_BYTES or buffer.readu8(msg, 0) ~= 0 then
		return nil
	end
	local ok, out = pcall(function(): { [string]: any }?
		local r = r_new(msg, 1)
		if r_u8(r) ~= Protocol.KIND_INTENT then
			return nil
		end
		local name = Protocol.INTENT_TYPES[r_u8(r)]
		if name == nil then
			return nil
		end
		local mask = r_u8(r)
		local it: { [string]: any } = { type = name }
		for bit, key in INTENT_INT_FIELDS do
			if mask // (2 ^ (bit - 1)) % 2 == 1 then
				local v = r_zz(r)
				if math.abs(v) >= 2147483647 then
					return nil
				end
				it[key] = v
			end
		end
		if mask // 32 % 2 == 1 then
			local ratio = r_f64(r)
			if ratio ~= ratio or math.abs(ratio) == math.huge then
				return nil
			end
			it.ratio = math.clamp(ratio, 0.01, 1.0)
		end
		if mask // 64 % 2 == 1 then
			local s = r_str(r)
			if #s > 16 then
				return nil
			end
			it.kind = s
		end
		if mask // 128 % 2 == 1 then
			local a = r_u8(r)
			if a > 1 then
				return nil
			end
			it.accept = a == 1
		end
		if r.n == len - 1 then
			local amount = r_u8(r)
			if amount < 1 or amount > Protocol.MAX_INTENT_AMOUNT then
				return nil
			end
			it.amount = amount
		end
		if r.n ~= len then
			return nil
		end
		if it.tile ~= nil and (it.tile < 0 or it.tile >= MAX_CELLS) then
			return nil
		end
		if it.target ~= nil and (it.target < 0 or it.target >= MAX_OWNERS) then
			return nil
		end
		if it.troops ~= nil then
			it.troops = math.max(0, it.troops)
		end
		return it
	end)
	if ok then
		return out
	end
	return nil
end

-- Test hooks
Protocol._write_value = function(v: any, grid_w: number?, cells: number?): buffer
	local w = w_new(64)
	w.gw = grid_w or 0
	w.cells = cells or 0
	w_u8(w, 0)
	write_value(w, v)
	return w_finish(w)
end
Protocol._read_value = function(b: buffer): any
	local r = r_new(b, 1)
	return read_value(r, 0)
end

return Protocol
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">Settings</string>
            <string name="Source"><![CDATA[--!strict
-- Per-player settings sanitizer, shared by the client (Session.save_settings / the copy it keeps) and the
-- server (SettingsStore, which persists them in a DataStore). The original kept these in
-- user://settings.cfg sections ([audio] music_enabled, [ui] ratio, labels, difficulty, tips_seen…).
--
-- A settings blob is { [section] = { [key] = value } } where a value is
--   * a boolean, a finite number (|v| < 1e12) or a string of at most MAX_STRING bytes, or
--   * ONE nested level of such scalars keyed by name (e.g. [ui] tips_seen = { expand = true, … }).
-- Names are 1..MAX_NAME characters of [A-Za-z0-9_]. Everything else is dropped, never an error.
--
-- The input may be an untrusted client table of any size or shape (cycles, metatables, huge tables):
-- every walk stops after a fixed number of EXAMINED entries (valid or not), so the cost per message is
-- bounded, and the output is a fresh plain table (never aliases the input).
--
-- Size caps (review_code.md R2-2): a cleaned section keeps at most MAX_SECTION_BYTES and a whole blob
-- at most MAX_TOTAL_BYTES (Settings.bytes: names + string lengths, 8 per number, 1 per boolean), so
-- what the server stores and echoes per player stays small. Real settings are far below: [ui] with its
-- ~15 keys and tips_seen is ~0.4 KB, [audio] a few bytes.

local Settings = {}

Settings.MAX_SECTIONS = 8
--- Valid top-level keys kept per section.
Settings.MAX_KEYS = 32
--- Valid entries kept per nested table.
Settings.MAX_NESTED_KEYS = 32
--- Entries looked at per section (top level + nested, valid or not) before the walk stops.
Settings.MAX_EXAMINED = 192
--- Sections looked at per blob before the walk stops.
Settings.MAX_SECTIONS_EXAMINED = 16
Settings.MAX_NAME = 32
Settings.MAX_SECTION_NAME = 16
Settings.MAX_STRING = 64
--- Size caps (Settings.bytes) of one cleaned section and of a whole blob.
Settings.MAX_SECTION_BYTES = 4096
Settings.MAX_TOTAL_BYTES = 16384

-- size of one scalar value (Settings.bytes metric)
local function value_bytes(v: any): number
	local t = type(v)
	if t == "string" then
		return #v
	elseif t == "number" then
		return 8
	end
	return 1
end

--- Size of a cleaned value: a section ({key = value | {key = scalar}}) or a whole blob
--- ({section = section}): the length of every name and string, 8 per number, 1 per boolean.
function Settings.bytes(t: any): number
	if type(t) ~= "table" then
		return value_bytes(t)
	end
	local n = 0
	for k, v in t do
		n += #tostring(k) + Settings.bytes(v)
	end
	return n
end

function Settings.valid_name(s: any, max: number?): boolean
	return type(s) == "string" and #s > 0 and #s <= (max or Settings.MAX_NAME) and string.match(s, "^[%w_]+$") ~= nil
end

local valid_name = Settings.valid_name

local function scalar_ok(v: any): boolean
	local t = type(v)
	if t == "boolean" then
		return true
	elseif t == "number" then
		return v == v and math.abs(v) < 1e12
	elseif t == "string" then
		return #v <= Settings.MAX_STRING
	end
	return false
end

-- rawget-style iteration: `next` never calls __index / __pairs metamethods of hostile tables.
local function walk(t: { [any]: any }, budget: { n: number }, fn: (any, any) -> boolean)
	local k, v = next(t)
	while k ~= nil do
		budget.n -= 1
		if budget.n < 0 then
			return
		end
		if fn(k, v) == false then
			return
		end
		k, v = next(t, k)
	end
end

--- A cleaned copy of one settings section, or nil when `values` is not a table. Entries past the
--- MAX_SECTION_BYTES size budget are dropped (trimmed, never an error).
function Settings.clean_section(values: any): { [string]: any }?
	if type(values) ~= "table" then
		return nil
	end
	local out = {}
	local n = 0
	local budget = { n = Settings.MAX_EXAMINED }
	local room = Settings.MAX_SECTION_BYTES
	walk(values, budget, function(k, v)
		if not valid_name(k) then
			return true
		end
		if type(v) == "table" then
			if #k >= room then
				return true
			end
			local sub = {}
			local m = 0
			local used = #k
			walk(v, budget, function(k2, v2)
				if valid_name(k2) and scalar_ok(v2) then
					local b = #k2 + value_bytes(v2)
					if used + b > room then
						return true -- over the size budget: dropped
					end
					used += b
					sub[k2] = v2
					m += 1
					if m >= Settings.MAX_NESTED_KEYS then
						return false
					end
				end
				return true
			end)
			out[k] = sub
			room -= used
		elseif scalar_ok(v) then
			local b = #k + value_bytes(v)
			if b > room then
				return true
			end
			room -= b
			out[k] = v
		else
			return true
		end
		n += 1
		return n < Settings.MAX_KEYS
	end)
	return out
end

--- A cleaned copy of a whole settings blob ({} when unusable). A section that would take the blob
--- past MAX_TOTAL_BYTES is dropped whole.
function Settings.clean_all(data: any): { [string]: { [string]: any } }
	local out = {}
	if type(data) ~= "table" then
		return out
	end
	local n = 0
	local total = 0
	local budget = { n = Settings.MAX_SECTIONS_EXAMINED }
	walk(data, budget, function(section, values)
		if valid_name(section, Settings.MAX_SECTION_NAME) then
			local c = Settings.clean_section(values)
			if c then
				local b = #section + Settings.bytes(c)
				if total + b > Settings.MAX_TOTAL_BYTES then
					return true
				end
				total += b
				out[section] = c
				n += 1
				if n >= Settings.MAX_SECTIONS then
					return false
				end
			end
		end
		return true
	end)
	return out
end

--- Deep copy of a cleaned section (one nested level), so callers can mutate what they get.
function Settings.copy_section(s: { [string]: any }?): { [string]: any }
	local out = {}
	if s == nil then
		return out
	end
	for k, v in s do
		out[k] = if type(v) == "table" then table.clone(v) else v
	end
	return out
end

--- True when two cleaned sections hold the same values.
function Settings.equal(a: { [string]: any }?, b: { [string]: any }?): boolean
	if a == nil or b == nil then
		return a == b
	end
	for k, v in a do
		local w = b[k]
		if type(v) == "table" then
			if type(w) ~= "table" then
				return false
			end
			for k2, v2 in v do
				if w[k2] ~= v2 then
					return false
				end
			end
			for k2 in w do
				if v[k2] == nil then
					return false
				end
			end
		elseif w ~= v then
			return false
		end
	end
	for k in b do
		if a[k] == nil then
			return false
		end
	end
	return true
end

return Settings
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="72">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="73">
      <Properties>
        <string name="Name">AirfrontServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Airfront server entry. Owned by the Session/Main agent (see PORT.md §Ownership).
-- Dev harness hook: workspace attribute AF_DEV runs src/server/Dev/<AF_DEV>.luau if it exists.
local dev = workspace:GetAttribute("AF_DEV")
if type(dev) == "string" and dev ~= "" then
	local mod = script:FindFirstChild("Dev") and script.Dev:FindFirstChild(dev)
	if mod then
		print("[RoWorld] server dev harness:", dev)
		require(mod)
		return
	end
end
local Server = script:FindFirstChild("ServerMain")
if Server then
	require(Server).start()
else
	print("[RoWorld] server boot (ServerMain not yet written)")
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="74">
        <Properties>
          <string name="Name">AdminCheck</string>
          <string name="Source"><![CDATA[--!strict
-- Who is a game admin: the game's owner, or rank ADMIN_RANK+ in the owning group (everyone in a Studio
-- playtest). ServerMain gives admins the AF_Admin attribute and tells them which players are bots.
--
-- 2026-11-01: every join on every server asked Roblox twice (GetRankInGroup, then GetGroupInfoAsync for
-- the group's owner), and a failed check was tried 4 times in 12 s. At ~3,000 joins a minute at peak
-- that ran past Roblox's limit for these calls ("number of API requests/minute exceeded limit for
-- HTTP API throttle. Please don't issue more than 4400 API requests/minute with server scripts": at
-- least 70,000 failed checks a day in the error report). Now the group's owner is looked up once per
-- server, and a player's answer is shared by every server for CACHE_S (a MemoryStore hash map): a
-- player is asked about about once per CACHE_S, however many servers they pass through. A failed check
-- waits RETRY_S before the next try.
--
--   AdminCheck.new(deps) -> check
--     deps = {
--       studio = boolean,                          -- RunService:IsStudio(): everyone is an admin
--       group = boolean,                           -- the game belongs to a group (CreatorType)
--       creator_id = number,                       -- game.CreatorId
--       rank = function(player) -> number,         -- GetRankInGroup(creator_id); may error
--       owner = function() -> number?,             -- the group owner's user id; may error
--       cache_get = function(key) -> any,          -- the shared answers (nil: none); may error
--       cache_set = function(key, value, ttl_s),   -- may error
--     }
--   check:is_admin(player) -> boolean   yields; errors while the answer can't be known
local AdminCheck = {}
AdminCheck.__index = AdminCheck

--- Group rank that counts as a game admin (254 = Admin, 255 = Owner in a default group).
AdminCheck.ADMIN_RANK = 254
--- How long every server trusts a player's answer (a promotion or demotion shows within this).
AdminCheck.CACHE_S = 6 * 3600
--- The waits before the second and third tries of a failed check (then it gives up: not an admin).
AdminCheck.RETRY_S = { 15, 60 }

function AdminCheck.new(deps: { [string]: any })
	local self = setmetatable({}, AdminCheck)
	self.deps = deps
	self._owner = nil :: number?
	self._owner_known = false
	self.asked = 0 -- rank lookups made (tests)
	return self
end

--- The group owner's user id (looked up once per server; nil: the group has none).
function AdminCheck._group_owner(self: any): number?
	if not self._owner_known then
		local id = self.deps.owner()
		self._owner = if type(id) == "number" then id else nil
		self._owner_known = true
	end
	return self._owner
end

function AdminCheck.is_admin(self: any, player: any): boolean
	local d = self.deps
	if d.studio then
		return true
	end
	local uid = tonumber(player.UserId) or 0
	if not d.group then
		return uid == d.creator_id
	end
	local key = tostring(uid)
	if d.cache_get ~= nil then
		local ok, v = pcall(d.cache_get, key)
		if ok and (v == 1 or v == 0) then
			return v == 1
		end
	end
	self.asked += 1
	local yes = d.rank(player) >= AdminCheck.ADMIN_RANK
	if not yes then
		-- the group's owner, whatever their role's rank
		yes = self:_group_owner() == uid
	end
	if d.cache_set ~= nil then
		pcall(d.cache_set, key, if yes then 1 else 0, AdminCheck.CACHE_S)
	end
	return yes
end

return AdminCheck
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="75">
        <Properties>
          <string name="Name">Analytics</string>
          <string name="Source"><![CDATA[--!strict
-- Creator Dashboard analytics (Roblox AnalyticsService): how new players get on. Solo matches run on
-- the client, so the client reports its milestones (OP.ANALYTICS, from client/UI/Telemetry.luau) and
-- this module logs them: known kinds only, each milestone once per match, bounded values. Nothing
-- here affects the game. Events are only recorded in the published game (not in Studio, where they
-- are printed instead) and the dashboard fills in within ~24 h.
--
-- Creator Dashboard → Analytics:
--   Funnels → Onboarding (a player's first session, each step once):
--     1 Joined Game · 2 Title Screen · 3 Match Started · 4 Spawned · 5 First Attack ·
--     6 Survived 3 Min · 7 Survived 10 Min · 8 Second Match
--   Funnels → "Match" (every match played):
--     1 Started · 2 Spawned · 3 First Attack · 4 Survived 3 Min · 5 Survived 10 Min · 6 Reached The End
--   Custom events (CustomField01 = mode, CustomField02 = experience, CustomField03 = detail):
--     Match Start (detail: map) · Match End (value: minutes; detail: result) ·
--     Eliminated (value: minutes alive; detail: who by) · Final Rank (value: rank, alive at the end) ·
--     How To Play (detail: where) · Spectate
--     Crate Shop Opened → Crate Clicked → Crate Bought → Crate Opened (detail: rarity) · Item Equipped
--       (detail: Skin / Flag) (cosmetic crates, Data/Cosmetics)
--     Arsenal Opened (detail: Title / In Match / Locked Unit / Result Screen / Result Offer) → Arsenal Clicked →
--       Arsenal Unlocked (detail: "<Item> for Stars" / "<Item> for Robux") · Stars Earned (value: the
--       Stars a match paid) (the Arsenal, Data/Arsenal; Stars, Data/Stars)
--     Takeover Offered → Takeover Clicked → Takeover Bought → Takeover Used (solo: take over the
--       nation that eliminated you, 25 Robux; each once per match; mode / experience fields)
--     Public Match Humans (one per public match, when it starts; value: humans it started with;
--       CustomField01 = band "1" / "2-4" / "5-9" / "10-19" / "20-29" / "30-39" / "40-49" / "50+",
--       CustomField02 = slots ("30 slots"), CustomField03 = how it started: Vote / Timer). Explore →
--       Custom events → Public Match Humans → Average (daily) is humans per match; the goal is 50.
--     Quit Situation / Left Situation (value: minutes; CustomField02 = what was happening,
--       CustomField03 = land standing) and Quit FPS / Left FPS (value: frame rate; CustomField02 = its
--       band, CustomField03 = experience): the client's last snapshot (Telemetry "state", every 10 s
--       and right before leaving) when a match ends with the player quitting the game / leaving to the
--       title. Situations: Choosing spawn · Not spawned · Under attack · Losing land · Idle · Growing ·
--       Holding · No report (quit before the first snapshot). Standing: Top 3 · Top 10 · Lower · No land.
--     Slow Frames (value: the frame rate; CustomField02 = what the frame was made of, CustomField03 =
--       how far into the match): once a match, the first 10 s a client spends under 12 frames a second
--       with the game's window in front (Telemetry "slow"). Causes: Munitions In Flight (40 or more) ·
--       Script - Units / Labels / Territory / Map Camera / Fallout Glow / Roads / Range Rings /
--       Structures / Map Effects / Fronts / Markers / Map Input / Map Other (the map's layers; until
--       v110 the ones after Territory were all Map Other) / Updates (the server's
--       updates decoded and applied: a public match) / Sim (a solo match's) / Session / HUD / HUD Kit
--       (our own code is half the frame or more; the biggest part) · Engine - GPU / Render CPU (it is
--       not, and the engine's own count of that is a third of the frame or more) · Engine - Other.
--       Break it down by platform in Explore. (Until v73 the updates, the session and the HUD were
--       not counted: an "Engine" of v71 or v72 may be one of them.)
--       (v71 logged the engine's as "Engine, Memory ...": Roblox refuses a field with a comma and
--       kept the event with the field empty. An empty cause on 2026-10-09 is one of those.)
--     Slow Frames Memory (value: the client's memory, MB; CustomField02 = the same cause,
--       CustomField03 = Under 1 GB / 1-2 GB / 2-3 GB / 3-4 GB / 4+ GB): with every Slow Frames.
--   Mode: Solo Easy / Solo Medium / Solo Hard / Public. Experience: the player's matches before this
--   one ("1st match", "2nd-5th match", "6th+ match"; kept in the saved settings' "stats" section).
--   Results: Won · Lost (alive when someone else won) · Eliminated · Left (back to the title) ·
--   Quit Game (left the game mid-match). Killers: Nation · Tribe · Bot Player · Real Player.
--
--   Analytics.configure(deps)   the Roblox services (tests inject fakes)
--   Analytics.joined(player)    PlayerAdded
--   Analytics.report(player, kind, a, b, c)   an OP.ANALYTICS message
--   Analytics.left(player)      PlayerRemoving (an open match ends as "Quit Game")

local Pacer = require("./Pacer")

local Analytics = {}

Analytics.ONBOARDING = {
	"Joined Game",
	"Title Screen",
	"Match Started",
	"Spawned",
	"First Attack",
	"Survived 3 Min",
	"Survived 10 Min",
	"Second Match",
}
Analytics.FUNNEL = "Match"
Analytics.FUNNEL_STEPS = { "Started", "Spawned", "First Attack", "Survived 3 Min", "Survived 10 Min", "Reached The End" }
Analytics.MODES = { solo0 = "Solo Easy", solo1 = "Solo Medium", solo2 = "Solo Hard", public = "Public" }
Analytics.KILLERS = { nation = "Nation", tribe = "Tribe", bot = "Bot Player", human = "Real Player" }
Analytics.WHERE = { title = "Title", match = "In Match" }
Analytics.SITUATIONS = {
	["Choosing spawn"] = true,
	["Not spawned"] = true,
	["Under attack"] = true,
	["Losing land"] = true,
	["Idle"] = true,
	["Growing"] = true,
	["Holding"] = true,
}
Analytics.STANDINGS = { ["Top 3"] = true, ["Top 10"] = true, ["Lower"] = true, ["No land"] = true }
Analytics.MAX_FPS = 240
--- What a slow frame was made of (the client's word, Telemetry.slow_cause).
Analytics.SLOW_CAUSES = {
	nukes = "Munitions In Flight",
	units = "Script - Units",
	labels = "Script - Labels",
	territory = "Script - Territory",
	map = "Script - Map Other",
	-- (2026-10-27: the rest of the map by its parts, Telemetry.MAP_PARTS)
	map_camera = "Script - Map Camera",
	map_glow = "Script - Fallout Glow",
	map_roads = "Script - Roads",
	map_ranges = "Script - Range Rings",
	map_structures = "Script - Structures",
	map_fx = "Script - Map Effects",
	map_fronts = "Script - Fronts",
	map_markers = "Script - Markers",
	map_input = "Script - Map Input",
	hud = "Script - HUD Kit",
	sim = "Script - Sim",
	net = "Script - Updates",
	session = "Script - Session",
	ui = "Script - HUD",
	gpu = "Engine - GPU",
	render = "Engine - Render CPU",
	engine = "Engine - Other",
	-- (v71's clients, until they rejoin, name the engine by the client's memory)
	engine_lo = "Engine - Memory Under 2 GB",
	engine_mid = "Engine - Memory 2-3 GB",
	engine_hi = "Engine - Memory 3+ GB",
}
--- The most memory a client may report (MB).
Analytics.MAX_MEMORY_MB = 65536
--- Where the Arsenal was opened from (the client's word).
Analytics.ARSENAL_FROM = {
	title = "Title",
	match = "In Match",
	locked = "Locked Unit",
	over = "Result Screen",
	--- the result screen's offers (the next unlock, 2x Stars), not its Stars pill
	offer = "Result Offer",
}
Analytics.RARITY_NAMES = { common = "Common", rare = "Rare", epic = "Epic", legendary = "Legendary" }
Analytics.STATS = "stats"
--- Longest match time a report may claim (minutes).
Analytics.MAX_MINUTES = 240
Analytics.MAX_RANK = 1000

type Match = {
	mode: string,
	exp: string,
	map: string,
	key: string,
	steps: { [number]: boolean },
	minutes: number,
	ended: boolean,
	snap: { situation: string, standing: string, fps: number }?,
	slow: boolean?,
	slow_mem: boolean?,
}
type Entry = { onboarding: { [number]: boolean }, match: Match? }
-- (a Match may also carry `tutorial`: the tutorial steps logged for it)

--- Roblox allows a server 120 + 20 x its players AnalyticsService events a minute (docs: "Event tracking
--- limitations") and drops the rest with "AnalyticsService: You have sent too many events" (~17,500 a
--- day in the error report since 2026-10-27). The events now go out through a Pacer at this share of
--- that rate, a burst of PACE_BURST_S of it at once; a player has at most PACE_PER_PLAYER waiting (a
--- client may report 6 times a second: one can't crowd out the rest).
Analytics.PACE_SHARE = 0.75
Analytics.PACE_BURST_S = 10
Analytics.PACE_PER_PLAYER = 40
Analytics.PACE_MAX_QUEUED = 3000

local IS_ROBLOX = typeof(game) == "Instance"
local deps: { [string]: any } = {}
if IS_ROBLOX then
	local AnalyticsService = game:GetService("AnalyticsService")
	local HttpService = game:GetService("HttpService")
	local Players = game:GetService("Players")
	local studio = game:GetService("RunService"):IsStudio()
	local pacer = Pacer.new({
		rate = function(): number
			return Analytics.PACE_SHARE * (120 + 20 * #Players:GetPlayers()) / 60
		end,
		burst_s = Analytics.PACE_BURST_S,
		max_queued = Analytics.PACE_MAX_QUEUED,
		per_key_max = Analytics.PACE_PER_PLAYER,
		now = os.clock,
		on_error = function(err: any)
			warn("[Analytics] " .. tostring(err))
		end,
	})
	Analytics.pacer = pacer
	task.spawn(function()
		while true do
			task.wait(0.25)
			pacer:pump()
		end
	end)
	local function fields(f: { string }?): any
		if f == nil then
			return nil
		end
		local keys = { Enum.AnalyticsCustomFieldKeys.CustomField01, Enum.AnalyticsCustomFieldKeys.CustomField02, Enum.AnalyticsCustomFieldKeys.CustomField03 }
		local out = {}
		for i, v in f do
			out[keys[i].Name] = Analytics.field(v)
		end
		return out
	end
	deps.onboarding = function(player: Player, step: number, name: string)
		if studio then
			print(string.format("[Analytics] onboarding %d %s (%s)", step, name, player.Name))
			return
		end
		pacer:submit(player, AnalyticsService.LogOnboardingFunnelStepEvent, AnalyticsService, player, step, name)
	end
	deps.funnel = function(player: Player, funnel: string, session: string, step: number, name: string, f: { string }?)
		if studio then
			print(string.format("[Analytics] funnel %s %d %s [%s]", funnel, step, name, table.concat(f or {}, ", ")))
			return
		end
		pacer:submit(player, AnalyticsService.LogFunnelStepEvent, AnalyticsService, player, funnel, session, step, name, fields(f))
	end
	deps.custom = function(player: Player, name: string, value: number, f: { string }?)
		if studio then
			print(string.format("[Analytics] event %s = %s [%s]", name, tostring(value), table.concat(f or {}, ", ")))
			return
		end
		pacer:submit(player, AnalyticsService.LogCustomEvent, AnalyticsService, player, name, value, fields(f))
	end
	deps.guid = function(): string
		return HttpService:GenerateGUID(false)
	end
	deps.warn = warn
end
--- Set by ServerMain: load_stats(player, fn(stats?)), save_stats(player, stats), and on a match server
--- classify(owner_id) -> "bot" | "human" | "nation" | "tribe" | nil (the client can't tell bot players).

local entries: { [any]: Entry } = {}

function Analytics.configure(d: { [string]: any })
	for k, v in d do
		deps[k] = v
	end
end

--- Tests: forget everyone.
function Analytics.reset()
	table.clear(entries)
end

local function entry(player: any): Entry
	local e = entries[player]
	if e == nil then
		e = { onboarding = {}, match = nil }
		entries[player] = e
	end
	return e
end

local function call(fn: any, ...: any)
	if fn == nil then
		return
	end
	local ok, err = pcall(fn, ...)
	if not ok and deps.warn then
		deps.warn("[Analytics] " .. tostring(err))
	end
end

Analytics.HUMAN_BANDS = {
	{ 1, 1, "1" },
	{ 2, 4, "2-4" },
	{ 5, 9, "5-9" },
	{ 10, 19, "10-19" },
	{ 20, 29, "20-29" },
	{ 30, 39, "30-39" },
	{ 40, 49, "40-49" },
}

function Analytics.humans_band(n: number): string
	for _, b in Analytics.HUMAN_BANDS do
		if n >= b[1] and n <= b[2] then
			return b[3]
		end
	end
	return if n >= 50 then "50+" else "0"
end

--- A public match started with `humans` real players in `slots` (bots fill the rest). Logged once per
--- match, attributed to one player on the server (AnalyticsService needs a player).
function Analytics.public_start(player: any, humans: number, slots: number, voted: boolean)
	local n = math.clamp(math.floor(tonumber(humans) or 0), 0, 1000)
	local s = math.clamp(math.floor(tonumber(slots) or 0), 0, 1000)
	call(deps.custom, player, "Public Match Humans", n, {
		Analytics.humans_band(n),
		string.format("%d slots", s),
		if voted then "Vote" else "Timer",
	})
end

--- A Quick Play join's outcome (docs/lobby-service.md "Quick Play"), on the hub: `result` "Seated" |
--- "Left Line" | "Timed Out" | "Teleport Failed" | "Unreachable", the value the seconds from asking
--- to that outcome; fields: the result, the kind, how long it took ("First Try" when the first ask
--- found a seat).
function Analytics.public_join(player: any, result: string, mode: string, wait_s: number, first_try: boolean)
	local w = math.clamp(tonumber(wait_s) or 0, 0, 3600)
	local band = if first_try
		then "First Try"
		elseif w < 10 then "Under 10 s"
		elseif w < 30 then "10-30 s"
		elseif w < 60 then "30-60 s"
		else "Over 60 s"
	call(deps.custom, player, "Public Join", math.floor(w * 10 + 0.5) / 10, {
		result,
		if mode == "team" then "Team" elseif mode == "ffa" then "Free For All" elseif mode == "world" then "World" else "Any",
		band,
	})
end

--- A custom field as AnalyticsService takes it. It refuses a field that holds , " or ' and keeps the
--- event with that field empty: v71's "Engine, Memory Under 2 GB" was refused 461 times in its first
--- hour (2026-10-09), and Studio, where events are only printed, had not shown it.
function Analytics.field(v: any): string
	return (string.gsub(tostring(v), "[,\"']", ""))
end

--- A client's memory (MB) as a band.
function Analytics.memory_band(mb: number): string
	return if mb < 1000
		then "Under 1 GB"
		elseif mb < 2000 then "1-2 GB"
		elseif mb < 3000 then "2-3 GB"
		elseif mb < 4000 then "3-4 GB"
		else "4+ GB"
end

--- How far into a match (minutes) something happened.
function Analytics.minute_band(mins: number): string
	return if mins < 5
		then "0-4 min"
		elseif mins < 10 then "5-9 min"
		elseif mins < 20 then "10-19 min"
		elseif mins < 30 then "20-29 min"
		else "30+ min"
end

--- The frame-rate band of a snapshot.
function Analytics.fps_band(fps: number): string
	if fps <= 0 then
		return "Unknown"
	elseif fps < 20 then
		return "Under 20 fps"
	elseif fps < 40 then
		return "20-39 fps"
	end
	return "40+ fps"
end

function Analytics.experience(matches_before: number): string
	if matches_before <= 0 then
		return "1st match"
	elseif matches_before < 5 then
		return "2nd-5th match"
	end
	return "6th+ match"
end

local function onboard(player: any, e: Entry, step: number)
	if e.onboarding[step] then
		return
	end
	e.onboarding[step] = true
	call(deps.onboarding, player, step, Analytics.ONBOARDING[step])
end

local function funnel(player: any, m: Match, step: number)
	if m.steps[step] then
		return
	end
	m.steps[step] = true
	call(deps.funnel, player, Analytics.FUNNEL, m.key, step, Analytics.FUNNEL_STEPS[step], { m.mode, m.exp })
end

local function custom(player: any, name: string, value: number, m: Match?, detail: string?)
	local f = { if m then m.mode else "None", if m then m.exp else "Unknown" }
	if detail ~= nil then
		table.insert(f, detail)
	end
	call(deps.custom, player, name, value, f)
end

local function minutes(v: any): number?
	local n = tonumber(v)
	if n == nil or n ~= n then
		return nil
	end
	return math.floor(math.clamp(n, 0, Analytics.MAX_MINUTES) * 10 + 0.5) / 10
end

local function end_match(player: any, e: Entry, result: string, mins: number?)
	local m = e.match
	if m == nil or m.ended then
		return
	end
	m.ended = true
	if mins ~= nil and mins > m.minutes then
		m.minutes = mins
	end
	custom(player, "Match End", m.minutes, m, result)
	if result == "Quit Game" or result == "Left" then
		-- what was going on when they gave up (the client's last snapshot)
		local pre = if result == "Quit Game" then "Quit" else "Left"
		local snap = m.snap or { situation = "No report", standing = "No land", fps = 0 }
		call(deps.custom, player, pre .. " Situation", m.minutes, { m.mode, snap.situation, snap.standing })
		call(deps.custom, player, pre .. " FPS", snap.fps, { m.mode, Analytics.fps_band(snap.fps), m.exp })
	end
end

function Analytics.joined(player: any)
	onboard(player, entry(player), 1)
end

--- A client's report. Kinds: "title" · "match_start" (mode, map) · "spawned" · "attack" ·
--- "alive" (minutes) · "eliminated" (minutes, killer kind, killer id) · "over" (won, minutes, rank) ·
--- "state" (situation, standing, fps) · "slow" (cause, minutes, fps) · "slow_mem" (cause, MB) ·
--- "left" (minutes) · "help" (where) · "spectate" ·
--- "takeover_offer" · "takeover_click" (client) · "credit_bought" / "credit_used" (kind; the server) ·
--- "starter" ("shown" / "bought": the server; "opened" / "clicked": the client) ·
--- "general" ("opened" (where) / "clicked" / "prompt_done": the client; "subscribed": the server) ·
--- "flag_shop" ("opened" / "clicked" <key> / "clicked_pack" <set>: the client; "bought" <key> <Robux
--- spent> / "bought_pack" <set> <Robux spent>: the server).
function Analytics.report(player: any, kind: any, a: any, b: any, c: any)
	if type(kind) ~= "string" then
		return
	end
	local e = entry(player)
	local m = e.match
	local open = m ~= nil and not m.ended
	if kind == "title" then
		onboard(player, e, 2)
	elseif kind == "match_start" then
		local mode = if type(a) == "string" then Analytics.MODES[a] else nil
		if mode == nil then
			return
		end
		local map = if type(b) == "string" and #b <= 40 and string.match(b, "^[%w_@%-]+$") then b else "unknown"
		if open then
			end_match(player, e, "Left")
		end
		local nm: Match = {
			mode = mode,
			exp = "Unknown",
			map = map,
			key = if deps.guid then deps.guid() else tostring(os.clock()),
			steps = {},
			minutes = 0,
			ended = false,
		}
		e.match = nm
		onboard(player, e, 3)
		local function with_stats(stats: any)
			local n = if type(stats) == "table" then tonumber(stats.matches) or 0 else 0
			nm.exp = Analytics.experience(n)
			call(deps.save_stats, player, { matches = math.min(n + 1, 1000000) })
			if n >= 1 then
				onboard(player, e, 8)
			end
			funnel(player, nm, 1)
			custom(player, "Match Start", 1, nm, nm.map)
		end
		if deps.load_stats then
			call(deps.load_stats, player, with_stats)
		else
			with_stats(nil)
		end
	elseif kind == "spawned" then
		if open then
			onboard(player, e, 4)
			funnel(player, m :: Match, 2)
		end
	elseif kind == "attack" then
		if open then
			onboard(player, e, 5)
			funnel(player, m :: Match, 3)
		end
	elseif kind == "alive" then
		local mins = minutes(a)
		if not open or mins == nil then
			return
		end
		local mm = m :: Match
		if mins > mm.minutes then
			mm.minutes = mins
		end
		if mm.minutes >= 3 then
			onboard(player, e, 6)
			funnel(player, mm, 4)
		end
		if mm.minutes >= 10 then
			onboard(player, e, 7)
			funnel(player, mm, 5)
		end
	elseif kind == "eliminated" then
		if not open then
			return
		end
		local mins = minutes(a) or (m :: Match).minutes
		local killer = nil
		local id = tonumber(c)
		if id ~= nil and deps.classify then
			local ok, k = pcall(deps.classify, id)
			if ok and type(k) == "string" then
				killer = Analytics.KILLERS[k]
			end
		end
		if killer == nil then
			-- the client only knows nation / tribe / player (bot players look like players)
			killer = if b == "nation" or b == "tribe" then Analytics.KILLERS[b] else "Unknown"
		end
		custom(player, "Eliminated", mins, m, killer)
		end_match(player, e, "Eliminated", mins)
	elseif kind == "over" then
		if not open then
			return
		end
		funnel(player, m :: Match, 6)
		local rank = tonumber(c)
		if rank ~= nil and rank >= 1 and rank <= Analytics.MAX_RANK then
			custom(player, "Final Rank", math.floor(rank), m)
		end
		end_match(player, e, if a == true then "Won" else "Lost", minutes(b))
	elseif kind == "state" then
		if not open or not Analytics.SITUATIONS[a] or not Analytics.STANDINGS[b] then
			return
		end
		local fps = tonumber(c) or 0
		if fps ~= fps then
			fps = 0
		end
		local mm = m :: Match
		mm.snap = {
			situation = a,
			standing = b,
			fps = math.floor(math.clamp(fps, 0, Analytics.MAX_FPS)),
		}
	elseif kind == "slow" then
		-- (once a match, and after its end too: a player who keeps watching is still playing the game)
		local cause = if type(a) == "string" then Analytics.SLOW_CAUSES[a] else nil
		local mins = minutes(b)
		local fps = tonumber(c)
		if m == nil or m.slow or cause == nil or mins == nil or fps == nil or fps ~= fps then
			return
		end
		m.slow = true
		call(deps.custom, player, "Slow Frames", math.floor(math.clamp(fps, 0, Analytics.MAX_FPS)), {
			m.mode,
			cause,
			Analytics.minute_band(mins),
		})
	elseif kind == "slow_mem" then
		-- (with "slow": the client's memory while its frames were slow)
		local cause = if type(a) == "string" then Analytics.SLOW_CAUSES[a] else nil
		local mb = tonumber(b)
		if m == nil or m.slow_mem or cause == nil or mb == nil or mb ~= mb then
			return
		end
		m.slow_mem = true
		local held = math.floor(math.clamp(mb, 0, Analytics.MAX_MEMORY_MB))
		call(deps.custom, player, "Slow Frames Memory", held, { m.mode, cause, Analytics.memory_band(held) })
	elseif kind == "left" then
		if open then
			end_match(player, e, "Left", minutes(a))
		end
	elseif kind == "help" then
		custom(player, "How To Play", 1, if open then m else nil, if type(a) == "string" then Analytics.WHERE[a] else nil)
	elseif kind == "spectate" then
		custom(player, "Spectate", 1, nil)
	elseif kind == "takeover_offer" or kind == "takeover_click" then
		-- the solo takeover offer (client, once per match each): shown, then pressed
		custom(player, if kind == "takeover_offer" then "Takeover Offered" else "Takeover Clicked", 1, m)
	elseif kind == "credit_bought" or kind == "credit_used" then
		-- (the server: a receipt stored / a credit spent; b: how many it stored, the 3-crate pack 3)
		if a == "takeover" then
			custom(player, if kind == "credit_bought" then "Takeover Bought" else "Takeover Used", 1, m)
		elseif a == "crate" and kind == "credit_bought" then
			local n = math.clamp(math.floor(tonumber(b) or 1), 1, 10)
			custom(player, "Crate Bought", n, nil, if n > 1 then "Pack of " .. n else "Single")
		end
	elseif kind == "crate_shop" or kind == "crate_click" then
		-- the crate screen opened / its buy button pressed (client, once per visit each)
		custom(player, if kind == "crate_shop" then "Crate Shop Opened" else "Crate Clicked", 1, nil)
	elseif kind == "crate_opened" then
		-- (the server) detail: the item's rarity
		local it = if type(a) == "string" then deps.cosmetic and deps.cosmetic(a) else nil
		custom(player, "Crate Opened", 1, nil, if it then Analytics.RARITY_NAMES[it.rarity] else nil)
	elseif kind == "equipped" then
		custom(player, "Item Equipped", 1, nil, if a == "skin" then "Skin" elseif a == "flag" then "Flag" else nil)
	elseif kind == "tutorial" then
		-- (client) a tutorial step: the "Tutorial" funnel (Data/Tutorial.FUNNEL), each step once a match
		local step = tonumber(a)
		local names = deps.tutorial_steps or {}
		if m == nil or step == nil or names[step] == nil then
			return
		end
		m.tutorial = m.tutorial or {}
		if m.tutorial[step] then
			return
		end
		m.tutorial[step] = true
		call(deps.funnel, player, "Tutorial", m.key, step, names[step], { m.mode, m.exp })
	elseif kind == "tutorial_skip" then
		-- (client) Skip was pressed; detail: the step it was on
		local names = deps.tutorial_steps or {}
		local step = math.clamp(math.floor(tonumber(a) or 1), 1, math.max(#names - 2, 1))
		custom(player, "Tutorial Skipped", 1, m, names[step + 1] or "Unknown")
	elseif kind == "hop" then
		-- (the server) a solo start on an outdated server: Sent to a fresh one / None listed / Failed
		custom(player, "Fresh Server Hop", 1, nil, if a == "sent" then "Sent" elseif a == "none" then "None" else "Failed")
	elseif kind == "arsenal_shop" then
		-- the Arsenal opened (client, once per visit); detail: from where
		custom(player, "Arsenal Opened", 1, if open then m else nil, Analytics.ARSENAL_FROM[a] or "Title")
	elseif kind == "arsenal_view" then
		-- (client) an item's row pressed in the Arsenal, once per item per visit; detail: the item
		local title = if type(a) == "string" and deps.arsenal_title then deps.arsenal_title(a) else nil
		if title ~= nil then
			custom(player, "Arsenal Viewed", 1, if open then m else nil, title)
		end
	elseif kind == "arsenal_click" or kind == "unlocked" then
		-- a buy button pressed (client) / an item unlocked (the server): detail "<Item> for <Stars|Robux>"
		local title = if type(a) == "string" and deps.arsenal_title then deps.arsenal_title(a) else nil
		if title ~= nil then
			local how = if b == "stars" then "Stars" else "Robux"
			custom(
				player,
				if kind == "unlocked" then "Arsenal Unlocked" else "Arsenal Clicked",
				1,
				if open then m else nil,
				title .. " for " .. how
			)
		end
	elseif kind == "starter" then
		-- the starter pack (Data/Starter): "shown" (the server: its clock started, once per player),
		-- "opened" (client: the offer's window, once per visit; b = "auto" | "button"), "clicked"
		-- (client: BUY pressed), "bought" (the server: the receipt granted)
		local names = { shown = "Shown", opened = "Opened", clicked = "Clicked", bought = "Bought" }
		local action = if type(a) == "string" then names[a] else nil
		if action ~= nil then
			custom(player, "Starter Pack", 1, nil, action)
		end
	elseif kind == "general" then
		-- RoWorld General (Data/Subscription; 2026-10-27): "opened" (client: its window; b = where from),
		-- "clicked" (client: SUBSCRIBE pressed), "prompt_done" (client: Roblox's prompt closed after a
		-- try to buy), "subscribed" (the server: Roblox says so, server/General)
		local names = { opened = "Opened", clicked = "Clicked", prompt_done = "Prompt Done", subscribed = "Subscribed" }
		local action = if type(a) == "string" then names[a] else nil
		if action ~= nil then
			custom(player, "General", 1, nil, action)
		end
	elseif kind == "flag_shop" then
		-- the flag shop (Data/Shop): "Flag Shop" Opened (client, once per visit) / Clicked (client, a
		-- flag's buy button) / Bought (the server, the receipt granted); a purchase also logs "Flag
		-- Bought", worth the Robux paid (the receipt's; its set price without one), the flag's name as the
		-- detail (each flag's takings)
		local names = {
			opened = "Opened",
			clicked = "Clicked",
			bought = "Bought",
			clicked_pack = "Clicked Pack",
			bought_pack = "Bought Pack",
		}
		local action = if type(a) == "string" then names[a] else nil
		if action == nil then
			return
		end
		custom(player, "Flag Shop", 1, nil, action)
		local lookup = if a == "bought" then deps.shop_flag elseif a == "bought_pack" then deps.shop_pack else nil
		if lookup ~= nil and type(b) == "string" then
			local name, robux = lookup(b)
			local paid = if type(c) == "number" and c == c and c >= 0 then c else tonumber(robux) or 0
			if name ~= nil then
				custom(player, "Flag Bought", math.floor(paid), nil, name)
			end
		end
	elseif kind == "stars_paid" then
		-- (the server) value: the Stars a match paid
		local n = tonumber(a)
		if n ~= nil and n == n then
			custom(player, "Stars Earned", math.clamp(math.floor(n), 0, 1000000), if m ~= nil then m else nil)
		end
	end
end

--- Who on this server is doing what now, for the lobby service's live stats page (how many people
--- are playing solos, 2026-09-28): players in an unfinished solo match (by difficulty) and the
--- rest (title screen, spectating, between matches). `players` = everyone on the server.
--- True while `player` plays a solo match (a party leader's match does not take them out of it).
function Analytics.in_solo(player: any): boolean
	local e = entries[player]
	local m = if e then e.match else nil
	return m ~= nil and not m.ended and string.sub(m.mode, 1, 5) == "Solo "
end

function Analytics.presence(players: { any }): { [string]: number }
	local out = { players = #players, solo = 0, solo_easy = 0, solo_medium = 0, solo_hard = 0, title = 0 }
	for _, p in players do
		local e = entries[p]
		local m = if e then e.match else nil
		if m ~= nil and not m.ended and string.sub(m.mode, 1, 5) == "Solo " then
			out.solo += 1
			if m.mode == "Solo Easy" then
				out.solo_easy += 1
			elseif m.mode == "Solo Hard" then
				out.solo_hard += 1
			else
				out.solo_medium += 1
			end
		else
			out.title += 1
		end
	end
	return out
end

function Analytics.left(player: any)
	local e = entries[player]
	if e == nil then
		return
	end
	end_match(player, e, "Quit Game")
	entries[player] = nil
end

return Analytics
]]></string>
        </Properties>
      </Item>
