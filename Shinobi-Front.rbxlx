      <Item class="ModuleScript" referent="97">
        <Properties>
          <string name="Name">MatchServer</string>
          <string name="Source"><![CDATA[--!strict
-- Port of the server half of scripts/net/session.gd: the shared multiplayer match.
-- LOBBY (countdown after the first player queues) → SPAWN → PLAYING → OVER (results) → LOBBY/IDLE,
-- one Sim, per-tick deltas to participants only, a cached compressed snapshot for late joiners,
-- intent sanitising + rate limits, idle drop between matches.
--
-- Pure logic with injected dependencies so it runs headless in Lune (tests/net_server.luau) and on a
-- Roblox server (ServerMain.luau wires Players/RemoteEvents/Heartbeat). Peers are opaque keys (Player
-- instances on Roblox, tables in tests).
--
--   deps = {
--     make_sim = function(config) -> Sim,          -- Sim.new(WorldMap.get(config.map_id), config)
--     pick_map = function() -> string?,          -- optional: map id of the next match (default
--                                                -- MatchServer.MP_MAP_ID, else the default map)
--     send = function(peer, op, ...),             -- one ordered reliable message to a peer
--     peers = function() -> { peer },             -- connected peers that are listening (lobby info)
--     now_ms = function() -> number,              -- monotonic milliseconds
--     log = function(text)?,
--     seed = function() -> number?,
--     lobby = {                                   -- optional: a public-lobby match server
--       countdown = function() -> number?,        --   seconds to the lobby's start (nil = unknown yet)
--       info = function() -> {map_id, max}?,      --   the lobby's map and player cap
--       on_start = function(humans, voted) -> number, -- bot players to add (fills the empty slots);
--                                                 --   voted: started by the players' vote
--       bot_names = function(n, taken) -> {string},
--       on_over = function(peers),                --   the match is over: send them back to a hub
--       on_closed = function()?,                  --   everyone left mid-match: it is gone
--       on_vote_start = function(seconds)?,       --   the waiting players voted to start early
--     },
--     bot_faces = {number}?,                      -- Roblox user ids: the head shots bot players wear
--   }

-- Roblox: ReplicatedStorage.Airfront.Net; Lune: the source tree.
local Net: any = if (game :: any) ~= nil then (game :: any):GetService("ReplicatedStorage").Airfront.Net else nil
local Protocol = if Net then require(Net.Protocol) else require("../shared/Net/Protocol")
local Coop = if Net then require(Net.Coop) else require("../shared/Net/Coop")
local Cosmetics: any = if Net then require(Net.Parent.Data.Cosmetics) else require("../shared/Data/Cosmetics")
local Stars: any = if Net then require(Net.Parent.Data.Stars) else require("../shared/Data/Stars")


local MatchServer = {}
MatchServer.__index = MatchServer
--- Bot players dress like players (they must look like people): this share wears a flag, this share a
--- skin (Common / Rare ones), picked at the start of the match. Fairly rare, as with people (toned
--- down 2026-09-29: bots wore too many skins and flags at 40% / 20%): about 2-3 flags
--- and a skin among 30 bots.
MatchServer.BOT_FLAG_SHARE = 0.08
MatchServer.BOT_SKIN_SHARE = 0.04

MatchServer.STAGE_IDLE = "idle"
MatchServer.STAGE_LOBBY = "lobby"
MatchServer.STAGE_SPAWN = "spawn"
MatchServer.STAGE_PLAYING = "playing"
MatchServer.STAGE_OVER = "over"

MatchServer.TICK_SEC = 1.0 / 10
MatchServer.LOBBY_COUNTDOWN_SEC = 15.0
MatchServer.REMATCH_COUNTDOWN_SEC = 12.0
MatchServer.RESULTS_SEC = 18.0
--- Once VOTE_SHARE of the waiting players voted to start, the match starts this soon.
MatchServer.VOTE_SHARE = 2 / 3 -- (2026-09-27; was more than half)
MatchServer.VOTE_START_S = 10.0
--- Vote start needs at least this many players waiting (2026-09-26)...
MatchServer.VOTE_MIN_PLAYERS = 2
--- ...except a player who has waited alone in a public match's waiting room this long (2026-09-27).
MatchServer.VOTE_SOLO_AFTER_S = 30.0
--- The last seconds before a public match starts, the bot players that will fill it show up in the
--- waiting room's player list one by one, like players joining (bots look like players; 2026-09-27).
MatchServer.FILL_REVEAL_S = 10.0
--- How the joins spread over that window (fill_schedule): arrivals thicken toward the start (their
--- times follow window * u^(1 / FILL_RAMP)), and now and then someone follows the previous joiner
--- a moment later (FILL_PARTY_CHANCE, FILL_PARTY_GAP_S), like friends joining together.
MatchServer.FILL_RAMP = 1.8
MatchServer.FILL_PARTY_CHANCE = 0.3
MatchServer.FILL_PARTY_GAP_S = { 0.06, 0.45 }
--- Nation difficulty of multiplayer matches. Public games ran Medium nations, but new
--- players were being overrun (2026-09-27): Easy nations; the Sim.SMART_BOTS smart bot players
--- stay Medium, the other bot players are novices.
MatchServer.MP_DIFFICULTY = 0
--- Core/Teams.HVN (a lobby's `teams` for Humans Vs Nations).
MatchServer.HVN = "Humans Vs Nations"
--- Tribes per match (nil: Sim.default_tribes, 400).
MatchServer.MP_TRIBES = nil :: number?
--- Map of the multiplayer matches when deps.pick_map is not given (nil: MapList.DEFAULT).
MatchServer.MP_MAP_ID = nil :: string?
--- (LobbyRules.MAX_PLAYERS: a public lobby seats up to 50 since 2026-10-19; it was 32 over 30-seat lobbies)
MatchServer.MP_MAX_HUMANS = 50
MatchServer.MP_SPAWN_TICKS = 200
MatchServer.MP_TIME_LIMIT_S = 40 * 60
MatchServer.NOTICE_INFO = 0
MatchServer.NOTICE_WARNING = 1
MatchServer.NOTICE_ERROR = 2
MatchServer.MAX_INTENTS_PER_SEC = 30
MatchServer.JOIN_COOLDOWN_MSEC = 2000
--- A peer may ask for a fresh snapshot (RESYNC, after its mirror failed a delta) this often.
MatchServer.RESYNC_COOLDOWN_MSEC = 10000
--- A failing Sim step / encode ends the match after this many failures in a row, or this many in one
--- match (each failure is followed by a snapshot resync of every participant).
MatchServer.MAX_STEP_FAILURES_IN_ROW = 3
MatchServer.MAX_STEP_FAILURES = 10
MatchServer.STEP_FAILED_NOTICE = "The match ran into a problem. You're back at the title screen."
--- Participants idle this long are not carried into the next match.
MatchServer.IDLE_DROP_MSEC = 5 * 60 * 1000
--- Catch-up cap: at most this many ticks are stepped after a server hitch.
MatchServer.MAX_CATCHUP_TICKS = 6
--- ... and only while a frame has spent less than this on them (one always runs). A server whose
--- steps take 100 ms or more never catches up: it ran all 6 in every frame, frames of 0.6 s and up
--- with everyone's orders and updates waiting on them (2026-11-01: the dashboard's server frame
--- rate P10 has been 1-4 fps at night since 2026-10-26; ServerPerf reports which servers). Now it
--- runs about one a frame: the match runs a little slower than the clock, and the server answers.
MatchServer.CATCHUP_BUDGET_S = 0.05
--- Match construction runs as a Coop job with this budget per server frame (never a long hitch
--- for the players already connected, as long as the Core loops call Coop.check()).
MatchServer.BUILD_BUDGET_S = 0.012

-- Wire constants mirrored from Core (kept local so this module has no Sim dependency).
local EV_MSG = 19
local EV_BONUS = 34
local PHASE_PLAYING = 1
local PHASE_OVER = 2

local OP = Protocol.OP
local STAGE_IDLE, STAGE_LOBBY, STAGE_SPAWN, STAGE_PLAYING, STAGE_OVER = "idle", "lobby", "spawn", "playing", "over"

--- `spectator`: watching only (arrived through a hub's Watch): no nation, never counted as a player,
--- gets the snapshot and the public deltas. `voted`: wants the waiting match to start now.
export type Participant = {
	uid: string,
	key: string,
	name: string,
	owner: number,
	active_msec: number,
	spectator: boolean,
	voted: boolean,
}

local function is_private(e: any): number?
	if e[1] == EV_MSG and e[2] ~= -1 then
		return e[2]
	end
	-- gold a player earned at a tile (a train's stop): their own map shows it, nobody else's
	if e[1] == EV_BONUS then
		return e[2]
	end
	return nil
end

function MatchServer.new(deps: { [string]: any })
	local self = setmetatable({}, MatchServer)
	self.deps = deps
	self.lobby_countdown_sec = MatchServer.LOBBY_COUNTDOWN_SEC
	self._stage = STAGE_IDLE
	self._stage_time = 0.0
	self._mp_sim = nil :: any
	self._mp_acc = 0.0
	self._mp_started_msec = 0
	-- peer -> participant; `_order` keeps insertion order (GDScript Dictionary order)
	self._participants = {} :: { [any]: Participant }
	self._order = {} :: { any }
	self._intent_budget = {} :: { [any]: number }
	--- Troops promised to each donation recipient this Sim tick (cap_donation).
	self._donated = {} :: { [any]: number }
	self._last_join_msec = {} :: { [any]: number }
	--- JOINs that arrived inside the cooldown: admitted when it expires instead of being dropped
	--- (a quick "Leave queue" → "Queue" would otherwise strand the client on its queue card).
	self._pending_join = {} :: { [any]: { uid: string, name: string, key: string? } }
	self._last_resync_msec = {} :: { [any]: number }
	self._step_failures_row = 0
	self._step_failures = 0
	self._step_errors_seen = {} :: { [string]: boolean }
	self._resync_all = false
	self._snap_tick = -1
	self._snap = nil :: buffer?
	self._budget_time = 0.0
	self._lobby_broadcast_time = 0.0
	self._closed = false
	--- a public-lobby match that has been played (lobby mode): later joiners go back to a hub
	self._finished = false
	--- ms (now_ms clock) at which a vote-started lobby begins (nil: no vote passed)
	self._vote_start_at = nil :: number?
	--- public waiting room: since when exactly one player is waiting (VOTE_SOLO_AFTER_S)
	self._alone_since = nil :: number?
	--- public waiting room: the bot players shown joining (FILL_REVEAL_S): names, when each shows up
	--- (server msec, ascending), how many show, and the lobby's size
	self._fill = nil :: { names: { string }, at: { number }, shown: number, max: number }?
	self._start_job = nil :: any
	--- Map id of the running match, or of the next one while no match runs (lobby info carries it
	--- so clients can download the map before the snapshot arrives). nil = the default map.
	self._map_id = self:_pick_map()
	-- instrumentation (read by ServerMain / tests)
	self.stats = {
		steps = 0,
		step_ms_total = 0.0,
		step_ms_max = 0.0,
		step_ms = {} :: { number },
		encode_ms_total = 0.0,
		bytes_sent = 0,
		deltas_sent = 0,
		delta_bytes_max = 0,
		snapshots_sent = 0,
		snapshot_bytes = 0,
		intents_ok = 0,
		intents_dropped = 0,
		catchup_frames = 0, -- frames that stepped more than one tick
		budget_stops = 0, -- frames that left ticks for the next one (CATCHUP_BUDGET_S)
	}
	return self
end

function MatchServer._pick_map(self: any): string?
	local pick = self.deps.pick_map
	if pick ~= nil then
		local ok, id = pcall(pick)
		if ok and type(id) == "string" then
			return id
		end
	end
	return MatchServer.MP_MAP_ID
end

function MatchServer._log(self: any, text: string)
	local log = self.deps.log
	if log then
		log(text)
	end
end

function MatchServer._now(self: any): number
	return self.deps.now_ms()
end

function MatchServer._send(self: any, peer: any, op: number, ...: any)
	self.deps.send(peer, op, ...)
end

function MatchServer.stage(self: any): string
	return self._stage
end

function MatchServer.participant(self: any, peer: any): Participant?
	return self._participants[peer]
end

function MatchServer.participant_count(self: any): number
	return #self._order
end

function MatchServer.sim(self: any): any
	return self._mp_sim
end

-- =============================================================================================
-- Client requests
-- =============================================================================================

--- A peer asks to queue for / join the match. `info = {uid = account id, name = display name}`.
function MatchServer.join(self: any, peer: any, info: { uid: string, name: string, key: string?, spectate: boolean? })
	if self._closed then
		return
	end
	local now = self:_now()
	local last = self._last_join_msec[peer]
	if last ~= nil and now - last < MatchServer.JOIN_COOLDOWN_MSEC then
		if self._participants[peer] == nil then
			self._pending_join[peer] = info
		end
		return
	end
	self._pending_join[peer] = nil
	self._last_join_msec[peer] = now
	if self._participants[peer] ~= nil then
		-- Double-tapped JOIN: already queued or already playing. Nothing to rebuild.
		self:broadcast_lobby()
		return
	end
	local nice = string.gsub(tostring(info.name or ""), "^%s*(.-)%s*$", "%1")
	-- at most 20 characters (UTF-8 safe; invalid UTF-8 is dropped)
	if utf8.len(nice) == nil then
		nice = ""
	else
		local cut = utf8.offset(nice, 21)
		if cut ~= nil then
			nice = string.sub(nice, 1, cut - 1)
		end
	end
	if nice == "" then
		nice = "Commander"
	end
	-- Keyed by account so a dropped player reconnects to their own nation.
	local key = info.key or info.uid
	local spectator = info.spectate == true
	self._participants[peer] = {
		uid = info.uid,
		key = key,
		name = nice,
		owner = 0,
		active_msec = now,
		spectator = spectator,
		voted = false,
	}
	table.insert(self._order, peer)
	self:_log(string.format("[Session] %s joined multiplayer, stage=%s", nice, self._stage))
	if self._finished then
		-- a public match that already ended: straight back to a hub
		local lobby = self.deps.lobby
		if lobby then
			lobby.on_over({ peer })
		end
		return
	end
	if self._stage == STAGE_IDLE then
		if not spectator then
			self:_set_stage(STAGE_LOBBY, self:_lobby_countdown())
		end
	elseif self._stage == STAGE_SPAWN or self._stage == STAGE_PLAYING or (spectator and self._stage == STAGE_OVER) then
		self:_admit(peer)
	end
	self:broadcast_lobby()
end

--- Seconds until the match starts from the lobby stage: the public lobby's own start time on a
--- match server (a long wait while it is still unknown), else the fixed countdown.
function MatchServer._lobby_countdown(self: any): number
	local lobby = self.deps.lobby
	local cd = self.lobby_countdown_sec
	if lobby ~= nil then
		local ok, v = pcall(lobby.countdown)
		cd = if ok and type(v) == "number" then math.max(v, 0.0) else 3600.0
	end
	if self._vote_start_at ~= nil then
		cd = math.min(cd, math.max(0.0, (self._vote_start_at - self:_now()) / 1000.0))
	end
	return cd
end

--- Players waiting in the lobby who voted to start, and how many votes start the match (two thirds
--- of the players here, rounded up; watchers don't vote).
function MatchServer.vote_counts(self: any): (number, number, number)
	local players, votes = 0, 0
	for _, p in self._order do
		local part = self._participants[p]
		if part ~= nil and not part.spectator then
			players += 1
			if part.voted then
				votes += 1
			end
		end
	end
	return votes, math.max(1, math.ceil(players * MatchServer.VOTE_SHARE - 1e-9)), players
end

--- Players needed before a vote can start the match: VOTE_MIN_PLAYERS, or 1 once a player has waited
--- alone in a public waiting room for VOTE_SOLO_AFTER_S.
function MatchServer.vote_min_players(self: any): number
	if self.deps.lobby ~= nil and self._alone_since ~= nil and self:_now() - self._alone_since >= MatchServer.VOTE_SOLO_AFTER_S * 1000 then
		return 1
	end
	return MatchServer.VOTE_MIN_PLAYERS
end

--- A player toggles their vote to start the waiting match early; once VOTE_SHARE of the players
--- here voted (and at least vote_min_players are here), it starts in VOTE_START_S (locked in: later
--- joiners or unvotes don't cancel it).
function MatchServer.vote_start(self: any, peer: any)
	local part = self._participants[peer]
	if part == nil or part.spectator or self._stage ~= STAGE_LOBBY or self._start_job ~= nil then
		return
	end
	part.voted = not part.voted
	self:_check_votes()
	self:broadcast_lobby()
end

function MatchServer._check_votes(self: any)
	if self._vote_start_at ~= nil or self._stage ~= STAGE_LOBBY then
		return
	end
	local votes, need, players = self:vote_counts()
	if players >= self:vote_min_players() and votes >= need then
		self._vote_start_at = self:_now() + MatchServer.VOTE_START_S * 1000
		if self.deps.lobby == nil then
			self._stage_time = math.min(self._stage_time, MatchServer.VOTE_START_S)
		elseif self.deps.lobby.on_vote_start then
			pcall(self.deps.lobby.on_vote_start, MatchServer.VOTE_START_S)
		end
		self:_log(string.format("[Session] %d of %d players voted to start", votes, players))
	end
end

function MatchServer.leave(self: any, peer: any)
	self._pending_join[peer] = nil
	self:_drop_participant(peer)
	-- fewer players waiting: the others' votes may now be enough
	self:_check_votes()
end

--- The peer's mirror failed a delta: resend the full state (rate-limited per peer).
function MatchServer.resync(self: any, peer: any)
	local part = self._participants[peer]
	if self._mp_sim == nil or part == nil or (part.owner == 0 and not part.spectator) then
		return
	end
	local now = self:_now()
	local last = self._last_resync_msec[peer]
	if last ~= nil and now - last < MatchServer.RESYNC_COOLDOWN_MSEC then
		return
	end
	self._last_resync_msec[peer] = now
	self:_log(string.format("[Session] resync requested by %s", part.name))
	self:_send_snapshot(peer)
end

--- A fallen player may take over the AI nation that eliminated them (a paid takeover, Sim.take_over:
--- nations only, so bot players stay indistinguishable from people).
function MatchServer.can_take_over(self: any, peer: any, target: number): boolean
	local sim = self._mp_sim
	local part = self._participants[peer]
	if sim == nil or part == nil or part.owner == 0 or part.spectator or self._stage ~= STAGE_PLAYING then
		return false
	end
	if type(target) ~= "number" or sim.o_killer[part.owner] ~= target then
		return false
	end
	return sim:can_take_over(part.owner, target)
end

--- The takeover itself (after its credit was spent): the peer commands `target` from now on.
function MatchServer.take_over(self: any, peer: any, target: number): boolean
	if not self:can_take_over(peer, target) then
		return false
	end
	local part = self._participants[peer]
	local old = part.owner
	if not self._mp_sim:take_over(old, target) then
		return false
	end
	part.owner = target
	part.active_msec = self:_now()
	-- a new life: its Stars are counted from here (the first life was paid when it fell)
	if self._tracker ~= nil then
		self._tracker:adopt(old, target)
	end
	part.paid = false
	self:_send(peer, OP.OWNER_CHANGED, target)
	-- the nation wears its new commander's cosmetics
	self:_broadcast_cosmetics()
	self:_log(string.format("[Takeover] %s took over %s", part.name, tostring(self._mp_sim.o_name[target])))
	return true
end

--- An encoded intent from a peer (untrusted). Returns true when it reached the Sim.
function MatchServer.intent(self: any, peer: any, payload: any): boolean
	local sim = self._mp_sim
	if sim == nil then
		return false
	end
	local part = self._participants[peer]
	if part == nil or part.owner == 0 then
		return false
	end
	local used = self._intent_budget[peer] or 0
	if used >= MatchServer.MAX_INTENTS_PER_SEC then
		self.stats.intents_dropped += 1
		return false
	end
	self._intent_budget[peer] = used + 1
	local clean = Protocol.decode_intent(payload)
	if clean == nil then
		self.stats.intents_dropped += 1
		return false
	end
	part.active_msec = self:_now()
	if clean.type == "donate" then
		MatchServer.cap_donation(sim, clean, self._donated)
	end
	sim:submit(part.owner, clean)
	self.stats.intents_ok += 1
	return true
end

--- Server-side twin of the UI's donation cap (UIRules.donate_plan): a donation never exceeds what
--- tick already promised it). The Sim itself accepts any amount (that rule stays as it is on
--- purpose), but troops far above the cap make Rules.troop_growth subtract more than the nation
--- original), but troops far above the cap make Rules.troop_growth subtract more than the nation
--- has (review_gameplay R2-8): a huge gift could push a small ally's troops negative.
--- `pending` = {tick = n, [target] = troops promised this tick} (reset when the Sim tick moves).
function MatchServer.cap_donation(sim: any, it: { [string]: any }, pending: { [any]: number }?)
	local target = tonumber(it.target) or 0
	local caps, troops = sim.o_cap, sim.o_troops
	if target <= 0 or type(caps) ~= "table" or type(troops) ~= "table" then
		return
	end
	local cap = tonumber(caps[target]) or 0
	if cap <= 0 then
		return
	end
	local promised = 0
	if pending ~= nil then
		local tick = tonumber(sim.tick) or 0
		if pending.tick ~= tick then
			table.clear(pending)
			pending.tick = tick
		end
		promised = pending[target] or 0
	end
	local room = math.max(0, math.floor(cap - (tonumber(troops[target]) or 0) - promised))
	local amount = math.clamp(tonumber(it.troops) or 0, 0, room)
	it.troops = amount
	if pending ~= nil and amount > 0 then
		pending[target] = promised + amount
	end
end

--- Dispatches one client → server message (after the transport checked `op` is a number).
--- `who = {uid = account key, name = display name}` comes from the trusted server-side Player.
function MatchServer.on_client(self: any, peer: any, who: { uid: string, name: string }, op: number, ...: any)
	-- Someone is at the controls: intents, a (re)queue, or ACTIVE (the client reports user input at
	-- most every 30 s, so a player watching the end of a match is not idle-dropped at the rematch;
	-- session.gd only counted intents).
	local part = self._participants[peer]
	if part ~= nil and (op == OP.INTENT or op == OP.ACTIVE or op == OP.JOIN) then
		part.active_msec = self:_now()
	end
	if op == OP.INTENT then
		self:intent(peer, (...))
	elseif op == OP.JOIN then
		self:join(peer, who)
	elseif op == OP.LEAVE then
		self:leave(peer)
	elseif op == OP.RESYNC then
		self:resync(peer)
	elseif op == OP.VOTE_START then
		self:vote_start(peer)
	end
end

--- The peer's connection went away (Roblox PlayerRemoving).
function MatchServer.peer_disconnected(self: any, peer: any)
	self._pending_join[peer] = nil
	self:_drop_participant(peer)
	self._last_join_msec[peer] = nil
	self._last_resync_msec[peer] = nil
	self:_check_votes()
end

-- =============================================================================================
-- Frame processing
-- =============================================================================================

function MatchServer.process(self: any, delta: number)
	if self._closed then
		return
	end
	self._budget_time += delta
	if self._budget_time >= 1.0 then
		self._budget_time = 0.0
		table.clear(self._intent_budget)
	end
	self._lobby_broadcast_time += delta
	if self._lobby_broadcast_time >= 1.0 then
		self._lobby_broadcast_time = 0.0
		self:broadcast_lobby()
	end
	if next(self._pending_join) ~= nil then
		self:_admit_pending_joins()
	end

	local stage = self._stage
	if stage == STAGE_LOBBY then
		if self.deps.lobby ~= nil and self._start_job == nil then
			self._stage_time = self:_lobby_countdown()
			self:_public_waiting_room()
		else
			self._stage_time -= delta
		end
		if #self._order == 0 then
			self._start_job = nil
			self:_set_stage(STAGE_IDLE, 0.0)
		elseif self._start_job ~= nil then
			self:_continue_start()
		elseif self._stage_time <= 0.0 then
			self:_start_match()
		end
	elseif stage == STAGE_SPAWN or stage == STAGE_PLAYING then
		local tick_sec = MatchServer.TICK_SEC
		self._mp_acc = math.min(self._mp_acc + delta, tick_sec * MatchServer.MAX_CATCHUP_TICKS)
		local clock = self.deps.clock or os.clock
		local t0 = clock()
		local n = 0
		while self._mp_acc >= tick_sec and self._mp_sim ~= nil do
			if n > 0 and clock() - t0 >= MatchServer.CATCHUP_BUDGET_S then
				self.stats.budget_stops += 1
				break
			end
			self._mp_acc -= tick_sec
			self:_server_step()
			n += 1
		end
		if n > 1 then
			self.stats.catchup_frames += 1
		end
	elseif stage == STAGE_OVER then
		self._stage_time -= delta
		if self._stage_time <= 0.0 and self.deps.lobby ~= nil then
			-- a public match is played once: everyone back to a hub
			self._finished = true
			local peers = table.clone(self._order)
			self:_close_match()
			table.clear(self._participants)
			table.clear(self._order)
			self:_set_stage(STAGE_IDLE, 0.0)
			self.deps.lobby.on_over(peers)
			return
		end
		if self._stage_time <= 0.0 then
			self:_close_match()
			self:_drop_idle_participants()
			if #self._order == 0 then
				self:_set_stage(STAGE_IDLE, 0.0)
			else
				self:_set_stage(STAGE_LOBBY, MatchServer.REMATCH_COUNTDOWN_SEC)
			end
		end
	end
end

--- Per frame in a public match's waiting room: the lone-player clock (a vote may pass once it runs
--- out) and the bot players showing up in the last FILL_REVEAL_S.
function MatchServer._public_waiting_room(self: any)
	local _, _, players = self:vote_counts()
	if players == 1 then
		if self._alone_since == nil then
			self._alone_since = self:_now()
		end
		self:_check_votes()
	else
		self._alone_since = nil
	end
	if self._fill == nil and players > 0 and self._stage_time <= MatchServer.FILL_REVEAL_S then
		self:_prepare_fill(players)
	end
	local fill = self._fill
	if fill ~= nil then
		-- (by the server's msec clock: the lobby countdown moves in whole seconds live, which showed
		-- each second's joiners in one burst)
		local now = self:_now()
		local shown = fill.shown
		while shown < #fill.at and fill.at[shown + 1] <= now do
			shown += 1
		end
		if shown ~= fill.shown then
			fill.shown = shown
			self:broadcast_lobby()
		end
	end
end

--- The bot players that will fill the match (their names are kept for it) and when each shows up.
function MatchServer._prepare_fill(self: any, humans: number)
	local lobby = self.deps.lobby
	local ok, info = pcall(lobby.info)
	local max = if ok and type(info) == "table" then tonumber(info.max) else nil
	local fill = { names = {}, at = {}, shown = 0, max = max or 0 }
	self._fill = fill
	if max == nil or max <= humans then
		return
	end
	local taken = {}
	for _, part in self._participants do
		taken[part.name] = true
	end
	local names_ok, names = pcall(lobby.bot_names, max - humans, taken)
	if not names_ok or type(names) ~= "table" then
		return
	end
	fill.names = names
	-- over what is left of the window, the last one just before the start
	local window = math.max(0.0, math.min(MatchServer.FILL_REVEAL_S, self._stage_time) - 0.6)
	local now = self:_now()
	for i, t in MatchServer.fill_schedule(#names, window) do
		fill.at[i] = now + t * 1000
	end
end

--- When each of `n` bot players shows up: seconds from the start of the reveal, ascending, within
--- `window`. Like players piling into a lobby: more of them the closer the start, some arriving in
--- twos and threes a moment apart, irregular gaps. `rand` (0..1) defaults to math.random.
function MatchServer.fill_schedule(n: number, window: number, rand: (() -> number)?): { number }
	local r = rand or math.random
	local t = table.create(n)
	for i = 1, n do
		t[i] = window * r() ^ (1 / MatchServer.FILL_RAMP)
	end
	table.sort(t)
	local gap = MatchServer.FILL_PARTY_GAP_S
	for i = 2, n do
		if r() < MatchServer.FILL_PARTY_CHANCE then
			t[i] = math.min(window, t[i - 1] + gap[1] + r() * (gap[2] - gap[1]))
		end
	end
	table.sort(t)
	return t
end

--- JOINs held back by the cooldown are admitted once it has passed (in arrival order is not needed:
--- each peer has at most one pending JOIN).
function MatchServer._admit_pending_joins(self: any)
	local now = self:_now()
	for peer, info in table.clone(self._pending_join) do
		local last = self._last_join_msec[peer]
		if last == nil or now - last >= MatchServer.JOIN_COOLDOWN_MSEC then
			self._pending_join[peer] = nil
			self:join(peer, info)
		end
	end
end

function MatchServer._start_match(self: any)
	local seed = if self.deps.seed then self.deps.seed() else math.random(0, 2 ^ 31 - 2)
	local config = {
		seed = seed,
		difficulty = MatchServer.MP_DIFFICULTY,
		tribes = MatchServer.MP_TRIBES,
		max_humans = MatchServer.MP_MAX_HUMANS,
		time_limit_s = MatchServer.MP_TIME_LIMIT_S,
		spawn_ticks = MatchServer.MP_SPAWN_TICKS,
		map_id = self._map_id,
	}
	local lobby = self.deps.lobby
	if lobby ~= nil then
		local ok, info = pcall(lobby.info)
		if ok and type(info) == "table" then
			if type(info.map_id) == "string" then
				config.map_id = info.map_id
				self._map_id = info.map_id
			end
			if type(info.max) == "number" then
				config.max_humans = math.max(config.max_humans, info.max)
			end
			-- a team game (Core/Teams; staging only for now): no nations in public team
			-- games, except Humans Vs Nations, which has as many as the match has player slots
			if info.mode == "team" and info.teams ~= nil then
				config.teams = info.teams
				if info.teams == MatchServer.HVN then
					config.nation_limit = if type(info.max) == "number" then info.max else nil
				else
					config.nations = false
				end
			end
		end
	end
	self._stage_time = 0.0
	self._start_job = Coop.job(self.deps.make_sim, config)
	self:_continue_start()
end

function MatchServer._continue_start(self: any)
	local job = self._start_job
	if not job:step(MatchServer.BUILD_BUDGET_S) then
		return
	end
	self._start_job = nil
	local ok, sim_or_err = job.ok, if job.ok then job.result else job.err
	if not ok or sim_or_err == nil then
		-- The match could not be created (should never happen); send everyone back to the title.
		self:_log("[Session] could not start the match: " .. tostring(sim_or_err))
		for _, peer in table.clone(self._order) do
			self:_send(peer, OP.MATCH_CLOSED, "Multiplayer is unavailable right now. Try again in a moment.")
		end
		table.clear(self._participants)
		table.clear(self._order)
		self:_set_stage(STAGE_IDLE, 0.0)
		return
	end
	self._mp_sim = sim_or_err
	--- the match's results, for Stars (Data/Stars)
	-- (a stand-in Sim in tests has no owner tables to follow)
	self._tracker = if type(sim_or_err.o_tiles) == "table" and type(sim_or_err.o_kind) == "table"
		then Stars.Tracker.new(sim_or_err)
		else nil
	self._mp_acc = 0.0
	self._snap_tick = -1
	self._snap = nil
	self._step_failures_row = 0
	self._step_failures = 0
	self._resync_all = false
	self._mp_started_msec = self:_now()
	-- (the players voted to start it, or its timer ran out: reported with the start)
	local voted = self._vote_start_at ~= nil
	self._vote_start_at = nil
	for _, part in self._participants do
		part.voted = false
	end
	self:_set_stage(STAGE_SPAWN, 0.0)
	local now = self:_now()
	-- Every commander's nation first, then ONE snapshot for all of them: each participant's own nation
	-- is in the state it starts from (admitting one by one gave players 2..N a snapshot without their
	-- own row until the next delta, i.e. state_ready / joined_owner fired with local_info() == nil).
	local order = table.clone(self._order)
	local humans = 0
	for _, peer in order do
		local part = self._participants[peer]
		if part and not part.spectator then
			part.owner = 0
			part.active_msec = now
			self:_ensure_owner(peer)
			humans += 1
		end
	end
	-- public lobby: bot players fill every empty slot (after the humans: they take the first colours)
	local lobby = self.deps.lobby
	if lobby ~= nil then
		local ok, n = pcall(lobby.on_start, humans, voted)
		if ok and type(n) == "number" and n > 0 then
			local taken = {}
			for _, peer in order do
				local part = self._participants[peer]
				if part then
					taken[part.name] = true
				end
			end
			-- the names the waiting room showed joining first (minus any a player took since), then more
			local names = {}
			for _, nm in if self._fill ~= nil then self._fill.names else {} do
				if #names < n and not taken[nm] then
					taken[nm] = true
					table.insert(names, nm)
				end
			end
			if #names < n then
				local more_ok, more = pcall(lobby.bot_names, n - #names, taken)
				if more_ok and type(more) == "table" then
					for _, nm in more do
						table.insert(names, nm)
					end
				end
			end
			local bots = self._mp_sim:add_bot_players(n, if #names > 0 then names else nil)
			self:_dress_bots(bots)
			self._snap = nil
			self._snap_tick = -1
			self:_log(string.format("[Session] %d bot players fill the lobby", n))
		end
	end
	self._fill = nil
	-- a team game: the teams, once everyone (bot players too) is in; a party stays together
	local sim = self._mp_sim
	if sim.team_mode and type(sim.assign_teams) == "function" then
		local groups = {}
		for _, peer in order do
			local part = self._participants[peer]
			if part and part.owner ~= 0 then
				groups[part.owner] = self:_party_of(part)
			end
		end
		sim:assign_teams(groups)
		self._snap = nil
		self._snap_tick = -1
		self:_log(string.format("[Session] %d teams: %s", #sim.team_names, table.concat(sim.team_names, ", ")))
	end
	for _, peer in order do
		local part = self._participants[peer]
		if part and (part.owner ~= 0 or part.spectator) then
			self:_send_snapshot(peer)
		end
	end
	self:_log(string.format("[Session] match started with %d commanders", humans))
end

--- Cosmetics for bot players (they look like players: some wear a flag or a skin, like people do, and
--- each has a head shot beside its name like every person: a different one each of deps.bot_faces,
--- Roblox user ids of accounts picked at random: real avatars, 2026-10-04).
function MatchServer._dress_bots(self: any, ids: any)
	self._bot_cosmetics = {}
	if type(ids) ~= "table" then
		return
	end
	local pool = if type(self.deps.bot_faces) == "table" then table.clone(self.deps.bot_faces) else {}
	local function face(): number?
		if #pool == 0 then
			return nil
		end
		local i = math.random(1, #pool)
		local v = pool[i]
		pool[i] = pool[#pool]
		pool[#pool] = nil
		return if type(v) == "number" and v > 0 then v else nil
	end
	local flags, skins = {}, {}
	for _, it in Cosmetics.all() do
		if it.kind == "flag" then
			table.insert(flags, it.id)
		elseif it.rarity == "common" or it.rarity == "rare" then
			table.insert(skins, it.id)
		end
	end
	for _, id in ids do
		local c = {}
		if #flags > 0 and math.random() < MatchServer.BOT_FLAG_SHARE then
			c.flag = flags[math.random(1, #flags)]
		end
		if #skins > 0 and math.random() < MatchServer.BOT_SKIN_SHARE then
			c.skin = skins[math.random(1, #skins)]
		end
		c.face = face()
		if c.flag or c.skin or c.face then
			self._bot_cosmetics[id] = c
		end
	end
end

--- The match's equipped cosmetics: owner id → { skin?, flag?, face? } (people's from
--- deps.cosmetics_of, bot players' from _dress_bots). `face` is a Roblox user id whose head shot goes
--- beside the name: a person's own, a bot player's dealt from deps.bot_faces.
function MatchServer.cosmetics_map(self: any): { [number]: any }
	local map = table.clone(self._bot_cosmetics or {})
	local of = self.deps.cosmetics_of
	for peer, part in self._participants do
		if part.owner ~= 0 then
			local c: any = nil
			if of ~= nil then
				local ok, v = pcall(of, peer)
				c = if ok and type(v) == "table" then v else nil
			end
			local uid = tonumber(part.uid)
			local face = if uid ~= nil and uid > 0 then uid else nil
			local skin, flag = if c ~= nil then c.skin else nil, if c ~= nil then c.flag else nil
			if skin ~= nil or flag ~= nil or face ~= nil then
				map[part.owner] = { skin = skin, flag = flag, face = face }
			end
		end
	end
	return map
end

--- Everyone (and every watcher) gets the whole map again.
function MatchServer._broadcast_cosmetics(self: any)
	if self._mp_sim == nil then
		return
	end
	local map = self:cosmetics_map()
	for _, peer in self._order do
		self:_send(peer, OP.COSMETICS, map)
	end
end

--- The Arsenal a participant plays with (deps.unlocks_of: a Defs.UNLOCK mask; server/Purchases).
function MatchServer._apply_unlocks(self: any, peer: any)
	local sim = self._mp_sim
	local part = self._participants[peer]
	local of = self.deps.unlocks_of
	if sim == nil or part == nil or part.owner == 0 or of == nil or sim.set_unlocks == nil then
		return
	end
	local ok, mask = pcall(of, peer)
	if ok and type(mask) == "number" then
		sim:set_unlocks(part.owner, mask)
	end
end

--- A player unlocked something mid-match: it works from the next tick.
function MatchServer.unlocks_changed(self: any, peer: any)
	self:_apply_unlocks(peer)
end

--- Pays a participant's Stars for the match once (deps.on_result(peer, result): server/Rewards):
--- when their nation falls, when the match ends, or — `left` — when they walk away from it.
function MatchServer._pay(self: any, peer: any, left: boolean)
	local part = self._participants[peer]
	local tracker = self._tracker
	if part == nil or tracker == nil or part.owner == 0 or part.paid or self.deps.on_result == nil then
		return
	end
	part.paid = true
	pcall(self.deps.on_result, peer, tracker:result(part.owner, left))
end

--- The party a participant came with (the hub's teleport data, via the lobby hooks), or nil.
function MatchServer._party_of(self: any, part: any): string?
	local lobby = self.deps.lobby
	if lobby == nil or type(lobby.party_of) ~= "function" or part.uid == nil then
		return nil
	end
	local ok, key = pcall(lobby.party_of, part.uid)
	return if ok and type(key) == "string" then key else nil
end

--- Gives a participant a nation in the running match (or tells them the match is full). A new
--- nation invalidates the cached snapshot, so every snapshot sent contains its receiver's nation.
function MatchServer._ensure_owner(self: any, peer: any): number
	local sim = self._mp_sim
	local part = self._participants[peer]
	if sim == nil or part == nil or part.spectator then
		return 0
	end
	if part.owner == 0 then
		part.owner = sim:add_human(part.key, part.name) or 0
		if part.owner ~= 0 then
			self._snap = nil
			self._snap_tick = -1
			-- a team game already under way: onto its party's team, else the smallest
			if sim.team_mode and type(sim.join_team) == "function" and #sim.team_names > 0 then
				local key = self:_party_of(part)
				local mates = {}
				if key ~= nil then
					for _, other in self._participants do
						if other ~= part and other.owner ~= 0 and self:_party_of(other) == key then
							table.insert(mates, other.owner)
						end
					end
				end
				sim:join_team(part.owner, mates)
			end
			-- the Arsenal the player has unlocked, and their Stars for this match
			self:_apply_unlocks(peer)
			part.paid = false
			if self._tracker ~= nil then
				self._tracker:watch(part.owner)
			end
		else
			self:_send(
				peer,
				OP.NOTICE,
				"This match is full. You'll be placed in the next one.",
				MatchServer.NOTICE_INFO
			)
		end
	end
	return part.owner
end

--- Sends a participant the full state. Snapshots are built at most once per tick (and state) and
--- shared by every admission / resync in that tick.
function MatchServer._send_snapshot(self: any, peer: any)
	local sim = self._mp_sim
	local part = self._participants[peer]
	if sim == nil or part == nil or (part.owner == 0 and not part.spectator) then
		return
	end
	if self._snap_tick ~= sim.tick or self._snap == nil then
		local t0 = os.clock()
		self._snap = Protocol.compress(Protocol.encode_snapshot(sim:snapshot()))
		self._snap_tick = sim.tick
		self.stats.snapshot_ms = (os.clock() - t0) * 1000
	end
	local snap = self._snap :: buffer
	self.stats.snapshots_sent += 1
	self.stats.snapshot_bytes = buffer.len(snap)
	self.stats.bytes_sent += buffer.len(snap)
	self:_send(peer, OP.SNAPSHOT, part.owner, snap)
	-- (outside the Sim: who wears what, for this mirror)
	self:_send(peer, OP.COSMETICS, self:cosmetics_map())
end

--- Adds a participant to the running match and sends them the full state (late join). Joiners added
--- after another snapshot was sent this tick get their OWNER_ADD in the next delta (GameState handles
--- that idempotently).
function MatchServer._admit(self: any, peer: any)
	local part = self._participants[peer]
	-- a spectator watches without a nation; a player gets one (unless the match is full)
	if (part ~= nil and part.spectator) or self:_ensure_owner(peer) ~= 0 then
		self:_send_snapshot(peer)
		-- the others see the newcomer's flag / skin
		self:_broadcast_cosmetics()
	end
end

--- One server tick, guarded: a Sim or encoder error never escapes into the Heartbeat. After a failure
--- every mirror is resynced with a snapshot (a tick whose delta was not sent, or a half-applied step,
--- leaves the clients behind); repeated failures end the match with a notice instead of freezing it.
function MatchServer._server_step(self: any)
	local ok, err = xpcall(self._step_once, debug.traceback, self)
	if ok and self._resync_all then
		ok, err = xpcall(self._resync_everyone, debug.traceback, self)
	end
	if ok then
		self._step_failures_row = 0
		return
	end
	self._step_failures_row += 1
	self._step_failures += 1
	local key = string.match(tostring(err), "^[^\n]*") or "?"
	if not self._step_errors_seen[key] then
		self._step_errors_seen[key] = true
		self:_log("[Session] match step failed: " .. tostring(err))
	end
	if
		self._step_failures_row >= MatchServer.MAX_STEP_FAILURES_IN_ROW
		or self._step_failures >= MatchServer.MAX_STEP_FAILURES
	then
		self:_abort_match(MatchServer.STEP_FAILED_NOTICE)
	else
		self._resync_all = true
	end
end

function MatchServer._resync_everyone(self: any)
	self._resync_all = false
	self._snap = nil
	self._snap_tick = -1
	for _, peer in self._order do
		self:_send_snapshot(peer)
	end
end

--- Ends the running match for good: everyone goes back to the title with `reason`.
function MatchServer._abort_match(self: any, reason: string)
	self:_log(string.format("[Session] match aborted: %s", reason))
	for _, peer in table.clone(self._order) do
		self:_send(peer, OP.MATCH_CLOSED, reason)
	end
	self:_close_match()
	table.clear(self._participants)
	table.clear(self._order)
	table.clear(self._intent_budget)
	self._resync_all = false
	self:_set_stage(STAGE_IDLE, 0.0)
end

function MatchServer._step_once(self: any)
	local sim = self._mp_sim
	local t0 = os.clock()
	local d = sim:step()
	local t1 = os.clock()
	local tracker = self._tracker
	if tracker ~= nil then
		tracker:step(d.ev)
		for _, peer in self._order do
			local part = self._participants[peer]
			if part.owner ~= 0 and not part.paid and tracker:final(part.owner) then
				self:_pay(peer, false)
			end
		end
	end
	local public, privates = Protocol.split_events(d.ev, is_private)
	local shared = Protocol.compress(Protocol.encode_delta(d, public, sim.W))
	local t2 = os.clock()
	local st = self.stats
	local step_ms = (t1 - t0) * 1000
	st.steps += 1
	st.step_ms_total += step_ms
	st.step_ms_max = math.max(st.step_ms_max, step_ms)
	table.insert(st.step_ms, step_ms)
	st.encode_ms_total += (t2 - t1) * 1000
	local shared_len = buffer.len(shared)
	st.delta_bytes_max = math.max(st.delta_bytes_max, shared_len)
	for _, peer in self._order do
		local part = self._participants[peer]
		local owner = part.owner
		if owner ~= 0 or part.spectator then
			local mine = owner ~= 0 and privates and privates[owner]
			if mine then
				local tail = Protocol.encode_tail(mine, sim.W)
				st.bytes_sent += shared_len + buffer.len(tail)
				self:_send(peer, OP.DELTA, shared, tail)
			else
				st.bytes_sent += shared_len
				self:_send(peer, OP.DELTA, shared)
			end
			st.deltas_sent += 1
		end
	end
	if self._stage == STAGE_SPAWN and sim.phase == PHASE_PLAYING then
		self:_set_stage(STAGE_PLAYING, 0.0)
	end
	if sim.phase == PHASE_OVER and self._stage ~= STAGE_OVER then
		self:_set_stage(STAGE_OVER, MatchServer.RESULTS_SEC)
	end
end

function MatchServer._close_match(self: any)
	self._mp_sim = nil
	self._tracker = nil
	self._bot_cosmetics = {}
	self._snap_tick = -1
	self._snap = nil
	for _, part in self._participants do
		part.owner = 0
	end
	-- the next match's map (announced in the lobby info from now on)
	self._map_id = self:_pick_map()
end

--- Players who walked away are not auto-entered into the next match.
function MatchServer._drop_idle_participants(self: any)
	local now = self:_now()
	for _, peer in table.clone(self._order) do
		local part = self._participants[peer]
		if part and now - part.active_msec > MatchServer.IDLE_DROP_MSEC then
			self:_remove(peer)
			self:_send(peer, OP.MATCH_CLOSED, "You were away, so you weren't entered in the next match.")
		end
	end
end

function MatchServer._remove(self: any, peer: any)
	self._participants[peer] = nil
	local i = table.find(self._order, peer)
	if i then
		table.remove(self._order, i)
	end
	self._intent_budget[peer] = nil
end

function MatchServer._drop_participant(self: any, peer: any)
	local part = self._participants[peer]
	if part == nil then
		return
	end
	local owner = part.owner
	-- walking away from a running match: Stars for what was done so far
	self:_pay(peer, true)
	self:_remove(peer)
	if self._mp_sim ~= nil and owner ~= 0 then
		self._mp_sim:remove_human(owner)
	end
	local st = self._stage
	if #self._order == 0 and (st == STAGE_SPAWN or st == STAGE_PLAYING or st == STAGE_OVER) then
		self:_close_match()
		self:_set_stage(STAGE_IDLE, 0.0)
		local lobby = self.deps.lobby
		if lobby ~= nil then
			-- a public match everyone left is over for good (nothing left to watch either)
			self._finished = true
			if lobby.on_closed then
				pcall(lobby.on_closed)
			end
		end
	end
	self:broadcast_lobby()
end

function MatchServer._set_stage(self: any, stage: string, timer: number)
	if stage == STAGE_IDLE or stage == STAGE_LOBBY then
		self._vote_start_at = nil -- a new wait: nobody has voted yet
	end
	if stage ~= STAGE_LOBBY or self._stage ~= STAGE_LOBBY then
		self._alone_since = nil
		if stage ~= STAGE_SPAWN then
			self._fill = nil
		end
	end
	self._stage = stage
	self._stage_time = timer
	self:_log("[Session] stage -> " .. stage)
	self:broadcast_lobby()
end

local function lobby_solo_wait(self: any, voters: number): boolean
	return self.deps.lobby ~= nil and voters == 1 and self._alone_since ~= nil and self._stage == STAGE_LOBBY
end

--- Lobby info for one peer (session.gd _broadcast_lobby's dictionary).
function MatchServer.lobby_info(self: any, peer: any): { [string]: any }
	local names = table.create(#self._order)
	local watchers = 0
	for _, p in self._order do
		local part = self._participants[p]
		if part.spectator then
			watchers += 1
		else
			table.insert(names, part.name)
		end
	end
	local humans = #names
	-- the last seconds: the bot players that will fill the match, as players joining
	local fill = self._fill
	if fill ~= nil and self._stage == STAGE_LOBBY then
		for i = 1, math.min(fill.shown, fill.max - humans) do
			table.insert(names, fill.names[i])
		end
	end
	local me = self._participants[peer]
	local votes, votes_needed, voters = self:vote_counts()
	local vote_min = self:vote_min_players()
	local solo_in = nil
	if lobby_solo_wait(self, voters) then
		solo_in = math.max(0.0, MatchServer.VOTE_SOLO_AFTER_S - (self:_now() - self._alone_since) / 1000.0)
	end
	local elapsed = 0.0
	if self._mp_sim ~= nil then
		elapsed = (self:_now() - self._mp_started_msec) / 1000.0
	end
	local lobby = self.deps.lobby
	local max = nil
	local lobby_map = nil
	local teams = nil
	if lobby ~= nil then
		local ok, info = pcall(lobby.info)
		if ok and type(info) == "table" then
			max = info.max
			lobby_map = info.map_id
			teams = if info.mode == "team" then info.teams else nil
		end
	end
	return {
		available = true,
		-- a team game's teams (a number of teams, "Duos", ...; nil: free for all)
		teams = teams,
		-- "match": a public lobby's own server (clients join at once); "hub": the shared queue
		kind = if lobby ~= nil then "match" else "hub",
		max = max,
		stage = self._stage,
		countdown_s = math.max(self._stage_time, 0.0),
		elapsed_s = elapsed,
		players = names,
		watchers = watchers,
		votes = votes,
		votes_needed = math.max(votes_needed, vote_min),
		vote_players = humans,
		vote_min_players = vote_min,
		--- alone in a public waiting room: seconds until a lone vote may start the match
		vote_solo_in = solo_in,
		voted = me ~= nil and me.voted,
		vote_started = self._vote_start_at ~= nil,
		in_match = me ~= nil,
		spectating = me ~= nil and me.spectator,
		map_id = if self._mp_sim ~= nil then self._mp_sim.map_id else (lobby_map or self._map_id),
	}
end

function MatchServer.broadcast_lobby(self: any)
	if self._closed then
		return
	end
	for _, peer in self.deps.peers() do
		self:_send(peer, OP.LOBBY, self:lobby_info(peer))
	end
end

--- The server is going away (Roblox BindToClose): tell everyone, stop the match.
function MatchServer.shutdown(self: any, reason: string?)
	if self._closed then
		return
	end
	for _, peer in table.clone(self._order) do
		self:_send(peer, OP.MATCH_CLOSED, reason or "The game server is restarting. You're back at the title screen.")
	end
	self:_close_match()
	table.clear(self._participants)
	table.clear(self._order)
	self._stage = STAGE_IDLE
	self._stage_time = 0.0
	self:broadcast_lobby()
	for _, peer in self.deps.peers() do
		local info = self:lobby_info(peer)
		info.available = false
		self:_send(peer, OP.LOBBY, info)
	end
	self._closed = true
end

--- Instrumentation summary since the last call (and resets the window).
function MatchServer.take_stats(self: any): { [string]: number }
	local st = self.stats
	local list = st.step_ms
	table.sort(list)
	local p50 = list[math.max(1, math.floor(#list * 0.5))] or 0
	local p99 = list[math.max(1, math.floor(#list * 0.99))] or 0
	local out = {
		steps = st.steps,
		step_ms_avg = if st.steps > 0 then st.step_ms_total / st.steps else 0,
		step_ms_p50 = p50,
		step_ms_p99 = p99,
		step_ms_max = st.step_ms_max,
		encode_ms_avg = if st.steps > 0 then st.encode_ms_total / st.steps else 0,
		bytes_sent = st.bytes_sent,
		deltas_sent = st.deltas_sent,
		delta_bytes_max = st.delta_bytes_max,
		snapshots_sent = st.snapshots_sent,
		snapshot_bytes = st.snapshot_bytes,
		snapshot_ms = st.snapshot_ms or 0,
		intents_ok = st.intents_ok,
		intents_dropped = st.intents_dropped,
		catchup_frames = st.catchup_frames,
		budget_stops = st.budget_stops,
	}
	st.steps, st.step_ms_total, st.step_ms_max, st.encode_ms_total = 0, 0, 0, 0
	st.bytes_sent, st.deltas_sent, st.delta_bytes_max, st.snapshots_sent = 0, 0, 0, 0
	st.intents_ok, st.intents_dropped = 0, 0
	st.catchup_frames, st.budget_stops = 0, 0
	table.clear(list)
	return out
end

return MatchServer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="98">
        <Properties>
          <string name="Name">Pacer</string>
          <string name="Source"><![CDATA[--!strict
-- Runs calls at a steady rate instead of in bursts: a token bucket in front of a queue, with a cap
-- on how many calls one key (a player) may have waiting, so no one crowds out the rest.
-- Analytics uses it for AnalyticsService (2026-11-01: Roblox allows 120 + 20 x players events a
-- minute on a server and drops the rest, "AnalyticsService: You have sent too many events").
--
--   Pacer.new(opts) -> pacer
--     opts = {
--       rate = function() -> number,   -- calls a second now
--       burst_s = number,              -- the bucket holds this many seconds of calls (at least 1 call)
--       max_queued = number,           -- calls waiting at most (past it: dropped)
--       per_key_max = number,          -- calls of one key waiting at most (past it: dropped)
--       now = function() -> number,    -- seconds
--       on_error = function(err)?,
--     }
--   pacer:submit(key, fn, ...) -> boolean   now if the bucket allows and nothing waits, else queued;
--                                           false: dropped
--   pacer:pump()                            runs the waiting calls the bucket allows (call often)
local Pacer = {}
Pacer.__index = Pacer

function Pacer.new(opts: { [string]: any })
	local self = setmetatable({}, Pacer)
	self.opts = opts
	self.tokens = 0.0
	self.at = opts.now()
	self.queue = {} :: { [number]: any }
	self.head = 1
	self.tail = 0
	self.waiting = {} :: { [any]: number }
	self.sent = 0
	self.dropped = 0
	self:_refill()
	self.tokens = self:_cap()
	return self
end

function Pacer._cap(self: any): number
	return math.max(1, self.opts.rate() * self.opts.burst_s)
end

function Pacer._refill(self: any)
	local t = self.opts.now()
	local dt = math.max(0, t - self.at)
	self.at = t
	self.tokens = math.min(self:_cap(), self.tokens + dt * self.opts.rate())
end

function Pacer._run(self: any, call: { any })
	self.tokens -= 1
	self.sent += 1
	local ok, err = pcall(table.unpack(call, 1, call.n))
	if not ok and self.opts.on_error then
		self.opts.on_error(err)
	end
end

function Pacer.queued(self: any): number
	return self.tail - self.head + 1
end

function Pacer.submit(self: any, key: any, fn: (...any) -> ...any, ...: any): boolean
	self:_refill()
	local call = table.pack(fn, ...)
	if self:queued() == 0 and self.tokens >= 1 then
		self:_run(call)
		return true
	end
	local mine = self.waiting[key] or 0
	if self:queued() >= self.opts.max_queued or mine >= self.opts.per_key_max then
		self.dropped += 1
		return false
	end
	self.waiting[key] = mine + 1
	self.tail += 1
	self.queue[self.tail] = { key = key, call = call }
	return true
end

function Pacer.pump(self: any)
	self:_refill()
	while self.tokens >= 1 and self.head <= self.tail do
		local it = self.queue[self.head]
		self.queue[self.head] = nil
		self.head += 1
		local left = (self.waiting[it.key] or 1) - 1
		self.waiting[it.key] = if left > 0 then left else nil
		self:_run(it.call)
	end
	if self.head > self.tail then
		-- (empty: start the array again)
		self.queue = {}
		self.head, self.tail = 1, 0
	end
end

return Pacer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="99">
        <Properties>
          <string name="Name">Party</string>
          <string name="Source"><![CDATA[--!strict
-- Parties on a hub server (experimental, staging only; 2026-10-10: for joining a match with
-- a friend): players who play public matches together. The leader picks the match; everyone in
-- the party who is on the title screen goes with them, in one teleport, and a team game puts the
-- party on one team (Core/Teams).
-- (Parties are what keep friends together in team games.)
--
-- A party lives on one server, so its members are on the same hub:
--   * an invite goes to anyone on this server (friends first in the list); a friend elsewhere gets a
--     Roblox game invite (SocialService:PromptGameInvite, client side) and lands here;
--   * players in one Roblox party (Player.PartyId) arrive together and are put in one party here;
--   * after a match, the match server sends everyone back to a hub in one teleport with who was in
--     which party (`arrived`), and the party is made again there.
--
--   Party.new(deps)   deps = { send(player, state), now() -> seconds, log(text)?, prefix: string? (this
--                     server's: party keys travel between servers) }
--   party:invite(from, target) / accept(target, from_uid) / decline(target, from_uid) / leave(p)
--   party:kick(leader, uid) / removed(p) / members(p) / is_leader(p) / key_of(p)
--   party:join_roblox_party(p, others_in_it) / arrived(p, key, leader_uid)
--   party:state(p) -> what the client shows (OP.PARTY_STATE)

local Party = {}
Party.__index = Party

--- Players in a party at most (4 until 2026-11-01; the user: "let's allow up to 8 per party", after a
--- group of five asked for "5 person lobbys" so they could all play together). The lobby service seats
--- up to 8 in one take.
Party.MAX_SIZE = 8
--- An invite waits this long for an answer.
Party.INVITE_TTL_S = 60
--- A player invites the same player again only this long after.
Party.INVITE_GAP_S = 3

type Group = { key: string, leader: any, members: { any } }

function Party.new(deps: { [string]: any })
	local self = setmetatable({}, Party)
	self.deps = deps
	self.groups = {} :: { [string]: Group }
	self.of = {} :: { [any]: string }
	--- target → { [from] = sent at }
	self.invites = {} :: { [any]: { [any]: number } }
	self._seq = 0
	return self
end

local function uid(p: any): number
	return tonumber(p.UserId) or 0
end

local function name_of(p: any): string
	local d = p.DisplayName
	return if type(d) == "string" and d ~= "" then d else tostring(p.Name)
end

function Party._log(self: any, text: string)
	if self.deps.log then
		self.deps.log("[Party] " .. text)
	end
end

function Party._new_key(self: any, leader: any): string
	self._seq += 1
	return ("%s%d:%d"):format(self.deps.prefix or "", uid(leader), self._seq)
end

--- `p`'s party key, or nil.
function Party.key_of(self: any, p: any): string?
	return self.of[p]
end

--- Everyone in `p`'s party (leader first), or { p } alone.
function Party.members(self: any, p: any): { any }
	local g = self.groups[self.of[p] or ""]
	if g == nil then
		return { p }
	end
	return table.clone(g.members)
end

function Party.is_leader(self: any, p: any): boolean
	local g = self.groups[self.of[p] or ""]
	return g == nil or g.leader == p
end

--- Tells every member (and anyone with an invite from them) what the party looks like now.
function Party._push(self: any, players: { any })
	local seen = {}
	for _, p in players do
		if not seen[p] then
			seen[p] = true
			self.deps.send(p, self:state(p))
		end
	end
end

function Party._push_group(self: any, key: string?)
	local g = self.groups[key or ""]
	if g ~= nil then
		self:_push(g.members)
	end
end

--- What `p` sees: { members = { {uid, name, leader} }, leader (am I), invites = { {uid, name} } }.
function Party.state(self: any, p: any): { [string]: any }
	local members = {}
	local g = self.groups[self.of[p] or ""]
	if g ~= nil and #g.members > 1 then
		for _, m in g.members do
			table.insert(members, { uid = uid(m), name = name_of(m), leader = m == g.leader })
		end
	end
	local invites = {}
	local now = self.deps.now()
	for from, at in self.invites[p] or {} do
		if now - at <= Party.INVITE_TTL_S and from.Parent ~= nil then
			table.insert(invites, { uid = uid(from), name = name_of(from) })
		end
	end
	table.sort(invites, function(a, b)
		return a.uid < b.uid
	end)
	return {
		members = members,
		leader = g == nil or g.leader == p,
		invites = invites,
		max = Party.MAX_SIZE,
	}
end

--- `from` invites `target` (on this server). Returns ok, reason.
function Party.invite(self: any, from: any, target: any): (boolean, string?)
	if target == nil or target == from then
		return false, "Pick someone to invite."
	end
	local key = self.of[from]
	if key ~= nil and self.of[target] == key then
		return false, name_of(target) .. " is already in your party."
	end
	local g = self.groups[key or ""]
	if g ~= nil and #g.members >= Party.MAX_SIZE then
		return false, ("A party holds %d players."):format(Party.MAX_SIZE)
	end
	local now = self.deps.now()
	local box = self.invites[target]
	if box == nil then
		box = {}
		self.invites[target] = box
	end
	if box[from] ~= nil and now - box[from] < Party.INVITE_GAP_S then
		return false, nil
	end
	box[from] = now
	self:_push({ target })
	self:_log(("%s invited %s"):format(name_of(from), name_of(target)))
	return true, nil
end

--- `target` accepts `from_uid`'s invite: they are now in `from`'s party (made if `from` had none);
--- `target` leaves the party it was in.
function Party.accept(self: any, target: any, from_uid: number): (boolean, string?)
	local box = self.invites[target]
	local from = nil
	for p, at in box or {} do
		if uid(p) == from_uid and self.deps.now() - at <= Party.INVITE_TTL_S then
			from = p
		end
	end
	if from == nil or from.Parent == nil then
		return false, "That invite has expired."
	end
	box[from] = nil
	local key = self.of[from]
	local g = self.groups[key or ""]
	if g ~= nil and #g.members >= Party.MAX_SIZE then
		self:_push({ target })
		return false, "That party is full."
	end
	if self.of[target] ~= nil then
		self:leave(target)
	end
	if g == nil then
		key = self:_new_key(from)
		g = { key = key :: string, leader = from, members = { from } }
		self.groups[key :: string] = g
		self.of[from] = key
	end
	table.insert(g.members, target)
	self.of[target] = key
	self:_push_group(key)
	self:_log(("%s joined %s's party (%d)"):format(name_of(target), name_of(g.leader), #g.members))
	return true, nil
end

function Party.decline(self: any, target: any, from_uid: number)
	local box = self.invites[target]
	for p in box or {} do
		if uid(p) == from_uid then
			box[p] = nil
		end
	end
	self:_push({ target })
end

--- `p` leaves its party (the next member leads when the leader leaves; one left alone is no party).
function Party.leave(self: any, p: any)
	local key = self.of[p]
	local g = self.groups[key or ""]
	self.of[p] = nil
	if g == nil then
		self:_push({ p })
		return
	end
	local i = table.find(g.members, p)
	if i ~= nil then
		table.remove(g.members, i)
	end
	if g.leader == p then
		g.leader = g.members[1]
	end
	if #g.members <= 1 then
		for _, m in g.members do
			self.of[m] = nil
		end
		self.groups[g.key] = nil
		self:_push(g.members)
	else
		self:_push_group(key)
	end
	if p.Parent ~= nil then
		self:_push({ p })
	end
end

--- The leader removes a member.
function Party.kick(self: any, leader: any, member_uid: number)
	local g = self.groups[self.of[leader] or ""]
	if g == nil or g.leader ~= leader then
		return
	end
	for _, m in g.members do
		if m ~= leader and uid(m) == member_uid then
			self:leave(m)
			return
		end
	end
end

--- `p` left the server.
function Party.removed(self: any, p: any)
	self:leave(p)
	self.invites[p] = nil
	for target, box in self.invites do
		if box[p] ~= nil then
			box[p] = nil
			if target.Parent ~= nil then
				self:_push({ target })
			end
		end
	end
end

--- Players of one Roblox party (Player.PartyId) on this server: one party, the first of them leading.
function Party.join_roblox_party(self: any, p: any, others: { any })
	if self.of[p] ~= nil then
		return
	end
	for _, o in others do
		if o ~= p and self.of[o] ~= nil then
			local g = self.groups[self.of[o]]
			if g ~= nil and #g.members < Party.MAX_SIZE then
				table.insert(g.members, p)
				self.of[p] = g.key
				self:_push_group(g.key)
			end
			return
		end
	end
	for _, o in others do
		if o ~= p and o.Parent ~= nil and self.of[o] == nil then
			local key = self:_new_key(o)
			self.groups[key] = { key = key, leader = o, members = { o, p } }
			self.of[o] = key
			self.of[p] = key
			self:_push_group(key)
			return
		end
	end
end

--- `p` came back from a match in party `key` (the match server's return teleport): the party is made
--- again with whoever of it is here; `leader_uid` leads when present.
function Party.arrived(self: any, p: any, key: string, leader_uid: number?)
	if self.of[p] ~= nil or type(key) ~= "string" or key == "" then
		return
	end
	local g = self.groups[key]
	if g == nil then
		g = { key = key, leader = p, members = {} }
		self.groups[key] = g
	end
	if #g.members >= Party.MAX_SIZE then
		return
	end
	table.insert(g.members, p)
	self.of[p] = key
	if leader_uid ~= nil and uid(p) == leader_uid then
		g.leader = p
	end
	self:_push_group(key)
end

return Party
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="100">
        <Properties>
          <string name="Name">Purchases</string>
          <string name="Source"><![CDATA[--!strict
-- Robux purchases (developer products, shared/Data/Products). A purchase is a saved credit: Roblox's
-- ProcessReceipt adds it to the player's record in its own DataStore (only the server writes it —
-- the client's SETTING op can't touch it) and only then reports the purchase granted, so Roblox
-- retries until it is stored and a receipt is never granted twice (its PurchaseId is kept). The game
-- spends a credit when the moment comes (Purchases.use); one bought after the moment passed stays
-- for the next time.
--
--   Purchases.configure(deps)     { datastore = DataStore, notify = fn(player, credits), log?, warn?,
--                                   arrived? = fn(player) -> { p = record? }? }
--   Purchases.process_receipt(info) -> "granted" | "not_processed"   (a product's `count` credits)
--   Purchases.load(player)        read the record (join; retried while Roblox refuses it), or take the
--                                 one the last server handed on (deps.arrived: server/Handoff); notify
--   Purchases.credits(player) -> { [kind]: number }
--   Purchases.use(player, kind) -> (ok, err?)   spend one (yields)
--   Purchases.settle(player, max_s) -> record?  leaving for another server: the record once this
--                                 server's writes have landed (yields)
--   Purchases.release(player)     PlayerRemoving
--   Purchases.lost                { payouts, stars } that could not be paid after every retry
--   Purchases.open_crate(player) -> (ok, item_id | err)   spend a crate credit, roll (never a duplicate)
--   Purchases.equip(player, slot, id | false) -> (ok, err?)   "skin" / "flag"; only owned items
--   Purchases.inventory(player) -> { owned = { id }, equipped = { skin?, flag? }, crates_bought,
--                                    stars, unlocks = { key } }
--   Purchases.add_stars(player, amount) -> (ok, balance)   a match's Stars (Data/Stars; yields)
--   Purchases.buy_unlock(player, key) -> (ok, err?)        unlock an Arsenal item with Stars (yields)
--   Purchases.has_unlock(player, key) / Purchases.unlock_mask(player)   what the player has unlocked
--   Purchases.starter_state(player) -> false | { state = "ready" } | { state = "active", left = s }
--   Purchases.starter_seen(player)   the starter pack is on their screen: its clock starts (once; yields)
--   Purchases.general_perks(player, day, skin, crates) -> given?   a RoWorld General's day (yields)
-- The Arsenal (Data/Arsenal): a product whose `grants` is "unlock:<key>" is not a credit — its receipt
-- unlocks that item for good (and pays the item's bonus Stars once). The same unlock bought twice (the
-- shop never offers it) pays Stars instead, DUPLICATE_STARS_PER_ROBUX for each Robux of its price.
-- The starter pack (Data/Starter; 2026-10-15): one product, kind "starter", that unlocks
-- Starter.ITEMS, for a player who has never paid Robux. Its record `starter` = { started, ends, used? }
-- is made the first time the offer is on their screen (starter_seen) and never again: a real deadline.
-- Its receipt is refused (not granted, never stored) unless that offer is running or ended under
-- Starter.GRACE_S ago and wasn't used: a prompt for it opened any other way buys nothing.
-- The record: { credits = { kind = n }, receipts = { id }, owned = { [item] = true },
--   equipped = { skin = id?, flag = id? }, crates_bought = n, stars = n, stars_earned = n,
--   unlocks = { [key] = true }, paid = bool, starter = { started, ends, used? }?, gifts = { [item] = true } }.
-- The flag shop (Data/Shop; 2026-10-22): a product whose `grants` is "shopflag:<key>" adds that
-- flag (item "shop_<key>") and puts it on, whenever its receipt comes (the shop may have turned over
-- since the prompt opened). One already owned pays Stars instead, as a second Arsenal unlock does.
-- A set's bundle ("shopset:<id>", 2026-10-24) adds every flag of the set and wears its rarest new
-- one (unless one of the set is worn already); a flag owned before pays its share of the bundle's price
-- in Stars.
-- Exclusive cosmetics (Cosmetics.exclusive_skins, made for particular players): every read of a
-- record for a player (clean(v, user_id)) owns what Cosmetics.granted(user_id) lists, and the first
-- time (not yet in `gifts`) puts it on; nobody else's record can hold one.
local IS_ROBLOX = typeof(game) == "Instance"
local Products: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Products)
	else require("../shared/Data/Products")
local Cosmetics: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Cosmetics)
	else require("../shared/Data/Cosmetics")
local Arsenal: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Arsenal)
	else require("../shared/Data/Arsenal")
local Starter: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Starter)
	else require("../shared/Data/Starter")
local Shop: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Shop)
	else require("../shared/Data/Shop")
local Subscription: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Subscription)
	else require("../shared/Data/Subscription")

local Purchases = {}

Purchases.STORE = "RofrontPurchases_v1"
--- Receipts remembered per player (a retried ProcessReceipt is always about a recent one).
Purchases.RECEIPTS_KEPT = 100
Purchases.MAX_CREDITS = 1000
Purchases.MAX_STARS = 1000000000
--- Stars for each Robux of an unlock bought a second time (what an Arsenal price works out to).
Purchases.DUPLICATE_STARS_PER_ROBUX = 500

type Record = {
	credits: { [string]: number },
	receipts: { string },
	owned: { [string]: boolean },
	equipped: { skin: string?, flag: string? },
	crates_bought: number,
	stars: number,
	stars_earned: number,
	unlocks: { [string]: boolean },
	--- the tutorial's Stars were paid (Data/Tutorial.STARS, once per player)
	tutorial_paid: boolean?,
	--- ever paid Robux (a record from before this field: it has receipts)
	paid: boolean,
	--- the starter pack's offer, once it has been on their screen
	starter: { started: number, ends: number, used: boolean? }?,
	--- exclusive items already given (and put on once): Cosmetics.granted
	gifts: { [string]: boolean },
	--- RoWorld General: the UTC day whose perks were given (Purchases.general_perks)
	general_day: number?,
}

--- Reading a player's record when they join: GetAsync attempts and the waits between them. Roblox
--- throttles DataStore reads now and then ("TooManyRequests ... API: GetAsync", 37 in a day on the
--- error report of 2026-10-05). The load used to give up after one attempt, and that player then
--- had none of their unlocks, Stars or cosmetics for the whole session.
Purchases.LOAD_ATTEMPTS = 5
Purchases.LOAD_BACKOFF = { 1, 3, 6, 10 }
--- After those the session goes on without the record, and the read is tried again every
--- LOAD_RETRY_S, LOAD_RETRIES more times, while the player stays.
Purchases.LOAD_RETRY_S = 20
Purchases.LOAD_RETRIES = 30
--- Stars that could not be paid on this server: every write failed, DsGate's retries included.
Purchases.lost = { payouts = 0, stars = 0 }

local deps: { [string]: any } = {}
local cache: { [any]: { [string]: number } } = {}
--- the player's items (the record's owned / equipped / crates_bought), as last read or written
local inv: { [any]: any } = {}
--- player -> the load that is still trying to read their record (a token: a newer load, a write
--- that brought the record, or leaving ends it)
local loading: { [any]: any } = {}
--- player -> their whole record as last read or written (handed to the next server: Purchases.settle)
local records: { [any]: Record } = {}
--- user id -> this server's writes to their record still in flight
local busy: { [number]: number } = {}
--- user id -> a write failed since the record was last read or written: what this server holds may
--- not be what is stored (Purchases.use keeps a spend before it is stored)
local doubt: { [number]: boolean } = {}

--- Every write to a record: UpdateAsync on its key, counted while in flight. Errors as UpdateAsync does.
local function update(user_id: number, fn: (any) -> any): any
	busy[user_id] = (busy[user_id] or 0) + 1
	local ok, res = pcall(function()
		return deps.datastore:UpdateAsync("u" .. tostring(user_id), fn)
	end)
	local n = (busy[user_id] or 1) - 1
	busy[user_id] = if n > 0 then n else nil
	if not ok then
		doubt[user_id] = true
		error(res, 0)
	end
	doubt[user_id] = nil
	return res
end

function Purchases.configure(d: { [string]: any })
	for k, v in d do
		deps[k] = v
	end
end

--- Tests: forget everyone.
function Purchases.reset()
	table.clear(cache)
	table.clear(inv)
	table.clear(loading)
	table.clear(records)
	table.clear(busy)
	table.clear(doubt)
	Purchases.lost.payouts = 0
	Purchases.lost.stars = 0
end

--- The credit kind a product grants (nil: not ours), and how many of it (the 3-crate pack: 3).
function Purchases.kind_of(product_id: number): (string?, number)
	for kind, p in Products do
		if p.id ~= 0 and p.id == product_id then
			return p.grants or kind, math.clamp(math.floor(tonumber(p.count) or 1), 1, 10)
		end
	end
	return nil, 0
end

local function key(user_id: number): string
	return "u" .. tostring(user_id)
end

local function clean(v: any, user_id: number?): Record
	local rec: Record = {
		credits = {},
		receipts = {},
		owned = {},
		equipped = {},
		crates_bought = 0,
		stars = 0,
		stars_earned = 0,
		unlocks = {},
		paid = false,
		gifts = {},
	}
	if type(v) ~= "table" then
		v = {}
	end
	local function count(x: any): number
		local n = tonumber(x) or 0
		return if n ~= n then 0 else math.clamp(math.floor(n), 0, Purchases.MAX_STARS)
	end
	rec.stars = count(v.stars)
	rec.stars_earned = count(v.stars_earned)
	rec.tutorial_paid = if v.tutorial_paid == true then true else nil
	local gday = tonumber(v.general_day)
	rec.general_day = if gday ~= nil and gday == gday then math.floor(gday) else nil
	if type(v.unlocks) == "table" then
		for k, on in v.unlocks do
			if on == true and Arsenal.item(k) ~= nil then
				rec.unlocks[k] = true
			end
		end
	end
	if type(v.owned) == "table" then
		for id, on in v.owned do
			if on == true and Cosmetics.may_own(id, user_id) then
				rec.owned[id] = true
			end
		end
	end
	if type(v.gifts) == "table" then
		for id, on in v.gifts do
			if on == true and type(id) == "string" then
				rec.gifts[id] = true
			end
		end
	end
	if type(v.equipped) == "table" then
		for _, slot in { "skin", "flag" } do
			local id = v.equipped[slot]
			local it = Cosmetics.item(id)
			if it ~= nil and it.kind == slot and rec.owned[id] then
				rec.equipped[slot] = id
			end
		end
	end
	-- (made for this player: always owned; worn the first time, then their own choice)
	for _, id in Cosmetics.granted(user_id) do
		local it = Cosmetics.item(id)
		if it ~= nil then
			rec.owned[id] = true
			if not rec.gifts[id] then
				rec.gifts[id] = true
				rec.equipped[it.kind] = id
			end
		end
	end
	rec.crates_bought = math.max(0, math.floor(tonumber(v.crates_bought) or 0))
	if type(v.credits) == "table" then
		for k, n in v.credits do
			if type(k) == "string" and type(n) == "number" and n == n then
				rec.credits[k] = math.clamp(math.floor(n), 0, Purchases.MAX_CREDITS)
			end
		end
	end
	if type(v.receipts) == "table" then
		for _, r in v.receipts do
			if type(r) == "string" then
				table.insert(rec.receipts, r)
			end
		end
	end
	-- (a stored `paid` wins: Staging's "Replay as new player" sets it false with receipts kept)
	rec.paid = if type(v.paid) == "boolean" then v.paid else #rec.receipts > 0
	if type(v.starter) == "table" then
		local started, ends = tonumber(v.starter.started), tonumber(v.starter.ends)
		if started ~= nil and ends ~= nil and started == started and ends == ends then
			rec.starter = { started = started, ends = ends, used = if v.starter.used == true then true else nil }
		end
	end
	return rec
end

local function log(text: string)
	if deps.log then
		deps.log("[Purchases] " .. text)
	end
end

local function player_by_id(user_id: number): any
	local ps = deps.players
	if ps == nil then
		return nil
	end
	local ok, p = pcall(function()
		return ps:GetPlayerByUserId(user_id)
	end)
	return if ok then p else nil
end

local function remember(player: any, rec: Record)
	loading[player] = nil -- (the record is here: a load still retrying has nothing left to do)
	records[player] = rec
	cache[player] = rec.credits
	inv[player] = {
		owned = rec.owned,
		equipped = rec.equipped,
		crates_bought = rec.crates_bought,
		stars = rec.stars,
		stars_earned = rec.stars_earned,
		unlocks = rec.unlocks,
		paid = rec.paid,
		starter = rec.starter,
	}
end

local function now_s(): number
	return if type(deps.now) == "function" then deps.now() else os.time()
end

--- The starter pack's product exists here (Studio: always, its prompt is a test purchase).
local function starter_on_sale(): boolean
	local p = Products[Starter.PRODUCT]
	return p ~= nil and (p.id ~= 0 or deps.studio == true)
end

--- `r` (a record, or a player's inv entry) has every item the pack unlocks.
local function starter_all_owned(r: any): boolean
	for _, k in Starter.ITEMS do
		if not r.unlocks[k] then
			return false
		end
	end
	return true
end

--- `r` may be offered the pack for the first time: never paid Robux, has played (a match or the
--- tutorial paid Stars), and doesn't have all of it already.
local function starter_eligible(r: any): boolean
	return not r.paid and (r.stars_earned or 0) > 0 and not starter_all_owned(r)
end

--- The pack's receipt may be granted on record `rec` at time `t`.
local function starter_redeemable(rec: Record, t: number): boolean
	local s = rec.starter
	return s ~= nil and not s.used and t <= s.ends + Starter.GRACE_S
end

--- Unlocks Arsenal item `it` on `rec` (a Robux receipt, or Stars already taken): its bonus Stars come
--- with it once. Already unlocked: Stars for the price instead.
local function unlock_on(rec: Record, it: any, robux: number?)
	if rec.unlocks[it.key] then
		local back = math.floor((robux or 0) * Purchases.DUPLICATE_STARS_PER_ROBUX)
		rec.stars = math.min(rec.stars + back, Purchases.MAX_STARS)
		return
	end
	rec.unlocks[it.key] = true
	rec.stars = math.min(rec.stars + (it.bonus or 0), Purchases.MAX_STARS)
end

local function notify(player: any)
	if player ~= nil and deps.notify then
		pcall(deps.notify, player, table.clone(cache[player] or {}))
	end
	if player ~= nil and deps.inventory then
		pcall(deps.inventory, player, Purchases.inventory(player))
	end
end

--- The player's items for the client: owned ids (list), equipped, crates bought.
function Purchases.inventory(player: any): any
	local i = inv[player]
	local owned = {}
	if i ~= nil then
		for id in i.owned do
			table.insert(owned, id)
		end
		table.sort(owned)
	end
	local unlocks = {}
	if i ~= nil then
		for k in i.unlocks do
			table.insert(unlocks, k)
		end
		table.sort(unlocks)
	end
	return {
		owned = owned,
		equipped = if i ~= nil then table.clone(i.equipped) else {},
		crates_bought = if i ~= nil then i.crates_bought else 0,
		stars = if i ~= nil then i.stars else 0,
		unlocks = unlocks,
		starter = Purchases.starter_state(player),
	}
end

--- The starter pack for this player: false (none: not eligible, bought, ended, or not on sale here),
--- { state = "ready" } (never shown yet: the client shows it and says so, starter_seen), or
--- { state = "active", left = seconds } (its clock is running).
function Purchases.starter_state(player: any): any
	local i = inv[player]
	if i == nil or not starter_on_sale() or starter_all_owned(i) then
		return false
	end
	local s = i.starter
	if s ~= nil then
		local left = s.ends - now_s()
		if s.used or left <= 0 then
			return false
		end
		return { state = "active", left = left }
	end
	return if starter_eligible(i) then { state = "ready" } else false
end

--- The offer is on the player's screen: its clock starts, once (a no-op when it already ran or they
--- can't have it). Yields. True when the clock started now.
function Purchases.starter_seen(player: any): boolean
	if not starter_on_sale() then
		return false
	end
	local started = false
	local stored: Record? = nil
	local ok, err = pcall(function()
		update(player.UserId, function(old: any): any
			started = false
			local rec = clean(old, player.UserId)
			stored = rec
			if rec.starter ~= nil or not starter_eligible(rec) then
				return nil
			end
			local t = now_s()
			rec.starter = { started = t, ends = t + Starter.DURATION_S }
			started = true
			return rec
		end)
	end)
	if not ok or stored == nil then
		log("could not start the starter pack for " .. tostring(player.UserId) .. ": " .. tostring(err))
		return false
	end
	remember(player, stored :: Record)
	notify(player)
	return started
end

--- True when the player has Arsenal item `key` (as last read or written).
function Purchases.has_unlock(player: any, key: string): boolean
	local i = inv[player]
	return i ~= nil and i.unlocks[key] == true
end

--- The player's Arsenal as the Sim's bit mask (Defs.UNLOCK; Sim.set_unlocks).
function Purchases.unlock_mask(player: any): number
	local i = inv[player]
	return if i ~= nil then Arsenal.mask(i.unlocks) else 0
end

function Purchases.stars(player: any): number
	local i = inv[player]
	return if i ~= nil then i.stars else 0
end

--- What the player shows in a match: { skin = id?, flag = id? } (nil when nothing is equipped).
function Purchases.equipped(player: any): any
	local i = inv[player]
	if i == nil or (i.equipped.skin == nil and i.equipped.flag == nil) then
		return nil
	end
	return table.clone(i.equipped)
end

--- Roblox's ProcessReceipt: store the credit, then say granted (never before it is stored).
function Purchases.process_receipt(info: any): string
	local user_id = tonumber(info and info.PlayerId)
	local product = tonumber(info and info.ProductId)
	local receipt = if info and type(info.PurchaseId) == "string" then info.PurchaseId else nil
	local kind, n = nil, 1
	if product then
		kind, n = Purchases.kind_of(product)
	end
	if user_id == nil or kind == nil or receipt == nil then
		log("unknown receipt for product " .. tostring(product))
		return "not_processed"
	end
	return Purchases.grant(user_id, kind, receipt, n, tonumber(info.CurrencySpent))
end

--- Store `n` (default 1) `kind` credits for `user_id` under `receipt` (once per receipt). "granted" once
--- stored. `spent`: the Robux the receipt says were paid (Managed Pricing: not always the set price),
--- passed on to deps.bought.
function Purchases.grant(user_id: number, kind: string, receipt: string, n: number?, spent: number?): string
	local count = math.clamp(math.floor(n or 1), 1, 10)
	local stored: Record? = nil
	local refused = false
	local ok, err = pcall(function()
		update(user_id, function(old: any): any
			refused = false
			local rec = clean(old, user_id)
			if table.find(rec.receipts, receipt) then
				stored = rec -- granted before (a retry): nothing to add
				return nil
			end
			local unlock_key = string.match(kind, "^unlock:(.+)$")
			local it = if unlock_key ~= nil then Arsenal.item(unlock_key) else nil
			local shop_key = string.match(kind, "^shopflag:(.+)$")
			local set_id = string.match(kind, "^shopset:(.+)$")
			if set_id ~= nil then
				local keys = Shop.set_keys(set_id)
				local total = Shop.set_total(set_id)
				local p = Products["shopset_" .. set_id]
				local paid = if p ~= nil then p.robux else 0
				local wear: string? = nil
				for _, k in keys do
					local id = Shop.item_id(k)
					if rec.owned[id] then
						local share = if total > 0 then paid * Shop.price(Shop.flag(k)) / total else 0
						rec.stars = math.min(rec.stars + math.floor(share * Purchases.DUPLICATE_STARS_PER_ROBUX), Purchases.MAX_STARS)
					else
						rec.owned[id] = true
						wear = wear or id -- (the keys come rarest first)
					end
				end
				if #keys == 0 then
					rec.stars = math.min(rec.stars + math.floor(paid * Purchases.DUPLICATE_STARS_PER_ROBUX), Purchases.MAX_STARS)
				end
				local worn = Shop.key_of(rec.equipped.flag)
				local worn_set = if worn ~= nil then (Shop.flag(worn) :: any).set else nil
				if wear ~= nil and worn_set ~= set_id then
					rec.equipped.flag = wear
				end
			elseif shop_key ~= nil then
				local id = Shop.item_id(shop_key)
				if Shop.flag(shop_key) == nil or rec.owned[id] then
					-- (owned already, or a flag this build doesn't know: Stars for the price)
					local p = Products["shop_" .. shop_key]
					local back = math.floor((if p ~= nil then p.robux else 0) * Purchases.DUPLICATE_STARS_PER_ROBUX)
					rec.stars = math.min(rec.stars + back, Purchases.MAX_STARS)
				else
					rec.owned[id] = true
					rec.equipped.flag = id -- (chosen and paid for: worn at once)
				end
			elseif kind == "starter" then
				local t = now_s()
				if not starter_redeemable(rec, t) then
					refused = true
					return nil
				end
				for _, k in Starter.ITEMS do
					local item = Arsenal.item(k)
					if item ~= nil then
						local p = Products[item.product]
						unlock_on(rec, item, if p ~= nil then p.robux else 0)
					end
				end
				local s = rec.starter :: any
				s.used = true
				s.bought = t
			elseif it ~= nil then
				local p = Products[it.product]
				unlock_on(rec, it, if p ~= nil then p.robux else 0)
			else
				rec.credits[kind] = math.min((rec.credits[kind] or 0) + count, Purchases.MAX_CREDITS)
				if kind == "crate" then
					rec.crates_bought += count
				end
			end
			table.insert(rec.receipts, receipt)
			while #rec.receipts > Purchases.RECEIPTS_KEPT do
				table.remove(rec.receipts, 1)
			end
			rec.paid = true
			stored = rec
			return rec
		end)
	end)
	if ok and refused then
		log(string.format("refused starter pack %s for %d: no running offer", receipt, user_id))
		return "not_processed"
	end
	if not ok or stored == nil then
		log("could not store receipt " .. receipt .. ": " .. tostring(err))
		return "not_processed"
	end
	local player = player_by_id(user_id)
	if player ~= nil then
		remember(player, stored :: Record)
		notify(player)
		if deps.bought then
			pcall(deps.bought, player, kind, count, spent)
		end
		local unlocked = if kind == "starter" then "" else string.match(kind, "^unlock:(.+)$")
		if unlocked ~= nil and deps.unlocked then
			pcall(deps.unlocked, player, unlocked)
		end
	end
	log(string.format("granted %s%s to %d (%s)", kind, if count > 1 then " x" .. count else "", user_id, receipt))
	return "granted"
end

--- Yields: LOAD_ATTEMPTS reads with LOAD_BACKOFF between them, then, with the session already going
--- on an empty record, more every LOAD_RETRY_S (deps.wait; without one, a single attempt).
--- A player teleported here by a server of ours comes with the record that server held when they left
--- (deps.arrived: server/Handoff); then nothing is read.
function Purchases.load(player: any)
	local token = {}
	loading[player] = token
	if deps.arrived then
		local ok, got = pcall(deps.arrived, player)
		if loading[player] ~= token then
			return
		end
		if ok and type(got) == "table" and type(got.p) == "table" then
			remember(player, clean(got.p, player.UserId))
			notify(player)
			return
		end
	end
	local wait = deps.wait
	local tries = 0
	while true do
		tries += 1
		local ok, v = pcall(function()
			return deps.datastore:GetAsync(key(player.UserId))
		end)
		if loading[player] ~= token then
			return -- (they left, a write brought the record, or another load began)
		end
		if ok then
			remember(player, clean(v, player.UserId))
			notify(player)
			if tries > Purchases.LOAD_ATTEMPTS and deps.unlocked then
				-- (it came late: the match they are in learns what they have unlocked)
				pcall(deps.unlocked, player, "")
			end
			return
		end
		local last = not wait or tries >= Purchases.LOAD_ATTEMPTS + Purchases.LOAD_RETRIES
		if tries == Purchases.LOAD_ATTEMPTS or (last and tries < Purchases.LOAD_ATTEMPTS) then
			cache[player] = cache[player] or {}
			log(
				"load failed for "
					.. tostring(player.UserId)
					.. ": "
					.. tostring(v)
					.. (if last then "" else " (trying again while they stay)")
			)
			notify(player)
		end
		if last then
			loading[player] = nil
			return
		end
		wait(if tries < Purchases.LOAD_ATTEMPTS then Purchases.LOAD_BACKOFF[tries] or 10 else Purchases.LOAD_RETRY_S)
	end
end

function Purchases.credits(player: any): { [string]: number }
	return table.clone(cache[player] or {})
end

--- Spend one `kind` credit (atomic on the stored record). Yields.
function Purchases.use(player: any, kind: string): (boolean, string?)
	if Products[kind] == nil then
		return false, "unknown product"
	end
	local spent = false
	local left: { [string]: number }? = nil
	local ok, err = pcall(function()
		update(player.UserId, function(old: any): any
			spent = false
			local rec = clean(old, player.UserId)
			left = rec.credits
			remember(player, rec)
			if (rec.credits[kind] or 0) <= 0 then
				return nil
			end
			rec.credits[kind] -= 1
			spent = true
			left = rec.credits
			return rec
		end)
	end)
	if not ok then
		return false, "store unavailable: " .. tostring(err)
	end
	if left ~= nil then
		cache[player] = left
	end
	notify(player)
	if not spent then
		return false, "no credit"
	end
	return true, nil
end

function Purchases.release(player: any)
	loading[player] = nil
	cache[player] = nil
	inv[player] = nil
	records[player] = nil
	doubt[player.UserId] = nil
end

--- A player leaving for another server of ours (server/Handoff): waits, at most `max_s`, for this
--- server's writes to their record to land (a match's Stars are often still being paid), then returns
--- the record as it now stands; nil when it isn't known for sure (never read, still loading, a write
--- that failed or hasn't landed): the next server reads the store. Yields. Call before release.
function Purchases.settle(player: any, max_s: number): any
	local uid = player.UserId
	local waited = 0
	while busy[uid] ~= nil and deps.wait ~= nil and waited < max_s do
		waited += 0.1
		deps.wait(0.1)
	end
	if busy[uid] ~= nil or doubt[uid] or loading[player] ~= nil or inv[player] == nil then
		return nil
	end
	return records[player]
end

--- What a write error was, in a word (for the warning the error report counts).
local function reason(err: any): string
	local text = tostring(err)
	for _, word in { "TooManyRequests", "InternalServerError", "ServiceUnavailable", "Throttled", "queue was full" } do
		if string.find(text, word, 1, true) then
			return word
		end
	end
	return "other"
end

--- Stars that could not be paid after every retry (2026-11-03: the error report showed the store
--- refusing requests, not whether a payout was lost in the end). The server log has who and how many;
--- the warning is worded the same each time so the error report counts them by kind and reason.
local function stars_lost(user_id: number, amount: number, what: string, err: any)
	Purchases.lost.payouts += 1
	Purchases.lost.stars += amount
	log(string.format("could not pay %d %s Stars to %d: %s", amount, what, user_id, tostring(err)))
	if deps.warn then
		deps.warn(string.format("[Purchases] %s Stars lost after every retry (%s)", what, reason(err)))
	end
end

--- Open one crate: spend a crate credit and add an item the player doesn't own (Cosmetics.roll, the
--- published odds), in one write; the new item is equipped when its slot is empty. Yields.
--- (ok, item_id) or (false, "no crate" | "everything owned" | "store unavailable: ...").
function Purchases.open_crate(player: any): (boolean, string?)
	local rng = deps.rng or Random.new()
	local got: string? = nil
	local why = "no crate"
	local stored: Record? = nil
	local ok, err = pcall(function()
		update(player.UserId, function(old: any): any
			got = nil
			local rec = clean(old, player.UserId)
			stored = rec
			if (rec.credits.crate or 0) <= 0 then
				why = "no crate"
				return nil
			end
			local id = Cosmetics.roll(rec.owned, rng:NextNumber(), rng:NextNumber())
			if id == nil then
				why = "everything owned"
				return nil
			end
			rec.credits.crate -= 1
			rec.owned[id] = true
			local it = Cosmetics.item(id)
			if it ~= nil and rec.equipped[it.kind] == nil then
				rec.equipped[it.kind] = id
			end
			got = id
			return rec
		end)
	end)
	if not ok then
		return false, "store unavailable: " .. tostring(err)
	end
	if stored ~= nil then
		remember(player, stored :: Record)
	end
	notify(player)
	if got == nil then
		return false, why
	end
	return true, got
end

--- Equip an owned item in its slot ("skin" / "flag"), or clear the slot (id false). Yields.
function Purchases.equip(player: any, slot: string, id: any): (boolean, string?)
	if slot ~= "skin" and slot ~= "flag" then
		return false, "bad slot"
	end
	if id ~= false then
		local it = Cosmetics.item(id)
		if it == nil or it.kind ~= slot then
			return false, "unknown item"
		end
	end
	local done = false
	local stored: Record? = nil
	local ok, err = pcall(function()
		update(player.UserId, function(old: any): any
			done = false
			local rec = clean(old, player.UserId)
			stored = rec
			if id ~= false and not rec.owned[id] then
				return nil
			end
			rec.equipped[slot] = if id == false then nil else id
			done = true
			return rec
		end)
	end)
	if not ok then
		return false, "store unavailable: " .. tostring(err)
	end
	if stored ~= nil then
		remember(player, stored :: Record)
	end
	notify(player)
	return done, if done then nil else "not owned"
end

--- Pays `amount` Stars (a match's payout, Data/Stars). Yields. (ok, the new balance).
--- The Stars for finishing the tutorial (Data/Tutorial), once per player. True when they were paid now.
function Purchases.tutorial_bonus(player: any, amount: number): boolean
	local add = math.floor(tonumber(amount) or 0)
	if add ~= add or add <= 0 then
		return false
	end
	local stored: Record? = nil
	local paid = false
	local ok, err = pcall(function()
		update(player.UserId, function(old: any): any
			local rec = clean(old, player.UserId)
			stored = rec
			if rec.tutorial_paid then
				paid = false
				return nil
			end
			paid = true
			rec.tutorial_paid = true
			rec.stars = math.min(rec.stars + add, Purchases.MAX_STARS)
			rec.stars_earned = math.min(rec.stars_earned + add, Purchases.MAX_STARS)
			return rec
		end)
	end)
	if not ok or stored == nil then
		stars_lost(player.UserId, add, "tutorial", err)
		return false
	end
	remember(player, stored :: Record)
	if paid then
		notify(player)
	end
	return paid
end

--- RoWorld General (Data/Subscription; 2026-10-27; server/General calls it while Roblox says the
--- player is subscribed): UTC day `day`'s crate credit, or, where crates aren't allowed (`crates`
--- false), Subscription.DAILY_STARS Stars, once a day; and the month's General skin `skin`, kept for
--- good (put on when no skin is worn). Returns what it gave now ({ crate?, stars?, skin? }; {} when
--- the day's were given already), or nil when the store failed (tried again later).
function Purchases.general_perks(player: any, day: number, skin: string?, crates: boolean): any
	local it = if skin ~= nil then Cosmetics.item(skin) else nil
	local stored: Record? = nil
	local given: any = {}
	local ok, err = pcall(function()
		update(player.UserId, function(old: any): any
			local rec = clean(old, player.UserId)
			stored = rec
			given = {}
			local changed = false
			if rec.general_day ~= day then
				rec.general_day = day
				if crates then
					rec.credits.crate = math.min((rec.credits.crate or 0) + 1, Purchases.MAX_CREDITS)
					given.crate = true
				else
					rec.stars = math.min(rec.stars + Subscription.DAILY_STARS, Purchases.MAX_STARS)
					rec.stars_earned = math.min(rec.stars_earned + Subscription.DAILY_STARS, Purchases.MAX_STARS)
					given.stars = Subscription.DAILY_STARS
				end
				changed = true
			end
			if it ~= nil and it.general and not rec.owned[it.id] then
				rec.owned[it.id] = true
				if rec.equipped[it.kind] == nil then
					rec.equipped[it.kind] = it.id
				end
				given.skin = it.id
				changed = true
			end
			return if changed then rec else nil
		end)
	end)
	if not ok or stored == nil then
		log("could not give " .. tostring(player.UserId) .. " their General's day: " .. tostring(err))
		return nil
	end
	remember(player, stored :: Record)
	if next(given) ~= nil then
		notify(player)
	end
	return given
end

--- Rofront Staging's "Replay as new player": the tutorial's Stars can be earned again, the first
--- crate's price is on offer again, and so is the starter pack (as one who never paid, its clock not
--- started, and without the pack's three items, which a new player doesn't have: the only things
--- taken; Stars, cosmetics and other unlocks stay). `keep_owned` (a game admin on production,
--- 2026-10-27): nothing is taken, and one who paid is still one who paid.
function Purchases.reset_new_player(player: any, keep_owned: boolean?): boolean
	local stored: Record? = nil
	local ok, err = pcall(function()
		update(player.UserId, function(old: any): any
			local rec = clean(old, player.UserId)
			rec.tutorial_paid = nil
			rec.crates_bought = 0
			rec.starter = nil
			if not keep_owned then
				rec.paid = false
				for _, k in Starter.ITEMS do
					rec.unlocks[k] = nil
				end
			end
			stored = rec
			return rec
		end)
	end)
	if not ok or stored == nil then
		log("could not reset " .. tostring(player.UserId) .. ": " .. tostring(err))
		return false
	end
	remember(player, stored :: Record)
	notify(player)
	return true
end

function Purchases.add_stars(player: any, amount: number): (boolean, number)
	local add = math.floor(tonumber(amount) or 0)
	if add ~= add or add <= 0 then
		return false, Purchases.stars(player)
	end
	local stored: Record? = nil
	local ok, err = pcall(function()
		update(player.UserId, function(old: any): any
			local rec = clean(old, player.UserId)
			rec.stars = math.min(rec.stars + add, Purchases.MAX_STARS)
			rec.stars_earned = math.min(rec.stars_earned + add, Purchases.MAX_STARS)
			stored = rec
			return rec
		end)
	end)
	if not ok or stored == nil then
		stars_lost(player.UserId, add, "match", err)
		return false, Purchases.stars(player)
	end
	remember(player, stored :: Record)
	notify(player)
	return true, (stored :: Record).stars
end

--- Unlock Arsenal item `key` with Stars: one write takes its price and unlocks it. Yields.
--- (ok) or (false, "unknown item" | "robux only" | "owned" | "not enough" | "store unavailable: ...").
function Purchases.buy_unlock(player: any, item_key: any): (boolean, string?)
	local it = Arsenal.item(item_key)
	if it == nil then
		return false, "unknown item"
	end
	if it.stars == nil then
		return false, "robux only"
	end
	local why = "store unavailable"
	local done = false
	local stored: Record? = nil
	local ok, err = pcall(function()
		update(player.UserId, function(old: any): any
			done = false
			local rec = clean(old, player.UserId)
			stored = rec
			if rec.unlocks[it.key] then
				why = "owned"
				return nil
			end
			if rec.stars < it.stars then
				why = "not enough"
				return nil
			end
			rec.stars -= it.stars
			unlock_on(rec, it, 0)
			done = true
			return rec
		end)
	end)
	if not ok then
		return false, "store unavailable: " .. tostring(err)
	end
	if stored ~= nil then
		remember(player, stored :: Record)
	end
	notify(player)
	if not done then
		return false, why
	end
	if deps.unlocked then
		pcall(deps.unlocked, player, it.key)
	end
	log(string.format("%d unlocked %s for %d Stars", player.UserId, it.key, it.stars))
	return true, nil
end

return Purchases
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="101">
        <Properties>
          <string name="Name">Rewards</string>
          <string name="Source"><![CDATA[--!strict
-- Stars for a match (shared/Data/Stars; spent in the Arsenal, shared/Data/Arsenal).
--
-- A public match runs on this server: MatchServer follows it (Stars.Tracker) and its results are paid
-- as they are (Rewards.pay). A solo match runs on the player's own device, so its result is the
-- client's word (OP.SOLO_RESULT): it is typed and bounded (Stars.sanitize), can't be longer than the
-- match really lasted on this server's clock (counted from the client's "match_start" report), and
-- never pays more than Stars.solo_cap of that real time. So a made-up report earns no faster than a
-- good player, and nothing at all without the time passing.
--
--   Rewards.configure(deps)          { add_stars = fn(player, n) -> (ok, balance), double = fn(player)
--                                      -> boolean, general = fn(player) -> boolean, send = fn(player,
--                                      payload), now = fn() -> s, log? }
-- A RoWorld General (Data/Subscription) gets Subscription.STARS_BONUS of the match's Stars on top
-- (before 2x Stars doubles: the "general" line).
--   Rewards.solo_started(player, mode)   the client's match_start ("solo0" / "solo1" / "solo2")
--   Rewards.solo_result(player, report)  OP.SOLO_RESULT (yields)
--   Rewards.pay(player, result, mode)    a result this server measured itself (yields)
--   Rewards.release(player)              PlayerRemoving
-- The payload sent to the client (OP.STARS): { lines = { { key, amount } }, total, balance, mode }.
local IS_ROBLOX = typeof(game) == "Instance"
local Stars: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Stars)
	else require("../shared/Data/Stars")
local Subscription: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Subscription)
	else require("../shared/Data/Subscription")

local Rewards = {}

--- Results one solo match may be paid for: its end, and one more for each life a takeover gave it.
Rewards.MAX_SOLO_PAYOUTS = 4
--- Slack on the real time a solo result may claim (the report's trip, the clock's grain), minutes.
Rewards.SLACK_MIN = 0.25

type Solo = { mode: string, paid_at: number, payouts: number }

local deps: { [string]: any } = {}
local solo: { [any]: Solo } = {}

function Rewards.configure(d: { [string]: any })
	for k, v in d do
		deps[k] = v
	end
end

--- Tests: forget everyone.
function Rewards.reset()
	table.clear(solo)
end

local function now(): number
	return if deps.now then deps.now() else os.clock()
end

local function deliver(player: any, lines: { { any } }, total: number, mode: string): number
	if total <= 0 then
		return 0
	end
	local ok, balance = deps.add_stars(player, total)
	if not ok then
		return 0
	end
	if deps.send then
		pcall(deps.send, player, { lines = lines, total = total, balance = balance, mode = mode })
	end
	if deps.log then
		deps.log(string.format("[Rewards] %s +%d Stars (%s)", tostring(player.UserId), total, mode))
	end
	return total
end

local function with_double(player: any, lines: { { any } }, total: number): ({ { any } }, number)
	local base = total
	if total > 0 and deps.double and deps.double(player) == true then
		table.insert(lines, { "double", total })
		total *= 2
	end
	if base > 0 and deps.general and deps.general(player) == true then
		local extra = Subscription.bonus(base, Stars.QUANTUM)
		if extra > 0 then
			table.insert(lines, { "general", extra })
			total += extra
		end
	end
	return lines, total
end

--- A result this server measured itself (a public match). Returns the Stars paid.
function Rewards.pay(player: any, result: any, mode: string?): number
	local m = mode or "public"
	local p = Stars.payout(result, m, false)
	local lines, total = with_double(player, p.lines, p.total)
	return deliver(player, lines, total, m)
end

function Rewards.solo_started(player: any, mode: any)
	if type(mode) ~= "string" or Stars.MODE_MULT[mode] == nil or mode == "public" then
		solo[player] = nil
		return
	end
	solo[player] = { mode = mode, paid_at = now(), payouts = 0 }
end

--- The client's result of the solo match it reported starting. Returns the Stars paid.
function Rewards.solo_result(player: any, report: any): number
	local m = solo[player]
	if m == nil or m.payouts >= Rewards.MAX_SOLO_PAYOUTS then
		return 0
	end
	local t = now()
	local real = math.max(0, (t - m.paid_at) / 60)
	local r = Stars.sanitize(report, real + Rewards.SLACK_MIN)
	m.payouts += 1
	m.paid_at = t
	if r.left then
		solo[player] = nil -- the match is over for this player
	end
	local p = Stars.payout(r, m.mode, false)
	local lines, total = p.lines, p.total
	local cap = Stars.solo_cap(real)
	if total > cap then
		-- more than that much real time can pay: every line shrinks alike
		local k = cap / total
		total = 0
		for _, line in lines do
			line[2] = math.floor(line[2] * k / Stars.QUANTUM) * Stars.QUANTUM
			total += line[2]
		end
	end
	lines, total = with_double(player, lines, total)
	return deliver(player, lines, total, m.mode)
end

function Rewards.release(player: any)
	solo[player] = nil
end

return Rewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="102">
        <Properties>
          <string name="Name">ServerMain</string>
          <string name="Source"><![CDATA[--!strict
-- Roblox server entry for the multiplayer match (the server half of scripts/net/session.gd plus the
-- server duties of scripts/main.gd). Every Roblox server hosts one shared match (MatchServer); players
-- pick Solo (runs on their client, never touches the server) or Multiplayer on the title screen.
--
-- Networking: ReplicatedStorage.AirfrontNet.ToServer / ToClient RemoteEvents (one per direction, so
-- everything in a direction is strictly ordered: snapshot before deltas, deltas in tick order). The
-- first argument is an op code (Net/Protocol.OP). Deltas / snapshots / intents are buffers.
--
-- Also: per-player settings (SettingsStore), graceful shutdown (BindToClose), and optional stats
-- logging (workspace attribute AF_NET_STATS = true prints a line every 30 s).
--
-- Maps: the terrain of every map but the default lives in script.Parent.MapData (server only);
-- WorldMap gets a provider for it, and AirfrontNet.GetMap (Net/MapFetch) serves it to clients that
-- need a map for solo play or an upcoming multiplayer match.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Airfront")
local Protocol = require(Shared.Net.Protocol) :: any
local MapFetch = require(Shared.Net.MapFetch) :: any
local LobbyRules = require(script.Parent.Lobbies.LobbyRules) :: any
local LobbyStore = require(script.Parent.Lobbies.LobbyStore) :: any
local LobbyDirectory = require(script.Parent.Lobbies.LobbyDirectory) :: any
local MatchHost = require(script.Parent.Lobbies.MatchHost) :: any
local Teleports = require(script.Parent.Lobbies.Teleports) :: any
local Party = require(script.Parent.Party) :: any
local SharedClock = require(script.Parent.Lobbies.SharedClock) :: any
local LobbyHttp = require(script.Parent.Lobbies.LobbyHttp) :: any
-- (gitignored: a clone without it keeps the MemoryStore lobby list; tools/publish.sh won't ship without it)
local SecretModule = script.Parent.Lobbies:FindFirstChild("Secret")
local LobbySecret = if SecretModule then require(SecretModule :: ModuleScript) :: any else nil
local BotNames = require(Shared.Data.BotNames) :: any
local BotFaces = require(script.Parent.BotFaces) :: any
local FreshServers = require(script.Parent.FreshServers) :: any
local TutorialData = require(Shared.Data.Tutorial) :: any
local Staging = require(Shared.Data.Staging) :: any
local HttpService = game:GetService("HttpService")
local MapList = require(Shared.Data.MapList) :: any
local MatchServer = require(script.Parent.MatchServer) :: any
local SettingsStore = require(script.Parent.SettingsStore) :: any
local Analytics = require(script.Parent.Analytics) :: any
local ServerPerf = require(script.Parent.ServerPerf) :: any
local AdminCheck = require(script.Parent.AdminCheck) :: any
local DsGate = require(script.Parent.DsGate) :: any
local Handoff = require(script.Parent.Handoff) :: any
local Purchases = require(script.Parent.Purchases) :: any
local Rewards = require(script.Parent.Rewards) :: any
local General = require(script.Parent.General) :: any
local Subscription = require(Shared.Data.Subscription) :: any
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local DataStoreService = game:GetService("DataStoreService")

local OP = Protocol.OP

local ServerMain = {}
ServerMain.server = nil :: any
--- Messages a client may send per second before the rest is ignored (intents have their own 30/s).
ServerMain.MAX_MESSAGES_PER_SEC = 90
--- The production experience (Rofront; build/publish.json). Other experiences running this code
--- (Rofront Staging) stay off the services production shares.
ServerMain.PROD_UNIVERSE = 10768172922
--- Team games and parties in production (docs/teams-and-parties.md; always on in Staging and Studio).
ServerMain.TEAM_GAMES_LIVE = true
--- SETTING messages per second per client (clients throttle each section to 2/s).
ServerMain.MAX_SETTINGS_PER_SEC = 8
--- ANALYTICS messages per second per client (a client sends a handful per match).
ServerMain.MAX_ANALYTICS_PER_SEC = 6
ServerMain.MAX_CREDIT_USES_PER_SEC = 2
--- A player may ask to be sent to a fresh server (OP.SOLO_HOP) this often, seconds.
ServerMain.HOP_GAP_S = 15
--- A client sends HELLO once (its scripts started). Further HELLOs from the same player are answered
--- at most this often (LOBBY); the SETTINGS reply has its own, longer limit (SettingsStore.replay).
--- review_code.md R2-2: every HELLO used to echo the whole stored settings blob.
ServerMain.HELLO_MIN_INTERVAL_S = 2.0
--- The match's instrumentation window; each one also goes to the lobby service (ServerPerf; 30 s
--- until 2026-11-01).
ServerMain.STATS_EVERY_S = 60
--- Hubs push the public-lobby list to their players this often (seconds).
ServerMain.LOBBIES_PUSH_S = 2.0

local started = false

--- Reports an error once per distinct message (first line), so a recurring fault can't flood the log.
local reported: { [string]: boolean } = {}
local reported_n = 0
local function report_once(where: string, err: any)
	local text = tostring(err)
	local key = where .. ":" .. (string.match(text, "^[^\n]*") or "")
	if reported[key] or reported_n >= 64 then
		return
	end
	reported[key] = true
	reported_n += 1
	warn(string.format("[RoWorldServer] %s failed: %s", where, text))
end

local function core(name: string): any
	local m = Shared.Core:FindFirstChild(name)
	if m == nil then
		return nil
	end
	return (require :: any)(m)
end

function ServerMain.start()
	if started then
		return
	end
	started = true
	Players.CharacterAutoLoads = false
	pcall(function()
		StarterGui.ResetPlayerGuiOnSpawn = false
	end)

	-- Server-only map data (src/server/MapData) for WorldMap.get / MapFetch.
	local WorldMapMod = core("WorldMap")
	local map_folder = script.Parent:FindFirstChild("MapData")
	if WorldMapMod ~= nil then
		WorldMapMod.add_provider(function(id: string): any
			local row = MapList.get(id)
			local mod = if row ~= nil and map_folder ~= nil then map_folder:FindFirstChild(row.module) else nil
			return if mod ~= nil then (require :: any)(mod) else nil
		end)
	end

	local folder = Instance.new("Folder")
	folder.Name = "AirfrontNet"
	if WorldMapMod ~= nil then
		MapFetch.serve(folder, function(id: string): any
			return WorldMapMod.load_data(id)
		end)
	end
	local to_server = Instance.new("RemoteEvent")
	to_server.Name = "ToServer"
	to_server.Parent = folder
	local to_client = Instance.new("RemoteEvent")
	to_client.Name = "ToClient"
	to_client.Parent = folder

	local listening: { [Player]: boolean } = {}
	local listening_list: { Player } = {}
	local msg_budget: { [Player]: number } = {}
	local setting_budget: { [Player]: number } = {}
	local analytics_budget: { [Player]: number } = {}
	local credit_budget: { [Player]: number } = {}
	--- server/FreshServers on a live hub (nil elsewhere), and when each player last asked to hop
	local fresh: any = nil
	local hop_at: { [Player]: number } = {}
	--- the INVENTORY payload for a player (set below, with the paid-random-items policy)
	local inventory_of: (any) -> any
	local hello_at: { [Player]: number } = {}
	local joining_lobby: { [Player]: boolean } = {}
	--- Players who came to watch (a hub's Watch teleport, or Studio's local Watch).
	local spectating: { [Player]: boolean } = {}

	-- Dev diagnostics (workspace attribute AF_DIAG; never set in the shipped place) can add fake
	-- participants (tables) next to real Players.
	local diag: any = nil
	if workspace:GetAttribute("AF_DIAG") == true then
		local m = script.Parent:FindFirstChild("Dev") and script.Parent.Dev:FindFirstChild("SessionDiag")
		if m then
			diag = (require :: any)(m)
		end
	end

	local function send(player: any, op: number, ...: any)
		if typeof(player) == "Instance" then
			if player.Parent == Players then
				to_client:FireClient(player, op, ...)
			end
		elseif diag ~= nil and diag.is_fake(player) then
			diag.deliver(player, op, ...)
		end
	end

	-- Public lobbies: a public server is a HUB (title, solo, the
	-- game-wide lobby list; joining a lobby teleports to its reserved server); a reserved server made
	-- for a lobby is that lobby's MATCH server (one match, bot players fill the empty slots, then
	-- everyone goes back to a hub). Studio has no teleports: a joined lobby runs on the same server.
	local is_match_server = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
	ServerMain.kind = if is_match_server then "match" else "hub"
	-- Team games and parties (docs/teams-and-parties.md): on Staging only at first, then
	-- in production too (since 2026-10-10). TEAM_GAMES_LIVE = false puts
	-- production back to two free-for-all lobbies and no parties.
	local TEAM_GAMES = ServerMain.TEAM_GAMES_LIVE or Staging.here() or RunService:IsStudio()
	ServerMain.team_games = TEAM_GAMES
	-- A live public hub takes part in server/FreshServers: it announces its version, lists itself
	-- while it is the newest, and once it is outdated sends the players who start a solo match to a
	-- fresh server (2026-10-04). Clients read workspace attribute RF_Outdated. Private servers,
	-- match servers and Studio stay out of it.
	if game.PrivateServerId == "" and not RunService:IsStudio() then
		local ok_fresh, err_fresh = pcall(function()
			local MSS = game:GetService("MemoryStoreService")
			local Messaging = game:GetService("MessagingService")
			local list = MSS:GetSortedMap("FreshHubs1")
			fresh = FreshServers.new({
				version = game.PlaceVersion,
				job_id = game.JobId,
				now = os.time,
				players = function(): number
					return #Players:GetPlayers()
				end,
				max_players = Players.MaxPlayers,
				publish = function(version: number)
					Messaging:PublishAsync("PlaceVersion", version)
				end,
				list_put = function(job_id: string, entry: any, ttl_s: number)
					list:SetAsync(job_id, entry, ttl_s)
				end,
				list_get = function(): any
					return list:GetRangeAsync(Enum.SortDirection.Ascending, 200)
				end,
				on_outdated = function(latest: number)
					workspace:SetAttribute("RF_Outdated", true)
				end,
				log = print,
			})
			task.spawn(function()
				pcall(function()
					Messaging:SubscribeAsync("PlaceVersion", function(msg: any)
						fresh:heard(if type(msg) == "table" then msg.Data else nil)
					end)
				end)
				while true do
					fresh:tick()
					task.wait(5)
				end
			end)
			-- a hop whose teleport could not start: the player plays here after all
			game:GetService("TeleportService").TeleportInitFailed:Connect(function(player: Player)
				if hop_at[player] ~= nil then
					send(player, OP.HOP_RESULT, false)
				end
			end)
		end)
		if not ok_fresh then
			warn("[Fresh] off: " .. tostring(err_fresh))
			fresh = nil
		end
	end
	-- Lobby times are written by one server and read by others: every server uses the shared clock
	-- (its own clock corrected against Roblox's backend), never its own os.time().
	SharedClock.start({ log = print })
	local now = SharedClock.now
	local store: any = nil
	local ok_store, st = pcall(LobbyStore.memory, game.JobId, now)
	if ok_store then
		store = st
	else
		warn("[Lobbies] MemoryStore unavailable, using a local store: " .. tostring(st))
		store = LobbyStore.localstore(now)
	end
	-- the lobby service on easy-1 (docs/lobby-service.md) in front of MemoryStore: with hundreds of
	-- servers reading the lobby list every few seconds MemoryStore refused most calls (one partition's
	-- limits, 2026-09-27). MemoryStore stays the fallback while the service is down or switched off.
	-- Studio uses it only when AF_LOBBY_URL points at a test service.
	local lobby_url: string? = nil
	if RunService:IsStudio() then
		local u = workspace:GetAttribute("AF_LOBBY_URL")
		lobby_url = if type(u) == "string" and u ~= "" then u else nil
	elseif LobbyHttp.ENABLED and game.GameId == ServerMain.PROD_UNIVERSE then
		-- (only the production experience: the service is one shared lobby list, and another
		-- experience, like Rofront Staging, must not show up in it; MemoryStore is its own per experience)
		lobby_url = LobbyHttp.BASE_URL
	end
	if lobby_url ~= nil and LobbySecret ~= nil then
		local client = LobbyHttp.roblox(LobbySecret, now, lobby_url, print)
		if client ~= nil then
			local fallback = store
			-- hubs tell the service who is playing solo / on the title (its live stats page)
			local presence = if ServerMain.kind == "hub"
				then function(): any
					return Analytics.presence(Players:GetPlayers())
				end
				else nil
			store = LobbyStore.failover(LobbyStore.http(client, ServerMain.kind, nil, presence), fallback, {
				healthy = function(): boolean
					return client:healthy()
				end,
				log = print,
			})
			ServerMain.lobby_client = client
			print("[Lobbies] lobby service " .. lobby_url .. " (MemoryStore as fallback)")
		else
			warn("[Lobbies] HTTP requests are off for this place: lobbies stay on MemoryStore")
		end
	end
	ServerMain.lobby_store = store
	-- What this server knew of a player follows them on its teleports (Handoff): the server they arrive
	-- on doesn't read their settings and Purchases record from the DataStores again.
	local handoff_map: any = nil
	pcall(function()
		handoff_map = game:GetService("MemoryStoreService"):GetHashMap(Handoff.MAP)
	end)
	local handoff = Handoff.new({
		map = handoff_map,
		guid = function(): string
			return HttpService:GenerateGUID(false)
		end,
		join_data = function(player: Player): any
			return player:GetJoinData()
		end,
		encode = function(v: any): string
			return HttpService:JSONEncode(v)
		end,
		spawn = task.spawn,
		wait = task.wait,
		now = os.clock,
		log = print,
	})
	ServerMain.handoff = handoff
	local teleports = Teleports.for_place(game.PlaceId, function(players: { Player }, data: any): any
		return handoff:stamp(players, data)
	end)
	local function lobby_maps(): { any }
		local out = {}
		for _, m in MapList.maps do
			if m.archive then
				continue
			end
			table.insert(out, {
				id = m.id,
				name = m.name,
				weight = m.multiplayer_frequency or 1,
				categories = m.categories,
				land = m.land_tiles,
				k_lin = m.k_lin,
			})
		end
		return out
	end
	local directory: any = nil
	local host: any = nil
	--- Studio stand-in for a lobby's reserved server: the lobby this server plays locally.
	local studio_lobby: any = nil
	if is_match_server then
		host = MatchHost.new({
			store = store,
			psid = game.PrivateServerId,
			now = now,
			to_hub = teleports.to_hub,
			log = print,
		})
		ServerMain.host = host
	else
		directory = LobbyDirectory.new({
			store = store,
			teleport = teleports,
			maps = lobby_maps,
			now = now,
			rand = math.random,
			new_id = function(): string
				return HttpService:GenerateGUID(false)
			end,
			log = print,
			team_games = TEAM_GAMES,
			-- (seats never past what a server holds: a seat past it is a "GameFull" teleport. Studio's
			-- Players.MaxPlayers is not the place's, so no cap there.)
			server_size = function(): number?
				return if RunService:IsStudio() then nil else Players.MaxPlayers
			end,
		})
		ServerMain.directory = directory
	end
	-- Parties (server/Party) on a hub; a match server knows who came in which party from the teleport
	-- data (user id → party key; party key → its leader's user id).
	local party: any = nil
	if TEAM_GAMES and not is_match_server then
		party = Party.new({
			send = function(p: Player, state: any)
				send(p, OP.PARTY_STATE, state)
			end,
			now = os.time,
			log = print,
			prefix = string.sub(game.JobId, 1, 8) .. ":",
		})
		ServerMain.party = party
	end
	local party_by_uid: { [string]: string } = {}
	local party_leader: { [string]: number } = {}
	--- The lobby hooks MatchServer uses on a match server (or for a Studio-local lobby).
	local function lobby_hooks(): any
		local function current(): any
			if host ~= nil then
				return host.lobby
			end
			return studio_lobby
		end
		return {
			countdown = function(): number?
				if host ~= nil then
					return host:starts_in()
				end
				local l = studio_lobby
				return if l then math.max(0, l.starts - now()) else nil
			end,
			info = function(): any
				local l = current()
				-- public matches play their map a bit smaller ("world@80"); a team game's teams
				return if l
					then { map_id = LobbyRules.match_map_id(l.map), max = l.max, mode = l.mode, teams = l.teams }
					else nil
			end,
			party_of = function(uid: string): string?
				return party_by_uid[uid]
			end,
			on_start = function(humans: number, voted: boolean?): number
				-- the humans a public match starts with (the headline number; goal: 50):
				-- one "Public Match Humans" event per match on the Creator Dashboard
				local slots = if host ~= nil and host.lobby
					then host.lobby.max
					elseif studio_lobby ~= nil then studio_lobby.max
					else humans
				local reporter = nil
				for _, p in Players:GetPlayers() do
					reporter = p
					break
				end
				if reporter ~= nil then
					Analytics.public_start(reporter, humans, slots, voted == true)
				end
				if host ~= nil then
					local bots = LobbyRules.bot_fill(if host.lobby then host.lobby.max else humans, humans)
					task.spawn(function()
						host:start(humans)
					end)
					return bots
				end
				local l = studio_lobby
				if l ~= nil then
					-- Studio: the local lobby shows as a live match to watch (the hub's own list)
					task.spawn(function()
						pcall(store.update, l.id, function(v: any): any?
							local cur = LobbyRules.decode(v)
							if cur == nil then
								return nil
							end
							cur.status = "started"
							cur.players = humans
							cur.beat = now()
							return cur
						end)
					end)
				end
				return if l then LobbyRules.bot_fill(l.max, humans) else 0
			end,
			bot_names = function(n: number, taken: { [string]: boolean }): { string }
				local rng = Random.new()
				return BotNames.many(n, function()
					return rng:NextNumber()
				end, taken)
			end,
			on_vote_start = function(seconds: number)
				if host ~= nil then
					task.spawn(function()
						host:start_early(seconds)
					end)
				elseif studio_lobby ~= nil then
					studio_lobby.starts = math.min(studio_lobby.starts, now() + math.ceil(seconds))
				end
			end,
			on_closed = function()
				if host ~= nil then
					task.spawn(function()
						host:finish()
					end)
				elseif studio_lobby ~= nil then
					local id = studio_lobby.id
					task.spawn(function()
						pcall(store.remove, id)
					end)
				end
			end,
			on_over = function(peers: { any })
				local list = {}
				for _, p in peers do
					if typeof(p) == "Instance" and p.Parent == Players then
						table.insert(list, p)
					end
				end
				if host ~= nil then
					-- (who was in which party: the hub makes the parties again)
					local back = nil
					if TEAM_GAMES then
						local parties, leaders = {}, {}
						for _, p in list do
							local key = party_by_uid[tostring(p.UserId)]
							if key ~= nil then
								parties[tostring(p.UserId)] = key
								leaders[key] = party_leader[key]
							end
						end
						if next(parties) ~= nil then
							back = { parties = parties, leaders = leaders }
						end
					end
					task.spawn(function()
						host:finish()
						host:return_to_hub(list, back)
					end)
				elseif studio_lobby ~= nil then
					local id = studio_lobby.id
					task.spawn(function()
						pcall(store.remove, id)
					end)
				end
				studio_lobby = nil
			end,
		}
	end

	local server = MatchServer.new({
		lobby = if is_match_server then lobby_hooks() else nil,
		-- the head shots bot players wear beside their names (Roblox user ids; server only)
		bot_faces = BotFaces,
		-- what a player wears in a match (Data/Cosmetics; the match server sends it to everyone)
		cosmetics_of = function(peer: any): any
			return if typeof(peer) == "Instance" then Purchases.equipped(peer) else nil
		end,
		-- the Arsenal a player has unlocked (Data/Arsenal), and their Stars for a public match
		unlocks_of = function(peer: any): number
			return if typeof(peer) == "Instance" then Purchases.unlock_mask(peer) else 0
		end,
		on_result = function(peer: any, result: any)
			if typeof(peer) == "Instance" then
				task.spawn(Rewards.pay, peer, result, "public")
			end
		end,
		make_sim = function(config: { [string]: any }): any
			local Sim = core("Sim")
			local WorldMap = core("WorldMap")
			if Sim == nil or WorldMap == nil then
				error("Core Sim is not available")
			end
			return Sim.new(WorldMap.get(config.map_id), config)
		end,
		send = send,
		peers = function(): { any }
			return listening_list
		end,
		now_ms = function(): number
			return os.clock() * 1000
		end,
		log = print,
	})
	ServerMain.server = server

	-- Quick Play on a hub (docs/lobby-service.md "Quick Play"): a player (a party leader: their party
	-- with them) asks for a public match of a kind; the store seats them in the soonest lobby of that
	-- kind with room, else they wait in line here until a seat is free. PUBLIC_STATE tells the client
	-- ("joining" | "line" | "going" | "idle").
	--- when each player asked (os.clock), for the wait the Public Join event reports
	local public_since: { [Player]: number } = {}
	--- seated and sent: the lobby, their seat, and whether this was already a retry
	local public_sent: { [Player]: { id: string, uid: string, mode: string, at: number, retried: boolean } } = {}
	--- the kinds of public match a player may ask for here (the title's cards)
	local public_kinds = {}
	for _, k in LobbyRules.kinds(TEAM_GAMES) do
		table.insert(public_kinds, k.mode)
	end
	local function public_state(players: { Player }, state: string, mode: string?, extra: any?)
		for _, m in players do
			send(m, OP.PUBLIC_STATE, state, mode, extra)
		end
	end
	--- The players who go with `player` (a party leader: everyone of the party on the title screen),
	--- and the party data for the match server; nil when `player` can't go now.
	local function public_group(player: Player): ({ Player }?, { [string]: any }?)
		if player.Parent ~= Players or Analytics.in_solo(player) then
			return nil, nil
		end
		if party == nil or party:key_of(player) == nil then
			return { player }, nil
		end
		local list, uids = {}, {}
		for _, m in party:members(player) do
			local free = m == player or (m.Parent == Players and not joining_lobby[m] and not Analytics.in_solo(m))
			if free then
				table.insert(list, m)
				table.insert(uids, tostring(m.UserId))
			end
		end
		if #list <= 1 then
			return { player }, nil
		end
		return list, { players = list, key = party:key_of(player), uids = uids, leader = player.UserId }
	end
	local function public_key(player: Player): string
		local k = if party ~= nil then party:key_of(player) else nil
		return if k ~= nil then "p:" .. k else "u:" .. tostring(player.UserId)
	end
	local function public_wait(m: Player): number
		return os.clock() - (public_since[m] or os.clock())
	end
	local function public_seated(players: { Player }, mode: string, l: any, first_try: boolean, retried: boolean?)
		for _, m in players do
			public_sent[m] =
				{ id = l.id, uid = tostring(m.UserId), mode = mode, at = os.clock(), retried = retried == true }
			pcall(Analytics.public_join, m, "Seated", mode, public_wait(m), first_try)
			public_since[m] = nil
		end
		public_state(players, "going", mode, { map = l.map, map_name = l.map_name })
	end
	local function public_failed(players: { Player }, mode: string, result: string, text: string?)
		for _, m in players do
			pcall(Analytics.public_join, m, result, mode, public_wait(m), false)
			public_since[m] = nil
		end
		public_state(players, "idle", mode)
		if text ~= nil then
			for _, m in players do
				send(m, OP.JOIN_RESULT, false, text)
				send(m, OP.NOTICE, text, 1)
			end
		end
	end
	--- Studio (no teleports): this server plays the lobby itself.
	local function public_studio(players: { Player }, group: { [string]: any }?, l: any)
		studio_lobby = l
		server.deps.lobby = lobby_hooks()
		server._finished = false -- (Studio replays lobbies on this one server)
		public_state(players, "idle", LobbyRules.mode_of(l))
		for _, m in players do
			if group ~= nil then
				party_by_uid[tostring(m.UserId)] = group.key
				party_leader[group.key] = group.leader
			end
			local nm = if m.DisplayName ~= "" then m.DisplayName else m.Name
			server:on_client(m, { uid = tostring(m.UserId), name = nm }, OP.JOIN, nm)
		end
	end
	local function public_join(player: Player, mode: string, retried: boolean?)
		if directory == nil or joining_lobby[player] then
			return
		end
		-- seated and on the way (the teleport has 20 s before the client gives up on it): no second seat
		local going = public_sent[player]
		if going ~= nil and os.clock() - going.at < 20 and not retried then
			return
		end
		if party ~= nil and party:key_of(player) ~= nil and not party:is_leader(player) then
			send(player, OP.JOIN_RESULT, false, "Your party leader picks the match.")
			send(player, OP.NOTICE, "Your party leader picks the match.", 1)
			return
		end
		local key = public_key(player)
		if directory:queued(key) ~= nil then
			return -- (in line already)
		end
		local players, group = public_group(player)
		if players == nil then
			return
		end
		for _, m in players do
			joining_lobby[m] = true
			public_since[m] = public_since[m] or os.clock()
		end
		public_state(players, "joining", mode)
		task.spawn(function()
			local ok, reason, l = directory:join_public(players, mode, { party = group })
			for _, m in players do
				joining_lobby[m] = nil
			end
			if ok then
				public_seated(players, mode, l, true, retried)
			elseif reason == "studio" and l ~= nil then
				public_studio(players, group, l)
			elseif reason == LobbyDirectory.NO_ROOM then
				-- every lobby of the kind is full right now: wait in line for the next free seat
				directory:enqueue({
					key = key,
					mode = mode,
					since = now(),
					members = function(): ({ any }?, { [string]: any }?)
						return public_group(player)
					end,
					done = function(seated: boolean, why: string?, lb: any, sent: { Player }?)
						local who = sent or public_group(player) or { player }
						if seated then
							public_seated(who, mode, lb, false, retried)
						elseif why == "studio" and lb ~= nil then
							public_studio(who, nil, lb)
						elseif why == "gone" then
							public_failed(who, mode, "Left Line", nil)
						elseif why == "timeout" then
							public_failed(
								who,
								mode,
								"Timed Out",
								"Every public match is full right now. Try again in a moment, or play solo."
							)
						else
							public_failed(who, mode, "Teleport Failed", why)
						end
					end,
				})
				public_state(players, "line", mode)
			elseif reason == LobbyDirectory.UNREACHABLE then
				public_failed(players, mode, "Unreachable", reason)
			else
				public_failed(players, mode, "Teleport Failed", reason)
			end
		end)
	end
	--- The player (a party leader: the party) leaves the line.
	local function public_cancel(player: Player)
		if directory == nil or (party ~= nil and party:key_of(player) ~= nil and not party:is_leader(player)) then
			return
		end
		local e = directory:queued(public_key(player))
		if e ~= nil and directory:dequeue(e.key) then
			public_failed(public_group(player) or { player }, e.mode, "Left Line", nil)
		end
	end
	ServerMain.public_join = public_join
	-- a public-match teleport that failed after it began: the seat goes back, and once the player is
	-- put in line again on their own
	if directory ~= nil and not RunService:IsStudio() then
		game:GetService("TeleportService").TeleportInitFailed:Connect(function(player: Player, result: any, msg: any)
			if result == Enum.TeleportResult.IsTeleporting then
				-- A second request refused because one is already under way: the player is still on
				-- their way, so the seat stays and nothing failed (2026-10-15: most of the ~5,200 daily
				-- "Teleport Failed" were this; their seat went back and they read "Couldn't reach that
				-- match" while the first teleport carried them in). If that one fails it fires again,
				-- and a seat nobody takes goes back after LobbyRules.ARRIVE_S anyway.
				return
			end
			local sent = public_sent[player]
			public_sent[player] = nil
			if sent == nil or os.clock() - sent.at > 60 then
				return
			end
			task.spawn(function()
				directory:release(sent.id, { sent.uid })
			end)
			pcall(Analytics.public_join, player, "Teleport Failed", sent.mode, 0, false)
			warn(
				string.format(
					"[Lobbies] teleport to %s failed for %s: %s %s",
					sent.id,
					player.Name,
					tostring(result),
					tostring(msg)
				)
			)
			-- (a party member who doesn't lead is brought along by the leader's retry, if free)
			local follower = party ~= nil and party:key_of(player) ~= nil and not party:is_leader(player)
			local again = not sent.retried and not follower and result ~= Enum.TeleportResult.Unauthorized
			if again and player.Parent == Players then
				send(player, OP.NOTICE, "Couldn't reach that match. Finding you another one…", 0)
				public_join(player, sent.mode, true)
			else
				public_state({ player }, "idle", sent.mode)
				send(player, OP.NOTICE, "Couldn't reach that match. Try again in a moment.", 1)
			end
		end)
	end

	to_server.OnServerEvent:Connect(function(player: Player, op: any, ...: any)
		if type(op) ~= "number" then
			return
		end
		local used = msg_budget[player] or 0
		if used >= ServerMain.MAX_MESSAGES_PER_SEC then
			return
		end
		msg_budget[player] = used + 1
		if op == OP.HELLO then
			local t = os.clock()
			local last = hello_at[player]
			if last ~= nil and t - last < ServerMain.HELLO_MIN_INTERVAL_S then
				return -- a repeated HELLO: already answered
			end
			hello_at[player] = t
			if not listening[player] then
				listening[player] = true
				table.insert(listening_list, player)
			end
			send(player, OP.LOBBY, server:lobby_info(player))
			if directory ~= nil then
				send(player, OP.LOBBIES, directory:view(), public_kinds)
			end
			-- the stored settings (size-capped) go out once, not on every HELLO
			SettingsStore.replay(player, function(data: any)
				send(player, OP.SETTINGS, data)
			end)
			send(player, OP.CREDITS, Purchases.credits(player))
			send(player, OP.INVENTORY, inventory_of(player))
			if Subscription.id() ~= "" then
				send(player, OP.GENERAL, General.state(player))
			end
			if party ~= nil then
				send(player, OP.PARTY_STATE, party:state(player))
			end
		elseif op == OP.SETTING then
			local s_used = setting_budget[player] or 0
			if s_used >= ServerMain.MAX_SETTINGS_PER_SEC then
				return
			end
			setting_budget[player] = s_used + 1
			local section, values = ...
			local ok, err = pcall(SettingsStore.set, player, section, values)
			if not ok then
				report_once("SettingsStore.set", err)
			end
		elseif op == OP.JOIN_PUBLIC then
			-- Quick Play: a public match of a kind ("ffa" | "team" | "world"), or false to leave the line
			local mode = ...
			if mode == false then
				public_cancel(player)
			elseif LobbyRules.is_mode(mode) and (mode ~= LobbyRules.MODE_TEAM or TEAM_GAMES) then
				public_join(player, mode)
			end
		elseif op == OP.JOIN_LOBBY then
			-- (a lobby picked by id) Quick Play into that lobby's kind
			local id = ...
			if directory == nil or type(id) ~= "string" or #id > 64 then
				return
			end
			local mode = LobbyRules.MODE_FFA
			for _, l in directory:lobbies() do
				if l.id == id then
					mode = LobbyRules.mode_of(l)
				end
			end
			public_join(player, mode)
		elseif op == OP.PARTY then
			if party == nil then
				return
			end
			local action, target = ...
			local tuid = tonumber(target)
			if action == "invite" and tuid ~= nil then
				local ok, why = party:invite(player, Players:GetPlayerByUserId(tuid))
				if ok then
					send(player, OP.NOTICE, "Invite sent", 0)
				elseif why ~= nil then
					send(player, OP.NOTICE, why, 1)
				end
			elseif action == "accept" and tuid ~= nil then
				local ok, why = party:accept(player, tuid)
				if not ok and why ~= nil then
					send(player, OP.NOTICE, why, 1)
				end
			elseif action == "decline" and tuid ~= nil then
				party:decline(player, tuid)
			elseif action == "leave" then
				party:leave(player)
			elseif action == "kick" and tuid ~= nil then
				party:kick(player, tuid)
			end
		elseif op == OP.SPECTATE_LOBBY then
			local id = ...
			if directory == nil or type(id) ~= "string" or #id > 64 or joining_lobby[player] then
				return
			end
			joining_lobby[player] = true
			task.spawn(function()
				local ok, err = directory:spectate(player, id)
				joining_lobby[player] = nil
				if ok then
					return -- the teleport is under way
				end
				if err == "studio" then
					-- Studio (no teleports): watch the lobby this server plays itself
					if studio_lobby ~= nil and studio_lobby.id == id and server:stage() ~= "idle" then
						spectating[player] = true
						local nm = if player.DisplayName ~= "" then player.DisplayName else player.Name
						server:on_client(
							player,
							{ uid = tostring(player.UserId), name = nm, spectate = true },
							OP.JOIN,
							nm
						)
						return
					end
					err = "That match has ended."
				end
				send(player, OP.JOIN_RESULT, false, err)
				send(player, OP.NOTICE, err or "Couldn't open that match.", 1)
			end)
		elseif op == OP.ANALYTICS then
			local a_used = analytics_budget[player] or 0
			if a_used >= ServerMain.MAX_ANALYTICS_PER_SEC then
				return
			end
			analytics_budget[player] = a_used + 1
			local ok, err = pcall(Analytics.report, player, ...)
			if not ok then
				report_once("Analytics.report", err)
			end
			-- a solo match starts its clock here (its Stars can't outrun it: server/Rewards)
			local kind, mode = ...
			if kind == "match_start" then
				Rewards.solo_started(player, mode)
			elseif kind == "tutorial" and mode == #TutorialData.FUNNEL then
				-- the tutorial's last step: its Stars, once per player
				task.spawn(Purchases.tutorial_bonus, player, TutorialData.STARS)
			end
		elseif op == OP.SOLO_RESULT then
			local c_used = credit_budget[player] or 0
			if c_used >= ServerMain.MAX_CREDIT_USES_PER_SEC then
				return
			end
			credit_budget[player] = c_used + 1
			local report = ...
			task.spawn(function()
				local ok, err = pcall(Rewards.solo_result, player, report)
				if not ok then
					report_once("Rewards.solo_result", err)
				end
			end)
		elseif op == OP.STARTER_SEEN then
			-- the starter pack's offer is on the player's screen: its 48 hours start (once)
			local c_used = credit_budget[player] or 0
			if c_used >= ServerMain.MAX_CREDIT_USES_PER_SEC then
				return
			end
			credit_budget[player] = c_used + 1
			task.spawn(function()
				if Purchases.starter_seen(player) then
					pcall(Analytics.report, player, "starter", "shown")
				end
			end)
		elseif op == OP.NEW_PLAYER then
			-- "Replay as new player" (the game menu): Rofront Staging / Studio, and on production the game's
			-- admins (2026-10-27: to play a first session as a new player does), who keep what they own there
			local test = Staging.here() or RunService:IsStudio()
			if not test and player:GetAttribute("AF_Admin") ~= true then
				return
			end
			local c_used = credit_budget[player] or 0
			if c_used >= ServerMain.MAX_CREDIT_USES_PER_SEC then
				return
			end
			credit_budget[player] = c_used + 1
			print(string.format("[%s] %s replays as a new player", if test then "Staging" else "Admin", player.Name))
			SettingsStore.set(player, Analytics.STATS, { matches = 0 })
			task.spawn(Purchases.reset_new_player, player, not test)
		elseif op == OP.SOLO_HOP then
			-- the player starts a solo match on an outdated hub: to a fresh server, where it starts
			local difficulty, map_id = ...
			local now_s = os.clock()
			if
				fresh == nil
				or type(difficulty) ~= "number"
				or (map_id ~= nil and (type(map_id) ~= "string" or #map_id > 64))
				or now_s - (hop_at[player] or -1e9) < ServerMain.HOP_GAP_S
			then
				send(player, OP.HOP_RESULT, false)
				return
			end
			hop_at[player] = now_s
			task.spawn(function()
				local target = if fresh:is_outdated() then fresh:pick() else nil
				local going = false
				if target ~= nil and player.Parent ~= nil then
					local ok, err = pcall(function()
						local opts = Instance.new("TeleportOptions")
						opts.ServerInstanceId = target
						opts:SetTeleportData(handoff:stamp({ player }, {
							hop = true,
							solo = { d = math.clamp(math.floor(difficulty), 0, 2), m = map_id },
						}))
						game:GetService("TeleportService"):TeleportAsync(game.PlaceId, { player }, opts)
					end)
					going = ok
					if not ok then
						warn("[Fresh] hop failed: " .. tostring(err))
					end
				end
				print(
					string.format("[Fresh] %s: %s", player.Name, if going then "to " .. tostring(target) else "stays")
				)
				pcall(
					Analytics.report,
					player,
					"hop",
					if going then "sent" elseif target == nil then "none" else "failed"
				)
				send(player, OP.HOP_RESULT, going)
			end)
		elseif op == OP.BUY_UNLOCK then
			local c_used = credit_budget[player] or 0
			local key = ...
			if c_used >= ServerMain.MAX_CREDIT_USES_PER_SEC or type(key) ~= "string" or #key > 32 then
				return
			end
			credit_budget[player] = c_used + 1
			task.spawn(function()
				local ok, err = Purchases.buy_unlock(player, key)
				send(player, OP.UNLOCK_RESULT, key, ok, err)
				if ok then
					pcall(Analytics.report, player, "unlocked", key, "stars")
				end
			end)
		elseif op == OP.OPEN_CRATE then
			local c_used = credit_budget[player] or 0
			if c_used >= ServerMain.MAX_CREDIT_USES_PER_SEC then
				return
			end
			credit_budget[player] = c_used + 1
			task.spawn(function()
				local ok, res = Purchases.open_crate(player)
				send(player, OP.CRATE_RESULT, ok, res)
				if ok then
					pcall(Analytics.report, player, "crate_opened", res)
				end
			end)
		elseif op == OP.EQUIP then
			local c_used = credit_budget[player] or 0
			local slot, id = ...
			if c_used >= ServerMain.MAX_CREDIT_USES_PER_SEC or type(slot) ~= "string" then
				return
			end
			if id ~= false and (type(id) ~= "string" or #id > 40) then
				return
			end
			credit_budget[player] = c_used + 1
			task.spawn(function()
				local ok = Purchases.equip(player, slot, id)
				if ok and id ~= false then
					pcall(Analytics.report, player, "equipped", slot)
				end
			end)
		elseif op == OP.USE_CREDIT then
			local c_used = credit_budget[player] or 0
			local kind, target = ...
			if c_used >= ServerMain.MAX_CREDIT_USES_PER_SEC or type(kind) ~= "string" or #kind > 48 then
				return
			end
			credit_budget[player] = c_used + 1
			if kind == "studio_grant:starter" then
				-- dev diagnostics (Studio + AF_DIAG only): the starter pack's receipt, through its real
				-- checks (refused unless its offer runs)
				if RunService:IsStudio() and diag ~= nil then
					task.spawn(Purchases.grant, player.UserId, "starter", "studio-" .. HttpService:GenerateGUID(false))
				end
				return
			end
			if kind == "studio_grant:takeover" or kind == "studio_grant:crate" then
				-- dev diagnostics (Studio + AF_DIAG only): a test credit without a real product
				if RunService:IsStudio() and diag ~= nil then
					local k = if kind == "studio_grant:crate" then "crate" else "takeover"
					task.spawn(Purchases.grant, player.UserId, k, "studio-" .. HttpService:GenerateGUID(false))
				end
				return
			end
			if string.sub(kind, 1, 13) == "studio_grant:" then
				-- dev diagnostics (Studio + AF_DIAG only): test Stars ("studio_grant:stars", target =
				-- how many) or a test unlock / shop flag as if bought with Robux
				-- ("studio_grant:unlock:<key>", "studio_grant:shopflag:<key>")
				if RunService:IsStudio() and diag ~= nil then
					local what = string.sub(kind, 14)
					if what == "stars" then
						task.spawn(Purchases.add_stars, player, tonumber(target) or 10000)
					elseif
						string.sub(what, 1, 7) == "unlock:"
						or string.sub(what, 1, 9) == "shopflag:"
						or string.sub(what, 1, 8) == "shopset:"
					then
						task.spawn(Purchases.grant, player.UserId, what, "studio-" .. HttpService:GenerateGUID(false))
					end
				end
				return
			end
			task.spawn(function()
				if kind == "takeover" and type(target) == "number" then
					-- a public match this server runs: the takeover happens here. Checked before the
					-- credit is spent, and again after (the match went on meanwhile): a nation that fell
					-- in between gives the credit back.
					if not server:can_take_over(player, target) then
						send(player, OP.CREDIT_RESULT, kind, false, "gone")
						return
					end
					local ok, err = Purchases.use(player, kind)
					if not ok then
						send(player, OP.CREDIT_RESULT, kind, false, err)
						return
					end
					if not server:take_over(player, target) then
						Purchases.grant(player.UserId, kind, "refund-" .. HttpService:GenerateGUID(false))
						send(player, OP.CREDIT_RESULT, kind, false, "gone")
						return
					end
					send(player, OP.CREDIT_RESULT, kind, true)
					pcall(Analytics.report, player, "credit_used", kind)
					return
				end
				-- solo (the player's own match runs on their device): spend; the client takes over
				local ok, err = Purchases.use(player, kind)
				send(player, OP.CREDIT_RESULT, kind, ok, err)
				if ok then
					pcall(Analytics.report, player, "credit_used", kind)
				end
			end)
		elseif op == OP.LEAVE and is_match_server then
			-- leaving a public match's server = back to a hub
			pcall(Analytics.report, player, "left")
			pcall(server.leave, server, player)
			task.spawn(function()
				teleports.to_hub({ player })
			end)
		else
			local name = player.DisplayName
			if name == "" then
				name = player.Name
			end
			local ok, err = xpcall(
				server.on_client,
				debug.traceback,
				server,
				player,
				{ uid = tostring(player.UserId), name = name, spectate = spectating[player] == true },
				op,
				...
			)
			if not ok then
				report_once("on_client op " .. tostring(op), err)
			end
		end
	end)

	-- Deep-link launch data (roblox://experiences/start?placeId=…&launchData=…) for the client's
	-- owner-only test hooks (Main.launch_hooks). Short strings only; the client decides what to honour.
	local function tag_launch(player: Player)
		local ok, jd = pcall(function()
			return player:GetJoinData()
		end)
		local ld = if ok and type(jd) == "table" then jd.LaunchData else nil
		if type(ld) == "string" and #ld > 0 and #ld <= 64 then
			player:SetAttribute("AF_LaunchData", ld)
		end
	end
	--- Humans on this server who came to play (spectators don't count for the lobby / bot fill).
	local function players_present(leaving: Player?): number
		local n = 0
		for _, p in Players:GetPlayers() do
			if p ~= leaving and not spectating[p] then
				n += 1
			end
		end
		return n
	end
	--- Their user ids (the lobby's seat ledger: MatchHost.set_roster).
	local function present_uids(leaving: Player?): { string }
		local out = {}
		for _, p in Players:GetPlayers() do
			if p ~= leaving and not spectating[p] then
				table.insert(out, tostring(p.UserId))
			end
		end
		return out
	end
	--- A hub's Watch teleport carries { spectate = true }: that player only watches this match.
	local function tag_spectator(player: Player)
		if not is_match_server then
			return
		end
		local ok, jd = pcall(function()
			return player:GetJoinData()
		end)
		local td = if ok and type(jd) == "table" then jd.TeleportData else nil
		if type(td) == "table" and td.spectate == true then
			spectating[player] = true
		end
		-- a party's members (LobbyDirectory.join): one team in a team game, and back to one hub
		local pd = if type(td) == "table" then td.party else nil
		if type(pd) == "table" and type(pd.key) == "string" and #pd.key <= 64 then
			party_by_uid[tostring(player.UserId)] = pd.key
			if tonumber(pd.leader) ~= nil then
				party_leader[pd.key] = tonumber(pd.leader) :: number
			end
		end
	end
	--- A hub: the party `player` came back with from a match, or the Roblox party it came in.
	local function join_party_on_arrival(player: Player)
		if party == nil then
			return
		end
		local ok, jd = pcall(function()
			return player:GetJoinData()
		end)
		local td = if ok and type(jd) == "table" then jd.TeleportData else nil
		local parties = if type(td) == "table" then td.parties else nil
		local key = if type(parties) == "table" then parties[tostring(player.UserId)] else nil
		if type(key) == "string" and #key <= 64 then
			local leaders = if type(td.leaders) == "table" then td.leaders else {}
			party:arrived(player, key, tonumber(leaders[key]))
			return
		end
		local pid_ok, pid = pcall(function()
			return (player :: any).PartyId
		end)
		if pid_ok and type(pid) == "string" and pid ~= "" then
			local o_ok, others = pcall(function()
				return game:GetService("SocialService"):GetPlayersByPartyId(pid)
			end)
			if o_ok and type(others) == "table" then
				party:join_roblox_party(player, others)
			end
		end
	end
	-- Game admins (the game's owner, or rank 254+ in the owning group; everyone in a Studio playtest)
	-- are told which "players" are bot players — nobody else ever receives it (bots look like players).
	-- Their Player has the AF_Admin attribute (set here only, so a client can't give it itself): the
	-- game menu's "Replay as new player" shows on production too.
	local admins: { [Player]: boolean } = {}
	local admin_sent: { [Player]: string } = {}
	-- (AdminCheck: the group's owner once per server, each player's answer shared by every server)
	local admin_cache: any = nil
	pcall(function()
		admin_cache = game:GetService("MemoryStoreService"):GetHashMap("admins_v1")
	end)
	local admin_check = AdminCheck.new({
		studio = RunService:IsStudio(),
		group = game.CreatorType == Enum.CreatorType.Group,
		creator_id = game.CreatorId,
		rank = function(player: Player): number
			return player:GetRankInGroup(game.CreatorId)
		end,
		owner = function(): number?
			local info = game:GetService("GroupService"):GetGroupInfoAsync(game.CreatorId)
			return if type(info) == "table" and type(info.Owner) == "table" then info.Owner.Id else nil
		end,
		cache_get = if admin_cache ~= nil
			then function(key: string): any
				return admin_cache:GetAsync(key)
			end
			else nil,
		cache_set = if admin_cache ~= nil
			then function(key: string, value: any, ttl_s: number)
				admin_cache:SetAsync(key, value, ttl_s)
			end
			else nil,
	})
	local function check_admin(player: Player)
		task.spawn(function()
			for attempt = 1, #AdminCheck.RETRY_S + 1 do
				local ok, yes = pcall(admin_check.is_admin, admin_check, player)
				if player.Parent ~= Players then
					return
				end
				if ok then
					if yes then
						admins[player] = true
						player:SetAttribute("AF_Admin", true)
						print(string.format("[Admin] %s (%d): game admin", player.Name, player.UserId))
					end
					return
				end
				if attempt > #AdminCheck.RETRY_S then
					warn(string.format("[Admin] check for %s failed: %s", player.Name, tostring(yes)))
					return
				end
				task.wait(AdminCheck.RETRY_S[attempt])
			end
		end)
	end
	--- Bot players of the running match (owner ids) to each admin, whenever the match changes.
	local function push_admin_bots()
		local sim = server:sim()
		local ids = {}
		if sim ~= nil and sim.o_bot ~= nil then
			for id = 1, sim.owner_total do
				if sim.o_bot[id] == 1 then
					table.insert(ids, id)
				end
			end
		end
		local key = tostring(sim) .. ":" .. #ids
		for p in admins do
			if listening[p] and admin_sent[p] ~= key then
				admin_sent[p] = key
				send(p, OP.ADMIN_BOTS, ids)
			end
		end
	end
	-- Creator Dashboard analytics: match counts live in the saved settings; on a match server the
	-- killer of an eliminated player is classified here (clients can't tell bot players apart)
	Analytics.configure({
		cosmetic = function(id: string): any
			local C = require(Shared.Data.Cosmetics) :: any
			return C.item(id)
		end,
		--- a shop flag's name and price (Robux), for "Flag Bought"
		shop_flag = function(key: string): (string?, number)
			local f = (require(Shared.Data.Shop) :: any).flag(key)
			local p = (require(Shared.Data.Products) :: any)["shop_" .. key]
			return if f ~= nil then f.name else nil, if p ~= nil then p.robux else 0
		end,
		--- a set bundle's name ("Halloween Pack") and price (Robux)
		shop_pack = function(id: string): (string?, number)
			local s = (require(Shared.Data.Shop) :: any).SETS[id]
			local p = (require(Shared.Data.Products) :: any)["shopset_" .. id]
			return if s ~= nil then s.name .. " Pack" else nil, if p ~= nil then p.robux else 0
		end,
		tutorial_steps = TutorialData.FUNNEL,
		arsenal_title = function(key: string): string?
			local it = (require(Shared.Data.Arsenal) :: any).item(key)
			return if it ~= nil then it.title else nil
		end,
		load_stats = function(player: Player, fn: (any) -> ())
			SettingsStore.when_loaded(player, function(data: any)
				fn(if type(data) == "table" then data[Analytics.STATS] else nil)
			end)
		end,
		save_stats = function(player: Player, stats: any)
			-- (Studio playtests write the real DataStore: they must not count as the owner's matches;
			-- and after a failed load the count starts from nothing: saving it would put a veteran's
			-- matches back to 1)
			if not RunService:IsStudio() and not SettingsStore.load_failed(player) then
				SettingsStore.set(player, Analytics.STATS, stats)
			end
		end,
		classify = function(id: number): string?
			local sim = server:sim()
			if sim == nil or id < 1 or id > (sim.owner_total or 0) then
				return nil
			end
			local Defs = core("Defs")
			local k = sim.o_kind[id]
			if k == Defs.KIND_HUMAN then
				return if sim.o_bot ~= nil and sim.o_bot[id] == 1 then "bot" else "human"
			end
			return if k == Defs.KIND_TRIBE then "tribe" else "nation"
		end,
	})
	-- Paid random items (the cosmetic crates) are not offered where Roblox's policy restricts them
	-- (PolicyService.ArePaidRandomItemsRestricted); unknown until checked = restricted.
	local crates_allowed: { [Player]: boolean } = {}
	--- the policy was asked (an answer or not): RoWorld General's daily perk waits for it
	local policy_known: { [Player]: boolean } = {}
	inventory_of = function(player: Player): any
		local inv = Purchases.inventory(player)
		inv.crates_allowed = crates_allowed[player] == true
		return inv
	end
	local function check_policy(player: Player)
		local ok, info = pcall(function()
			return PolicyService:GetPolicyInfoForPlayerAsync(player)
		end)
		crates_allowed[player] = ok and type(info) == "table" and info.ArePaidRandomItemsRestricted == false
		policy_known[player] = true
		send(player, OP.INVENTORY, inventory_of(player))
	end
	-- Robux purchases: a receipt is a stored credit before Roblox hears it was granted
	-- (Studio playtests write the real DataStores: their test credits go to a store of their own)
	local store_name = Purchases.STORE .. (if RunService:IsStudio() then "_studio" else "")
	local got_store, purchase_store = pcall(function()
		-- (budget-aware, throttled requests sent again: DsGate)
		return DsGate.wrap(DataStoreService:GetDataStore(store_name))
	end)
	if not got_store then
		if not RunService:IsStudio() then
			error(purchase_store)
		end
		-- an unpublished place open in Studio has no DataStores: the records last for this session
		warn("[Purchases] no DataStore here (an unpublished place): purchases are kept for this session only")
		local rows: { [string]: any } = {}
		purchase_store = {
			GetAsync = function(_: any, k: string): any
				return rows[k]
			end,
			UpdateAsync = function(_: any, k: string, fn: (any) -> any): any
				local v = fn(rows[k])
				if v ~= nil then
					rows[k] = v
				end
				return v
			end,
		}
	end
	Purchases.configure({
		datastore = purchase_store,
		players = Players,
		notify = function(player: Player, credits: any)
			send(player, OP.CREDITS, credits)
		end,
		inventory = function(player: Player, _inv: any)
			send(player, OP.INVENTORY, inventory_of(player))
		end,
		bought = function(player: Player, kind: string, count: number?, spent: number?)
			if kind == "starter" then
				pcall(Analytics.report, player, "starter", "bought")
				return
			end
			local shop_key = string.match(kind, "^shopflag:(.+)$")
			if shop_key ~= nil then
				pcall(Analytics.report, player, "flag_shop", "bought", shop_key, spent)
				return
			end
			local set_id = string.match(kind, "^shopset:(.+)$")
			if set_id ~= nil then
				pcall(Analytics.report, player, "flag_shop", "bought_pack", set_id, spent)
				return
			end
			pcall(Analytics.report, player, "credit_bought", kind, count)
			local key = string.match(kind, "^unlock:(.+)$")
			if key ~= nil then
				pcall(Analytics.report, player, "unlocked", key, "robux")
			end
		end,
		-- an Arsenal unlock (Stars or Robux): the match the player is in lets them use it at once
		-- (also a record that could only be read late: Purchases.load)
		unlocked = function(player: Player, _key: string)
			pcall(server.unlocks_changed, server, player)
		end,
		wait = task.wait,
		log = print,
		warn = warn,
		-- teleported here by a server of ours: the record it held when they left
		arrived = function(player: Player): any
			return handoff:arrived(player)
		end,
		-- (Studio: the starter pack is offered before its product exists; the prompt is a test)
		studio = RunService:IsStudio(),
	})
	SettingsStore.connect_handoff(function(player: Player): any
		return handoff:arrived(player)
	end, function(player: Player, settings: any)
		handoff:part(player, "s", settings)
	end)
	-- Stars for matches (shared/Data/Stars): public matches as this server measured them, solo
	-- matches on the client's report within what the clock allows
	Rewards.configure({
		add_stars = Purchases.add_stars,
		double = function(player: Player): boolean
			return Purchases.has_unlock(player, "stars2x")
		end,
		general = General.active,
		send = function(player: Player, payload: any)
			send(player, OP.STARS, payload)
			pcall(Analytics.report, player, "stars_paid", payload.total)
		end,
		log = print,
	})
	-- RoWorld General (Data/Subscription; 2026-10-27): Roblox says who is subscribed; server/General
	-- gives the perks
	General.configure({
		status = function(player: Player): boolean?
			local info = (MarketplaceService :: any):GetUserSubscriptionStatusAsync(player, Subscription.id())
			return if type(info) == "table" then info.IsSubscribed == true else nil
		end,
		perks = function(player: Player, day: number, skin: string?): any
			-- (a crate or Stars: the policy decides, so wait for its answer; unknown = no crates)
			local t0 = os.clock()
			while policy_known[player] == nil and player.Parent == Players and os.clock() - t0 < 15 do
				task.wait(0.5)
			end
			return Purchases.general_perks(player, day, skin, crates_allowed[player] == true)
		end,
		send = function(player: Player, state: any)
			send(player, OP.GENERAL, state)
		end,
		subscribed = function(player: Player)
			pcall(Analytics.report, player, "general", "subscribed")
		end,
		now = os.time,
		log = print,
	})
	pcall(function()
		(Players :: any).UserSubscriptionStatusChanged:Connect(function(player: Player, sid: string)
			if sid == Subscription.id() then
				task.spawn(General.changed, player)
			end
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(60)
			pcall(General.tick)
		end
	end)
	MarketplaceService.ProcessReceipt = function(info: any): Enum.ProductPurchaseDecision
		local ok, r = pcall(Purchases.process_receipt, info)
		if ok and r == "granted" then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		if not ok then
			report_once("Purchases.process_receipt", r)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Players.PlayerAdded:Connect(function(player: Player)
		task.spawn(Purchases.load, player)
		task.spawn(check_policy, player)
		task.spawn(General.joined, player)
		Analytics.joined(player)
		tag_launch(player)
		tag_spectator(player)
		task.spawn(join_party_on_arrival, player)
		check_admin(player)
		SettingsStore.load(player)
		if host ~= nil then
			host:set_present(players_present())
			host:set_roster(present_uids())
		end
	end)
	for _, p in Players:GetPlayers() do
		task.spawn(Purchases.load, p)
		task.spawn(check_policy, p)
		task.spawn(General.joined, p)
		Analytics.joined(p)
		tag_launch(p)
		tag_spectator(p)
		check_admin(p)
		SettingsStore.load(p)
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		server:peer_disconnected(player)
		listening[player] = nil
		hop_at[player] = nil
		local i = table.find(listening_list, player)
		if i then
			table.remove(listening_list, i)
		end
		msg_budget[player] = nil
		setting_budget[player] = nil
		analytics_budget[player] = nil
		credit_budget[player] = nil
		crates_allowed[player] = nil
		policy_known[player] = nil
		General.release(player)
		Rewards.release(player)
		if handoff:leaving(player) then
			-- on one of our teleports: their record goes along once this server's writes have landed
			task.spawn(function()
				handoff:part(player, "p", Purchases.settle(player, Handoff.PART_WAIT_S - 5))
				Purchases.release(player)
			end)
		else
			Purchases.release(player)
		end
		pcall(Analytics.left, player)
		hello_at[player] = nil
		joining_lobby[player] = nil
		public_since[player] = nil
		public_sent[player] = nil
		-- in line alone, or leading a party in line: out of it (the party's others go back to idle)
		if directory ~= nil and (party == nil or party:key_of(player) == nil or party:is_leader(player)) then
			local key = public_key(player)
			local e = directory:queued(key)
			if e ~= nil then
				directory:dequeue(key)
				local others = {}
				if party ~= nil and party:key_of(player) ~= nil then
					for _, m in party:members(player) do
						if m ~= player then
							table.insert(others, m)
						end
					end
				end
				public_state(others, "idle", e.mode)
			end
		end
		if host ~= nil then
			host:set_present(players_present(player))
			host:set_roster(present_uids(player))
		end
		spectating[player] = nil
		admins[player] = nil
		admin_sent[player] = nil
		if party ~= nil then
			party:removed(player)
		end
	end)
	SettingsStore.start()

	local budget_time = 0.0
	local admin_time = 0.0
	local stats_time = 0.0
	local lobby_push = 0.0
	local studio_beat = 0.0
	local perf = ServerPerf.new()
	local StatsService = game:GetService("Stats")
	--- the counts at the last report (each report has the window's)
	local counted = { hits = 0, misses = 0, none = 0, sent = 0, lost = 0, lost_stars = 0 }
	--- What this server runs, for its ServerPerf report.
	local function perf_context(): { [string]: any }
		local ctx: { [string]: any } = {
			role = ServerMain.kind,
			stage = server:stage(),
			humans = server:participant_count(),
			players = #Players:GetPlayers(),
			mem_mb = StatsService:GetTotalMemoryUsageMb(),
			age_min = time() / 60,
			version = game.PlaceVersion,
			-- players who came with their records (Handoff) and who had to read the DataStores, records
			-- handed on, and Stars that could not be paid
			handoff_hits = handoff.hits - counted.hits,
			handoff_misses = handoff.misses - counted.misses,
			handoff_none = handoff.none - counted.none,
			handoff_sent = handoff.sent - counted.sent,
			stars_lost = Purchases.lost.payouts - counted.lost,
			stars_lost_amount = Purchases.lost.stars - counted.lost_stars,
		}
		counted.hits, counted.misses, counted.none, counted.sent = handoff.hits, handoff.misses, handoff.none, handoff.sent
		counted.lost, counted.lost_stars = Purchases.lost.payouts, Purchases.lost.stars
		local sim = server:sim()
		if sim ~= nil then
			ctx.minute = sim.tick * MatchServer.TICK_SEC / 60
			ctx.attacks = #sim.attacks
		end
		local l = if host ~= nil then host.lobby else nil
		if l ~= nil then
			ctx.map = l.map
			ctx.mode = l.mode or "ffa"
			ctx.max = l.max
		end
		return ctx
	end
	RunService.Heartbeat:Connect(function(dt: number)
		perf:frame(dt)
		admin_time += dt
		if admin_time >= 1.0 then
			admin_time = 0.0
			push_admin_bots()
		end
		budget_time += dt
		if budget_time >= 1.0 then
			budget_time = 0.0
			table.clear(msg_budget)
			table.clear(setting_budget)
			table.clear(analytics_budget)
			table.clear(credit_budget)
		end
		-- MatchServer guards its own tick (a failing Sim ends the match with a notice); this catches
		-- anything else so one fault can't throw on every Heartbeat.
		local ok, err = xpcall(server.process, debug.traceback, server, dt)
		if not ok then
			report_once("MatchServer.process", err)
		end
		-- public lobbies: the hub keeps the game-wide list fresh and shows it; the match server keeps
		-- its lobby record current
		-- (lobby scheduling waits for the shared clock's first measurement, a second or so)
		if directory ~= nil and SharedClock.ready() then
			directory:tick(dt, task.spawn)
			directory:tick_queue(dt, task.spawn)
			lobby_push += dt
			if lobby_push >= ServerMain.LOBBIES_PUSH_S then
				lobby_push = 0.0
				local view = directory:view()
				for _, p in listening_list do
					send(p, OP.LOBBIES, view, public_kinds)
				end
			end
			if studio_lobby ~= nil and server:participant_count() == 0 and server:stage() == "idle" then
				studio_lobby = nil
				server.deps.lobby = nil
			end
			-- Studio: the locally played lobby keeps its live record fresh (as MatchHost does live)
			local stg = server:stage()
			if studio_lobby ~= nil and (stg == "spawn" or stg == "playing") then
				studio_beat += dt
				if studio_beat >= LobbyRules.LIVE_BEAT_S then
					studio_beat = 0.0
					local id = studio_lobby.id
					task.spawn(function()
						pcall(store.update, id, function(v: any): any?
							local cur = LobbyRules.decode(v)
							if cur == nil or cur.status ~= "started" then
								return nil
							end
							cur.beat = now()
							return cur
						end)
					end)
				end
			end
		elseif host ~= nil and SharedClock.ready() then
			host:tick(dt, task.spawn)
		end
		stats_time += dt
		if stats_time >= ServerMain.STATS_EVERY_S then
			local elapsed = stats_time
			stats_time = 0.0
			local st = server:take_stats()
			ServerMain.last_stats = st
			ServerMain.last_stats_window = elapsed
			local ok_r, report = pcall(perf.take, perf, st, perf_context())
			local client = ServerMain.lobby_client
			if ok_r and client ~= nil then
				task.spawn(function()
					pcall(client.post, client, "/v1/perf", { role = ServerMain.kind, perf = report })
				end)
			end
			if workspace:GetAttribute("AF_NET_STATS") == true and st.steps > 0 then
				local n = math.max(1, server:participant_count())
				print(
					string.format(
						"[Net] stage=%s players=%d step avg %.2f ms p99 %.2f max %.2f | encode %.2f ms | %.1f KB/s per client (max delta %d B) | snapshots %d (%d B) | intents %d ok %d dropped",
						server:stage(),
						server:participant_count(),
						st.step_ms_avg,
						st.step_ms_p99,
						st.step_ms_max,
						st.encode_ms_avg,
						st.bytes_sent / 1024 / elapsed / n,
						st.delta_bytes_max,
						st.snapshots_sent,
						st.snapshot_bytes,
						st.intents_ok,
						st.intents_dropped
					)
				)
			end
		end
	end)

	game:BindToClose(function()
		server:shutdown("The game server is restarting. You're back at the title screen.")
		if host ~= nil and not RunService:IsStudio() then
			-- a match server closing: everyone to a hub instead of out of the game
			pcall(teleports.to_hub, Players:GetPlayers())
		end
		SettingsStore.flush(true)
	end)

	-- Warm the shared geography before anyone queues, so the first match starts quickly.
	task.defer(function()
		local WorldMap = core("WorldMap")
		if WorldMap then
			pcall(WorldMap.shared)
		end
	end)

	folder.Parent = ReplicatedStorage
	if diag ~= nil then
		diag.start(ServerMain)
	end
end

return ServerMain
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="103">
        <Properties>
          <string name="Name">ServerPerf</string>
          <string name="Source"><![CDATA[--!strict
-- How this server keeps up (2026-11-01). The Creator Dashboard's server frame rate P10 had fallen at
-- night (21:00-08:00 UTC) from ~56 fps to 1-4 fps since mid-October while the median stayed at 60,
-- and nothing of ours said which servers those were. Every live server now sends the lobby service a
-- summary of each window (ServerMain.STATS_EVERY_S): its frame rate and slow frames, the match's Sim
-- step times, and what it was running (POST /v1/perf: services/lobbies/src/perf.ts).
--
--   ServerPerf.new() -> perf
--   perf:frame(dt)                   every Heartbeat
--   perf:take(st, ctx) -> report     the window's report (and a fresh window); st = MatchServer
--                                    take_stats(), ctx = what the server runs (see `report`)
local ServerPerf = {}
ServerPerf.__index = ServerPerf

--- A frame this long or longer is slow (under 10 fps).
ServerPerf.SLOW_FRAME_S = 0.1

function ServerPerf.new()
	local self = setmetatable({}, ServerPerf)
	self.frames = 0
	self.time = 0.0
	self.slow = 0
	self.slow_time = 0.0
	self.worst = 0.0
	return self
end

function ServerPerf.frame(self: any, dt: number)
	self.frames += 1
	self.time += dt
	if dt >= ServerPerf.SLOW_FRAME_S then
		self.slow += 1
		self.slow_time += dt
	end
	if dt > self.worst then
		self.worst = dt
	end
end

local function r1(x: number): number
	return math.floor(x * 10 + 0.5) / 10
end

--- The window's report: every field a number or a short string (the service checks them).
---   ctx = { role = "hub" | "match", stage = string, humans = number, players = number,
---           map = string?, mode = string?, max = number?, minute = number?, nations = number?,
---           mem_mb = number, age_min = number, version = number }
function ServerPerf.take(self: any, st: { [string]: number }, ctx: { [string]: any }): { [string]: any }
	local t = math.max(self.time, 1e-6)
	local report: { [string]: any } = {
		fps = r1(self.frames / t),
		slow_frames = self.slow,
		-- the share of the window spent in slow frames: 1 = the server never kept up
		slow_share = math.floor(self.slow_time / t * 100 + 0.5) / 100,
		worst_ms = math.floor(self.worst * 1000 + 0.5),
		window_s = math.floor(t + 0.5),
		steps = st.steps or 0,
		step_ms_avg = r1(st.step_ms_avg or 0),
		step_ms_p99 = r1(st.step_ms_p99 or 0),
		step_ms_max = r1(st.step_ms_max or 0),
		encode_ms_avg = r1(st.encode_ms_avg or 0),
		catchup_frames = st.catchup_frames or 0,
		budget_stops = st.budget_stops or 0,
	}
	for k, v in ctx do
		if type(v) == "number" then
			report[k] = r1(v)
		elseif type(v) == "string" then
			report[k] = string.sub(v, 1, 32)
		end
	end
	self.frames, self.time, self.slow, self.slow_time, self.worst = 0, 0.0, 0, 0.0, 0.0
	return report
end

return ServerPerf
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="104">
        <Properties>
          <string name="Name">SettingsStore</string>
          <string name="Source"><![CDATA[--!strict
-- Per-player settings persistence. The original kept music / UI settings in user://settings.cfg
-- ([audio] music_enabled, [ui] ratio, labels, difficulty, tips_seen…). Roblox clients have no files, so
-- the server keeps one small table per account in a DataStore: { [section] = { [key] = value } }
-- (validated by Net/Settings: scalars and one nested level, bounded size).
--
-- Robustness:
--   * the load retries GetAsync with backoff; if it still fails, the player's stored value is never
--     overwritten with the partial session copy — every write is an UpdateAsync that merges only the
--     sections this session changed into whatever is stored (so a failed load, or the same account in
--     two servers, can never wipe untouched sections). After a failed load a changed section is
--     merged key by key: the session only knows the keys it set, and writing the section whole put a
--     returning player's `ui` back to those few keys (their tips and tutorial state gone; the error
--     report of 2026-10-05 had 8 such loads in a day);
--   * writes are coalesced (at most one per player per FLUSH_SEC), serialized per player (never two in
--     flight, so they can't land out of order), and `dirty` is cleared only when a write succeeded;
--   * leave and shutdown flush what is pending (shutdown waits for every write, bounded).
-- Without DataStore access (Studio without API access, guests) it works in memory for the session.
-- A player teleported here by a server of ours comes with the settings that server held when they left
-- (server/Handoff, 2026-11-03): nothing is read.
--
-- The Roblox services are injectable (SettingsStore.configure) so tests drive it headless.

local IS_ROBLOX = typeof(game) == "Instance"
local SettingsMod: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Net.Settings)
	else require("../shared/Net/Settings")

local DsGate = require("./DsGate")

local SettingsStore = {}

SettingsStore.STORE_NAME = "AirfrontSettings_v1"
SettingsStore.FLUSH_SEC = 12
SettingsStore.MAX_SECTIONS = SettingsMod.MAX_SECTIONS
SettingsStore.MAX_KEYS = SettingsMod.MAX_KEYS
--- GetAsync attempts on load and the waits before each retry (20 s in all: Roblox's throttling
--- "Too many requests, try again later" clears within seconds; it was 3 attempts over 4 s).
SettingsStore.LOAD_ATTEMPTS = 5
SettingsStore.LOAD_BACKOFF = { 1.0, 3.0, 6.0, 10.0 }
--- BindToClose waits at most this long for the final writes.
SettingsStore.SHUTDOWN_WAIT_SEC = 20

type Entry = {
	data: { [string]: { [string]: any } },
	loaded: boolean,
	--- GetAsync failed every attempt: the stored value is unknown (writes still merge safely).
	load_failed: boolean,
	dirty: boolean,
	--- Sections changed this session (the only ones a write touches).
	touched: { [string]: boolean },
	--- Bumped by every change; a write clears `dirty` only if nothing changed while it ran.
	gen: number,
	writing: boolean,
	last_write: number,
	waiters: { (any) -> () },
	--- SETTINGS replies (replay): when the last one was scheduled, and whether it is still pending.
	replayed_at: number?,
	replay_pending: boolean,
}

-- Services (Roblox by default; tests inject fakes with configure()).
local deps: { [string]: any } = {}
if IS_ROBLOX then
	deps.players = game:GetService("Players")
	deps.datastores = game:GetService("DataStoreService")
	deps.gate = DsGate.wrap -- (budget-aware, throttled requests sent again: DsGate)
	deps.spawn = task.spawn
	deps.wait = task.wait
	deps.now = os.clock
	deps.warn = warn
end

local entries: { [any]: Entry } = {}
local store: any = nil
local store_checked = false
--- Writes in flight (any player), for the shutdown flush.
local inflight = 0

--- Tests: replace the Roblox services. `store` = an object with GetAsync / UpdateAsync (the DataStore),
--- `spawn(fn, ...)`, `wait(sec)`, `now()`, `warn(text)`.
function SettingsStore.configure(d: { [string]: any })
	for k, v in d do
		deps[k] = v
	end
	if d.store ~= nil then
		store = d.store
		store_checked = true
	end
	table.clear(entries)
	inflight = 0
end

local function get_store(): any
	if store_checked then
		return store
	end
	store_checked = true
	local ds = deps.datastores
	if ds ~= nil then
		local ok, s = pcall(function()
			return ds:GetDataStore(SettingsStore.STORE_NAME)
		end)
		if ok then
			store = if deps.gate then deps.gate(s) else s
		end
	end
	return store
end

local function key_for(player: any): string?
	local uid = tonumber(player.UserId) or 0
	if uid <= 0 then
		return nil -- Studio test players / guests: memory only
	end
	return "p_" .. tostring(uid)
end

--- Returns a cleaned copy of a settings section, or nil when unusable.
function SettingsStore.clean_section(values: any): { [string]: any }?
	return SettingsMod.clean_section(values)
end

--- Outages / throttling are worth a retry; "no access" answers (Studio without API access, an
--- unpublished place) are not.
local function retryable(err: any): boolean
	local text = string.lower(tostring(err))
	return not (
		string.find(text, "403", 1, true)
		or string.find(text, "forbidden", 1, true)
		or string.find(text, "studio", 1, true)
		or string.find(text, "publish", 1, true)
	)
end

local function release_waiters(e: Entry)
	e.loaded = true
	local waiters = e.waiters
	e.waiters = {}
	for _, fn in waiters do
		deps.spawn(fn, e.data)
	end
end

--- Starts loading a player's settings (call on PlayerAdded).
function SettingsStore.load(player: any)
	if entries[player] then
		return
	end
	local e: Entry = {
		data = {},
		loaded = false,
		load_failed = false,
		dirty = false,
		touched = {},
		gen = 0,
		writing = false,
		last_write = 0,
		waiters = {},
		replayed_at = nil,
		replay_pending = false,
	}
	entries[player] = e
	deps.spawn(function()
		-- teleported here by a server of ours: the settings it held when they left (server/Handoff)
		if deps.arrived then
			local ok, got = pcall(deps.arrived, player)
			if entries[player] ~= e then
				return
			end
			if ok and type(got) == "table" and type(got.s) == "table" then
				local handed = SettingsMod.clean_all(got.s)
				for section, values in e.data do
					handed[section] = values
				end
				e.data = handed
				release_waiters(e)
				return
			end
		end
		local key = key_for(player)
		local ds = if key then get_store() else nil
		if ds and key then
			local ok, data = false, nil
			for attempt = 1, SettingsStore.LOAD_ATTEMPTS do
				ok, data = pcall(function()
					return ds:GetAsync(key)
				end)
				if ok or entries[player] ~= e or not retryable(data) then
					break
				end
				if attempt < SettingsStore.LOAD_ATTEMPTS then
					deps.wait(SettingsStore.LOAD_BACKOFF[attempt] or 3.0)
				end
			end
			if ok then
				-- merge under anything the player changed while loading
				local loaded = SettingsMod.clean_all(data)
				for section, values in e.data do
					loaded[section] = values
				end
				e.data = loaded
			else
				e.load_failed = true
				if deps.warn then
					deps.warn(
						"[SettingsStore] could not load settings ("
							.. tostring(data)
							.. "); using defaults this session"
					)
				end
			end
		end
		release_waiters(e)
	end)
end

--- Calls fn(settings) once the player's settings are loaded (or failed to load).
function SettingsStore.when_loaded(player: any, fn: (any) -> ())
	local e = entries[player]
	if e == nil then
		SettingsStore.load(player)
		e = entries[player]
	end
	if e.loaded then
		deps.spawn(fn, e.data)
	else
		table.insert(e.waiters, fn)
	end
end

--- Store a section (cleaned; see Net/Settings). Returns false when it was refused: invalid, too many
--- sections, or the player's whole blob would exceed Settings.MAX_TOTAL_BYTES (review_code.md R2-2:
--- the stored blob is what every SETTINGS reply carries, so it stays small).
function SettingsStore.set(player: any, section: any, values: any): boolean
	local e = entries[player]
	if e == nil or not SettingsMod.valid_name(section, SettingsMod.MAX_SECTION_NAME) then
		return false
	end
	local c = SettingsMod.clean_section(values)
	if c == nil then
		return false
	end
	if e.data[section] == nil then
		local n = 0
		for _ in e.data do
			n += 1
		end
		if n >= SettingsMod.MAX_SECTIONS then
			return false
		end
	elseif SettingsMod.equal(e.data[section], c) then
		return true -- nothing changed (no write needed)
	end
	local total = #section + SettingsMod.bytes(c)
	for s, v in e.data do
		if s ~= section then
			total += #s + SettingsMod.bytes(v)
		end
	end
	if total > SettingsMod.MAX_TOTAL_BYTES then
		return false
	end
	e.data[section] = c
	e.touched[section] = true
	e.gen += 1
	e.dirty = true
	return true
end

--- A SETTINGS reply (the player's whole stored blob) goes out at most once per this many seconds per
--- player after the first one (review_code.md R2-2: HELLO used to echo it on every message).
SettingsStore.REPLAY_MIN_S = 30

--- Answer a HELLO: fn(settings) once the player's settings are loaded — the first time, and again
--- only if REPLAY_MIN_S passed since the last reply (a client script restart). Extra HELLOs while a
--- reply is pending or within the interval are dropped. Returns true when a reply was scheduled.
function SettingsStore.replay(player: any, fn: (any) -> ()): boolean
	local e = entries[player]
	if e == nil then
		SettingsStore.load(player)
		e = entries[player]
	end
	local ex = e :: Entry
	if ex.replay_pending then
		return false
	end
	local now = deps.now()
	if ex.replayed_at ~= nil and now - ex.replayed_at < SettingsStore.REPLAY_MIN_S then
		return false
	end
	ex.replayed_at = now
	ex.replay_pending = true
	SettingsStore.when_loaded(player, function(data: any)
		ex.replay_pending = false
		fn(data)
	end)
	return true
end

--- One write of the sections this session changed, merged into the stored value. Serialized per
--- player; `dirty` stays set when the write fails or the data changed meanwhile.
local function write(player: any, e: Entry)
	if e.writing or not e.dirty then
		return
	end
	local key = key_for(player)
	local ds = if key then get_store() else nil
	if ds == nil or key == nil then
		e.dirty = false
		e.last_write = deps.now()
		return
	end
	e.writing = true
	inflight += 1
	local gen = e.gen
	local sections = {}
	for section in e.touched do
		sections[section] = SettingsMod.copy_section(e.data[section])
	end
	-- (the stored sections were never seen: this session's copies hold only the keys it set)
	local blind = e.load_failed
	local uid = tonumber(player.UserId) or 0
	local ok, err = pcall(function()
		ds:UpdateAsync(key, function(old: any)
			local merged = SettingsMod.clean_all(old)
			for section, values in sections do
				local stored = merged[section]
				if blind and type(stored) == "table" then
					local both = SettingsMod.copy_section(stored)
					for k, v in values do
						both[k] = v
					end
					-- (a section too big merged is written as this session has it, as before)
					merged[section] = SettingsMod.clean_section(both) or values
				else
					merged[section] = values
				end
			end
			return SettingsMod.clean_all(merged), { uid }
		end)
	end)
	inflight -= 1
	e.writing = false
	e.last_write = deps.now()
	if ok then
		if e.gen == gen then
			e.dirty = false
		end
	elseif deps.warn then
		deps.warn("[SettingsStore] saving settings failed (will retry): " .. tostring(err))
	end
end
SettingsStore._write = write

--- Periodic flush of dirty entries (at most one write per player per FLUSH_SEC). `force` (shutdown)
--- writes everything pending now and waits for all writes, bounded by SHUTDOWN_WAIT_SEC.
function SettingsStore.flush(force: boolean?)
	local t0 = deps.now()
	for _ = 1, if force then 2 else 1 do
		local now = deps.now()
		for player, e in entries do
			if
				e.dirty
				and not e.writing
				and (force or (e.loaded and now - e.last_write >= SettingsStore.FLUSH_SEC))
			then
				deps.spawn(write, player, e)
			end
		end
		if not force then
			return
		end
		-- a second pass picks up entries whose earlier write was still in flight or failed
		while inflight > 0 and deps.now() - t0 < SettingsStore.SHUTDOWN_WAIT_SEC do
			deps.wait(0.1)
		end
	end
end

--- What a leaving player's settings are, for the next server (deps.parting): only when this session's
--- copy is what is stored (read whole, every change written).
local function parting(player: any, e: Entry?)
	if deps.parting == nil then
		return
	end
	local known = e ~= nil and e.loaded and not e.load_failed and not e.dirty
	pcall(deps.parting, player, if known then SettingsMod.clean_all((e :: Entry).data) else nil)
end

--- The player left: forget the entry and write what is pending (after a write already in flight).
function SettingsStore.release(player: any)
	local e = entries[player]
	if e == nil then
		parting(player, nil)
		return
	end
	entries[player] = nil
	if not e.dirty then
		parting(player, e)
		return
	end
	deps.spawn(function()
		inflight += 1 -- keep a shutdown flush waiting while this one queues behind a write in flight
		local t0 = deps.now()
		while e.writing and deps.now() - t0 < 30 do
			deps.wait(0.1)
		end
		inflight -= 1
		for _ = 1, 2 do
			write(player, e)
			if not e.dirty then
				break
			end
			deps.wait(2.0)
		end
		parting(player, e)
	end)
end

--- The handoff between servers (server/Handoff): `arrived(player) -> { s = settings? }?` is asked
--- before the DataStore read of a joining player; `parting(player, settings?)` hears a leaving
--- player's settings once their last write landed (nil: not known for sure).
function SettingsStore.connect_handoff(arrived: (any) -> any, part: (any, any) -> ())
	deps.arrived = arrived
	deps.parting = part
end

--- True when the player's stored settings could not be read: what this session holds is not what
--- they have saved.
function SettingsStore.load_failed(player: any): boolean
	local e = entries[player]
	return e ~= nil and e.load_failed
end

--- Debug view of a player's stored settings (dev diagnostics / tests).
function SettingsStore.peek(player: any): ({ [string]: any }?, boolean)
	local e = entries[player]
	if e == nil then
		return nil, false
	end
	return e.data, e.loaded
end

--- Tests: the raw entry.
function SettingsStore._entry(player: any): any
	return entries[player]
end

function SettingsStore.start()
	deps.spawn(function()
		while true do
			deps.wait(SettingsStore.FLUSH_SEC / 2)
			SettingsStore.flush(false)
		end
	end)
	deps.players.PlayerRemoving:Connect(SettingsStore.release)
end

return SettingsStore
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterGui" referent="105">
