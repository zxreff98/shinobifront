		interact:donate_from_card()
	end)
	target_card.closed:Connect(function()
		ctx:world_call("set_selected_owner", { 0 })
		ctx:world_call("set_range_mode", { "auto" })
		ctx:world_call("set_range_owner", { 0 })
	end)
	self.touch_router = TouchRouter.new(self)
	self.touch_router:connect()
	local rotate_card = RotateCard.new(ctx)
	rotate_card.name = "RotateCard"
	self.rotate_card = rotate_card
	root:add_child(rotate_card)
	rotate_card.changed:Connect(function(_shown)
		self:_update_input_gate()
	end)
	interact:connect_input()
	self:_hook_buttons(root)
	if UICtx.IS_ROBLOX then
		local RunService = game:GetService("RunService")
		self._step_name = "AirfrontUI_" .. tostring(math.random(1, 1e9))
		local perf = { frames = 0, process = 0.0, kit = 0.0, max = 0.0 }
		self._perf = perf
		-- (Telemetry "slow" says how much of a slow frame the HUD's own work was)
		self.telemetry.ui_perf = perf
		-- (the frame's dt: a Studio film steps it)
		local FrameClock = require("../Map/FrameClock") :: any
		RunService:BindToRenderStep(self._step_name, Enum.RenderPriority.Camera.Value + 10, function(real_dt)
			local dt = FrameClock.dt(real_dt)
			local t0 = os.clock()
			-- _process guards each component itself; this outer guard keeps W.step (tweens, timers,
			-- layout) running even if something outside those guards throws.
			W.guard("UIRoot._process", self._process, self, dt)
			local t1 = os.clock()
			W.guard("Widgets.step", W.step, dt)
			local t2 = os.clock()
			perf.frames += 1
			perf.process += t1 - t0
			perf.kit += t2 - t1
			perf.max = math.max(perf.max, t2 - t0)
		end)
		table.insert(
			self._conns,
			root.resized:Connect(function()
				self:_layout()
			end)
		)
	end
end

--- The spectating pill's takeover button (Takeover.refresh): nil hides it.
function UIRoot._set_spec_takeover(self, info: any)
	local b = self._spec_take
	if b == nil then
		return
	end
	self._spec_take_info = info
	if info == nil then
		b:set_visible(false)
	else
		b:set_visible(true)
		b:set_disabled(info.busy == true)
		if info.saved > 0 then
			b:set_icon("check")
			b:set_text(if info.busy then "Taking over…" else "Take over (saved)")
		else
			b:set_icon("robux")
			b:set_text(if info.busy then "Taking over…" else string.format("Take over  ·  %d", info.price))
		end
	end
	self:_layout()
end

--- Solo: the player took over nation `id` (Session.take_over): back to playing, camera on it.
function UIRoot._on_took_over(self, id: number)
	local ctx = self.ctx
	if self._elim_timer ~= nil then
		self._elim_timer.cancel()
		self._elim_timer = nil
	end
	self._stats.elim = false
	self._stats.killer = 0
	self._stats.over = false
	if self.over.is_open then
		self.over:close()
	end
	-- everything bound to "me" follows the new nation: its borders (attack / expand reach — the
	-- tracker still pointed at the fallen nation: "No border or sea route" everywhere), its structure
	-- counts (build costs), the HUD, its pending alliance requests, its attacks
	ctx.rules:recount()
	self:_bind_refresh()
	self.attacks:mark_dirty()
	self.board:mark_dirty()
	ctx:world_call("focus_owner", { id })
	ctx:sfx("start")
	self:_update_pause()
	self:_update_input_gate()
	self:_request_apply()
end

function UIRoot._build_spectate_pill(self)
	local ctx = self.ctx
	local p = GlassPanel.new(16.0, 8.0, 999, true, 16)
	local h = UITheme.hbox(12)
	p:add_child(h)
	local eye = UITheme.icon_rect("eye", 18.0, UITheme.CYAN)
	eye.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(eye)
	local v = UITheme.vbox(0)
	v.size_flags_vertical = W.SHRINK_CENTER
	v:add_child(UITheme.label("SPECTATING", 13, 800, UITheme.TEXT, 2))
	self._spec_sub = UITheme.label("Drag to look around · click a nation for details", 11, 500, UITheme.TEXT_2)
	v:add_child(self._spec_sub)
	h:add_child(v)
	-- solo: take over the nation that conquered you (Takeover.luau; hidden without an offer)
	self._spec_take = UITheme.button("Take over", "PrimaryButton", "robux", 44.0)
	self._spec_take:set_font_size(13)
	self._spec_take.size_flags_vertical = W.SHRINK_CENTER
	self._spec_take.pressed:Connect(function()
		if self.takeover ~= nil then
			self.takeover:start()
		end
	end)
	self._spec_take:set_visible(false)
	h:add_child(self._spec_take)
	self._spec_again = UITheme.button("Play again", "PrimaryButton", "play", 44.0)
	self._spec_again:set_font_size(13)
	self._spec_again.pressed:Connect(function()
		self:_restart_solo(
			math.clamp(tonumber(ctx:setting("difficulty", UICtx.DEFAULT_DIFFICULTY)) or UICtx.DEFAULT_DIFFICULTY, 0, 2)
		)
	end)
	self._spec_again.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self._spec_again)
	local b = UITheme.button("Title", "GlassButton", "exit", 44.0)
	self._spec_leave = b
	b:set_font_size(13)
	b.size_flags_vertical = W.SHRINK_CENTER
	b.pressed:Connect(function()
		ctx:session_call("leave_match")
	end)
	h:add_child(b)
	p:set_visible(false)
	return p
end

--- Connect to a signal of a duck-typed object (Session / WorldView / AudioDirector) if it has it.
function UIRoot._sig(self, obj: any, sig: string, cb: (...any) -> ())
	local s = obj[sig]
	if (type(s) == "table" and type(s.Connect) == "function") or typeof(s) == "RBXScriptSignal" then
		table.insert(self._sconns, s:Connect(cb))
	end
end

--- Button sounds (GDScript _on_node_added): click on press, soft hover on desktop. The kit tree
--- has no node_added signal, so new buttons are hooked on layout / every half second: the whole tree
--- only when a node joined it since (W.tree_serial; 2026-10-27: it walked every node of every screen,
--- a thousand and more, twice a second, for nothing new nearly every time).
function UIRoot._hook_buttons(self, n: any)
	local serial = W.tree_serial
	if n == self.root then
		if serial == self._hooked_serial then
			return
		end
		self._hooked_serial = serial
	end
	local ctx = self.ctx
	local BuildButton = kit("BuildButton")
	local Leaderboard = self.board and getmetatable(self.board)
	local function rec(node)
		if node._freed then
			return
		end
		if not node._sfx_hooked and node.pressed ~= nil and node.gui ~= nil and node.gui:IsA("GuiButton") then
			node._sfx_hooked = true
			local quiet = (BuildButton ~= nil and getmetatable(node) == BuildButton.__mt)
				or (node.__row_of_leaderboard == true)
			if quiet then
				node.pressed:Connect(function()
					ctx:sfx("click", -4.0)
				end)
			else
				node.pressed:Connect(function()
					ctx:sfx("click", -2.0)
				end)
				node.mouse_entered:Connect(function()
					if not node.disabled and not ctx.touch then
						ctx:sfx("hover", -14.0)
					end
				end)
			end
		end
		for _, c in ipairs(node.children or {}) do
			rec(c)
		end
		for _, c in ipairs(node._internal or {}) do
			rec(c)
		end
	end
	local _ = Leaderboard
	rec(n)
end

-- =============================================================================================
-- Session
-- =============================================================================================

function UIRoot._on_state_ready(self, s: any)
	self:_end_building()
	-- (a new state schedules the deferred rebind, which ends with the screen switch)
	self:_bind_state(s)
	if s == nil then
		self:_request_apply()
	end
end

function UIRoot._on_joined_owner(self, _id: number)
	local ctx = self.ctx
	if ctx.state ~= nil then
		-- the border scan and the HUD refresh run in the deferred rebind step (_bind_refresh)
		ctx.borders:bind(ctx.state, 0)
		ctx.rules:recount()
		self:_schedule_rebind()
	else
		self:_request_apply()
	end
end

--- The frame that delivers a new match (state_ready / joined_owner) already carries the Session's
--- last build slice and the view's rebind, and the next one the territory rebuild. The UI's own
--- rebind work (~5 ms on desktop, several times that on phones) is therefore spread over the frames
--- after them: _bind_refresh (border scan, HUD refresh) REBIND_FRAMES later, then the screen switch
--- (_apply_screen and its layout) one frame after that. Screen requests meanwhile wait for it.
UIRoot.REBIND_FRAMES = 2

function UIRoot._schedule_rebind(self)
	if self._rebind_refresh_in == nil then
		self._rebind_refresh_in = UIRoot.REBIND_FRAMES
	end
	self._rebind_apply_in = nil
end

--- True while a deferred rebind (refresh or screen switch) is pending.
function UIRoot.rebind_pending(self): boolean
	return self._rebind_refresh_in ~= nil or self._rebind_apply_in ~= nil
end

local function rebind_step(self)
	local n = self._rebind_refresh_in
	if n ~= nil then
		if n > 0 then
			self._rebind_refresh_in = n - 1
			return
		end
		self._rebind_refresh_in = nil
		self._rebind_apply_in = 1
		self:_bind_refresh()
		return
	end
	local a = self._rebind_apply_in
	if a ~= nil then
		if a > 0 then
			self._rebind_apply_in = a - 1
			return
		end
		self._rebind_apply_in = nil
		-- inside the kit step like _request_apply, so its follow-up layout (W.defer) lands next frame
		W.defer(function()
			if not self:rebind_pending() then
				self:_apply_screen()
			end
		end)
	end
end

--- Phones: the strip shows only numbers; one tap opens the details card above it.
function UIRoot._toggle_stats_card(self)
	local tooltip = self.tooltip
	if tooltip:is_shown() and tooltip.place == Tooltip.Place.PINNED and tooltip:has_meta("stats") then
		tooltip:hide_tip()
		return
	end
	local spec = self.bar:stats_spec()
	if spec == nil or next(spec) == nil then
		return
	end
	self.target_card:hide_card()
	local r = self.bar:stats_rect()
	local top_y = math.min(r.Min.Y, self.bar:top_edge()) - 8.0
	tooltip:show_pinned(spec, Rect.new(0, 0, r.Min.X + 236.0, top_y))
	tooltip:set_meta("stats", true)
end

--- A solo match started on an outdated server is played on a fresh one (server/FreshServers;
--- 2026-10-04).
--- The server says so in workspace attribute RF_Outdated; it is asked to
--- teleport us (Session.hop_solo) and the match starts on arrival (autostart_solo). Once a session:
--- no answer within HOP_ANSWER_S, "stay", or still here HOP_TRAVEL_S after "going" starts it here.
UIRoot.HOP_ANSWER_S = 4.0
UIRoot.HOP_TRAVEL_S = 25.0

function UIRoot._hop_instead(self, difficulty: number, restart: boolean): boolean
	local ctx = self.ctx
	if not UICtx.IS_ROBLOX or self._hop_tried or self._hop ~= nil then
		return false
	end
	if workspace:GetAttribute("RF_Outdated") ~= true then
		return false
	end
	local s = ctx.session
	local map_id = UIMaps.valid(ctx:setting("map_id", UIMaps.DEFAULT_ID))
	if s == nil or type(s.hop_solo) ~= "function" or not s:hop_solo(difficulty, map_id) then
		return false
	end
	self._hop_tried = true
	self._hop = { difficulty = difficulty, restart = restart, deadline = UICtx.msec() + UIRoot.HOP_ANSWER_S * 1000 }
	self.busy:show_text("Updating to the latest version…")
	return true
end

function UIRoot._on_hop_result(self, going: boolean)
	local h = self._hop
	if h == nil then
		return
	end
	if going then
		h.deadline = UICtx.msec() + UIRoot.HOP_TRAVEL_S * 1000
	else
		self:_hop_fallback()
	end
end

--- The hop is off: the match starts on this server after all.
function UIRoot._hop_fallback(self)
	local h = self._hop
	if h == nil then
		return
	end
	self._hop = nil
	self.busy:hide_chip()
	if h.restart then
		self:_restart_solo(h.difficulty)
	else
		self:_on_play_solo(h.difficulty)
	end
end

--- Arrived from an outdated server with a solo match asked for there (the teleport's data; Main):
--- it starts as soon as the title is up.
function UIRoot.autostart_solo(self, difficulty: number, map_id: string?)
	self._hop_tried = true
	self._autostart = {
		difficulty = math.clamp(math.floor(difficulty), 0, 2),
		map_id = map_id,
		deadline = UICtx.msec() + 20000,
	}
end

function UIRoot._autostart_step(self)
	local a = self._autostart
	local ctx = self.ctx
	if a == nil then
		return
	end
	if UICtx.msec() > a.deadline or ctx:mode() == UICtx.MODE_SOLO or ctx:mode() == UICtx.MODE_MULTI then
		self._autostart = nil
		return
	end
	if self._screen ~= "title" or ctx:session_call("is_building") == true or ctx:mp_waiting() then
		return
	end
	self._autostart = nil
	if a.map_id ~= nil then
		ctx:set_setting("map_id", UIMaps.valid(a.map_id))
	end
	self:_on_play_solo(a.difficulty)
end

function UIRoot._on_play_solo(self, difficulty: number)
	local ctx = self.ctx
	-- A second tap can land after a fast build finished but before the title fades out: never
	-- start a second match over the one just built.
	if
		ctx:session_call("is_building") == true
		or ctx:mode() == UICtx.MODE_SOLO
		or UICtx.msec() - self._solo_msec < 1500
		or self._hop ~= nil
	then
		return
	end
	-- waiting in line for a public match (Quick Play): out of it first
	if self.title:public_busy() then
		ctx:session_call("leave_line")
	end
	if self:_hop_instead(difficulty, false) then
		return
	end
	self._solo_msec = UICtx.msec()
	ctx:set_setting("difficulty", difficulty)
	ctx:sfx("click")
	ctx:session_call("start_solo", { difficulty, UIMaps.valid(ctx:setting("map_id", UIMaps.DEFAULT_ID)) })
end

--- A fresh solo match from inside one: the results screen's "Play again", the game menu's "Restart
--- match" and the spectate pill's "Play again". DELIBERATE DEVIATION: ui_root.gd routed these through
--- _on_play_solo, whose "already in solo" guard (meant for a second tap on the title) made all three
--- dead buttons. Session.start_solo builds the new world in the background (the old one stays frozen
--- meanwhile, with the "Deploying a new world…" chip) and swaps it in on state_ready.
function UIRoot._restart_solo(self, difficulty: number)
	local ctx = self.ctx
	if
		ctx:mode() ~= UICtx.MODE_SOLO
		or ctx:session_call("is_building") == true
		or UICtx.msec() - self._solo_msec < 1500
		or self._hop ~= nil
	then
		return
	end
	if self:_hop_instead(difficulty, true) then
		return
	end
	self._solo_msec = UICtx.msec()
	ctx:set_setting("difficulty", difficulty)
	ctx:sfx("click")
	self._restart_pending = true
	ctx:session_call("start_solo", { difficulty, UIMaps.valid(ctx:setting("map_id", UIMaps.DEFAULT_ID)) })
	self:_update_pause()
end

--- Session builds new worlds in the background: acknowledge instantly, swap when state_ready fires.
function UIRoot._on_building(self, mode: number)
	self._building = true
	local what = if mode == UICtx.MODE_TITLE then "Returning to the title…" else "Deploying a new world…"
	self.title:set_building(mode ~= UICtx.MODE_TITLE)
	self.over:set_building(mode ~= UICtx.MODE_TITLE)
	if mode ~= UICtx.MODE_TITLE or self._screen ~= "title" then
		self.busy:show_text(what)
	end
end

function UIRoot._end_building(self)
	self._restart_pending = false
	if not self._building then
		return
	end
	self._building = false
	self.title:set_building(false)
	self.over:set_building(false)
	self.busy:hide_chip()
end

function UIRoot._bind_state(self, s: any)
	local ctx = self.ctx
	for _, c in ipairs(self._conns_state or {}) do
		c:Disconnect()
	end
	self._conns_state = {}
	ctx.state = s
	-- the mode this state was built for (Session.state_mode): a title backdrop that finishes while
	-- the player waits for a multiplayer match must not pass for the match
	local sm = if ctx.session ~= nil then tonumber(ctx.session.state_mode) else nil
	ctx.state_mode = sm or ctx:mode()
	W.guard("Telemetry.bind", self.telemetry.bind, self.telemetry, s)
	self:_reset_match()
	-- a new match: the Attack bar starts at its default and the leaderboard closed (not the state a
	-- resync hands over mid-match)
	if not (ctx.session ~= nil and ctx.session.state_is_resync == true) then
		ctx:reset_ratio()
		ctx.troop_floor = nil -- (a new player's floor arms again in this match: UIAdvisor.check_floor)
		ctx.alive_from_tick = nil
		if self.board.expanded then
			self.board:close_for_match()
			self.leaderboard_toggled:Fire(false)
			self:_request_relayout()
		end
	end
	local adv = self.advisor
	table.clear(adv._ship_state)
	table.clear(adv._ship_vet)
	table.clear(adv._sam_by_nuke)
	table.clear(adv._volleys)
	table.clear(adv._shells)
	if self.unit_card ~= nil then
		self.unit_card:hide_card()
	end
	if s == nil then
		return
	end
	local function c(name: string, cb: (...any) -> ())
		local sig = s[name]
		if type(sig) == "table" and sig.Connect then
			table.insert(self._conns_state, sig:Connect(cb))
		end
	end
	local bar = self.bar
	c("tiles_changed", function(changed)
		ctx.borders:on_tiles_changed(changed)
		adv:on_tiles_changed(changed)
	end)
	c("stats_changed", function()
		adv:track_stats()
		adv:check_renewals()
		bar:sample_growth()
		if bar.visible then
			bar:refresh()
		end
		self.board:mark_dirty()
	end)
	c("owner_eliminated", function(id, killer)
		adv:on_owner_eliminated(id, killer)
	end)
	c("structure_added", function(sid)
		adv:on_structure_added(sid)
	end)
	c("structure_changed", function(sid, old)
		local st = ctx.state.structures[sid]
		if st ~= nil and ctx.rules:on_structure(st.kind, old, st.owner) then
			bar:refresh_buttons()
		end
	end)
	c("structure_removed", function(sid)
		local st2 = ctx.state.structures[sid]
		if st2 ~= nil and ctx.rules:on_structure(st2.kind, st2.owner, 0) then
			bar:refresh_buttons()
		end
	end)
	c("structure_leveled", function(sid)
		local sl = ctx.state.structures[sid]
		if sl ~= nil and sl.owner == ctx:me() then
			bar:refresh_buttons() -- levels count toward the next price
		end
	end)
	c("unit_added", function(uid)
		adv:on_unit_added(uid)
	end)
	c("sam_launched", function(id)
		adv:on_sam_launched(id)
	end)
	c("shell_fired", function(id)
		adv:on_shell_fired(id)
	end)
	c("shell_impact", function(id, hit)
		adv:on_shell_impact(id, hit)
	end)
	c("unit_removed", function(uid, reason)
		adv:on_unit_removed(uid, reason)
	end)
	for _, sig_name in ipairs({ "unit_state_changed", "unit_hp_changed", "unit_veterancy_changed" }) do
		c(sig_name, function(uid)
			adv:on_unit_changed(uid)
		end)
	end
	c("unit_removed", function(uid, _reason)
		local u = ctx.state.units[uid]
		if u ~= nil and ctx.rules:on_unit(u.kind, u.owner, -1) then
			bar:refresh_buttons()
		end
	end)
	c("nuke_launched", function(uid)
		adv:on_nuke_launched(uid)
	end)
	c("nuke_detonated", function(uid, kind, tile, radius, owner)
		adv:on_nuke_detonated(uid, kind, tile, radius, owner)
	end)
	c("attack_started", function(aid)
		adv:on_attack_started(aid)
	end)
	c("attack_updated", function(aid)
		self:_on_attack_touched(aid)
	end)
	c("attack_ended", function(aid)
		self:_on_attack_touched(aid)
	end)
	c("alliance_requested", function(from, to)
		adv:on_alliance_requested(from, to)
	end)
	c("alliance_request_closed", function(from, to)
		adv:on_alliance_request_closed(from, to)
	end)
	c("alliance_changed", function(a, b, formed, traitor, expired)
		adv:on_alliance_changed(a, b, formed, traitor, expired)
	end)
	c("traitor_marked", function(_id, _until)
		self.board:mark_dirty()
	end)
	c("message", function(to, cat, text)
		adv:on_message(to, cat, text)
	end)
	c("phase_changed", function(phase, left)
		self:_on_phase_changed(phase, left)
	end)
	c("game_over", function(winner, reason)
		adv:on_game_over(winner, reason)
	end)
	c("owner_spawned", function(id, tile)
		self:_on_owner_spawned(id, tile)
	end)
	-- cheap now: the tracker forgets the previous match (its events stop), the rule counts are
	-- current; the full border scan waits for _bind_refresh
	ctx.borders:bind(s, 0)
	ctx.rules:recount()
	ctx.play_start_tick = -1.0
	if s.phase ~= Defs.PHASE_SPAWN then
		-- Joined a running match. time_limit_ticks is absolute (= start of play + the limit), so the
		-- start of play follows exactly; without a limit fall back to the lobby clock.
		if (s.time_limit_ticks or 0) > 0 then
			ctx.play_start_tick = math.max(0.0, s.time_limit_ticks - ctx:match_limit_s() * Defs.TICK_RATE)
		elseif ctx:mode() == UICtx.MODE_MULTI then
			ctx.play_start_tick = math.max(0.0, s.tick - (tonumber(ctx:lobby().elapsed_s) or 0.0) * Defs.TICK_RATE)
		else
			ctx.play_start_tick = 0.0
		end
	end
	self:_schedule_rebind()
end

--- The expensive half of a (re)bind, run a few frames after state_ready (see REBIND_FRAMES): the
--- local player's border scan, the HUD refresh and pending alliance requests. The screen switch
--- follows one frame later.
function UIRoot._bind_refresh(self)
	local ctx = self.ctx
	local s = ctx.state
	if s == nil then
		return
	end
	local bar = self.bar
	self.advisor:track_stats()
	ctx.borders:bind(s, s.local_owner)
	self.top:on_bind()
	self.spawn:on_phase(if s.phase == Defs.PHASE_SPAWN then (s.phase_ticks_left or 0) else 0)
	bar:reset_rate()
	bar:refresh(false)
	self.board:refresh()
	local keys = {}
	for key in pairs(s.requests or {}) do
		table.insert(keys, key)
	end
	table.sort(keys)
	for _, key in ipairs(keys) do
		if key % 1024 == s.local_owner and s.local_owner ~= 0 and not self.feed:has_request_card(key // 1024) then
			self.feed:alliance_request(key // 1024)
		end
	end
	ctx.state_bound:Fire()
end

--- Attack events arrive for every war on the planet; only ours matter to the panel.
function UIRoot._on_attack_touched(self, aid: number)
	local ctx = self.ctx
	local a = if ctx.state ~= nil then ctx.state.attacks[aid] else nil
	if a ~= nil and ctx:me() ~= 0 and (a.attacker == ctx:me() or a.target == ctx:me()) then
		self.attacks:mark_dirty()
	end
end

function UIRoot._reset_match(self)
	local ctx = self.ctx
	self.feed:clear()
	self.target_card:hide_card()
	self.coach:clear()
	self.advisor:reset()
	ctx:set_paused(false)
	self.alert:clear()
	self.interact:cancel_aim(false)
	self.radial:close(false)
	self.tooltip:hide_tip()
	if self.over.is_open then
		self.over:close()
	end
	if self._elim_timer ~= nil then
		self._elim_timer.cancel()
	end
	self._elim_timer = nil
	self._stats =
		{ peak_share = 0.0, max_troops = 0, kills = 0, duration_s = 0.0, over = false, elim = false, killer = 0 }
	ctx:world_call("set_selected_owner", { 0 })
end

--- Elimination curtain after `sec` (UIAdvisor).
function UIRoot._start_elim_timer(self, sec: number, killer: number)
	if self._elim_timer ~= nil then
		self._elim_timer.cancel()
	end
	local h
	h = W.timer(sec, function()
		h.done = true
		self.advisor:on_elim_timeout(killer)
	end)
	self._elim_timer = h
end

function UIRoot._elim_timer_pending(self): boolean
	local h = self._elim_timer
	return h ~= nil and not h.cancelled and not h.done
end

-- =============================================================================================
-- GameState events
-- =============================================================================================

function UIRoot._on_notice(self, text: string, severity: number)
	local cat = Defs.MSG_INFO
	if severity == 1 then
		cat = Defs.MSG_BAD
	elseif severity == 2 then
		cat = Defs.MSG_ALERT
	end
	self.notices:toast(cat, text, if severity == 0 then "info" else "target", if severity > 0 then 9.0 else 6.0)
	self.ctx:sfx(if severity == 2 then "deny" else "toast", -4.0)
end

function UIRoot._on_phase_changed(self, phase: number, ticks_left: number)
	local ctx = self.ctx
	self.top:on_phase(phase, ticks_left)
	if phase == Defs.PHASE_SPAWN then
		self.spawn:on_phase(ticks_left)
	end
	if phase == Defs.PHASE_PLAYING and ctx.play_start_tick < 0.0 and ctx.state ~= nil then
		ctx.play_start_tick = ctx.state.tick
	end
	if phase == Defs.PHASE_PLAYING and self._screen == "spawn" and ctx:in_match() and not ctx:needs_spawn() then
		ctx:sfx("start")
		-- After the HUD has switched to play (and the globe's safe area follows), so the camera
		-- push-in and the banner use the final layout.
		self:_request_apply()
		W.defer(function()
			W.defer(function()
				self.advisor:war_begins()
			end)
		end)
		return
	end
	self:_request_apply()
end

function UIRoot._on_owner_spawned(self, id: number, _tile: number)
	local ctx = self.ctx
	if id == ctx:me() and id ~= 0 then
		self.spawn:refresh()
		self:_request_apply()
		-- landed once play had begun (placed automatically after not picking, or a late landing):
		-- the camera goes to the new nation, and the start sound the others heard plays now
		if ctx.state ~= nil and ctx.state.phase == Defs.PHASE_PLAYING and self._screen == "spawn" then
			ctx:world_call("focus_owner", { id })
			ctx:sfx("start")
		end
	end
end

-- =============================================================================================
-- Screens
-- =============================================================================================

function UIRoot._request_apply(self)
	if self._apply_pending then
		return
	end
	self._apply_pending = true
	W.defer(function()
		if self:rebind_pending() then
			-- a deferred rebind is in flight: its last step applies the screen
			self._apply_pending = false
			return
		end
		self:_apply_screen()
	end)
end

function UIRoot._compute_screen(self): string
	local ctx = self.ctx
	local m = ctx:mode()
	if ctx.session == nil or m == UICtx.MODE_TITLE or ctx.state_mode ~= m or ctx.state == nil then
		return "title"
	end
	local ph = ctx.state.phase
	if ph == Defs.PHASE_SPAWN then
		return "spawn"
	elseif ph == Defs.PHASE_PLAYING then
		return if ctx:needs_spawn() then "spawn" else "play"
	end
	return "over"
end

function UIRoot._apply_screen(self)
	local ctx = self.ctx
	self._apply_pending = false
	local scr = self:_compute_screen()
	local prev = self._screen
	self._screen = scr
	local changed = scr ~= prev
	local in_game = scr ~= "title"
	local alive = ctx:alive_player()
	if changed then
		self.radial:close(false)
		self.tooltip:hide_tip()
		self.target_card:hide_card()
		self.interact:cancel_aim(false)
		self.screen_changed:Fire(scr)
		-- back on the title from the tutorial's match: it is over
		if scr == "title" and self.tutorial ~= nil and self.tutorial.active then
			self.tutorial:stop("left")
		end
	end
	if scr == "title" then
		-- Queued for multiplayer: mode is already MULTI but no match state yet, so keep the
		-- cinematic title globe.
		ctx:world_call("set_attract_mode", { true })
	end
	-- Title
	local title = self.title
	if scr == "title" then
		if changed or not title.visible then
			title:set_visible(true)
			title:on_show()
			self.telemetry:title_shown()
		end
		-- (the settings page may stand open over the title; the game menu goes when the title comes)
		if self.pause.is_open and (changed or self.pause:page() ~= "settings") then
			self.pause:close()
		end
		if self.over.is_open then
			self.over:close()
		end
	elseif title.visible and changed then
		title:hide_animated()
	end
	-- Territory labels stay off over the cinematic title globe.
	ctx:world_call("set_labels_visible", { self.labels_on and in_game })
	-- HUD
	self.hud:set_visible(in_game)
	self.spawn:set_visible(scr == "spawn")
	self.top:set_visible(scr == "play" or scr == "over")
	self.bar:set_visible(scr == "play" and alive)
	self._test_gold:set_visible((scr == "spawn" or scr == "play") and ctx:session_call("can_use_studio_test_gold") == true)
	self.spectate_pill:set_visible(in_game and scr ~= "spawn" and not alive and not self.over.is_open)
	self.board:set_visible(in_game and scr ~= "spawn")
	self.feed:set_visible(in_game and not self.over.is_open)
	self.attacks:set_visible(scr == "play")
	self.coach:set_visible((scr == "play" or scr == "spawn") and not self.over.is_open)
	self.interact.enabled = scr == "spawn" or scr == "play"
	self:_layout()
	W.defer(function()
		self:_layout()
	end)
	if changed then
		if scr == "spawn" then
			self.spawn:on_show()
			self.advisor:spawn_view()
		elseif scr == "play" then
			if prev == "spawn" or prev == "title" then
				W.slide_in(self.bar.panel, Vector2.new(0, 60), 0.1, 0.55)
				W.slide_in(self.top.panel, Vector2.new(0, -40), 0.2, 0.5)
				W.slide_in(
					if self.board.expanded then self.board.panel else self.board._pill,
					Vector2.new(40, 0),
					0.25,
					0.5
				)
			end
			self.bar:refresh(false)
			self.board:refresh()
			self.top:refresh()
		end
	end
	self:_play_music(scr)
	if scr == "over" and not self.over.is_open and not self._stats.over and ctx.state ~= nil then
		self.advisor:on_game_over(ctx.state.winner, ctx.state.over_reason)
	end
	self:_update_input_gate()
	self:_hook_buttons(self.root)
end

function UIRoot._play_music(self, _scr: string)
	self:_update_music()
end

--- The soundtrack's mood for the moment (MusicMood); polled, and on every screen change.
function UIRoot._update_music(self)
	local ctx = self.ctx
	local st = ctx.state
	local scr = self._screen
	if scr == "" then
		return -- (booting: AudioDirector already opens with the title music)
	end
	local me = if scr ~= "title" and ctx:in_match() then ctx:me() else 0
	local my = if me ~= 0 then ctx:my() else nil
	local mood = self._music:mood({
		screen = scr,
		waiting = ctx:mp_waiting(),
		me = me,
		alive = my == nil or my.alive ~= false,
		winner = if st ~= nil then (tonumber(st.winner) or 0) else 0,
		fighting = scr == "play" and MusicMood.fighting(st, me),
	}, os.clock())
	ctx:set_music_mood(mood)
end

function UIRoot._update_input_gate(self)
	local ctx = self.ctx
	local modal = self.help.is_open
		or self.pause.is_open
		or self.over.is_open
		or self.map_picker.is_open
		or (self.locker ~= nil and self.locker.is_open)
		or (self.flag_shop ~= nil and self.flag_shop.is_open)
		or (self.arsenal ~= nil and self.arsenal.is_open)
		or (self.starter ~= nil and self.starter.is_open)
		or (self.general ~= nil and self.general.is_open)
	ctx:set_world_input(not modal and not self.rotate_card.visible and not self.radial.is_open)
	self.feed:set_visible(self.hud.visible and not self.over.is_open)
	self.coach:set_visible(
		self.hud.visible and (self._screen == "play" or self._screen == "spawn") and not self.over.is_open
	)
	self.interact.enabled = not modal
		and not self.rotate_card.visible
		and (self._screen == "spawn" or self._screen == "play")
	self.spectate_pill:set_visible(
		self.hud.visible and self._screen ~= "spawn" and not ctx:alive_player() and not self.over.is_open
	)
	self._spec_again:set_visible(ctx:mode() == UICtx.MODE_SOLO)
	-- a public match's own server: leaving goes back to a hub (the title with the lobby list)
	self._spec_leave:set_text(if ctx:mode() == UICtx.MODE_MULTI then "Leave" else "Title")
	local killer = self._stats.killer or 0
	if ctx:mode() == UICtx.MODE_MULTI and ctx:me() == 0 and ctx.state ~= nil then
		self._spec_sub:set_text("Watching this match · drag to look around, click a nation")
	elseif self._stats.elim and ctx.state ~= nil then
		self._spec_sub:set_text(
			if killer ~= 0
				then string.format("Conquered by %s · the war goes on without you", ctx.state:owner_name(killer))
				else "Your nation fell · the war goes on without you"
		)
	else
		self._spec_sub:set_text("Drag to look around · click a nation for details")
	end
end

--- Solo freezes the simulation while help or the game menu is open.
function UIRoot._update_pause(self)
	local ctx = self.ctx
	local want = (
		self.help.is_open
		or self.pause.is_open
		or (self.takeover ~= nil and self.takeover:pending())
		or (self.arsenal ~= nil and self.arsenal.is_open)
	)
		and ctx:mode() == UICtx.MODE_SOLO
		and ctx:in_match()
		and ctx.state ~= nil
		and ctx.state.phase ~= Defs.PHASE_OVER
	-- A solo restart is building: the match being replaced stays frozen until the new world swaps in.
	ctx:set_paused(want or (self._restart_pending and ctx:mode() == UICtx.MODE_SOLO))
end

function UIRoot._set_labels(self, on: boolean)
	self.labels_on = on
	self.ctx:set_setting("labels", on)
	self.ctx:world_call("set_labels_visible", { on })
	self.labels_toggled:Fire(on)
end

-- =============================================================================================
-- Layout
-- =============================================================================================

function UIRoot._safe_insets(self): any
	local d = self.debug_insets
	if d.x >= 0.0 then
		return d
	end
	return self.probe:safe_insets()
end

--- Recompute every panel position (viewport, safe area, touch or layout mode changed).
function UIRoot.relayout(self)
	self:_layout()
end

local function insets_equal(a: any, b: any): boolean
	return a.x == b.x and a.y == b.y and a.z == b.z and a.w == b.w
end

function UIRoot._layout(self)
	local root = self.root
	if root == nil then
		return
	end
	local ctx = self.ctx
	local vp = root.vp
	ctx.vp = vp
	ctx:update_origin()
	ctx.insets = self:_safe_insets()
	self._last_vp = vp
	self._last_insets = ctx.insets
	ctx.compact = vp.Y < 560.0 or vp.X < 900.0
	-- Studio: workspace attribute AF_FORCE_COMPACT previews the phone layout on a desktop viewport
	if not ctx.compact and UICtx.IS_ROBLOX and workspace:GetAttribute("AF_FORCE_COMPACT") == true then
		ctx.compact = game:GetService("RunService"):IsStudio()
	end
	-- (and AF_FORCE_DESKTOP the desktop layout on Studio's small game view, squeezed)
	if ctx.compact and UICtx.IS_ROBLOX and workspace:GetAttribute("AF_FORCE_DESKTOP") == true then
		ctx.compact = not game:GetService("RunService"):IsStudio()
	end
	-- (the single-row bar: ten slots, plus the Arsenal's SHOP slot and a slot per unlocked kind)
	ctx.wide = vp.X >= 1420.0 + (if self.bar ~= nil then self.bar:extra_width() else 62.0)
	if self.debug_touch >= 0 then
		ctx.touch = self.debug_touch == 1
	elseif UICtx.IS_ROBLOX and workspace:GetAttribute("AF_FORCE_TOUCH") == true then
		-- Studio: preview the touch HUD (tray, place confirm, …) with the mouse
		ctx.touch = ctx.touch or game:GetService("RunService"):IsStudio()
	end
	ctx.reserved_top_left = self.probe:airship_reserved()
	UITheme.min_font_size = if ctx.touch then 12 else 0
	self.title:apply_layout()
	self.top:apply_layout()
	self.spawn:apply_layout()
	self.bar:apply_layout()
	-- Leaderboard: top-right, dropping below the status pill / spawn banner when they would touch.
	local board_top = 12.0 + ctx.insets.y
	local board_w = if ctx.compact then 250.0 else 300.0
	local board_left = vp.X - 12.0 - ctx.insets.z - board_w
	local blockers = {}
	if self.top.visible then
		table.insert(blockers, self.top.panel)
	end
	if self.spawn.visible then
		table.insert(blockers, self.spawn.panel)
	end
	for _, b in ipairs(blockers) do
		local r = b:get_global_rect()
		if r.Max.X + 12.0 > board_left then
			board_top = math.max(board_top, r.Max.Y + 10.0)
		end
	end
	local board = self.board
	board:apply_layout(board_top)
	-- Phones: when the status pill had to drop below the top bar, the rank pill sits beside it.
	if ctx.compact and self.top.visible and not board.expanded and board._pill ~= nil then
		local tr = self.top.panel:get_global_rect()
		local pill_w = board._pill:get_combined_minimum_size().X
		local min_x = if tr.Min.Y >= ctx.reserved_top_left.Max.Y
			then ctx.insets.x + 8.0
			else ctx.reserved_top_left.Max.X + 8.0
		if tr.Min.X - 8.0 - pill_w >= min_x then
			board:place_pill_left_of(tr)
		end
	end
	local bar = self.bar
	local attacks_top = math.max(board:bottom_edge(), if self.top.visible then self.top:bottom_edge() else 0.0) + 10.0
	attacks_top = attacks_top
	self.attacks.tray_open = bar.tray ~= nil and bar.tray.visible
	self.attacks:apply_layout(attacks_top, (if bar.visible then bar:top_edge() else vp.Y - ctx.insets.w) - 8.0)
	self.attacks:refresh()
	self.notices:apply_layout_top(
		if self._screen ~= "title" then ctx.insets.y + (if ctx.compact then 70.0 else 96.0) else ctx.insets.y + 12.0
	)
	self.coach:apply_layout()
	self.tutorial:apply_layout()
	-- the territory notice sits top-left under the top bar, below panels reaching that corner
	self.globe_notice:apply_layout({ self.top.panel, self.spawn.panel, self.title._head })
	local bar_top = if bar.visible then bar:top_edge() else vp.Y - ctx.insets.w
	local sp = self.spectate_pill
	if sp.visible then
		bar_top = math.min(bar_top, vp.Y - ctx.insets.w - 12.0 - sp:get_combined_minimum_size().Y)
	end
	local testGold = self._test_gold
	local buttonWidth = 176
	local buttonY = bar_top - 52
	testGold:set_anchors(0, 0, 0, 0)
	testGold:set_offsets(vp.X / 2 - buttonWidth / 2, buttonY, vp.X / 2 + buttonWidth / 2, buttonY + 44)
	self.feed:apply_layout(bar_top - 12.0)
	self:_layout_alert()
	local sb = 14.0 + ctx.insets.w
	sp.anchor_left, sp.anchor_right, sp.anchor_top, sp.anchor_bottom = 0.5, 0.5, 1.0, 1.0
	sp.grow_horizontal = W.GROW_BOTH
	sp.grow_vertical = W.GROW_BEGIN
	sp.offset_top = -sb
	sp.offset_bottom = -sb
	sp.offset_left = 0
	sp.offset_right = 0
	UITheme.fix_width(self._spec_sub, if ctx.compact then 250.0 else 330.0, W.ALIGN_LEFT, false)
	sp:reset_size()
	self.help:apply_layout()
	self.pause:apply_layout()
	self.map_picker:apply_layout()
	if self.locker ~= nil and self.locker.is_open then
		self.locker:apply_layout()
	end
	if self.flag_shop ~= nil and self.flag_shop.is_open then
		self.flag_shop:apply_layout()
	end
	if self.arsenal ~= nil and self.arsenal.is_open then
		self.arsenal:apply_layout()
	end
	if self.general ~= nil and self.general.is_open then
		self.general:apply_layout()
	end
	if self.starter ~= nil and self.starter.is_open then
		self.starter:apply_layout()
	end
	if self.crate_opening ~= nil then
		self.crate_opening:apply_layout()
	end
	if self.over.is_open then
		self.over:apply_layout()
	end
	if UITheme.min_font_size > 0 then
		self.probe:enforce_min_font(root)
	end
	self.rotate_card:refresh()
	ctx:fit_canvas(self.radial.gui)
	self.probe:update_world_safe_area()
	ctx.layout_changed:Fire()
end

function UIRoot.relayout_alert(self)
	self:_layout_alert()
end

function UIRoot._layout_alert(self)
	local ctx = self.ctx
	if ctx.compact then
		-- Phones: the alert temporarily takes over the status pill's slot (top-right).
		self.alert:apply_layout(self.top.panel.offset_top, 8.0 + ctx.insets.z)
		return
	end
	local y = 12.0 + ctx.insets.y
	if self.top.visible then
		y = self.top:bottom_edge() + 10.0
	elseif self.spawn.visible then
		y = self.spawn:bottom_edge() + 10.0
	end
	self.alert:apply_layout(y)
end

-- =============================================================================================
-- Frame
-- =============================================================================================

local function call_update(comp: any, delta: number)
	comp:update(delta)
end

local function process_interact(self, delta: number)
	self.interact:process_frame(delta)
end

local function update_radial(self, delta: number)
	self.radial:update(delta)
	-- the hold ring follows a finger held on the map (touch only)
	local ctx = self.ctx
	local w = ctx.world
	local inp = if w ~= nil then w.input else nil
	if ctx.touch and inp ~= nil and type(inp.hold_state) == "function" and not self.radial.is_open then
		local pos, k = inp:hold_state()
		self.hold_ring:set(if pos ~= nil then ctx:to_logical(pos) else nil, k)
	else
		self.hold_ring:set(nil, 0)
	end
end

local function slow_poll(self)
	local ctx = self.ctx
	-- A build that ended without a new world (failed, or the Core was missing): don't leave the
	-- "Deploying…" chip up or the old solo match frozen.
	if self._building and ctx:session_call("is_building") == false then
		self:_end_building()
		self:_update_pause()
	end
	self:_poll_layout()
	self:_update_music()
end

local function tips_and_threats(self)
	self.advisor:check_threats()
	self.advisor:check_tips()
	self.advisor:check_floor()
	self.advisor:flush_volleys()
end

local function telemetry_tick(self)
	self.telemetry:tick()
end

--- Per-frame UI work. Each unit runs under W.guard (one failing component is reported once per
--- distinct error and never stops the others, nor the kit step that follows).
function UIRoot._process(self, delta: number)
	local ctx = self.ctx
	local guard = W.guard
	if self._rebind_refresh_in ~= nil or self._rebind_apply_in ~= nil then
		guard("UIRoot rebind", rebind_step, self)
	end
	guard("UIInteract.process_frame", process_interact, self, delta)
	guard("RadialMenu.update", update_radial, self, delta)
	local comps = self._frame_comps
	if comps == nil then
		comps = {}
		for _, key in ipairs({ "bar", "top", "board", "feed", "notices", "attacks", "alert" }) do
			local comp = self[key]
			if comp ~= nil and comp.update then
				table.insert(comps, { comp, key .. ".update" })
			end
		end
		self._frame_comps = comps
	end
	for i = 1, #comps do
		local e = comps[i]
		guard(e[2], call_update, e[1], delta)
	end
	self._poll += delta
	if self._poll >= 0.5 then
		self._poll = 0.0
		guard("UIRoot poll", slow_poll, self)
	end
	-- The radial menu takes the globe's input while it is open (GDScript: its full-rect STOP).
	local want_world = not (
		self.help.is_open
		or self.pause.is_open
		or self.over.is_open
		or self.rotate_card.visible
		or self.radial.is_open
	)
	if want_world ~= self._world_input then
		self._world_input = want_world
		ctx:set_world_input(want_world)
	end
	-- Tips step aside while the player is placing something or using the radial menu.
	local coach = self.coach
	local target = if self.radial.is_open or self.interact.aim_kind ~= "" then 0.0 else 1.0
	local a = Defs.move_toward(coach.modulate_a, target, delta * 6.0)
	if a ~= coach.modulate_a then
		coach:set_modulate_a(a)
	end
	self.telemetry:frame(delta)
	if self._hop ~= nil and UICtx.msec() > self._hop.deadline then
		guard("UIRoot hop", self._hop_fallback, self)
	end
	if self._autostart ~= nil then
		guard("UIRoot autostart", self._autostart_step, self)
	end
	if self._tutorial_at ~= nil then
		guard("UIRoot tutorial", self._tutorial_step, self)
	end
	if self.arsenal ~= nil and self.arsenal.is_open then
		guard("Arsenal.frame", self.arsenal.frame, self.arsenal, delta)
	end
	self._threat_poll += delta
	if self._threat_poll >= 1.0 then
		self._threat_poll = 0.0
		guard("UIAdvisor checks", tips_and_threats, self)
		guard("Telemetry.tick", telemetry_tick, self)
		if self.takeover ~= nil then
			guard("Takeover.tick", self.takeover.tick, self.takeover)
		end
		if self.locker ~= nil and self.locker.is_open then
			guard("Locker.tick", self.locker.tick, self.locker)
		end
		if self.flag_shop ~= nil then
			guard("FlagShop.tick", self.flag_shop.tick, self.flag_shop)
		end
		if self.arsenal ~= nil and self.arsenal.is_open then
			guard("Arsenal.tick", self.arsenal.tick, self.arsenal)
		end
		guard("UIRoot starter", self._starter_auto, self)
	end
end

--- Twice a second: re-layout on viewport / safe-area changes, keep cross-panel positions current.
function UIRoot._poll_layout(self)
	local ctx = self.ctx
	local vp = self.root.vp
	if
		vp ~= self._last_vp
		or not insets_equal(self:_safe_insets(), self._last_insets)
		or self.probe:airship_bar_moved()
	then
		self:_layout()
	elseif self.hud.visible then
		-- Cross-panel positions (feed above the bar, alert under the status) follow content size.
		local bar = self.bar
		local bar_top = if bar.visible then bar:top_edge() else vp.Y - ctx.insets.w
		local testGold = self._test_gold
	local buttonWidth = 176
	local buttonY = bar_top - 52
	testGold:set_anchors(0, 0, 0, 0)
	testGold:set_offsets(vp.X / 2 - buttonWidth / 2, buttonY, vp.X / 2 + buttonWidth / 2, buttonY + 44)
	self.feed:apply_layout(bar_top - 12.0)
		self.attacks.tray_open = bar.tray ~= nil and bar.tray.visible
		self.attacks:apply_layout(
			math.max(self.board:bottom_edge(), if self.top.visible then self.top:bottom_edge() else 0.0) + 10.0,
			(if bar.visible then bar:top_edge() else vp.Y - ctx.insets.w) - 8.0
		)
		-- (a hidden alert is placed when it comes up, UIAdvisor -> relayout_alert: here its two fixed-width
		-- labels were drawn again glyph by glyph twice a second, 2026-10-27)
		if self.alert.visible then
			self:_layout_alert()
		end
		self.probe:update_world_safe_area()
	end
	self:_hook_buttons(self.root)
end

--- UI CPU cost per frame in ms since the last call: {process, kit, total, max, frames}.
function UIRoot.perf_stats(self): { [string]: number }
	local p = self._perf
	if p == nil or p.frames == 0 then
		return { process = 0, kit = 0, total = 0, max = 0, frames = 0 }
	end
	local n = p.frames
	local out = {
		process = p.process / n * 1000,
		kit = p.kit / n * 1000,
		total = (p.process + p.kit) / n * 1000,
		max = p.max * 1000,
		frames = n,
	}
	p.frames, p.process, p.kit, p.max = 0, 0.0, 0.0, 0.0
	return out
end

--- Tear down (tests): disconnect everything and free the GUI.
function UIRoot.destroy(self)
	if UICtx.IS_ROBLOX and self._step_name then
		game:GetService("RunService"):UnbindFromRenderStep(self._step_name)
	end
	for _, c in ipairs(self._sconns) do
		c:Disconnect()
	end
	for _, c in ipairs(self._conns_state or {}) do
		c:Disconnect()
	end
	for _, c in ipairs(self._conns) do
		c:Disconnect()
	end
	self.interact:destroy()
	self.touch_router:destroy()
	self.root:destroy()
	self.gui:Destroy()
	self.ctx.rules = nil
	self.ctx.state = nil
	self.ctx.coach = nil
	self.ctx.tooltip = nil
end

return UIRoot
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="236">
            <Properties>
              <string name="Name">UIRules</string>
              <string name="Source"><![CDATA[-- Port of scripts/ui/ui_rules.gd
-- Client-side game knowledge for the interface: build/nuke catalogue, costs (via Rules), what a
-- click on a tile would do, radial-menu contents and placement checks. These are hints only; the
-- Sim validates every intent for real.
-- (The GDScript's unused private helpers _site_ok / _nearest_own / _neighbours4 are left out.)

local UICtx = require("./UICtx") :: any
local Defs = UICtx.core("Defs")

local _Rules: any = nil
local function Rules(): any
	if _Rules == nil then
		_Rules = UICtx.core("Rules")
	end
	return _Rules
end
local _Theme: any = nil
local function T(): any
	if _Theme == nil then
		_Theme = UICtx.mod("UITheme")
	end
	return _Theme
end

local _Arsenal: any = nil
local function Arsenal(): any
	if _Arsenal == nil then
		_Arsenal = UICtx.data("Arsenal")
	end
	return _Arsenal
end

local UIRules = {}
UIRules.__index = UIRules

UIRules.BUILD_KINDS = { "city", "port", "factory", "defense", "sam", "silo", "warship" }
UIRules.NUKE_KINDS = { "atom", "hydrogen", "mirv" }
--- Hotkeys 1..9, 0 in this order.
UIRules.ACTIONS = { "city", "port", "factory", "defense", "sam", "silo", "warship", "atom", "hydrogen", "mirv" }
UIRules.HOTKEYS = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" }
--- The Arsenal's kinds (Data/Arsenal: unlocked with Stars or Robux), in the order of its tray:
--- structures, munitions launched like a nuke (the last two from their own structure: strikes), and
--- the Reinforcements call. A locked one is offered in the Arsenal instead of doing anything.
UIRules.ARSENAL_BUILD = { "artillery", "airfield", "railgun" }
UIRules.ARSENAL_NUKES = { "mega", "scatter", "airstrike", "slug" }
UIRules.ARSENAL = { "artillery", "airfield", "railgun", "mega", "scatter", "airstrike", "slug", "reinforce" }

UIRules.TITLES = {
	city = "Hidden Village",
	port = "Trade Harbor",
	factory = "Supply Depot",
	defense = "Barrier Seal",
	sam = "Sealing Barrier",
	silo = "Chakra Shrine",
	warship = "Mist Patrol",
	atom = "Rasengan",
	hydrogen = "Planetary Devastation",
	mirv = "Multi Shadow Clone Technique",
	artillery = "Great Fireball Technique",
	airfield = "Summoning Shrine",
	railgun = "Lightning Shrine",
	mega = "Tailed Beast Bomb (Bijūdama)",
	scatter = "Tengai Shinsei",
	airstrike = "Summoning: Toad Oil Flame Bullet",
	slug = "Lightning Cutter",
	reinforce = "Shadow Clone Technique",
}
UIRules.SHORT = {
	city = "Village",
	port = "Harbor",
	factory = "Supply",
	defense = "Barrier",
	sam = "Seal",
	silo = "Shrine",
	warship = "Patrol",
	atom = "Rasengan",
	hydrogen = "Chibaku Tensei",
	mirv = "Shadow Clones",
	artillery = "Fireball",
	airfield = "Summon",
	railgun = "Lightning",
	mega = "Bijūdama",
	scatter = "Meteor",
	airstrike = "Toad Flame",
	slug = "Raikiri",
	reinforce = "Clones",
}
UIRules.BLURBS = {
	city = "Raises your troop cap by {city}. Joins the road network.",
	port = "Coastal. Sends trade ships for gold and builds warships.",
	factory = "Road hub. Trucks pay gold at every stop they pass.",
	defense = "Land within {def_r} tiles costs attackers {def_mag}x the troops and {def_cost}x the time.",
	sam = "Seals incoming chakra attacks aimed within {sam_r} tiles.",
	silo = "Channels long-range jutsu.",
	warship = "Patrols where you send it: sinks transports, then warships, and captures trade ships. Heals at your ports.",
	atom = "Rank 4. Naruto's spiraling chakra sphere blasts a small area.",
	hydrogen = "Rank 2. Pain's core descends, hovers over the target, and pulls up the terrain.",
	mirv = "Sends up to {mirv_n} shadow clones to strike across one territory.",
	artillery = "Casts fireballs automatically at enemies within {art_r} tiles.",
	airfield = "Summons a toad flame attack within {air_r} tiles. Ready again in {air_s} s.",
	railgun = "Channels Lightning Cutter anywhere on the map. Ready again in {rail_s} s.",
	mega = "Rank 3. A rolling chakra sphere cuts a destructive path through the ground.",
	scatter = "Rank 1. Madara brings down a massive meteor with {scat_lo} to {scat_hi} falling fragments.",
	airstrike = "Burns a {air_blast}-tile circle of enemy units and structures.",
	slug = "A focused lightning strike damages every structure it hits.",
	reinforce = "Summons clones equal to a fifth of your troop cap every {rein_s} s.",
}

--- Godot String.format({key: value}): replaces {key} placeholders.
function UIRules.format(text: string, values: { [string]: string }): string
	return (
		string.gsub(text, "{([%w_]+)}", function(k: string)
			local v = values[k]
			return if v ~= nil then v else "{" .. k .. "}"
		end)
	)
end

--- Blurb with its numbers filled in from Rules.
function UIRules.blurb(kind: string): string
	local R = Rules()
	return UIRules.format(UIRules.BLURBS[kind] or "", {
		city = T().fmt_troops(R.CITY_TROOPS),
		def_r = tostring(Defs.round(R.defense_range())),
		def_mag = tostring(Defs.round(R.DEFENSE_POST_MAG)),
		def_cost = tostring(Defs.round(R.DEFENSE_POST_COST)),
		sam_r = tostring(Defs.round(R.sam_range(1))),
		mirv_n = tostring(R.MIRV_WARHEADS),
		art_r = tostring(Defs.round(R.artillery_range())),
		air_r = tostring(Defs.round(R.launch_range(Defs.N_AIRSTRIKE))),
		air_s = tostring(R.RELOAD_TICKS[Defs.S_AIRFIELD] // Defs.TICK_RATE),
		rail_s = tostring(R.RELOAD_TICKS[Defs.S_RAILGUN] // Defs.TICK_RATE),
		air_blast = tostring(Defs.round(R.NUKE_RADIUS[Defs.N_AIRSTRIKE])),
		scat_lo = tostring(R.SCATTER_MIN),
		scat_hi = tostring(R.SCATTER_MAX),
		rein_s = tostring(R.REINFORCE_COOLDOWN_TICKS // Defs.TICK_RATE),
	})
end

function UIRules.new(c: any)
	local self = setmetatable({}, UIRules)
	self.ctx = c
	-- One-entry cache for primary(): hover card and the following click ask about the same tile.
	self._pc_tile = -1
	self._pc_msec = 0
	self._pc_tick = -1
	self._pc_ratio = -1.0
	self._pc = {} :: { [string]: any }
	-- Local owner's structure counts by kind (index = Defs.S_*) plus warships and transports, kept
	-- current from GameState signals so availability checks are O(1).
	self._scount = table.create(Defs.STRUCT_KIND_COUNT, 0)
	self._scount[0] = 0
	self._warships = 0
	self._transports = 0
	self._counted_owner = -1
	return self
end

--- The Arsenal item (Data/Arsenal) a build / launch kind belongs to; nil for the kinds everyone has.
function UIRules.arsenal_item(kind: string): any
	return Arsenal().item_for(kind)
end

--- True when `kind` is an Arsenal kind the player hasn't unlocked.
function UIRules.arsenal_locked(self: any, kind: string): boolean
	local it = Arsenal().item_for(kind)
	if it == nil then
		return false
	end
	local s = self.ctx.session
	return not (s ~= nil and type(s.has_unlock) == "function" and s:has_unlock(it.key))
end

--- A strike: a munition its own structure fires (an Air Strike, a Railgun shot), not a silo.
function UIRules.is_strike(kind: string): boolean
	return kind == "airstrike" or kind == "slug"
end

--- The structure kind (Defs.S_*) a nuke / strike kind leaves from.
function UIRules.launcher(kind: string): number
	local nk = Defs.nuke_kind_from_name(kind)
	local l = if nk >= 0 then Rules().NUKE_LAUNCHER[nk] else nil
	return if type(l) == "number" and l >= 0 then l else Defs.S_SILO
end

--- The troops/s label is green while the regrowth rate
--- (Rules.troop_growth) is >= its previous sample and orange once it drops — past the troop
--- count that regrows fastest (the (1 - troops / max) fall-off overtakes the troops^0.73 term), or
--- when losing land lowers the cap. `last` = nil (no previous sample) keeps it green.
function UIRules.troop_rate_rising(rate: number, last: number?): boolean
	return last == nil or rate >= last
end

--- The label text: "+" .. render_troops(rate per second) .. "/s"; render_number clamps at 0,
--- so a nation above its cap after losing land reads "+0/s".
function UIRules.troop_rate_text(per_second: number): string
	return "+" .. T().fmt_troops(math.max(per_second, 0.0)) .. "/s"
end

--- Aimed at a target tile and launched (the bombs, and the Arsenal's munitions).
function UIRules.is_nuke(kind: string): boolean
	return kind == "atom"
		or kind == "hydrogen"
		or kind == "mirv"
		or kind == "mega"
		or kind == "scatter"
		or kind == "airstrike"
		or kind == "slug"
end

-- ---------------------------------------------------------------------------------------------
-- Costs (single adapter over Core/Rules)
-- ---------------------------------------------------------------------------------------------

--- `owned`: structures of the kinds that share the cost count, warships for "warship", MIRVs
--- launched this match for "mirv".
function UIRules.rules_cost(kind: string, owned: number): number
	if UIRules.is_nuke(kind) then
		return Rules().nuke_cost(kind, owned)
	end
	return Rules().build_cost(kind, owned)
end

--- (inner, outer) blast radii in tiles (MIRV: 0, spread) — Rules.nuke_radii. Two numbers.
function UIRules.nuke_radii(kind: string): (number, number)
	local k = Defs.nuke_kind_from_name(kind)
	if k < 0 then
		return 0, 0
	end
	local a, b = Rules().nuke_radii(k)
	if typeof(a) == "Vector2" then
		return a.X, a.Y
	end
	return a or 0, b or 0
end

function UIRules.nuke_radius(kind: string): number
	local _, outer = UIRules.nuke_radii(kind)
	return Defs.round(outer)
end

--- "Blast radius" text for tooltips: "15 tiles (6 wiped out)" / MIRV spread.
function UIRules.blast_text(kind: string): string
	local inner, outer = UIRules.nuke_radii(kind)
	if kind == "mirv" then
		-- MIRV_WARHEADS is the cap: the real count follows the target's land (55-tile spacing)
		return string.format("Up to %d warheads across the target nation", Rules().MIRV_WARHEADS)
	end
	if inner > 0.0 then
		return string.format("%d tiles (%d wiped out)", Defs.round(outer), Defs.round(inner))
	end
	return string.format("%d tiles", Defs.round(outer))
end

--- The victory metric as result-screen copy (review R2-4): `win` = share of the land outside
--- fallout (what Sim._check_victory compares with Rules.WIN_SHARE), `land` = share of all land.
--- "80.1%" + `all_land` when nothing is irradiated (or it makes no visible difference), else
--- "80.1% of the land outside fallout" -- never a number that reads as short of the 80% goal.
function UIRules.win_phrase(win: number, land: number, fallout: number, all_land: string): string
	local pct = T().fmt_pct(win)
	if fallout > 0 and T().fmt_pct(land) ~= pct then
		return pct .. " of the land outside fallout"
	end
	return pct .. all_land
end

--- What the result screen's offers say for a payout and an inventory (UI/GameOver; tests/offers.luau):
--- the next unlock with the Stars towards it, and 2x Stars with what this match would have paid.
--- `stars`: the balance to count with (the payout's own, or the inventory's once it changed since).
--- Returns { goal = { key, text, ready }?, x2 = { text }? }.
function UIRules.result_offers(award: any, inv: any, catalog: any, stars: number?): { [string]: any }
	local out: { [string]: any } = {}
	if award == nil or (tonumber(award.total) or 0) <= 0 or type(inv) ~= "table" or inv.loaded == false then
		return out
	end
	local unlocks = if type(inv.unlocks) == "table" then inv.unlocks else {}
	local balance = math.max(0, math.floor(stars or tonumber(award.balance) or tonumber(inv.stars) or 0))
	local goal = catalog.next_goal(unlocks)
	if goal ~= nil then
		local ready = balance >= goal.stars
		out.goal = {
			key = goal.key,
			ready = ready,
			text = if ready
				then "UNLOCK " .. string.upper(goal.title)
				else string.format("%s  %s / %s", string.upper(goal.title), UICtx.commas(balance), UICtx.commas(goal.stars)),
		}
	end
	if not unlocks.stars2x and catalog.item("stars2x") ~= nil then
		-- (a payout already doubled never gets here: its owner has the booster)
		out.x2 = { text = string.format("WITH 2X STARS: +%s", UICtx.commas(math.floor(award.total) * 2)) }
	end
	return out
end

--- Seconds for the result screen's "Match duration" card: the whole match (stats.match_s, set at
--- game over) on a result, the moment the player fell (duration_s) on ELIMINATED (review R2-6).
function UIRules.result_seconds(kind: string, stats: { [string]: any }): number
	local secs = tonumber(stats.duration_s) or 0.0
	local m = tonumber(stats.match_s)
	if kind ~= "eliminated" and m ~= nil then
		secs = m
	end
	return secs
end

--- Full recount (on bind / when the local owner changes). Everything else is incremental.
function UIRules.recount(self: any)
	if self._m ~= nil then
		self._m.state = nil
	end
	self._scount = table.create(Defs.STRUCT_KIND_COUNT, 0)
	self._scount[0] = 0
	self._warships = 0
	self._transports = 0
	local s = self.ctx.state
	local me = self.ctx:me()
	self._counted_owner = me
	if s == nil or me == 0 then
		return
	end
	for _, st in s.structures do
		if st.owner == me and st.kind >= 0 and st.kind < Defs.STRUCT_KIND_COUNT then
			self._scount[st.kind] += 1
		end
	end
	for _, u in s.units do
		if u.owner == me then
			if u.kind == Defs.U_WARSHIP then
				self._warships += 1
			elseif u.kind == Defs.U_TRANSPORT then
				self._transports += 1
			end
		end
	end
end

--- Structure moved between owners (old -> new); returns true when the local owner is involved.
function UIRules.on_structure(self: any, kind: number, old_owner: number, new_owner: number): boolean
	local me = self.ctx:me()
	if me == 0 or kind < 0 or kind >= Defs.STRUCT_KIND_COUNT then
		return false
	end
	if self._m ~= nil then
		self._m.state = nil
	end
	if self._counted_owner ~= me then
		self:recount()
		return true
	end
	local hit = false
	if old_owner == me then
		self._scount[kind] = math.max(0, self._scount[kind] - 1)
		hit = true
	end
	if new_owner == me then
		self._scount[kind] += 1
		hit = true
	end
	return hit
end

--- Unit added (+1) or removed (-1); returns true when it is ours.
function UIRules.on_unit(self: any, kind: number, owner_id: number, delta: number): boolean
	local me = self.ctx:me()
	if me == 0 or owner_id ~= me then
		return false
	end
	if self._counted_owner ~= me then
		self:recount()
		return true
	end
	if kind == Defs.U_WARSHIP then
		self._warships = math.max(0, self._warships + delta)
	elseif kind == Defs.U_TRANSPORT then
		self._transports = math.max(0, self._transports + delta)
	end
	return true
end

function UIRules.struct_count(self: any, kind: number): number
	if self._counted_owner ~= self.ctx:me() then
		self:recount()
	end
	return if kind >= 0 and kind < Defs.STRUCT_KIND_COUNT then self._scount[kind] else 0
end

function UIRules.transports(self: any): number
	if self._counted_owner ~= self.ctx:me() then
		self:recount()
	end
	return self._transports
end

function UIRules.owned(self: any, kind: string): number
	local ctx = self.ctx
	if ctx.state == nil or ctx:me() == 0 then
		return 0
	end
	if self._counted_owner ~= ctx:me() then
		self:recount()
	end
	if kind == "warship" then
		return self._warships
	end
	if kind == "mirv" then
		return ctx.state.mirvs_launched or 0
	end
	if UIRules.is_nuke(kind) or kind == "reinforce" then
		return 0
	end
	-- Ports and factories share one count (Rules.cost_count_kinds).
	local n = 0
	for _, sk in Rules().cost_count_kinds(kind) do
		n += self:struct_count(sk)
	end
	return n
end

--- The local player's structures by kind, from one pass over the match's, kept while the frame is
--- the same (state, tick, render tick and owner): per kind (index kind + 1) the level sum, the
--- finished and building counts, the seconds until the first one building finishes, and the
--- structures themselves. (2026-10-27: the build slots refresh 2-4 times a second and each slot made
--- its own passes, ~17 over every structure in the match per refresh: costs, silos, launchers. The
--- answers are the same.)
function UIRules._mine(self: any, s: any): any
	local me = self.ctx:me()
	local m = self._m
	if m == nil then
		local n = Defs.STRUCT_KIND_COUNT
		m = { level = table.create(n, 0), act = table.create(n, 0), building = table.create(n, 0) }
		m.soonest = table.create(n, math.huge)
		m.list = {}
		for k = 1, n do
			m.list[k] = {}
		end
		self._m = m
	elseif m.state == s and m.tick == s.tick and m.rt == s.render_tick and m.me == me then
		return m
	end
	m.state, m.tick, m.rt, m.me = s, s.tick, s.render_tick, me
	local level, act, building, soonest, list = m.level, m.act, m.building, m.soonest, m.list
	for k = 1, Defs.STRUCT_KIND_COUNT do
		level[k], act[k], building[k], soonest[k] = 0, 0, 0, math.huge
		table.clear(list[k])
	end
	local tick = s.tick
	for _, st in s.structures do
		local k = st.kind
		if st.owner ~= me or k < 0 or k >= Defs.STRUCT_KIND_COUNT then
			continue
		end
		k += 1
		level[k] += st.level
		if st.active_tick > tick then
			building[k] += 1
			soonest[k] = math.min(soonest[k], (st.active_tick - tick) / Defs.TICK_RATE)
		else
			act[k] += 1
		end
		table.insert(list[k], st)
	end
	return m
end

--- What Rules.cost_of reads the state through: the local player's level sums from _mine, the rest
--- from the state itself.
function UIRules._cost_view(self: any, s: any): any
	local view = self._view
	if view == nil then
		local mt = { __index = s }
		view = setmetatable({
			struct_level_sum = function(_, id: number, kind: number): number
				local st = mt.__index
				if id == self.ctx:me() and kind >= 0 and kind < Defs.STRUCT_KIND_COUNT then
					return self:_mine(st).level[kind + 1]
				end
				return st:struct_level_sum(id, kind)
			end,
		}, mt)
		self._view, self._view_mt = view, mt
	end
	self._view_mt.__index = s
	return view
end

--- Gold for the next `kind` (structures, upgrades, warships, nukes) — Rules.cost_of, the Sim's
--- own pricing (shared port/factory count, levels, worldwide MIRV launches).
function UIRules.cost(self: any, kind: string): number
	local ctx = self.ctx
	if kind == "reinforce" then
		return Rules().REINFORCE_COST
	end
	if ctx.state == nil then
		return UIRules.rules_cost(kind, 0)
	end
	return Rules().cost_of(self:_cost_view(ctx.state), ctx:me(), kind)
end

--- The local player's finished structures of `kind` that can fire now (a silo's loaded missiles, an
--- airfield / railgun that isn't reloading), and the seconds until the next one can when none does.
function UIRules.ready_launchers(self: any, kind: number): (number, number)
	local s = self.ctx.state
	if s == nil then
		return 0, 0.0
	end
	local cd = Rules().RELOAD_TICKS[kind] or 0
	local n = 0
	local soonest = math.huge
	local mine = if kind >= 0 and kind < Defs.STRUCT_KIND_COUNT then self:_mine(s).list[kind + 1] else {}
	for _, st in mine do
		if st.active_tick <= s.tick then
			local busy = 0
			local first = math.huge
			for _, t in st.shots or {} do
				if t + cd > s.tick then
					busy += 1
					first = math.min(first, t + cd - s.tick)
				end
			end
			local free = math.max(0, (st.level or 1) - busy)
			n += free
			if free == 0 then
				soonest = math.min(soonest, first)
			end
		end
	end
	return n, if n == 0 and soonest < math.huge then soonest / Defs.TICK_RATE else 0.0
end

--- Finished (active) structures of `kind` the local player owns — silos must be built before a
--- nuke can fly. Returns active, under_construction, seconds until the first one finishes.
function UIRules.active_structs(self: any, kind: number): (number, number, number)
	local s = self.ctx.state
	if s == nil or kind < 0 or kind >= Defs.STRUCT_KIND_COUNT then
		return 0, 0, 0.0
	end
	local m = self:_mine(s)
	local k = kind + 1
	local building = m.building[k]
	return m.act[k], building, if building > 0 then m.soonest[k] else 0.0
end

--- {ok, locked, reason, cost} — whether the action can be used right now (ignores the target).
function UIRules.availability(self: any, kind: string): { [string]: any }
	local ctx = self.ctx
	local c = self:cost(kind)
	local out = { ok = false, locked = false, reason = "", cost = c } :: { [string]: any }
	local s = ctx.state
	local o = ctx:my()
	-- an Arsenal kind the player hasn't unlocked: `arsenal` names the item to offer
	if self:arsenal_locked(kind) then
		local it = UIRules.arsenal_item(kind)
		out.reason = "Unlock " .. it.title .. " in the Arsenal"
		out.locked = true
		out.arsenal = it.key
		return out
	end
	if s == nil or o == nil or not ctx:in_match() then
		out.reason = "Join a match first"
		out.locked = true
		return out
	end
	if not o.spawned then
		out.reason = "Place your capital first"
		out.locked = true
		return out
	end
	if not o.alive then
		out.reason = "You have been eliminated"
		out.locked = true
		return out
	end
	if s.phase ~= Defs.PHASE_PLAYING then
		out.reason = "Available once the match begins"
		out.locked = true
		return out
	end
	if UIRules.is_nuke(kind) then
		-- the structure it leaves from: a silo, or (strikes) an airfield / a railgun
		local lk = UIRules.launcher(kind)
		local title = Defs.STRUCT_TITLES[lk]
		if self:struct_count(lk) == 0 then
			out.reason = "Requires " .. (if lk == Defs.S_AIRFIELD then "an " else "a ") .. title
			out.locked = true
			return out
		end
		local act, _, soon = self:active_structs(lk)
		if act == 0 then
			local what = if lk == Defs.S_SILO then "Silo" else title
			out.reason = what .. " under construction · ready in " .. T().fmt_time(math.ceil(soon))
			out.locked = true
			return out
		end
		if UIRules.is_strike(kind) then
			local ready, wait = self:ready_launchers(lk)
			if ready == 0 then
				out.reason = string.format(
					"%s · ready in %s",
					if lk == Defs.S_AIRFIELD then "Airfield rearming" else "Railgun reloading",
					T().fmt_time(math.ceil(wait))
				)
				return out
			end
		end
	end
	if kind == "reinforce" then
		local wait = ((s.reinforce_ready and s.reinforce_ready[o.id]) or 0) - s.tick
		if wait > 0 then
			out.reason = "Ready in " .. T().fmt_time(math.ceil(wait / Defs.TICK_RATE))
			return out
		end
		if Rules().reinforce_troops(o.troops or 0, o.max_troops or 0) <= 0 then
			out.reason = "Your army is at its cap"
			return out
		end
	end
	if kind == "port" and not ctx.borders:has_coast() then
		out.reason = "Requires a coastline"
		out.locked = true
		return out
	end
	if kind == "warship" and self:struct_count(Defs.S_PORT) == 0 then
		out.reason = "Requires a Port"
		out.locked = true
		return out
	end
	if kind == "warship" then
		local act, _, soon = self:active_structs(Defs.S_PORT)
		if act == 0 then
			out.reason = "Port under construction · ready in " .. T().fmt_time(math.ceil(soon))
			out.locked = true
			return out
		end
	end
	if c < 0 then
		out.reason = "Unavailable"
		out.locked = true
		return out
	end
	if (o.gold or 0) < c then
		out.reason = "Need " .. T().fmt_num(c - o.gold) .. " more gold"
		return out
	end
	out.ok = true
	return out
end

--- Structure kinds an own structure of the same kind upgrades instead of a new build (defense posts
--- are not upgradable).
UIRules.UPGRADABLE = { "city", "port", "factory", "sam", "silo" }

--- Bulk menus (four fixed slots: x1, two steps, then the most the
--- player can do right now): structure upgrades x1 / x5 / x10 / xMax, atom bombs x1 / x2 / x5 / xMax
--- (xMax capped by gold, and for bombs by loaded silo missiles; Protocol.MAX_INTENT_AMOUNT 50). User
--- 2026-09-29: the build menu should offer to build several cities, factories or SAMs at once, stacked
--- on top of each other, when the player can afford them.
UIRules.STRUCTURE_BULK_STEPS = { 5, 10 }
UIRules.NUKE_BULK_STEPS = { 2, 5 }
UIRules.MAX_BULK = 50

--- Missiles loaded right now in the local player's finished silos (a silo holds one per level;
--- each launch reloads for SILO_COOLDOWN_TICKS).
function UIRules.ready_missiles(self: any): number
	local s = self.ctx.state
	if s == nil then
		return 0
	end
	local me = self.ctx:me()
	local cd = Rules().SILO_COOLDOWN_TICKS
	local n = 0
	for _, st in s.structures do
		if st.owner == me and st.kind == Defs.S_SILO and st.active_tick <= s.tick then
			local busy = 0
			for _, t in st.shots or {} do
				if t + cd > s.tick then
					busy += 1
				end
			end
			n += math.max(0, (st.level or 1) - busy)
		end
	end
	return n
end

--- Total gold for `amount` more of `kind` in a row (upgrades: each level at the next price).
function UIRules.bulk_cost(self: any, kind: string, amount: number): number
	local R = Rules()
	if UIRules.is_nuke(kind) then
		return R.nuke_cost(kind, if self.ctx.state then self.ctx.state.mirvs_launched else 0) * amount
	end
	local count = if self.ctx.state then R.cost_count_of(self.ctx.state, self.ctx:me(), kind) else 0
	local total = 0
	for i = 0, amount - 1 do
		total += R.build_cost(kind, count + i)
	end
	return total
end

--- The most of `kind` the local player can buy in a row now (gold; bombs: loaded missiles too).
function UIRules.bulk_max(self: any, kind: string): number
	local o = self.ctx:my()
	local gold = if o ~= nil then (tonumber(o.gold) or 0) else 0
	local cap = UIRules.MAX_BULK
	if UIRules.is_nuke(kind) then
		cap = math.min(cap, self:ready_missiles())
	end
	local max = 0
	for n = 1, cap do
		if self:bulk_cost(kind, n) > gold then
			break
		end
		max = n
	end
	return max
end

--- The amount ring for `kind` (id prefix "build" / "nuke") when more than one is possible, else nil.
function UIRules.bulk_ring(self: any, prefix: string, kind: string): { any }?
	local max = self:bulk_max(kind)
	if max <= 1 then
		return nil
	end
	local steps = if UIRules.is_nuke(kind) then UIRules.NUKE_BULK_STEPS else UIRules.STRUCTURE_BULK_STEPS
	local slots = { 1, steps[1], steps[2], max }
	local ring = {}
	local nuke = UIRules.is_nuke(kind)
	local loaded = if nuke then self:ready_missiles() else math.huge
	for i, n in slots do
		local cost = self:bulk_cost(kind, n)
		local ok = n <= max
		local reason = ""
		if not ok then
			reason = if nuke and n > loaded
				then string.format("Only %d missile%s loaded", loaded, if loaded == 1 then "" else "s")
				else "Not enough gold"
		end
		table.insert(ring, {
			id = string.format("%s:%s:%d", prefix, kind, n),
			-- (the fourth slot is the most affordable: its amount says how many)
			label = string.format("×%d · %s", n, T().fmt_cost(cost)),
			icon = kind,
			ok = ok,
			reason = reason,
			danger = nuke,
			cost = cost,
		})
	end
	return ring
end

--- A Rules constant by name (so the UI works before and after the Sim exposes it).
function UIRules.rules_const(cname: string, fallback: any): any
	local v = Rules()[cname]
	if v == nil then
		return fallback
	end
	return v
end

--- Radius (our tiles) a build tap searches the player's own land for a valid site
--- (15 full-size tiles).
function UIRules.snap_radius(): number
	return tonumber(UIRules.rules_const("BUILD_SNAP_RADIUS", 15.0 / Rules().K_LIN)) :: number
end

--- Friendly copy for Rules.placement reasons.
UIRules.PLACE_REASONS = {
	not_own = "Build on your own land",
	no_room = "No room here: structures need space",
	no_coast = "Ports must be on your coast",
	no_port = "Warships need a finished port on this water",
	gold = "Not enough gold",
	invalid = "Can't build here",
}

--- Where a build tap at `tile` really lands:
---   * near an own structure of the same upgradable kind -> upgrade it (tile = that structure);
---   * else the nearest valid site on the player's own land connected to the tap, within
---     snap_radius(), at least STRUCT_MIN_DIST from every structure of any owner (ports: coast).
--- Nukes and warships aim exactly. Returns {ok, tile, reason, warn, upgrade, sid, level}.
function UIRules.resolve_placement(self: any, kind: string, tile: number): { [string]: any }
	local ctx = self.ctx
	local out =
		{ ok = false, tile = tile, reason = "", warn = "", upgrade = false, sid = 0, level = 1 } :: { [string]: any }
	local s = ctx.state
	if s == nil or tile < 0 then
		out.reason = "Point at the globe"
		return out
	end
	if UIRules.is_nuke(kind) then
		local pl = self:_placement_exact(kind, tile)
		out.ok = pl.ok
		out.reason = pl.reason
		out.warn = pl.warn
		return out
	end
	-- The Sim's own algorithm (Rules.place_site via Rules.placement): snapped site or upgrade.
	local r = Rules().placement(s, ctx:me(), kind, tile)
	local code = tostring(r.reason or "")
	local rtile = tonumber(r.tile) or -1
	if kind == "warship" then
		-- the tap picks the patrol target on the sea; Rules returns the launching port.
		out.port = rtile
		out.ok = code == "" and s.map:is_water(tile)
		out.tile = tile
		out.code = code
		if code == "" and not s.map:is_water(tile) then
			out.reason = "Tap the sea where the warship should patrol"
		elseif code ~= "" then
			out.reason = UIRules.PLACE_REASONS[code] or "Can't build here"
		end
		return out
	end
	-- Gold is shown on the slot itself; the preview still shows where it would go.
	out.ok = code == "" or code == "gold"
	out.tile = if rtile >= 0 then rtile else tile
	out.reason = if code ~= "" then (UIRules.PLACE_REASONS[code] or "Can't build here") else ""
	out.code = code
	local sid = tonumber(r.upgrade_sid) or 0
	if sid > 0 and s.structures[sid] ~= nil then
		out.upgrade = true
		out.sid = sid
		out.level = s.structures[sid].level + 1
	end
	if code == "gold" then
		out.ok = false
	end
	return out
end

--- {ok, reason, warn, tile, upgrade, level} for placing `kind` at `tile` (availability is checked
--- separately). Structures snap / upgrade like the Sim (resolve_placement).
function UIRules.placement(self: any, kind: string, tile: number): { [string]: any }
	if UIRules.is_nuke(kind) then
		return self:_placement_exact(kind, tile)
	end
	return self:resolve_placement(kind, tile)
end

--- True when a finished structure of `skind` of the local player's that can fire now is within the
--- reach of munition `nkind` from `tile` (no reach limit: any such structure).
function UIRules.in_reach(self: any, skind: number, nkind: number, tile: number): boolean
	local s = self.ctx.state
	if s == nil then
		return false
	end
	local R = s.rules or Rules()
	local me = self.ctx:me()
	local reach = R.launch_range(nkind)
	local cd = R.RELOAD_TICKS[skind] or 0
	local range_d2 = s.map.range_d2
	for _, st in s.structures do
		if st.owner == me and st.kind == skind and st.active_tick <= s.tick then
			local busy = 0
			for _, t in st.shots or {} do
				if t + cd > s.tick then
					busy += 1
				end
			end
			if busy < (st.level or 1) and (reach <= 0 or range_d2(st.tile, tile) <= reach * reach) then
				return true
			end
		end
	end
	return false
end

function UIRules._placement_exact(self: any, kind: string, tile: number): { [string]: any }
	local ctx = self.ctx
	local out = { ok = false, reason = "", warn = "" } :: { [string]: any }
	local s = ctx.state
	if s == nil or tile < 0 then
		out.reason = "Point at the globe"
		return out
	end
	local map = s.map
	local own = s:tile_owner(tile)
	local me = ctx:me()
	if UIRules.is_nuke(kind) then
		if own == me and own ~= 0 then
			out.reason = "That is your own land"
			return out
		end
		if not map:is_land(tile) and kind ~= "mirv" then
			out.warn = "Open water: little to hit"
		end
		if own ~= 0 and s:are_allies(me, own) then
			out.warn = "Breaks your alliance with " .. s:owner_name(own)
		end
		if kind == "mirv" and own == 0 then
			out.reason = "Target a nation"
			return out
		end
		if UIRules.is_strike(kind) then
			-- a strike never hits an ally, and an air strike needs a ready airfield within reach
			out.warn = ""
			if own ~= 0 and s:are_allies(me, own) then
				out.reason = "That is your ally's land"
				return out
			end
			if kind == "airstrike" and not self:in_reach(Defs.S_AIRFIELD, Defs.N_AIRSTRIKE, tile) then
				out.reason = "Out of your Airfields' reach"
				return out
			end
			if own == 0 then
				out.warn = "Nobody's land: nothing to hit"
			end
		end
		out.ok = true
		return out
	end
	if kind == "warship" then
		if map:is_water(tile) or own == me then
			out.ok = true
		else
			out.reason = "Target water near your ports"
		end
		return out
	end
	if own ~= me then
		out.reason = "Build on your own land"
		return out
	end
	if kind == "port" and not map:is_coastal(tile) then
		out.reason = "Ports must be on the coast"
		return out
	end
	-- Same test as the Sim: no structure closer than STRUCT_MIN_DIST (latitude-corrected circle).
	local md = Rules().STRUCT_MIN_DIST
	local min_d2 = md * md
	local range_d2 = Defs.range_d2
	for _, st in s.structures do
		if range_d2(tile, st.tile) < min_d2 then
			out.reason = "Too close to another structure"
			return out
		end
	end
	out.ok = true
	return out
end

-- ---------------------------------------------------------------------------------------------
-- Primary click
-- ---------------------------------------------------------------------------------------------

--- What a primary click on `tile` does:
--- Where a boat aimed at `tile` lands — the
--- nearest coastal tile of the same owner (unclaimed land for owner 0) that one of our coasts
--- reaches by sea, so clicking anywhere on a territory across the water works, not only its shore
--- pixel. Searches rings out to BOAT_SNAP_FULL full-size tiles; -1 when none.
UIRules.BOAT_SNAP_FULL = 120.0
function UIRules.boat_landing(self: any, tile: number): number
	local ctx = self.ctx
	local s = ctx.state
	if s == nil or tile < 0 then
		return -1
	end
	local map = s.map
	local borders = ctx.borders
	if map:is_coastal(tile) and borders:can_reach_by_sea(tile) then
		return tile
	end
	local own = s:tile_owner(tile)
	local W, H = map.W, map.H
	local k = tonumber(map.k_lin) or 1.0
	local rmax = math.ceil(UIRules.BOAT_SNAP_FULL / k)
	local cx, cy = tile % W, tile // W
	local best, best_d = -1, math.huge
	for r = 1, rmax do
		-- the ring at Chebyshev distance r
		for dy = -r, r do
			local y = cy + dy
			if y < 0 or y >= H then
				continue
			end
			local edge = dy == -r or dy == r
			local dx = -r
			while dx <= r do
				local x = cx + dx
				if x >= 0 and x < W then
					local t = y * W + x
					if map:is_coastal(t) and s:tile_owner(t) == own and borders:can_reach_by_sea(t) then
						local d = dx * dx + dy * dy
						if d < best_d then
							best, best_d = t, d
						end
					end
				end
				dx += if edge then 1 else 2 * r
			end
		end
		-- a hit on ring r: nothing farther than r * sqrt(2) can be closer
		if best >= 0 and r * r >= best_d / 2 then
			break
		end
	end
	return best
end

--- {type: spawn|expand|attack|boat|inspect|none, ok, reason, target, troops, verb, icon}
function UIRules.primary(self: any, tile: number): { [string]: any }
	local ctx = self.ctx
	local now = UICtx.msec()
	local t = if ctx.state ~= nil then ctx.state.tick else -1
	if
		tile == self._pc_tile
		and now - self._pc_msec < 400
		and t == self._pc_tick
		and math.abs(ctx.ratio - self._pc_ratio) < 1e-6
	then
		return table.clone(self._pc)
	end
	local res = self:_primary(tile)
	self._pc_tile = tile
	self._pc_msec = now
	self._pc_tick = t
	self._pc_ratio = ctx.ratio
	self._pc = res
	return table.clone(res)
end

--- Drops the primary() cache (tests / after the world changed under the same tick).
function UIRules.invalidate(self: any)
	self._pc_tile = -1
end

function UIRules._primary(self: any, tile: number): { [string]: any }
	local ctx = self.ctx
	local out =
		{ type = "none", ok = false, reason = "", target = 0, troops = 0.0, verb = "", icon = "info" } :: { [string]: any }
	local s = ctx.state
	if s == nil or tile < 0 or tile >= Defs.TILE_COUNT then
		return out
	end
	local map = s.map
	local me = ctx:me()
	local own = s:tile_owner(tile)
	out.target = own
	if me == 0 or not ctx:in_match() then
		out.type = "inspect"
		out.ok = own ~= 0
		return out
	end
	local o = ctx:my()
	if s.phase == Defs.PHASE_SPAWN or ctx:needs_spawn() then
		if o ~= nil and o.spawned and own == me then
			out.type = "inspect"
			out.ok = true
			return out
		end
		if map:is_contestable(tile) and own == 0 and not s:has_fallout(tile) then
			out.type = "spawn"
			out.ok = true
			out.verb = "Start here"
			out.icon = "target"
		else
			out.reason = if map:is_land(tile) then "Pick unclaimed land" else "Pick land, not water"
		end
		return out
	end
	if s.phase ~= Defs.PHASE_PLAYING or o == nil or not o.alive then
		out.type = "inspect"
		out.ok = own ~= 0
		return out
	end
	if own == me or (own ~= 0 and s:are_allies(me, own)) then
		out.type = "inspect"
		out.ok = true
		return out
	end
	if not map:is_contestable(tile) then
		out.reason = if ctx:terrain_at(tile) == Defs.T_ICECAP then "Antarctica cannot be claimed" else ""
		return out
	end
	-- Fallout stays until the land is conquered again; taking it is slow and costly.
	local fallout = own == 0 and s:has_fallout(tile)
	local share = ctx:order_ratio()
	local troops = (o.troops or 0) * share
	out.troops = troops
	if troops < 1.0 then
		-- (the floor under a new player's army: UICtx.troop_floor)
		out.floor = share < ctx.ratio
		out.reason = if out.floor then UICtx.data("Tutorial").FLOOR_REASON else "No troops available"
		return out
	end
	local land = false
	if s:borders_tile(me, tile) then
		land = true
	elseif own == 0 then
		local touch = ctx.borders:region_touches_me(tile)
		land = touch == 1 or (touch == -1 and ctx.borders:borders_owner(0))
	else
		land = ctx.borders:borders_owner(own)
	end
	if land then
		out.type = if own == 0 then "expand" else "attack"
		out.ok = true
		out.verb = if own == 0 then (if fallout then "Expand into fallout" else "Expand") else "Attack"
		out.icon = "attack"
		return out
	end
	local landing = self:boat_landing(tile)
	if landing >= 0 then
		out.boat_tile = landing
		local max_boats = Rules().MAX_BOATS_PLAYER
		if self:transports() >= max_boats then
			out.type = "boat"
			out.reason = string.format("All %d transports at sea", max_boats)
			out.icon = "boat"
			return out
		end
		out.type = "boat"
		out.ok = true
		out.verb = "Boat invasion"
		out.icon = "boat"
		return out
	end
	out.reason = if own == 0 then "Out of reach: expand toward it" else "No border or sea route"
	return out
end

function UIRules.primary_intent(self: any, tile: number, action: { [string]: any }): { [string]: any }
	local ty = tostring(action.type or "")
	if ty == "spawn" then
		return { type = "spawn", tile = tile }
	elseif ty == "expand" or ty == "attack" then
		return { type = "attack", tile = tile, ratio = self.ctx:order_ratio() }
	elseif ty == "boat" then
		return { type = "boat", tile = tonumber(action.boat_tile) or tile, ratio = self.ctx:order_ratio() }
	end
	return {}
end

--- Short sentence for the floating confirmation ("Attacking Brazil with 24.5K").
function UIRules.confirm_text(self: any, action: { [string]: any }): string
	local s = self.ctx.state
	local troops = T().fmt_troops(tonumber(action.troops) or 0.0)
	local target = tonumber(action.target) or 0
	local ty = tostring(action.type or "")
	if ty == "spawn" then
		return "Starting position set"
	elseif ty == "expand" then
		return "Expanding with " .. troops
	elseif ty == "attack" then
		return string.format("Attacking %s with %s", s:owner_name(target), troops)
	elseif ty == "boat" then
		if target == 0 then
			return "Boat launched with " .. troops
		end
		return string.format("Invading %s by sea with %s", s:owner_name(target), troops)
	end
	return ""
end

-- ---------------------------------------------------------------------------------------------
-- Radial menu
-- ---------------------------------------------------------------------------------------------

--- Items: {id, label, icon, ok, reason, danger, sub: {items}}
--- A donation to ally `own` at the current attack ratio, limited to the ally's troop headroom.
--- The Sim accepts any amount (rule unchanged), but troops above the cap evaporate on the next tick
--- (Rules.troop_growth snaps to the cap), so the UI never sends more than fits (review P1-5).
--- Returns { amount, want, room, cap, capped (amount < want), full (no useful room: < 1 % of cap) }.
function UIRules.donate_plan(self: any, own: number): { [string]: any }
	local ctx = self.ctx
	local want = Defs.trunc(ctx:troops_for_ratio())
	local s = ctx.state
	local o = if s ~= nil and own ~= 0 then s:get_owner(own) else nil
	local cap = if o ~= nil then (tonumber(o.max_troops) or 0) else 0
	local room = want
	if cap > 0 then
		room = math.max(0, math.floor(cap - (tonumber(o.troops) or 0)))
	end
	local amount = math.max(0, math.min(want, room))
	return {
		amount = amount,
		want = want,
		room = room,
		cap = cap,
		capped = amount < want,
		full = cap > 0 and room < math.max(1.0, cap * 0.01),
	}
end

function UIRules.radial_items(self: any, tile: number): { { [string]: any } }
	local ctx = self.ctx
	local items = {}
	local s = ctx.state
	if s == nil or tile < 0 then
		return items
	end
	local me = ctx:me()
	local own = s:tile_owner(tile)
	local playing = s.phase == Defs.PHASE_PLAYING and ctx:alive_player() and not ctx:needs_spawn()
	local land = s.map:is_contestable(tile)

	if playing and land and own ~= me and not s:are_allies(me, own) then
		local p = self:primary(tile)
		local is_boat = tostring(p.type) == "boat"
		local verb = if own == 0 then "Expand" else "Attack"
		local atk =
			{ id = "attack", label = verb, icon = "attack", ok = p.ok and not is_boat, reason = "", danger = false }
		if is_boat then
			atk.reason = "No land border: send a boat"
		elseif not p.ok then
			atk.reason = tostring(p.reason)
		end
		table.insert(items, atk)
		local boat = { id = "boat", label = "Boat", icon = "boat", ok = false, reason = "", danger = false }
		if self:boat_landing(tile) < 0 then
			boat.reason = if s.map:is_coastal(tile)
				then "None of your coasts reach it"
				else "No coast of theirs within reach"
		elseif self:transports() >= Rules().MAX_BOATS_PLAYER then
			boat.reason = "All transports are at sea"
		elseif ctx:troops_for_ratio() < 1.0 then
			boat.reason = "No troops available"
		else
			boat.ok = true
		end
		table.insert(items, boat)
	end

	if playing and own ~= me and me ~= 0 then
		for _, a in s.attacks do
			if a.attacker == me and a.target == own then
				table.insert(
					items,
					{ id = "retreat", label = "Retreat", icon = "retreat", ok = true, reason = "", danger = false }
				)
				break
			end
		end
	end

	if playing and own == me then
		local sub = {}
		-- (the Arsenal's structures the player has unlocked come after the others)
		local build_kinds = table.clone(UIRules.BUILD_KINDS)
		for _, k in UIRules.ARSENAL_BUILD do
			if not self:arsenal_locked(k) then
				table.insert(build_kinds, k)
			end
		end
		for _, k in build_kinds do
			local av = self:availability(k)
			local pl = self:placement(k, tile)
			local ok = av.ok and pl.ok
			local reason = if not av.ok then tostring(av.reason) else tostring(pl.reason)
			table.insert(sub, {
				id = "build:" .. k,
				label = UIRules.SHORT[k],
				icon = k,
				ok = ok,
				reason = reason,
				danger = false,
				cost = av.cost,
				-- an existing structure here: level it up several times at once (bulk upgrade)
				sub = if ok and pl.upgrade then self:bulk_ring("build", k) else nil,
			})
		end
		table.insert(
			items,
			{ id = "build", label = "Build", icon = "city", ok = true, reason = "", danger = false, sub = sub }
		)
	end

	-- what can be launched at the tile: the bombs with a silo, and the Arsenal's munitions the player
	-- has unlocked (a strike with its own structure)
	local launch_kinds = {}
	if playing and own ~= me and me ~= 0 then
		local kinds = table.clone(UIRules.NUKE_KINDS)
		for _, k in UIRules.ARSENAL_NUKES do
			if not self:arsenal_locked(k) then
				table.insert(kinds, k)
			end
		end
		for _, k in kinds do
			if self:struct_count(UIRules.launcher(k)) > 0 then
				table.insert(launch_kinds, k)
			end
		end
	end
	if #launch_kinds > 0 then
		local nsub = {}
		for _, k2 in launch_kinds do
			local av2 = self:availability(k2)
			local pl2 = self:placement(k2, tile)
			local ok2 = av2.ok and pl2.ok
			table.insert(nsub, {
				id = "nuke:" .. k2,
				label = UIRules.SHORT[k2],
				icon = k2,
				ok = ok2,
				reason = if not av2.ok then tostring(av2.reason) else tostring(pl2.reason),
				danger = true,
				cost = av2.cost,
				-- atom bombs stack (x2 against a SAM): a bulk launch
				sub = if ok2 and k2 == "atom" then self:bulk_ring("nuke", k2) else nil,
			})
		end
		local only_strikes = self:struct_count(Defs.S_SILO) == 0
		table.insert(items, {
			id = "nuke",
			label = if only_strikes then "Strike" else "Nuke",
			icon = if only_strikes then launch_kinds[1] else "atom",
			ok = true,
			reason = "",
			danger = true,
			sub = nsub,
		})
	end

	if playing and own ~= 0 and own ~= me then
		local target_info = s:get_owner(own)
		if s:are_allies(me, own) then
			local plan = self:donate_plan(own)
			table.insert(items, {
				id = "donate",
				label = "Donate",
				icon = "donate",
				ok = plan.want >= 1 and not plan.full,
				reason = if plan.want < 1 then "No troops to spare" elseif plan.full then "At their troop cap" else "",
				danger = false,
				troops = plan.amount,
				capped = plan.capped,
			})
			-- the last ALLIANCE_EXTEND_WINDOW_TICKS: ask to renew (renewed once both asked)
			local ai = s:alliance_info(me, own)
			if ai ~= nil and ai.in_window then
				table.insert(items, {
					id = "ally_extend",
					label = "Renew",
					icon = "alliance",
					ok = ai.can_extend,
					reason = if ai.me_asked then "Renewal asked" else "",
					danger = false,
				})
			end
			-- (a teammate is no alliance: nothing to betray)
			if s:has_alliance(me, own) then
				table.insert(
					items,
					{ id = "ally_break", label = "Betray", icon = "betray", ok = true, reason = "", danger = true }
				)
			end
		elseif s:has_request(own, me) then
			table.insert(
				items,
				{ id = "ally_accept", label = "Accept", icon = "alliance", ok = true, reason = "", danger = false }
			)
		elseif s:has_request(me, own) then
			table.insert(items, {
				id = "ally_request",
				label = "Ally",
				icon = "alliance",
				ok = false,
				reason = "Request pending",
				danger = false,
			})
		elseif target_info ~= nil and target_info.alive then
			-- a new request waits 30 s after the previous one (Rules.ALLY_REQUEST_COOLDOWN_TICKS)
			local wait = s:request_cooldown_left(me, own)
			table.insert(items, {
				id = "ally_request",
				label = "Ally",
				icon = "alliance",
				ok = wait <= 0,
				reason = if wait > 0 then string.format("Wait %ds", math.ceil(wait / Defs.TICK_RATE)) else "",
				danger = false,
			})
		end
	end

	table.insert(items, { id = "focus", label = "Focus", icon = "eye", ok = true, reason = "", danger = false })
	if own ~= 0 then
		table.insert(items, { id = "info", label = "Info", icon = "info", ok = true, reason = "", danger = false })
	end
	return items
end

return UIRules
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="237">
            <Properties>
              <string name="Name">UITheme</string>
              <string name="Source"><![CDATA[--!strict
-- Port of scripts/ui/ui_theme.gd
-- AIRFRONT design system: colour tokens, the 8 px spacing scale, Rubik weights, text metrics, the
-- icon cache, style factories and widget helpers. Everything is static so any component can use it.
--
-- Roblox notes (see build/notes/ui-kit.md):
--   * Colours: tokens are Color3; a translucent colour is an RGBA {color: Color3, alpha: number}
--     made with UITheme.c(col, a) (= Godot `Color(col, a)`) or UITheme.rgba(r, g, b, a). Every kit
--     function accepts Color3 or RGBA (or a Core RGBA8 int).
--   * Sizes are Godot logical px. The kit renders them at `UITheme.scale` (set by Widgets.Root).
--   * Godot font size S (em px) -> Roblox TextSize round(S * 1.185 * scale): Roblox TextSize is the
--     line height (ascent + descent), Rubik's is 1.185 em (verified: TextBounds == TTF advances).
--   * Text is measured synchronously with a hidden TextLabel once the Rubik weights are loaded
--     (UITheme.init() yields until they are); Lune falls back to approximate metrics.

local IS_ROBLOX = (game :: any) ~= nil

local UITheme = {}

UITheme.IS_ROBLOX = IS_ROBLOX

--- Shared Core module by name (ReplicatedStorage.Airfront.Core in Roblox, src/shared/Core in Lune),
--- required once and kept. A require later in a session can fail: in some live sessions every require
--- after some moment errors "Cannot require a RobloxScript module from a non RobloxScript context"
--- (from 2026-10-10, 34.6K a day by 10-23), so the client asks for what it needs at start
--- (UICtx.prime) and the kept module answers from then on.
local _core: { [string]: any } = {}
local function core(name: string): any
	local m = _core[name]
	if m ~= nil then
		return m
	end
	if IS_ROBLOX then
		local rs = game:GetService("ReplicatedStorage")
		m = require((rs:WaitForChild("Airfront") :: any):WaitForChild("Core"):WaitForChild(name))
	else
		m = (require :: any)("../../shared/Core/" .. name)
	end
	_core[name] = m
	return m
end
UITheme.core = core

local _Defs: any = nil
local function Defs(): any
	if _Defs == nil then
		local ok, d = pcall(core, "Defs")
		_Defs = if ok then d else false
	end
	return if _Defs then _Defs else nil
end

-- =============================================================================================
-- Colours
-- =============================================================================================

export type RGBA = { color: Color3, alpha: number }

local RGBA_MT = { __type = "RGBA" }
RGBA_MT.__index = RGBA_MT

local function rgba_of(c: Color3, a: number): RGBA
	return setmetatable({ color = c, alpha = a }, RGBA_MT) :: any
end

--- Color(r, g, b, a) with components 0..1.
function UITheme.rgba(r: number, g: number, b: number, a: number?): RGBA
	return rgba_of(Color3.new(r, g, b), if a == nil then 1.0 else a)
end

--- Godot `Color(col, alpha)`: the same colour with another alpha.
function UITheme.c(col: any, alpha: number): RGBA
	return rgba_of(UITheme.color3(col), alpha)
end

function UITheme.is_rgba(x: any): boolean
	return type(x) == "table" and getmetatable(x) == RGBA_MT
end

--- Color3 of any colour value (Color3 | RGBA | RGBA8 int).
function UITheme.color3(x: any): Color3
	if typeof(x) == "Color3" then
		return x
	end
	if type(x) == "table" and x.color ~= nil then
		return x.color
	end
	if type(x) == "number" then
		local r = bit32.band(bit32.rshift(x, 24), 255)
		local g = bit32.band(bit32.rshift(x, 16), 255)
		local b = bit32.band(bit32.rshift(x, 8), 255)
		return Color3.fromRGB(r, g, b)
	end
	return Color3.new(1, 1, 1)
end

--- Alpha (0..1) of any colour value.
function UITheme.alpha(x: any): number
	if type(x) == "table" and x.alpha ~= nil then
		return x.alpha
	end
	if type(x) == "number" then
		return bit32.band(x, 255) / 255.0
	end
	return 1.0
end

function UITheme.to_rgba(x: any): RGBA
	if UITheme.is_rgba(x) then
		return x
	end
	return rgba_of(UITheme.color3(x), UITheme.alpha(x))
end

--- Godot Color.lerp (alpha included). Returns a Color3 when both inputs are opaque Color3s.
function UITheme.lerp(a: any, b: any, t: number): any
	local ca, cb = UITheme.color3(a), UITheme.color3(b)
	local c = Color3.new(ca.R + (cb.R - ca.R) * t, ca.G + (cb.G - ca.G) * t, ca.B + (cb.B - ca.B) * t)
	if typeof(a) == "Color3" and typeof(b) == "Color3" then
		return c
	end
	local aa, ab = UITheme.alpha(a), UITheme.alpha(b)
	return rgba_of(c, aa + (ab - aa) * t)
end

--- Godot Color.get_luminance().
function UITheme.luminance(x: any): number
	local c = UITheme.color3(x)
	return 0.2126 * c.R + 0.7152 * c.G + 0.0722 * c.B
end

function UITheme.equal(a: any, b: any): boolean
	if a == b then
		return true
	end
	if a == nil or b == nil then
		return false
	end
	local ca, cb = UITheme.color3(a), UITheme.color3(b)
	return math.abs(ca.R - cb.R) < 1e-4
		and math.abs(ca.G - cb.G) < 1e-4
		and math.abs(ca.B - cb.B) < 1e-4
		and math.abs(UITheme.alpha(a) - UITheme.alpha(b)) < 1e-4
end

