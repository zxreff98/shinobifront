      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Core</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Defs</string>
            <string name="Source"><![CDATA[--!native
--!strict
-- Port of scripts/core/defs.gd: shared enums, grid helpers and small lookup tables used by the
-- simulation, the client mirror and the views — plus the GDScript builtin helpers the port needs
-- (posmod, trunc, idiv/imod, smoothstep, clampi, round, colour conversions).
--
-- Conventions (see build/notes/READY-core-api):
-- * Tables indexed by an enum value (STRUCT_NAMES, NUKE_NAMES, …) are keyed by that value (0-based):
--   Defs.STRUCT_NAMES[Defs.S_CITY] == "city". Their sizes: Defs.STRUCT_KIND_COUNT, Defs.NUKE_KIND_COUNT.
-- * Functions that returned a Vector2 in GDScript return two numbers (tile_latlon → lat, lon).
-- * Colours are RGBA8 ints (0xRRGGBBAA, Godot Color.to_rgba32 layout) everywhere in Core.

local Defs = {}

--- DEPRECATED fallbacks: the size of the default map ("World", 2000 x 1000). Every map
--- has its own size (map.W / map.H / map.N); simulation code never uses these.
Defs.W = 2000
Defs.H = 1000
Defs.TILE_COUNT = 2000 * 1000
Defs.TICK_RATE = 10
Defs.MAX_OWNERS = 1024

-- Terrain codes (assets/world/terrain.png)
Defs.T_OCEAN = 0
Defs.T_LAKE = 1
Defs.T_PLAINS = 2
Defs.T_HIGHLAND = 3
Defs.T_MOUNTAIN = 4
Defs.T_TUNDRA = 5
Defs.T_ICECAP = 6

-- Owner kinds
Defs.KIND_NATION = 0
Defs.KIND_TRIBE = 1
Defs.KIND_HUMAN = 2

-- Match phases
Defs.PHASE_SPAWN = 0
Defs.PHASE_PLAYING = 1
Defs.PHASE_OVER = 2

-- Structure kinds (value doubles as the map atlas column in row 0)
Defs.S_CITY = 0
Defs.S_PORT = 1
Defs.S_FACTORY = 2
Defs.S_DEFENSE = 3
Defs.S_SAM = 4
Defs.S_SILO = 5
-- The Arsenal's structures (Data/Arsenal: unlocked with Stars or Robux; 2026-10-04)
Defs.S_ARTILLERY = 6
Defs.S_AIRFIELD = 7
Defs.S_RAILGUN = 8
Defs.STRUCT_KIND_COUNT = 9
Defs.STRUCT_NAMES = { [0] = "city", "port", "factory", "defense", "sam", "silo", "artillery", "airfield", "railgun" }
Defs.STRUCT_TITLES = {
	[0] = "City",
	"Port",
	"Factory",
	"Defense Post",
	"Sealing Barrier",
	"Chakra Shrine",
	"Artillery",
	"Airfield",
	"Railgun",
}

-- Unit kinds
Defs.U_TRANSPORT = 0
Defs.U_TRADE = 1
Defs.U_WARSHIP = 2
Defs.U_TRUCK = 3
Defs.UNIT_KIND_COUNT = 4

-- Nuke kinds
Defs.N_ATOM = 0
Defs.N_HYDROGEN = 1
Defs.N_MIRV = 2
Defs.N_WARHEAD = 3
-- The Arsenal's munitions (Data/Arsenal). Mega and scatter leave a silo like an atom bomb; a shell is
-- fired by an Artillery battery on its own; an air strike leaves an Airfield and a slug a Railgun.
Defs.N_MEGA = 4
Defs.N_SCATTER = 5
Defs.N_SHELL = 6
Defs.N_AIRSTRIKE = 7
Defs.N_SLUG = 8
Defs.NUKE_KIND_COUNT = 9
Defs.NUKE_NAMES = { [0] = "atom", "hydrogen", "mirv", "warhead", "mega", "scatter", "shell", "airstrike", "slug" }
Defs.NUKE_TITLES = {
	[0] = "Rasengan",
	"Planetary Devastation",
	"Multi Shadow Clone Technique",
	"Chakra Fragment",
	"Bijūdama",
	"Tengai Shinsei",
	"Great Fireball Technique",
	"Toad Oil Flame Bullet",
	"Lightning Cutter",
}

-- Arsenal unlocks an owner holds (Sim.o_unlock bit mask; Data/Arsenal names them). Without its bit
-- the Sim refuses the build, the launch or the call.
Defs.UNLOCK = {
	mega = 1,
	scatter = 2,
	reinforce = 4,
	artillery = 8,
	airfield = 16,
	railgun = 32,
	reload2x = 64,
}
Defs.UNLOCK_ALL = 127
--- The unlock a structure kind (Defs.S_*) / a munition (Defs.N_*) needs: 0 = none.
Defs.STRUCT_UNLOCK = { [0] = 0, 0, 0, 0, 0, 0, 8, 16, 32 }
Defs.NUKE_UNLOCK = { [0] = 0, 0, 0, 0, 1, 2, 8, 16, 32 }

-- Tile flags (GameState.flags / delta "flags")
Defs.F_FALLOUT = 1

-- Unit removal reasons
Defs.DEL_ARRIVED = 0
Defs.DEL_DESTROYED = 1
Defs.DEL_INTERCEPTED = 2
Defs.DEL_CAPTURED = 3

-- Message categories
Defs.MSG_INFO = 0
Defs.MSG_GOOD = 1
Defs.MSG_BAD = 2
Defs.MSG_ALERT = 3
Defs.MSG_ALLIANCE = 4

-- Game-over reasons
Defs.OVER_DOMINATION = 0
Defs.OVER_TIME = 1
Defs.OVER_DEFEATED = 2
Defs.OVER_ABANDONED = 3

-- Map atlas cells (assets/icons/map_atlas.png, 8 x 2 cells of 128 px) as {x, y} (Vector2i in GDScript).
Defs.ATLAS_CITY = { x = 0, y = 0 }
Defs.ATLAS_PORT = { x = 1, y = 0 }
Defs.ATLAS_FACTORY = { x = 2, y = 0 }
Defs.ATLAS_DEFENSE = { x = 3, y = 0 }
Defs.ATLAS_SAM = { x = 4, y = 0 }
Defs.ATLAS_SILO = { x = 5, y = 0 }
Defs.ATLAS_WARSHIP = { x = 6, y = 0 }
Defs.ATLAS_TRANSPORT = { x = 7, y = 0 }
Defs.ATLAS_TRADE = { x = 0, y = 1 }
Defs.ATLAS_TRUCK = { x = 1, y = 1 }
Defs.ATLAS_TARGET = { x = 2, y = 1 }
Defs.ATLAS_ATTACK = { x = 3, y = 1 }
Defs.ATLAS_CAPITAL = { x = 4, y = 1 }
Defs.ATLAS_RADIATION = { x = 5, y = 1 }
Defs.ATLAS_GLOW = { x = 6, y = 1 }
Defs.ATLAS_SPAWN = { x = 7, y = 1 }

local DEG = math.pi / 180

-- =============================================================================================
-- GDScript builtin equivalents
-- =============================================================================================

--- GDScript posmod(a, b) (result has the sign of b) == Luau `%`.
function Defs.posmod(a: number, b: number): number
	return a % b
end

--- GDScript int(x): truncate toward zero.
function Defs.trunc(x: number): number
	if x >= 0 then
		return math.floor(x)
	end
	return -math.floor(-x)
end

--- GDScript integer `a / b` (truncating division of ints).
function Defs.idiv(a: number, b: number): number
	local q = a / b
	if q >= 0 then
		return math.floor(q)
	end
	return -math.floor(-q)
end

--- GDScript integer `a % b` (C remainder: sign of a).
function Defs.imod(a: number, b: number): number
	return math.fmod(a, b)
end

function Defs.clampi(v: number, lo: number, hi: number): number
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

Defs.clampf = Defs.clampi
Defs.clamp = Defs.clampi

function Defs.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function Defs.inverse_lerp(a: number, b: number, v: number): number
	if a == b then
		return 0
	end
	return (v - a) / (b - a)
end

--- Godot smoothstep(from, to, x).
function Defs.smoothstep(from: number, to: number, x: number): number
	if from == to then
		return if x < from then 0 else 1
	end
	local s = (x - from) / (to - from)
	if s < 0 then
		s = 0
	elseif s > 1 then
		s = 1
	end
	return s * s * (3.0 - 2.0 * s)
end

--- Godot round(): half away from zero.
function Defs.round(x: number): number
	if x >= 0 then
		return math.floor(x + 0.5)
	end
	return -math.floor(-x + 0.5)
end

--- Godot snappedf(x, step).
function Defs.snappedf(x: number, step: number): number
	if step == 0 then
		return x
	end
	return math.floor(x / step + 0.5) * step
end

--- Godot wrapf(value, min, max).
function Defs.wrapf(value: number, lo: number, hi: number): number
	local range = hi - lo
	if range == 0 then
		return lo
	end
	return value - range * math.floor((value - lo) / range)
end

function Defs.wrapi(value: number, lo: number, hi: number): number
	local range = hi - lo
	if range == 0 then
		return lo
	end
	return lo + ((value - lo) % range)
end

--- Godot move_toward(from, to, delta).
function Defs.move_toward(from: number, to: number, delta: number): number
	if math.abs(to - from) <= delta then
		return to
	end
	return from + (if to > from then delta else -delta)
end

--- Godot is_finite for numbers (false for NaN / ±inf).
function Defs.is_finite(x: number): boolean
	return x == x and x ~= math.huge and x ~= -math.huge
end

--- Rounds a double to float32 precision (PackedFloat32Array / Color components).
function Defs.f32(x: number): number
	return string.unpack("f", string.pack("f", x)) :: number
end

--- Index (0-based, matching the enum values) of `value` in an enum-keyed table, or -1.
function Defs.find(tbl: { [number]: any }, value: any): number
	local i = 0
	while tbl[i] ~= nil do
		if tbl[i] == value then
			return i
		end
		i += 1
	end
	return -1
end

-- =============================================================================================
-- Enums
-- =============================================================================================

function Defs.struct_kind_from_name(kind_name: string): number
	for k = 0, Defs.STRUCT_KIND_COUNT - 1 do
		if Defs.STRUCT_NAMES[k] == kind_name then
			return k
		end
	end
	return -1
end

function Defs.nuke_kind_from_name(kind_name: string): number
	for k = 0, Defs.NUKE_KIND_COUNT - 1 do
		if Defs.NUKE_NAMES[k] == kind_name then
			return k
		end
	end
	return -1
end

-- =============================================================================================
-- Grid geometry
-- =============================================================================================
-- Every map is a flat W x H grid (no wrap, plain grid metrics); the helpers that need the
-- map size live on the map (WorldMap: map.W / map.H / map.N, map.dist2, map.range_d2,
-- map.geo_manhattan, map.geo_span, map.gc_dist, map:tile_x / tile_y / tile_index / neighbor).
-- The sphere helpers below are plain math (no grid) kept for camera code.

--- Unit-sphere position (x, y, z) of a lat/lon (Y up, lon 0 faces +Z) as three numbers.
function Defs.latlon_xyz(lat_deg: number, lon_deg: number): (number, number, number)
	local lat = lat_deg * DEG
	local lon = lon_deg * DEG
	local c = math.cos(lat)
	return c * math.sin(lon), math.sin(lat), c * math.cos(lon)
end

function Defs.latlon_vec3(lat_deg: number, lon_deg: number): Vector3
	local x, y, z = Defs.latlon_xyz(lat_deg, lon_deg)
	return Vector3.new(x, y, z)
end

--- lat, lon (degrees) of a direction given as numbers (normalised internally).
function Defs.xyz_latlon(x: number, y: number, z: number): (number, number)
	local l = math.sqrt(x * x + y * y + z * z)
	if l > 0 then
		x /= l
		y /= l
		z /= l
	end
	local ny = y
	if ny < -1 then
		ny = -1
	elseif ny > 1 then
		ny = 1
	end
	return math.asin(ny) / DEG, math.atan2(x, z) / DEG
end

function Defs.vec3_latlon(v: Vector3): (number, number)
	return Defs.xyz_latlon(v.X, v.Y, v.Z)
end

-- ---------------------------------------------------------------------------------------------
-- DEPRECATED view-map shims for client UI written against the old fixed grid (TargetCard,
-- UIInteract, UIRules, UIAdvisor). They follow the map of the most recently created / switched
-- GameState (GameState calls Defs.set_view_map) and use its flat metrics; Defs.W / H / TILE_COUNT
-- follow it too. Simulation code never uses them (several maps may live in one process) — new code
-- should use state.map (map.W, map.range_d2, map.gc_dist, map:point_tile ...).
-- ---------------------------------------------------------------------------------------------

local view_w = Defs.W
local view_h = Defs.H

--- Called by GameState: the map the client UI shows.
function Defs.set_view_map(map: any)
	view_w = map.W
	view_h = map.H
	Defs.W = map.W
	Defs.H = map.H
	Defs.TILE_COUNT = map.N
end

--- DEPRECATED (use map.gc_dist): straight-line tile distance on the view map.
function Defs.tile_distance(a: number, b: number): number
	local dx = a % view_w - b % view_w
	local dy = a // view_w - b // view_w
	return math.sqrt(dx * dx + dy * dy)
end

--- DEPRECATED (use map.range_d2 / map.dist2): squared tile distance on the view map.
function Defs.range_d2(a: number, b: number): number
	local dx = a % view_w - b % view_w
	local dy = a // view_w - b // view_w
	return dx * dx + dy * dy
end
Defs.dist2 = Defs.range_d2

--- DEPRECATED (use map.geo_manhattan).
function Defs.geo_manhattan(a: number, b: number): number
	return math.abs(a % view_w - b % view_w) + math.abs(a // view_w - b // view_w)
end

--- DEPRECATED: tile containing map-space point (x, y) on the view map (the old sphere-to-tile
--- helpers now receive GameState's map-space positions; z is ignored).
function Defs.xyz_tile(x: number, y: number, _z: number?): number
	local tx = math.clamp(math.floor(x), 0, view_w - 1)
	local ty = math.clamp(math.floor(y), 0, view_h - 1)
	return ty * view_w + tx
end

function Defs.vec3_tile(v: Vector3): number
	return Defs.xyz_tile(v.X, v.Y, v.Z)
end

-- float32 rounding through a scratch buffer (faster than string.pack for hot callers).
local F32B = buffer.create(4)
local function f32b(x: number): number
	buffer.writef32(F32B, 0, x)
	return buffer.readf32(F32B, 0)
end
Defs.f32b = f32b

-- =============================================================================================
-- Colours (RGBA8 ints, Godot Color.to_rgba32 layout 0xRRGGBBAA)
-- =============================================================================================

--- r, g, b, a bytes of an RGBA8 int.
function Defs.rgba_bytes(c: number): (number, number, number, number)
	c = c % 4294967296
	return c // 16777216, (c // 65536) % 256, (c // 256) % 256, c % 256
end

--- r, g, b, a floats (0..1) of an RGBA8 int (Godot Color.hex).
function Defs.rgba_floats(c: number): (number, number, number, number)
	local r, g, b, a = Defs.rgba_bytes(c)
	return r / 255, g / 255, b / 255, a / 255
end

--- Godot Color(r, g, b, a).to_rgba32(): components rounded half away from zero, wrapped to a byte.
function Defs.floats_rgba(r: number, g: number, b: number, a: number?): number
	-- Color::to_rgba32: (uint8_t)Math::round(r * 255.0f) — the product is a float32
	local function byte(v: number): number
		return Defs.round(Defs.f32b(v * 255.0)) % 256
	end
	return ((byte(r) * 256 + byte(g)) * 256 + byte(b)) * 256 + byte(a or 1.0)
end

--- "#rrggbb" / "rrggbb" / "#rrggbbaa" → RGBA8 int (Color.html(h).to_rgba32()).
function Defs.html_rgba(hex: string): number
	local s = string.gsub(hex, "^#", "")
	if #s == 6 then
		return (tonumber(s, 16) or 0x888888) * 256 + 255
	elseif #s == 8 then
		return tonumber(s, 16) or 0x888888FF
	elseif #s == 3 then
		local r = tonumber(string.sub(s, 1, 1), 16) or 8
		local g = tonumber(string.sub(s, 2, 2), 16) or 8
		local b = tonumber(string.sub(s, 3, 3), 16) or 8
		return (((r * 17) * 256 + g * 17) * 256 + b * 17) * 256 + 255
	end
	return 0x888888FF
end

--- Godot Color.from_hsv(h, s, v, a) → r, g, b floats (0..1).
function Defs.hsv_floats(h: number, s: number, v: number): (number, number, number)
	if s == 0 then
		return v, v, v
	end
	h *= 6.0
	h = math.fmod(h, 6)
	local i = math.floor(h)
	local f = h - i
	local p = v * (1.0 - s)
	local q = v * (1.0 - s * f)
	local t = v * (1.0 - s * (1.0 - f))
	if i == 0 then
		return v, t, p
	elseif i == 1 then
		return q, v, p
	elseif i == 2 then
		return p, v, t
	elseif i == 3 then
		return p, q, v
	elseif i == 4 then
		return t, p, v
	end
	return v, p, q
end

--- Color.from_hsv(h, s, v).to_rgba32().
function Defs.hsv_rgba(h: number, s: number, v: number): number
	local r, g, b = Defs.hsv_floats(h, s, v)
	return Defs.floats_rgba(r, g, b, 1.0)
end

--- Godot Color.hex(c) as a Roblox Color3 (falls back to a plain {R,G,B} table where Color3 is missing).
function Defs.color_from_int(c: number): any
	local r, g, b = Defs.rgba_bytes(c)
	local C3: any = Color3
	if C3 ~= nil then
		return C3.fromRGB(r, g, b)
	end
	return { R = r / 255, G = g / 255, B = b / 255 }
end

--- Color.to_html(false) of an RGBA8 int ("rrggbb").
function Defs.rgba_html(c: number): string
	local r, g, b = Defs.rgba_bytes(c)
	return string.format("%02x%02x%02x", r, g, b)
end

-- =============================================================================================
-- Text
-- =============================================================================================

--- "12.3K", "1.25M", "-850" (Defs.format_troops).
function Defs.format_troops(value: number): string
	local v = math.abs(value)
	local s: string
	if v >= 1000000.0 then
		if v < 10000000.0 then
			s = string.format("%.2fM", v / 1000000.0)
		else
			s = string.format("%.1fM", v / 1000000.0)
		end
	elseif v >= 1000.0 then
		if v < 100000.0 then
			s = string.format("%.1fK", v / 1000.0)
		else
			s = string.format("%dK", Defs.trunc(v / 1000.0))
		end
	else
		s = tostring(Defs.trunc(v))
	end
	return (if value < 0.0 then "-" else "") .. s
end

-- =============================================================================================
-- Godot's sort (core/templates/sort_array.h: introsort — median-of-3 quicksort, heapsort past
-- 2*log2(n) levels, final insertion sort), so Array.sort_custom() orders equal elements exactly
-- like the original (table.sort is a different, also unstable, algorithm).
-- =============================================================================================

local INTROSORT_THRESHOLD = 16

--- Sorts the 1-based array `a` in place with Godot's SortArray algorithm; `less(x, y)` is the
--- sort_custom callable. Equal elements end up in the same order as in Godot.
function Defs.godot_sort(a: { any }, less: (any, any) -> boolean)
	local len = #a
	if len < 2 then
		return
	end
	-- 0-based helpers over the 1-based array
	local function get(i: number): any
		return a[i + 1]
	end
	local function set(i: number, v: any)
		a[i + 1] = v
	end
	local function median_of_3(x: any, y: any, z: any): any
		if less(x, y) then
			if less(y, z) then
				return y
			elseif less(x, z) then
				return z
			else
				return x
			end
		elseif less(x, z) then
			return x
		elseif less(y, z) then
			return z
		else
			return y
		end
	end
	local function push_heap(first: number, hole: number, top: number, value: any)
		local parent = (hole - 1) // 2
		while hole > top and less(get(first + parent), value) do
			set(first + hole, get(first + parent))
			hole = parent
			parent = (hole - 1) // 2
		end
		set(first + hole, value)
	end
	local function adjust_heap(first: number, hole: number, n: number, value: any)
		local top = hole
		local second = 2 * hole + 2
		while second < n do
			if less(get(first + second), get(first + second - 1)) then
				second -= 1
			end
			set(first + hole, get(first + second))
			hole = second
			second = 2 * (second + 1)
		end
		if second == n then
			set(first + hole, get(first + second - 1))
			hole = second - 1
		end
		push_heap(first, hole, top, value)
	end
	local function pop_heap_to(first: number, last: number, result: number, value: any)
		set(result, get(first))
		adjust_heap(first, 0, last - first, value)
	end
	local function make_heap(first: number, last: number)
		if last - first < 2 then
			return
		end
		local n = last - first
		local parent = (n - 2) // 2
		while true do
			adjust_heap(first, parent, n, get(first + parent))
			if parent == 0 then
				return
			end
			parent -= 1
		end
	end
	local function partial_sort(first: number, last: number, middle: number)
		make_heap(first, middle)
		for i = middle, last - 1 do
			if less(get(i), get(first)) then
				pop_heap_to(first, middle, i, get(i))
			end
		end
		-- sort_heap
		local l = middle
		while l - first > 1 do
			pop_heap_to(first, l - 1, l - 1, get(l - 1))
			l -= 1
		end
	end
	local function partitioner(first: number, last: number, pivot: any): number
		while true do
			while less(get(first), pivot) do
				first += 1
			end
			last -= 1
			while less(pivot, get(last)) do
				last -= 1
			end
			if not (first < last) then
				return first
			end
			local tmp = get(first)
			set(first, get(last))
			set(last, tmp)
			first += 1
		end
	end
	local function introsort(first: number, last: number, depth: number)
		while last - first > INTROSORT_THRESHOLD do
			if depth == 0 then
				partial_sort(first, last, last)
				return
			end
			depth -= 1
			local cut =
				partitioner(first, last, median_of_3(get(first), get(first + (last - first) // 2), get(last - 1)))
			introsort(cut, last, depth)
			last = cut
		end
	end
	local function unguarded_linear_insert(last: number, value: any)
		local nxt = last - 1
		while less(value, get(nxt)) do
			set(last, get(nxt))
			last = nxt
			nxt -= 1
		end
		set(last, value)
	end
	local function linear_insert(first: number, last: number)
		local val = get(last)
		if less(val, get(first)) then
			for i = last, first + 1, -1 do
				set(i, get(i - 1))
			end
			set(first, val)
		else
			unguarded_linear_insert(last, val)
		end
	end
	local function insertion_sort(first: number, last: number)
		if first == last then
			return
		end
		for i = first + 1, last - 1 do
			linear_insert(first, i)
		end
	end
	local k = 0
	local n = len
	while n ~= 1 do
		n = n // 2
		k += 1
	end
	introsort(0, len, k * 2)
	if len > INTROSORT_THRESHOLD then
		insertion_sort(0, INTROSORT_THRESHOLD)
		for i = INTROSORT_THRESHOLD, len - 1 do
			unguarded_linear_insert(i, get(i))
		end
	else
		insertion_sort(0, len)
	end
end

return Defs
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Ev</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/core/ev.gd: event type ids carried in the "ev" array of a Sim delta. Each event
-- is a 1-based Luau array whose first element is one of these ids, followed by the arguments in
-- GDScript order (DESIGN.md §4): { Ev.OWNER_ADD, id, name, color, kind, flags }. Values are part
-- of the network protocol, so never renumber them.
local Ev = {}

Ev.OWNER_ADD = 0 -- id, name, color, kind, flags
Ev.OWNER_OUT = 1 -- id, killer_id
Ev.PHASE = 2 -- phase, ticks_left
Ev.SPAWNED = 3 -- id, tile
Ev.STRUCT_ADD = 4 -- sid, kind, owner, tile
Ev.STRUCT_OWNER = 5 -- sid, new_owner
Ev.STRUCT_DEL = 6 -- sid
Ev.ROAD_ADD = 7 -- rid, sid_a, sid_b, tiles  (a railroad: its tile path from a's end to b's end)
Ev.ROAD_DEL = 8 -- rid (, sid_a, sid_b)
Ev.UNIT_ADD = 9 -- uid, kind, owner, path, start_tick, ticks_per_tile_x100, troops
Ev.UNIT_MOVE = 10 -- uid, tile
Ev.UNIT_DEL = 11 -- uid, reason
Ev.NUKE = 12 -- uid, kind, owner, from_tile, to_tile, launch_tick, flight_ticks
Ev.BOOM = 13 -- uid, kind, tile, radius_tiles, owner
Ev.ATTACK = 14 -- aid, attacker, target, troops, anchor_tile, retreating  (re-sent to update)
Ev.ATTACK_END = 15 -- aid
Ev.ALLY_REQ = 16 -- from, to, created_tick
Ev.ALLY = 17 -- a, b, expires_at
Ev.ALLY_END = 18 -- a, b, traitor_id, expired
Ev.MSG = 19 -- to_owner (-1 all), category, text
Ev.GAME_OVER = 20 -- winner_id, reason
Ev.ALLY_REQ_END = 21 -- from, to   (request answered or expired)
Ev.TRAITOR = 22 -- id, until_tick
Ev.STRUCT_LEVEL = 23 -- sid, level, active_tick  (upgrade, or construction start: active from active_tick)
Ev.SHELL = 24 -- shell_id, shooter_kind (0 warship, 1 defense post), shooter_id (uid / sid), from_tile, target_uid, fire_tick, impact_tick, damage
Ev.UNIT_HP = 25 -- uid, hp, max_hp  (at most once per unit per tick)
Ev.UNIT_VET = 26 -- uid, veterancy_level
Ev.UNIT_STATE = 27 -- uid, state (0 patrolling, 1 retreating, 2 docked / repairing), patrol_tile
Ev.UNIT_PATH = 28 -- uid, path, start_tick, ticks_per_tile_x100  (a warship changed course)
Ev.SAM_LAUNCH = 29 -- sam_sid, nuke_uid, fire_tick, intercept_tick, will_hit  (BOOM radius 0 follows at intercept_tick)
Ev.ALLY_EXT = 30 -- a, b, expires_at, asked  (renewal asked: bit 1 by min(a, b), bit 2 by max(a, b); a renewal resets it to 0)
Ev.CONQUEST = 31 -- conqueror, conquered, gold  (the gold `conqueror` took)
Ev.STRUCT_SHOTS = 32 -- sid, ticks  (SAM / silo: launch or upgrade ticks of its missiles still reloading
--   — each reloads for Rules.SAM / SILO_COOLDOWN_TICKS)

Ev.REINFORCE = 33 -- id, troops, ready_tick  (Reinforcements arrived; the next call is ready at ready_tick)

Ev.BONUS = 34 -- owner, tile, gold  (gold `owner` earned at `tile`, a train's
--   stop at a station. Only for a person, and sent to that person alone)

--- Number of event ids (ids are 0..COUNT-1).
Ev.COUNT = 35

return Ev
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">GameState</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/game_state.gd: client-side mirror of the match. Built from Sim.snapshot()
-- and kept current with Sim.step() deltas (locally in solo, via the network in multiplayer).
-- Views and UI read only this object.
--
-- Representation (see build/notes/READY-core-api for the full contract):
-- * owner: buffer of i32 per tile (buffer.readi32(state.owner, t * 4)); use state:tile_owner(t).
-- * flags: buffer of u8 per tile (bit0 = fallout); use state:has_fallout(t).
-- * owners / structures / roads / units / nukes / attacks / shells / sam_missiles: tables keyed by
--   id (iteration order is unspecified — sort when order matters). Info records are plain tables
--   with the GDScript member names (OwnerInfo.color is a Color3 in Roblox; OwnerInfo.rgba is the
--   RGBA8 int).
-- * alliances: key min(a,b)*1024+max(a,b) → true; requests: key from*1024+to → tick.
-- * Signals (Core/Signal): same names and argument order as the GDScript signals.
-- * The map: state.map (a WorldMap; flat W x H grid, no wrap), state.W / state.H / state.N, its
--   scaled rules in state.rules (Rules.for_map) and state.map_id. Positions are MAP SPACE: x right,
--   y down, in tiles (tile i covers [x, x+1) x [y, y+1), centre (x + 0.5, y + 0.5)); z is height
--   above the map (nuke arcs), 0 on the ground.
-- * Vector-returning helpers (tile_dir, unit_pose, nuke_pose) return Vector3s (Roblox or the Lune
--   prelude); *_xyz variants return plain numbers.
local Defs = require("./Defs")
local Ev = require("./Ev")
local Rules = require("./Rules")
local Signal = require("./Signal")
local WorldMap = require("./WorldMap")
local Coop = require("../Net/Coop")

local F_FALLOUT = Defs.F_FALLOUT

local GameState = {}
GameState.__index = GameState

local SIGNALS = {
	"snapshot_loaded",
	"cosmetics_changed", -- (ids: {number}) owners whose equipped skin / flag changed (set_cosmetics)
	"tiles_changed", -- (changed: {number}, olds: {number}) packed tile * 1024 + owner, new values; olds[k]: the owner changed[k]'s tile had (the list is reused: read it in the handler)
	"flags_changed", -- (changed: {number}) packed tile * 256 + flags
	"ticked", -- (tick)
	"stats_changed",
	"owner_added", -- (id)
	"owner_eliminated", -- (id, killer)
	"conquest", -- (conqueror, conquered, gold) Ev.CONQUEST: the gold the conqueror took
	"reinforced", -- (owner, troops, ready_tick) the Arsenal's Reinforcements arrived
	"bonus", -- (owner, tile, gold) Ev.BONUS: gold earned at a tile (a train's stop)
	"owner_spawned", -- (id, tile)
	"structure_added", -- (sid)
	"structure_changed", -- (sid, old_owner)
	"structure_removed", -- (sid)
	"structure_leveled", -- (sid) level or construction state changed (Ev.STRUCT_LEVEL)
	"road_added", -- (rid)
	"road_removed", -- (rid)
	"unit_added", -- (uid)
	"unit_moved", -- (uid)
	"unit_removed", -- (uid, reason)
	"unit_hp_changed", -- (uid)
	"unit_veterancy_changed", -- (uid)
	"unit_state_changed", -- (uid)
	"shell_fired", -- (id)
	"shell_impact", -- (id, hit)
	"sam_launched", -- (nuke_uid)
	"nuke_launched", -- (uid)
	"nuke_detonated", -- (uid, kind, tile, radius, owner)
	"attack_started", -- (aid)
	"attack_updated", -- (aid)
	"attack_ended", -- (aid)
	"alliance_requested", -- (from, to)
	"alliance_request_closed", -- (from, to)
	"alliance_changed", -- (a, b, formed, traitor, expired)
	"alliance_extension", -- (a, b, expires_at, asked) a renewal was asked for or granted (Ev.ALLY_EXT)
	"traitor_marked", -- (id, until_tick)
	"message", -- (to, category, text)
	"phase_changed", -- (phase, ticks_left)
	"game_over", -- (winner, reason)
}
GameState.SIGNAL_NAMES = SIGNALS

local function new_owner_info(id: number)
	return {
		id = id,
		name = "",
		rgba = 0xFFFFFFFF,
		color = Defs.color_from_int(0xFFFFFFFF),
		kind = Defs.KIND_NATION,
		--- team games (Core/Teams): 1..#team_names; 0 = none
		team = 0,
		alive = true,
		spawned = false,
		spawn_tile = -1,
		tiles = 0,
		troops = 0,
		gold = 0,
		max_troops = 0,
		income = 0, -- gold per second
		traitor_until = 0, -- tick
		killer = 0,
		-- sums of the owned tiles' x and y (territory centroid = (cx, cy) / tiles); cz unused (0)
		cx = 0.0,
		cy = 0.0,
		cz = 0.0,
		label_tile = -1,
	}
end
GameState.new_owner_info = new_owner_info

export type OwnerInfo = typeof(new_owner_info(0))
export type StructInfo = {
	sid: number,
	kind: number,
	owner: number,
	tile: number,
	level: number,
	active_tick: number,
	--- SAMs / silos: launch or upgrade ticks of missiles still reloading (Ev.STRUCT_SHOTS; entries
	--- older than the cooldown have reloaded)
	shots: { number }?,
}
--- A railroad: stations a and b (structure ids) and its tiles from a's end to b's end.
export type RoadInfo = { rid: number, a: number, b: number, tiles: { number } }
export type UnitInfo = {
	uid: number,
	kind: number,
	owner: number,
	path: { number },
	start_tick: number,
	ticks_per_tile_x100: number,
	troops: number,
	prev_tile: number,
	move_tick: number,
	hp: number,
	max_hp: number,
	veterancy: number,
	state: number,
	patrol_tile: number,
}
export type SamMissileInfo = {
	sam_sid: number,
	nuke_uid: number,
	fire_tick: number,
	intercept_tick: number,
	will_hit: boolean,
}
export type ShellInfo = {
	id: number,
	shooter_kind: number,
	shooter_id: number,
	from_tile: number,
	target_uid: number,
	fire_tick: number,
	impact_tick: number,
	damage: number,
}
export type NukeInfo = {
	uid: number,
	kind: number,
	owner: number,
	from_tile: number,
	to_tile: number,
	launch_tick: number,
	flight_ticks: number,
}
--- retreating: a retreat was ordered (the attack is frozen until its troops come home).
export type AttackInfo = {
	aid: number,
	attacker: number,
	target: number,
	troops: number,
	anchor_tile: number,
	retreating: boolean,
}

function GameState.new(world: any?)
	local self: any = setmetatable({}, GameState)
	for _, name in SIGNALS do
		self[name] = Signal.new()
	end
	local map = world or WorldMap.shared()
	self.map = map
	self.map_id = map.id
	Defs.set_view_map(map) -- deprecated UI shims follow the displayed map
	self.W = map.W
	self.H = map.H
	self.N = map.N
	--- The map's scaled rules (Rules.for_map): ranges / radii for this map.
	self.rules = Rules.for_map(map)
	self.tick = 0
	--- Smoothed fractional tick used for animation (set every frame by Session).
	self.render_tick = 0.0
	self.phase = Defs.PHASE_SPAWN
	self.phase_ticks_left = 0
	self.time_limit_ticks = 0
	--- Tick at which PLAYING began (-1 before that): from the snapshot or the PHASE event.
	self.playing_since = -1
	--- MIRVs launched this match (the next MIRV costs Rules.nuke_cost("mirv", mirvs_launched)).
	self.mirvs_launched = 0
	--- Shells in flight (Ev.SHELL), by shell id; removed at their impact tick (signal shell_impact).
	self.shells = {} :: { [number]: ShellInfo }
	--- SAM missiles in flight, by the uid of the nuke they chase; removed by that nuke's BOOM.
	self.sam_missiles = {} :: { [number]: SamMissileInfo }
	self._removed_now = {} :: { [number]: number }
	--- Per owner: {[slot] = count} (slot = Defs.S_* or Rules.BUILT_WARSHIP; 0-based) — how many
	--- were built, used by Rules.cost_of(). Read with built_count(id, slot).
	self.built = {} :: { [number]: { [number]: number } }
	self.winner = 0
	self.over_reason = -1
	--- Team games (Core/Teams): the team names (empty outside one) and the team that won (0: none).
	self.team_names = {} :: { string }
	self.winner_team = 0
	--- Owner id controlled by this client (0 = spectator / not yet joined).
	self.local_owner = 0
	self.loaded = false
	self.owner = buffer.create(map.N * 4)
	self.flags = buffer.create(map.N)
	--- Tiles currently irradiated (victory counts land that is not fallout; see Rules).
	self.fallout_count = 0
	self.owners = {} :: { [number]: OwnerInfo }
	self.structures = {} :: { [number]: StructInfo }
	self.roads = {} :: { [number]: RoadInfo }
	self.units = {} :: { [number]: UnitInfo }
	self.nukes = {} :: { [number]: NukeInfo }
	--- owner id -> the tick its next Reinforcements call is ready (Ev.REINFORCE; absent: now)
	self.reinforce_ready = {} :: { [number]: number }
	self.attacks = {} :: { [number]: AttackInfo }
	--- key = min(a,b) * 1024 + max(a,b)
	self.alliances = {} :: { [number]: boolean }
	--- key as alliances → tick at which the alliance expires (Rules.ALLIANCE_TICKS after it was
	--- formed or last renewed)
	self.alliance_expires = {} :: { [number]: number }
	--- key as alliances → renewal asked: bit 1 by min(a, b), bit 2 by max(a, b)
	self.alliance_ext = {} :: { [number]: number }
	self._ally_seq = {} :: { [number]: number } -- formation order (GDScript Dictionary order)
	self._seq = 0
	--- key = from * 1024 + to → tick the request was made
	self.requests = {} :: { [number]: number }
	--- key = from * 1024 + to → when the last request the mirror saw closed was made
	self._req_last = {} :: { [number]: number }
	--- owner id → { skin = id?, flag = id? } (Data/Cosmetics): outside the Sim — the match server
	--- sends it (OP.COSMETICS), a solo match sets the player's own
	self.cosmetics = {} :: { [number]: { skin: string?, flag: string?, face: number? } }
	return self
end

--- Replace the equipped cosmetics of the owners in `map` (owner id → {skin, flag, face}; an owner
--- mapped to false loses theirs). `face` is the player's Roblox user id (their head shot beside their
--- name). `full`: owners not in `map` lose theirs too. Fires cosmetics_changed.
function GameState.set_cosmetics(self: any, map: { [any]: any }, full: boolean?)
	local changed = {}
	local seen = {}
	for k, v in map do
		local id = tonumber(k)
		if id == nil or id <= 0 then
			continue
		end
		seen[id] = true
		local skin = if type(v) == "table" and type(v.skin) == "string" then v.skin else nil
		local flag = if type(v) == "table" and type(v.flag) == "string" then v.flag else nil
		local face = if type(v) == "table" and type(v.face) == "number" and v.face > 0 then v.face else nil
		local old = self.cosmetics[id]
		if skin == nil and flag == nil and face == nil then
			if old ~= nil then
				self.cosmetics[id] = nil
				table.insert(changed, id)
			end
		elseif old == nil or old.skin ~= skin or old.flag ~= flag or old.face ~= face then
			self.cosmetics[id] = { skin = skin, flag = flag, face = face }
			table.insert(changed, id)
		end
	end
	if full then
		for id in table.clone(self.cosmetics) do
			if not seen[id] then
				self.cosmetics[id] = nil
				table.insert(changed, id)
			end
		end
	end
	if #changed > 0 then
		self.cosmetics_changed:Fire(changed)
	end
end

export type GameState = typeof(GameState.new())

local function count_keys(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end
GameState.count_keys = count_keys

-- ---------------------------------------------------------------------------------------------
-- Queries
-- ---------------------------------------------------------------------------------------------

function GameState.get_owner(self: GameState, id: number): OwnerInfo?
	return self.owners[id]
end

function GameState.local_info(self: GameState): OwnerInfo?
	return self.owners[self.local_owner]
end

function GameState.owner_name(self: GameState, id: number): string
	if id == 0 then
		return "Unclaimed land"
	end
	local o = self.owners[id]
	return if o ~= nil then o.name else "Unknown"
end

local GREY = 0x999999FF -- Color(0.6, 0.6, 0.6)

--- Owner colour as a Color3 (grey for unknown owners).
function GameState.owner_color(self: GameState, id: number): any
	local o = self.owners[id]
	if o ~= nil then
		return o.color
	end
	return Defs.color_from_int(GREY)
end

--- Owner colour as an RGBA8 int.
function GameState.owner_rgba(self: GameState, id: number): number
	local o = self.owners[id]
	return if o ~= nil then o.rgba else GREY
end

--- Friendly: allies, and teammates in a team game (the Sim's `allied`).
function GameState.are_allies(self: GameState, a: number, b: number): boolean
	if a == 0 or b == 0 or a == b then
		return false
	end
	return self.alliances[math.min(a, b) * 1024 + math.max(a, b)] == true or self:same_team(a, b)
end

--- An alliance (not a team): what can be renewed or broken.
function GameState.has_alliance(self: GameState, a: number, b: number): boolean
	if a == 0 or b == 0 or a == b then
		return false
	end
	return self.alliances[math.min(a, b) * 1024 + math.max(a, b)] == true
end

-- ---------------------------------------------------------------------------------------------
-- Teams (team games; Core/Teams)
-- ---------------------------------------------------------------------------------------------

function GameState.is_team_game(self: GameState): boolean
	return #self.team_names > 0
end

--- `id`'s team (0: none).
function GameState.team_of(self: GameState, id: number): number
	local o = self.owners[id]
	return if o ~= nil then o.team or 0 else 0
end

function GameState.same_team(self: GameState, a: number, b: number): boolean
	local t = self:team_of(a)
	return a ~= b and t ~= 0 and t == self:team_of(b)
end

function GameState.team_name(self: GameState, t: number): string
	return self.team_names[t] or ""
end

--- The colour a team is shown in: its first member's.
function GameState.team_color(self: GameState, t: number): Color3
	local best = nil
	for id, o in self.owners do
		if o.team == t and (best == nil or id < best) then
			best = id
		end
	end
	return if best ~= nil then self.owners[best].color else Color3.new(0.6, 0.6, 0.6)
end

--- The teams by land: { {team, tiles, members (alive), alive} } sorted by tiles, most first.
function GameState.team_ranking(self: GameState): { { [string]: any } }
	local rows = {}
	for t = 1, #self.team_names do
		rows[t] = { team = t, tiles = 0, members = 0 }
	end
	for _, o in self.owners do
		local r = rows[o.team or 0]
		if r ~= nil and o.alive then
			r.tiles += o.tiles or 0
			r.members += 1
		end
	end
	local out = {}
	for t = 1, #self.team_names do
		table.insert(out, rows[t])
	end
	table.sort(out, function(a, b)
		if a.tiles ~= b.tiles then
			return a.tiles > b.tiles
		end
		return a.team < b.team
	end)
	return out
end

function GameState.has_request(self: GameState, from: number, to: number): boolean
	return self.requests[from * 1024 + to] ~= nil
end

--- Alliance info for `me` and ally `other`, or nil when not allied:
--- {expires_at, ticks_left, in_window (renewal may be asked: the last
--- Rules.ALLIANCE_EXTEND_WINDOW_TICKS), me_asked, other_asked, can_extend (in the window, both
--- alive, `me` has not asked yet)}. Send {type = "ally_extend", target = other} to ask.
function GameState.alliance_info(self: GameState, me: number, other: number): { [string]: any }?
	if not self:has_alliance(me, other) then
		return nil
	end
	local key = math.min(me, other) * 1024 + math.max(me, other)
	local expires = self.alliance_expires[key] or -1
	local bits = self.alliance_ext[key] or 0
	local mine = if me < other then 1 else 2
	local me_asked = bit32.band(bits, mine) ~= 0
	local other_asked = bit32.band(bits, 3 - mine) ~= 0
	local in_window = expires >= 0 and expires <= self.tick + Rules.ALLIANCE_EXTEND_WINDOW_TICKS
	local a, b = self.owners[me], self.owners[other]
	local alive = a ~= nil and a.alive and b ~= nil and b.alive
	return {
		expires_at = expires,
		ticks_left = math.max(0, expires - self.tick),
		in_window = in_window,
		me_asked = me_asked,
		other_asked = other_asked,
		can_extend = in_window and alive and not me_asked,
	}
end

--- Ticks until `from` may send `to` a new alliance request (the Sim's request cooldown is
--- counted from when the previous request was made; the mirror only knows requests it saw).
function GameState.request_cooldown_left(self: GameState, from: number, to: number): number
	local last = self._req_last[from * 1024 + to]
	if last == nil then
		return 0
	end
	return math.max(0, last + Rules.ALLY_REQUEST_COOLDOWN_TICKS - self.tick)
end

--- Allies of `id` (1-based array) in alliance formation order.
function GameState.allies_of(self: GameState, id: number): { number }
	local keys = {}
	for key in self.alliances do
		if key // 1024 == id or key % 1024 == id then
			table.insert(keys, key)
		end
	end
	local seq = self._ally_seq
	table.sort(keys, function(x, y)
		return (seq[x] or 0) < (seq[y] or 0)
	end)
	local out = {}
	for _, key in keys do
		local a = key // 1024
		table.insert(out, if a == id then key % 1024 else a)
	end
	return out
end

function GameState._set_alliance(self: GameState, a: number, b: number, on: boolean)
	local key = math.min(a, b) * 1024 + math.max(a, b)
	if on then
		if not self.alliances[key] then
			self._seq += 1
			self._ally_seq[key] = self._seq
		end
		self.alliances[key] = true
	else
		self.alliances[key] = nil
		self._ally_seq[key] = nil
		self.alliance_expires[key] = nil
		self.alliance_ext[key] = nil
	end
end

function GameState.is_traitor(self: GameState, id: number): boolean
	local o = self.owners[id]
	return o ~= nil and o.traitor_until > self.tick
end

--- Switches the mirror to another map (clears the grids; a snapshot must follow).
function GameState.set_map(self: GameState, map: any)
	self.map = map
	self.map_id = map.id
	Defs.set_view_map(map)
	self.W = map.W
	self.H = map.H
	self.N = map.N
	self.rules = Rules.for_map(map)
	self.owner = buffer.create(map.N * 4)
	self.flags = buffer.create(map.N)
	self.fallout_count = 0
end

--- Owner id of tile `i` (0 = unowned / out of range).
function GameState.tile_owner(self: GameState, i: number): number
	if i >= 0 and i < self.N then
		return buffer.readi32(self.owner, i * 4)
	end
	return 0
end
GameState.owner_of = GameState.tile_owner

function GameState.tile_flags(self: GameState, i: number): number
	if i >= 0 and i < self.N then
		return buffer.readu8(self.flags, i)
	end
	return 0
end

function GameState.has_fallout(self: GameState, i: number): boolean
	return i >= 0 and i < self.N and bit32.band(buffer.readu8(self.flags, i), F_FALLOUT) ~= 0
end

--- True when `id` owns a tile 4-adjacent to `i` (used for UI hints; the Sim validates for real).
function GameState.borders_tile(self: GameState, id: number, i: number): boolean
	local owner = self.owner
	local W = self.W
	local x = i % W
	if x > 0 and buffer.readi32(owner, (i - 1) * 4) == id then
		return true
	end
	if x < W - 1 and buffer.readi32(owner, (i + 1) * 4) == id then
		return true
	end
	if i >= W and buffer.readi32(owner, (i - W) * 4) == id then
		return true
	end
	if i < self.N - W and buffer.readi32(owner, (i + W) * 4) == id then
		return true
	end
	return false
end

--- Fraction (0..1) of contestable land held by `id`.
function GameState.land_share(self: GameState, id: number): number
	local o = self.owners[id]
	if o == nil or self.map.contestable_count <= 0 then
		return 0.0
	end
	return o.tiles / self.map.contestable_count
end

--- Alive owners holding land, sorted by territory, largest first (ties: lower id first).
function GameState.ranking(self: GameState): { OwnerInfo }
	local list = {}
	for _, o in self.owners do
		if o.alive and o.tiles > 0 then
			table.insert(list, o)
		end
	end
	table.sort(list, function(p, q)
		if p.tiles ~= q.tiles then
			return p.tiles > q.tiles
		end
		return p.id < q.id
	end)
	return list
end

--- Structures of `id` (of `kind`, or all kinds when kind < 0), sorted by sid.
function GameState.structures_of(self: GameState, id: number, kind: number?): { StructInfo }
	local k = kind or -1
	local out = {}
	for _, s in self.structures do
		if s.owner == id and (k < 0 or s.kind == k) then
			table.insert(out, s)
		end
	end
	table.sort(out, function(a, b)
		return a.sid < b.sid
	end)
	return out
end

function GameState.count_structures(self: GameState, id: number, kind: number): number
	local n = 0
	for _, s in self.structures do
		if s.owner == id and s.kind == kind then
			n += 1
		end
	end
	return n
end

--- Sum of the levels of `id`'s structures of `kind` (one under construction counts 1).
function GameState.struct_level_sum(self: GameState, id: number, kind: number): number
	local n = 0
	for _, s in self.structures do
		if s.owner == id and s.kind == kind then
			n += s.level
		end
	end
	return n
end

--- Structures (slot Defs.S_*) or warships (Rules.BUILT_WARSHIP) `id` has built or upgraded.
function GameState.built_count(self: GameState, id: number, slot: number): number
	local b = self.built[id]
	if b == nil then
		return 0
	end
	return b[slot] or 0
end

function GameState._count_built(self: GameState, id: number, slot: number, n: number?)
	local b = self.built[id]
	if b == nil then
		b = {}
		for k = 0, Rules.BUILT_SLOTS - 1 do
			b[k] = 0
		end
		self.built[id] = b
	end
	if slot >= 0 and slot < Rules.BUILT_SLOTS then
		b[slot] += n or 1
	end
end

function GameState.count_units(self: GameState, id: number, kind: number): number
	local n = 0
	for _, u in self.units do
		if u.owner == id and u.kind == kind then
			n += 1
		end
	end
	return n
end

--- Map-space centre of tile `i` as numbers: x + 0.5, y + 0.5, 0.
function GameState.tile_dir_xyz(self: any, i: number): (number, number, number)
	local W = self.W
	local x = i % W
	return x + 0.5, (i - x) // W + 0.5, 0.0
end
local tile_dir_xyz = GameState.tile_dir_xyz

--- Map-space centre of tile `i` (x, y in tiles) as two numbers.
function GameState.tile_xy(self: any, i: number): (number, number)
	local W = self.W
	local x = i % W
	return x + 0.5, (i - x) // W + 0.5
end

--- Map-space centre of tile `i` as a Vector3 (z = 0).
function GameState.tile_dir(self: any, i: number): Vector3
	local x, y, z = tile_dir_xyz(self, i)
	return Vector3.new(x, y, z)
end

-- Straight-line interpolation (map space), as numbers.
local function lerp_xyz(ax: number, ay: number, az: number, bx: number, by: number, bz: number, w: number)
	return ax + (bx - ax) * w, ay + (by - ay) * w, az + (bz - az) * w
end
GameState.lerp_xyz = lerp_xyz

local function normalize(x: number, y: number, z: number): (number, number, number)
	local l = math.sqrt(x * x + y * y + z * z)
	if l > 0 then
		return x / l, y / l, z / l
	end
	return 0, 0, 0
end

local function clamp01(v: number): number
	if v < 0 then
		return 0
	elseif v > 1 then
		return 1
	end
	return v
end

--- Map-space position of a moving unit at `at_tick` (fractional), plus its unit heading, as
--- numbers: px, py, pz (0), fx, fy, fz (0), progress (0..1).
function GameState.unit_pose_xyz(
	self: GameState,
	u: UnitInfo,
	at_tick: number
): (number, number, number, number, number, number, number)
	local path = u.path
	local n = #path
	if (u.kind == Defs.U_WARSHIP and u.prev_tile >= 0) or n < 2 then
		local cx, cy, cz = tile_dir_xyz(self, if n > 0 then path[1] else 0)
		if u.kind == Defs.U_WARSHIP and u.prev_tile >= 0 then
			local f = clamp01((at_tick - u.move_tick) / Defs.TICK_RATE)
			local ax, ay, az = tile_dir_xyz(self, u.prev_tile)
			local px, py, pz = lerp_xyz(ax, ay, az, cx, cy, cz, f)
			local dx, dy, dz = cx - ax, cy - ay, cz - az
			if dx * dx + dy * dy + dz * dz > 1e-12 then
				dx, dy, dz = normalize(dx, dy, dz)
			else
				dx, dy, dz = 0, 0, 0
			end
			return px, py, pz, dx, dy, dz, f
		end
		return cx, cy, cz, 0, 0, 0, 1.0
	end
	local tiles_done = math.max(0.0, (at_tick - u.start_tick) * 100.0 / math.max(u.ticks_per_tile_x100, 1))
	local last = n - 1
	local seg = math.min(Defs.trunc(tiles_done), last - 1)
	local frac = clamp01(tiles_done - seg)
	local ax, ay, az = tile_dir_xyz(self, path[seg + 1])
	local bx, by, bz = tile_dir_xyz(self, path[seg + 2])
	local px, py, pz = lerp_xyz(ax, ay, az, bx, by, bz, frac)
	local fx, fy, fz = normalize(bx - ax, by - ay, bz - az)
	return px, py, pz, fx, fy, fz, clamp01(tiles_done / last)
end

--- Map-space position (Vector3), forward (Vector3) and progress (0..1) of a moving unit at
--- `at_tick`. (GDScript returned [position, forward, progress].)
function GameState.unit_pose(self: GameState, u: UnitInfo, at_tick: number): (Vector3, Vector3, number)
	local px, py, pz, fx, fy, fz, p = self:unit_pose_xyz(u, at_tick)
	return Vector3.new(px, py, pz), Vector3.new(fx, fy, fz), p
end

--- Map-space ground position (x, y), height above the map (z, tiles: a parabola peaking at
--- 4 + 0.35 x the flight distance) and progress 0..1 of a nuke in flight.
function GameState.nuke_pose_xyz(self: GameState, n: NukeInfo, at_tick: number): (number, number, number, number)
	local t = clamp01((at_tick - n.launch_tick) / math.max(n.flight_ticks, 1))
	local ax, ay = self:tile_xy(n.from_tile)
	local bx, by = self:tile_xy(n.to_tile)
	local dx = bx - ax
	local dy = by - ay
	local height = 4.0 + math.sqrt(dx * dx + dy * dy) * 0.35
	return ax + dx * t, ay + dy * t, height * 4.0 * t * (1.0 - t), t
end

--- Map-space position (Vector3; z = height) and progress 0..1 of a nuke in flight.
function GameState.nuke_pose(self: GameState, n: NukeInfo, at_tick: number): (Vector3, number)
	local x, y, z, t = self:nuke_pose_xyz(n, at_tick)
	return Vector3.new(x, y, z), t
end

--- A tile inside `id`'s territory near its centre of mass; cached, refreshed on demand (-1 if none).
function GameState.label_tile(self: GameState, id: number): number
	local o = self.owners[id]
	if o == nil or o.tiles <= 0 then
		return -1
	end
	local owner = self.owner
	local W = self.W
	local H = self.H
	local guess = o.spawn_tile
	if o.tiles > 0 then
		local gx0 = math.clamp(math.floor(o.cx / o.tiles + 0.5), 0, W - 1)
		local gy0 = math.clamp(math.floor(o.cy / o.tiles + 0.5), 0, H - 1)
		guess = gy0 * W + gx0
	end
	if guess >= 0 and buffer.readi32(owner, guess * 4) == id then
		o.label_tile = guess
		return guess
	end
	if o.label_tile >= 0 and buffer.readi32(owner, o.label_tile * 4) == id then
		return o.label_tile
	end
	-- Spiral outward (bounded) from the guess.
	if guess >= 0 then
		local gx = guess % W
		local gy = guess // W
		for r = 1, 47 do
			for dx = -r, r do
				for k = 0, 1 do
					local yy = gy + (if k == 0 then -r else r)
					local xx = gx + dx
					if yy < 0 or yy >= H or xx < 0 or xx >= W then
						continue
					end
					local t = yy * W + xx
					if buffer.readi32(owner, t * 4) == id then
						o.label_tile = t
						return t
					end
				end
			end
			for dy = -r + 1, r - 1 do
				for k = 0, 1 do
					local yy2 = gy + dy
					local xx2 = gx + (if k == 0 then -r else r)
					if yy2 < 0 or yy2 >= H or xx2 < 0 or xx2 >= W then
						continue
					end
					local t2 = yy2 * W + xx2
					if buffer.readi32(owner, t2 * 4) == id then
						o.label_tile = t2
						return t2
					end
				end
			end
		end
	end
	o.label_tile = if o.spawn_tile >= 0 and buffer.readi32(owner, o.spawn_tile * 4) == id then o.spawn_tile else -1
	return o.label_tile
end

-- ---------------------------------------------------------------------------------------------
-- Snapshot / delta application
-- ---------------------------------------------------------------------------------------------

local function clear(t: { [any]: any })
	table.clear(t)
end

--- Loads a Sim.snapshot() table (see READY-core-api for its shape). Fires snapshot_loaded. A
--- snapshot of another map (snap.map_id) switches the mirror to that map (WorldMap.get: the map's
--- data must be available — clients fetch it with MapFetch first).
function GameState.load_snapshot(self: GameState, snap: { [string]: any })
	local mid = snap.map_id
	if type(mid) == "string" and mid ~= "" and mid ~= self.map_id then
		self:set_map(WorldMap.get(mid))
	end
	local N = self.N
	self.tick = snap.t or 0
	self.render_tick = self.tick
	self.phase = snap.phase or Defs.PHASE_SPAWN
	self.phase_ticks_left = snap.phase_left or 0
	self.time_limit_ticks = snap.time_limit_ticks or 0
	self.playing_since = snap.playing_since or -1
	self.mirvs_launched = snap.mirvs_launched or 0
	clear(self.built)
	for _, row in snap.built or {} do
		local b = {}
		for k = 0, Rules.BUILT_SLOTS - 1 do
			b[k] = row[k + 2] or 0
		end
		self.built[row[1]] = b
	end
	self.winner = snap.winner or 0
	self.over_reason = snap.over_reason or -1
	self.team_names = if type(snap.teams) == "table" then snap.teams else {}
	self.winner_team = tonumber(snap.winner_team) or 0
	clear(self.owners)
	clear(self.structures)
	clear(self.roads)
	clear(self.units)
	clear(self.nukes)
	clear(self.reinforce_ready)
	clear(self.shells)
	clear(self.sam_missiles)
	clear(self.attacks)
	clear(self.alliances)
	clear(self._ally_seq)
	clear(self.alliance_expires)
	clear(self.alliance_ext)
	clear(self.requests)
	clear(self._req_last)

	local grid = snap.owner
	if typeof(grid) == "buffer" and buffer.len(grid) == N * 4 then
		local b = buffer.create(N * 4)
		buffer.copy(b, 0, grid, 0, N * 4)
		self.owner = b
	else
		self.owner = buffer.create(N * 4)
	end
	local fl = snap.flags
	if typeof(fl) == "buffer" and buffer.len(fl) == N then
		local b = buffer.create(N)
		buffer.copy(b, 0, fl, 0, N)
		self.flags = b
	else
		self.flags = buffer.create(N)
	end
	local fc = 0
	local flags = self.flags
	for i = 0, N - 1 do
		if i % 65536 == 0 then
			Coop.check()
		end
		if buffer.readu8(flags, i) == F_FALLOUT then
			fc += 1
		end
	end
	self.fallout_count = fc

	for _, row in snap.owners or {} do
		local o = new_owner_info(row[1])
		o.name = tostring(row[2])
		o.rgba = row[3]
		o.color = Defs.color_from_int(row[3])
		o.kind = row[4]
		o.team = tonumber(row[5]) or 0
		o.alive = row[6] == true
		o.troops = row[8]
		o.gold = row[9]
		o.max_troops = row[10]
		o.income = row[11]
		o.traitor_until = row[12]
		o.spawn_tile = row[13]
		o.spawned = o.spawn_tile >= 0
		self.owners[o.id] = o
	end
	self:_recount_tiles()

	Coop.check()
	for _, row in snap.structs or {} do
		self:_add_struct(row[1], row[2], row[3], row[4])
		if #row >= 6 then
			local si = self.structures[row[1]]
			si.level = row[5]
			si.active_tick = row[6]
			if type(row[7]) == "table" then
				si.shots = row[7]
			end
		end
	end
	for _, row in snap.roads or {} do
		self:_add_road(row[1], row[2], row[3], row[4])
	end
	for _, row in snap.units or {} do
		self:_add_unit(row, 0)
	end
	for _, row in snap.nukes or {} do
		self:_add_nuke(row, 0)
	end
	for _, row in snap.shells or {} do
		self:_add_shell(row, 0)
	end
	for _, row in snap.sam_missiles or {} do
		self:_add_sam_missile(row, 0)
	end
	for _, row in snap.attacks or {} do
		self:_set_attack(row, 0)
	end
	for _, row in snap.allies or {} do
		self:_set_alliance(row[1], row[2], true)
		local key = math.min(row[1], row[2]) * 1024 + math.max(row[1], row[2])
		self.alliance_expires[key] = row[3]
		self.alliance_ext[key] = row[4] or 0
	end
	for _, row in snap.requests or {} do
		self.requests[row[1] * 1024 + row[2]] = row[3] or self.tick
	end
	self.loaded = true
	self.snapshot_loaded:Fire()
end

local HANDLERS: { [number]: (GameState, { any }) -> () } = {}

--- Applies one Sim.step() delta table {t, tiles, flags, stats?, ev}. Fires the signals.
function GameState.apply_delta(self: GameState, delta: { [string]: any })
	self.tick = delta.t or (self.tick + 1)
	local tiles = delta.tiles
	if tiles ~= nil and #tiles > 0 then
		self.tiles_changed:Fire(tiles, self:_apply_tiles(tiles))
	end
	local fl = delta.flags
	if fl ~= nil and #fl > 0 then
		local flags = self.flags
		local fc = self.fallout_count
		for _, v in fl do
			local fi = v // 256
			local was = bit32.band(buffer.readu8(flags, fi), F_FALLOUT) ~= 0
			buffer.writeu8(flags, fi, v % 256)
			local now = bit32.band(v, F_FALLOUT) ~= 0
			if was ~= now then
				fc += if now then 1 else -1
			end
		end
		self.fallout_count = fc
		self.flags_changed:Fire(fl)
	end
	local stats = delta.stats
	if stats ~= nil and #stats > 0 then
		self:_apply_stats(stats)
	end
	table.clear(self._removed_now)
	local evs = delta.ev
	if evs ~= nil then
		for _, e in evs do
			local h = HANDLERS[e[1]]
			if h ~= nil then
				h(self, e)
			end
		end
	end
	if next(self.shells) ~= nil then
		local landed = {}
		for id, sh in self.shells do
			if sh.impact_tick <= self.tick then
				table.insert(landed, id)
			end
		end
		if #landed > 0 then
			table.sort(landed)
			for _, id in landed do
				local sh = self.shells[id]
				self.shells[id] = nil
				local hit = sh.damage > 0
					and (self.units[sh.target_uid] ~= nil or self._removed_now[sh.target_uid] == Defs.DEL_DESTROYED)
				self.shell_impact:Fire(id, hit)
			end
		end
	end
	self.ticked:Fire(self.tick)
end

--- Applies one event array (e[1] = Ev id). Normally called by apply_delta.
function GameState._apply_event(self: GameState, e: { any })
	local h = HANDLERS[e[1]]
	if h ~= nil then
		h(self, e)
	end
end

--- Returns the owners the tiles had, in the order of `tiles` (one list, reused by the next call:
--- the map's surface repaints only the neighbours whose look depends on the old or the new owner).
function GameState._apply_tiles(self: GameState, tiles: { number }): { number }
	local owner = self.owner
	local owners = self.owners
	local W = self.W
	local olds = (self :: any)._tiles_old
	if olds == nil then
		olds = {}
		;(self :: any)._tiles_old = olds
	end
	for k = #tiles + 1, #olds do
		olds[k] = nil
	end
	for k, v in tiles do
		local i = v // 1024
		local nw = v % 1024
		local old = buffer.readi32(owner, i * 4)
		olds[k] = old
		if old == nw then
			continue
		end
		buffer.writei32(owner, i * 4, nw)
		local x = i % W
		local y = (i - x) // W
		local po = owners[old]
		if po ~= nil then
			po.tiles -= 1
			po.cx -= x
			po.cy -= y
		end
		local no = owners[nw]
		if no ~= nil then
			no.tiles += 1
			no.cx += x
			no.cy += y
		end
	end
	return olds
end

function GameState._apply_stats(self: GameState, stats: { number })
	local owners = self.owners
	local n = #stats // 6
	for k = 0, n - 1 do
		local b = k * 6
		local o = owners[stats[b + 1]]
		if o == nil then
			continue
		end
		o.troops = stats[b + 3]
		o.gold = stats[b + 4]
		o.max_troops = stats[b + 5]
		o.income = stats[b + 6]
	end
	self.stats_changed:Fire()
end

HANDLERS[Ev.OWNER_ADD] = function(self, e)
	-- Idempotent: a late joiner's snapshot may already contain this owner.
	local o = self.owners[e[2]]
	if o == nil then
		o = new_owner_info(e[2])
		self.owners[o.id] = o
	end
	o.name = tostring(e[3])
	o.rgba = e[4]
	o.color = Defs.color_from_int(e[4])
	o.kind = e[5]
	o.team = tonumber(e[6]) or 0
	o.alive = true -- a re-sent OWNER_ADD also revives an owner (join → leave → join)
	self.owner_added:Fire(o.id)
end

HANDLERS[Ev.OWNER_OUT] = function(self, e)
	local o = self.owners[e[2]]
	if o ~= nil then
		o.alive = false
		o.killer = e[3]
	end
	self.owner_eliminated:Fire(e[2], e[3])
end

HANDLERS[Ev.CONQUEST] = function(self, e)
	self.conquest:Fire(e[2], e[3], e[4])
end

HANDLERS[Ev.BONUS] = function(self, e)
	self.bonus:Fire(e[2], e[3], e[4])
end

--- The Arsenal's Reinforcements arrived for owner e[2]: when its next call is ready.
HANDLERS[Ev.REINFORCE] = function(self, e)
	self.reinforce_ready[e[2]] = e[4]
	self.reinforced:Fire(e[2], e[3], e[4])
end

HANDLERS[Ev.PHASE] = function(self, e)
	self.phase = e[2]
	if self.phase == Defs.PHASE_PLAYING and self.playing_since < 0 then
		self.playing_since = self.tick
	end
	self.phase_ticks_left = e[3]
	self.phase_changed:Fire(self.phase, self.phase_ticks_left)
end

HANDLERS[Ev.SPAWNED] = function(self, e)
	local o = self.owners[e[2]]
	if o ~= nil then
		o.spawned = true
		o.spawn_tile = e[3]
		o.label_tile = e[3]
	end
	self.owner_spawned:Fire(e[2], e[3])
end

HANDLERS[Ev.STRUCT_ADD] = function(self, e)
	self:_add_struct(e[2], e[3], e[4], e[5])
	self:_count_built(e[4], e[3])
	self.structure_added:Fire(e[2])
end

HANDLERS[Ev.STRUCT_LEVEL] = function(self, e)
	local sl = self.structures[e[2]]
	if sl ~= nil then
		if e[3] > sl.level then
			self:_count_built(sl.owner, sl.kind, e[3] - sl.level)
		end
		sl.level = e[3]
		sl.active_tick = e[4]
		self.structure_leveled:Fire(sl.sid)
	end
end

HANDLERS[Ev.STRUCT_SHOTS] = function(self, e)
	local s = self.structures[e[2]]
	if s ~= nil and type(e[3]) == "table" then
		s.shots = e[3]
		self.structure_leveled:Fire(s.sid) -- (views redraw its reload bar)
	end
end

HANDLERS[Ev.STRUCT_OWNER] = function(self, e)
	local s = self.structures[e[2]]
	if s ~= nil then
		local old_owner = s.owner
		s.owner = e[3]
		self.structure_changed:Fire(s.sid, old_owner)
	end
end

HANDLERS[Ev.STRUCT_DEL] = function(self, e)
	if self.structures[e[2]] ~= nil then
		self.structure_removed:Fire(e[2])
		self.structures[e[2]] = nil
	end
end

HANDLERS[Ev.ROAD_ADD] = function(self, e)
	self:_add_road(e[2], e[3], e[4], e[5])
	self.road_added:Fire(e[2])
end

HANDLERS[Ev.ROAD_DEL] = function(self, e)
	if self.roads[e[2]] ~= nil then
		self.road_removed:Fire(e[2])
		self.roads[e[2]] = nil
	end
end

HANDLERS[Ev.UNIT_ADD] = function(self, e)
	self:_add_unit(e, 1)
	if e[3] == Defs.U_WARSHIP then
		self:_count_built(e[4], Rules.BUILT_WARSHIP)
	end
	self.unit_added:Fire(e[2])
end

HANDLERS[Ev.UNIT_MOVE] = function(self, e)
	local u = self.units[e[2]]
	if u ~= nil then
		u.prev_tile = if #u.path > 0 then u.path[1] else e[3]
		u.path = { e[3] }
		u.move_tick = self.tick
		self.unit_moved:Fire(u.uid)
	end
end

HANDLERS[Ev.SHELL] = function(self, e)
	self:_add_shell(e, 1)
	self.shell_fired:Fire(e[2])
end

HANDLERS[Ev.SAM_LAUNCH] = function(self, e)
	self:_add_sam_missile(e, 1)
	self.sam_launched:Fire(e[3])
end

HANDLERS[Ev.UNIT_HP] = function(self, e)
	local u = self.units[e[2]]
	if u ~= nil then
		u.hp = e[3]
		u.max_hp = e[4]
		self.unit_hp_changed:Fire(u.uid)
	end
end

HANDLERS[Ev.UNIT_VET] = function(self, e)
	local u = self.units[e[2]]
	if u ~= nil then
		u.veterancy = e[3]
		self.unit_veterancy_changed:Fire(u.uid)
	end
end

HANDLERS[Ev.UNIT_STATE] = function(self, e)
	local u = self.units[e[2]]
	if u ~= nil then
		u.state = e[3]
		u.patrol_tile = e[4]
		self.unit_state_changed:Fire(u.uid)
	end
end

HANDLERS[Ev.UNIT_PATH] = function(self, e)
	local u = self.units[e[2]]
	if u ~= nil then
		u.path = table.clone(e[3])
		u.start_tick = e[4]
		u.ticks_per_tile_x100 = e[5]
		u.prev_tile = -1
		u.move_tick = u.start_tick
		self.unit_moved:Fire(u.uid)
	end
end

HANDLERS[Ev.UNIT_DEL] = function(self, e)
	self._removed_now[e[2]] = e[3]
	if self.units[e[2]] ~= nil then
		self.unit_removed:Fire(e[2], e[3])
		self.units[e[2]] = nil
	end
end

HANDLERS[Ev.NUKE] = function(self, e)
	if e[3] == Defs.N_MIRV then
		self.mirvs_launched += 1
	end
	self:_add_nuke(e, 1)
	self.nuke_launched:Fire(e[2])
end

HANDLERS[Ev.BOOM] = function(self, e)
	self.nuke_detonated:Fire(e[2], e[3], e[4], e[5], e[6])
	self.nukes[e[2]] = nil
	self.sam_missiles[e[2]] = nil
end

HANDLERS[Ev.ATTACK] = function(self, e)
	local existed = self.attacks[e[2]] ~= nil
	self:_set_attack(e, 1)
	if existed then
		self.attack_updated:Fire(e[2])
	else
		self.attack_started:Fire(e[2])
	end
end

HANDLERS[Ev.ATTACK_END] = function(self, e)
	if self.attacks[e[2]] ~= nil then
		self.attack_ended:Fire(e[2])
		self.attacks[e[2]] = nil
	end
end

HANDLERS[Ev.ALLY_REQ] = function(self, e)
	self.requests[e[2] * 1024 + e[3]] = e[4] or self.tick
	self.alliance_requested:Fire(e[2], e[3])
end

--- Drops request `k`, remembering when it was made (request_cooldown_left).
local function forget_request(self, k: number)
	local made = self.requests[k]
	if made ~= nil then
		self._req_last[k] = made
		self.requests[k] = nil
	end
end

HANDLERS[Ev.ALLY_REQ_END] = function(self, e)
	forget_request(self, e[2] * 1024 + e[3])
	self.alliance_request_closed:Fire(e[2], e[3])
end

HANDLERS[Ev.ALLY] = function(self, e)
	local a, b = e[2], e[3]
	self:_set_alliance(a, b, true)
	local key = math.min(a, b) * 1024 + math.max(a, b)
	self.alliance_expires[key] = e[4] or (self.tick + Rules.ALLIANCE_TICKS)
	self.alliance_ext[key] = 0
	forget_request(self, a * 1024 + b)
	forget_request(self, b * 1024 + a)
	self.alliance_changed:Fire(a, b, true, 0, false)
end

HANDLERS[Ev.ALLY_END] = function(self, e)
	local a, b = e[2], e[3]
	self:_set_alliance(a, b, false)
	self.alliance_changed:Fire(a, b, false, e[4], e[5] == true)
end

HANDLERS[Ev.ALLY_EXT] = function(self, e)
	local a, b = e[2], e[3]
	local key = math.min(a, b) * 1024 + math.max(a, b)
	if self.alliances[key] then
		self.alliance_expires[key] = e[4]
		self.alliance_ext[key] = e[5] or 0
	end
	self.alliance_extension:Fire(a, b, e[4], e[5] or 0)
end

HANDLERS[Ev.TRAITOR] = function(self, e)
	local o = self.owners[e[2]]
	if o ~= nil then
		o.traitor_until = e[3]
	end
	self.traitor_marked:Fire(e[2], e[3])
end

HANDLERS[Ev.MSG] = function(self, e)
	local to = e[2]
	if to == -1 or to == self.local_owner then
		self.message:Fire(to, e[3], tostring(e[4]))
	end
end

HANDLERS[Ev.GAME_OVER] = function(self, e)
	self.winner = e[2]
	self.over_reason = e[3]
	self.winner_team = tonumber(e[4]) or 0
	self.phase = Defs.PHASE_OVER
	self.game_over:Fire(self.winner, self.over_reason)
end

GameState.HANDLERS = HANDLERS

function GameState._add_struct(self: GameState, sid: number, kind: number, own: number, tile: number)
	self.structures[sid] = { sid = sid, kind = kind, owner = own, tile = tile, level = 1, active_tick = 0 }
end

function GameState._add_road(self: GameState, rid: number, a: number, b: number, tiles: { number }?)
	self.roads[rid] = { rid = rid, a = a, b = b, tiles = if type(tiles) == "table" then tiles else {} }
end

-- The _add_* helpers read their arguments from `args` starting at index o + 1 (o = 0 for
-- snapshot rows, 1 for event arrays whose first element is the Ev id).
function GameState._add_sam_missile(self: GameState, args: { any }, o: number)
	local m = {
		sam_sid = args[o + 1],
		nuke_uid = args[o + 2],
		fire_tick = args[o + 3],
		intercept_tick = args[o + 4],
		will_hit = args[o + 5] == true,
	}
	self.sam_missiles[m.nuke_uid] = m
end

function GameState._add_shell(self: GameState, args: { any }, o: number)
	local sh = {
		id = args[o + 1],
		shooter_kind = args[o + 2],
		shooter_id = args[o + 3],
		from_tile = args[o + 4],
		target_uid = args[o + 5],
		fire_tick = args[o + 6],
		impact_tick = args[o + 7],
		damage = args[o + 8],
	}
	self.shells[sh.id] = sh
end

function GameState._add_unit(self: GameState, args: { any }, o: number)
	local path = args[o + 4]
	local u: UnitInfo = {
		uid = args[o + 1],
		kind = args[o + 2],
		owner = args[o + 3],
		path = if path ~= nil then table.clone(path) else {},
		start_tick = args[o + 5],
		ticks_per_tile_x100 = args[o + 6],
		troops = args[o + 7],
		prev_tile = -1,
		move_tick = args[o + 5],
		hp = 0,
		max_hp = 0,
		veterancy = 0,
		state = 0,
		patrol_tile = -1,
	}
	if #args - o >= 12 then
		u.hp = args[o + 8]
		u.max_hp = args[o + 9]
		u.veterancy = args[o + 10]
		u.state = args[o + 11]
		u.patrol_tile = args[o + 12]
	end
	self.units[u.uid] = u
end

function GameState._add_nuke(self: GameState, args: { any }, o: number)
	local n = {
		uid = args[o + 1],
		kind = args[o + 2],
		owner = args[o + 3],
		from_tile = args[o + 4],
		to_tile = args[o + 5],
		launch_tick = args[o + 6],
		flight_ticks = args[o + 7],
	}
	self.nukes[n.uid] = n
end

function GameState._set_attack(self: GameState, args: { any }, o: number)
	local aid = args[o + 1]
	local at = self.attacks[aid]
	if at == nil then
		at = { aid = aid, attacker = 0, target = 0, troops = 0, anchor_tile = -1, retreating = false }
		self.attacks[aid] = at
	end
	at.attacker = args[o + 2]
	at.target = args[o + 3]
	at.troops = args[o + 4]
	at.anchor_tile = args[o + 5]
	at.retreating = args[o + 6] == true
end

function GameState._recount_tiles(self: GameState)
	local owners = self.owners
	for _, o in owners do
		o.tiles = 0
		o.cx = 0.0
		o.cy = 0.0
		o.cz = 0.0
	end
	local owner = self.owner
	local W = self.W
	for i = 0, self.N - 1 do
		if i % 32768 == 0 then
			Coop.check()
		end
		local id = buffer.readi32(owner, i * 4)
		if id == 0 then
			continue
		end
		local o = owners[id]
		if o ~= nil then
			o.tiles += 1
			local x = i % W
			o.cx += x
			o.cy += (i - x) // W
		end
	end
end

--- Encodes an owner grid for snapshots: a copy of the i32 buffer (Sim.snapshot() uses this).
function GameState.encode_grid(grid: buffer): buffer
	local b = buffer.create(buffer.len(grid))
	buffer.copy(b, 0, grid, 0, buffer.len(grid))
	return b
end

return GameState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">GodotRng</string>
            <string name="Source"><![CDATA[--!native
-- sim-parity: bit-exact emulation of Godot 4's RandomNumberGenerator (RandomPCG = PCG32
-- XSH-RR, default increment, Godot's randf / randi_range / randf_range algorithms) and of
-- GDScript's hash(int). This is the PRODUCTION generator (Rng.new returns it): the port consumes
-- exactly the random numbers the original does for the same seed, so every seed plays out tick for
-- tick like the Godot game (verified by tests/parity_lockstep.luau against recorded traces).
--
-- 64-bit state is kept as two uint32 halves (hi, lo) in doubles.
local GodotRng = {}
GodotRng.__index = GodotRng

local band = bit32.band
local bor = bit32.bor
local bxor = bit32.bxor
local lshift = bit32.lshift
local rshift = bit32.rshift
local rrotate = bit32.rrotate
local countlz = bit32.countlz

local TWO32 = 4294967296
local TWO16 = 65536

-- low 32 bits of a (uint32) * b (uint32)
local function imul(a: number, b: number): number
	local lo = band(b, 0xFFFF)
	local hi = rshift(b, 16)
	return band(a * lo + band(a * hi, 0xFFFF) * 65536, 0xFFFFFFFF)
end

-- full 64-bit product of two uint32 → hi, lo
local function mul32x32(a: number, b: number): (number, number)
	local a0 = band(a, 0xFFFF)
	local a1 = rshift(a, 16)
	local b0 = band(b, 0xFFFF)
	local b1 = rshift(b, 16)
	local p0 = a0 * b0
	local mid = a1 * b0 + a0 * b1
	local p2 = a1 * b1
	local midlo = mid % TWO16
	local midhi = (mid - midlo) / TWO16
	local t = p0 + midlo * TWO16
	local lo = t % TWO32
	local carry = (t - lo) / TWO32
	local hi = (p2 + midhi + carry) % TWO32
	return hi, lo
end

-- (ahi,alo) * (bhi,blo) mod 2^64
local function mul64(ahi: number, alo: number, bhi: number, blo: number): (number, number)
	local hi, lo = mul32x32(alo, blo)
	hi = (hi + imul(ahi, blo) + imul(alo, bhi)) % TWO32
	return hi, lo
end

local function add64(ahi: number, alo: number, bhi: number, blo: number): (number, number)
	local lo = alo + blo
	local carry = 0
	if lo >= TWO32 then
		lo -= TWO32
		carry = 1
	end
	return (ahi + bhi + carry) % TWO32, lo
end

-- PCG32 multiplier 6364136223846793005 = 0x5851F42D_4C957F2D
local MHI, MLO = 0x5851F42D, 0x4C957F2D
-- PCG_DEFAULT_INC_64 = 1442695040888963407 = 0x14057B7E_F767814F
local DINC_HI, DINC_LO = 0x14057B7E, 0xF767814F

--- int64 (as a Luau number, |x| < 2^53) → hi, lo (two's complement)
local function split64(x: number): (number, number)
	if x >= 0 then
		local lo = x % TWO32
		return ((x - lo) / TWO32) % TWO32, lo
	end
	-- two's complement of |x|
	local ax = -x
	local lo = ax % TWO32
	local hi = ((ax - lo) / TWO32) % TWO32
	-- ~(hi,lo) + 1
	hi = TWO32 - 1 - hi
	lo = TWO32 - 1 - lo
	return add64(hi, lo, 0, 1)
end

local function shl64(hi: number, lo: number, n: number): (number, number)
	if n >= 32 then
		return lshift(lo, n - 32), 0
	end
	return bor(lshift(hi, n), rshift(lo, 32 - n)), lshift(lo, n)
end

local function shr64(hi: number, lo: number, n: number): (number, number)
	if n >= 32 then
		return 0, rshift(hi, n - 32)
	end
	return rshift(hi, n), bor(rshift(lo, n), lshift(hi, 32 - n))
end

--- GDScript hash(int): Variant::hash() → hash_one_uint64 (Thomas Wang 64→32).
function GodotRng.hash_int(x: number): number
	local hi, lo = split64(x)
	-- v = (~v) + (v << 18)
	local shi, slo = shl64(hi, lo, 18)
	hi, lo = add64(TWO32 - 1 - hi, TWO32 - 1 - lo, shi, slo)
	-- v = v ^ (v >> 31)
	shi, slo = shr64(hi, lo, 31)
	hi, lo = bxor(hi, shi), bxor(lo, slo)
	-- v = v * 21
	hi, lo = mul64(hi, lo, 0, 21)
	-- v = v ^ (v >> 11)
	shi, slo = shr64(hi, lo, 11)
	hi, lo = bxor(hi, shi), bxor(lo, slo)
	-- v = v + (v << 6)
	shi, slo = shl64(hi, lo, 6)
	hi, lo = add64(hi, lo, shi, slo)
	-- v = v ^ (v >> 22)
	shi, slo = shr64(hi, lo, 22)
	hi, lo = bxor(hi, shi), bxor(lo, slo)
	return lo
end

export type GodotRng = typeof(setmetatable(
	{} :: { seed: number, shi: number, slo: number, ihi: number, ilo: number, calls: number },
	GodotRng
))

--- A generator seeded like `rng.seed = hash(seed)` (pass raw = true to seed with `seed` directly).
function GodotRng.new(seed: number?, raw: boolean?): GodotRng
	local self = setmetatable({ seed = 0, shi = 0, slo = 0, ihi = 0, ilo = 0, calls = 0 }, GodotRng)
	local s = seed or 0
	if not raw then
		s = GodotRng.hash_int(s)
	end
	self:set_seed(s)
	return self
end

-- pcg32_random_r
local function step(self: GodotRng): number
	local ohi, olo = self.shi, self.slo
	local hi, lo = mul64(ohi, olo, MHI, MLO)
	self.shi, self.slo = add64(hi, lo, self.ihi, self.ilo)
	-- xorshifted = ((old >> 18) ^ old) >> 27 ; rot = old >> 59
	local s18hi, s18lo = shr64(ohi, olo, 18)
	local xhi, xlo = bxor(ohi, s18hi), bxor(olo, s18lo)
	local xs = bor(rshift(xlo, 27), lshift(xhi, 5))
	local rot = rshift(ohi, 27)
	return rrotate(xs, rot)
end

--- RandomPCG::seed(p_seed): pcg32_srandom_r(&pcg, p_seed, PCG_DEFAULT_INC_64).
function GodotRng.set_seed(self: GodotRng, seed: number)
	self.seed = seed
	local ihi, ilo = shl64(DINC_HI, DINC_LO, 1)
	self.ihi, self.ilo = ihi, bor(ilo, 1)
	self.shi, self.slo = 0, 0
	step(self)
	local sh, sl = split64(seed)
	self.shi, self.slo = add64(self.shi, self.slo, sh, sl)
	step(self)
end

--- The 64-bit PCG state as a signed int64 decimal string (RandomNumberGenerator.state).
function GodotRng.state_string(self: GodotRng): string
	local hi, lo = self.shi, self.slo
	local neg = hi >= 0x80000000
	if neg then
		hi, lo = add64(TWO32 - 1 - hi, TWO32 - 1 - lo, 0, 1)
	end
	-- decimal of hi*2^32+lo without losing precision: long division by 10^6 in base 2^32
	local digits = {}
	local h, l = hi, lo
	while h > 0 or l > 0 do
		-- (h*2^32 + l) / 1e6
		local qh = h // 1000000
		local rh = h % 1000000
		local cur = rh * TWO32 + l -- < 1e6 * 2^32 < 2^53
		local ql = cur // 1000000
		local r = cur % 1000000
		h, l = qh + ql // TWO32, ql % TWO32
		table.insert(digits, 1, string.format(if h > 0 or l > 0 then "%06d" else "%d", r))
	end
	local s = if #digits == 0 then "0" else table.concat(digits)
	return if neg then "-" .. s else s
end

--- A cheap state fingerprint (low 32 bits of the state).
function GodotRng.state_lo(self: GodotRng): number
	return self.slo
end

--- RandomNumberGenerator.randi(): uint32.
function GodotRng.randi(self: GodotRng): number
	self.calls += 1
	return step(self)
end

-- pcg32_boundedrand_r
local function bounded(self: GodotRng, bound: number): number
	local threshold = (TWO32 - bound) % bound
	while true do
		local r = step(self)
		if r >= threshold then
			return r % bound
		end
	end
end

local f32buf = buffer.create(4)
local function f32(x: number): number
	buffer.writef32(f32buf, 0, x)
	return buffer.readf32(f32buf, 0)
end
GodotRng.f32 = f32

--- RandomPCG::randf() (float): [0, 1] with Godot's exponent trick; a float32 value.
function GodotRng.randf(self: GodotRng): number
	self.calls += 1
	local proto = step(self)
	if proto == 0 then
		return 0.0
	end
	local significand = bor(step(self), 0x80000001)
	-- (float)significand rounds to nearest even; ldexp by a power of two is exact
	return f32(significand) * 2 ^ (-32 - countlz(proto))
end

--- RandomPCG::random(int from, int to): inclusive, unbiased.
function GodotRng.randi_range(self: GodotRng, from: number, to: number): number
	if from == to then
		return from
	end
	self.calls += 1
	local lo = if from < to then from else to
	local bound = math.abs(from - to) + 1
	return bounded(self, bound % TWO32) + lo
end

--- RandomPCG::random(float from, float to) = randf() * (to - from) + from, in float32.
--- FUSED selects fused multiply-add (clang contracts a*b+c on arm64) vs two roundings.
GodotRng.FUSED = false
function GodotRng.randf_range(self: GodotRng, from: number, to: number): number
	local r = self:randf()
	local a = f32(from)
	local b = f32(to)
	local d = f32(b - a)
	if GodotRng.FUSED then
		-- r * d is exact in double (24 x 24-bit mantissas); one rounding of the sum ~ fma
		return f32(r * d + a)
	end
	return f32(f32(r * d) + a)
end

return GodotRng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">MapCodec</string>
            <string name="Source"><![CDATA[--!native
-- Decoding of map terrain blobs (tools/maps/import_maps.py writes base64(zstd(tile bytes))).
-- zstd comes from EncodingService in Roblox and from @lune/serde under Lune (tests, tools); other
-- hosts can plug a decompressor with MapCodec.set_zstd. Base64 is portable Luau (EncodingService's
-- Base64Decode is used when the engine has it).
local MapCodec = {}

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local DEC = buffer.create(256)
for i = 1, 64 do
	buffer.writeu8(DEC, string.byte(B64, i), i - 1)
end

--- Portable base64 → buffer.
function MapCodec.b64decode_luau(s: string): buffer
	local n = #s
	local pad = 0
	if n > 0 and string.byte(s, n) == 61 then
		pad += 1
	end
	if n > 1 and string.byte(s, n - 1) == 61 then
		pad += 1
	end
	local len = n // 4 * 3 - pad
	local out = buffer.create(len)
	local src = buffer.fromstring(s)
	local readu8 = buffer.readu8
	local o = 0
	local full = (n // 4) - (if pad > 0 then 1 else 0)
	for q = 0, full - 1 do
		local i = q * 4
		local v = readu8(DEC, readu8(src, i)) * 262144
			+ readu8(DEC, readu8(src, i + 1)) * 4096
			+ readu8(DEC, readu8(src, i + 2)) * 64
			+ readu8(DEC, readu8(src, i + 3))
		buffer.writeu8(out, o, v // 65536)
		buffer.writeu8(out, o + 1, (v // 256) % 256)
		buffer.writeu8(out, o + 2, v % 256)
		o += 3
	end
	if pad > 0 then
		local i = full * 4
		local a = readu8(DEC, readu8(src, i))
		local b = readu8(DEC, readu8(src, i + 1))
		local c = if pad == 1 then readu8(DEC, readu8(src, i + 2)) else 0
		local v = a * 262144 + b * 4096 + c * 64
		buffer.writeu8(out, o, v // 65536)
		if pad == 1 then
			buffer.writeu8(out, o + 1, (v // 256) % 256)
		end
	end
	return out
end

type Zstd = (buffer) -> buffer
local zstd: Zstd? = nil
local b64: ((string) -> buffer)? = nil

do
	local ok, es = pcall(function()
		return (game :: any):GetService("EncodingService")
	end)
	if ok and es ~= nil then
		local algo = (Enum :: any).CompressionAlgorithm.Zstd
		local ok_z = pcall(function()
			local z = es:CompressBuffer(buffer.fromstring("rofront"), algo, 3)
			assert(buffer.tostring(es:DecompressBuffer(z, algo)) == "rofront", "zstd round trip")
		end)
		if ok_z then
			zstd = function(b: buffer): buffer
				return es:DecompressBuffer(b, algo)
			end
		end
		local ok_b = pcall(function()
			assert(buffer.tostring(es:Base64Decode(buffer.fromstring("cm9mcm9udA=="))) == "rofront", "base64")
		end)
		if ok_b then
			b64 = function(s: string): buffer
				return es:Base64Decode(buffer.fromstring(s))
			end
		end
	elseif (script :: any) == nil then
		-- Lune (tests / tools)
		local ok_s, serde = pcall(require, "@lune/serde")
		if ok_s and serde ~= nil then
			zstd = function(b: buffer): buffer
				return buffer.fromstring((serde :: any).decompress("zstd", buffer.tostring(b)))
			end
		end
	end
end

--- Plug a zstd decompressor (buffer → buffer); nil disables.
function MapCodec.set_zstd(fn: Zstd?)
	zstd = fn
end

function MapCodec.has_zstd(): boolean
	return zstd ~= nil
end

function MapCodec.b64decode(s: string): buffer
	if b64 ~= nil then
		return (b64 :: any)(s)
	end
	return MapCodec.b64decode_luau(s)
end

function MapCodec.zstd_decompress(b: buffer): buffer
	local z = zstd
	if z == nil then
		error("MapCodec: no zstd decompressor available (EncodingService / @lune/serde)")
	end
	return z(b)
end

--- RLE pairs store (run length minus one, tile byte).
local function rle_decode(src: buffer, size: number): buffer
	local len = buffer.len(src)
	assert(len % 2 == 0, "MapCodec: incomplete terrain run")
	local out = buffer.create(size)
	local at = 0
	for i = 0, len - 2, 2 do
		local count = buffer.readu8(src, i) + 1
		assert(at + count <= size, "MapCodec: terrain run exceeds map size")
		buffer.fill(out, at, buffer.readu8(src, i + 1), count)
		at += count
	end
	assert(at == size, "MapCodec: terrain run data ended early")
	return out
end

--- Tile bytes of a map data table: `terrain` is either a buffer (raw bytes, or zstd bytes when
--- `codec` is "zstd" — what MapFetch downloads) or a string in `codec` ("zstd+base64", default).
--- Checks the size.
function MapCodec.terrain_bytes(data: { [string]: any }): buffer
	local t = data.terrain
	local size = data.size or (data.width * data.height)
	local out: buffer
	if typeof(t) == "buffer" then
		out = if data.codec == "zstd" then MapCodec.zstd_decompress(t)
			elseif data.codec == "rle" then rle_decode(t, size)
			else t
	elseif type(t) == "string" then
		local codec = data.codec or "zstd+base64"
		if codec == "zstd+base64" then
			out = MapCodec.zstd_decompress(MapCodec.b64decode(t))
		elseif codec == "rle+base64" then
			out = rle_decode(MapCodec.b64decode_luau(t), size)
		elseif codec == "zstd" then
			out = MapCodec.zstd_decompress(buffer.fromstring(t))
		elseif codec == "raw" then
			out = buffer.fromstring(t)
		else
			error("MapCodec: unknown codec " .. tostring(codec))
		end
	else
		error("MapCodec: map data has no terrain")
	end
	if buffer.len(out) ~= size then
		error(string.format("MapCodec: terrain is %d bytes, expected %d", buffer.len(out), size))
	end
	return out
end

return MapCodec
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">NumberFormat</string>
            <string name="Source"><![CDATA[--!strict
-- Number display (render_number / render_troops):
-- values are floored, never rounded ("2.45K", "123K", "1.25M"), negatives show as 0, and troops are
-- shown as the internal count / 10 (a 25,000-troop start reads "2.50K").
local NumberFormat = {}

--- `v` with d decimals (already floored to d decimals).
local function fixed(v: number, d: number): string
	return string.format("%." .. d .. "f", v)
end

function NumberFormat.render_number(num: number): string
	if num ~= num then
		num = 0
	end
	num = math.max(num, 0)
	if num >= 10_000_000_000 then
		return fixed(math.floor(num / 100000000) / 10, 1) .. "B"
	elseif num >= 1_000_000_000 then
		return fixed(math.floor(num / 10000000) / 100, 2) .. "B"
	elseif num >= 10_000_000 then
		return fixed(math.floor(num / 100000) / 10, 1) .. "M"
	elseif num >= 1_000_000 then
		return fixed(math.floor(num / 10000) / 100, 2) .. "M"
	elseif num >= 100000 then
		return tostring(math.floor(num / 1000)) .. "K"
	elseif num >= 10000 then
		return fixed(math.floor(num / 100) / 10, 1) .. "K"
	elseif num >= 1000 then
		return fixed(math.floor(num / 10) / 100, 2) .. "K"
	end
	return tostring(math.floor(num))
end

--- render_troops: the internal troop count / 10.
function NumberFormat.render_troops(troops: number): string
	return NumberFormat.render_number(troops / 10)
end

return NumberFormat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Rng</string>
            <string name="Source"><![CDATA[--!native
--!strict
-- Deterministic pseudo-random generator with the subset of Godot's RandomNumberGenerator API the
-- port uses: Rng.new(seed), rng.seed, rng:set_seed(s), rng:randi() (uint32 0..2^32-1),
-- rng:randf() ([0, 1)), rng:randi_range(a, b) (inclusive), rng:randf_range(a, b).
-- Pure Luau (bit32); xoshiro128** seeded through splitmix32. Bit-exact parity with Godot's PCG32 is
-- not a goal (behavioural parity is): same seed → same sequence on every Luau VM.
local Rng = {}
Rng.__index = Rng

export type Rng = typeof(setmetatable({} :: { seed: number, s0: number, s1: number, s2: number, s3: number }, Rng))

local band = bit32.band
local bxor = bit32.bxor
local lshift = bit32.lshift
local rshift = bit32.rshift
local lrotate = bit32.lrotate

local TWO32 = 4294967296

-- 32 x 32 → low 32 bits multiply (exact in doubles by splitting b into 16-bit halves).
local function imul(a: number, b: number): number
	local lo = band(b, 0xFFFF)
	local hi = rshift(b, 16)
	return band(a * lo + band(a * hi, 0xFFFF) * 65536, 0xFFFFFFFF)
end

local function splitmix32(x: number): (number, number)
	x = band(x + 0x9E3779B9, 0xFFFFFFFF)
	local z = x
	z = imul(bxor(z, rshift(z, 16)), 0x85EBCA6B)
	z = imul(bxor(z, rshift(z, 13)), 0xC2B2AE35)
	z = bxor(z, rshift(z, 16))
	return x, z
end

function Rng.new(seed: number?): Rng
	local self = setmetatable({ seed = 0, s0 = 0, s1 = 0, s2 = 0, s3 = 0 }, Rng)
	self:set_seed(seed or 0)
	return self
end

--- Resets the state from an integer seed (any sign / magnitude up to 2^53).
function Rng.set_seed(self: Rng, seed: number)
	self.seed = seed
	local lo = seed % TWO32
	local hi = ((seed - lo) / TWO32) % TWO32
	local x = band(bxor(lo, imul(hi, 0x27D4EB2F)), 0xFFFFFFFF)
	local z
	x, z = splitmix32(x)
	self.s0 = z
	x, z = splitmix32(x)
	self.s1 = z
	x, z = splitmix32(x)
	self.s2 = z
	x, z = splitmix32(x)
	self.s3 = z
	if self.s0 == 0 and self.s1 == 0 and self.s2 == 0 and self.s3 == 0 then
		self.s0 = 1
	end
end

--- Uniform uint32 (0 .. 4294967295), like RandomNumberGenerator.randi().
function Rng.randi(self: Rng): number
	local s0, s1, s2, s3 = self.s0, self.s1, self.s2, self.s3
	local result = band(lrotate(band(s1 * 5, 0xFFFFFFFF), 7) * 9, 0xFFFFFFFF)
	local t = lshift(s1, 9)
	s2 = bxor(s2, s0)
	s3 = bxor(s3, s1)
	s1 = bxor(s1, s2)
	s0 = bxor(s0, s3)
	s2 = bxor(s2, t)
	s3 = lrotate(s3, 11)
	self.s0, self.s1, self.s2, self.s3 = s0, s1, s2, s3
	return result
end

--- Uniform float in [0, 1).
function Rng.randf(self: Rng): number
	return self:randi() / TWO32
end

--- Uniform integer in [from, to] (either order), like randi_range.
function Rng.randi_range(self: Rng, from: number, to: number): number
	if from == to then
		return from
	end
	local lo = if from < to then from else to
	local hi = if from < to then to else from
	return lo + self:randi() % (hi - lo + 1)
end

--- Uniform float in [from, to), like randf_range.
function Rng.randf_range(self: Rng, from: number, to: number): number
	return self:randf() * (to - from) + from
end

-- Production: Godot's exact RandomNumberGenerator (PCG32), seeded like sim.gd's
-- `rng.seed = hash(int(seed))`, so a seed plays out exactly as in the original. The xoshiro
-- implementation above stays available as Rng.xoshiro(seed) for tools that want it.
local GodotRng = require("./GodotRng")
Rng.xoshiro = Rng.new
Rng.new = function(seed: number?): any
	return GodotRng.new(seed or 0)
end

return Rng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Rules</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/rules.gd: every balance number and formula of the simulation. Numbers are
-- stated in full-size-tile units and scaled to the map's own tiles (see the map-scale conversion
-- below). The Sim charges exactly
-- what these functions return, so the UI and renderer may call them for costs, caps, incomes and
-- ranges.
--
-- Map-scale conversion: one of our tiles is K_LIN full-resolution full-size tiles across (per map:
-- map.k_lin, 1.0 unless the importer resampled the map to its tile budget, see WorldMap).
--   * a tile COUNT fed to a formula is multiplied by K_AREA (our tile is K_AREA full-size tiles);
--   * a full-size DISTANCE (ranges, radii, speeds in tiles/tick) is divided by K_LIN to get our tiles;
--   * an attack border length is multiplied by K_LIN;
--   * conquering one of our tiles costs K_AREA full-size tiles worth of troops and attack time, so the
--     same land AREA falls per second on every map. Time is never scaled (10 ticks/s).
-- Economy numbers are per player, not per tile, and are used unscaled. With K_LIN = 1 every number
-- is used as written.
--
-- Per-map rules: this module is the K_LIN = 1 table; Rules.for_map(map) / Rules.for_k(k_lin) return
-- the (cached) table built for another scale — same API, scaled constants. The Sim keeps its map's
-- table in `sim.R`; GameState in `state.rules`.
-- Geometry comes from the map (flat grid and its metrics): place_site takes the map,
-- near_structures / warship_port / placement read state.map.
-- Units: troops and gold are plain numbers (format with Defs.format_troops); time in ticks.
--
-- Luau conventions: tables indexed by an enum (BUILD_TICKS[Defs.S_CITY], ATTACK_MAG[terrain code],
-- NUKE_*[Defs.N_*], NATION_*[difficulty]) are keyed by the enum value (0-based). Functions that
-- returned a Vector2 return two numbers (nuke_radii → inner, outer). PackedFloat32Array constants
-- are rounded to float32 like the Godot version.
local Defs = require("./Defs")

local f32 = Defs.f32
local function f32t(values: { number }): { [number]: number }
	local out = {}
	for i, v in ipairs(values) do
		out[i - 1] = f32(v)
	end
	return out
end
local function zt(values: { any }): { [number]: any }
	local out = {}
	for i, v in ipairs(values) do
		out[i - 1] = v
	end
	return out
end

local function clampi(v: number, lo: number, hi: number): number
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

local trunc = Defs.trunc

--- Builds the rules table for maps whose tiles are `K_LIN` full-size tiles across.
local function build(K_LIN: number): any
	local Rules: any = {}
	Rules.TICK_RATE = 10
	--- Full-size tiles per one of our tiles, linear and by area (the map's k_lin).
	Rules.K_LIN = K_LIN
	Rules.K_AREA = K_LIN * K_LIN
	local K_AREA = Rules.K_AREA
	--- Our tiles per tile of the original 1024 x 512 Earth grid (2000 / 1024 full-size tiles), where the
	--- AI heuristics were tuned: distances in those tiles scale by
	--- LEGACY_LIN, tile counts by LEGACY_AREA.
	Rules.LEGACY_LIN = (2000.0 / 1024.0) / K_LIN
	Rules.LEGACY_AREA = Rules.LEGACY_LIN * Rules.LEGACY_LIN

	-- ---------------------------------------------------------------------------------------------
	-- Spawning (startManpower, startingGold, minDistanceBetweenPlayers)
	-- ---------------------------------------------------------------------------------------------
	--- Spawn: a start claims the free land within euclidean distance 4 full-size tiles of the corner
	--- of the start tile (the disc is centred there) — nations, tribes and humans alike.
	Rules.SPAWN_RADIUS = 4.0 / K_LIN
	Rules.SPAWN_RADIUS_AI = Rules.SPAWN_RADIUS
	Rules.SPAWN_RADIUS_HUMAN = Rules.SPAWN_RADIUS
	--- Tribes spawn at least this far from any claimed tile: minDistanceBetweenPlayers 30 full-size tiles.
	Rules.TRIBE_SPAWN_MIN_DIST = 30.0 / K_LIN
	--- Nation spawn: a nation starts on free land within +-25 full-size tiles of its
	--- manifest coordinates (50 tries; mountains are skipped half the time).
	Rules.NATION_SPAWN_DELTA = 25.0 / K_LIN
	--- Default tribe count: 400 on every map (public lobbies, the
	--- singleplayer and private-lobby defaults; only half-size "compact" maps use 100).
	Rules.DEFAULT_TRIBES = 400
	--- Solo: countdown after the player's first pick.
	Rules.SOLO_COUNTDOWN_TICKS = 50
	--- Multiplayer default spawn phase length (config.spawn_ticks overrides).
	Rules.DEFAULT_SPAWN_TICKS = 200
	--- startManpower: humans 25k, tribes 10k, nations by difficulty (see NATION_START_TROOPS).
	Rules.START_TROOPS_HUMAN = 25000.0
	Rules.START_TROOPS_TRIBE = 10000.0
	--- startingGold: 0 by default.
	Rules.START_GOLD = 0.0
	--- Late joiners start with this fraction of the median nation's troops (never below START_TROOPS_HUMAN / 2).
	Rules.LATE_JOIN_TROOP_FRACTION = 0.4
	--- Spawn shield (2026-10-30; matches with other people, not solo): for this many ticks from its
	--- nation's first tick in play (the start of PLAYING, or a late joiner's landing) no one may attack
	--- a person, by land or by boat (the AI leaves them be too). One who attacks a person or a nation
	--- loses their own (tribes don't count). A start is about 50 full-size tiles, under
	--- ANNEX_BELOW_FULL_TILES, so it fell whole to the first tile any attack took: on the first tick of
	--- play 119 troops took a nation of 26,646.
	Rules.SPAWN_SHIELD_TICKS = 300

	-- ---------------------------------------------------------------------------------------------
	-- Difficulty: Relaxed / Standard / Brutal (index = config.difficulty: 0 / 1 / 2)
	-- ---------------------------------------------------------------------------------------------
	--- maxTroops nation multiplier. Kept as doubles, not float32 (the
	--- Godot version's float32 packing made 0.9 x 10 = 8.99999 and truncated to 8).
	Rules.NATION_TROOP_MULT = zt({ 0.5, 0.75, 1.0 })
	--- troopIncreaseRate nation multiplier.
	Rules.NATION_GROWTH_MULT = zt({ 0.9, 0.95, 1.0 })
	--- startManpower for nations.
	Rules.NATION_START_TROOPS = zt({ 12500.0, 18750.0, 25000.0 })

	-- ---------------------------------------------------------------------------------------------
	-- Troops (maxTroops, troopIncreaseRate, cityTroopIncrease)
	-- ---------------------------------------------------------------------------------------------
	Rules.CITY_TROOPS = 250000.0
	--- Tribes: maxTroops / 3, growth x 0.5.
	Rules.TRIBE_CAP_DIV = 3.0
	Rules.TRIBE_GROWTH_MULT = 0.5

	local KIND_NATION = Defs.KIND_NATION
	local KIND_TRIBE = Defs.KIND_TRIBE
	local KIND_HUMAN = Defs.KIND_HUMAN

	function Rules.start_troops(kind: number, difficulty: number): number
		if kind == KIND_TRIBE then
			return Rules.START_TROOPS_TRIBE
		elseif kind == KIND_NATION then
			return Rules.NATION_START_TROOPS[clampi(difficulty, 0, 2)]
		end
		return Rules.START_TROOPS_HUMAN
	end

	--- maxTroops = 2 * (numTiles^0.6 * 1000 + 50000) + cities * 250k, numTiles in full-size tiles.
	function Rules.max_troops(kind: number, tiles: number, cities: number, difficulty: number): number
		local m = 2.0 * ((math.max(tiles, 0) * K_AREA) ^ 0.6 * 1000.0 + 50000.0) + cities * 250000.0
		if kind == KIND_TRIBE then
			return m / 3.0
		end
		if kind == KIND_NATION then
			return m * Rules.NATION_TROOP_MULT[clampi(difficulty, 0, 2)]
		end
		return m
	end

	--- troopIncreaseRate: toAdd = (10 + troops^0.73 / 4) *
	--- (1 - troops/max) [tribes x0.5, nations by difficulty]; the result is min(troops + toAdd, max) -
	--- troops, so troops above the cap snap to it. This is the float the UI shows; each tick adds it
	--- as whole troops, which truncates it (see troop_growth_applied).
	function Rules.troop_growth(kind: number, troops: number, cap: number, difficulty: number): number
		local add = (10.0 + math.max(troops, 0.0) ^ 0.73 / 4.0) * (1.0 - troops / math.max(cap, 1.0))
		if kind == KIND_TRIBE then
			add *= 0.5
		elseif kind == KIND_NATION then
			add *= Rules.NATION_GROWTH_MULT[clampi(difficulty, 0, 2)]
		end
		return math.min(troops + add, cap) - troops
	end

	--- What one tick really adds: troops grow in whole troops, a positive rate adds
	--- floor(x) and a negative rate removes floor(-x), i.e. the rate
	--- truncated toward zero.
	function Rules.troop_growth_applied(kind: number, troops: number, cap: number, difficulty: number): number
		return trunc(Rules.troop_growth(kind, troops, cap, difficulty))
	end

	-- ---------------------------------------------------------------------------------------------
	-- Gold (goldAdditionRate, conquerGoldAmount)
	-- ---------------------------------------------------------------------------------------------
	--- goldAdditionRate: 100 per tick for humans and nations, 50 for tribes.
	Rules.GOLD_PER_TICK = 100.0
	Rules.TRIBE_GOLD_PER_TICK = 50.0

	function Rules.gold_per_tick(kind: number): number
		return if kind == KIND_TRIBE then 50.0 else 100.0
	end

	--- Passive gold per second (goldAdditionRate x 10). Trade ships, trains and conquests come on top.
	--- (Signature kept for the UI; territory and factories don't change it.)
	function Rules.passive_income(kind: number, tiles: number, _factories: number?, _difficulty: number?): number
		if tiles > 0 then
			return Rules.gold_per_tick(kind) * 10.0
		end
		return 0.0
	end

	--- conquerGoldAmount: conquering a nation or tribe takes all its gold, a human half of it.
	function Rules.conquer_gold(victim_kind: number, victim_gold: number): number
		return victim_gold * (if victim_kind == KIND_HUMAN then 0.5 else 1.0)
	end

	-- ---------------------------------------------------------------------------------------------
	-- Structures (costs, structureMinDist, defensePost*, SAM*, Silo*)
	-- ---------------------------------------------------------------------------------------------
	--- structureMinDist 15 full-size tiles: a site is valid only when no structure lies closer than
	--- STRUCT_MIN_DIST tiles (euclidean, map.range_d2). STRUCT_SPACING is that distance rounded up.
	Rules.STRUCT_MIN_DIST = 15.0 / K_LIN
	Rules.STRUCT_SPACING = math.ceil(15.0 / K_LIN)
	Rules.WARSHIP_KIND_NAME = "warship"
	--- defensePostRange 30 full-size tiles; inside it a post multiplies mag x5 (defensePostDefenseBonus) and
	--- tileCost x3 (defensePostSpeedBonus).
	Rules.DEFENSE_RANGE_FULL = 30.0
	Rules.DEFENSE_POST_MAG = 5.0
	Rules.DEFENSE_POST_COST = 3.0
	--- Integer radius of the defense-post coverage map (ceil of defense_range()).
	Rules.DEFENSE_RADIUS = math.ceil(30.0 / K_LIN)
	--- SAMCooldown / SiloCooldown: 90 ticks per missile; a SAM or silo holds `level` missiles.
	Rules.SAM_COOLDOWN_TICKS = 90
	Rules.SILO_COOLDOWN_TICKS = 90
	--- samUpgradeDuration (SAMCooldown / 2): after an upgrade the SAM's range grows to the new level's
	--- over this many ticks.
	Rules.SAM_UPGRADE_TICKS = 45
	--- constructionDuration (ticks), index = Defs.S_*: city 2 s, port 5 s, factory 2 s,
	--- defense post 5 s, SAM 30 s, silo 10 s. A structure under construction blocks placement and
	--- counts for prices but does nothing and can't be upgraded.
	--- (Arsenal: artillery 8 s, airfield 10 s, railgun 15 s.)
	Rules.BUILD_TICKS = zt({ 20, 50, 20, 50, 300, 100, 80, 100, 150 })
	--- Upgradable: city, port, factory, SAM and silo gain levels; defense posts don't (nor
	--- the Arsenal's structures).
	Rules.UPGRADABLE = zt({ 1, 1, 1, 0, 1, 1, 0, 0, 0 })
	--- Build search radius (15 full-size tiles): a build click floods the builder's own
	--- connected land within this range and builds on the nearest tile with no structure closer than
	--- STRUCT_MIN_DIST. radiusPortSpawn (20 full-size tiles, manhattan) limits where a port may snap to the coast.
	Rules.PLACE_SEARCH_R = 15.0 / K_LIN
	Rules.PORT_SPAWN_MANHATTAN = 20.0 / K_LIN
	--- Per-owner "constructed" counters (units ever built): index Defs.S_* for structures,
	--- BUILT_WARSHIP for warships.
	Rules.BUILT_WARSHIP = 15
	Rules.BUILT_SLOTS = 16
	--- samRange(level) = 150 - 480 / (level + 5) full-size tiles (level 1 = 70).
	Rules.SAM_MAX_RANGE_FULL = 150.0
	--- Integer SAM range at level 1 (our tiles), for callers that want a constant.
	Rules.SAM_RADIUS = math.ceil(70.0 / K_LIN)

	--- Defense-post protection radius in OUR tiles (euclidean, map.range_d2).
	function Rules.defense_range(): number
		return 30.0 / K_LIN
	end

	--- SAM interception range in OUR tiles for a SAM of `level` (euclidean, map.range_d2).
	function Rules.sam_range(level: number?): number
		local l = level or 1
		return (150.0 - 480.0 / (math.max(l, 1) + 5)) / K_LIN
	end

	--- Gold cost of the next structure (or level) of `kind_name`. `owned_count` is the owner's
	--- cost count (see cost_count_kinds / cost_of). Upgrading costs the same as building.
	--- For "warship": min(warships owned, warships ever built). Returns -1 for unknown kinds.
	function Rules.build_cost(kind_name: string, owned_count: number): number
		local n = math.max(owned_count, 0)
		if kind_name == "city" or kind_name == "port" or kind_name == "factory" then
			return math.min(1000000, 125000 * 2 ^ math.min(n, 4))
		elseif kind_name == "defense" then
			return math.min(250000, 50000 * (n + 1))
		elseif kind_name == "sam" then
			return math.min(3000000, 1500000 * (n + 1))
		elseif kind_name == "silo" then
			return 1000000
		elseif kind_name == "warship" then
			return math.min(1000000, 250000 * (n + 1))
		elseif kind_name == "artillery" then
			return math.min(750000, 150000 * (n + 1))
		elseif kind_name == "airfield" then
			return math.min(1500000, 500000 * (n + 1))
		elseif kind_name == "railgun" then
			return math.min(7500000, 2500000 * (n + 1))
		end
		return -1
	end

	--- Structure kinds (Defs.S_*) whose owned counts add up to the count build_cost() expects (1-based list).
	function Rules.cost_count_kinds(kind_name: string): { number }
		if kind_name == "port" or kind_name == "factory" then
			return { Defs.S_PORT, Defs.S_FACTORY }
		end
		local k = Defs.struct_kind_from_name(kind_name)
		if k >= 0 then
			return { k }
		end
		return {}
	end

	function Rules.build_cost_kind(kind: number, owned_count: number): number
		if kind < 0 or kind >= Defs.STRUCT_KIND_COUNT then
			return -1
		end
		return Rules.build_cost(Defs.STRUCT_NAMES[kind], owned_count)
	end

	function Rules.is_upgradable(kind: number): boolean
		return kind >= 0 and kind < Defs.STRUCT_KIND_COUNT and Rules.UPGRADABLE[kind] == 1
	end

	--- SAM range (our tiles) `ticks_since_upgrade` after being raised to `level` (ramps over
	--- SAM_UPGRADE_TICKS from the previous level's range: a dynamic SAM range).
	function Rules.sam_range_at(level: number, ticks_since_upgrade: number): number
		local r = Rules.sam_range(level)
		if level <= 1 or ticks_since_upgrade >= Rules.SAM_UPGRADE_TICKS then
			return r
		end
		local r0 = Rules.sam_range(level - 1)
		return r0 + (r - r0) * math.max(ticks_since_upgrade, 0) / Rules.SAM_UPGRADE_TICKS
	end

	--- THE placement algorithm (upgrade a structure in reach, or else find a land or coastal site
	--- among the valid tiles near the click), shared by the Sim and by previews on a GameState.
	--- `map` gives the grid and metrics, `owner_grid` (i32 buffer) / `coastal` (u8 buffer) are the tile
	--- arrays, `now` the current tick,
	--- and `near` every structure (any owner) within PLACE_SEARCH_R + STRUCT_MIN_DIST of `tile` as
	--- 1-based rows {sid, kind, owner, tile, level, active_tick}, sorted by sid.
	--- Returns {tile = int, upgrade_sid = int, reason = string}:
	--- * the clicked tile must be `id`'s ("not_own");
	--- * upgradable kinds: if the nearest structure of that kind within STRUCT_MIN_DIST of the click is
	---   `id`'s and finished, the click upgrades it (upgrade_sid, tile = its tile);
	--- * otherwise flood `id`'s 4-connected land within PLACE_SEARCH_R of the click, keep tiles with no
	---   structure closer than STRUCT_MIN_DIST and take the one nearest the click (ports: coastal tiles
	---   within PORT_SPAWN_MANHATTAN, nearest by manhattan distance) — "no_room" / "no_coast" if none.
	function Rules.place_site(
		map: any,
		owner_grid: buffer,
		coastal: buffer,
		id: number,
		kind: number,
		tile: number,
		near: { { number } },
		now: number
	): { tile: number, upgrade_sid: number, reason: string }
		local out = { tile = -1, upgrade_sid = 0, reason = "" }
		local W = map.W
		local N = map.N
		local range_d2 = map.range_d2
		local geo_manhattan = map.geo_manhattan
		if tile < 0 or tile >= N or kind < 0 or kind >= Defs.STRUCT_KIND_COUNT then
			out.reason = "invalid"
			return out
		end
		if buffer.readi32(owner_grid, tile * 4) ~= id then
			out.reason = "not_own"
			return out
		end
		local md2 = Rules.STRUCT_MIN_DIST * Rules.STRUCT_MIN_DIST
		if Rules.is_upgradable(kind) then
			local best: { number }? = nil
			local bd = 0.0
			for _, row in near do
				if row[2] ~= kind then
					continue
				end
				local d = range_d2(row[4], tile)
				if d > md2 then
					continue
				end
				if best == nil or d < bd or (d == bd and row[1] < (best :: { number })[1]) then
					best = row
					bd = d
				end
			end
			if best ~= nil and best[3] == id and best[6] <= now then
				out.tile = best[4]
				out.upgrade_sid = best[1]
				return out
			end
		end
		local r2 = Rules.PLACE_SEARCH_R * Rules.PLACE_SEARCH_R
		local seen: { [number]: boolean } = { [tile] = true }
		local stack = { tile }
		local flood = { tile }
		while #stack > 0 do
			local t = stack[#stack]
			stack[#stack] = nil
			local x = t % W
			local n1 = if t >= W then t - W else -1
			local n2 = if t < N - W then t + W else -1
			local n3 = if x > 0 then t - 1 else -1
			local n4 = if x < W - 1 then t + 1 else -1
			for k = 1, 4 do
				local n = if k == 1 then n1 elseif k == 2 then n2 elseif k == 3 then n3 else n4
				if n < 0 or seen[n] or buffer.readi32(owner_grid, n * 4) ~= id or range_d2(tile, n) >= r2 then
					continue
				end
				seen[n] = true
				table.insert(flood, n)
				table.insert(stack, n)
			end
		end
		local port = kind == Defs.S_PORT
		local pick = -1
		local pd = 0.0
		for _, t in flood do
			if port and (buffer.readu8(coastal, t) == 0 or geo_manhattan(tile, t) > Rules.PORT_SPAWN_MANHATTAN) then
				continue
			end
			local blocked = false
			for _, row in near do
				if range_d2(row[4], t) < md2 then
					blocked = true
					break
				end
			end
			if blocked then
				continue
			end
			local d = if port then geo_manhattan(tile, t) else range_d2(tile, t)
			if pick < 0 or d < pd then
				pick = t
				pd = d
			end
		end
		if pick < 0 then
			out.reason = if port then "no_coast" else "no_room"
			return out
		end
		out.tile = pick
		return out
	end

	--- Structure rows {sid, kind, owner, tile, level, active_tick} of a GameState within the reach
	--- place_site() needs around `tile`, sorted by sid.
	function Rules.near_structures(state: any, tile: number): { { number } }
		local range_d2 = state.map.range_d2
		local reach = Rules.PLACE_SEARCH_R + Rules.STRUCT_MIN_DIST + 1.0
		local r2 = reach * reach
		local out = {}
		for _, s in state.structures do
			if range_d2(tile, s.tile) <= r2 or range_d2(s.tile, tile) <= r2 then
				table.insert(out, { s.sid, s.kind, s.owner, s.tile, s.level, s.active_tick })
			end
		end
		table.sort(out, function(a, b)
			return a[1] < b[1]
		end)
		return out
	end

	--- Cost count for `id` and `kind_name` from a GameState (see build_cost()).
	function Rules.cost_count_of(state: any, id: number, kind_name: string): number
		if kind_name == "warship" then
			return math.min(state:count_units(id, Defs.U_WARSHIP), state:built_count(id, Rules.BUILT_WARSHIP))
		end
		local n = 0
		for _, k in Rules.cost_count_kinds(kind_name) do
			n += math.min(state:struct_level_sum(id, k), state:built_count(id, k))
		end
		return n
	end

	--- Gold the next `kind_name` (structure, level or warship) costs `id` right now (nukes:
	--- nuke_cost with the match's MIRV count).
	function Rules.cost_of(state: any, id: number, kind_name: string): number
		if Defs.nuke_kind_from_name(kind_name) >= 0 then
			return Rules.nuke_cost(kind_name, state.mirvs_launched)
		end
		return Rules.build_cost(kind_name, Rules.cost_count_of(state, id, kind_name))
	end

	--- Build preview on client data, using exactly the Sim's algorithm (place_site). Returns
	--- {ok = bool, tile = snapped tile or -1, upgrade_sid = sid or 0, cost = gold, reason = ""} with
	--- reason one of "" / "not_own" / "no_room" / "no_coast" / "no_port" / "gold" / "invalid".
	--- Warships: tile is the port they launch from (nearest own finished port on the clicked water
	--- body, or nearest own finished port when a land tile is clicked).
	function Rules.placement(
		state: any,
		id: number,
		kind_name: string,
		tile: number
	): { ok: boolean, tile: number, upgrade_sid: number, cost: number, reason: string }
		local R = Rules.for_map(state.map)
		if R ~= Rules then
			return R.placement(state, id, kind_name, tile)
		end
		local out = { ok = false, tile = -1, upgrade_sid = 0, cost = Rules.cost_of(state, id, kind_name), reason = "" }
		if kind_name == "warship" then
			local p = Rules.warship_port(state, id, tile)
			out.tile = p
			out.reason = if p >= 0 then "" else "no_port"
		else
			local kind = Defs.struct_kind_from_name(kind_name)
			local r = Rules.place_site(
				state.map,
				state.owner,
				state.map.coastal,
				id,
				kind,
				tile,
				Rules.near_structures(state, tile),
				state.tick
			)
			out.tile = r.tile
			out.upgrade_sid = r.upgrade_sid
			out.reason = r.reason
		end
		local o = state.owners[id]
		if out.reason == "" and (o == nil or o.gold < out.cost) then
			out.reason = "gold"
		end
		out.ok = out.reason == ""
		return out
	end

	--- Port a warship ordered at `tile` launches from (GameState data; the Sim uses the same rule):
	--- the nearest (manhattan) finished own port on the clicked water body, or on any body when a land
	--- tile is clicked. -1 if none.
	function Rules.warship_port(state: any, id: number, tile: number): number
		local body = -1
		local map = state.map
		local geo_manhattan = map.geo_manhattan
		if tile >= 0 and tile < map.N and buffer.readu8(map.terrain, tile) <= Defs.T_LAKE then
			body = buffer.readu16(map.water_body, tile * 2)
		end
		local best = -1
		local bd = 0.0
		for _, s in state.structures do
			if s.owner ~= id or s.kind ~= Defs.S_PORT or s.active_tick > state.tick then
				continue
			end
			if body >= 0 and buffer.readu16(map.coast_body, s.tile * 2) ~= body then
				continue
			end
			local d = if tile >= 0 then geo_manhattan(tile, s.tile) else 0.0
			if best < 0 or d < bd or (d == bd and s.tile < best) then
				best = s.tile
				bd = d
			end
		end
		return best
	end

	-- ---------------------------------------------------------------------------------------------
	-- Roads & trains (trainStationMin/MaxRange, trainGold, trainSpawnRate, train speed 2)
	-- ---------------------------------------------------------------------------------------------
	--- trainStationMin/MaxRange: stations link to stations 15..110 full-size tiles away (our tiles below).
	Rules.ROAD_MIN_TILES = 15.0 / K_LIN
	Rules.ROAD_MAX_TILES = 110.0 / K_LIN
	--- Rail network: a new station first snaps onto any railroad in the 4-tile grid cells within
	--- stationRadius 3 of it (splitting the railroad there); otherwise it links to every station in
	--- range it isn't already within maxConnectionDistance (4) hops of. A railroad's tile path must be
	--- shorter than railroadMaxSize (trainStationMaxRange x 1.4142).
	--- (in full-size tiles: SimStructures keys its rail grid by full-size-tile cells)
	Rules.RAIL_SNAP_FULL = 3
	Rules.RAIL_CELL_FULL = 4
	Rules.RAIL_LINK_HOPS = 4
	Rules.RAIL_MAX_PATH = 110.0 * 1.4142 / K_LIN
	--- Rail paths: A* on the half-resolution minimap (maps coarser than full resolution use their
	--- own grid), 4-neighbour steps, water / shoreline steps cost 1 + 5, a turn +3, heuristic weight 2;
	--- water is entered only from or into shoreline (rails bridge narrow straits, never open sea).
	Rules.RAIL_MINIMAP = if K_LIN < 1.5 then 2 else 1
	Rules.RAIL_WATER_PENALTY = 5
	Rules.RAIL_TURN_PENALTY = 3
	Rules.RAIL_HEURISTIC_W = 2
	--- Trains move 2 full-size tiles per tick.
	Rules.TRUCK_TPT_X100 = trunc(100.0 * K_LIN / 2.0)
	--- Safety cap on trains in flight per factory (on top of the trainSpawnRate throttle).
	Rules.TRUCKS_PER_FACTORY = 6
	--- A train: an engine + 5 cars (units counted by trainSaturation), and at least 10
	--- ticks between two trains from one factory.
	Rules.TRAIN_UNITS = 6
	Rules.TRAIN_COOLDOWN_TICKS = 10

	--- trainGold(rel, citiesVisited): self 10k / ally 35k / other 25k, minus 5k per stop beyond the
	--- 9th, at least 5k. Paid to the train's owner and (if different) to the station's owner, at city
	--- and port stops only.
	function Rules.train_gold(rel: string, stops_visited: number): number
		local base = 25000.0
		if rel == "self" then
			base = 10000.0
		elseif rel == "ally" then
			base = 35000.0
		end
		return math.max(5000.0, base - 5000.0 * math.max(0, stops_visited - 9))
	end

	function Rules.sigmoid(value: number, decay_rate: number, midpoint: number): number
		return 1.0 / (1.0 + math.exp(-decay_rate * (value - midpoint)))
	end
	local sigmoid = Rules.sigmoid

	--- trainSaturation(units): world-wide spawn throttle by train units (TRAIN_UNITS per train).
	function Rules.train_saturation(units: number): number
		local boost = 1.0 + 0.5 * math.exp(-units / 30.0)
		local damping = 1.0 - sigmoid(units, math.log(2.0) / 100.0, 560.0)
		local plateau = 0.25 * (1.0 - sigmoid(units, math.log(2.0) / 150.0, 900.0))
		return boost * math.max(damping, plateau)
	end

	--- trainSpawnRate: each factory spawns a train with probability 1 / rate per tick.
	function Rules.train_spawn_rate(owner_factories: number, train_units: number): number
		local rate = (owner_factories + 10) * 15.0
		return math.max(1, math.floor(rate / Rules.train_saturation(train_units)))
	end

	-- ---------------------------------------------------------------------------------------------
	-- Attacks (attackLogic + tunables)
	-- ---------------------------------------------------------------------------------------------
	--- terrainAttackBase by our terrain code (ocean, lake, plains, highland, mountain, tundra, icecap):
	--- mag (bloodiness) and tileCost (slowness). Tundra uses the highland numbers.
	Rules.ATTACK_MAG = f32t({ 80.0, 80.0, 80.0, 100.0, 120.0, 100.0, 80.0 })
	Rules.ATTACK_TILE_COST = f32t({ 16.5, 16.5, 16.5, 20.0, 25.0, 20.0, 16.5 })
	--- Attack-front priority terrain magnitude (plains 1 / highland 1.5 / mountain 2).
	Rules.PRIORITY_MAG = f32t({ 1.0, 1.0, 1.0, 1.5, 2.0, 1.5, 1.0 })
	Rules.LARGE_TERRITORY_MIDPOINT = 300000.0
	Rules.LARGE_TERRITORY_STEEPNESS = 2.5
	Rules.LARGE_ATTACKER_DEPTH = 0.7
	Rules.LARGE_DEFENDER_DEPTH = 0.3
	Rules.LARGE_ATTACKER_SPEED_DEPTH = 0.73
	Rules.BOT_DEFENDER_LOSS_MULT = 0.7
	Rules.TERRA_NULLIUS_COST_SCALE = 2000.0
	Rules.TERRA_NULLIUS_MIN_COST = 5.0
	Rules.TERRA_NULLIUS_MAX_COST = 100.0
	Rules.ATTACKER_LOSS_BASE = 0.463
	Rules.ATTACKER_LOSS_PER_DENSITY = 0.0039
	Rules.SPEED_COST_DIVISOR = 8.55
	--- Each attack tick: borderSize = the attack's border length + a random jitter whose upper
	--- bound 5 is exclusive, so the jitter is 0..4 (rand % BORDER_JITTER).
	Rules.BORDER_JITTER = 5
	--- Queueing a front tile: priority = (random 0..6 + 10) * (1 - 0.5 n + mag / 2)
	--- + ticks, n = the attacker's 4-neighbours of the queued tile (before the tile being conquered
	--- changes hands), mag = PRIORITY_MAG. The random part is 10..16.
	Rules.PRIORITY_BASE = 10
	Rules.PRIORITY_RAND = 7
	--- malusForRetreat: retreating from a player attack loses 25 %.
	Rules.RETREAT_MALUS = 0.25
	Rules.RETREAT_KEEP = 1.0 - 0.25
	--- Retreat delay: a retreat order freezes the attack and brings the troops home
	--- 20 ticks later (the attack still advances on the tick after the order).
	Rules.RETREAT_DELAY_TICKS = 20
	--- Annexation: a player under 100 full-size tiles is annexed by the attacker. A person's nation
	--- only once the attack has more troops left than its army at home (2026-10-30: the first tile of
	--- any attack took a start whole, whatever its army; SPAWN_SHIELD_TICKS).
	Rules.ANNEX_BELOW_FULL_TILES = 100.0
	--- Performance guard: at most ~572 full-size tiles (this many of our tiles) per
	--- attack per tick; see tests/growth_rules.luau for when it binds.
	Rules.MAX_TILES_PER_TICK = math.max(1, math.floor(572.0 / K_AREA))
	Rules.ATTACK_UPDATE_TICKS = 10
	--- attackRatio default (the troop slider starts at 20 %); the Sim's fallback when an
	--- attack / boat intent carries no ratio.
	Rules.DEFAULT_ATTACK_RATIO = 0.2

	local LOG_MID = math.log(300000.0)

	--- largeTerritoryBonus: logistic in log(full-size tiles), ~1 for small, 1 - depth for huge territories.
	function Rules.large_territory_bonus(src_tiles: number, depth: number): number
		return 1.0 - depth * sigmoid(math.log(math.max(src_tiles, 1.0)), 2.5, LOG_MID)
	end

	--- falloutDefenseModifier(ratio): 5 - 2 * ratio (ratio = fallout tiles / land tiles).
	function Rules.fallout_modifier(fallout_ratio: number): number
		return 5.0 - clampi(fallout_ratio, 0.0, 1.0) * 2.0
	end

	--- attackLogic against terra nullius: troops lost per full-size tile per unit of mag (tribes / 10, others / 5).
	function Rules.neutral_loss_per_mag(attacker_kind: number): number
		return 1.0 / (if attacker_kind == KIND_TRIBE then 10.0 else 5.0)
	end

	-- ---------------------------------------------------------------------------------------------
	-- Naval (boatMaxNumber, boatAttackAmount, transports / trade ships 1 tile/tick, tradeShipGold,
	-- tradeShipSpawnRate, warship*)
	-- ---------------------------------------------------------------------------------------------
	--- Transports and trade ships move 1 full-size tile per tick.
	Rules.TRANSPORT_TPT_X100 = trunc(100.0 * K_LIN)
	Rules.TRADE_TPT_X100 = trunc(100.0 * K_LIN)
	--- boatMaxNumber: 3 transports at sea per player. The AI (nations, tribes, bot players) keeps it.
	Rules.MAX_BOATS_PER_OWNER = 3
	--- A person's transports at sea (raised to 10 on 2026-10-10).
	Rules.MAX_BOATS_PLAYER = 10
	--- boatAttackAmount / AI boat attacks: troops / 5.
	Rules.BOAT_ATTACK_FRACTION = 0.2
	--- Boat orders that need a path search, per owner per second (extra orders are rejected).
	Rules.BOAT_SEARCHES_PER_S = 2
	--- Shore probes (boat reach and AI boat attacks on unclaimed land): every
	--- 10th shore tile of an owner (a count along its border, scaled like a border length) looks 5 full-size
	--- tiles across the water in each direction whose first step is water (rivers up to 4 wide).
	Rules.SHORE_PROBE_EVERY = math.max(1, math.floor(10.0 / K_LIN + 0.5))
	Rules.SHORE_PROBE_DIST = math.max(2, math.floor(5.0 / K_LIN + 0.5))
	--- tradeShipShortRangeDebuff 300 full-size tiles (manhattan) — closer ports get no bonus weight.
	Rules.TRADE_SHORT_RANGE_FULL = 300.0
	-- Warships (warship*, warship and shell stats) -------------------------------------------------
	--- maxHealth 1000; +20 % per veterancy level (max 3), which also scales shell damage +20 %.
	Rules.WARSHIP_HP = 1000
	Rules.WARSHIP_MAX_VET = 3
	Rules.WARSHIP_VET_HP_PCT = 20
	Rules.WARSHIP_VET_DMG_PCT = 20
	--- Veterancy: the final blow on an enemy warship is +1 level at once (partial progress wiped);
	--- otherwise 10 transports sunk OR 25 trade ships captured (or a mix) fill a level.
	Rules.WARSHIP_VET_TRANSPORTS = 10
	Rules.WARSHIP_VET_TRADES = 25
	--- Shell damage 250 x roll: multiplier 200 / 225 / 250 / 275 / 300 (%, /250).
	Rules.SHELL_DAMAGE = 250
	--- warshipShellAttackRate: a warship fires when more than 20 ticks passed since its last shell at a
	--- warship (it does not reload between transports).
	Rules.WARSHIP_FIRE_TICKS = 20
	--- warshipTargettingRange 130, warshipPatrolRange 100, warshipDockingRange 5 full-size tiles.
	Rules.WARSHIP_RANGE_FULL = 130.0
	Rules.WARSHIP_PATROL_FULL = 100.0
	Rules.WARSHIP_DOCK_FULL = 5.0
	Rules.WARSHIP_RANGE = trunc(130.0 / K_LIN)
	Rules.WARSHIP_PATROL_RADIUS = trunc(100.0 / K_LIN)
	--- Healing: +1 HP per tick within 150 full-size tiles of an own port (warshipPassiveHealing[Range]);
	--- docked: the port's level x 5 HP per tick shared by the ships docked there
	--- (warshipPortHealingBonusPerLevel); a port docks at most `level` ships.
	Rules.WARSHIP_PASSIVE_HEAL = 1
	Rules.WARSHIP_PASSIVE_HEAL_FULL = 150.0
	Rules.WARSHIP_PORT_HEAL_PER_LEVEL = 5
	--- Repair retreat below 75 % of (veterancy-adjusted) max health (warshipRetreatHealthPercent); a
	--- retreating ship switches port when another is within 0.75 x the squared distance
	--- (warshipPortSwitchThreshold); no retreat for 50 ticks after a manual move.
	Rules.WARSHIP_RETREAT_PCT = 75
	Rules.WARSHIP_RETREAT_FRAC = 0.75
	Rules.WARSHIP_PORT_SWITCH = 0.75
	Rules.WARSHIP_MANUAL_NO_RETREAT_TICKS = 50
	--- Speeds: 1 full-size tile per tick (2 while chasing a trade ship) — ticks per our tile x100.
	Rules.WARSHIP_TPT_X100 = trunc(100.0 * K_LIN)
	Rules.WARSHIP_HUNT_TPT_X100 = trunc(50.0 * K_LIN)
	--- Shells fly 3 full-size tiles per tick (air path) and fizzle if the target is gone or friendly.
	Rules.SHELL_SPEED_FULL = 3.0
	--- A trade ship sailing along a shore is safe from warships for 20 ticks
	--- (safeFromPiratesCooldownMax).
	Rules.SAFE_FROM_PIRATES_TICKS = 20
	--- Defense posts can shell transports / warships within 75 full-size tiles every 100 ticks;
	--- this targeting is off by default (Sim config
	--- "defense_posts_shoot" turns it on).
	Rules.DEFENSE_POST_SHOOTS = false
	Rules.DEFENSE_POST_SHELL_TICKS = 100
	Rules.DEFENSE_POST_TARGET_FULL = 75.0
	--- Build-click snap radius (the build search radius), for the UI.
	Rules.BUILD_SNAP_RADIUS = 15.0 / K_LIN

	--- Max health of a warship with `vet` veterancy (maxHealthWithVeterancy).
	function Rules.warship_max_hp(vet: number): number
		return 1000 * (100 + clampi(vet, 0, 3) * 20) // 100
	end

	--- Shell damage for a die `roll` in 1..5 and the shooter's veterancy.
	function Rules.shell_damage(roll: number, vet: number): number
		local mult = (clampi(roll, 1, 5) - 1) * 25 + 200
		if vet > 0 then
			mult = Defs.idiv(mult * (100 + vet * 20), 100)
		end
		return trunc(Defs.round(250 / 250.0 * mult))
	end

	--- Ticks a shell needs to cover `dist_tiles` of our tiles.
	function Rules.shell_flight_ticks(dist_tiles: number): number
		return math.max(1, trunc(math.ceil(dist_tiles * K_LIN / 3.0)))
	end

	--- Targeting range of warships in our tiles (euclidean, map.range_d2).
	function Rules.warship_range(): number
		return 130.0 / K_LIN
	end

	--- Transports an owner may have at sea at once (boatMaxNumber; a `player`: MAX_BOATS_PLAYER).
	function Rules.max_boats(_tiles: number?, player: boolean?): number
		return if player then Rules.MAX_BOATS_PLAYER else Rules.MAX_BOATS_PER_OWNER
	end

	--- tradeShipGold(dist): 75000 / (1 + e^(-0.03 (dist - 300))) + 50 dist, dist = full-size tiles sailed.
	function Rules.trade_gold(path_tiles: number): number
		local d = path_tiles * K_LIN
		return 75000.0 / (1.0 + math.exp(-0.03 * (d - 300.0))) + 50.0 * d
	end

	--- tradeShipSaturation(ships): world-wide spawn throttle.
	function Rules.trade_saturation(ships: number): number
		local boost = 1.0 + 0.45 * math.exp(-ships / 120.0)
		local damping = 1.0 - sigmoid(ships, math.log(2.0) / 50.0, 330.0)
		local plateau = 0.25 * (1.0 - sigmoid(ships, math.log(2.0) / 100.0, 800.0))
		return boost * math.max(damping, plateau)
	end

	--- tradeShipSpawnRate: every 10 ticks each port spawns with probability 1 / rate (pity timer).
	function Rules.trade_spawn_rate(rejections: number, ships: number): number
		return math.max(1, math.floor(100.0 / (rejections + 1) / Rules.trade_saturation(ships)))
	end

	-- ---------------------------------------------------------------------------------------------
	-- Nukes (index = Defs.N_*; nukeMagnitudes, nukeSpeed, nukeDeathFactor, costs,
	-- nukeAllianceBreakThreshold, MIRV warheads)
	-- ---------------------------------------------------------------------------------------------
	--- Atom 750k, hydrogen 5M, MIRV 25M (+15M per MIRV launched in the match; see nuke_cost()).
	--- (Arsenal: Bijūdama 2.5M, Tengai Shinsei 12M; a shell, an air strike and a railgun slug are free —
	--- their battery, airfield or railgun is the price.)
	Rules.NUKE_COST = zt({ 750000, 5000000, 25000000, 0, 2500000, 12000000, 0, 0, 0 })
	Rules.MIRV_COST_STEP = 15000000
	--- nukeMagnitudes (full-size tiles): atom 12/30, hydrogen 80/100, warhead 12/18 (inner / outer).
	--- (Arsenal: mega = twice an atom bomb's radii, four times its ground; Tengai Shinsei has a 110/140-tile impact before secondary fragments; a shell, an air strike and a slug have one blast disc and take no land.)
	Rules.NUKE_INNER_FULL = f32t({ 12.0, 80.0, 0.0, 12.0, 24.0, 110.0, 0.0, 0.0, 0.0 })
	Rules.NUKE_OUTER_FULL = f32t({ 30.0, 100.0, 0.0, 18.0, 60.0, 140.0, 1.5, 15.0, 5.0 })
	--- Outer blast radius in our tiles (UI displays trunc(NUKE_RADIUS[kind])).
	Rules.NUKE_RADIUS = f32t({
		30.0 / K_LIN,
		100.0 / K_LIN,
		0.0,
		18.0 / K_LIN,
		60.0 / K_LIN,
		140.0 / K_LIN,
		1.5 / K_LIN,
		15.0 / K_LIN,
		5.0 / K_LIN,
	})
	--- SAMs always hit what they can reach; the MIRV carrier itself can't be intercepted (nor can a
	--- shell, an air strike or a slug).
	Rules.NUKE_INTERCEPT_P = f32t({ 1.0, 1.0, 0.0, 1.0, 1.0, 1.0, 0.0, 0.0, 0.0 })
	--- defaultSamMissileSpeed 12 full-size tiles/tick (manhattan time to reach); a bomb or warhead can be
	--- targeted only within defaultNukeTargetableRange (150 full-size tiles) of its target or of its launch point.
	Rules.SAM_MISSILE_SPEED_FULL = 12.0
	Rules.NUKE_TARGETABLE_FULL = 150.0
	--- nukeSpeed (full-size tiles per tick): atom / hydrogen 10, MIRV 15, warhead 22.
	--- (Arsenal: mega / scattershot 10 like the bombs; shell 6, air strike 8, slug 80.)
	Rules.NUKE_SPEED_FULL = f32t({ 10.0, 10.0, 15.0, 22.0, 10.0, 10.0, 6.0, 8.0, 80.0 })
	--- MIRV: 350 warheads within 1500 full-size tiles of the aim, on the target's land.
	Rules.MIRV_WARHEADS = 350
	Rules.MIRV_SPREAD = trunc(1500.0 / K_LIN)
	--- nukeAllianceBreakThreshold: 100 weighted full-size tiles (inner 1, outer 0.5) of an ally's land.
	Rules.NUKE_ALLIANCE_BREAK_FULL = 100.0

	--- (inner, outer) blast radii in OUR tiles for nuke kind `kind`; MIRV: (0, spread).
	--- (GDScript returned Vector2(inner, outer).)
	function Rules.nuke_radii(kind: number): (number, number)
		if kind == Defs.N_MIRV then
			return 0.0, Rules.MIRV_SPREAD
		end
		if kind < 0 or kind >= Defs.NUKE_KIND_COUNT then
			return 0.0, 0.0
		end
		return Rules.NUKE_INNER_FULL[kind] / K_LIN, Rules.NUKE_OUTER_FULL[kind] / K_LIN
	end

	--- Gold cost of a nuke; the MIRV grows by 15M for every MIRV already launched in the match.
	function Rules.nuke_cost(kind_name: string, mirvs_launched: number?): number
		local k = Defs.nuke_kind_from_name(kind_name)
		if k < 0 or k == Defs.N_WARHEAD or k == Defs.N_SHELL then
			return -1
		end
		if k == Defs.N_MIRV then
			return Rules.NUKE_COST[k] + Rules.MIRV_COST_STEP * math.max(mirvs_launched or 0, 0)
		end
		return Rules.NUKE_COST[k]
	end

	--- Flight time in ticks over `dist_tiles` of OUR tiles at nukeSpeed.
	function Rules.nuke_flight_ticks(dist_tiles: number, kind: number?): number
		local speed = Rules.NUKE_SPEED_FULL[clampi(kind or Defs.N_ATOM, 0, Defs.NUKE_KIND_COUNT - 1)]
		return math.max(1, trunc(math.ceil(dist_tiles * K_LIN / speed)))
	end

	--- The nuke flight path, a parabola-like arc:
	--- a cubic Bezier from the silo's tile centre to the target's, its control
	--- points a quarter and three quarters along, raised by max(dist / 3, 50 full-size tiles) toward the top of
	--- the map (clamped to it), flown at constant speed along the curve. The Sim's trajectory (what SAMs
	--- intercept) and the renderer's nuke both come from this arc, so a nuke seen crossing a SAM is one
	--- the SAM can reach (2026-09-29: a SAM shoots down the nukes that pass over it; the Sim
	--- flew a straight line under the drawn arc).
	--- nuke_arc builds its arc-length table (NUKE_ARC_SAMPLES segments); nuke_arc_at the point at
	--- arc-length fraction s in [0, 1] (tile units, map space); nuke_arc_ticks the flight time.
	Rules.NUKE_ARC_MIN_HEIGHT_FULL = 50.0
	Rules.NUKE_ARC_SAMPLES = 96
	function Rules.nuke_arc(W: number, H: number, from_tile: number, to_tile: number): any
		local sx, sy = from_tile % W + 0.5, from_tile // W + 0.5
		local dx, dy = to_tile % W + 0.5, to_tile // W + 0.5
		local ddx, ddy = dx - sx, dy - sy
		local dist = math.sqrt(ddx * ddx + ddy * ddy)
		local hmax = math.max(dist / 3, Rules.NUKE_ARC_MIN_HEIGHT_FULL / K_LIN)
		local p1x, p1y = sx + ddx / 4, math.clamp(sy + ddy / 4 - hmax, 0, H - 1)
		local p2x, p2y = sx + ddx * 3 / 4, math.clamp(sy + ddy * 3 / 4 - hmax, 0, H - 1)
		local n = Rules.NUKE_ARC_SAMPLES
		local xs, ys, lens = table.create(n + 1), table.create(n + 1), table.create(n + 1)
		local total = 0.0
		local px, py = sx, sy
		for i = 0, n do
			local t = i / n
			local u = 1 - t
			local a, b, c, d = u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t
			local x = a * sx + b * p1x + c * p2x + d * dx
			local y = a * sy + b * p1y + c * p2y + d * dy
			if i > 0 then
				total += math.sqrt((x - px) * (x - px) + (y - py) * (y - py))
			end
			xs[i + 1], ys[i + 1], lens[i + 1] = x, y, total
			px, py = x, y
		end
		return { xs = xs, ys = ys, lens = lens, length = total }
	end

	function Rules.nuke_arc_at(arc: any, s: number): (number, number)
		local xs, ys, lens = arc.xs, arc.ys, arc.lens
		local total = arc.length
		if total <= 0 then
			return xs[1], ys[1]
		end
		local want = math.clamp(s, 0, 1) * total
		local lo, hi = 1, #lens
		while hi - lo > 1 do
			local mid = (lo + hi) // 2
			if lens[mid] < want then
				lo = mid
			else
				hi = mid
			end
		end
		local seg = lens[hi] - lens[lo]
		local f = if seg > 0 then (want - lens[lo]) / seg else 0
		return xs[lo] + (xs[hi] - xs[lo]) * f, ys[lo] + (ys[hi] - ys[lo]) * f
	end

	--- Ticks to fly `arc`: a nuke moves nukeSpeed full-size tiles along the curve per tick.
	Rules.GRAVITY_DESCENT_TICKS = 9
	Rules.GRAVITY_HOLD_TICKS = 25
	Rules.BIJUDAMA_SWEEP_RADIUS = 14 / K_LIN

	function Rules.nuke_arc_ticks(arc: any, kind: number?): number
		if kind == Defs.N_HYDROGEN then
			return Rules.GRAVITY_DESCENT_TICKS + Rules.GRAVITY_HOLD_TICKS
		end
		local speed = Rules.NUKE_SPEED_FULL[clampi(kind or Defs.N_ATOM, 0, Defs.NUKE_KIND_COUNT - 1)]
		return math.max(1, trunc(math.ceil(arc.length * K_LIN / speed)))
	end

	-- ---------------------------------------------------------------------------------------------
	-- The Arsenal (2026-10-04: units unlocked with Stars or Robux, Data/Arsenal). Numbers
	-- are in full-size tiles like everything above.
	-- ---------------------------------------------------------------------------------------------
	--- Munitions that fly a straight line (a shell, a bomber's run, a railgun slug); the others fly
	--- the nuke arc (nuke_arc).
	Rules.NUKE_FLAT = zt({ false, false, false, false, false, false, true, true, true })
	--- The structure a munition leaves from (Defs.S_*): bombs a silo, an air strike an airfield, a slug
	--- a railgun. (Shells are fired by the battery itself; warheads come off a MIRV or a scattershot.)
	Rules.NUKE_LAUNCHER = zt({
		Defs.S_SILO,
		Defs.S_SILO,
		Defs.S_SILO,
		-1,
		Defs.S_SILO,
		Defs.S_SILO,
		Defs.S_ARTILLERY,
		Defs.S_AIRFIELD,
		Defs.S_RAILGUN,
	})
	--- A structure that fires reloads for this long per shot (index Defs.S_*; 0: it doesn't fire).
	--- SAMCooldown / SiloCooldown 90; an airfield rearms for 30 s, a railgun reloads for 25 s. A battery
	--- rolls its own gap per shot (ARTILLERY_GAP_*).
	Rules.RELOAD_TICKS = zt({ 0, 0, 0, 0, 90, 90, 0, 300, 250 })
	--- What the Rapid Reload unlock makes of every reload of its owner's.
	Rules.RAPID_RELOAD_MULT = 0.5
	--- Artillery: a battery shells whatever isn't its owner's or an ally's within 45 tiles, every 4 to
	--- 7 s (a new battery waits one gap first; with nothing in range it looks again every 2 s).
	Rules.ARTILLERY_RANGE_FULL = 45.0
	Rules.ARTILLERY_GAP_MIN = 40
	Rules.ARTILLERY_GAP_MAX = 70
	Rules.ARTILLERY_IDLE_TICKS = 20
	Rules.ARTILLERY_SAMPLES = 24
	--- A shell kills 2.88 % of the army whose land it hits (at least 1,440, at most 19,200) and does
	--- 150 damage to the structures within 1.5 tiles.
	Rules.SHELL_KILL_FRAC = 0.0288
	Rules.SHELL_KILL_MIN = 1440.0
	Rules.SHELL_KILL_MAX = 19200.0
	--- Air strike: an airfield reaches 156 tiles; the bombs fall on a 15-tile disc and kill, per army
	--- with land under it, 60 troops per tile hit up to 6 % of that army; structures take 600.
	Rules.AIRFIELD_RANGE_FULL = 156.0
	Rules.AIRSTRIKE_KILL_PER_TILE = 60.0
	Rules.AIRSTRIKE_KILL_FRAC = 0.06
	--- Railgun: no range limit; a 5-tile disc, 150 troops per tile up to 4 % of the army; structures
	--- take 1000 (a level).
	Rules.SLUG_KILL_PER_TILE = 150.0
	Rules.SLUG_KILL_FRAC = 0.04
	--- Damage a munition does to each structure in its disc (index Defs.N_*).
	Rules.STRIKE_DAMAGE = zt({ 0, 0, 0, 0, 0, 0, 150, 600, 1000 })
	--- Health of a structure (index Defs.S_*), only ever lowered by a shell, an air strike or a slug:
	--- at 0 it loses a level and is whole again, or is destroyed at level 1.
	Rules.STRUCT_HP = zt({ 1000, 1000, 1000, 600, 1000, 1000, 600, 800, 1000 })
	--- Scattershot: 4 to 6 warheads come down 28 to 46 tiles around the aim point.
	Rules.SCATTER_MIN = 4
	Rules.SCATTER_MAX = 6
	Rules.SCATTER_NEAR_FULL = 28.0
	Rules.SCATTER_FAR_FULL = 46.0
	--- Reinforcements: 100,000 gold brings a fifth of the troop cap (never past the cap), every 30 s.
	Rules.REINFORCE_COST = 100000.0
	Rules.REINFORCE_FRACTION = 0.20
	Rules.REINFORCE_COOLDOWN_TICKS = 300

	function Rules.artillery_range(): number
		return 45.0 / K_LIN
	end

	--- Reach of the structure a munition leaves from, in OUR tiles (0: no limit).
	function Rules.launch_range(kind: number): number
		if kind == Defs.N_AIRSTRIKE then
			return 156.0 / K_LIN
		elseif kind == Defs.N_SHELL then
			return 45.0 / K_LIN
		end
		return 0.0
	end

	--- A munition's flight path: the nuke arc for the bombs, a straight line for a shell, an air
	--- strike and a slug (same table shape, so nuke_arc_at / nuke_arc_ticks work on both).
	function Rules.munition_arc(W: number, H: number, from_tile: number, to_tile: number, kind: number?): any
		if kind == Defs.N_HYDROGEN then
			local x, y = to_tile % W + 0.5, to_tile // W + 0.5
			return { xs = { x }, ys = { y }, lens = { 0.0 }, length = 0 }
		end
		if kind ~= Defs.N_MEGA and (kind == nil or not Rules.NUKE_FLAT[kind]) then
			return Rules.nuke_arc(W, H, from_tile, to_tile)
		end
		local sx, sy = from_tile % W + 0.5, from_tile // W + 0.5
		local dx, dy = to_tile % W + 0.5, to_tile // W + 0.5
		local len = math.sqrt((dx - sx) * (dx - sx) + (dy - sy) * (dy - sy))
		return { xs = { sx, dx }, ys = { sy, dy }, lens = { 0.0, len }, length = len }
	end

	--- Troops a strike (shell / air strike / slug) kills of an army of `troops` with `src_tiles`
	--- full-size tiles of land under the blast.
	function Rules.strike_kill(kind: number, troops: number, src_tiles: number): number
		local t = math.max(troops, 0.0)
		if kind == Defs.N_SHELL then
			return math.min(t, clampi(math.floor(t * 0.0288), 1440.0, 19200.0))
		elseif kind == Defs.N_AIRSTRIKE then
			return math.floor(math.min(t, src_tiles * 60.0, t * 0.06))
		elseif kind == Defs.N_SLUG then
			return math.floor(math.min(t, src_tiles * 150.0, t * 0.04))
		end
		return 0.0
	end

	--- Troops one Reinforcements call brings an army of `troops` under `cap`.
	function Rules.reinforce_troops(troops: number, cap: number): number
		return math.max(0, math.min(math.floor(cap * 0.20), math.floor(cap) - math.floor(troops)))
	end

	--- nukeDeathFactor for a warhead, per full-size tile: 500 * (1 - e^(-2 * excess / max)).
	function Rules.warhead_death(troops: number, max_troops: number): number
		local m = math.max(max_troops, 1.0)
		local excess = math.max(0.0, troops - 0.03 * m)
		return 500.0 * (1.0 - math.exp(-2.0 * excess / m))
	end

	-- ---------------------------------------------------------------------------------------------
	-- Diplomacy & victory (traitor*, win share)
	-- ---------------------------------------------------------------------------------------------
	--- allianceRequestDuration 20 s: a request is rejected once
	--- more than this many ticks passed since it was made.
	Rules.ALLY_REQUEST_TICKS = 200
	--- allianceRequestCooldown 30 s: a player can't send a new request to
	--- the same player until this many ticks after the previous (answered or expired) one was made.
	Rules.ALLY_REQUEST_COOLDOWN_TICKS = 300
	--- allianceDuration 5 min: an alliance expires this many ticks after it was formed
	--- or last renewed (expiresAt <= ticks: it ends, no traitor penalty).
	Rules.ALLIANCE_TICKS = 3000
	--- allianceExtensionPromptOffset 30 s: renewal can be asked in the last 300
	--- ticks; once both allies asked, the alliance is extended: expiresAt = now + ALLIANCE_TICKS.
	Rules.ALLIANCE_EXTEND_WINDOW_TICKS = 300
	--- traitorDuration 30 s; traitors take x0.5 attacker losses (traitorDefenseDebuff) and x0.8 attack
	--- time (traitorSpeedDebuff) when attacked.
	Rules.TRAITOR_TICKS = 300
	Rules.TRAITOR_DEFENSE_DEBUFF = 0.5
	Rules.TRAITOR_SPEED_DEBUFF = 0.8
	--- Owners are hostile for this long after one attacked the other.
	Rules.HOSTILE_TICKS = 600
	--- Nukes leave a much longer grudge.
	Rules.NUKE_GRUDGE_TICKS = 3000
	Rules.AI_MAX_ALLIES = 3
	--- Win share: 80 % of the land that is not fallout.
	Rules.WIN_SHARE = 0.8

	-- ---------------------------------------------------------------------------------------------
	-- Human protection (our AI behaviour layer; index = difficulty)
	-- ---------------------------------------------------------------------------------------------
	--- No AI attacks a human before this many ticks after PLAYING starts. Each AI adds its own
	--- random delay (0..HUMAN_GRACE_JITTER) plus HUMAN_GRACE_PER_TILE per tile of distance beyond
	--- HUMAN_GRACE_NEAR tiles, so wars trickle in instead of starting on one tick.
	Rules.HUMAN_GRACE_TICKS = zt({ 3000, 1800, 1200 })
	Rules.HUMAN_GRACE_JITTER = 900
	Rules.HUMAN_GRACE_NEAR = 40
	Rules.HUMAN_GRACE_PER_TILE = 3
	Rules.HUMAN_GRACE_MAX_EXTRA = 1200
	--- At most this many AI nations may be at war with one human at once (tribes don't count).
	Rules.MAX_AI_WARS_ON_HUMAN = zt({ 1, 2, 3 })
	--- The smart bot players of a public match (Sim.SMART_BOTS, playing at Sim.SMART_SKILL) are no
	--- harsher towards players than this difficulty's AI: its grace above, its limit on wars, how
	--- often it passes a player over as a target (SimAI.HUMAN_SKIP). They were the one AI of a public
	--- match that came for a player after 3 minutes instead of 5, passed one over 1 time in 4 instead
	--- of 3 in 4, and joined a war another AI already had on one (made a little easier for
	--- public matches on 2026-10-05). The rest of them stays as it was: their troops,
	--- their pace, their wars on the AI. Also the difficulty of a public match's "Protected" countdown.
	Rules.SMART_VS_PLAYERS = 0
	--- Endgame capitulation (AI nations only): after CAPITULATE_AGE ticks of play, a nation
	--- holding less than CAPITULATE_SHARE of the land that is attacked by an owner with
	--- CAPITULATE_RATIO times its troops surrenders all its land (and gold) to that attacker.
	Rules.CAPITULATE_AGE = 12000
	Rules.CAPITULATE_SHARE = 0.02
	Rules.CAPITULATE_RATIO = 8.0
	Rules.CAPITULATE_GAP = 300

	--- Earliest tick (counted from the start of PLAYING) at which any AI may attack a human —
	--- for a "protected" countdown in the UI. Counter-attacks against a human who attacks first are
	--- always allowed.
	function Rules.human_grace_ticks(difficulty: number): number
		return Rules.HUMAN_GRACE_TICKS[clampi(difficulty, 0, 2)]
	end

	return Rules
end

local cache: { [number]: any } = {}

--- Rules scaled for maps whose tiles are `k_lin` full-size tiles across (cached per value).
local function for_k(k_lin: number?): any
	local k = tonumber(k_lin) or 1.0
	if k <= 0 or k ~= k then
		k = 1.0
	end
	local r = cache[k]
	if r == nil then
		r = build(k)
		cache[k] = r
		r.for_k = for_k
		r.for_map = function(map: any): any
			return for_k(if map ~= nil then map.k_lin else nil)
		end
	end
	return r
end

return for_k(1.0)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal synchronous signal (GDScript `signal` equivalent). Handlers run in connection order.
-- Usage: local s = Signal.new(); local c = s:Connect(fn); s:Fire(a, b); c:Disconnect()
-- Fire allocates nothing: handlers connected during a Fire first run on the next Fire, and handlers
-- disconnected during a Fire are skipped at once (their slots are compacted when the outermost Fire
-- returns), exactly the semantics of iterating a snapshot of the list.
local Signal = {}
Signal.__index = Signal

export type Connection = { Connected: boolean, Disconnect: (self: Connection) -> () }

local Connection = {}
Connection.__index = Connection

function Connection.Disconnect(self: any)
	if not self.Connected then
		return
	end
	self.Connected = false
	local sig = self._signal
	if sig._firing > 0 then
		sig._dirty = true -- removed when the outermost Fire returns
		return
	end
	local list = sig._handlers
	local i = table.find(list, self)
	if i then
		table.remove(list, i)
	end
end

function Signal.new()
	return setmetatable({ _handlers = {}, _firing = 0, _dirty = false }, Signal)
end

function Signal.Connect(self: any, fn: (...any) -> ())
	local c = setmetatable({ Connected = true, _fn = fn, _signal = self }, Connection)
	table.insert(self._handlers, c)
	return c
end

function Signal.Once(self: any, fn: (...any) -> ())
	local c
	c = self:Connect(function(...)
		c:Disconnect()
		fn(...)
	end)
	return c
end

-- A handler error is reported and the remaining handlers still run (Godot semantics: one broken
-- listener must not starve its siblings). The report keeps the handler's traceback.
local report: (string) -> () = (warn :: any) or print
local spawn = if type(task) == "table" then (task :: any).spawn else nil

local function on_handler_error(err: string)
	if spawn then
		-- Roblox: surface it as a real error in the output (red, clickable) without unwinding Fire.
		spawn(error, err, 0)
	else
		report(err)
	end
end

local function compact(self: any)
	self._dirty = false
	local list = self._handlers
	local j = 0
	for i = 1, #list do
		local c = list[i]
		if c.Connected then
			j += 1
			list[j] = c
		end
	end
	for i = #list, j + 1, -1 do
		list[i] = nil
	end
end

function Signal.Fire(self: any, ...)
	local list = self._handlers
	local n = #list
	if n == 0 then
		return
	end
	-- Only the first n handlers run (later connections wait for the next Fire); slots are never
	-- removed while firing (Disconnect only marks them), so indices stay valid.
	self._firing += 1
	for i = 1, n do
		local c = list[i]
		if c.Connected then
			local ok, err = xpcall(c._fn, debug.traceback, ...)
			if not ok then
				on_handler_error(err)
			end
		end
	end
	self._firing -= 1
	if self._firing == 0 and self._dirty then
		compact(self)
	end
end

function Signal.DisconnectAll(self: any)
	for _, c in ipairs(self._handlers) do
		c.Connected = false
	end
	if self._firing > 0 then
		self._dirty = true
	else
		table.clear(self._handlers)
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Sim</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/sim.gd: the authoritative match simulation (DESIGN.md §4). Pure logic, no
-- Instances; runs the server's multiplayer match and every local (title / solo) match. Construct,
-- add humans, submit intents, call step() at 10 Hz and feed each returned delta to a GameState.
--
-- CLASS / MIXIN PROTOCOL (binding for sim-systems; see build/notes/sim-core.md):
-- The GDScript chain SimState → SimAttacks → SimStructures → SimNaval → SimWarships → SimNukes → Sim
-- is flattened into ONE class table: each part module exposes install(C) that assigns its methods;
-- parts are installed in chain order (later ones override earlier ones; an override that needs
-- `super` keeps `local prev = C.name` inside its install), then Sim's own methods are assigned.
-- Sim.new(map, config) creates the instance (map: a WorldMap, or nil for WorldMap.get(config.map_id))
-- and runs, in order:
--   self.rng = Rng.new(seed)      (before _init_state, like `rng.seed = …` in sim.gd)
--   self:_init_state(map)         SimState   — every SimState member
--   self:_init_attacks()          SimAttacks — every SimAttacks member
--   self:_init_structures()       SimStructures (sim-systems)
--   self:_init_naval()            SimNaval      (sim-systems; nav = SimNav.shared(map))
--   self:_init_warships()         SimWarships   (sim-systems)
--   self:_init_nukes()            SimNukes      (sim-systems; GDScript had only member initialisers)
--   self.defense_posts_shoot = config.defense_posts_shoot (default Rules.DEFENSE_POST_SHOOTS)
--   _make_human_palette → _create_nations → _create_tribes → ai = SimAI.new(); ai:setup(self)
-- Every `_init_*` must assign ALL members its GDScript part declares (Luau has no field defaults).
local Defs = require("./Defs")
local Ev = require("./Ev")
local NumberFormat = require("./NumberFormat")
local Rules = require("./Rules")
local Rng = require("./Rng")
local GameState = require("./GameState")
local SimColors = require("./SimColors")
local SimState = require("./SimState")
local SimAttacks = require("./SimAttacks")
local SimStructures = require("./SimStructures")
local SimNaval = require("./SimNaval")
local SimWarships = require("./SimWarships")
local SimNukes = require("./SimNukes")
local SimArsenal = require("./SimArsenal")
local SimAI = require("./SimAI")
local Teams = require("./Teams")
local WorldMap = require("./WorldMap")
local Nations = require("../Data/Nations")
local Coop = require("../Net/Coop")

local STRUCT_KINDS = SimState.STRUCT_KINDS
local TICK_RATE = 10

local readi32 = buffer.readi32

local Sim = {}
Sim.__index = Sim

SimState.install(Sim)
SimAttacks.install(Sim)
SimStructures.install(Sim)
SimNaval.install(Sim)
SimWarships.install(Sim)
SimNukes.install(Sim)
SimArsenal.install(Sim)

Sim.TICK_RATE = TICK_RATE
--- Owners whose start lies within these many tiles (of the original 1024-wide grid; scaled by the
--- map's R.LEGACY_LIN) count as neighbours for colour contrast.
Sim.COLOR_NEAR_NATION = 70
Sim.COLOR_NEAR_HUMAN = 120
--- Every tribe's colour: one flat warm grey shared by all tribes,
--- so tribes read as neutral filler and only players and nations are colourful.
Sim.TRIBE_COLOR = Defs.html_rgba("#d1cdc7")
Sim.PROF_NAMES = { "intents", "economy", "ai", "attacks", "units", "ports", "factories", "nukes", "misc" }

local function clock_us(): number
	return os.clock() * 1e6
end

-- =============================================================================================
-- Construction
-- =============================================================================================

--- Sim.new(map, config): config = {map_id (used when `map` is nil; default MapList.DEFAULT), seed,
--- difficulty (0..2), tribes (default: Sim.default_tribes(map)), max_humans, time_limit_s,
--- spawn_ticks, solo_countdown_ticks (a solo match: ticks from placing the capital to the start;
--- default Rules.SOLO_COUNTDOWN_TICKS), defense_posts_shoot, nations (false: no manifest nations),
--- nation_limit (that many of the manifest's nations, picked at random), teams (a team game:
--- a number of teams, Teams.DUOS / TRIOS / QUADS / HVN; see assign_teams)}.
function Sim.new(p_map: any, config: { [string]: any }?): any
	local cfg = config or {}
	if p_map == nil then
		p_map = WorldMap.get(if type(cfg.map_id) == "string" then cfg.map_id else nil)
	end
	local self: any = setmetatable({}, Sim)
	local seed = if type(cfg.seed) == "number" then Defs.trunc(cfg.seed) else 1
	self.rng = Rng.new(seed)
	self.difficulty = math.clamp(Defs.trunc(tonumber(cfg.difficulty) or 1), 0, 2)
	self.max_humans = math.max(Defs.trunc(tonumber(cfg.max_humans) or 0), 0)
	--- Map id (snapshots carry it so mirrors build GameState on the same map).
	self.map_id = p_map.id
	self.tribe_count = math.clamp(Defs.trunc(tonumber(cfg.tribes) or Sim.default_tribes(p_map)), 0, 700)
	self.time_limit_s = math.max(Defs.trunc(tonumber(cfg.time_limit_s) or 0), 0)
	self.spawn_total = math.max(Defs.trunc(tonumber(cfg.spawn_ticks) or Rules.DEFAULT_SPAWN_TICKS), 10)
	--- True when max_humans == 1 (spawn phase waits for the player's pick, then counts down 5 s).
	self.solo = self.max_humans == 1
	--- Spawn phase ticks left; -1 while a solo match waits for the first pick.
	self.spawn_left = -1
	self.solo_countdown = math.max(Defs.trunc(tonumber(cfg.solo_countdown_ticks) or Rules.SOLO_COUNTDOWN_TICKS), 1)
	--- Absolute tick at which the match ends by time (0 = no limit).
	self.time_limit_ticks = 0
	self.winner = 0
	self.over_reason = -1
	self.nation_count = 0
	--- Team games (Core/Teams): the config (nil: every owner for itself), the team names once
	--- assign_teams ran, the team that won, and per team the players put on it so far (their shades).
	self.team_config = cfg.teams
	self.team_mode = cfg.teams ~= nil
	self.team_names = {} :: { string }
	self.winner_team = 0
	self._team_n = {} :: { [number]: number }
	self.nation_limit = if type(cfg.nation_limit) == "number" then math.max(Defs.trunc(cfg.nation_limit), 0) else nil
	--- Wall-clock microseconds of the last step() (diagnostics).
	self.last_step_usec = 0
	--- When true, step() accumulates per-subsystem microseconds into `prof` (see PROF_NAMES).
	self.profile = false
	self.prof = table.create(#Sim.PROF_NAMES, 0)
	self._intents = {} :: { { any } }
	self._human_disk = {} :: { [number]: { number } }
	self._human_colors = {} :: { number }
	--- Humans whose start disk is claimed at the beginning of the next tick (their colour is chosen
	--- at the pick, and a re-sent OWNER_ADD must reach the mirror while they hold no land).
	--- id → tile, plus the ids in pick order (GDScript Dictionary insertion order).
	self._pending_spawn = {} :: { [number]: number }
	--- bot player id → spawn-phase ticks left at which it takes its random start
	self._bot_spawn_at = {} :: { [number]: number }
	self._pending_order = {} :: { number }
	--- humans given a random start because they never picked (a message says so when they land)
	self._auto_placed = {} :: { [number]: boolean }
	self._force_stats = false
	self.last_capitulation = -100000

	-- Coop.check(): Session builds local matches inside a Coop job (time-sliced over frames);
	-- a no-op elsewhere (server, Lune).
	self:_init_state(p_map)
	Coop.check()
	self:_init_attacks()
	self:_init_structures()
	Coop.check()
	self:_init_naval()
	Coop.check()
	self:_init_warships()
	self:_init_nukes()
	self:_init_arsenal()
	Coop.check()
	if type(cfg.defense_posts_shoot) == "boolean" then
		self.defense_posts_shoot = cfg.defense_posts_shoot
	else
		self.defense_posts_shoot = Rules.DEFENSE_POST_SHOOTS
	end
	self:_make_human_palette()
	-- Nations turned off in the config (nations = false): no manifest nations.
	if cfg.nations ~= false then
		self:_create_nations()
	end
	Coop.check()
	self:_create_tribes()
	Coop.check()
	self.ai = SimAI.new()
	self.ai:setup(self)
	Coop.check()
	if self.max_humans == 0 then
		self:_start_playing()
	else
		self.phase = Defs.PHASE_SPAWN
		self.spawn_left = if self.solo then -1 else self.spawn_total
		if not self.solo and self.time_limit_s > 0 then
			self.time_limit_ticks = self.spawn_total + self.time_limit_s * TICK_RATE
		end
	end
	-- The initial state travels in snapshot(); start the first delta clean.
	self.d_tiles = {}
	self.d_flags = {}
	self.d_ev = {}
	table.clear(self.pending_out)
	return self
end

--- Default tribe count for `map`: Rules.DEFAULT_TRIBES (400 on a map at
--- full size). A smaller build ("id@80") gets fewer in proportion to its area, so compact
--- maps (a quarter of the area) get 100.
function Sim.default_tribes(map: any): number
	local s = if type(map) == "table" then (tonumber(map.scale) or 1.0) else 1.0
	return math.floor(Rules.DEFAULT_TRIBES * s * s + 0.5)
end

-- =============================================================================================
-- Public API
-- =============================================================================================

--- Registers a human (not yet spawned). Re-joining with the same key returns the same id.
function Sim.add_human(self: any, key: string, display_name: string): number
	local old = self.human_keys[key]
	if old ~= nil then
		if self.o_alive[old] == 1 then
			-- Reconnect: the (possibly passive) nation is theirs again.
			self.o_left[old] = 0
			return old
		end
		if self.o_spawned[old] == 0 then
			-- Joined and left before spawning: revive the same id instead of burning a new one.
			self.o_alive[old] = 1
			self.o_left[old] = 0
			self.o_troops[old] = Rules.START_TROOPS_HUMAN
			self.o_gold[old] = Rules.START_GOLD
			self:ev({ Ev.OWNER_ADD, old, self.o_name[old], self.o_color[old], Defs.KIND_HUMAN, self.o_team[old] })
			return old
		end
	end
	local cols = self._human_colors
	local col = cols[#self.humans % #cols + 1]
	local nm = if type(display_name) == "string" and display_name ~= "" then display_name else "Commander"
	local id = self:add_owner(nm, col, Defs.KIND_HUMAN)
	if id <= 0 then
		return 0
	end
	self.human_keys[key] = id
	table.insert(self.humans, id)
	self.o_troops[id] = Rules.START_TROOPS_HUMAN
	return id
end

--- Registers a bot player: an AI commander that looks like a human player everywhere (kind HUMAN,
--- human troops / colours, a player-style name) and plays like an AI nation. It picks a random start
--- at a random moment of the spawn phase, like a person would (public matches fill empty slots with
--- these; they are meant to be indistinguishable from players).
--- Public matches were too hard for new players with every bot player on the nation AI at full human
--- strength (2026-09-27): only SMART_BOTS of them play like that; the rest are novices — the
--- Easy nation AI (slow attacks, long peace with humans, few boats, no warship hunting, late nukes)
--- with Easy nation troop numbers (half the troop cap, x0.9 growth, 12.5K to start).
Sim.SMART_BOTS = 2
Sim.NOVICE_SKILL = 0
--- Smart bot players play at this difficulty whatever the match's (public matches run Easy nations).
Sim.SMART_SKILL = 1
--- Towards players, though, they are no harsher than Rules.SMART_VS_PLAYERS' AI (human_difficulty).

--- The AI difficulty `id` plays at (its own for bot players, else the match's).
function Sim.ai_difficulty(self: any, id: number): number
	local s = self.o_skill[id]
	return if s ~= nil and s >= 0 then s else self.difficulty
end

--- The difficulty whose human-protection rules `id` follows (Rules.SMART_VS_PLAYERS for a smart bot
--- player, else the one it plays at).
function Sim.human_difficulty(self: any, id: number): number
	local d = self:ai_difficulty(id)
	if self.o_bot[id] == 1 and self.o_skill[id] ~= Sim.NOVICE_SKILL then
		return math.min(d, Rules.SMART_VS_PLAYERS)
	end
	return d
end

--- A novice bot player (weaker troop numbers).
function Sim.is_novice_bot(self: any, id: number): boolean
	return self.o_bot[id] == 1 and self.o_skill[id] == Sim.NOVICE_SKILL
end

--- Troops `id` starts with (novice bot players: the Easy nation start).
function Sim._start_troops_of(self: any, id: number): number
	if self:is_novice_bot(id) then
		return Rules.start_troops(Defs.KIND_NATION, Sim.NOVICE_SKILL)
	end
	return Rules.START_TROOPS_HUMAN
end

--- `smart`: plays like a nation at the match's difficulty with human troop numbers; otherwise a
--- novice (see SMART_BOTS).
function Sim.add_bot_player(self: any, display_name: string, smart: boolean?): number
	local id = self:add_human("bot:" .. tostring(self.owner_total + 1) .. ":" .. display_name, display_name)
	if id <= 0 then
		return 0
	end
	self.o_ai[id] = 1
	self.o_bot[id] = 1
	self.o_skill[id] = if smart == false then Sim.NOVICE_SKILL else Sim.SMART_SKILL
	self.o_troops[id] = self:_start_troops_of(id)
	-- spawn when this many spawn-phase ticks are left (between 85% and 15% of the phase)
	local total = self.spawn_total
	self._bot_spawn_at[id] = self.rng:randi_range(math.floor(total * 0.15), math.floor(total * 0.85))
	return id
end

--- Adds `n` bot players with names from `names` (1-based; missing names get generated ones): SMART_BOTS
--- of them (random picks) smart, the rest novices.
function Sim.add_bot_players(self: any, n: number, names: { string }?): { number } -- (their ids)
	local out = {}
	local smart = {}
	local left = math.min(Sim.SMART_BOTS, n)
	for k = 1, n do
		-- k is smart with probability (smart still to place) / (bots still to add)
		if left > 0 and self.rng:randi() % (n - k + 1) < left then
			smart[k] = true
			left -= 1
		end
	end
	for k = 1, n do
		local nm = if names and names[k] then names[k] else ("Player" .. tostring(1000 + k))
		local id = self:add_bot_player(nm, smart[k] == true)
		if id <= 0 then
			break
		end
		table.insert(out, id)
	end
	return out
end

--- Human left: their nation (if any) stays as a passive, AI-less nation.
function Sim.remove_human(self: any, owner_id: number)
	if owner_id <= 0 or owner_id > self.owner_total or self.o_kind[owner_id] ~= Defs.KIND_HUMAN then
		return
	end
	self.o_left[owner_id] = 1
	if self.o_spawned[owner_id] == 0 and self.o_alive[owner_id] == 1 then
		self.o_alive[owner_id] = 0
		self:ev({ Ev.OWNER_OUT, owner_id, 0 })
	end
end

--- A paid takeover of the nation that eliminated you (2026-09-28; public matches too, provided
--- the target is an AI): the fallen human `old` takes command of AI nation `target` — its land, troops,
--- gold, structures and alliances stay; its AI stops and it plays by human rules from now on, under
--- the player's name (its colour stays). Nations only: never a tribe, never a bot player (in a public
--- match that would give the bot away as not a person). True when done.
function Sim.can_take_over(self: any, old: number, target: number): boolean
	return self.phase == Defs.PHASE_PLAYING
		and old > 0
		and old <= self.owner_total
		and self.o_kind[old] == Defs.KIND_HUMAN
		and self.o_alive[old] == 0
		and target > 0
		and target <= self.owner_total
		and self.o_kind[target] == Defs.KIND_NATION
		and self.o_alive[target] == 1
		and self.o_spawned[target] == 1
		and self.o_tiles[target] > 0
end

function Sim.take_over(self: any, old: number, target: number): boolean
	if not self:can_take_over(old, target) then
		return false
	end
	self.o_kind[target] = Defs.KIND_HUMAN
	-- the nation plays with its new commander's Arsenal
	self.o_unlock[target] = self.o_unlock[old]
	self.o_ai[target] = 0
	self.o_skill[target] = -1
	self.o_left[target] = 0
	for key, id in self.human_keys do
		if id == old then
			self.human_keys[key] = target
		end
	end
	table.insert(self.humans, target)
	-- it goes by the player's name from now on (2026-09-28: the nation is renamed to the taker's
	-- username); its colour stays
	local was = self.o_name[target]
	self.o_name[target] = self.o_name[old]
	self:ev({ Ev.OWNER_ADD, target, self.o_name[target], self.o_color[target], Defs.KIND_HUMAN, self.o_team[target] })
	self:msg(target, Defs.MSG_GOOD, "You took over " .. was)
	return true
end

--- Queues an intent dictionary for the next step().
function Sim.submit(self: any, owner_id: number, intent: { [string]: any })
	table.insert(self._intents, { owner_id, intent })
end

--- Solo convenience: place (or move) the human's start immediately. True when accepted.
function Sim.human_start(self: any, owner_id: number, tile: number): boolean
	return self:_intent_spawn(owner_id, tile)
end

--- Ticks until the spawn phase ends (-1 while a solo match waits for the pick; 0 once playing).
function Sim.spawn_ticks_left(self: any): number
	return if self.phase == Defs.PHASE_SPAWN then self.spawn_left else 0
end

--- Number of owner ids allocated (valid ids are 1..owner_count()).
function Sim.owner_count(self: any): number
	return self.owner_total
end

--- Advances one tick and returns the delta {t, tiles, flags, stats?, ev} (see READY-core-api).
function Sim.step(self: any): { [string]: any }
	local t0 = clock_us()
	self.tick += 1
	local tick = self.tick
	if self.phase ~= Defs.PHASE_OVER then
		self.path_budget = 2
		if tick % 10 == 0 then
			self:refill_boat_tokens()
		end
		self:_claim_pending_spawns()
		if self.profile then
			self:_step_profiled()
		else
			-- A tick first advances what is already under way (the troop
			-- and gold income first: it starts at spawn) and only then starts the actions
			-- of this turn's intents, so income is computed on the troops held before this tick's
			-- orders (and a city finishing now raises the cap from the next tick).
			if self.phase == Defs.PHASE_PLAYING then
				self:_economy_tick()
				self:_alliances_tick()
			end
			self:_process_intents()
			if self.phase == Defs.PHASE_SPAWN then
				self:_spawn_phase_tick()
			else
				self:construction_tick()
				self.ai:tick(self)
				self:attacks_tick()
				self:units_tick()
				self:warships_tick()
				self:ports_tick()
				self:factories_tick()
				self:arsenal_tick()
				self:nukes_tick()
				self:_diplomacy_tick()
				self:_process_eliminations()
				if tick % 10 == 0 then
					self:_check_victory()
				end
			end
		end
	else
		table.clear(self._intents)
	end
	local d: { [string]: any } = { t = tick, tiles = self.d_tiles, flags = self.d_flags, ev = self.d_ev }
	if tick % 5 == 0 or self._force_stats then
		d.stats = self:_stats_rows()
		self._force_stats = false
	end
	self.d_tiles = {}
	self.d_flags = {}
	self.d_ev = {}
	self.last_step_usec = clock_us() - t0
	return d
end

function Sim._step_profiled(self: any)
	local t = clock_us()
	if self.phase == Defs.PHASE_PLAYING then
		self:_economy_tick()
		self:_alliances_tick()
	end
	t = self:_lap(2, t)
	self:_process_intents()
	t = self:_lap(1, t)
	if self.phase == Defs.PHASE_SPAWN then
		self:_spawn_phase_tick()
		return
	end
	self:construction_tick()
	t = self:_lap(2, t)
	self.ai:tick(self)
	t = self:_lap(3, t)
	self:attacks_tick()
	t = self:_lap(4, t)
	self:units_tick()
	self:warships_tick()
	t = self:_lap(5, t)
	self:ports_tick()
	t = self:_lap(6, t)
	self:factories_tick()
	t = self:_lap(7, t)
	self:arsenal_tick()
	self:nukes_tick()
	t = self:_lap(8, t)
	self:_diplomacy_tick()
	self:_process_eliminations()
	if self.tick % 10 == 0 then
		self:_check_victory()
	end
	self:_lap(9, t)
end

--- slot is 1-based (PROF_NAMES[slot]).
function Sim._lap(self: any, slot: number, since: number): number
	local now = clock_us()
	self.prof[slot] += now - since
	return now
end

--- Full state for GameState:load_snapshot() / late joiners (see READY-core-api for the shape).
function Sim.snapshot(self: any): { [string]: any }
	local owners = {}
	for id = 1, self.owner_total do
		table.insert(owners, {
			id,
			self.o_name[id],
			self.o_color[id],
			self.o_kind[id],
			self.o_team[id],
			self.o_alive[id] == 1,
			self.o_tiles[id],
			Defs.trunc(self.o_troops[id]),
			self:_gold_int(id),
			Defs.trunc(self.o_cap[id]),
			Defs.trunc(self.o_income[id] + self.o_bonus_rate[id]),
			self.o_traitor_until[id],
			if self.o_spawned[id] == 1 then self.o_spawn_tile[id] else -1,
		})
	end
	-- allies: {a, b, expires_at, renewal asked bits}; requests: {from, to, tick made}
	local allies = {}
	for _, k in self:_ordered_keys(self.alliances) do
		table.insert(allies, { k // 1024, k % 1024, self.ally_expires[k], self.ally_ext[k] })
	end
	local reqs = {}
	for _, k in self:_ordered_keys(self.requests) do
		table.insert(reqs, { k // 1024, k % 1024, self.requests[k] })
	end
	local n = self.N
	local fl = buffer.create(n)
	buffer.copy(fl, 0, self.flags, 0, n)
	return {
		map_id = self.map.id,
		map_w = self.W,
		map_h = self.H,
		t = self.tick,
		phase = self.phase,
		phase_left = self:spawn_ticks_left(),
		time_limit_ticks = self.time_limit_ticks,
		playing_since = self.playing_since,
		mirvs_launched = self.mirvs_launched,
		built = self:built_rows(),
		winner = self.winner,
		over_reason = self.over_reason,
		teams = if #self.team_names > 0 then self.team_names else nil,
		winner_team = if self.winner_team ~= 0 then self.winner_team else nil,
		owner = GameState.encode_grid(self.owner),
		flags = fl,
		owners = owners,
		structs = self:struct_rows(),
		roads = self:road_rows(),
		units = self:unit_rows(),
		nukes = self:nuke_rows(),
		shells = self:shell_rows(),
		sam_missiles = self:sam_rows(),
		attacks = self:attack_rows(),
		allies = allies,
		requests = reqs,
	}
end

-- =============================================================================================
-- Setup
-- =============================================================================================

local HUMAN_HEX = {
	"#ffd23f",
	"#3bceac",
	"#ee4266",
	"#5e60ce",
	"#f77f00",
	"#80ed99",
	"#ff99c8",
	"#00b4d8",
	"#c77dff",
	"#f9c74f",
	"#e63946",
	"#90be6d",
	"#ff6d00",
	"#4cc9f0",
	"#b5179e",
	"#fcbf49",
}

function Sim._make_human_palette(self: any)
	for _, h in HUMAN_HEX do
		table.insert(self._human_colors, Defs.html_rgba(h))
	end
end

-- Nation colours by ISO code (the authored palette, Data/Nations), for flags that match.
local NATION_COLOR: { [string]: string } = {}
for _, nd in Nations :: any do
	if type(nd) == "table" and nd.code ~= nil and nd.color ~= nil then
		NATION_COLOR[string.lower(tostring(nd.code))] = tostring(nd.color)
	end
end

--- Nations of the map's manifest: each starts on free land picked by
--- _nation_spawn_land() around its coordinates (random tiles within +-NATION_SPAWN_DELTA, 50 tries,
--- mountains skipped half the time; failing that the nearest free land, then a random start), or at
--- a random start when it has no coordinates. Colours: the authored colour of the flag's country
--- (minimal nudge away from neighbours), else the nation-style candidate most distinct from them.
function Sim._create_nations(self: any)
	local R = self.R
	local list = self.map:load_nations()
	local limit = self.nation_limit
	if limit ~= nil and limit < #list then
		-- (Humans Vs Nations: as many nations as players, picked at random)
		local pool = table.clone(list)
		for i = #pool, 2, -1 do
			local j = self.rng:randi_range(1, i)
			pool[i], pool[j] = pool[j], pool[i]
		end
		list = table.move(pool, 1, limit, 1, {})
	end
	local picked = {} :: { [number]: boolean }
	for _, nd in list do
		if type(nd) ~= "table" then
			continue
		end
		local hex = if nd.flag ~= nil then NATION_COLOR[string.lower(tostring(nd.flag))] else nil
		local col = if hex ~= nil then Defs.html_rgba(hex) else 0x888888FF
		local id = self:add_owner(tostring(nd.name or "Nation"), col, Defs.KIND_NATION)
		if id <= 0 then
			break
		end
		picked[id] = hex ~= nil
		self.nation_count += 1
		Coop.check()
		self.o_troops[id] = Rules.start_troops(Defs.KIND_NATION, self.difficulty)
		local t = -1
		local at = tonumber(nd.tile) or -1
		if at >= 0 and at < self.N then
			t = self:_nation_spawn_land(at)
			if t < 0 then
				t = self:_nearest_free_land(at, math.ceil(2 * R.NATION_SPAWN_DELTA))
			end
		end
		if t < 0 then
			t = self:_random_start(id)
		end
		if t >= 0 then
			self:_spawn_owner(id, t, R.SPAWN_RADIUS)
		end
	end
	for id = 1, self.owner_total do
		if self.o_spawn_tile[id] < 0 then
			continue
		end
		Coop.check()
		local refs = self:_colour_refs(id, Sim.COLOR_NEAR_NATION)
		if picked[id] then
			-- Authored colours stay unless a nearby capital's colour is too similar (minimal nudge).
			self.o_color[id] = SimColors.nudge(self.o_color[id], refs)
		else
			self.o_color[id] = SimColors.pick(SimColors.human_palette(), refs, self.rng)
		end
	end
end

--- A nation's spawn land: a free, contestable tile within +-NATION_SPAWN_DELTA of `t`
--- (50 tries; a mountain is skipped half the time), or -1.
function Sim._nation_spawn_land(self: any, t: number): number
	local W, H = self.W, self.H
	local cx = t % W
	local cy = t // W
	local d = math.max(1, math.floor(self.R.NATION_SPAWN_DELTA + 0.5))
	local rng = self.rng
	local owner = self.owner
	local terr = self.terr
	for _ = 1, 50 do
		local x = rng:randi_range(cx - d, cx + d - 1)
		local y = rng:randi_range(cy - d, cy + d - 1)
		if x < 0 or y < 0 or x >= W or y >= H then
			continue
		end
		local c = y * W + x
		if not self:claimable(c) or readi32(owner, c * 4) ~= 0 then
			continue
		end
		if buffer.readu8(terr, c) == Defs.T_MOUNTAIN and rng:randi() % 2 == 0 then
			continue
		end
		return c
	end
	return -1
end

--- A random start (for tribes, unplaced nations and humans who never
--- picked): of 1000 random tiles of the whole map, the first that is free land, not
--- next to anyone's land, whose whole spawn disk is free land, and (for the first 750 tries) at
--- least TRIBE_SPAWN_MIN_DIST (manhattan) from every other start. -1 when none is found.
function Sim._random_start(self: any, id: number): number
	local map = self.map
	if map.land_count <= 0 then
		return -1
	end
	local N = self.N
	local rng = self.rng
	local owner = self.owner
	local geo_manhattan = self.geo_manhattan
	local min_d = self.R.TRIBE_SPAWN_MIN_DIST
	local r = self.R.SPAWN_RADIUS
	local o_spawn_tile = self.o_spawn_tile
	local o_spawned = self.o_spawned
	local total = self.owner_total
	for tries = 1, 1000 do
		if tries % 50 == 0 then
			Coop.check()
		end
		local c = rng:randi() % N
		if not self:claimable(c) or readi32(owner, c * 4) ~= 0 or self:_owned_near(c) then
			continue
		end
		if tries <= 750 then
			local near = false
			for o = 1, total do
				if o ~= id and o_spawned[o] == 1 then
					local st = o_spawn_tile[o]
					if st >= 0 and geo_manhattan(st, c) < min_d then
						near = true
						break
					end
				end
			end
			if near then
				continue
			end
		end
		if self:_spawn_disk_free(c, r) then
			return c
		end
	end
	return -1
end

--- True when a 4-neighbour of `t` is owned (an unowned tile on someone's border).
function Sim._owned_near(self: any, t: number): boolean
	local owner = self.owner
	local W = self.W
	local x = t % W
	if x > 0 and readi32(owner, (t - 1) * 4) ~= 0 then
		return true
	end
	if x < W - 1 and readi32(owner, (t + 1) * 4) ~= 0 then
		return true
	end
	if t >= W and readi32(owner, (t - W) * 4) ~= 0 then
		return true
	end
	if t < self.N - W and readi32(owner, (t + W) * 4) ~= 0 then
		return true
	end
	return false
end

--- The spawn disk: every tile within euclidean distance `radius` of the corner of the
--- start tile, as a 1-based array (inside the map).
function Sim._spawn_disk(self: any, center: number, radius: number): { number }
	local W, H = self.W, self.H
	local cx = center % W
	local cy = center // W
	local r2 = radius * radius
	local ri = math.ceil(radius) + 1
	local out = {}
	for dy = -ri, ri do
		local y = cy + dy
		if y < 0 or y >= H then
			continue
		end
		local fy = dy + 0.5
		for dx = -ri, ri do
			local x = cx + dx
			if x < 0 or x >= W then
				continue
			end
			local fx = dx + 0.5
			if fx * fx + fy * fy <= r2 then
				table.insert(out, y * W + x)
			end
		end
	end
	return out
end

--- True when every tile of the spawn disk around `c` is free contestable land.
function Sim._spawn_disk_free(self: any, c: number, radius: number): boolean
	local owner = self.owner
	for _, t in self:_spawn_disk(c, radius) do
		if readi32(owner, t * 4) ~= 0 or not self:claimable(t) then
			return false
		end
	end
	return true
end

--- Tribes: `tribe_count` tribes at random starts (Sim._random_start).
function Sim._create_tribes(self: any)
	local names = WorldMap.load_tribe_names()
	local rng = self.rng
	local order = {}
	for i = 0, #names - 1 do
		order[i] = i
	end
	for i = #names - 1, 1, -1 do
		local j = rng:randi() % (i + 1)
		order[i], order[j] = order[j], order[i]
	end
	local spawn_r = self.R.SPAWN_RADIUS
	local nn = #names
	for k = 0, self.tribe_count - 1 do
		local tribe_name
		if nn > 0 then
			tribe_name = names[order[k % nn] + 1]
			if k >= nn then
				tribe_name ..= " " .. tostring(k // nn + 1)
			end
		else
			tribe_name = "Tribe " .. tostring(k + 1)
		end
		local id = self:add_owner(tribe_name, Sim.TRIBE_COLOR, Defs.KIND_TRIBE)
		if id <= 0 then
			break
		end
		self.o_troops[id] = Rules.START_TROOPS_TRIBE
		Coop.check()
		local t = self:_random_start(id)
		if t >= 0 then
			self:_spawn_owner(id, t, spawn_r)
		end
		if self.o_spawned[id] == 0 or self.o_tiles[id] == 0 then
			-- No room left: this tribe never existed as far as the match is concerned.
			self.o_alive[id] = 0
		end
	end
end

--- `radius` in tiles of the original 1024-wide grid (scaled by the map's LEGACY_LIN).
function Sim._colour_refs(self: any, id: number, radius: number, kind: number?): { any }
	return SimColors.refs_near(self, id, radius * self.R.LEGACY_LIN, kind or -1)
end

--- True when nobody owns a tile within `r` (latitude-corrected) of `t`.
function Sim._area_free(self: any, t: number, r: number): boolean
	local owner = self.owner
	for _, c in self:disk_tiles(t, r, false) do
		if readi32(owner, c * 4) ~= 0 then
			return false
		end
	end
	return true
end

function Sim._nearest_free_land(self: any, t: number, r: number): number
	local owner = self.owner
	if self:claimable(t) and readi32(owner, t * 4) == 0 then
		return t
	end
	local W, H = self.W, self.H
	local cx = t % W
	local cy = t // W
	for rr = 1, r do
		for dy = -rr, rr do
			local y = cy + dy
			if y < 0 or y >= H then
				continue
			end
			for dx = -rr, rr do
				if math.max(math.abs(dx), math.abs(dy)) ~= rr then
					continue
				end
				local x = cx + dx
				if x < 0 or x >= W then
					continue
				end
				local c = y * W + x
				if self:claimable(c) and readi32(owner, c * 4) == 0 then
					return c
				end
			end
		end
	end
	return -1
end

--- Claims the unowned claimable tiles of the spawn disk (_spawn_disk); returns the
--- tiles claimed (1-based).
function Sim._claim_disk(self: any, id: number, center: number, radius: number): { number }
	local owner = self.owner
	local out = {}
	for _, c in self:_spawn_disk(center, radius) do
		if readi32(owner, c * 4) == 0 and self:claimable(c) then
			self:set_owner(c, id)
			table.insert(out, c)
		end
	end
	return out
end

function Sim._spawn_owner(self: any, id: number, t: number, radius: number): { number }
	local got = self:_claim_disk(id, t, radius)
	self.o_spawned[id] = 1
	self.o_spawn_tile[id] = t
	self:ev({ Ev.SPAWNED, id, t })
	return got
end

-- =============================================================================================
-- Intents
-- =============================================================================================

function Sim._process_intents(self: any)
	if #self._intents == 0 then
		return
	end
	local list = self._intents
	self._intents = {}
	for _, e in list do
		local id = e[1]
		if type(id) ~= "number" or id <= 0 or id > self.owner_total then
			continue
		end
		local it = e[2]
		if type(it) ~= "table" then
			continue
		end
		self:_apply_intent(id, it)
	end
end

--- Typed, finite reads from untrusted intent dictionaries (wrong types or NaN → default).
local function _num(it: { [string]: any }, key: string, default: number): number
	local v = it[key]
	if type(v) ~= "number" or not Defs.is_finite(v) then
		return default
	end
	return v
end
Sim._num = _num

local function _int(it: { [string]: any }, key: string, default: number): number
	local v = it[key]
	if type(v) == "number" and Defs.is_finite(v) then
		return Defs.trunc(v)
	end
	return default
end
Sim._int = _int

local function _str(it: { [string]: any }, key: string): string
	local v = it[key]
	return if type(v) == "string" then v else ""
end
Sim._str = _str

--- The most levels / bombs one intent can ask for (Protocol caps the wire).
Sim.MAX_INTENT_AMOUNT = 50

function Sim._apply_intent(self: any, id: number, it: { [string]: any })
	local kind = _str(it, "type")
	local tile = _int(it, "tile", -1)
	if kind == "spawn" then
		self:_intent_spawn(id, tile)
		return
	end
	if self.phase ~= Defs.PHASE_PLAYING or self.o_alive[id] == 0 or self.o_spawned[id] == 0 then
		return
	end
	if kind == "attack" then
		self:intent_attack(id, tile, _num(it, "ratio", Rules.DEFAULT_ATTACK_RATIO))
	elseif kind == "boat" then
		self:launch_boat(id, tile, _num(it, "ratio", Rules.DEFAULT_ATTACK_RATIO))
	elseif kind == "build" then
		-- `amount`: a bulk upgrade (level after level, each at the
		-- next price, until one can't be afforded); only ever more than one level on an existing
		-- structure
		local kname = _str(it, "kind")
		local ok, upgraded = self:try_build(id, kname, tile)
		local n = math.clamp(_int(it, "amount", 1), 1, Sim.MAX_INTENT_AMOUNT)
		for _ = 2, n do
			if not ok or not upgraded then
				break
			end
			ok, upgraded = self:try_build(id, kname, tile)
		end
	elseif kind == "nuke" then
		-- `amount`: stacked atom bombs (several at one target, each from a loaded silo)
		local kname = _str(it, "kind")
		local n = if kname == "atom" then math.clamp(_int(it, "amount", 1), 1, Sim.MAX_INTENT_AMOUNT) else 1
		for _ = 1, n do
			if not self:launch_nuke(id, kname, tile) then
				break
			end
		end
	elseif kind == "retreat" then
		self:retreat(id, _int(it, "attack_id", 0))
	elseif kind == "move_warship" then
		self:move_warship(id, _int(it, "uid", 0), tile)
	elseif kind == "ally_request" then
		self:ally_request(id, _int(it, "target", 0))
	elseif kind == "ally_reply" then
		self:ally_reply(id, _int(it, "target", 0), it.accept == true)
	elseif kind == "ally_break" then
		self:ally_break(id, _int(it, "target", 0))
	elseif kind == "ally_extend" then
		self:ally_extend(id, _int(it, "target", 0))
	elseif kind == "donate" then
		self:donate(id, _int(it, "target", 0), _int(it, "troops", 0))
	elseif kind == "reinforce" then
		self:reinforce(id)
	end
end

function Sim._set_pending(self: any, id: number, t: number)
	if self._pending_spawn[id] == nil then
		table.insert(self._pending_order, id)
	end
	self._pending_spawn[id] = t
end

function Sim._intent_spawn(self: any, id: number, t: number): boolean
	if
		id <= 0
		or id > self.owner_total
		or self.o_kind[id] ~= Defs.KIND_HUMAN
		or self.o_alive[id] == 0
		or self.o_left[id] == 1
	then
		return false
	end
	if t < 0 or t >= self.N or t ~= t or not self:claimable(t) then
		return false
	end
	local owner = self.owner
	if self.phase == Defs.PHASE_SPAWN then
		local o = readi32(owner, t * 4)
		if o ~= 0 and o ~= id then
			return false
		end
		local disk = self._human_disk[id]
		if disk ~= nil then
			for _, c in disk do
				if readi32(owner, c * 4) == id then
					self:set_owner(c, 0)
				end
			end
			self._human_disk[id] = nil
		end
		self.o_spawned[id] = 0
		self:_recolor_human(id, t)
		self:_set_pending(id, t)
		self.o_troops[id] = self:_start_troops_of(id)
		if self.solo and self.spawn_left < 0 then
			self.spawn_left = self.solo_countdown
			self:ev({ Ev.PHASE, Defs.PHASE_SPAWN, self.spawn_left })
		end
		return true
	end
	if
		self.phase == Defs.PHASE_PLAYING
		and self.o_spawned[id] == 0
		and readi32(owner, t * 4) == 0
		and self._pending_spawn[id] == nil
	then
		self:_recolor_human(id, t)
		self:_set_pending(id, t)
		self.o_troops[id] =
			math.max(Rules.START_TROOPS_HUMAN * 0.5, self:_median_nation_troops() * Rules.LATE_JOIN_TROOP_FRACTION)
		self.o_gold[id] = Rules.START_GOLD
		return true
	end
	return false
end

function Sim._claim_pending_spawns(self: any)
	if #self._pending_order == 0 then
		return
	end
	local owner = self.owner
	for _, id in self._pending_order do
		local t = self._pending_spawn[id]
		if t == nil or self.o_alive[id] == 0 or self.o_left[id] == 1 then
			continue
		end
		if readi32(owner, t * 4) ~= 0 or not self:claimable(t) then
			t = self:_nearest_free_land(t, math.ceil(6 * self.R.LEGACY_LIN))
		end
		if t < 0 then
			self:msg(id, Defs.MSG_INFO, "That land was just taken — pick another spot")
			continue
		end
		self._human_disk[id] = self:_spawn_owner(id, t, self.R.SPAWN_RADIUS)
		if self.phase == Defs.PHASE_PLAYING and not self.solo then
			-- (one placed when the spawn phase ended, or a late joiner: from its first tick in play)
			self.o_shield_until[id] = self.tick + Rules.SPAWN_SHIELD_TICKS
		end
		if self._auto_placed[id] then
			self._auto_placed[id] = nil
			self:msg(id, Defs.MSG_GOOD, "You didn't pick a start, so you were placed here.")
		elseif self.phase == Defs.PHASE_PLAYING then
			self:msg(
				id,
				Defs.MSG_GOOD,
				if self:shielded(id)
					then string.format(
						"You have landed. Expand into free land! No one can attack you for %d s",
						Rules.SPAWN_SHIELD_TICKS // TICK_RATE
					)
					else "You have landed. Expand into free land!"
			)
		end
	end
	table.clear(self._pending_spawn)
	table.clear(self._pending_order)
	self._force_stats = true
end

--- Naval hooks → AI (the nations' warship behaviour).
function Sim._on_transport_sunk(self: any, u: any, killer: number)
	self.ai:on_transport_sunk(self, u, killer)
end

function Sim._on_trade_captured(self: any, victim: number, captor: number, t: number)
	self.ai:on_trade_captured(self, victim, captor, t)
end

function Sim._on_transport_launched(self: any, u: any, target_owner: number)
	self.ai:on_transport_launched(self, u, target_owner)
end

--- No transport lands on a person under their spawn shield; AI transports may only open a new war
--- on a human within the AI's human-protection rules.
function Sim._landing_allowed(self: any, id: number, tg: number): boolean
	if self:shielded(tg) then
		return false
	end
	if self.o_ai[id] == 0 or not self:is_human(tg) or self:attack_between(id, tg) ~= nil then
		return true
	end
	return self.ai:may_attack_human(self, id, tg)
end

--- Picks human `id`'s colour for a start at `t` (see SimColors.for_human). A changed colour is
--- announced by re-sending OWNER_ADD (the mirror updates the entry in place).
function Sim._recolor_human(self: any, id: number, t: number)
	if self.team_mode and self.o_team[id] ~= 0 then
		-- (a team game: the team's colour stays)
		return
	end
	self:set_owner_color(id, SimColors.for_human(self, id, t, Sim.COLOR_NEAR_HUMAN))
end

-- =============================================================================================
-- Teams (team games; Core/Teams)
-- =============================================================================================

--- Bot players' random starts tried for one near a teammate (see Teams).
Sim.TEAM_START_TRIES = 8

--- Puts `id` on team `t` and gives it the team's next shade (re-sends OWNER_ADD with the team).
function Sim._set_team(self: any, id: number, t: number)
	local n = self._team_n[t] or 0
	self._team_n[t] = n + 1
	self.o_team[id] = t
	self.o_color[id] = Teams.color(self.team_names[t] or "", t, n)
	self:ev({ Ev.OWNER_ADD, id, self.o_name[id], self.o_color[id], self.o_kind[id], t })
end

--- A team game: every player onto a team, once, after the humans and the bot players are in (the
--- humans in join order, the bot players filling the places left; Humans Vs Nations: the humans and
--- bot players against the nations). `groups`: human id → the key of the party it joined with.
function Sim.assign_teams(self: any, groups: { [number]: string }?)
	if not self.team_mode or #self.team_names > 0 then
		return
	end
	local cfg = self.team_config
	if cfg == Teams.HVN then
		self.team_names = Teams.resolve(cfg, 0)
		for _, h in self.humans do
			self:_set_team(h, 1)
		end
		for id = 1, self.owner_total do
			if self.o_kind[id] == Defs.KIND_NATION then
				self:_set_team(id, 2)
			end
		end
		return
	end
	local players = {}
	for _, h in self.humans do
		table.insert(players, { id = h, group = if groups then groups[h] else nil, filler = self.o_bot[h] == 1 })
	end
	-- (nations, when a team game has them, fill like bot players, after all humans)
	for id = 1, self.owner_total do
		if self.o_kind[id] == Defs.KIND_NATION then
			table.insert(players, { id = id, filler = true })
		end
	end
	self.team_names = Teams.resolve(cfg, #players)
	local rng = self.rng
	local out = Teams.assign(players, #self.team_names, Teams.packs(cfg), function(list)
		for i = #list, 2, -1 do
			local j = rng:randi_range(1, i)
			list[i], list[j] = list[j], list[i]
		end
	end)
	for _, p in players do
		self:_set_team(p.id, out[p.id])
	end
end

--- A team game: a human who came after the teams were made joins a teammate of `group` (players it
--- came with) if one has a team, else the team with the fewest players.
function Sim.join_team(self: any, id: number, group: { number }?)
	if not self.team_mode or #self.team_names == 0 or self.o_team[id] ~= 0 then
		return
	end
	if self.team_config == Teams.HVN then
		self:_set_team(id, 1)
		return
	end
	for _, m in group or {} do
		if m ~= id and self.o_team[m] ~= 0 then
			self:_set_team(id, self.o_team[m])
			return
		end
	end
	local count = table.create(#self.team_names, 0)
	for _, h in self.humans do
		local t = self.o_team[h]
		if t ~= 0 and self.o_alive[h] == 1 then
			count[t] += 1
		end
	end
	local best = 1
	for t = 2, #self.team_names do
		if count[t] < count[best] then
			best = t
		end
	end
	self:_set_team(id, best)
end

--- Team games: a bot player's start, the nearest to a teammate already on the map of a few
--- random starts; a random start when none is there yet.
function Sim._team_start(self: any, id: number): number
	local mates = {}
	for o = 1, self.owner_total do
		if o ~= id and self.o_spawned[o] == 1 and self.o_spawn_tile[o] >= 0 and self:same_team(id, o) then
			table.insert(mates, self.o_spawn_tile[o])
		end
	end
	if #mates == 0 then
		return self:_random_start(id)
	end
	local geo_manhattan = self.geo_manhattan
	local best, bd = -1, math.huge
	for _ = 1, Sim.TEAM_START_TRIES do
		local c = self:_random_start(id)
		if c < 0 then
			break
		end
		for _, m in mates do
			local d = geo_manhattan(m, c)
			if d < bd then
				best, bd = c, d
			end
		end
	end
	return best
end

--- Team games: tiles held per team (alive owners; 1-based by team).
function Sim.team_tiles(self: any): { number }
	local sums = table.create(#self.team_names, 0)
	for id = 1, self.owner_total do
		local t = self.o_team[id]
		if t ~= 0 and self.o_alive[id] == 1 then
			sums[t] += self.o_tiles[id]
		end
	end
	return sums
end

function Sim._median_nation_troops(self: any): number
	local vals = {}
	for id = 1, self.owner_total do
		if self.o_kind[id] == Defs.KIND_NATION and self.o_alive[id] == 1 then
			table.insert(vals, self.o_troops[id])
		end
	end
	if #vals == 0 then
		return Rules.start_troops(Defs.KIND_NATION, self.difficulty)
	end
	table.sort(vals)
	return vals[#vals // 2 + 1]
end

--- Attack intent (also used by the AI). True when troops were committed.
function Sim.intent_attack(self: any, id: number, t: number, ratio: number): boolean
	if not Defs.is_finite(ratio) then
		return false
	end
	-- The client sends a ratio: that share of current troops attacks.
	return self:intent_attack_troops(id, t, self.o_troops[id] * math.clamp(ratio, 0.01, 1.0))
end

--- An attack with `amount` troops (as the AI sends it).
--- True when troops were committed.
function Sim.intent_attack_troops(self: any, id: number, t: number, amount: number): boolean
	if t < 0 or t >= self.N or buffer.readu8(self.land, t) == 0 or not Defs.is_finite(amount) then
		return false
	end
	local tg = readi32(self.owner, t * 4)
	if tg == id then
		return false
	end
	if tg ~= 0 and self:allied(id, tg) then
		self:msg(id, Defs.MSG_INFO, "You can't attack your ally " .. self.o_name[tg])
		return false
	end
	if tg ~= 0 and self.o_alive[tg] == 0 then
		return false
	end
	if self:shielded(tg) then
		self:msg(id, Defs.MSG_INFO, self:shield_text(tg))
		return false
	end
	local o_troops = self.o_troops
	-- An attack takes min(amount, home troops), floored (troops are whole numbers).
	local home = o_troops[id]
	local troops = math.floor(math.min(amount, home))
	if troops < 1.0 then
		return false
	end
	o_troops[id] -= troops
	self.dbg_flow[id * 5] += troops
	local a = self:start_attack(id, tg, troops, -1)
	if a == nil and o_troops[id] >= home - 0.5 then
		-- Refunded: there is no frontier (troops spent cancelling a counter-attack are not refunded).
		if tg ~= 0 then
			self:msg(id, Defs.MSG_INFO, "You don't border " .. self.o_name[tg] .. " — send a boat")
		else
			self:msg(id, Defs.MSG_INFO, "That land isn't next to yours — send a boat")
		end
		return false
	end
	return true
end

--- `loser` surrenders every tile to `winner` (AI endgame capitulation). The loser is eliminated
--- at the end of the tick with `winner` as the conqueror; its gold goes along.
function Sim.capitulate(self: any, loser: number, winner: number)
	if loser <= 0 or winner <= 0 or self.o_alive[loser] == 0 or self.o_alive[winner] == 0 or self:is_human(loser) then
		return
	end
	local owner = self.owner
	local tiles = {}
	local map = self.map
	local land_list = map.land_list
	for k = 0, map.land_count - 1 do
		local c = readi32(land_list, k * 4)
		if readi32(owner, c * 4) == loser then
			table.insert(tiles, c)
		end
	end
	for _, c in tiles do
		self:conquer(c, winner, nil)
	end
	self.last_capitulation = self.tick
	self.o_killer[loser] = winner
	local top = self:top_owners()
	for _, h in self.humans do
		if self.o_left[h] == 0 and self:news_relevant(h, loser, winner, top) then
			self:msg(h, Defs.MSG_INFO, self.o_name[loser] .. " surrendered to " .. self.o_name[winner])
		end
	end
end

--- Alliance request: an answer to a pending request
--- from `target` accepts it; otherwise a new request, unless one is pending or the previous request
--- to `target` was made less than ALLY_REQUEST_COOLDOWN_TICKS ago.
function Sim.ally_request(self: any, id: number, target: number): boolean
	if target <= 0 or target > self.owner_total or target == id or self.o_alive[target] == 0 then
		return false
	end
	if self:allied(id, target) or self:has_request(id, target) then
		return false
	end
	if self:has_request(target, id) then
		self:close_request(target, id)
		self:form_alliance(target, id)
		return true
	end
	local wait = self:request_cooldown_left(id, target)
	if wait > 0 then
		self:msg(
			id,
			Defs.MSG_INFO,
			string.format("You can ask %s again in %d s", self.o_name[target], math.ceil(wait / TICK_RATE))
		)
		return false
	end
	self:add_request(id, target)
	if self.o_ai[target] == 1 then
		self.ai:queue_reply(self, id, target)
	end
	return true
end

function Sim.ally_reply(self: any, id: number, target: number, accept: boolean): boolean
	if target <= 0 or target > self.owner_total or not self:has_request(target, id) then
		return false
	end
	if accept and self.o_alive[target] == 1 then
		self:close_request(target, id)
		self:form_alliance(target, id)
	else
		self:close_request(target, id)
		self:msg(target, Defs.MSG_INFO, self.o_name[id] .. " declined your alliance")
	end
	return true
end

--- Alliance renewal: `id` asks to renew its alliance with `target` (in the last
--- ALLIANCE_EXTEND_WINDOW_TICKS before it expires). Renewed once both asked; an AI ally answers a
--- request (SimAI.queue_extension). True when accepted.
function Sim.ally_extend(self: any, id: number, target: number): boolean
	if target <= 0 or target > self.owner_total then
		return false
	end
	local r = self:extend_alliance(id, target)
	if r == "asked" and self.o_ai[target] == 1 then
		self.ai:queue_extension(self, id, target)
	end
	return r ~= ""
end

function Sim.ally_break(self: any, id: number, target: number): boolean
	if not self:has_alliance(id, target) then
		return false
	end
	self:end_alliance(id, target, id)
	return true
end

function Sim.donate(self: any, id: number, target: number, troops: number): boolean
	if target <= 0 or target > self.owner_total or not self:allied(id, target) or self.o_alive[target] == 0 then
		return false
	end
	local amount = math.clamp(troops, 0.0, math.max(self.o_troops[id], 0.0))
	if amount < 1.0 then
		return false
	end
	self.o_troops[id] -= amount
	self.o_troops[target] += amount
	self:msg(target, Defs.MSG_GOOD, self.o_name[id] .. " sent you " .. NumberFormat.render_troops(amount) .. " troops")
	return true
end

-- =============================================================================================
-- Phases
-- =============================================================================================

function Sim._spawn_phase_tick(self: any)
	if self.spawn_left < 0 then
		return
	end
	self.spawn_left -= 1
	if self.spawn_left > 0 then
		if self.spawn_left % 10 == 0 then
			self:ev({ Ev.PHASE, Defs.PHASE_SPAWN, self.spawn_left })
		end
		for id, at in self._bot_spawn_at do
			if self.spawn_left <= at then
				self._bot_spawn_at[id] = nil
				if self.o_spawned[id] == 0 and self.o_alive[id] == 1 and self._pending_spawn[id] == nil then
					local t = if self.team_mode then self:_team_start(id) else self:_random_start(id)
					if t >= 0 then
						self:_recolor_human(id, t)
						self:_set_pending(id, t)
					end
				end
			end
		end
		return
	end
	-- Humans that never picked get a random start (multiplayer).
	for _, h in self.humans do
		if self.o_spawned[h] == 0 and self.o_alive[h] == 1 and self.o_left[h] == 0 then
			local t = if self.team_mode then self:_team_start(h) else self:_random_start(h)
			if t >= 0 then
				self:_recolor_human(h, t)
				self:_set_pending(h, t)
				self._auto_placed[h] = true
			end
		end
	end
	self:_start_playing()
end

function Sim._start_playing(self: any)
	self.phase = Defs.PHASE_PLAYING
	self.playing_since = self.tick
	self.spawn_left = 0
	table.clear(self.pending_out)
	if self.time_limit_s > 0 and not self.solo then
		self.time_limit_ticks = self.tick + self.time_limit_s * TICK_RATE
	end
	self:ev({ Ev.PHASE, Defs.PHASE_PLAYING, 0 })
	for id = 1, self.owner_total do
		if self.o_alive[id] == 1 and self.o_spawned[id] == 1 then
			if self.o_kind[id] == Defs.KIND_HUMAN and not self.solo then
				self.o_shield_until[id] = self.tick + Rules.SPAWN_SHIELD_TICKS
			end
			local novice = self:is_novice_bot(id)
			self.o_cap[id] = self.R.max_troops(
				if novice then Defs.KIND_NATION else self.o_kind[id],
				self.o_tiles[id],
				0,
				if novice then Sim.NOVICE_SKILL else self.difficulty
			)
			self.o_income[id] = Rules.passive_income(self.o_kind[id], self.o_tiles[id])
		end
	end
end

function Sim._economy_tick(self: any)
	local tick = self.tick
	local second = tick % 10 == 0
	local difficulty = self.difficulty
	local o_alive = self.o_alive
	local o_spawned = self.o_spawned
	local o_kind = self.o_kind
	local o_tiles = self.o_tiles
	local o_cap = self.o_cap
	local o_troops = self.o_troops
	local o_income = self.o_income
	local o_gold = self.o_gold
	local o_alevel = self.o_alevel
	local o_bonus_rate = self.o_bonus_rate
	local o_bonus_acc = self.o_bonus_acc
	local max_troops = self.R.max_troops
	local troop_growth_applied = Rules.troop_growth_applied
	local o_bot = self.o_bot
	local o_skill = self.o_skill
	local NOVICE = Sim.NOVICE_SKILL
	for id = 1, self.owner_total do
		if o_alive[id] == 0 or o_spawned[id] == 0 then
			continue
		end
		local kind = o_kind[id]
		-- (novice bot players count as Easy nations for troops; gold stays a player's)
		local tkind, tdiff = kind, difficulty
		if o_bot[id] == 1 and o_skill[id] == NOVICE then
			tkind, tdiff = Defs.KIND_NATION, NOVICE
		end
		-- maxTroops: + cityTroopIncrease per level of each finished city.
		local cap = max_troops(tkind, o_tiles[id], o_alevel[id * STRUCT_KINDS + Defs.S_CITY], tdiff)
		o_cap[id] = cap
		-- Per-tick player update: + troopIncreaseRate troops (whole troops: truncated) and
		-- + goldAdditionRate gold every tick, never during the spawn phase.
		o_troops[id] += troop_growth_applied(tkind, o_troops[id], cap, tdiff)
		if (tick + id) % 10 == 0 then
			o_income[id] = Rules.passive_income(kind, o_tiles[id])
		end
		o_gold[id] += o_income[id] / TICK_RATE
		if second then
			o_bonus_rate[id] = o_bonus_rate[id] * 0.9 + o_bonus_acc[id] * 0.1
			o_bonus_acc[id] = 0.0
		end
	end
end

function Sim._diplomacy_tick(self: any)
	local tick = self.tick
	-- (alliance and request expiry: SimState._alliances_tick, every tick)
	if tick % 600 == 0 and next(self.grudge) ~= nil then
		local stale = {}
		for k, v in self.grudge do
			if v <= tick then
				table.insert(stale, k)
			end
		end
		for _, k in stale do
			self.grudge[k] = nil
		end
	end
end

function Sim._process_eliminations(self: any)
	if #self.pending_out == 0 then
		return
	end
	local list = self.pending_out
	self.pending_out = {}
	for _, id in list do
		if self.o_alive[id] == 1 and self.o_spawned[id] == 1 and self.o_tiles[id] <= 0 then
			self:_eliminate(id, self.o_killer[id])
		end
	end
end

function Sim._eliminate(self: any, id: number, killer: number)
	-- Decide who hears about it before alliances are dissolved: humans involved, allied or
	-- bordering, or when a top-5 owner did the conquering. Tribes are never world news.
	local audience = {}
	if #self.humans > 0 then
		local top = self:top_owners()
		for _, h in self.humans do
			if h == id or h == killer or self.o_alive[h] == 0 or self.o_left[h] == 1 then
				continue
			end
			if self.o_kind[id] == Defs.KIND_TRIBE and not self:allied(h, id) and not self:allied(h, killer) then
				continue
			end
			if self:news_relevant(h, id, killer, top) then
				table.insert(audience, h)
			end
		end
	end
	self.o_alive[id] = 0
	self.o_troops[id] = 0.0
	self:ev({ Ev.OWNER_OUT, id, killer })
	self:end_attacks_of(id)
	self:remove_units_of(id)
	for _, a in self:allies_of(id) do
		self:end_alliance(id, a, 0)
	end
	local reqs = {}
	for _, k in self:_ordered_keys(self.requests) do
		if k // 1024 == id or k % 1024 == id then
			table.insert(reqs, k)
		end
	end
	for _, k in reqs do
		self:close_request(k // 1024, k % 1024)
	end
	for kind = 0, STRUCT_KINDS - 1 do
		if self.o_scount[id * STRUCT_KINDS + kind] > 0 then
			for _, s in self:structs_of(id, kind) do
				self:destroy_struct(s)
			end
		end
	end
	local o_name = self.o_name
	if killer > 0 then
		self:_conquest_gold(id, killer)
		self:msg(killer, Defs.MSG_GOOD, "You eliminated " .. o_name[id])
	end
	if self:is_human(id) then
		if killer > 0 then
			self:msg(id, Defs.MSG_BAD, o_name[killer] .. " conquered your nation")
		else
			self:msg(id, Defs.MSG_BAD, "Your nation has fallen")
		end
	end
	for _, h in audience do
		self:msg(
			h,
			Defs.MSG_INFO,
			o_name[id] .. " was eliminated" .. (if killer > 0 then " by " .. o_name[killer] else "")
		)
	end
end

--- Conquest: `by` takes `victim`'s gold (conquerGoldAmount: half of a human's) and
--- Ev.CONQUEST tells the clients (the conqueror's "+ gold" popup), once per victim: gold earned
--- by pockets left after an annexation still goes to the final conqueror, silently.
function Sim._conquest_gold(self: any, victim: number, by: number)
	local gold = Rules.conquer_gold(self.o_kind[victim], self.o_gold[victim])
	self.o_gold[by] += gold
	self.o_gold[victim] = 0.0
	if not self._conquest_sent[victim] then
		self._conquest_sent[victim] = true
		self:ev({ Ev.CONQUEST, by, victim, math.floor(gold) })
	end
end

function Sim._check_victory(self: any)
	local best = 0
	local bt = -1
	local o_alive = self.o_alive
	local o_tiles = self.o_tiles
	for id = 1, self.owner_total do
		if o_alive[id] == 1 and o_tiles[id] > bt then
			bt = o_tiles[id]
			best = id
		end
	end
	-- A team game: the team's land together; tribes are
	-- on no team and never win. `best` is then the winning team's biggest member.
	local team = 0
	if self.team_mode and #self.team_names > 0 then
		local sums = self:team_tiles()
		local tt = -1
		for t = 1, #sums do
			if sums[t] > tt then
				team, tt = t, sums[t]
			end
		end
		bt = -1
		best = 0
		for id = 1, self.owner_total do
			if o_alive[id] == 1 and self.o_team[id] == team and o_tiles[id] > bt then
				bt, best = o_tiles[id], id
			end
		end
		bt = tt
	end
	if best > 0 and bt >= Rules.WIN_SHARE * (self.map.contestable_count - self.fallout_count) then
		self:_game_over(best, Defs.OVER_DOMINATION, team)
		return
	end
	if self.time_limit_ticks > 0 and self.tick >= self.time_limit_ticks then
		self:_game_over(best, Defs.OVER_TIME, team)
		return
	end
	-- Solo never ends on the human's death: they may keep watching (only domination ends it).
	-- Multiplayer ends once every human that spawned is out (or every survivor has left).
	if self.max_humans > 0 and not self.solo and #self.humans > 0 then
		local any_spawned = false
		local any_present = false
		local any_alive = false
		for _, h in self.humans do
			if self.o_spawned[h] == 1 then
				any_spawned = true
				if o_alive[h] == 1 then
					any_alive = true
					if self.o_left[h] == 0 then
						any_present = true
					end
				end
			end
		end
		if any_spawned and not any_alive then
			self:_game_over(best, Defs.OVER_DEFEATED, team)
		elseif any_spawned and not any_present then
			self:_game_over(best, Defs.OVER_ABANDONED, team)
		end
	end
end

function Sim._game_over(self: any, w: number, reason: number, team: number?)
	self.phase = Defs.PHASE_OVER
	self.winner = w
	self.over_reason = reason
	local t = team or 0
	self.winner_team = t
	if t ~= 0 then
		self:ev({ Ev.GAME_OVER, w, reason, t })
	else
		self:ev({ Ev.GAME_OVER, w, reason })
	end
	self:ev({ Ev.PHASE, Defs.PHASE_OVER, 0 })
	local tn = self.team_names[t]
	if tn ~= nil and (reason == Defs.OVER_DOMINATION or reason == Defs.OVER_TIME) then
		local who = if tn == Teams.HUMANS or tn == Teams.NATIONS then "The " .. tn else ("The %s team"):format(tn)
		self:msg(
			-1,
			Defs.MSG_ALERT,
			if reason == Defs.OVER_DOMINATION
				then who .. " has won"
				else "Time is up — " .. string.lower(string.sub(who, 1, 1)) .. string.sub(who, 2) .. " holds the most land and wins"
		)
	elseif w > 0 and reason == Defs.OVER_DOMINATION then
		self:msg(-1, Defs.MSG_ALERT, self.o_name[w] .. " has conquered the world")
	elseif w > 0 and reason == Defs.OVER_TIME then
		self:msg(-1, Defs.MSG_ALERT, "Time is up — " .. self.o_name[w] .. " holds the most land and wins")
	end
end

-- =============================================================================================
-- Stats
-- =============================================================================================

function Sim._gold_int(self: any, id: number): number
	return Defs.trunc(math.min(self.o_gold[id], 2000000000.0))
end

function Sim._stats_rows(self: any): { number }
	local s = {}
	local n = 0
	local o_alive = self.o_alive
	local o_spawned = self.o_spawned
	local o_kind = self.o_kind
	local trunc = Defs.trunc
	for id = 1, self.owner_total do
		-- Alive owners that have spawned, plus humans still choosing a start (their HUD shows
		-- troops and gold during the spawn phase).
		if o_alive[id] == 0 or (o_spawned[id] == 0 and o_kind[id] ~= Defs.KIND_HUMAN) then
			continue
		end
		s[n + 1] = id
		s[n + 2] = self.o_tiles[id]
		s[n + 3] = trunc(self.o_troops[id])
		s[n + 4] = self:_gold_int(id)
		s[n + 5] = trunc(self.o_cap[id])
		s[n + 6] = trunc(self.o_income[id] + self.o_bonus_rate[id])
		n += 6
	end
	return s
end

return Sim
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">SimAI</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/sim_ai.gd (SimAI extends SimAIEconomy).
-- Nation and tribe AI. Each AI nation "thinks" every ~1.5 s; thinking is staggered by owner id so
-- no tick carries more than a handful of thinkers. Nation attack sizing runs on a per-nation
-- cadence: every attackRate ticks a nation sends everything above
-- expandRatio x max troops into free land, and wars only once troops reach reserveRatio (usually
-- triggerRatio) of max, sending everything above the reserve; its target choice, human protection
-- and dogpile caps sit on top of that. Tribes (the simple bots) run a plainer loop (see
-- the Tribes section): they act only on their attackRate ticks. The AI perceives the world through
-- Sim.scan_border() (a walk over its border list) and acts only through the same entry points
-- humans use (intent_attack, launch_boat, try_build, launch_nuke, ally_request / ally_reply /
-- ally_break), so every rule and cost applies to it too.
--
-- Luau: SimAIEconomy's methods are mixed into this class (SimAIEconomy.install); the Sim is passed
-- in as `sim` on every call (no stored back-reference), as in GDScript.
--
-- Map scale: the heuristics were tuned on the original 1024-wide Earth grid; tile distances in
-- those units are multiplied by sim.R.LEGACY_LIN (our tiles per original tile), border-tile counts
-- likewise and tile counts by sim.R.LEGACY_AREA, so every map plays alike.

local Defs = require("./Defs")
local Rules = require("./Rules")
local SimAIEconomy = require("./SimAIEconomy")
local Coop = require("../Net/Coop")

local readu8 = buffer.readu8
local readu16 = buffer.readu16
local readi32 = buffer.readi32

local f32 = Defs.f32

local filled = SimAIEconomy.filled
local zt = SimAIEconomy.zt
local NUKE_AGE = SimAIEconomy.NUKE_AGE

local KIND_NATION = Defs.KIND_NATION
local KIND_TRIBE = Defs.KIND_TRIBE
local KIND_HUMAN = Defs.KIND_HUMAN
local U_TRANSPORT = Defs.U_TRANSPORT

local SimAI = {}
SimAI.__index = SimAI
SimAIEconomy.install(SimAI)

-- Re-export the base constants (GDScript subclasses see their parent's consts).
for k, v in SimAIEconomy do
	if type(v) ~= "function" and SimAI[k] == nil then
		SimAI[k] = v
	end
end

SimAI.NATION_THINK = 15
--- Novice bot players (Sim.is_novice_bot) wait this many times longer before attacking a real player.
SimAI.NOVICE_GRACE_MULT = 2
-- A nation's attackRate range (ticks between attack decisions) per difficulty.
SimAI.NATION_ATTACK_RATE = zt({ { 65, 100 }, { 55, 70 }, { 45, 60 } })
-- Tribe cadence: attackRate is drawn from 40-79 ticks (80 excluded), attackTick from
-- 0 .. attackRate - 1; a tribe acts when tick % attackRate == attackTick.
SimAI.TRIBE_ATTACK_RATE = { 40, 79 }
-- A tribe's random attack: 1 in 3 chance to go for a
-- traitor; a nation or human neighbour is skipped 1 time in 2 (tribes never are).
SimAI.TRIBE_TRAITOR_ODDS = 3
SimAI.TRIBE_SKIP_PLAYER_ODDS = 2
-- Delete cooldown (deleteUnitCooldown 30 s) and deletionMarkDuration (30 s): a tribe marks
-- one captured structure for deletion per attack tick at most every 300 ticks; it goes 300 ticks later.
SimAI.TRIBE_DELETE_COOLDOWN = 300
SimAI.TRIBE_DELETE_DELAY = 300
-- Score (own / target troops x preferences) a war target needs. The "weakest" strategy
-- attacks a bordering enemy with fewer troops than ours.
SimAI.WAR_RATIO = zt({ 1.0, 1.0, 1.0 }) -- PackedFloat32Array
-- Easy nations skip a human target 3 times in 4, Medium 1 in 4, Hard never.
SimAI.HUMAN_SKIP = zt({ 0.75, 0.25, 0.0 }) -- PackedFloat32Array
-- Alliance acceptance bias per difficulty.
SimAI.ACCEPT_BIAS = zt({ f32(0.1), 0.0, f32(-0.15) }) -- PackedFloat32Array
SimAI.NUKE_GAP = 1800
-- After an AI nukes someone, other AIs leave that target alone for this long (Brutal: half).
SimAI.NUKE_TARGET_COOL = 600
-- Nuke-age extra delay before AIs may nuke a human (on top of that AI's own grace).
SimAI.HUMAN_NUKE_EXTRA = 1200
-- Late-game remnant mop-up (boat invasions of small, weak owners).
SimAI.MOPUP_AGE = 6000
SimAI.MOPUP_GAP = 200
-- Endgame naval offensives by big nations against major rivals across the sea.
SimAI.INVASION_AGE = 12000
SimAI.INVASION_GAP = 150
SimAI.LATE_WAR_FROM = 12000
SimAI.LATE_WAR_SPAN = 9000

local NATION_THINK = SimAI.NATION_THINK
local NATION_ATTACK_RATE = SimAI.NATION_ATTACK_RATE
local TRIBE_ATTACK_RATE = SimAI.TRIBE_ATTACK_RATE
local WAR_RATIO = SimAI.WAR_RATIO
local HUMAN_SKIP = SimAI.HUMAN_SKIP
local ACCEPT_BIAS = SimAI.ACCEPT_BIAS
--- Team games: the share of alliance requests refused outright, by difficulty (0..2).
local TEAM_REFUSE = { [0] = 0.25, [1] = 0.5, [2] = 0.75 }
local HUMAN_NUKE_EXTRA = SimAI.HUMAN_NUKE_EXTRA

function SimAI.new()
	local self = setmetatable({}, SimAI)
	self:_init_economy()
	self.next_think = {} :: { [number]: number }
	-- Per-AI ratios of max troops: triggerRatio 0.50-0.59, reserveRatio 0.30-0.39,
	-- expandRatio 0.10-0.19; attack cadence (attackRate) and the tick of the next attack decision
	-- (nations) or the attack tick modulo attackRate (tribes).
	self.trigger_r = {} :: { [number]: number }
	self.reserve_r = {} :: { [number]: number }
	self.expand_r = {} :: { [number]: number }
	self.attack_rate = {} :: { [number]: number }
	self.next_attack = {} :: { [number]: number }
	self.attack_tick = {} :: { [number]: number }
	-- 0 until the AI's first (forced) expansion after the land grab begins.
	self.started = {} :: { [number]: number }
	-- Per tribe: 1 until the tribe first finds no free land nearby.
	self.tribe_tn = {} :: { [number]: number }
	-- Tick of each tribe's last structure deletion, and the structures tribes marked for deletion.
	self.last_delete = {} :: { [number]: number }
	self.doomed = {} :: { any }
	-- Scratch lists of the tribe decision (nearby players, traitors), reused.
	self._near = {} :: { number }
	self._near_seen = {} :: { [number]: boolean }
	self._pick = {} :: { number }
	self.aggression = {} :: { [number]: number }
	self.naval = {} :: { [number]: number }
	self.last_boat = {} :: { [number]: number }
	self.last_nuke = {} :: { [number]: number }
	self.last_ally_ask = {} :: { [number]: number }
	-- Tick until which AIs will not pick this owner as a nuke target.
	self.nuke_cool = {} :: { [number]: number }
	-- Per-AI extra grace (ticks) before it may attack humans; see _may_attack_human().
	self.grace_jitter = {} :: { [number]: number }
	-- AI nations currently at war with each owner (rebuilt every tick; tribes don't count).
	self.attackers_on = {} :: { [number]: number }
	self.last_mopup = {} :: { [number]: number }
	self.last_invasion = {} :: { [number]: number }
	-- { due_tick, from, to } alliance requests an AI must answer.
	self.replies = {} :: { { number } }
	-- { due_tick, from, to } renewal requests of `from` that AI ally `to` must answer.
	self.extensions = {} :: { { number } }
	self.leader = 0
	self.leader_share = 0.0
	self.runaway_human = 0
	return self
end

function SimAI:setup(sim)
	local m = Defs.MAX_OWNERS
	self:_setup_economy(m)
	-- Coop.check(): Session builds local matches time-sliced over frames (no-op outside a Coop job).
	Coop.check()
	self.next_think = filled(m, 0)
	self.trigger_r = filled(m, 0.0)
	self.reserve_r = filled(m, 0.0)
	self.expand_r = filled(m, 0.0)
	self.attack_rate = filled(m, 0)
	self.next_attack = filled(m, 0)
	self.attack_tick = filled(m, 0)
	self.started = filled(m, 0)
	self.tribe_tn = filled(m, 1)
	self.last_delete = filled(m, -1)
	self.aggression = filled(m, 0.0)
	self.naval = filled(m, 0.0)
	self.last_boat = filled(m, 0)
	self.last_nuke = filled(m, -100000)
	self.last_ally_ask = filled(m, 0)
	self.nuke_cool = filled(m, 0)
	self.grace_jitter = filled(m, 0)
	self.attackers_on = filled(m, 0)
	self.last_mopup = filled(m, 0)
	self.last_invasion = filled(m, 0)
	local rng = sim.rng
	for id = 1, m - 1 do
		self.aggression[id] = f32(rng:randf_range(0.8, 1.25))
		self.naval[id] = f32(rng:randf_range(0.5, 1.5))
		self.next_think[id] = id % NATION_THINK
		self.grace_jitter[id] = rng:randi_range(0, Rules.HUMAN_GRACE_JITTER)
		self.last_ally_ask[id] = rng:randi_range(0, 600)
		-- 0.50-0.59 etc., drawn once per AI (nations and tribes alike).
		self.trigger_r[id] = rng:randi_range(50, 59) / 100
		self.reserve_r[id] = rng:randi_range(30, 39) / 100
		self.expand_r[id] = rng:randi_range(10, 19) / 100
		if id % 256 == 0 then
			Coop.check()
		end
	end
	-- A tribe's setup: attackRate and attackTick.
	for id = 1, sim.owner_total do
		if sim.o_kind[id] == KIND_TRIBE then
			self:_tribe_cadence(sim, id)
		end
	end
end

function SimAI:_tribe_cadence(sim, id: number)
	local rate = sim.rng:randi_range(TRIBE_ATTACK_RATE[1], TRIBE_ATTACK_RATE[2])
	self.attack_rate[id] = rate
	self.attack_tick[id] = sim.rng:randi_range(0, rate - 1)
end

function SimAI:tick(sim)
	local t = sim.tick
	if #self.replies > 0 then
		self:_process_replies(sim)
	end
	if #self.extensions > 0 then
		self:_process_extensions(sim)
	end
	if t % 50 == 0 then
		self:_update_leader(sim)
	end
	-- AI nations at war with each owner: live non-counter attacks plus transports under way to it
	-- (a boat launched under the cap must not push a human over it when it lands).
	local attackers_on = self.attackers_on
	for i = 0, Defs.MAX_OWNERS - 1 do
		attackers_on[i] = 0
	end
	local o_kind = sim.o_kind
	local pairs_ = {}
	for _, a in sim.attacks do
		if
			not a.dead
			and not a.counter
			and a.target > 0
			and (o_kind[a.attacker] == KIND_NATION or sim.o_bot[a.attacker] == 1)
		then
			pairs_[a.attacker * 1024 + a.target] = true
		end
	end
	local owner = sim.owner
	for _, u in sim.unit_list do
		if not u.dead and u.kind == U_TRANSPORT and (o_kind[u.owner] == KIND_NATION or sim.o_bot[u.owner] == 1) then
			local tg = readi32(owner, u.target_tile * 4)
			if tg > 0 and o_kind[tg] == KIND_HUMAN then
				pairs_[u.owner * 1024 + tg] = true
			end
		end
	end
	for k in pairs_ do
		attackers_on[k % 1024] += 1
	end
	if #self.doomed > 0 then
		self:_delete_doomed(sim)
	end
	local next_think = self.next_think
	local attack_rate = self.attack_rate
	local attack_tick = self.attack_tick
	local o_ai = sim.o_ai
	local o_alive = sim.o_alive
	local o_spawned = sim.o_spawned
	local rng = sim.rng
	for id = 1, sim.owner_total do
		if o_ai[id] == 0 or o_alive[id] == 0 or o_spawned[id] == 0 then
			continue
		end
		if o_kind[id] == KIND_TRIBE then
			if attack_rate[id] == 0 then
				-- (a tribe added after setup: tests place owners by hand)
				self:_tribe_cadence(sim, id)
			end
			-- Nothing happens off the tribe's attack ticks.
			if t % attack_rate[id] == attack_tick[id] then
				if self.started[id] == 0 then
					self:_tribe_first(sim, id)
				else
					self:_think_tribe(sim, id)
				end
				Coop.check()
			end
			continue
		end
		if next_think[id] > t then
			continue
		end
		if self.started[id] == 0 then
			self:_first_attack(sim, id)
			continue
		end
		next_think[id] = t + NATION_THINK + rng:randi_range(-3, 3)
		self:_think_nation(sim, id)
		-- (a local match's step runs as a Coop job spread over frames: Session._local_process)
		Coop.check()
	end
end

function SimAI:_update_leader(sim)
	local best = 0
	local bt = 0
	local second = 0
	local o_alive = sim.o_alive
	local o_tiles = sim.o_tiles
	for id = 1, sim.owner_total do
		if o_alive[id] == 0 then
			continue
		end
		local n = o_tiles[id]
		if n > bt then
			second = bt
			bt = n
			best = id
		elseif n > second then
			second = n
		end
	end
	self.leader = best
	self.leader_share = if best > 0 then sim:land_share(best) else 0.0
	local rank = self.rank
	local ids = {}
	for id = 1, sim.owner_total do
		rank[id] = 999
		if o_alive[id] == 1 and o_tiles[id] > 0 then
			table.insert(ids, id)
		end
	end
	-- Godot's sort_custom (unstable): owners with equal land get the Godot version's ranks.
	Defs.godot_sort(ids, function(p, q)
		return o_tiles[p] > o_tiles[q]
	end)
	for k = 1, #ids do
		rank[ids[k]] = k
	end
	self.runaway_human = 0
	-- (the runaway leader is a free-for-all rule: FFA only)
	if not sim.team_mode and best > 0 and sim:is_human(best) and self.leader_share >= 0.15 and bt >= 1.3 * second then
		self.runaway_human = best
	end
	self.nukes_in_play = self.nukes_in_play or sim.nukes_launched > 0
end

-- A nation's first act is an expansion with half its troops and its attack decisions
-- then come every attackRate ticks. (Tribes: _tribe_first.)
function SimAI:_first_attack(sim, id: number)
	self.started[id] = 1
	local r = NATION_ATTACK_RATE[sim:ai_difficulty(id)]
	self.attack_rate[id] = sim.rng:randi_range(r[1], r[2])
	self.next_attack[id] = sim.tick + sim.rng:randi_range(0, self.attack_rate[id])
	sim:scan_border(id, math.ceil(400 * sim.R.LEGACY_LIN))
	if sim.sc_neutral > 0 and sim.sc_neutral_tile >= 0 then
		sim:intent_attack(id, sim.sc_neutral_tile, 0.5)
	end
end

-- True (and schedules the next one) when this AI's attackRate cycle comes round.
function SimAI:_attack_due(sim, id: number): boolean
	if sim.tick < self.next_attack[id] then
		return false
	end
	self.next_attack[id] = sim.tick + self.attack_rate[id]
	return true
end

-- Attack size: the share of home troops above `keep` x max troops.
function SimAI._above(sim, id: number, keep: number): number
	local troops = sim.o_troops[id]
	return (troops - keep * math.max(sim.o_cap[id], 1.0)) / math.max(troops, 1.0)
end
local _above = SimAI._above

-- Two owners big enough to be rivals for the win never stay allied.
function SimAI._great_powers(a_share: number, b_share: number): boolean
	return (a_share >= 0.12 and b_share >= 0.08) or (b_share >= 0.12 and a_share >= 0.08)
end
local _great_powers = SimAI._great_powers

-- =============================================================================================
-- Nations
-- =============================================================================================

function SimAI:_think_nation(sim, id: number)
	local age = sim.tick - sim.playing_since
	local troops = sim.o_troops[id]
	local fill = troops / math.max(sim.o_cap[id], 1.0)
	sim:scan_border(id, math.ceil(400 * sim.R.LEGACY_LIN))
	self:_consider_retint(sim, id, age)
	if self:_consider_capitulation(sim, id, age) then
		return
	end
	local defended = self:_defend(sim, id)
	local due = self:_attack_due(sim, id)
	-- Expansion into unclaimed land: everything above expandRatio of max troops.
	local expanded = false
	if due and sim.sc_neutral > 0 and sim.sc_neutral_tile >= 0 then
		local send = _above(sim, id, self.expand_r[id])
		if send * troops >= 1.0 then
			expanded = sim:intent_attack(id, sim.sc_neutral_tile, send)
		end
	end
	local warred = false
	-- While there is clean free land to take, the attack cycle goes to expansion.
	if due and not defended and not expanded then
		warred = self:_consider_war(sim, id, fill, age)
	end
	-- Nuked land: with no clean land to take and no war
	-- started, a nation at its trigger ratio slowly re-settles bordering fallout.
	if
		due
		and not warred
		and not defended
		and sim.sc_neutral == 0
		and sim.sc_fallout_tile >= 0
		and fill >= self.trigger_r[id]
	then
		local send2 = _above(sim, id, self.reserve_r[id]) * 0.5
		if send2 * troops >= 1.0 then
			sim:intent_attack(id, sim.sc_fallout_tile, send2)
		end
	end
	self:_consider_build(sim, id, age)
	if due then
		self:_maybe_spawn_warship(sim, id)
		self:_counter_infestation(sim, id)
	end
	if not warred and sim.sc_neutral == 0 then
		self:_consider_boat(sim, id, age)
	end
	self:_consider_mopup(sim, id, age)
	self:_consider_invasion(sim, id, age)
	self:_consider_nuke(sim, id, age)
	self:_consider_diplomacy(sim, id, age)
end

-- Endgame: a small nation overrun by a far stronger attacker surrenders (see Rules.CAPITULATE_*).
function SimAI:_consider_capitulation(sim, id: number, age: number): boolean
	if age < Rules.CAPITULATE_AGE or sim:land_share(id) >= Rules.CAPITULATE_SHARE then
		return false
	end
	if sim.tick - sim.last_capitulation < Rules.CAPITULATE_GAP then
		return false
	end
	if sim.tick - sim.o_attacked_tick[id] > 40 then
		return false
	end
	local mine = sim.o_troops[id] + 1.0
	for _, a in sim.attacks do
		if a.dead or a.target ~= id or sim.o_kind[a.attacker] == KIND_TRIBE then
			continue
		end
		if sim.o_troops[a.attacker] + a.troops >= Rules.CAPITULATE_RATIO * mine then
			sim:capitulate(id, a.attacker)
			return true
		end
	end
	return false
end

-- Counter-attacks the largest incoming attack when we can afford it. True if we acted.
function SimAI:_defend(sim, id: number): boolean
	if sim.tick - sim.o_attacked_tick[id] > 40 then
		return false
	end
	local worst = nil
	for _, a in sim.attacks do
		if not a.dead and a.target == id and (worst == nil or a.troops > worst.troops) then
			worst = a
		end
	end
	if worst == nil then
		return false
	end
	local x = worst.attacker
	local tile = -1
	if sim.sc_count[x] > 0 then
		tile = sim.sc_tile[x]
	elseif
		worst.last_tile >= 0
		and readi32(sim.owner, worst.last_tile * 4) == x
		and sim:touches(worst.last_tile, id)
	then
		tile = worst.last_tile
	end
	if tile < 0 then
		return false
	end
	local mine = sim.o_troops[id]
	if mine < worst.troops * 1.1 or worst.troops < mine * 0.02 then
		return false
	end
	-- Already answering this attacker with enough troops: don't feed a ping-pong grind.
	local ours = sim:attack_between(id, x)
	if ours ~= nil and ours.troops >= worst.troops * 0.8 then
		return false
	end
	local ratio = math.clamp(worst.troops * 1.25 / math.max(mine, 1.0), 0.05, 0.4)
	return sim:intent_attack(id, tile, ratio)
end

function SimAI:_consider_war(sim, id: number, fill: number, age: number): boolean
	local my_share = sim:land_share(id)
	-- Before a war: save up to reserveRatio, usually to triggerRatio.
	if fill < self.reserve_r[id] then
		return false
	end
	if fill < self.trigger_r[id] and sim.rng:randf() >= 0.1 then
		return false
	end
	local d = sim:ai_difficulty(id)
	-- (towards players a smart bot player is as patient as Easy: Rules.SMART_VS_PLAYERS)
	local hd = sim:human_difficulty(id)
	local mine = sim.o_troops[id]
	local best = -1
	local best_s = 0.0
	local sc_count = sim.sc_count
	local attackers_on = self.attackers_on
	local L = sim.R.LEGACY_LIN
	for _, p in sim.sc_list do
		if sc_count[p] < 2 * L or sim:allied(id, p) then
			continue
		end
		local pk = sim.o_kind[p]
		local at_war = sim:attack_between(id, p) ~= nil
		if
			pk == KIND_HUMAN
			and not at_war
			and (not self:_may_attack_human(sim, id, p, age) or sim.rng:randf() < HUMAN_SKIP[hd])
		then
			continue
		end
		local s = mine / (sim.o_troops[p] + 1.0)
		-- Prefer targets that are not already being dogpiled.
		s *= 0.6 ^ (attackers_on[p] - (if at_war then 1 else 0))
		if pk == KIND_TRIBE then
			s *= 1.5
		end
		if sim:is_traitor(p) then
			s *= 1.3
		end
		if sim:grudge_of(id, p) then
			s *= 1.35
		end
		if at_war then
			s *= 1.2
		end
		if p == self.runaway_human then
			s *= 1.4
		end
		if _great_powers(my_share, sim:land_share(p)) then
			s *= 1.5
		end
		s *= self.aggression[id] * (0.8 + 0.2 * math.min(sc_count[p] / (20.0 * L), 1.0))
		if s > best_s then
			best_s = s
			best = p
		end
	end
	-- Endgame showdown: from minute 20 wars need a smaller edge (x0.5 by minute 35), so the
	-- larger empire's faster regrowth decides the attrition instead of a frozen stalemate.
	local w = math.clamp((age - SimAI.LATE_WAR_FROM) / SimAI.LATE_WAR_SPAN, 0.0, 1.0)
	local need = WAR_RATIO[d] * (1.0 + (0.5 - 1.0) * w)
	if best < 0 or best_s < need then
		return false
	end
	local new_war = sim:attack_between(id, best) == nil
	if new_war and sim:count_attacks_by(id, true) >= (if my_share >= 0.12 then 3 else 2) then
		return false
	end
	-- Send everything above the reserve; only reinforce a front that is running short.
	local ratio = _above(sim, id, self.reserve_r[id])
	if ratio * mine < 1.0 then
		return false
	end
	if not new_war then
		local ex = sim:attack_between(id, best)
		if ex ~= nil and ex.troops > sim.o_troops[best] * 0.8 then
			return false
		end
	end
	local ok = sim:intent_attack(id, sim.sc_tile[best], ratio)
	if ok and new_war then
		attackers_on[best] += 1
	end
	return ok
end

-- Launches a transport; a boat aimed at a human takes a war slot at once (so two AIs deciding
-- in the same tick can't both slip under MAX_AI_WARS_ON_HUMAN).
function SimAI:_boat_at(sim, id: number, tile: number, ratio: number): boolean
	local tg = readi32(sim.owner, tile * 4)
	local ok = sim:launch_boat(id, tile, ratio)
	if ok and tg > 0 and sim:is_human(tg) and sim:attack_between(id, tg) == nil then
		self.attackers_on[tg] += 1
	end
	return ok
end

-- Public check used by the Sim when an AI transport lands on a human's coast.
function SimAI:may_attack_human(sim, id: number, h: number): boolean
	-- Tribes have no human protection (a tribe never skips a human target) beyond the spawn
	-- shield, which holds for every attacker.
	if sim.o_kind[id] == KIND_TRIBE then
		return not sim:shielded(h)
	end
	return self:_may_attack_human(sim, id, h, sim.tick - sim.playing_since)
end

-- Human protection: that human's spawn shield is over, this AI's own grace (global minimum + its
-- random delay + more for distant nations) has passed, and fewer than MAX_AI_WARS_ON_HUMAN nations
-- already fight that human.
function SimAI:_may_attack_human(sim, id: number, h: number, age: number): boolean
	if sim:shielded(h) then
		-- (a late joiner's spawn shield: the AI's grace counts from the start of play)
		return false
	end
	local d = sim:human_difficulty(id)
	local grace = Rules.human_grace_ticks(d) + self.grace_jitter[id]
	if sim:is_novice_bot(id) then
		-- novice bot players leave real players alone for twice as long (~10 min)
		grace *= SimAI.NOVICE_GRACE_MULT
	end
	local a = if sim.o_spawn_tile[id] >= 0 then sim.o_spawn_tile[id] else sim:centre_tile(id)
	local b = sim.o_spawn_tile[h]
	if a >= 0 and b >= 0 then
		-- in tiles of the original grid
		local dist = Defs.trunc(math.sqrt(sim.range_d2(a, b)) / sim.R.LEGACY_LIN)
		grace += math.clamp(
			(dist - Rules.HUMAN_GRACE_NEAR) * Rules.HUMAN_GRACE_PER_TILE,
			0,
			Rules.HUMAN_GRACE_MAX_EXTRA
		)
	end
	if age < grace then
		return false
	end
	if
		(sim.o_kind[id] == KIND_NATION or sim.o_bot[id] == 1)
		and self.attackers_on[h] >= Rules.MAX_AI_WARS_ON_HUMAN[d]
	then
		return false
	end
	return true
end

function SimAI:_consider_boat(sim, id: number, age: number)
	if age < 600 or sim.o_boats[id] >= (if sim:ai_difficulty(id) == 2 then 2 else 1) then
		return
	end
	if sim.tick - self.last_boat[id] < Defs.trunc(300.0 / self.naval[id]) then
		return
	end
	local home_coast = sim:own_coast_tile(id)
	if home_coast < 0 then
		return
	end
	self.last_boat[id] = sim.tick
	local map = sim.map
	local cb = map.coast_body
	local water_body = readu16(cb, home_coast * 2)
	local ct = map.coast_list
	local nct = map.coast_count
	local owner = sim.owner
	local land = sim.land
	local flags = sim.flags
	local mine = sim.o_troops[id]
	local dist2 = sim.dist2
	local L = sim.R.LEGACY_LIN
	local tile_troops = 60.0 * sim.R.LEGACY_AREA
	local best = -1
	local best_s = 0.0
	for _ = 1, 48 do
		local c = readi32(ct, (sim.rng:randi() % nct) * 4)
		if readu16(cb, c * 2) ~= water_body or readu8(land, c) == 0 or bit32.band(readu8(flags, c), 1) ~= 0 then
			continue
		end
		local o = readi32(owner, c * 4)
		if o == id or sim:allied(id, o) then
			continue
		end
		local s = 0.0
		if o == 0 then
			s = 3.0
		else
			local ratio = mine * 0.3 / (sim.o_troops[o] / math.max(sim.o_tiles[o], 1) * tile_troops + 1.0)
			if ratio < 1.0 then
				continue
			end
			if
				sim.o_kind[o] == KIND_HUMAN
				and sim:attack_between(id, o) == nil
				and not self:_may_attack_human(sim, id, o, age)
			then
				continue
			end
			s = 1.0 + math.min(ratio, 3.0) * 0.3
			if sim.o_kind[o] == KIND_TRIBE then
				s *= 1.4
			end
		end
		local dist = math.sqrt(dist2(home_coast, c))
		s /= 1.0 + dist / (110.0 * L)
		if s > best_s then
			best_s = s
			best = c
		end
	end
	if best >= 0 and best_s > 0.35 then
		self:_boat_at(sim, id, best, Rules.BOAT_ATTACK_FRACTION)
	end
end

-- Endgame: a big nation (>= 12 % land) that is not badly outmatched keeps landing 20 % waves on a
-- major rival it can't reach by land, so continents separated by oceans still get decided.
function SimAI:_consider_invasion(sim, id: number, age: number)
	if age < SimAI.INVASION_AGE or sim.tick - self.last_invasion[id] < SimAI.INVASION_GAP then
		return
	end
	self.last_invasion[id] = sim.tick + sim.rng:randi_range(0, 80)
	local share = sim:land_share(id)
	if share < 0.12 or sim.o_boats[id] >= Rules.max_boats(sim.o_tiles[id]) then
		return
	end
	local mine = sim.o_troops[id]
	if mine < math.max(sim.o_cap[id], 1.0) * 0.3 then
		return
	end
	local best = 0
	local best_s = 0.0
	local rank = self.rank
	for p = 1, sim.owner_total do
		if p == id or sim.o_alive[p] == 0 or rank[p] > 8 or sim:allied(id, p) or sim:land_share(p) < 0.04 then
			continue
		end
		if sim.sc_count[p] > 0 or sim.o_coast[p] <= 0 then
			continue
		end
		local theirs = sim.o_troops[p] + 1.0
		if mine < 0.7 * theirs then
			continue
		end
		if sim:is_human(p) and sim:attack_between(id, p) == nil and not self:_may_attack_human(sim, id, p, age) then
			continue
		end
		local s = (mine / theirs) * sim:land_share(p) * (if sim:grudge_of(id, p) then 1.5 else 1.0)
		if s > best_s then
			best_s = s
			best = p
		end
	end
	if best <= 0 then
		return
	end
	local ct = sim.map.coast_list
	local nct = sim.map.coast_count
	local owner = sim.owner
	local flags = sim.flags
	for _ = 1, 300 do
		local c = readi32(ct, (sim.rng:randi() % nct) * 4)
		if readi32(owner, c * 4) == best and bit32.band(readu8(flags, c), 1) == 0 then
			self:_boat_at(sim, id, c, Rules.BOAT_ATTACK_FRACTION)
			return
		end
	end
end

-- Late game: big nations invade small, weak remnants (usually islands they can't reach by land)
-- by sea, so the match can actually end.
function SimAI:_consider_mopup(sim, id: number, age: number)
	if age < SimAI.MOPUP_AGE or sim.tick - self.last_mopup[id] < SimAI.MOPUP_GAP then
		return
	end
	self.last_mopup[id] = sim.tick + sim.rng:randi_range(0, 100)
	local tiles = sim.o_tiles[id]
	if sim:land_share(id) < 0.03 or sim.o_boats[id] >= Rules.max_boats(tiles) then
		return
	end
	local mine = sim.o_troops[id]
	local LA = sim.R.LEGACY_AREA
	local L = sim.R.LEGACY_LIN
	local dist2 = sim.dist2
	local small = math.max(600 * LA, Defs.trunc(0.006 * sim.map.contestable_count))
	local home = sim:own_coast_tile(id)
	if home < 0 then
		return
	end
	local best = 0
	local best_s = 0.0
	for p = 1, sim.owner_total do
		if p == id or sim.o_alive[p] == 0 or sim.o_tiles[p] <= 0 or sim.o_tiles[p] > small or sim:allied(id, p) then
			continue
		end
		if sim.o_troops[p] > 0.2 * mine or sim.o_coast[p] <= 0 then
			continue
		end
		if sim:is_human(p) and sim:attack_between(id, p) == nil and not self:_may_attack_human(sim, id, p, age) then
			continue
		end
		local anchor = if sim.o_spawn_tile[p] >= 0 then sim.o_spawn_tile[p] else home
		local s = 1.0 / (1.0 + math.sqrt(dist2(home, anchor)) / (200.0 * L))
		if sim.sc_count[p] > 0 then
			s *= 0.3
		end
		if s > best_s then
			best_s = s
			best = p
		end
	end
	if best <= 0 then
		return
	end
	local target = sim:own_coast_tile(best)
	if target < 0 then
		return
	end
	local need = (sim.o_troops[best] + sim.o_tiles[best] * 60.0 * LA) * 1.6
	self:_boat_at(sim, id, target, math.clamp(need / math.max(mine, 1.0), 0.05, Rules.BOAT_ATTACK_FRACTION))
end

function SimAI:_consider_nuke(sim, id: number, age: number)
	local d = sim:ai_difficulty(id)
	if age < NUKE_AGE[d] or sim:struct_count(id, Defs.S_SILO) == 0 then
		return
	end
	if sim.tick - self.last_nuke[id] < SimAI.NUKE_GAP then
		return
	end
	local gold = sim.o_gold[id]
	if gold < Rules.NUKE_COST[Defs.N_ATOM] then
		return
	end
	local mine = sim.o_troops[id]
	local best = 0
	local best_s = 0.0
	local nuke_cool = self.nuke_cool
	local LA = sim.R.LEGACY_AREA
	for _, p in sim.sc_list do
		if sim:allied(id, p) or sim.o_kind[p] == KIND_TRIBE or sim.o_tiles[p] < 400 * LA or nuke_cool[p] > sim.tick then
			continue
		end
		if
			sim.o_kind[p] == KIND_HUMAN
			and (age < HUMAN_NUKE_EXTRA or not self:_may_attack_human(sim, id, p, age - HUMAN_NUKE_EXTRA))
		then
			continue
		end
		local s = sim.o_tiles[p] + 0.0
		if sim:grudge_of(id, p) then
			s *= 1.6
		end
		local at_war = sim:grudge_of(id, p) or sim:attack_between(id, p) ~= nil
		if not at_war then
			continue
		end
		if sim.o_troops[p] > mine then
			s *= 1.3
		end
		if s > best_s then
			best_s = s
			best = p
		end
	end
	-- The leader / a runaway human is only a nuke target for rivals that border it or hold a
	-- grudge, and never more than one AI nuke per target per minute (no dogpile collapse).
	for _, p2 in { self.leader, self.runaway_human } do
		if p2 <= 0 or p2 == id or sim:allied(id, p2) or nuke_cool[p2] > sim.tick or sim:land_share(p2) < 0.25 then
			continue
		end
		if sim.sc_count[p2] == 0 and not sim:grudge_of(id, p2) then
			continue
		end
		if sim:is_human(p2) and not self:_may_attack_human(sim, id, p2, age - HUMAN_NUKE_EXTRA) then
			continue
		end
		local s2 = sim.o_tiles[p2] * (if p2 == self.runaway_human then 2.0 else 1.2)
		if s2 > best_s then
			best_s = s2
			best = p2
		end
	end
	if best <= 0 then
		return
	end
	local kind = Defs.N_ATOM
	if
		gold >= Rules.nuke_cost("mirv", sim.mirvs_launched)
		and (best == self.leader or best == self.runaway_human)
		and sim:land_share(best) >= 0.35
	then
		kind = Defs.N_MIRV
	elseif gold >= Rules.NUKE_COST[Defs.N_HYDROGEN] and sim.o_tiles[best] > 2500 * LA then
		kind = Defs.N_HYDROGEN
	end
	local target = self:_nuke_target(sim, id, best, kind)
	if target < 0 then
		return
	end
	self.last_nuke[id] = sim.tick
	if sim:launch_nuke(id, Defs.NUKE_NAMES[kind], target) then
		nuke_cool[best] = sim.tick + SimAI.NUKE_TARGET_COOL
		-- Follow up on the ground while the defender reels.
		if sim.sc_count[best] > 0 and sim.o_troops[id] > sim.o_troops[best] * 0.6 then
			sim:intent_attack(id, sim.sc_tile[best], 0.3)
		end
	end
end

function SimAI:_nuke_target(sim, id: number, p: number, kind: number): number
	local cands = {}
	for _, k in { Defs.S_CITY, Defs.S_SILO, Defs.S_FACTORY, Defs.S_PORT } do
		if sim:struct_count(p, k) > 0 then
			for _, s in sim:structs_of(p, k) do
				table.insert(cands, s.tile)
			end
			if #cands >= 6 then
				break
			end
		end
	end
	if sim.sc_count[p] > 0 then
		table.insert(cands, sim.sc_tile[p])
	end
	local st = sim.o_spawn_tile[p]
	if st >= 0 and readi32(sim.owner, st * 4) == p then
		table.insert(cands, st)
	end
	-- MIRV warheads only ever land on the target's own land.
	local radius = sim.R.NUKE_RADIUS[kind]
	for _ = 1, math.min(#cands, 6) do
		local c = cands[sim.rng:randi() % #cands + 1]
		if kind == Defs.N_MIRV or self:_blast_safe(sim, id, c, radius + 2.0 * sim.R.LEGACY_LIN) then
			return c
		end
	end
	return -1
end

-- True when a blast of `radius` at `c` would not touch allies and would spare most own land.
function SimAI:_blast_safe(sim, id: number, c: number, radius: number): boolean
	local own = 0
	local total = 0
	local W = sim.W
	local cx = c % W
	local cy = c // W
	local r = Defs.trunc(radius)
	local owner = sim.owner
	local rng = sim.rng
	for _ = 1, 40 do
		local x = math.clamp(cx + rng:randi_range(-r, r), 0, W - 1)
		local y = math.clamp(cy + rng:randi_range(-r, r), 0, sim.H - 1)
		local t = y * W + x
		local o = readi32(owner, t * 4)
		if o == 0 then
			continue
		end
		total += 1
		if o == id then
			own += 1
		elseif sim:allied(id, o) then
			return false
		end
	end
	return own * 4 <= total
end

function SimAI:_consider_diplomacy(sim, id: number, age: number)
	if age < 300 or sim.tick - self.last_ally_ask[id] < 600 then
		return
	end
	self.last_ally_ask[id] = sim.tick + sim.rng:randi_range(0, 600)
	local mine = sim.o_troops[id]
	local my_share = sim:land_share(id)
	-- Betrayal: great powers do not tolerate each other for long, dominant nations shed weak
	-- allies that stand in their way, and aggressive nations occasionally stab a weak neighbour.
	if sim.o_ally_count[id] > 0 then
		for _, p in sim:allies_of(id) do
			local ps = sim:land_share(p)
			local chance = 0.0
			if _great_powers(my_share, ps) then
				chance = 0.35
			elseif my_share >= 0.25 and mine > 2.0 * sim.o_troops[p] then
				chance = 0.15
			elseif mine > 3.0 * sim.o_troops[p] and sim.sc_count[p] > 0 then
				chance = 0.04 * self.aggression[id] * (0.5 + 0.5 * sim:ai_difficulty(id))
			end
			if sim:is_human(p) and age < Rules.human_grace_ticks(sim:human_difficulty(id)) * 2 then
				chance *= 0.25
			end
			if chance > 0.0 and sim.rng:randf() < chance then
				sim:ally_break(id, p)
				return
			end
		end
	end
	if sim.o_ally_count[id] >= Rules.AI_MAX_ALLIES or sim.rng:randf() > 0.4 then
		return
	end
	local best = 0
	local best_s = 0.0
	for _, p in sim.sc_list do
		if sim.o_kind[p] == KIND_TRIBE or sim:allied(id, p) or sim:hostile(id, p) or sim:has_request(id, p) then
			continue
		end
		if sim:is_traitor(p) or sim.o_ally_count[p] >= Rules.AI_MAX_ALLIES + (if sim:is_human(p) then 2 else 0) then
			continue
		end
		if _great_powers(my_share, sim:land_share(p)) then
			continue
		end
		local s = sim.o_troops[p] / math.max(mine, 1.0) + sim.rng:randf() * 0.5
		if sim:is_human(p) then
			s += 0.4
		end
		if s > best_s then
			best_s = s
			best = p
		end
	end
	if best > 0 and best_s > 0.6 then
		sim:ally_request(id, best)
	end
end

-- =============================================================================================
-- Alliance replies
-- =============================================================================================

function SimAI:queue_reply(sim, from: number, to: number)
	-- A tribe answers on its next attack tick (see _tribe_answers); the request made this tick is
	-- initialised after this tick's tribe update ran.
	local due = if sim.o_kind[to] == KIND_TRIBE then sim.tick + 1 else sim.tick + sim.rng:randi_range(20, 45)
	table.insert(self.replies, { due, from, to })
end

--- A tribe accepts alliance requests on its attack ticks after its first.
function SimAI:_tribe_answers(sim, id: number): boolean
	return self.started[id] == 1 and sim.tick % self.attack_rate[id] == self.attack_tick[id]
end

function SimAI:_process_replies(sim)
	local keep = {}
	for _, r in self.replies do
		if r[1] > sim.tick then
			table.insert(keep, r)
			continue
		end
		local from = r[2]
		local to = r[3]
		if not sim:has_request(from, to) or sim.o_alive[to] == 0 or sim.o_ai[to] == 0 then
			continue
		end
		if sim.o_kind[to] == KIND_TRIBE then
			-- A tribe accepts every request.
			if self:_tribe_answers(sim, to) then
				sim:ally_reply(to, from, true)
			else
				table.insert(keep, r)
			end
			continue
		end
		sim:ally_reply(to, from, self:_accept(sim, to, from))
	end
	self.replies = keep
end

function SimAI:_accept(sim, me: number, other: number): boolean
	if sim.o_ally_count[me] >= Rules.AI_MAX_ALLIES or sim:grudge_of(me, other) then
		return false
	end
	if _great_powers(sim:land_share(me), sim:land_share(other)) then
		return false
	end
	if sim:attack_between(me, other) ~= nil then
		return false
	end
	local p = 0.3
	local ratio = (sim.o_tiles[other] + 1) / (sim.o_tiles[me] + 1)
	if ratio > 1.5 then
		p += 0.35
	elseif ratio > 0.7 then
		p += 0.2
	end
	if sim:is_human(other) then
		p += 0.15
	end
	if self:_shared_enemy(sim, me, other) then
		p += 0.2
	end
	if sim:is_traitor(other) then
		p = 0.08
	end
	p += ACCEPT_BIAS[sim:ai_difficulty(me)]
	-- Team games: a nation refuses a request outright 25% / 50% / 75% of
	-- the time on Easy / Medium / Hard
	if sim.team_mode and sim.rng:randf() < TEAM_REFUSE[sim:ai_difficulty(me)] then
		return false
	end
	return sim.rng:randf() < p
end

-- =============================================================================================
-- Alliance renewals
-- =============================================================================================
-- AIs never ask to renew (only a human can click "renew"); they answer when only the other
-- side has asked: a tribe always agrees, on its next attack
-- tick (as it accepts every alliance request), a nation agrees when it would accept that player's
-- alliance request (the same decision as for a new request)
-- and, while it declines, reconsiders every attack tick (attackRate: Easy 65-100, Medium 55-70,
-- Hard 45-60 ticks) until the alliance expires. So alliances between two AIs lapse after
-- Rules.ALLIANCE_TICKS.
SimAI.EXTEND_RETRY = zt({ { 65, 100 }, { 55, 70 }, { 45, 60 } })

function SimAI:queue_extension(sim, from: number, to: number)
	local due = if sim.o_kind[to] == KIND_TRIBE then sim.tick + 1 else sim.tick + sim.rng:randi_range(20, 45)
	table.insert(self.extensions, { due, from, to })
end

function SimAI:_process_extensions(sim)
	local keep = {}
	for _, r in self.extensions do
		if r[1] > sim.tick then
			table.insert(keep, r)
			continue
		end
		local from = r[2]
		local to = r[3]
		if
			sim.o_alive[to] == 0
			or sim.o_ai[to] == 0
			or not sim:has_alliance(from, to)
			or not sim:asked_to_extend(from, to)
			or sim:asked_to_extend(to, from)
		then
			continue
		end
		if sim.o_kind[to] == KIND_TRIBE and not self:_tribe_answers(sim, to) then
			-- A tribe renews on its next attack tick.
			table.insert(keep, r)
			continue
		end
		if self:_accept_extension(sim, to, from) then
			sim:ally_extend(to, from)
		else
			local span = SimAI.EXTEND_RETRY[math.clamp(sim:ai_difficulty(to), 0, 2)]
			r[1] = sim.tick + sim.rng:randi_range(span[1], span[2])
			table.insert(keep, r)
		end
	end
	self.extensions = keep
end

--- Would AI `me` renew its alliance with `other`? Tribes always; others decide as for a new
--- request from `other` (_accept), except that the alliance itself does not count against
--- AI_MAX_ALLIES.
function SimAI:_accept_extension(sim, me: number, other: number): boolean
	if sim.o_kind[me] == KIND_TRIBE then
		return true
	end
	if sim:grudge_of(me, other) or _great_powers(sim:land_share(me), sim:land_share(other)) then
		return false
	end
	local p = 0.3
	local ratio = (sim.o_tiles[other] + 1) / (sim.o_tiles[me] + 1)
	if ratio > 1.5 then
		p += 0.35
	elseif ratio > 0.7 then
		p += 0.2
	end
	if sim:is_human(other) then
		p += 0.15
	end
	if self:_shared_enemy(sim, me, other) then
		p += 0.2
	end
	if sim:is_traitor(other) then
		p = 0.08
	end
	p += ACCEPT_BIAS[sim:ai_difficulty(me)]
	return sim.rng:randf() < p
end

-- True when both owners currently hold a grudge against the same third party.
function SimAI:_shared_enemy(sim, a: number, b: number): boolean
	local foes = {}
	local any = false
	local tick = sim.tick
	for k, expiry in sim.grudge do
		if expiry > tick and k // 1024 == a then
			foes[k % 1024] = true
			any = true
		end
	end
	if not any then
		return false
	end
	for k, expiry in sim.grudge do
		if expiry > tick and k // 1024 == b and foes[k % 1024] and k % 1024 ~= a then
			return true
		end
	end
	return false
end

-- =============================================================================================
-- Tribes: the tribe update and the attack choices it makes
-- =============================================================================================
-- A tribe acts only on its attack ticks (tick % attackRate == attackTick; never in the spawn
-- phase). On the first it sends everything above expandRatio x max troops into free land and
-- nothing else (_tribe_send_tn). On every later one it accepts all alliance requests and
-- renewals (_process_replies / _process_extensions), marks one captured structure for deletion
-- (_tribe_delete_next) and then picks an attack:
--   1. a random nearby traitor, 1 time in 3 (no troop threshold);
--   2. while it has only ever seen free land nearby: free land again — the latch goes off for good
--      the first time there is none;
--   3. a random target, only at triggerRatio of max troops or more: the biggest incoming
--      attacker, a traitor (1 in 3), then its nearby players in random order — a nation or human
--      skipped 1 time in 2 — the first it can attack.
-- Troops: a land attack on a player sends everything above reserveRatio x max (expandRatio against
-- a tribe holding structures), free land everything above expandRatio x max; a target only
-- reachable across water gets a transport with troops / 5. No strength check, no human grace.
-- "Nearby" (_tribe_nearby): owners of land next to the border (free land unless fallout),
-- plus what every 10th shore tile sees 5 full-size tiles across a river.

local TRIBE_TRAITOR_ODDS = SimAI.TRIBE_TRAITOR_ODDS
local TRIBE_SKIP_PLAYER_ODDS = SimAI.TRIBE_SKIP_PLAYER_ODDS
local TRIBE_DELETE_COOLDOWN = SimAI.TRIBE_DELETE_COOLDOWN
local TRIBE_DELETE_DELAY = SimAI.TRIBE_DELETE_DELAY
local T_LAKE = Defs.T_LAKE
local F_FALLOUT = Defs.F_FALLOUT
local STRUCTURE_KINDS = { Defs.S_CITY, Defs.S_PORT, Defs.S_FACTORY, Defs.S_DEFENSE, Defs.S_SAM, Defs.S_SILO }
-- Cardinal steps (x, y) of the shore probes.
local PROBE_DX = { 0, 0, -1, 1 }
local PROBE_DY = { -1, 1, 0, 0 }

--- A tribe's first attack tick: it sends an attack
--- into terra nullius; nothing else happens that tick.
function SimAI:_tribe_first(sim, id: number)
	self.started[id] = 1
	sim:scan_border(id, sim.bcount[id])
	self:_tribe_send_tn(sim, id)
end

--- Every later attack tick of a tribe (alliances are answered by _process_replies /
--- _process_extensions at the start of the tick).
function SimAI:_think_tribe(sim, id: number)
	local tn_near = self:_tribe_nearby(sim, id)
	self:_consider_retint(sim, id, sim.tick - sim.playing_since)
	self:_tribe_delete_next(sim, id)
	-- the attack choice
	local rng = sim.rng
	local traitor = self:_tribe_traitor(sim, id)
	-- (the traitor is never an ally, so there is no alliance to break first)
	if traitor > 0 and rng:randi_range(1, TRIBE_TRAITOR_ODDS) == 1 and self:_tribe_send(sim, id, traitor) then
		return
	end
	if self.tribe_tn[id] == 1 then
		if tn_near then
			if self:_tribe_send_tn(sim, id) then
				return
			end
		else
			self.tribe_tn[id] = 0
		end
	end
	self:_tribe_attack_random(sim, id)
end

--- Step 3: a random target, at triggerRatio of max troops or more.
function SimAI:_tribe_attack_random(sim, id: number)
	if sim.o_troops[id] / math.max(sim.o_cap[id], 1.0) < self.trigger_r[id] then
		return
	end
	local rng = sim.rng
	local attacker = self:_tribe_incoming(sim, id)
	if attacker > 0 and self:_tribe_send(sim, id, attacker) then
		return
	end
	local traitor = self:_tribe_traitor(sim, id)
	if traitor > 0 and rng:randi_range(1, TRIBE_TRAITOR_ODDS) == 1 and self:_tribe_send(sim, id, traitor) then
		return
	end
	-- Fisher-Yates shuffle of the nearby list, terra nullius included
	local near = self._near
	for i = #near, 2, -1 do
		local j = rng:randi_range(1, i)
		near[i], near[j] = near[j], near[i]
	end
	local o_kind = sim.o_kind
	for _, p in near do
		if p == 0 or sim:allied(id, p) then
			continue
		end
		if o_kind[p] ~= KIND_TRIBE and rng:randi_range(1, TRIBE_SKIP_PLAYER_ODDS) == 1 then
			continue
		end
		if self:_tribe_send(sim, id, p) then
			return
		end
	end
end

--- Scans the whole border (sc_list / sc_count / sc_tile for the owners of the
--- land next to it, sc_neutral / sc_fallout_tile for unowned land) and fills self._near with what
--- is nearby — the owners next to the border in border order, then the shore probes: every
--- SHORE_PROBE_EVERY-th coastal tile looks SHORE_PROBE_DIST tiles away in each direction whose
--- first step is water. Free land (not fallout) is in the list as 0 (terra nullius, after the land
--- neighbours when it touches the border). True when free land is nearby.
function SimAI:_tribe_nearby(sim, id: number): boolean
	sim:scan_border(id, sim.bcount[id])
	local near = self._near
	local seen = self._near_seen
	table.clear(near)
	table.clear(seen)
	for _, p in sim.sc_list do
		near[#near + 1] = p
		seen[p] = true
	end
	local tn = sim.sc_neutral > 0
	if tn then
		near[#near + 1] = 0
		seen[0] = true
	end
	if sim.o_coast[id] <= 0 then
		return tn
	end
	local R = sim.R
	local every = R.SHORE_PROBE_EVERY
	local dist = R.SHORE_PROBE_DIST
	local W, H = sim.W, sim.H
	local terr = sim.terr
	local land = sim.land
	local owner = sim.owner
	local flags = sim.flags
	local cnext = sim.cnext
	local k = 0
	local c = sim.chead[id]
	while c ~= -1 do
		if k % every == 0 then
			local x = c % W
			local y = c // W
			for d = 1, 4 do
				local dx, dy = PROBE_DX[d], PROBE_DY[d]
				local x1, y1 = x + dx, y + dy
				if x1 < 0 or x1 >= W or y1 < 0 or y1 >= H or readu8(terr, y1 * W + x1) > T_LAKE then
					continue
				end
				local nx, ny = x + dx * dist, y + dy * dist
				if nx < 0 or nx >= W or ny < 0 or ny >= H then
					continue
				end
				local n = ny * W + nx
				if readu8(land, n) ~= 1 then
					continue
				end
				local o = readi32(owner, n * 4)
				if o == id or seen[o] or (o == 0 and bit32.band(readu8(flags, n), F_FALLOUT) ~= 0) then
					continue
				end
				seen[o] = true
				near[#near + 1] = o
				tn = tn or o == 0
			end
		end
		k += 1
		c = cnext[c]
	end
	return tn
end

--- A random nearby traitor that is not an ally (0: none).
function SimAI:_tribe_traitor(sim, id: number): number
	local pick = self._pick
	table.clear(pick)
	for _, p in self._near do
		if p > 0 and sim:is_traitor(p) and not sim:allied(id, p) then
			pick[#pick + 1] = p
		end
	end
	if #pick == 0 then
		return 0
	end
	return pick[sim.rng:randi_range(1, #pick)]
end

--- The incoming attacker (tribe attackers count too): the attacker of the
--- biggest attack on `id` that is not an ally (0: none).
function SimAI:_tribe_incoming(sim, id: number): number
	local best = 0
	local most = 0
	local o_alive = sim.o_alive
	for _, a in sim.attacks do
		if a.dead or a.target ~= id or a.troops <= most or o_alive[a.attacker] == 0 or sim:allied(id, a.attacker) then
			continue
		end
		most = a.troops
		best = a.attacker
	end
	return best
end

--- True when owner `p` holds any structure.
function SimAI._holds_structures(sim, p: number): boolean
	for _, k in STRUCTURE_KINDS do
		if sim:struct_count(p, k) > 0 then
			return true
		end
	end
	return false
end
local _holds_structures = SimAI._holds_structures

--- A tribe's attack on a player: a land attack when it shares a land border with
--- `p` (everything above reserveRatio x max troops, or above expandRatio x max
--- against a tribe that holds structures), else a transport (_tribe_boat).
function SimAI:_tribe_send(sim, id: number, p: number): boolean
	if sim.sc_count[p] > 0 then
		local keep = if sim.o_kind[p] == KIND_TRIBE and _holds_structures(sim, p)
			then self.expand_r[id]
			else self.reserve_r[id]
		local troops = sim.o_troops[id] - sim.o_cap[id] * keep
		if troops < 1.0 then
			return false
		end
		return sim:intent_attack_troops(id, sim.sc_tile[p], troops)
	end
	return self:_tribe_boat(sim, id, p)
end

--- A tribe's attack on free land: a land attack with everything above expandRatio x max
--- troops when unowned land (fallout too) touches the border, else a
--- transport to free land across the water (_tribe_boat_tn). Needs a fresh
--- scan_border of `id`.
function SimAI:_tribe_send_tn(sim, id: number): boolean
	local tile = if sim.sc_neutral_tile >= 0 then sim.sc_neutral_tile else sim.sc_fallout_tile
	if tile >= 0 then
		local troops = sim.o_troops[id] - sim.o_cap[id] * self.expand_r[id]
		if troops < 1.0 then
			return false
		end
		return sim:intent_attack_troops(id, tile, troops)
	end
	return self:_tribe_boat_tn(sim, id)
end

--- A boat to free land: every SHORE_PROBE_EVERY-th coastal tile,
--- each direction whose first step is water: when the tile SHORE_PROBE_DIST away is free land (not
--- fallout), a transport with troops / 5 lands on that shore (the first land along the probe:
--- the closest reachable shore).
function SimAI:_tribe_boat_tn(sim, id: number): boolean
	if sim.o_coast[id] <= 0 or sim.o_boats[id] >= Rules.max_boats() then
		return false
	end
	local R = sim.R
	local every = R.SHORE_PROBE_EVERY
	local dist = R.SHORE_PROBE_DIST
	local W, H = sim.W, sim.H
	local terr = sim.terr
	local land = sim.land
	local owner = sim.owner
	local flags = sim.flags
	local k = 0
	-- (a copy: a launch changes no coast, but keep the walk independent of the list)
	for _, c in sim:coast_tiles(id) do
		k += 1
		if (k - 1) % every ~= 0 then
			continue
		end
		local x = c % W
		local y = c // W
		for d = 1, 4 do
			local dx, dy = PROBE_DX[d], PROBE_DY[d]
			local x1, y1 = x + dx, y + dy
			if x1 < 0 or x1 >= W or y1 < 0 or y1 >= H or readu8(terr, y1 * W + x1) > T_LAKE then
				continue
			end
			local nx, ny = x + dx * dist, y + dy * dist
			if nx < 0 or nx >= W or ny < 0 or ny >= H then
				continue
			end
			local n = ny * W + nx
			if
				readu8(land, n) ~= 1
				or readi32(owner, n * 4) ~= 0
				or bit32.band(readu8(flags, n), F_FALLOUT) ~= 0
			then
				continue
			end
			local shore = -1
			for s = 2, dist do
				local t = (y + dy * s) * W + x + dx * s
				if readu8(terr, t) > T_LAKE then
					shore = t
					break
				end
			end
			if
				shore < 0
				or readu8(land, shore) ~= 1
				or readi32(owner, shore * 4) ~= 0
				or bit32.band(readu8(flags, shore), F_FALLOUT) ~= 0
			then
				continue
			end
			if sim.o_troops[id] / 5 < 1.0 then
				return false
			end
			if sim:launch_boat(id, shore, Rules.BOAT_ATTACK_FRACTION) then
				return true
			end
		end
	end
	return false
end

--- Closest pair of tiles: both lists sorted by x, then a sweep keeping the closest (manhattan) pair
--- it passes. Returns the tile of `ys` of that pair (-1 when a list is empty).
function SimAI._closest_two(W: number, xs: { number }, ys: { number }): number
	if #xs == 0 or #ys == 0 then
		return -1
	end
	local function by_x(a: number, b: number): boolean
		local ax, bx = a % W, b % W
		if ax ~= bx then
			return ax < bx
		end
		return a < b
	end
	table.sort(xs, by_x)
	table.sort(ys, by_x)
	local i, j = 1, 1
	local nx, ny = #xs, #ys
	local best = math.huge
	local result = ys[1]
	while i <= nx and j <= ny do
		local a, b = xs[i], ys[j]
		local ax, bx = a % W, b % W
		local d = math.abs(ax - bx) + math.abs(a // W - b // W)
		if d < best then
			best = d
			result = b
		end
		-- At the end of xs move along ys, at the end of ys along xs, else the one with smaller x.
		if i ~= nx and (j == ny or ax < bx) then
			i += 1
		else
			j += 1
		end
	end
	return result
end
local _closest_two = SimAI._closest_two

--- A tribe's boat attack: a transport with troops / 5 to the shore tile of `p` closest to
--- ours (_closest_two).
function SimAI:_tribe_boat(sim, id: number, p: number): boolean
	if sim.o_coast[id] <= 0 or sim.o_coast[p] <= 0 or sim.o_boats[id] >= Rules.max_boats() then
		return false
	end
	local dst = _closest_two(sim.W, sim:coast_tiles(id), sim:coast_tiles(p))
	if dst < 0 then
		return false
	end
	return sim:launch_boat(id, dst, Rules.BOAT_ATTACK_FRACTION)
end

--- Tribe structure deletion: once the delete cooldown (TRIBE_DELETE_COOLDOWN) is over,
--- the tribe's first structure (in the order it got them) not yet marked is marked for deletion
--- and goes TRIBE_DELETE_DELAY ticks later unless captured first.
function SimAI:_tribe_delete_next(sim, id: number)
	if sim.tick - self.last_delete[id] < TRIBE_DELETE_COOLDOWN or not _holds_structures(sim, id) then
		return
	end
	local first = nil
	for _, s in sim.struct_list do
		if not s.dead and s.owner == id and s.delete_at == 0 and (first == nil or s.owned_seq < first.owned_seq) then
			first = s
		end
	end
	if first == nil then
		return
	end
	self.last_delete[id] = sim.tick
	first.delete_at = sim.tick + TRIBE_DELETE_DELAY
	table.insert(self.doomed, first)
end

--- Marked structures go once overdue; a capture in
--- the meantime cleared the mark (a change of owner clears it).
function SimAI:_delete_doomed(sim)
	local keep = {}
	for _, s in self.doomed do
		if s.dead or s.delete_at == 0 then
			continue
		end
		if sim.tick > s.delete_at then
			sim:destroy_struct(s)
		else
			keep[#keep + 1] = s
		end
	end
	self.doomed = keep
end

return SimAI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">SimAIEconomy</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/sim_ai_economy.gd (SimAIEconomy).
-- Base of SimAI: the AI's economy (what to build and where), defense-post policy, warship
-- behaviour and the neighbour-colour upkeep. Strategy
-- (expansion, war, boats, nukes, diplomacy) lives in SimAI.
--
-- Luau: GDScript `SimAI extends SimAIEconomy` is flattened: SimAI's class table gets these
-- methods through SimAIEconomy.install(C) (one-level method lookup), and SimAI.new() calls
-- `_init_economy()` for the member initialisers. The Sim is always passed in as `sim` (no stored
-- back-reference), exactly as in GDScript.

local Defs = require("./Defs")
local Rules = require("./Rules")
local SimColors = require("./SimColors")

local readu8 = buffer.readu8
local readi32 = buffer.readi32

local f32 = Defs.f32

local STRUCT_KINDS = 16
local S_CITY = Defs.S_CITY
local S_PORT = Defs.S_PORT
local S_FACTORY = Defs.S_FACTORY
local S_DEFENSE = Defs.S_DEFENSE
local S_SAM = Defs.S_SAM
local S_SILO = Defs.S_SILO
local T_LAKE = Defs.T_LAKE

local SimAIEconomy = {}

-- 0-based table from a list (enum / difficulty keyed constants, sim-core convention).
local function zt(values: { any }): { [number]: any }
	local out = {}
	for i, v in values do
		out[i - 1] = v
	end
	return out
end
SimAIEconomy.zt = zt

-- Ticks after the start before AI nations fire nukes (also when they start saving for them).
SimAIEconomy.NUKE_AGE = zt({ 4800, 3600, 2700 })
-- No wars on nations until the land grab is over.
SimAIEconomy.NATION_WAR_AGE = 1200
-- Only the largest nations build missile silos.
SimAIEconomy.SILO_TOP_RANK = 12
-- Structures per city (ports 0.75, factories 0.75 — x0.33 when
-- the nation has a coast — SAMs 0.15 / 0.2 / 0.25 by difficulty, silos 0.4 for the first then
-- 0.2, at most 3), cities otherwise; each owned structure raises its perceived cost by
-- PERCEIVED_COST_STEP x its price until the nation has saved up for a MIRV plus a hydrogen bomb.
--
-- Reworked on 2026-10-07 so that the AI builds more
-- ports. A 20-minute match of 70 nations had 23 of
-- its 42 coastal nations without a port at minute 6. What changed:
--   * the build step walks its build order (port, factory, SAM, silo, then a city) and takes
--     the first that can be afforded AND placed. Before, it picked one kind and waited for it, so a
--     nation saving for its next port built nothing else, and one with no site for it nothing ever;
--   * CROWDED_FULL_TILES_PER_NATION: with more than a nation per 7,500 land tiles a nation's very
--     first structure is a port (a factory without a coast), for income early. On top, a nation with
--     a coast builds its port first on every map (PORT_FIRST). The density threshold is met on the
--     World map with bot players (a nation per 5,900 tiles) but on few others (Africa: one per
--     23,000), and there the change above alone left half the coastal nations without a port at
--     minute 6. Measured on World, Easy, 40 bot players: 77 ports at minute 2 (was 3), 108 at
--     minute 4 (was 49). The nations are richer for it: 2.5M gold each at minute 6, was 1.25M
--     (docs/ai.md has the tables);
--   * CITIES_BEFORE_SAVING: nothing is hoarded for nukes before the third city (the second city
--     cost 500K to an AI, so the first port, due with it, came minutes late). Easy nations
--     wait too, since public matches run Easy nations;
--   * port sites only prefer the site farthest from the nation's other ports. Before, it refused any
--     site within PORT_MIN_GAP of one, so a short coast held one port;
--   * PORT_WATER_FULL_TILES: no port on a pond (water under 3,000 tiles that is not the
--     ocean), where no trade ship could ever call, at any difficulty.
SimAIEconomy.PORT_PER_CITY = 0.75
SimAIEconomy.FACTORY_PER_CITY = 0.75
SimAIEconomy.FACTORY_COASTAL_MULT = 0.33
SimAIEconomy.SAM_PER_CITY = zt({ f32(0.15), f32(0.2), f32(0.25) }) -- PackedFloat32Array
SimAIEconomy.SILO_PER_CITY = 0.2
SimAIEconomy.FIRST_SILO_PER_CITY = 0.4
SimAIEconomy.MAX_SILOS = 3
-- Perceived cost increase per owned structure of the kind: city/port/factory/silo 1, SAM 0.3.
SimAIEconomy.PERCEIVED_COST_STEP = zt({ 1.0, 1.0, 1.0, 0.0, f32(0.3), 1.0 }) -- PackedFloat32Array
-- Upgrade density: with more than one structure per 1500 full-size tiles a nation upgrades an
-- existing structure of the chosen kind instead of placing a new one.
SimAIEconomy.UPGRADE_DENSITY_FULL_TILES = 1500.0
-- Build order after defense posts; a city when none of these is due or possible.
SimAIEconomy.BUILD_ORDER = { S_PORT, S_FACTORY, S_SAM, S_SILO }
-- Crowded map: more nations than one per this many full-size land tiles.
SimAIEconomy.CROWDED_FULL_TILES_PER_NATION = 7500.0
-- A coastal nation's first structure is a port whatever the map's density.
SimAIEconomy.PORT_FIRST = true
-- CITIES_BEFORE_SAVING: cities owned before saving up for nukes inflates structure costs.
SimAIEconomy.CITIES_BEFORE_SAVING = 3
-- Full-size tiles of water (the ocean always counts) a port needs.
SimAIEconomy.PORT_WATER_FULL_TILES = 3000.0
-- A nation that found no site for a port looks again after this many ticks (the search walks the
-- map's coast list).
SimAIEconomy.PORT_RETRY_TICKS = 300
-- At most one defense post per this many border tiles (hard cap DEFENSE_CAP).
SimAIEconomy.DEFENSE_PER_BORDER = 250
SimAIEconomy.DEFENSE_CAP = 6
-- Minimum ticks between two defense posts built by the same AI.
SimAIEconomy.DEFENSE_GAP = 600
-- Colour upkeep: after the land grab, an AI owner whose colour is within RETINT_BELOW (OKLab ΔE)
-- of a bordering owner shifts it minimally — the smaller of the two changes (never a human).
SimAIEconomy.RETINT_FROM = 1200
SimAIEconomy.RETINT_BELOW = 0.06
SimAIEconomy.RETINT_OWNER_GAP = 1200
SimAIEconomy.RETINT_PER_MINUTE = 4
-- Chance that a nation answers a sunk transport / captured trade ship / incoming invasion with a
-- new warship (Easy never, Medium 15 %, Hard 50 %); with 10+ warships it re-tasks one.
SimAIEconomy.WARSHIP_RETALIATE_P = zt({ 0.0, f32(0.15), 0.5 }) -- PackedFloat32Array
SimAIEconomy.WARSHIP_FLEET_CAP = 10

local E = SimAIEconomy
local NUKE_AGE = E.NUKE_AGE
local NATION_WAR_AGE = E.NATION_WAR_AGE
local SAM_PER_CITY = E.SAM_PER_CITY
local PERCEIVED_COST_STEP = E.PERCEIVED_COST_STEP
local WARSHIP_RETALIATE_P = E.WARSHIP_RETALIATE_P
local WARSHIP_FLEET_CAP = E.WARSHIP_FLEET_CAP

-- Tiles of each water body of a map (body id -> tiles), counted once per map.
local BODY_TILES: { [any]: { [number]: number } } = setmetatable({}, { __mode = "k" }) :: any
local function body_tiles(map: any): { [number]: number }
	local sizes = BODY_TILES[map]
	if sizes == nil then
		sizes = {}
		local wb = map.water_body
		local readu16 = buffer.readu16
		for t = 0, map.N - 1 do
			local b = readu16(wb, t * 2)
			if b ~= 0 then
				sizes[b] = (sizes[b] or 0) + 1
			end
		end
		BODY_TILES[map] = sizes
	end
	return sizes
end
SimAIEconomy.body_tiles = body_tiles

local function filled(m: number, v: number): { [number]: number }
	local t = table.create(m)
	for i = 0, m - 1 do
		t[i] = v
	end
	return t
end
SimAIEconomy.filled = filled

function SimAIEconomy.install(C)
	-- Member initialisers of sim_ai_economy.gd.
	function C:_init_economy()
		self.last_build = {} :: { [number]: number }
		-- 1 once a nation's port-first structure stands (or can't)
		self.crowded_first = {} :: { [number]: number }
		-- crowded map or not, worked out once (nil until then)
		self._crowded = nil :: boolean?
		-- the tick a nation without a port site may look for one again
		self.port_wait = {} :: { [number]: number }
		self.last_defense = {} :: { [number]: number }
		-- Land rank per owner (1 = largest), refreshed every 50 ticks.
		self.rank = {} :: { [number]: number }
		self.nukes_in_play = false
		self.last_retint = {} :: { [number]: number }
		self.retints = 0
		self._retint_window = 0
		self._retint_count = 0
		-- OKLab ({x = L, y = a, z = b}) cache per owner, valid while _lab_col[id] == its colour.
		self._lab = {} :: { [number]: any }
		self._lab_col = {} :: { [number]: number }
	end

	function C:_setup_economy(m: number)
		self.last_build = filled(m, 0)
		self.crowded_first = filled(m, 0)
		self._crowded = nil
		self.port_wait = filled(m, 0)
		self.last_defense = filled(m, -100000)
		self.rank = filled(m, 999)
		self.last_retint = filled(m, -100000)
		self._lab = table.create(m)
		self._lab_col = filled(m, -1)
	end

	-- =========================================================================================
	-- Colour upkeep
	-- =========================================================================================

	function C:_lab_of(sim, id: number)
		local c = sim.o_color[id]
		if self._lab_col[id] ~= c then
			self._lab_col[id] = c
			self._lab[id] = SimColors.oklab(c)
		end
		return self._lab[id]
	end

	-- Called after scan_border(): re-tints this AI owner when it clashes with a neighbour it is
	-- smaller than (or with any human neighbour). Rate limited per owner and worldwide.
	function C:_consider_retint(sim, id: number, age: number)
		-- (a team game: every owner keeps its team's colour)
		if sim.team_mode then
			return
		end
		if age < E.RETINT_FROM or sim.tick - self.last_retint[id] < E.RETINT_OWNER_GAP or #sim.sc_list == 0 then
			return
		end
		if sim.tick - self._retint_window >= 600 then
			self._retint_window = sim.tick
			self._retint_count = 0
		end
		if self._retint_count >= E.RETINT_PER_MINUTE then
			return
		end
		local me = self:_lab_of(sim, id)
		local clash = false
		local refs = {}
		for _, p in sim.sc_list do
			local lab = self:_lab_of(sim, p)
			table.insert(refs, lab)
			if SimColors.dist(me, lab) < E.RETINT_BELOW and (sim.o_tiles[id] <= sim.o_tiles[p] or sim:is_human(p)) then
				clash = true
			end
		end
		if not clash then
			return
		end
		local col = SimColors.shift(sim.o_color[id], refs)
		if col == sim.o_color[id] then
			return
		end
		sim:set_owner_color(id, col)
		self.last_retint[id] = sim.tick
		self._retint_count += 1
		self.retints += 1
	end

	-- =========================================================================================
	-- Economy
	-- =========================================================================================

	-- Crowded map: nations (and bot players, who play as nations; never people or tribes)
	-- per full-size land tile.
	function C:_crowded_map(sim): boolean
		local c = self._crowded
		if c == nil then
			local nations = 0
			for id = 1, sim.owner_total do
				if sim.o_ai[id] == 1 and sim.o_kind[id] ~= Defs.KIND_TRIBE then
					nations += 1
				end
			end
			local land = sim.map.land_count * sim.R.K_AREA
			c = land > 0 and nations * E.CROWDED_FULL_TILES_PER_NATION > land
			self._crowded = c
		end
		return c
	end

	-- Due: fewer of `kind` than its share of the cities (levels counted).
	function C:_structure_due(sim, id: number, kind: number, cities: number, age: number): boolean
		local d = sim:ai_difficulty(id)
		if kind == S_PORT then
			return sim.o_coast[id] > 0 and sim:struct_levels(id, S_PORT) < Defs.trunc(cities * E.PORT_PER_CITY)
		elseif kind == S_FACTORY then
			local mult = if sim.o_coast[id] > 0 then E.FACTORY_COASTAL_MULT else 1.0
			return sim:struct_levels(id, S_FACTORY) < Defs.trunc(cities * E.FACTORY_PER_CITY * mult)
		elseif kind == S_SAM then
			return sim:struct_levels(id, S_SAM) < Defs.trunc(cities * SAM_PER_CITY[d]) and age > NATION_WAR_AGE
		elseif kind == S_SILO then
			local silos = sim:struct_count(id, S_SILO)
			return silos < E.MAX_SILOS
				and silos < Defs.trunc(cities * (if silos == 0 then E.FIRST_SILO_PER_CITY else E.SILO_PER_CITY))
				and age > NUKE_AGE[d] - 900
				and self.rank[id] <= E.SILO_TOP_RANK
		end
		return false
	end

	-- Build (or, on a crowded territory, upgrade) one `kind` when the nation
	-- has its perceived cost and a place for it. True when something was ordered.
	function C:_spawn_structure(sim, id: number, kind: number, cities: number, threat: number): boolean
		local gold = sim.o_gold[id]
		local cost = Rules.build_cost_kind(kind, sim:cost_count(id, kind))
		-- Perceived cost: inflate by owned count until the MIRV + hydrogen stockpile is reached
		-- (never before the third city).
		local perceived = cost
		if kind ~= S_DEFENSE and cities >= E.CITIES_BEFORE_SAVING then
			local save_up = Rules.nuke_cost("mirv", sim.mirvs_launched) + Rules.nuke_cost("hydrogen")
			if gold < save_up then
				perceived = cost * (1.0 + PERCEIVED_COST_STEP[kind] * sim:struct_levels(id, kind))
			end
		end
		if gold < perceived then
			return false
		end
		-- on a crowded territory upgrade instead (or leave it: a construction is under way)
		if Rules.is_upgradable(kind) and sim:struct_count(id, kind) > 0 then
			local total = 0
			for k = 0, Defs.STRUCT_KIND_COUNT - 1 do
				total += sim:struct_count(id, k)
			end
			if total * E.UPGRADE_DENSITY_FULL_TILES > sim.o_tiles[id] * sim.R.K_AREA then
				local ready = {}
				for _, s in sim:structs_of(id, kind) do
					if s.active then
						table.insert(ready, s)
					end
				end
				return #ready > 0
					and sim:try_build(id, Defs.STRUCT_NAMES[kind], ready[sim.rng:randi() % #ready + 1].tile) == true
			end
		end
		local site = self:_pick_site(sim, id, kind, threat)
		return site >= 0 and sim:try_build(id, Defs.STRUCT_NAMES[kind], site) == true
	end

	function C:_consider_build(sim, id: number, age: number)
		if sim.tick - self.last_build[id] < 20 then
			return
		end
		if sim.o_gold[id] < 100000.0 then
			return
		end
		-- Cities count by level.
		local cities = sim:struct_levels(id, S_CITY)
		local threat = self:_defense_threat(sim, id)
		-- A defense post against a threatening neighbour comes before the economy.
		if
			cities > 0
			and threat > 0
			and sim:struct_count(id, S_DEFENSE) < self:_defense_cap(sim, id)
			and sim.tick - self.last_defense[id] >= E.DEFENSE_GAP
			and sim.rng:randf() < 0.35
		then
			if self:_spawn_structure(sim, id, S_DEFENSE, cities, threat) then
				self.last_build[id] = sim.tick
				self.last_defense[id] = sim.tick
			end
			return
		end
		-- The very first structure is a port; without a coast a factory, on a crowded map only.
		if self.crowded_first[id] == 0 then
			local coastal = sim.o_coast[id] > 0
			if (coastal and E.PORT_FIRST) or self:_crowded_map(sim) then
				local first = if coastal then S_PORT else S_FACTORY
				if sim.o_gold[id] >= Rules.build_cost_kind(first, sim:cost_count(id, first)) then
					-- (with the gold and still nothing built: there is no place for it, cities then)
					self.crowded_first[id] = 1
					if self:_spawn_structure(sim, id, first, cities, threat) then
						self.last_build[id] = sim.tick
						return
					end
				end
			else
				self.crowded_first[id] = 1
			end
		end
		for _, kind in E.BUILD_ORDER do
			if self:_structure_due(sim, id, kind, cities, age) and self:_spawn_structure(sim, id, kind, cities, threat) then
				self.last_build[id] = sim.tick
				return
			end
		end
		if self:_spawn_structure(sim, id, S_CITY, cities, threat) then
			self.last_build[id] = sim.tick
		end
	end

	-- Defense posts are allowed on long borders only: 1 per DEFENSE_PER_BORDER border tiles
	-- (at least 1, at most DEFENSE_CAP).
	function C:_defense_cap(sim, id: number): number
		if sim.o_kind[id] == Defs.KIND_TRIBE then
			return 1
		end
		return math.clamp(sim.bcount[id] // (E.DEFENSE_PER_BORDER * sim.R.LEGACY_LIN), 1, E.DEFENSE_CAP)
	end

	-- The neighbour worth fortifying against, sharing a real border: one attacking us now, one
	-- that attacked us in the last minute and is not trivially weak, or (after the land grab) a
	-- nation much stronger than us along a long border. Tribes only fortify against live attacks.
	-- 0 when nobody threatens us.
	function C:_defense_threat(sim, id: number): number
		local mine = math.max(sim.o_troops[id], 1.0)
		local age = sim.tick - sim.playing_since
		local tribe = sim.o_kind[id] == Defs.KIND_TRIBE
		local best = 0
		local bs = 0.0
		local sc_count = sim.sc_count
		local L = sim.R.LEGACY_LIN
		for _, p in sim.sc_list do
			if sc_count[p] < 6 * L or sim:allied(id, p) then
				continue
			end
			local theirs = sim.o_troops[p]
			local attacking = sim:attack_between(p, id) ~= nil
			local ok = attacking
			if not ok and not tribe then
				-- (GDScript: if grudge… ok = true elif war-age… ok = true)
				if
					(sim:grudge_of(id, p) and theirs > 0.7 * mine)
					or (
						age > NATION_WAR_AGE
						and sim.o_kind[p] ~= Defs.KIND_TRIBE
						and theirs > 1.5 * mine
						and sc_count[p] >= 12 * L
					)
				then
					ok = true
				end
			end
			if not ok then
				continue
			end
			local s = theirs * (if attacking then 2.0 else 1.0)
			if s > bs then
				bs = s
				best = p
			end
		end
		if best < 0 then
			self.port_wait[id] = sim.tick + E.PORT_RETRY_TICKS
		end
		return best
	end

	function C:_pick_site(sim, id: number, kind: number, threat: number): number
		local tiles = sim.o_tiles[id]
		if kind == S_PORT then
			return self:_port_site(sim, id)
		elseif kind == S_FACTORY then
			return self:_factory_site(sim, id)
		elseif kind == S_DEFENSE then
			return self:_defense_site(sim, id, threat)
		elseif kind == S_SAM then
			local cities = sim:structs_of(id, S_CITY)
			if #cities > 0 then
				local s = sim:find_site(
					id,
					kind,
					cities[sim.rng:randi() % #cities + 1].tile,
					math.ceil(8 * sim.R.LEGACY_LIN),
					16
				)
				if s >= 0 then
					return s
				end
			end
		end
		-- Cities (and silos / fallback SAMs) sit around the centre of the territory.
		local L = sim.R.LEGACY_LIN
		local spread = math.clamp(Defs.trunc(math.sqrt(tiles) * 0.45), math.ceil(6 * L), math.ceil(45 * L))
		local site = sim:find_site(id, kind, sim:centre_tile(id), spread, 24)
		if site < 0 then
			site = sim:find_site(
				id,
				kind,
				if sim.o_spawn_tile[id] >= 0 then sim.o_spawn_tile[id] else sim.bhead[id],
				spread,
				12
			)
		end
		return site
	end

	-- Ports spread along the coast: the valid coastal site farthest from our other ports
	-- (structures keep STRUCT_MIN_DIST apart as everywhere), on the ocean or
	-- on water big enough for trade.
	function C:_port_site(sim, id: number): number
		if sim.tick < self.port_wait[id] then
			return -1
		end
		local sizes = body_tiles(sim.map)
		local need = E.PORT_WATER_FULL_TILES / sim.R.K_AREA
		local cb = sim.map.coast_body
		local readu16 = buffer.readu16
		local function water_ok(t: number): boolean
			local b = readu16(cb, t * 2)
			return b == 1 or (sizes[b] or 0) >= need
		end
		local anchor = sim:own_coast_tile(id)
		local best = -1
		local best_d = -1.0
		local ct = sim.map.coast_list
		local nct = sim.map.coast_count
		local owner = sim.owner
		local L = sim.R.LEGACY_LIN
		local far = math.ceil(60 * L)
		-- our coast tiles (big maps have tens of thousands of coast tiles, so a blind pick from the
		-- map's list is rarely ours): one pass, at most 4096 kept
		local mine = {}
		for k = 0, nct - 1 do
			local r = readi32(ct, k * 4)
			if readi32(owner, r * 4) == id and water_ok(r) then
				mine[#mine + 1] = r
				if #mine >= 4096 then
					break
				end
			end
		end
		for i = 0, 35 do
			local c = -1
			if i < 16 then
				c = sim:find_site(id, S_PORT, anchor, math.ceil(30 * L), 1)
			elseif #mine > 0 then
				local r = mine[sim.rng:randi() % #mine + 1]
				if sim:valid_site(id, S_PORT, r) then
					c = r
				end
			end
			if c < 0 or not water_ok(c) then
				continue
			end
			local dd = sim:own_struct_dist2(id, S_PORT, c, far)
			if dd < 0.0 then
				dd = far * far + 1.0
			end
			if dd > best_d then
				best_d = dd
				best = c
			end
		end
		if best < 0 then
			self.port_wait[id] = sim.tick + E.PORT_RETRY_TICKS
		end
		return best
	end

	-- Factories go next to an existing city or port that is already on the road network.
	function C:_factory_site(sim, id: number): number
		local hubs = {}
		local any = {}
		for _, k in { S_CITY, S_PORT } do
			for _, s in sim:structs_of(id, k) do
				table.insert(any, s)
				if s.station then
					table.insert(hubs, s)
				end
			end
		end
		if #hubs == 0 then
			hubs = any
		end
		for _ = 1, math.min(#hubs, 4) do
			local h = hubs[sim.rng:randi() % #hubs + 1]
			local site =
				sim:find_site(id, S_FACTORY, h.tile, sim.R.STRUCT_SPACING + math.ceil(3 * sim.R.LEGACY_LIN), 14)
			if site >= 0 then
				return site
			end
		end
		return -1
	end

	-- A defense post just behind the border facing `threat`, never inside the radius of another
	-- of our posts.
	function C:_defense_site(sim, id: number, threat: number): number
		if threat <= 0 or sim.sc_count[threat] <= 0 then
			return -1
		end
		local contact = sim.sc_tile[threat]
		local r = sim.R.DEFENSE_RADIUS
		local near = math.ceil(4 * sim.R.LEGACY_LIN)
		for _ = 1, 16 do
			local c = sim:find_site(id, S_DEFENSE, contact, near, 1)
			if c >= 0 and sim:own_struct_dist2(id, S_DEFENSE, c, r) < 0.0 then
				return c
			end
		end
		return -1
	end

	-- =========================================================================================
	-- Warships (the nations' warship behaviour)
	-- =========================================================================================

	function C:_warship_cost(sim, id: number): number
		return Rules.build_cost(
			Rules.WARSHIP_KIND_NAME,
			math.min(sim.o_warships[id], sim.o_built[id * STRUCT_KINDS + Rules.BUILT_WARSHIP])
		)
	end

	-- Each attack cycle, chance 1 in 50: the first warship, patrolling a random
	-- sea tile within 250 full-size tiles of one of the nation's ports.
	function C:_maybe_spawn_warship(sim, id: number)
		if sim.rng:randi() % 50 ~= 0 or sim.o_warships[id] > 0 or sim.o_gold[id] <= self:_warship_cost(sim, id) then
			return
		end
		local ports = {}
		for _, p in sim.port_list do
			if p.owner == id and p.water >= 0 then
				table.insert(ports, p)
			end
		end
		if #ports == 0 then
			return
		end
		local port = ports[sim.rng:randi() % #ports + 1]
		local t = self:_sea_tile_near(sim, port.tile, 250.0 / sim.R.K_LIN)
		if t >= 0 then
			sim:build_warship(id, t)
		end
	end

	-- A random water tile within `r` tiles (box) of `t`, or -1.
	function C:_sea_tile_near(sim, t: number, r: number): number
		local ri = Defs.trunc(r)
		local rx = sim.geo_span(t, r)
		local terrain = sim.map.terrain
		local region = sim.nav.region
		local rng = sim.rng
		local W = sim.W
		for _ = 1, 50 do
			local x = (t % W) + rng:randi_range(-rx, rx)
			local y = (t // W) + rng:randi_range(-ri, ri)
			if y < 1 or y >= sim.H - 1 or x < 0 or x >= W then
				continue
			end
			local c = y * W + x
			if readu8(terrain, c) <= T_LAKE and readi32(region, c * 4) >= 0 then
				return c
			end
		end
		return -1
	end

	function C:on_transport_sunk(sim, u, killer: number)
		if killer > 0 and self:_tracks_ships(sim, u.owner) then
			self:_retaliate(sim, u.owner, sim:unit_tile(u), killer)
		end
	end

	function C:on_trade_captured(sim, victim: number, captor: number, t: number)
		if self:_tracks_ships(sim, victim) then
			self:_retaliate(sim, victim, t, captor)
		end
	end

	-- Retaliation: an invasion heading for a nation with no warship within
	-- 90 full-size tiles of the landing (by position or patrol tile) makes it answer near the landing.
	function C:on_transport_launched(sim, u, tg: number)
		if not self:_tracks_ships(sim, tg) or sim:allied(u.owner, tg) or u.target_tile < 0 then
			return
		end
		local r = 90.0 / sim.R.K_LIN
		local range_d2 = sim.range_d2
		local geo_manhattan = sim.geo_manhattan
		for _, w in sim.warship_list do
			if w.dead or w.owner ~= tg then
				continue
			end
			if
				range_d2(sim:unit_tile(w), u.target_tile) <= r * r
				or (w.patrol >= 0 and geo_manhattan(u.target_tile, w.patrol) < r)
			then
				return
			end
		end
		local sea = self:_sea_tile_near(sim, u.target_tile, 30.0 / sim.R.K_LIN)
		if sea >= 0 then
			self:_retaliate(sim, tg, sea, u.owner)
		end
	end

	function C:_tracks_ships(sim, id: number): boolean
		return id > 0
			and sim.o_ai[id] == 1
			and (sim.o_kind[id] == Defs.KIND_NATION or sim.o_bot[id] == 1)
			and sim.o_alive[id] == 1
			and sim:ai_difficulty(id) > 0
			and sim.o_built[id * STRUCT_KINDS + S_PORT] > 0
	end

	function C:_retaliate(sim, id: number, t: number, enemy: number)
		if enemy == id or t < 0 then
			return
		end
		if sim.o_warships[id] >= WARSHIP_FLEET_CAP then
			self:_move_nearest_warship(sim, id, t)
			return
		end
		if sim.rng:randf() < WARSHIP_RETALIATE_P[sim:ai_difficulty(id)] then
			if
				readu8(sim.map.terrain, t) > T_LAKE
				or sim.o_gold[id] < self:_warship_cost(sim, id)
				or not sim:build_warship(id, t)
			then
				self:_move_nearest_warship(sim, id, t)
			end
		end
	end

	-- Re-tasking: the nearest warship still near its own patrol area takes `t` as patrol tile.
	function C:_move_nearest_warship(sim, id: number, t: number)
		if readu8(sim.map.terrain, t) > T_LAKE then
			return
		end
		local near = Rules.WARSHIP_RANGE_FULL / sim.R.K_LIN
		local geo_manhattan = sim.geo_manhattan
		local best = nil
		local bd = 0.0
		for _, w in sim.warship_list do
			if w.dead or w.owner ~= id or w.patrol < 0 then
				continue
			end
			local pos = sim:unit_tile(w)
			if geo_manhattan(pos, w.patrol) >= near then
				continue
			end
			local d = geo_manhattan(pos, t)
			if best == nil or d < bd then
				best = w
				bd = d
			end
		end
		if best ~= nil then
			sim:move_warship(id, best.uid, t)
		end
	end

	-- Warship swarms (Hard only): when 10+ warships sail and some enemy owns more than
	-- 10, one of the three richest AI owners builds a warship on top of one of them.
	function C:_counter_infestation(sim, id: number)
		if sim:ai_difficulty(id) < 2 or #sim.warship_list <= WARSHIP_FLEET_CAP or sim.o_warships[id] >= WARSHIP_FLEET_CAP then
			return
		end
		if sim.o_gold[id] < self:_warship_cost(sim, id) or sim.o_alevel[id * STRUCT_KINDS + S_PORT] <= 0 then
			return
		end
		local richer = 0
		local o_alive = sim.o_alive
		local o_gold = sim.o_gold
		for p = 1, sim.owner_total do
			if p ~= id and o_alive[p] == 1 and sim.o_kind[p] ~= Defs.KIND_HUMAN and o_gold[p] > o_gold[id] then
				richer += 1
				if richer >= 3 then
					return
				end
			end
		end
		for p = 1, sim.owner_total do
			if p == id or o_alive[p] == 0 or sim:allied(id, p) or sim.o_warships[p] <= WARSHIP_FLEET_CAP then
				continue
			end
			local theirs = {}
			for _, w in sim.warship_list do
				if not w.dead and w.owner == p then
					table.insert(theirs, w)
				end
			end
			if #theirs == 0 then
				continue
			end
			local target = theirs[sim.rng:randi() % #theirs + 1]
			local t = sim:unit_tile(target)
			if not sim:build_warship(id, t) then
				self:_move_nearest_warship(sim, id, t)
			end
			return
		end
	end
end

return SimAIEconomy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">SimArsenal</string>
            <string name="Source"><![CDATA[--!native
-- The Arsenal (2026-10-04): units such as Artillery and special nukes, each earned with the
-- in-game currency or bought with Robux. A mixin of the flattened Sim class, after
-- SimNukes. What a player may use is a bit mask per owner (Sim.o_unlock, Defs.UNLOCK; the match's host
-- sets it from the player's saved unlocks with Sim.set_unlocks): without the bit the Sim refuses the
-- build, the launch or the call. The AI builds none of it.
--
--   Artillery (structure)  shells whatever isn't its owner's or an ally's within range, on its own
--   Airfield (structure)   flies an air strike at a tile within range, then rearms
--   Railgun (structure)    fires a slug at any tile on the map, then reloads
--   Mega Nuke (silo)       an atom bomb with twice the radii
--   Scattershot (silo)     an atom bomb's crater, and 4 to 6 warheads around it
--   Reinforcements (call)  gold for a fifth of the troop cap
--   Rapid Reload           every reload of its owner's takes half as long
--
-- Shells, air strikes and slugs are munitions like the bombs (SimNukes: the same list, the same NUKE /
-- BOOM events, a straight flight path), but they land as a strike (_strike): they take no land and
-- leave no fallout. A strike kills a share of each army with land under it and damages the structures
-- there, never its owner's or an ally's. Structures have health only for this (Rules.STRUCT_HP): at 0
-- one loses a level and is whole again, or is destroyed at level 1.

local Defs = require("./Defs")
local Ev = require("./Ev")
local Rules = require("./Rules")
local SimState = require("./SimState")

local readi32 = buffer.readi32
local readu8 = buffer.readu8

local filled = SimState.filled
local a_an = SimState.a_an
local MAXO = Defs.MAX_OWNERS
local STRUCT_KINDS = SimState.STRUCT_KINDS

local S_SAM = Defs.S_SAM
local S_SILO = Defs.S_SILO
local S_ARTILLERY = Defs.S_ARTILLERY
local U_TRANSPORT = Defs.U_TRANSPORT
local N_WARHEAD = Defs.N_WARHEAD
local N_SCATTER = Defs.N_SCATTER
local N_SHELL = Defs.N_SHELL
local N_AIRSTRIKE = Defs.N_AIRSTRIKE
local N_SLUG = Defs.N_SLUG
local UNLOCK = Defs.UNLOCK

local SimArsenal = {}

--- What a locked build / launch / call tells the player (the client offers the unlock itself).
SimArsenal.LOCKED_TEXT = "Unlock %s in the Arsenal first"

function SimArsenal.install(C)
	function C:_init_arsenal()
		--- Defs.UNLOCK bits per owner.
		self.o_unlock = filled(MAXO, 0)
		--- Tick of each owner's last Reinforcements call.
		self.o_reinforce_tick = filled(MAXO, -100000)
		--- Finished batteries, in the order they finished.
		self.batteries = {} :: { any }
	end

	--- The Arsenal unlocks `id` plays with (a Defs.UNLOCK bit mask), from now on.
	function C:set_unlocks(id: number, mask: number)
		if id > 0 and id < MAXO and type(mask) == "number" and mask == mask then
			self.o_unlock[id] = bit32.band(math.max(0, math.floor(mask)), Defs.UNLOCK_ALL)
		end
	end

	function C:has_unlock(id: number, bit: number): boolean
		return bit == 0 or bit32.band(self.o_unlock[id] or 0, bit) ~= 0
	end

	--- Neither `a`'s own nor an ally's: what a strike may hurt.
	function C:_strike_enemy(a: number, b: number): boolean
		return b > 0 and b ~= a and not self:allied(a, b)
	end

	--- The tick to record for a shot `s` fires now (its `shots` queue: a shot reloads until that tick
	--- + Rules.RELOAD_TICKS). With Rapid Reload the shot is recorded as fired earlier, so everything
	--- that reads the queue (the Sim, the mirror's reload bar) needs only the kind's own reload time.
	function C:shot_stamp(s: any): number
		local tick = self.tick
		if bit32.band(self.o_unlock[s.owner] or 0, UNLOCK.reload2x) == 0 then
			return tick
		end
		local base = Rules.RELOAD_TICKS[s.kind] or 0
		return tick - (base - math.max(1, math.ceil(base * Rules.RAPID_RELOAD_MULT)))
	end

	-- =========================================================================================
	-- Structure health
	-- =========================================================================================

	--- `dmg` to structure `s` from owner `by`: at 0 health it loses a level (and is whole again) or,
	--- at level 1, is destroyed.
	function C:damage_struct(s: any, dmg: number, by: number)
		if s.dead or dmg <= 0 then
			return
		end
		local full = Rules.STRUCT_HP[s.kind] or 1000
		s.hp = (s.hp or full) - dmg
		if s.hp > 0 then
			return
		end
		local owner = s.owner
		local title = Defs.STRUCT_TITLES[s.kind]
		if s.level <= 1 then
			self:destroy_struct(s)
			self:msg(owner, Defs.MSG_BAD, string.format("%s destroyed your %s", self:name_of(by), title))
			return
		end
		s.level -= 1
		s.hp = full
		local b = owner * STRUCT_KINDS + s.kind
		self.o_slevel[b] -= 1
		if s.active then
			self.o_alevel[b] -= 1
		end
		self:ev({ Ev.STRUCT_LEVEL, s.sid, s.level, s.active_tick })
		-- a SAM or silo loses a missile slot: one still reloading goes first
		if (s.kind == S_SAM or s.kind == S_SILO) and #s.shots > s.level then
			while #s.shots > s.level do
				table.remove(s.shots)
			end
			self:ev({ Ev.STRUCT_SHOTS, s.sid, table.clone(s.shots) })
		end
		self:msg(
			owner,
			Defs.MSG_BAD,
			string.format("%s knocked your %s down to level %d", self:name_of(by), title, s.level)
		)
	end

	-- =========================================================================================
	-- Artillery
	-- =========================================================================================

	--- A finished battery starts its first gap (SimStructures._activate).
	function C:_battery_ready(s: any)
		s.next_fire = self.tick + self:_battery_gap(s)
		table.insert(self.batteries, s)
	end

	function C:_battery_gap(s: any): number
		local gap = self.rng:randi_range(Rules.ARTILLERY_GAP_MIN, Rules.ARTILLERY_GAP_MAX)
		if bit32.band(self.o_unlock[s.owner] or 0, UNLOCK.reload2x) ~= 0 then
			gap = math.max(1, math.ceil(gap * Rules.RAPID_RELOAD_MULT))
		end
		return gap
	end

	--- Where battery `s` aims: the nearest structure in range that isn't its owner's or an ally's,
	--- else enemy land found by a few random looks over its range. -1: nothing.
	function C:_battery_target(s: any): number
		local R = self.R
		local id = s.owner
		local range = R.artillery_range()
		local r2 = range * range
		local range_d2 = self.range_d2
		local best = -1
		local bd = 0.0
		for _, st in self:structs_in_box(s.tile, self.geo_span(s.tile, range), math.ceil(range)) do
			if st.dead or not self:_strike_enemy(id, st.owner) then
				continue
			end
			local d = range_d2(s.tile, st.tile)
			if d <= r2 and (best < 0 or d < bd or (d == bd and st.tile < best)) then
				best = st.tile
				bd = d
			end
		end
		if best >= 0 then
			return best
		end
		local W, H = self.W, self.H
		local cx, cy = s.tile % W, s.tile // W
		local owner = self.owner
		local land = self.land
		local rng = self.rng
		for _ = 1, Rules.ARTILLERY_SAMPLES do
			local ang = rng:randf() * 2.0 * math.pi
			local rad = range * math.sqrt(rng:randf())
			local x = math.floor(cx + math.cos(ang) * rad + 0.5)
			local y = math.floor(cy + math.sin(ang) * rad + 0.5)
			if x < 0 or y < 0 or x >= W or y >= H then
				continue
			end
			local t = y * W + x
			if readu8(land, t) == 1 and self:_strike_enemy(id, readi32(owner, t * 4)) then
				return t
			end
		end
		return -1
	end

	--- Batteries whose gap is over fire a shell (or look again in a moment).
	function C:arsenal_tick()
		local list = self.batteries
		local n = #list
		if n == 0 then
			return
		end
		local tick = self.tick
		local R = self.R
		local w = 0
		for i = 1, n do
			local s = list[i]
			if s.dead then
				continue
			end
			w += 1
			list[w] = s
			if tick < s.next_fire then
				continue
			end
			local t = self:_battery_target(s)
			if t < 0 then
				s.next_fire = tick + Rules.ARTILLERY_IDLE_TICKS
				continue
			end
			s.next_fire = tick + self:_battery_gap(s)
			local arc = R.munition_arc(self.W, self.H, s.tile, t, N_SHELL)
			self:_spawn_nuke(N_SHELL, s.owner, s.tile, t, R.nuke_arc_ticks(arc, N_SHELL), arc)
		end
		for i = n, w + 1, -1 do
			list[i] = nil
		end
	end

	-- =========================================================================================
	-- Strikes (a shell, an air strike or a slug lands)
	-- =========================================================================================

	function C:_strike(n: any)
		local kind = n.kind
		local to = n.to_tile
		local shooter = n.owner
		local R = self.R
		local range_d2 = self.range_d2
		local _, radius = R.nuke_radii(kind)
		local r2 = radius * radius
		local owner = self.owner
		-- land under the blast, per army that isn't the shooter's or an ally's (a shell: the tile it hits)
		local hit: { [number]: number } = {}
		local order = {}
		if kind == N_SHELL then
			local o = readi32(owner, to * 4)
			if self:_strike_enemy(shooter, o) then
				hit[o] = 1
				table.insert(order, o)
			end
		else
			for _, t in self:disk_tiles(to, radius, true) do
				local o = readi32(owner, t * 4)
				if self:_strike_enemy(shooter, o) then
					if hit[o] == nil then
						hit[o] = 0
						table.insert(order, o)
					end
					hit[o] += 1
				end
			end
		end
		local o_troops = self.o_troops
		local dbg_flow = self.dbg_flow
		local tick = self.tick
		for _, o in order do
			local troops = o_troops[o]
			local kill = Rules.strike_kill(kind, troops, hit[o] * R.K_AREA)
			if kill <= 0 then
				continue
			end
			local keep = 1.0 - kill / math.max(troops, 1.0)
			dbg_flow[o * 5 + 3] += kill
			o_troops[o] = troops - kill
			if kind ~= N_SHELL then
				-- the same share of its armies in the field and at sea
				for _, a in self.attacks do
					if not a.dead and a.attacker == o then
						a.troops *= keep
					end
				end
				for _, u in self.unit_list do
					if not u.dead and u.owner == o and u.kind == U_TRANSPORT then
						u.troops *= keep
					end
				end
				self:add_grudge(o, shooter, Rules.HOSTILE_TICKS)
				self.o_attacked_tick[o] = tick
			end
		end
		local dmg = Rules.STRIKE_DAMAGE[kind] or 0
		if dmg > 0 then
			local r = math.max(1, math.ceil(radius))
			for _, s in self:structs_in_box(to, math.max(1, self.geo_span(to, radius)), r) do
				if not s.dead and self:_strike_enemy(shooter, s.owner) and range_d2(to, s.tile) <= r2 then
					self:damage_struct(s, dmg, shooter)
				end
			end
		end
		self:ev({ Ev.BOOM, n.uid, kind, to, math.max(1, math.ceil(radius)), shooter })
		local victim = readi32(owner, to * 4)
		if kind ~= N_SHELL and self:_strike_enemy(shooter, victim) then
			self:msg(
				victim,
				Defs.MSG_BAD,
				string.format(
					"%s from %s hit your land",
					SimState.cap_first(a_an(Defs.NUKE_TITLES[kind])),
					self.o_name[shooter]
				)
			)
		end
	end

	-- =========================================================================================
	-- Scattershot
	-- =========================================================================================

	--- The warheads that leave the silo with a scattershot aimed at `aim`: Rules.SCATTER_MIN..MAX of
	--- them, evenly around the aim point (a random turn, a little jitter), SCATTER_NEAR..FAR tiles out,
	--- never onto `id`'s or an ally's land. Each lands a moment after the last.
	function C:_scatter_warheads(id: number, from_tile: number, aim: number, flight: number)
		local R = self.R
		local rng = self.rng
		local W, H = self.W, self.H
		local ax, ay = aim % W, aim // W
		local owner = self.owner
		local count = rng:randi_range(Rules.SCATTER_MIN, Rules.SCATTER_MAX)
		local base = rng:randf() * 2.0 * math.pi
		local near, far = Rules.SCATTER_NEAR_FULL / R.K_LIN, Rules.SCATTER_FAR_FULL / R.K_LIN
		local fired = 0
		for i = 0, count - 1 do
			local t = -1
			for _ = 1, 6 do
				local ang = base + i * 2.0 * math.pi / count + rng:randf_range(-0.3, 0.3)
				local rad = rng:randf_range(near, far)
				local x = math.floor(ax + math.cos(ang) * rad + 0.5)
				local y = math.floor(ay + math.sin(ang) * rad + 0.5)
				if x < 0 or y < 0 or x >= W or y >= H then
					continue
				end
				local c = y * W + x
				local o = readi32(owner, c * 4)
				if o == id or (o ~= 0 and self:allied(id, o)) then
					continue
				end
				t = c
				break
			end
			if t < 0 then
				continue
			end
			fired += 1
			local arc = R.nuke_arc(W, H, from_tile, t)
			local wn = self:_spawn_nuke(
				N_WARHEAD,
				id,
				from_tile,
				t,
				math.max(flight, R.nuke_arc_ticks(arc, N_SCATTER)) + fired * 2,
				arc
			)
			wn.target_owner = readi32(owner, t * 4)
		end
	end

	-- =========================================================================================
	-- Reinforcements
	-- =========================================================================================

	--- Ticks until `id` may call Reinforcements again (0: now).
	function C:reinforce_wait(id: number): number
		return math.max(0, self.o_reinforce_tick[id] + Rules.REINFORCE_COOLDOWN_TICKS - self.tick)
	end

	--- Reinforcements intent: Rules.REINFORCE_COST gold for a fifth of the troop cap, never past it.
	function C:reinforce(id: number): boolean
		if not self:has_unlock(id, UNLOCK.reinforce) then
			self:msg(id, Defs.MSG_INFO, string.format(SimArsenal.LOCKED_TEXT, "Reinforcements"))
			return false
		end
		local wait = self:reinforce_wait(id)
		if wait > 0 then
			self:msg(
				id,
				Defs.MSG_INFO,
				string.format("Reinforcements are ready in %d s", math.ceil(wait / Rules.TICK_RATE))
			)
			return false
		end
		local troops = Rules.reinforce_troops(self.o_troops[id], self.o_cap[id])
		if troops <= 0 then
			self:msg(id, Defs.MSG_INFO, "Your army is already at its cap")
			return false
		end
		if self.o_gold[id] < Rules.REINFORCE_COST then
			self:msg(id, Defs.MSG_INFO, "Not enough gold for Reinforcements")
			return false
		end
		self.o_gold[id] -= Rules.REINFORCE_COST
		self.o_troops[id] += troops
		self.o_reinforce_tick[id] = self.tick
		self:ev({ Ev.REINFORCE, id, troops, self.tick + Rules.REINFORCE_COOLDOWN_TICKS })
		self._force_stats = true
		return true
	end
end

return SimArsenal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">SimAttacks</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/sim_attacks.gd (mixin, installed after SimState): attacks — troops
-- committed against one target owner (0 = expansion into unclaimed land). The rules run in
-- full-size-tile units (see Rules: one of our tiles is K_AREA full-size tiles, border lengths
-- scale by K_LIN). On unscaled maps (K_LIN = 1) an attack works
-- tile for tile:
--
--   * the queue: a min-priority queue of the target's tiles next to the attacker. _add_neighbors
--     queues each target-owned land neighbour of a tile with priority
--     ticks + (random 0..6 + 10) * (1 - 0.5 n + mag / 2), n = the attacker's neighbours of it
--     counted BEFORE the tile being conquered changes hands, mag = PRIORITY_MAG (plains 1,
--     highland 1.5, mountain 2). 4 x priority is an integer (mag / 2 is a multiple of 1/4), so
--     the queue is a bucket queue keyed by it: same order as a priority heap up to ties.
--   * the attack's border (borderSize, `front`): tiles queued and not yet dequeued.
--   * tick: borderSize = border + random 0..4; a budget of 1; while budget > 0: stop (troops
--     lost) under 1 troop; an empty queue ends the attack and the troops go home; dequeue a tile,
--     drop it from the border, skip it unless it is still the target's and touches the attacker;
--     _add_neighbors(tile); attack logic → budget -= tickFraction, troops -= attackerTroopLoss, the
--     defender loses floor(troops / tiles); conquer; a dead defender (< 100 tiles) is annexed.
--   * init: troops are taken (floored) from the attacker; an opposing attack of the target cancels
--     troops first; an existing attack on the same target is absorbed (its troops join and the
--     queue is rebuilt from the whole border: _seed_from_border); a new attack starts conquering the
--     tick after the order (new attacks are initialised at the end of a tick).
--   * retreat: the attack keeps going for the rest of the order's tick and the
--     next one, then freezes; RETREAT_DELAY_TICKS later the troops come home (-25 % against a
--     player, malusForRetreat).
-- One attack per (attacker, target) pair, so a boat landing joins the running attack on that
-- target; MAX_TILES_PER_TICK caps an attack at ~572 full-size tiles per tick (Luau performance
-- guard).
-- For K_AREA > 1 one of our tiles is taken over one or more ticks (`chew` carries the progress in
-- full-size tiles), so the same land area falls per second on every map.
--
-- Luau: Attack objects are plain tables; `attacks` is a 1-based array in creation order.
-- The conquest queue is a bucket queue: `ring[key % RING]` holds the tiles of keys within RING of
-- each other (1-based stacks; ties pop last-in first), keys further
-- out wait in the sparse `over` (key → stack). The border set is the `fmark` i32 buffer (tile → aid
-- of the attack whose border holds it); a tile in two attacks' borders at once goes to the second
-- attack's `xb` set.
local Defs = require("./Defs")
local Ev = require("./Ev")
local Rules = require("./Rules")
local SimState = require("./SimState")
local Coop = require("../Net/Coop")

local MAXO = Defs.MAX_OWNERS
local F_FALLOUT = Defs.F_FALLOUT
local RING = 256
local RING_MASK = 255
local PRIORITY_BASE = Rules.PRIORITY_BASE
local PRIORITY_RAND = Rules.PRIORITY_RAND

local readi32 = buffer.readi32
local writei32 = buffer.writei32
local readu8 = buffer.readu8

local set_owner = SimState.set_owner
local touches = SimState.touches

local SimAttacks = {}
SimAttacks.RING = RING

--- A new Attack record (GDScript class SimAttacks.Attack).
function SimAttacks.new_attack(): any
	return {
		aid = 0,
		attacker = 0,
		target = 0,
		troops = 0.0,
		--- Full-size tiles already taken of `head`, the tile being conquered (-1: none).
		chew = 0.0,
		head = -1,
		--- borderSize: tiles in the attack's border.
		front = 0,
		--- Border tiles whose fmark belongs to another live attack (tile → true), or nil.
		xb = nil :: { [number]: boolean }?,
		--- The queue: ring buckets (slot → stack), their entry count and key range [qmin, qhi]
		--- (qhi is an upper bound); `over` holds keys outside it (key → stack), `osize` entries
		--- from key `omin` up. A tile may be queued more than once.
		ring = {} :: { [number]: { number } },
		rsize = 0,
		qmin = 0,
		qhi = 0,
		over = nil :: { [number]: { number } }?,
		osize = 0,
		omin = 0,
		last_tile = -1,
		sent_troops = -1,
		started_tick = 0,
		--- Retreat order: frozen from `frozen_from`, troops home at `retreat_at` (0 = no order).
		retreat_at = 0,
		frozen_from = 0,
		--- Troops of a new order on the same target, absorbed at the end of the tick.
		pend = 0.0,
		--- Started while the target was attacking us (a counter-attack, not a declaration of war).
		counter = false,
		dead = false,
	}
end
local new_attack = SimAttacks.new_attack

-- 4 x (1 - 0.5 n + mag / 2) by terrain code * 5 + n (n = attacker-owned neighbours, 0..4).
local PRIORITY_F4: { [number]: number } = {}
for tt = 0, 6 do
	for n = 0, 4 do
		PRIORITY_F4[tt * 5 + n] = 4 - 2 * n + math.floor(2 * Rules.PRIORITY_MAG[tt] + 0.5)
	end
end
SimAttacks.PRIORITY_F4 = PRIORITY_F4

-- =============================================================================================
-- Conquest queue and border set
-- =============================================================================================

--- Entries queued (including duplicates).
local function qsize(a: any): number
	return a.rsize + a.osize
end
SimAttacks.qsize = qsize

--- Queues `t` under `key`.
local function _enqueue(a: any, t: number, key: number)
	local rsize = a.rsize
	local in_ring
	if rsize == 0 then
		in_ring = true
		a.qmin = key
		a.qhi = key
	elseif key < a.qmin then
		in_ring = a.qhi - key < RING
		if in_ring then
			a.qmin = key
		end
	elseif key > a.qhi then
		in_ring = key - a.qmin < RING
		if in_ring then
			a.qhi = key
		end
	else
		in_ring = true
	end
	if in_ring then
		local ring = a.ring
		local slot = bit32.band(key, RING_MASK)
		local b = ring[slot]
		if b == nil then
			ring[slot] = { t }
		else
			b[#b + 1] = t
		end
		a.rsize = rsize + 1
		return
	end
	local over = a.over
	if over == nil then
		over = {}
		a.over = over
	end
	local b = over[key]
	if b == nil then
		over[key] = { t }
	else
		b[#b + 1] = t
	end
	if a.osize == 0 or key < a.omin then
		a.omin = key
	end
	a.osize += 1
end

--- True when `t` is in attack `a`'s border.
local function in_border(self: any, a: any, t: number): boolean
	if readi32(self.fmark, t * 4) == a.aid then
		return true
	end
	local xb = a.xb
	return xb ~= nil and xb[t] == true
end
SimAttacks.in_border = in_border

--- Adds `t` to attack `a`'s border.
local function _border_add(self: any, a: any, t: number)
	local fmark = self.fmark
	local m = readi32(fmark, t * 4)
	local aid = a.aid
	if m == aid then
		return
	end
	if m == 0 or self.attack_by_id[m] == nil then
		writei32(fmark, t * 4, aid)
		a.front += 1
		return
	end
	local xb = a.xb
	if xb == nil then
		xb = {}
		a.xb = xb
	elseif xb[t] then
		return
	end
	xb[t] = true
	a.front += 1
end

--- Drops `t` from attack `a`'s border.
local function _border_remove(self: any, a: any, t: number)
	local fmark = self.fmark
	if readi32(fmark, t * 4) == a.aid then
		writei32(fmark, t * 4, 0)
		a.front -= 1
		return
	end
	local xb = a.xb
	if xb ~= nil and xb[t] then
		xb[t] = nil
		a.front -= 1
	end
end

--- Queues target tile `t` (_add_neighbors' body for one neighbour): priority from the current
--- ownership of its neighbours, added to the attack's border.
local function _push(self: any, a: any, t: number)
	local owner = self.owner
	local at = a.attacker
	local W = self.W
	local x = t % W
	local n = 0
	if x > 0 and readi32(owner, (t - 1) * 4) == at then
		n += 1
	end
	if x < W - 1 and readi32(owner, (t + 1) * 4) == at then
		n += 1
	end
	if t >= W and readi32(owner, (t - W) * 4) == at then
		n += 1
	end
	if t < self.N - W and readi32(owner, (t + W) * 4) == at then
		n += 1
	end
	local key = 4 * self.tick
		+ (PRIORITY_BASE + self.rng:randi() % PRIORITY_RAND) * PRIORITY_F4[readu8(self.terr, t) * 5 + n]
	local rsize = a.rsize
	if rsize > 0 and key >= a.qmin and key <= a.qhi then
		-- (hot path of _enqueue: inside the ring's current key range)
		local ring = a.ring
		local slot = bit32.band(key, RING_MASK)
		local b = ring[slot]
		if b == nil then
			ring[slot] = { t }
		else
			b[#b + 1] = t
		end
		a.rsize = rsize + 1
	else
		_enqueue(a, t, key)
	end
	local fmark = self.fmark
	local m = readi32(fmark, t * 4)
	if m == 0 then
		writei32(fmark, t * 4, a.aid)
		a.front += 1
	elseif m ~= a.aid then
		_border_add(self, a, t)
	end
end

--- Dequeues the lowest-priority tile (without touching the border); -1 if empty.
local function _dequeue(a: any): number
	local rsize = a.rsize
	local osize = a.osize
	if rsize + osize <= 0 then
		return -1
	end
	local k = a.qmin
	local b
	if rsize > 0 then
		local ring = a.ring
		b = ring[bit32.band(k, RING_MASK)]
		while b == nil or #b == 0 do
			k += 1
			b = ring[bit32.band(k, RING_MASK)]
		end
		a.qmin = k
	end
	if osize > 0 and (rsize == 0 or a.omin < k) then
		local over = a.over :: { [number]: { number } }
		local ok = a.omin
		local ob = over[ok]
		while ob == nil do
			ok += 1
			ob = over[ok]
		end
		local n = #ob
		local t = ob[n]
		if n == 1 then
			over[ok] = nil
		else
			ob[n] = nil
		end
		a.omin = ok
		a.osize = osize - 1
		return t
	end
	local n = #b
	local t = b[n]
	b[n] = nil
	a.rsize = rsize - 1
	return t
end

--- Dequeues the lowest-priority tile and drops it from the border; -1 if empty.
local function _pop(self: any, a: any): number
	local t = _dequeue(a)
	if t >= 0 then
		local fmark = self.fmark
		if readi32(fmark, t * 4) == a.aid then
			writei32(fmark, t * 4, 0)
			a.front -= 1
		elseif a.xb ~= nil then
			_border_remove(self, a, t)
		end
	end
	return t
end

--- Queues every target-owned land 4-neighbour of `t`.
local function _add_neighbors(self: any, a: any, t: number)
	local owner = self.owner
	local land = self.land
	local tg = a.target
	local W = self.W
	local x = t % W
	local n
	if t >= W then
		n = t - W
		if readi32(owner, n * 4) == tg and readu8(land, n) == 1 then
			_push(self, a, n)
		end
	end
	if t < self.N - W then
		n = t + W
		if readi32(owner, n * 4) == tg and readu8(land, n) == 1 then
			_push(self, a, n)
		end
	end
	if x > 0 then
		n = t - 1
		if readi32(owner, n * 4) == tg and readu8(land, n) == 1 then
			_push(self, a, n)
		end
	end
	if x < W - 1 then
		n = t + 1
		if readi32(owner, n * 4) == tg and readu8(land, n) == 1 then
			_push(self, a, n)
		end
	end
end

--- Empties the queue and the border set.
local function _clear_queue(self: any, a: any)
	local fmark = self.fmark
	local aid = a.aid
	for _, b in a.ring do
		for i = #b, 1, -1 do
			local t = b[i]
			if readi32(fmark, t * 4) == aid then
				writei32(fmark, t * 4, 0)
			end
			b[i] = nil
		end
	end
	if a.over ~= nil then
		for _, b in a.over do
			for _, t in b do
				if readi32(fmark, t * 4) == aid then
					writei32(fmark, t * 4, 0)
				end
			end
		end
		a.over = nil
	end
	a.rsize = 0
	a.osize = 0
	a.xb = nil
	a.front = 0
	a.head = -1
	a.chew = 0.0
end

--- Clears the queue and the border, then _add_neighbors of every
--- border tile of the attacker. Returns the border size.
local function _seed_from_border(self: any, a: any): number
	_clear_queue(self, a)
	local bnext = self.bnext
	local b = self.bhead[a.attacker]
	while b ~= -1 do
		_add_neighbors(self, a, b)
		b = readi32(bnext, b * 4)
	end
	return a.front
end

--- Transfers tile `t` to `nw`. Attack queues are fed only by the attack that
--- conquers (_add_neighbors). `via` is kept for callers (boat landings pass nil).
local function conquer(self: any, t: number, nw: number, _via: any?)
	set_owner(self, t, nw)
end

SimAttacks._push = _push
SimAttacks._pop = _pop
SimAttacks._dequeue = _dequeue
SimAttacks._enqueue = _enqueue
SimAttacks._add_neighbors = _add_neighbors
SimAttacks._seed_from_border = _seed_from_border
SimAttacks.conquer = conquer

function SimAttacks.install(C: any)
	--- Initialises every SimAttacks member (GDScript declarations + _init_attacks).
	function C._init_attacks(self: any)
		self.attacks = {} :: { any }
		self.attack_by_id = {} :: { [number]: any }
		--- attacker * 1024 + target → aid (0 = none), i32 buffer
		self.pair_attack = buffer.create(MAXO * MAXO * 4)
		Coop.check()
		--- tile -> aid of the attack whose border holds it (0 = none; a dead attack's id is stale),
		--- i32 buffer
		self.fmark = buffer.create(self.N * 4)
		--- Attacks with troops of a new order waiting to be absorbed (1-based).
		self._merges = {} :: { any }
		self.next_aid = 1
		--- attacker*1024+target → tick of the last "is attacking you" alert (throttle).
		self._alert_tick = {} :: { [number]: number }
	end

	function C.attack_between(self: any, attacker: number, target: number): any?
		local aid = readi32(self.pair_attack, (attacker * 1024 + target) * 4)
		if aid ~= 0 then
			return self.attack_by_id[aid]
		end
		return nil
	end

	--- Troops committed in all of `id`'s attacks.
	function C.troops_in_attacks(self: any, id: number): number
		local s = 0.0
		for _, a in self.attacks do
			if not a.dead and a.attacker == id then
				s += a.troops + a.pend
			end
		end
		return s
	end

	function C.count_attacks_by(self: any, id: number, players_only: boolean): number
		local n = 0
		for _, a in self.attacks do
			if not a.dead and a.attacker == id and (not players_only or a.target ~= 0) then
				n += 1
			end
		end
		return n
	end

	-- =========================================================================================
	-- Frontier queue
	-- =========================================================================================

	C._push = _push
	C._pop = _pop
	C._add_neighbors = _add_neighbors
	C._seed_from_border = _seed_from_border

	-- =========================================================================================
	-- Starting / ending
	-- =========================================================================================

	--- Commits `troops` (already removed from the attacker's home troops) against `target`.
	--- `beachhead` >= 0 seeds from that tile only (boat landings). Returns the attack or nil; on
	--- nil the troops have been returned (or spent cancelling an opposing attack).
	function C.start_attack(self: any, attacker: number, target: number, troops: number, beachhead: number?): any?
		local bh = beachhead or -1
		local o_troops = self.o_troops
		if troops < 1.0 then
			o_troops[attacker] += troops
			return nil
		end
		local counter = target ~= 0 and self:attack_between(target, attacker) ~= nil
		-- A new order: an opposing attack between the same pair cancels troops first (the
		-- smaller side is deleted, its troops lost).
		if target ~= 0 then
			local opp = self:attack_between(target, attacker)
			if opp ~= nil then
				local cancel = math.min(troops, opp.troops)
				troops -= cancel
				opp.troops -= cancel
				if opp.troops < 1.0 then
					self:end_attack(opp, false)
				end
				if troops < 1.0 then
					return nil
				end
			end
		end
		local a = self:attack_between(attacker, target)
		if a ~= nil then
			if bh >= 0 then
				-- A boat landing joins the running attack with its beachhead's neighbours (one attack
				-- per attacker and target).
				a.troops += troops
				a.retreat_at = 0
				a.frozen_from = 0
				_add_neighbors(self, a, bh)
				self:_send_attack(a)
			elseif a.started_tick == self.tick then
				-- Two orders in one tick: both attacks start at the end of it, the second absorbs
				-- the first.
				a.troops += troops
				_seed_from_border(self, a)
				self:_send_attack(a)
			else
				-- The new attack absorbs the running one at the end of this tick (after it has
				-- advanced once more with its own troops): see _apply_merges.
				if a.pend == 0 then
					table.insert(self._merges, a)
				end
				a.pend += troops
			end
			return a
		end
		a = new_attack()
		a.aid = self.next_aid
		self.next_aid += 1
		a.attacker = attacker
		a.target = target
		a.troops = troops
		a.started_tick = self.tick
		a.counter = counter
		if bh >= 0 then
			_add_neighbors(self, a, bh)
			a.last_tile = bh
		else
			_seed_from_border(self, a)
		end
		if a.front <= 0 then
			-- Nothing to attack: the troops are refunded at once (rather than sent and retreated)
			-- so the caller can tell the player why.
			o_troops[attacker] += troops
			return nil
		end
		local attacks = self.attacks
		attacks[#attacks + 1] = a
		self.attack_by_id[a.aid] = a
		writei32(self.pair_attack, (attacker * 1024 + target) * 4, a.aid)
		if a.last_tile < 0 then
			a.last_tile = self:_any_queued(a)
		end
		self:_send_attack(a)
		if target ~= 0 then
			if self:shielded(attacker) and self.o_kind[target] ~= Defs.KIND_TRIBE then
				-- (attacking a person or a nation ends one's own spawn shield: none attacks from behind it)
				self.o_shield_until[attacker] = 0
				self:msg(
					attacker,
					Defs.MSG_INFO,
					string.format("You attacked %s, so your spawn shield is down", self.o_name[target])
				)
			end
			self:add_grudge(target, attacker, Rules.HOSTILE_TICKS)
			self.o_attacked_tick[target] = self.tick
			if self:is_human(target) then
				local mk = attacker * 1024 + target
				if self.tick - (self._alert_tick[mk] or -1000) > 150 then
					self._alert_tick[mk] = self.tick
					if counter then
						self:msg(target, Defs.MSG_ALERT, self.o_name[attacker] .. " is counter-attacking you!")
					else
						self:msg(target, Defs.MSG_ALERT, self.o_name[attacker] .. " is attacking you!")
					end
				end
			end
			self:_on_attack_started(a)
		end
		return a
	end

	--- Some queued tile of `a` (the anchor shown before the first conquest), or -1.
	function C._any_queued(_self: any, a: any): number
		for _, b in a.ring do
			if #b > 0 then
				return b[1]
			end
		end
		return -1
	end

	--- Hook for the AI / subclasses.
	function C._on_attack_started(_self: any, _a: any) end

	function C._send_attack(self: any, a: any)
		local tr = Defs.trunc(a.troops)
		a.sent_troops = tr
		self:ev({ Ev.ATTACK, a.aid, a.attacker, a.target, tr, a.last_tile, a.retreat_at > 0 })
	end

	--- Ends an attack. Surviving troops return home multiplied by `keep` (default 1) when `give_back`
	--- (floored to whole troops).
	function C.end_attack(self: any, a: any, give_back: boolean, keep: number?)
		if a.dead then
			return
		end
		a.dead = true
		local k = keep or 1.0
		if give_back and self.o_alive[a.attacker] == 1 then
			local back = math.floor(math.max(a.troops, 0.0) * k)
			self.o_troops[a.attacker] += back
			self.dbg_flow[a.attacker * 5 + 4] += back
		end
		a.troops = 0.0
		local pk = (a.attacker * 1024 + a.target) * 4
		if readi32(self.pair_attack, pk) == a.aid then
			writei32(self.pair_attack, pk, 0)
		end
		self.attack_by_id[a.aid] = nil
		self:ev({ Ev.ATTACK_END, a.aid })
	end

	--- Orders attack `aid` of `id` home. The attack advances on this tick and the
	--- next (the order takes effect when the retreat first ticks), is frozen after that,
	--- and RETREAT_DELAY_TICKS after the order its troops come home — 25 % fewer when the target is
	--- a player (malusForRetreat). A second order changes nothing.
	function C.retreat(self: any, id: number, aid: number): boolean
		local a = self.attack_by_id[aid]
		if a == nil or a.attacker ~= id then
			return false
		end
		if a.retreat_at == 0 then
			a.frozen_from = self.tick + 2
			a.retreat_at = self.tick + Rules.RETREAT_DELAY_TICKS + 1
			self:_send_attack(a)
		end
		return true
	end

	--- Ends every attack by or against `id` (elimination).
	function C.end_attacks_of(self: any, id: number)
		for _, a in self.attacks do
			if a.dead then
				continue
			end
			if a.attacker == id then
				self:end_attack(a, false)
			elseif a.target == id then
				self:end_attack(a, true)
			end
		end
	end

	function C._on_alliance_formed(self: any, a: number, b: number)
		local x = self:attack_between(a, b)
		if x ~= nil then
			self:end_attack(x, true)
		end
		x = self:attack_between(b, a)
		if x ~= nil then
			self:end_attack(x, true)
		end
	end

	-- =========================================================================================
	-- Per-tick processing
	-- =========================================================================================

	function C.attacks_tick(self: any)
		local attacks = self.attacks
		local count = #attacks
		local tick = self.tick
		for idx = 1, count do
			local a = attacks[idx]
			-- An attack ordered this tick starts next tick (new attacks are initialised at
			-- the end of the tick).
			if a.dead or a.started_tick == tick then
				continue
			end
			self:_process_attack(a)
			-- (a local match's step runs as a Coop job spread over frames: Session._local_process)
			Coop.check()
		end
		if #self._merges > 0 then
			self:_apply_merges()
		end
		-- Compact dead attacks.
		local w = 0
		local n = #attacks
		for idx = 1, n do
			local a2 = attacks[idx]
			if not a2.dead then
				w += 1
				attacks[w] = a2
			end
		end
		for idx = n, w + 1, -1 do
			attacks[idx] = nil
		end
	end

	--- A new order on a target already under attack, at the end of the tick:
	--- the running attack is absorbed (its troops join; a retreat order is dropped) and the queue is
	--- rebuilt from the whole border (_seed_from_border). If the running attack ended this tick the
	--- order starts a fresh attack (conquering from the next tick).
	function C._apply_merges(self: any)
		local list = self._merges
		self._merges = {}
		for _, a in list do
			local troops = a.pend
			a.pend = 0.0
			if troops <= 0.0 or self.o_alive[a.attacker] == 0 then
				continue
			end
			if a.target ~= 0 and (self.o_alive[a.target] == 0 or self:allied(a.attacker, a.target)) then
				-- The order's init finds no valid target: nothing leaves home.
				self.o_troops[a.attacker] += troops
				continue
			end
			if a.dead then
				self:start_attack(a.attacker, a.target, troops, -1)
				continue
			end
			a.troops += troops
			a.retreat_at = 0
			a.frozen_from = 0
			_seed_from_border(self, a)
			self:_send_attack(a)
		end
	end

	function C._process_attack(self: any, a: any)
		local at = a.attacker
		local tg = a.target
		local o_alive = self.o_alive
		if o_alive[at] == 0 or (tg ~= 0 and o_alive[tg] == 0) then
			self:end_attack(a, true)
			return
		end
		local tick = self.tick
		local neutral = tg == 0
		if a.retreat_at > 0 then
			if tick >= a.retreat_at then
				self:end_attack(a, true, if neutral then 1.0 else Rules.RETREAT_KEEP)
				return
			end
			if tick >= a.frozen_from then
				return
			end
		end
		if not neutral and self:allied(at, tg) then
			-- An alliance made after the attack started: retreat() without malus.
			self:end_attack(a, true)
			return
		end
		local o_tiles = self.o_tiles
		local o_troops = self.o_troops
		local o_kind = self.o_kind
		local R = self.R
		local K_AREA = R.K_AREA
		-- attackLogic inputs that only change between ticks. borderSize (+ random 0..4) is fixed
		-- for the tick.
		local border_of = a.front * R.K_LIN + self.rng:randi() % Rules.BORDER_JITTER
		local fo_mod = Rules.fallout_modifier(self.fallout_count / math.max(self.map.contestable_count, 1))
		local nl = Rules.neutral_loss_per_mag(o_kind[at])
		local bonus_l = 1.0
		local bonus_s = 1.0
		local trait_l = 1.0
		local trait_s = 1.0
		local mag_k = 1.0
		if not neutral then
			local att_of = o_tiles[at] * K_AREA
			local def_of = math.max(o_tiles[tg] * K_AREA, 1.0)
			local ldb = Rules.large_territory_bonus(def_of, Rules.LARGE_DEFENDER_DEPTH)
			bonus_l = Rules.ATTACKER_LOSS_BASE * Rules.large_territory_bonus(att_of, Rules.LARGE_ATTACKER_DEPTH) * ldb
			bonus_s = Rules.large_territory_bonus(att_of, Rules.LARGE_ATTACKER_SPEED_DEPTH)
				* ldb
				/ (Rules.SPEED_COST_DIVISOR * math.max(border_of, 1.0))
			if self.o_traitor_until[tg] > tick then
				trait_l = Rules.TRAITOR_DEFENSE_DEBUFF
				trait_s = Rules.TRAITOR_SPEED_DEBUFF
			end
			if o_kind[tg] == Defs.KIND_TRIBE and o_kind[at] ~= Defs.KIND_TRIBE then
				mag_k = Rules.BOT_DEFENDER_LOSS_MULT
			end
		end
		local owner = self.owner
		local land = self.land
		local flags = self.flags
		local terr = self.terr
		local def_cover = self.def_cover
		local ATTACK_MAG = Rules.ATTACK_MAG
		local ATTACK_TILE_COST = Rules.ATTACK_TILE_COST
		local border1 = math.max(border_of, 1.0)
		local dbg_flow = self.dbg_flow
		local cap = R.MAX_TILES_PER_TICK
		local budget = 1.0
		local taken = 0
		while budget > 0.0 do
			if a.troops < 1.0 then
				-- An attack that runs out of troops simply ends.
				a.troops = 0.0
				self:end_attack(a, false)
				return
			end
			local t = a.head
			if t >= 0 and (readi32(owner, t * 4) ~= tg or not touches(self, t, at)) then
				a.head = -1
				a.chew = 0.0
				t = -1
			end
			if t < 0 then
				if taken >= cap then
					break
				end
				t = _pop(self, a)
				if t < 0 then
					-- The queue is empty: the attack ends, troops home.
					self:end_attack(a, true)
					return
				end
				if readi32(owner, t * 4) ~= tg or readu8(land, t) == 0 or not touches(self, t, at) then
					continue
				end
				-- _add_neighbors(tile) runs before the tile changes hands.
				_add_neighbors(self, a, t)
				a.head = t
				a.chew = 0.0
			end
			-- Per full-size tile of this tile: attacker troop loss, tick fraction, defender troop loss.
			local tt = readu8(terr, t)
			local mag = ATTACK_MAG[tt]
			local tc = ATTACK_TILE_COST[tt]
			if not neutral and readu8(def_cover, t) > 0 and self:_defense_post_covers(t, tg) then
				mag *= Rules.DEFENSE_POST_MAG
				tc *= Rules.DEFENSE_POST_COST
			end
			if bit32.band(readu8(flags, t), F_FALLOUT) ~= 0 then
				mag *= fo_mod
				tc *= fo_mod
			end
			local loss: number
			local tf: number
			local dloss = 0.0
			if neutral then
				loss = mag * nl
				local v = Rules.TERRA_NULLIUS_COST_SCALE * tc / a.troops
				if v < Rules.TERRA_NULLIUS_MIN_COST then
					v = Rules.TERRA_NULLIUS_MIN_COST
				elseif v > Rules.TERRA_NULLIUS_MAX_COST then
					v = Rules.TERRA_NULLIUS_MAX_COST
				end
				tf = v / (border1 * 2.0)
			else
				local dtroops = o_troops[tg]
				dloss = dtroops / math.max(o_tiles[tg] * K_AREA, 1.0)
				local ratio = dtroops / a.troops
				local cl = if ratio < 0.6 then 0.6 elseif ratio > 2.0 then 2.0 else ratio
				loss = mag * mag_k * trait_l * cl * (bonus_l + Rules.ATTACKER_LOSS_PER_DENSITY * dloss)
				local c1 = if ratio < 0.82 then 0.82 elseif ratio > 7.5 then 7.5 else ratio
				local r20 = ratio / 20.0
				local c2 = if r20 < 1.0 then 1.0 elseif r20 > 50.0 then 50.0 else r20
				tf = c1 * c2 * tc * bonus_s * trait_s
			end
			if tf < 1e-6 then
				tf = 1e-6
			end
			-- The defender's per-tile loss is floored (whole troops).
			local dfloor = math.floor(dloss)
			local need = K_AREA - a.chew
			-- Full-size tiles this tick can still take: the loop runs while budget > 0 (at least one), and
			-- while troops last (the tile that drops them below 1 still falls).
			local can = math.ceil(budget / tf)
			if loss > 0.0 then
				can = math.min(can, math.ceil(a.troops / loss))
			end
			if can >= need then
				budget -= need * tf
				a.troops -= need * loss
				if not neutral then
					local dl = math.min(need * dfloor, math.max(o_troops[tg], 0.0))
					dbg_flow[tg * 5 + 2] += dl
					o_troops[tg] -= dl
				end
				a.chew = 0.0
				a.head = -1
				conquer(self, t, at, a)
				a.last_tile = t
				taken += 1
				if
					not neutral
					and o_tiles[tg] * K_AREA < Rules.ANNEX_BELOW_FULL_TILES
					and (o_kind[tg] ~= Defs.KIND_HUMAN or a.troops > o_troops[tg])
				then
					-- (a person's small nation only once the attack outnumbers its army at home)
					self:_annex(tg, at)
					self:end_attack(a, true)
					return
				end
			else
				budget -= can * tf
				a.troops -= can * loss
				if not neutral then
					local dl2 = math.min(can * dfloor, math.max(o_troops[tg], 0.0))
					dbg_flow[tg * 5 + 2] += dl2
					o_troops[tg] -= dl2
				end
				a.chew += can
			end
		end
		if (tick + a.aid) % Rules.ATTACK_UPDATE_TICKS == 0 and Defs.trunc(a.troops) ~= a.sent_troops then
			self:_send_attack(a)
			if not neutral then
				self:add_grudge(tg, at, Rules.HOSTILE_TICKS)
				self.o_attacked_tick[tg] = tick
			end
		end
	end

	--- A dead defender: a player under ANNEX_BELOW_FULL_TILES is conquered outright. Its
	--- tiles touching the attacker go to the attacker, others to a bordering non-allied player, in
	--- repeated passes; unreachable pockets stay (and are mopped up later). Gold goes to the attacker.
	function C._annex(self: any, victim: number, by: number)
		self:_conquest_gold(victim, by)
		self.o_killer[victim] = by
		local owner = self.owner
		local tiles = self:owned_tiles(victim)
		local seen = 0
		for _ = 1, 100 do
			local progressed = false
			local rest = {}
			for _, t in tiles do
				seen += 1
				if seen % 1024 == 0 then
					Coop.check() -- (a big nation's fall: tens of thousands of tiles)
				end
				if readi32(owner, t * 4) ~= victim then
					continue
				end
				if touches(self, t, by) then
					conquer(self, t, by, nil)
					progressed = true
					continue
				end
				local taker = self:_annex_neighbour(t, victim)
				if taker > 0 then
					conquer(self, t, taker, nil)
					progressed = true
				else
					rest[#rest + 1] = t
				end
			end
			tiles = rest
			if not progressed or #tiles == 0 then
				break
			end
		end
		if self.o_tiles[victim] > 0 and self:is_human(victim) then
			self:msg(victim, Defs.MSG_BAD, self.o_name[by] .. " has conquered your nation")
		end
	end

	function C._annex_neighbour(self: any, t: number, victim: number): number
		local owner = self.owner
		local W = self.W
		local N = self.N
		local x = t % W
		for k = 1, 4 do
			local n
			if k == 1 then
				if x == 0 then
					continue
				end
				n = t - 1
			elseif k == 2 then
				if x == W - 1 then
					continue
				end
				n = t + 1
			elseif k == 3 then
				if t < W then
					continue
				end
				n = t - W
			else
				if t >= N - W then
					continue
				end
				n = t + W
			end
			local o = readi32(owner, n * 4)
			if o > 0 and o ~= victim and not self:allied(o, victim) then
				return o
			end
		end
		return 0
	end

	--- Every tile of `id` (flood from its border list; tiny owners only — cost ~ tiles owned).
	function C.owned_tiles(self: any, id: number): { number }
		local owner = self.owner
		local bnext = self.bnext
		local out = {}
		local seen: { [number]: boolean } = {}
		local b = self.bhead[id]
		while b ~= -1 do
			if not seen[b] then
				seen[b] = true
				out[#out + 1] = b
			end
			b = readi32(bnext, b * 4)
		end
		local i = 1
		local W = self.W
		local N = self.N
		while i <= #out do
			local t = out[i]
			i += 1
			local x = t % W
			for k = 1, 4 do
				local n
				if k == 1 then
					n = if x > 0 then t - 1 else -1
				elseif k == 2 then
					n = if x < W - 1 then t + 1 else -1
				elseif k == 3 then
					n = if t >= W then t - W else -1
				else
					n = if t < N - W then t + W else -1
				end
				if n >= 0 and readi32(owner, n * 4) == id and not seen[n] then
					seen[n] = true
					out[#out + 1] = n
				end
			end
		end
		return out
	end

	C.conquer = conquer

	--- Overridden by SimStructures: true when a defense post of `id` covers tile `t`.
	function C._defense_post_covers(_self: any, _t: number, _id: number): boolean
		return false
	end

	-- =========================================================================================
	-- Snapshot helpers
	-- =========================================================================================

	--- {aid, attacker, target, troops, anchor tile, retreating} per live attack.
	function C.attack_rows(self: any): { { any } }
		local out = {}
		for _, a in self.attacks do
			if not a.dead then
				out[#out + 1] = { a.aid, a.attacker, a.target, Defs.trunc(a.troops), a.last_tile, a.retreat_at > 0 }
			end
		end
		return out
	end
end

return SimAttacks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">SimColors</string>
            <string name="Source"><![CDATA[-- Port of scripts/core/sim_colors.gd: owner colour assignment in OKLab (perceptual) space: every
-- owner should read as distinct from the owners around it (target ΔE ≥ MIN_DE). Used at spawn
-- time; colours never change while a human holds land.
--
-- Colours are RGBA8 ints (0xRRGGBBAA). OKLab values are tables {x = L, y = a, z = b} (GDScript
-- Vector3); `refs` are 1-based arrays of them.
--
-- float32: Godot's Vector3 / Vector2 / Color are float32 (real_t = float), so OKLab triples,
-- distances (distance_to / length) and the shifted candidates are rounded to float32 exactly where
-- the original rounds them (the scalar math in between is GDScript double) — the port picks and
-- re-tints to the very same RGBA values (verified in lockstep with the original, tools/parity).
local Defs = require("./Defs")

local f32 = Defs.f32b

--- Vector2(x, y).length() in float32.
local function len2_f32(x: number, y: number): number
	return f32(math.sqrt(f32(f32(x * x) + f32(y * y))))
end

local SimColors = {}

export type Lab = { x: number, y: number, z: number }

--- Target minimum OKLab distance between neighbouring owners.
SimColors.MIN_DE = 0.12
local MIN_DE = 0.12

local function _lin(v: number): number
	if v <= 0.04045 then
		return v / 12.92
	end
	return ((v + 0.055) / 1.055) ^ 2.4
end

local function _gamma(v: number): number
	if v < 0 then
		v = 0
	elseif v > 1 then
		v = 1
	end
	if v <= 0.0031308 then
		return v * 12.92
	end
	return 1.055 * v ^ (1.0 / 2.4) - 0.055
end

local function cbrt(v: number): number
	-- Godot pow(x, 1/3) (NaN for negatives; inputs here are never negative)
	return v ^ (1.0 / 3.0)
end

--- sRGB colour (RGBA8 int, as on the wire) → OKLab {x = L, y = a, z = b}.
function SimColors.oklab(rgba: number): Lab
	local cr, cg, cb = Defs.rgba_floats(rgba)
	local r = _lin(Defs.f32(cr))
	local g = _lin(Defs.f32(cg))
	local b = _lin(Defs.f32(cb))
	local l = cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
	local m = cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
	local s = cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
	return {
		x = f32(0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s),
		y = f32(1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s),
		z = f32(0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s),
	}
end

--- OKLab → sRGB RGBA8 int (out-of-gamut values are clipped).
function SimColors.to_rgba(lab: Lab): number
	local l_ = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z
	local m_ = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z
	local s_ = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z
	local l = l_ * l_ * l_
	local m = m_ * m_ * m_
	local s = s_ * s_ * s_
	local r = 4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s
	local g = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s
	local b = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
	-- Color(r, g, b) stores float32 components before to_rgba32().
	return Defs.floats_rgba(Defs.f32(_gamma(r)), Defs.f32(_gamma(g)), Defs.f32(_gamma(b)), 1.0)
end

--- OKLab distance (Vector3.distance_to, float32: component differences, squares, sums, sqrtf).
function SimColors.dist(a: Lab, b: Lab): number
	local dx, dy, dz = f32(b.x - a.x), f32(b.y - a.y), f32(b.z - a.z)
	return f32(math.sqrt(f32(f32(f32(dx * dx) + f32(dy * dy)) + f32(dz * dz))))
end
local dist = SimColors.dist

--- Smallest OKLab distance from `lab` to any of `refs` (10 when there are none).
function SimColors.min_de(lab: Lab, refs: { Lab }): number
	local d = 10.0
	for _, r in refs do
		local e = dist(lab, r)
		if e < d then
			d = e
		end
	end
	return d
end
local min_de = SimColors.min_de

--- Curated tribe palette: 32 saturated, mid-bright colours (sat 0.55–0.8, value 0.68–0.9). 1-based.
function SimColors.tribe_palette(): { number }
	local out = {}
	for i = 0, 15 do
		local h = i / 16.0
		table.insert(out, Defs.hsv_rgba(h, 0.62, 0.9))
		table.insert(out, Defs.hsv_rgba(h + 1.0 / 32.0, 0.8, 0.68))
	end
	return out
end

local _human_palette: { number }? = nil

--- Human candidates in the nations' style: vivid but not neon (OKLab L 0.64–0.76, chroma
--- 0.11–0.155, every 15° of hue); out-of-gamut variants are dropped, so no pure RGB primaries.
function SimColors.human_palette(): { number }
	if _human_palette ~= nil then
		return _human_palette
	end
	local out = {}
	for i = 0, 23 do
		local h = 2 * math.pi * i / 24.0
		for _, l in { 0.64, 0.70, 0.76 } do
			for _, c in { 0.11, 0.155 } do
				-- Yellow-green hues turn olive / muddy at low lightness.
				local deg = math.deg(h)
				if deg > 75.0 and deg < 140.0 and l < 0.74 then
					continue
				end
				local lab = { x = f32(l), y = f32(math.cos(h) * c), z = f32(math.sin(h) * c) }
				local rgba = SimColors.to_rgba(lab)
				if dist(SimColors.oklab(rgba), lab) < 0.01 then
					table.insert(out, rgba)
				end
			end
		end
	end
	_human_palette = out
	return out
end

--- Candidate with the largest minimum ΔE to `refs`. With `rng`, picks randomly among the
--- candidates that already reach MIN_DE (so neighbours don't all get the same "best" colour).
function SimColors.pick(cands: { number }, refs: { Lab }, rng: any?): number
	local best = cands[1]
	local best_d = -1.0
	local good = {}
	for _, c in cands do
		local d = min_de(SimColors.oklab(c), refs)
		if d >= MIN_DE then
			table.insert(good, c)
		end
		if d > best_d + 1e-4 then
			best_d = d
			best = c
		end
	end
	if rng ~= nil and #good > 0 then
		return good[rng:randi() % #good + 1]
	end
	return best
end

--- Authored colours are only touched when a neighbour is this close (clearly confusable).
SimColors.NUDGE_BELOW = 0.08

--- Keeps an authored colour unless it is closer than NUDGE_BELOW to `refs`; then applies the
--- smallest lightness / hue shift (in OKLab) that reaches MIN_DE (or the best one found).
function SimColors.nudge(rgba: number, refs: { Lab }): number
	if min_de(SimColors.oklab(rgba), refs) >= SimColors.NUDGE_BELOW then
		return rgba
	end
	return SimColors.shift(rgba, refs)
end

local DLS = { 0.0, 0.05, -0.05, 0.1, -0.1, 0.15, -0.15 }
local DHS = { 0.0, 0.26, -0.26, 0.52, -0.52, 0.79, -0.79, 1.05, -1.05 }

--- The smallest OKLab lightness / hue shift of `rgba` that reaches MIN_DE from every ref (or the
--- most distinct variant found when none does).
function SimColors.shift(rgba: number, refs: { Lab }): number
	local lab = SimColors.oklab(rgba)
	local chroma = len2_f32(lab.y, lab.z)
	local hue = math.atan2(lab.z, lab.y)
	local best = rgba
	local best_cost = 1e9
	local best_d = min_de(lab, refs)
	for _, dl in DLS do
		for _, dh in DHS do
			local h = hue + dh
			local lx = lab.x + dl
			if lx < 0.35 then
				lx = 0.35
			elseif lx > 0.92 then
				lx = 0.92
			end
			local rgb = SimColors.to_rgba({ x = f32(lx), y = f32(math.cos(h) * chroma), z = f32(math.sin(h) * chroma) })
			local d = min_de(SimColors.oklab(rgb), refs)
			local cost = math.abs(dl) * 2.0 + math.abs(dh) * math.max(chroma, 0.05)
			if d >= MIN_DE and (best_d < MIN_DE or cost < best_cost) then
				best = rgb
				best_cost = cost
				best_d = d
			elseif best_d < MIN_DE and d > best_d then
				best = rgb
				best_d = d
			end
		end
	end
	return best
end

-- =============================================================================================
-- Assignment helpers (operate on the Sim's owner arrays)
-- =============================================================================================

--- OKLab colours of living, spawned owners (of `kind`, or any when -1/nil) whose start lies within
--- `radius` tiles of `id`'s start.
function SimColors.refs_near(st: any, id: number, radius: number, kind: number?): { Lab }
	local k = kind or -1
	local refs = {}
	local t = st.o_spawn_tile[id]
	if t < 0 then
		return refs
	end
	local r2 = radius * radius
	local dist2 = st.dist2
	for o = 1, st.owner_total do
		if k >= 0 and st.o_kind[o] ~= k then
			continue
		end
		if o ~= id and st.o_alive[o] == 1 and st.o_spawn_tile[o] >= 0 and dist2(st.o_spawn_tile[o], t) <= r2 then
			table.insert(refs, SimColors.oklab(st.o_color[o]))
		end
	end
	return refs
end

--- Colour for human `id` starting at `t`: the nation-style candidate most distinct from the owners
--- it will border (territory or start within NEAR_HUMAN tiles of the original 1024-wide grid —
--- scaled by the map's LEGACY_LIN — full weight), from owners up to `radius` tiles away (with 0.04
--- slack) and from all other present humans.
SimColors.NEAR_HUMAN = 45

function SimColors.for_human(st: any, id: number, t: number, radius: number): number
	local near_refs = {}
	local far_refs = {}
	local r2 = radius * radius
	local near = SimColors.NEAR_HUMAN * st.R.LEGACY_LIN
	local n2 = near * near
	local dist2 = st.dist2
	local W, H = st.W, st.H
	for o = 1, st.owner_total do
		if o == id or st.o_alive[o] == 0 then
			continue
		end
		local d2 = 2 ^ 30
		if st.o_kind[o] == Defs.KIND_HUMAN and st.o_left[o] == 0 then
			d2 = 0
		elseif st.o_tiles[o] > 0 then
			local n = st.o_tiles[o]
			local cx = math.clamp(math.floor(st.o_cx[o] / n + 0.5), 0, W - 1)
			local cy = math.clamp(math.floor(st.o_cy[o] / n + 0.5), 0, H - 1)
			d2 = dist2(cy * W + cx, t)
			if st.o_spawn_tile[o] >= 0 then
				d2 = math.min(d2, dist2(st.o_spawn_tile[o], t))
			end
		end
		if d2 <= n2 then
			table.insert(near_refs, SimColors.oklab(st.o_color[o]))
		elseif d2 <= r2 then
			table.insert(far_refs, SimColors.oklab(st.o_color[o]))
		end
	end
	local best = 0
	local best_s = -1.0
	for _, c in SimColors.human_palette() do
		local lab = SimColors.oklab(c)
		local sc = math.min(min_de(lab, near_refs), min_de(lab, far_refs) + 0.04)
		-- Slight preference for brighter, livelier tints among equally distinct ones.
		sc += 0.08 * (lab.x - 0.64) + 0.1 * (len2_f32(lab.y, lab.z) - 0.11)
		if sc > best_s then
			best_s = sc
			best = c
		end
	end
	return best
end

return SimColors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">SimNav</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/sim_nav.gd: water pathfinding for boats, trade ships and warships.
--
-- The map's grid (flat, no wrap) is cut into 8 x 8 tile cells (edge cells may be smaller). Inside
-- each cell the water tiles are split into 4-connected regions; regions touching across a cell
-- edge (or diagonally through a one-tile strait) are linked in a small graph. A path query runs A*
-- on that graph, stitches the regions together with tiny in-region BFS walks through precomputed
-- portal tiles, then straightens the result with line-of-sight string pulling and rasterises it
-- back into a dense tile path (consecutive tiles are 4/8-neighbours). The graph is built once per
-- map (cached on the map) and shared read-only by every Sim on it; each Sim gets private scratch.
--
-- Luau: body = map.water_body (u16 buffer: readu16(body, t * 2)), region = i32 buffer per tile
-- (-1 on land); per-region data and the adjacency (CSR) are buffers (reg_* / adj_* below); paths
-- are 1-based arrays of tiles ({} = none).
local Defs = require("./Defs")
local Coop = require("../Net/Coop")

local CELL = 8
--- Weighted A* (slightly inadmissible): far fewer expansions; smoothing removes the kinks.
local HEURISTIC_W = 1.4
--- Region-pair key stride (region ids stay below 2^24).
local PAIR_K = 16777216

local readu16 = buffer.readu16
local readu8 = buffer.readu8
local writeu8 = buffer.writeu8
local readi32 = buffer.readi32
local writei32 = buffer.writei32
local readf32 = buffer.readf32
local writef32 = buffer.writef32
local readf64 = buffer.readf64
local writef64 = buffer.writef64
local f32b = Defs.f32b

local SimNav = {}
SimNav.__index = SimNav
SimNav.CELL = CELL
SimNav.HEURISTIC_W = HEURISTIC_W

local function clock_us(): number
	return os.clock() * 1e6
end

local function new_blank(): any
	return setmetatable({
		map = nil,
		W = 0,
		H = 0,
		N = 0,
		CW = 0,
		CH = 0,
		body = nil,
		region = nil,
		reg_count = 0,
		-- per region (0-based r): body (i32), representative tile (i32), centroid x / y (f32),
		-- full 8x8 water cell (u8)
		reg_body = nil,
		reg_tile = nil,
		reg_x = nil,
		reg_y = nil,
		reg_full = nil,
		-- CSR adjacency: edges of r are adj_off[r] .. adj_off[r + 1] - 1 (i32); per edge the other
		-- region (i32), cost (f32) and portal tiles on this / the other side (i32)
		adj_off = nil,
		adj_to = nil,
		adj_cost = nil,
		adj_pa = nil,
		adj_pb = nil,
		-- A* scratch (per instance): g (f64), came / seen / closed stamps (i32) per region
		_g = nil,
		_came = nil,
		_seen = nil,
		_closed = nil,
		_stamp = 0,
		_heap_n = {},
		_heap_f = {},
		_heap_size = 0,
		-- in-region BFS scratch (a region has at most 64 tiles)
		_t_seen = {},
		_t_par = {},
		_q = {},
		-- statistics for the bench
		searches = 0,
		expanded = 0,
		usec = 0,
		usec_astar = 0,
		usec_smooth = 0,
		usec_max = 0,
		fails = 0,
	}, SimNav)
end

function SimNav.new(): any
	return new_blank()
end

--- A SimNav for one Sim: the region graph is built once per map (cached on the map object) and
--- shared read-only, while the A*/BFS scratch is private.
function SimNav.shared(world: any): any
	local g = world._nav_graph
	if g == nil then
		g = new_blank()
		g:build(world)
		world._nav_graph = g
	end
	return g:_instance()
end

function SimNav._instance(self: any): any
	local n = new_blank()
	for _, k in
		{
			"map",
			"W",
			"H",
			"N",
			"CW",
			"CH",
			"body",
			"region",
			"reg_count",
			"reg_body",
			"reg_tile",
			"reg_x",
			"reg_y",
			"reg_full",
			"adj_off",
			"adj_to",
			"adj_cost",
			"adj_pa",
			"adj_pb",
		}
	do
		n[k] = self[k]
	end
	n:_alloc_scratch()
	return n
end

function SimNav._alloc_scratch(self: any)
	local rc = math.max(self.reg_count, 1)
	self._g = buffer.create(rc * 8)
	self._came = buffer.create(rc * 4)
	self._seen = buffer.create(rc * 4)
	self._closed = buffer.create(rc * 4)
	self._stamp = 0
	self._heap_n = {}
	self._heap_f = {}
end

local function _dist(ax: number, ay: number, bx: number, by: number): number
	local dx = ax - bx
	local dy = ay - by
	return math.sqrt(dx * dx + dy * dy)
end
SimNav._dist = _dist

function SimNav.build(self: any, world: any)
	self.map = world
	local W, H, N = world.W, world.H, world.N
	self.W = W
	self.H = H
	self.N = N
	local CW = (W + CELL - 1) // CELL
	local CH = (H + CELL - 1) // CELL
	self.CW = CW
	self.CH = CH
	local body = world.water_body
	self.body = body
	local region = buffer.create(N * 4)
	buffer.fill(region, 0, 255) -- -1 everywhere
	self.region = region
	local reg_count = 0
	-- growable per-region arrays (plain tables while building)
	local reg_body, reg_tile, reg_x, reg_y, reg_full = {}, {}, {}, {}, {}
	local stack = {}
	local members = {}
	-- 1. Regions: flood fill water inside each cell.
	for cy = 0, CH - 1 do
		for cx = 0, CW - 1 do
			if cx % 16 == 0 then
				Coop.check()
			end
			local x0 = cx * CELL
			local y0 = cy * CELL
			local x1 = math.min(x0 + CELL, W) - 1
			local y1 = math.min(y0 + CELL, H) - 1
			for yy = y0, y1 do
				for xx = x0, x1 do
					local t0 = yy * W + xx
					if readu16(body, t0 * 2) == 0 or readi32(region, t0 * 4) ~= -1 then
						continue
					end
					local r = reg_count
					reg_count += 1
					local b = readu16(body, t0 * 2)
					writei32(region, t0 * 4, r)
					table.clear(stack)
					table.clear(members)
					stack[1] = t0
					local fx = 0.0
					local fy = 0.0
					while #stack > 0 do
						local t = stack[#stack]
						stack[#stack] = nil
						members[#members + 1] = t
						local tx = t % W
						local ty = t // W
						fx += tx
						fy += ty
						if tx > x0 and readu16(body, (t - 1) * 2) == b and readi32(region, (t - 1) * 4) == -1 then
							writei32(region, (t - 1) * 4, r)
							stack[#stack + 1] = t - 1
						end
						if tx < x1 and readu16(body, (t + 1) * 2) == b and readi32(region, (t + 1) * 4) == -1 then
							writei32(region, (t + 1) * 4, r)
							stack[#stack + 1] = t + 1
						end
						if ty > y0 and readu16(body, (t - W) * 2) == b and readi32(region, (t - W) * 4) == -1 then
							writei32(region, (t - W) * 4, r)
							stack[#stack + 1] = t - W
						end
						if ty < y1 and readu16(body, (t + W) * 2) == b and readi32(region, (t + W) * 4) == -1 then
							writei32(region, (t + W) * 4, r)
							stack[#stack + 1] = t + W
						end
					end
					local m = #members
					fx /= m
					fy /= m
					local best = members[1]
					local bd = 1e20
					for _, t in members do
						local ddx = (t % W) - fx
						local ddy = (t // W) - fy
						local dd = ddx * ddx + ddy * ddy
						if dd < bd then
							bd = dd
							best = t
						end
					end
					reg_full[r + 1] = if m == CELL * CELL then 1 else 0
					reg_x[r + 1] = fx
					reg_y[r + 1] = fy
					reg_body[r + 1] = b
					reg_tile[r + 1] = best
				end
			end
		end
	end
	assert(reg_count < PAIR_K, "SimNav: too many regions")
	self.reg_count = reg_count
	local rb = buffer.create(math.max(reg_count, 1) * 4)
	local rt = buffer.create(math.max(reg_count, 1) * 4)
	local rx = buffer.create(math.max(reg_count, 1) * 4)
	local ry = buffer.create(math.max(reg_count, 1) * 4)
	local rf = buffer.create(math.max(reg_count, 1))
	for r = 0, reg_count - 1 do
		writei32(rb, r * 4, reg_body[r + 1])
		writei32(rt, r * 4, reg_tile[r + 1])
		writef32(rx, r * 4, reg_x[r + 1])
		writef32(ry, r * 4, reg_y[r + 1])
		writeu8(rf, r, reg_full[r + 1])
	end
	reg_body, reg_tile, reg_x, reg_y, reg_full = nil :: any, nil :: any, nil :: any, nil :: any, nil :: any
	self.reg_body = rb
	self.reg_tile = rt
	self.reg_x = rx
	self.reg_y = ry
	self.reg_full = rf
	Coop.check()
	-- 2. Edges between regions, with every boundary pair collected per region pair (keys kept in
	-- first-seen order).
	local pairs_: { [number]: { number } } = {}
	local keys: { number } = {}
	local function add_pair(r: number, r2: number, t: number, t2: number)
		local k
		if r < r2 then
			k = r * PAIR_K + r2
		else
			k = r2 * PAIR_K + r
			t, t2 = t2, t
		end
		local list = pairs_[k]
		if list == nil then
			list = {}
			pairs_[k] = list
			keys[#keys + 1] = k
		end
		list[#list + 1] = t
		list[#list + 1] = t2
	end
	for t = 0, N - 1 do
		if t % 16384 == 0 then
			Coop.check()
		end
		local r = readi32(region, t * 4)
		if r < 0 then
			continue
		end
		local x = t % W
		local y = t // W
		local has_e = x < W - 1
		local e = t + 1
		local r2
		if has_e then
			r2 = readi32(region, e * 4)
			if r2 >= 0 and r2 ~= r then
				add_pair(r, r2, t, e)
			end
		end
		if y < H - 1 then
			local s = t + W
			r2 = readi32(region, s * 4)
			if r2 >= 0 and r2 ~= r then
				add_pair(r, r2, t, s)
			end
			-- Diagonal links through one-tile straits (both orthogonal tiles are land).
			if has_e then
				local se = s + 1
				r2 = readi32(region, se * 4)
				if r2 >= 0 and r2 ~= r and readi32(region, e * 4) < 0 and readi32(region, s * 4) < 0 then
					add_pair(r, r2, t, se)
				end
			end
			if x > 0 then
				local sw = s - 1
				r2 = readi32(region, sw * 4)
				local wv = t - 1
				if r2 >= 0 and r2 ~= r and readi32(region, wv * 4) < 0 and readi32(region, s * 4) < 0 then
					add_pair(r, r2, t, sw)
				end
			end
		end
	end
	-- 3. CSR adjacency (both directions), portal = middle boundary pair.
	local deg = buffer.create((reg_count + 1) * 4)
	for _, k in keys do
		local a = k // PAIR_K
		local b = k % PAIR_K
		writei32(deg, a * 4, readi32(deg, a * 4) + 1)
		writei32(deg, b * 4, readi32(deg, b * 4) + 1)
	end
	local adj_off = buffer.create((reg_count + 1) * 4)
	local acc = 0
	for r = 0, reg_count - 1 do
		writei32(adj_off, r * 4, acc)
		acc += readi32(deg, r * 4)
	end
	writei32(adj_off, reg_count * 4, acc)
	local na = math.max(acc, 1)
	local adj_to = buffer.create(na * 4)
	local adj_cost = buffer.create(na * 4)
	local adj_pa = buffer.create(na * 4)
	local adj_pb = buffer.create(na * 4)
	local fill = buffer.create((reg_count + 1) * 4)
	for _, k in keys do
		local a = k // PAIR_K
		local b = k % PAIR_K
		local list = pairs_[k]
		local mid = (#list // 4) * 2
		local ta = list[mid + 1]
		local tb = list[mid + 2]
		local cost = _dist(readf32(rx, a * 4), readf32(ry, a * 4), readf32(rx, b * 4), readf32(ry, b * 4))
		local fa = readi32(fill, a * 4)
		local ia = readi32(adj_off, a * 4) + fa
		writei32(fill, a * 4, fa + 1)
		writei32(adj_to, ia * 4, b)
		writef32(adj_cost, ia * 4, cost)
		writei32(adj_pa, ia * 4, ta)
		writei32(adj_pb, ia * 4, tb)
		local fb = readi32(fill, b * 4)
		local ib = readi32(adj_off, b * 4) + fb
		writei32(fill, b * 4, fb + 1)
		writei32(adj_to, ib * 4, a)
		writef32(adj_cost, ib * 4, cost)
		writei32(adj_pa, ib * 4, tb)
		writei32(adj_pb, ib * 4, ta)
	end
	Coop.check()
	self.adj_off = adj_off
	self.adj_to = adj_to
	self.adj_cost = adj_cost
	self.adj_pa = adj_pa
	self.adj_pb = adj_pb
	self:_alloc_scratch()
end

function SimNav.is_water(self: any, t: number): boolean
	return readu16(self.body, t * 2) ~= 0
end

--- Water body of tile `t` (0 on land).
function SimNav.body_of(self: any, t: number): number
	return readu16(self.body, t * 2)
end

--- Region of water tile `t` (-1 on land).
function SimNav.region_of(self: any, t: number): number
	return readi32(self.region, t * 4)
end

--- Water body of region `r`.
function SimNav.region_body(self: any, r: number): number
	return readi32(self.reg_body, r * 4)
end

--- A water tile of `water_body` 4/8-adjacent to land tile `t` (-1 if none). Order: west, east,
--- north, north-west, north-east, south, south-west, south-east.
function SimNav.water_next_to(self: any, t: number, water_body: number): number
	local body = self.body
	local region = self.region
	local W = self.W
	local x = t % W
	local has_w = x > 0
	local has_e = x < W - 1
	local function ok(c: number): boolean
		return readu16(body, c * 2) == water_body and readi32(region, c * 4) >= 0
	end
	if has_w and ok(t - 1) then
		return t - 1
	end
	if has_e and ok(t + 1) then
		return t + 1
	end
	if t >= W then
		local up = t - W
		if ok(up) then
			return up
		end
		if has_w and ok(up - 1) then
			return up - 1
		end
		if has_e and ok(up + 1) then
			return up + 1
		end
	end
	if t < self.N - W then
		local dn = t + W
		if ok(dn) then
			return dn
		end
		if has_w and ok(dn - 1) then
			return dn - 1
		end
		if has_e and ok(dn + 1) then
			return dn + 1
		end
	end
	return -1
end

-- =============================================================================================
-- Search
-- =============================================================================================

--- Dense water tile path from water tile `src` to water tile `dst` (same body), or {}.
function SimNav.find_path(self: any, src: number, dst: number): { number }
	local t0 = clock_us()
	local p = self:_find_path(src, dst)
	local dt = clock_us() - t0
	self.usec += dt
	if dt > self.usec_max then
		self.usec_max = dt
	end
	if #p == 0 then
		self.fails += 1
	end
	return p
end

--- Like find_path, but tries a straight line first (cheap for short warship hops).
function SimNav.short_path(self: any, src: number, dst: number): { number }
	local body = self.body
	if src >= 0 and dst >= 0 then
		local b = readu16(body, src * 2)
		if b ~= 0 and b == readu16(body, dst * 2) and self:los(src, dst, b) then
			local out = { src }
			self:_raster(src, dst, out)
			return out
		end
	end
	return self:find_path(src, dst)
end

function SimNav._find_path(self: any, src: number, dst: number): { number }
	if src < 0 or dst < 0 or src >= self.N or dst >= self.N then
		return {}
	end
	local region = self.region
	local ra = readi32(region, src * 4)
	local rb = readi32(region, dst * 4)
	local reg_body = self.reg_body
	if ra < 0 or rb < 0 or readi32(reg_body, ra * 4) ~= readi32(reg_body, rb * 4) then
		return {}
	end
	local ta = clock_us()
	local regs = self:_region_path(ra, rb)
	self.usec_astar += clock_us() - ta
	if #regs == 0 then
		return {}
	end
	local raw = { src }
	local cur = src
	local adj_off = self.adj_off
	local adj_to = self.adj_to
	local adj_pa = self.adj_pa
	local adj_pb = self.adj_pb
	for i = 1, #regs - 1 do
		local r = regs[i]
		local r2 = regs[i + 1]
		local k = readi32(adj_off, r * 4)
		local pa = -1
		local pb = -1
		local kend = readi32(adj_off, (r + 1) * 4)
		while k < kend do
			if readi32(adj_to, k * 4) == r2 then
				pa = readi32(adj_pa, k * 4)
				pb = readi32(adj_pb, k * 4)
				break
			end
			k += 1
		end
		if pa < 0 then
			return {}
		end
		if not self:_bfs_append(cur, pa, r, raw) then
			return {}
		end
		raw[#raw + 1] = pb
		cur = pb
	end
	if not self:_bfs_append(cur, dst, rb, raw) then
		return {}
	end
	local ts = clock_us()
	local sm = self:_smooth(raw, readi32(reg_body, ra * 4))
	self.usec_smooth += clock_us() - ts
	return sm
end

function SimNav._region_path(self: any, ra: number, rb: number): { number }
	self.searches += 1
	self._stamp += 1
	local st = self._stamp
	self._heap_size = 0
	local g = self._g
	local came = self._came
	local seen = self._seen
	local closed = self._closed
	local reg_x = self.reg_x
	local reg_y = self.reg_y
	local adj_off = self.adj_off
	local adj_to = self.adj_to
	local adj_cost = self.adj_cost
	writef64(g, ra * 8, 0.0)
	writei32(came, ra * 4, -1)
	writei32(seen, ra * 4, st)
	local gx = readf32(reg_x, rb * 4)
	local gy = readf32(reg_y, rb * 4)
	self:_heap_push(ra, _dist(readf32(reg_x, ra * 4), readf32(reg_y, ra * 4), gx, gy) * HEURISTIC_W)
	local found = false
	local expanded = 0
	while self._heap_size > 0 do
		local r = self:_heap_pop()
		if readi32(closed, r * 4) == st then
			continue
		end
		writei32(closed, r * 4, st)
		expanded += 1
		if r == rb then
			found = true
			break
		end
		local gr = readf64(g, r * 8)
		for k = readi32(adj_off, r * 4), readi32(adj_off, (r + 1) * 4) - 1 do
			local n = readi32(adj_to, k * 4)
			if readi32(closed, n * 4) == st then
				continue
			end
			-- g values are kept rounded to float32 (as the original's PackedFloat32Array).
			local ng = gr + readf32(adj_cost, k * 4)
			if readi32(seen, n * 4) ~= st or ng < readf64(g, n * 8) then
				writei32(seen, n * 4, st)
				writef64(g, n * 8, f32b(ng))
				writei32(came, n * 4, r)
				self:_heap_push(n, ng + _dist(readf32(reg_x, n * 4), readf32(reg_y, n * 4), gx, gy) * HEURISTIC_W)
			end
		end
	end
	self.expanded += expanded
	local out = {}
	if not found then
		return out
	end
	local c = rb
	while c ~= -1 do
		out[#out + 1] = c
		c = readi32(came, c * 4)
	end
	-- reverse
	local n = #out
	for i = 1, n // 2 do
		out[i], out[n + 1 - i] = out[n + 1 - i], out[i]
	end
	return out
end

function SimNav._heap_push(self: any, n: number, f: number)
	local hn = self._heap_n
	local hf = self._heap_f
	local i = self._heap_size
	self._heap_size = i + 1
	while i > 0 do
		local p = (i - 1) // 2
		if hf[p] <= f then
			break
		end
		hn[i] = hn[p]
		hf[i] = hf[p]
		i = p
	end
	hn[i] = n
	hf[i] = f32b(f)
end

function SimNav._heap_pop(self: any): number
	local hn = self._heap_n
	local hf = self._heap_f
	local top = hn[0]
	local size = self._heap_size - 1
	self._heap_size = size
	if size == 0 then
		return top
	end
	local ln = hn[size]
	local lf = hf[size]
	local i = 0
	while true do
		local c = i * 2 + 1
		if c >= size then
			break
		end
		if c + 1 < size and hf[c + 1] < hf[c] then
			c += 1
		end
		if hf[c] >= lf then
			break
		end
		hn[i] = hn[c]
		hf[i] = hf[c]
		i = c
	end
	hn[i] = ln
	hf[i] = lf
	return top
end

--- BFS inside region `r` from `a` to `b`; appends the tiles after `a` up to and including `b`.
function SimNav._bfs_append(self: any, a: number, b: number, r: number, out: { number }): boolean
	if a == b then
		return true
	end
	if readu8(self.reg_full, r) == 1 then
		self:_raster(a, b, out)
		return true
	end
	local region = self.region
	local t_seen = self._t_seen
	local t_par = self._t_par
	table.clear(t_seen)
	table.clear(t_par)
	local q = self._q
	table.clear(q)
	q[1] = a
	local qn = 1
	t_seen[a] = true
	t_par[a] = -1
	local head = 1
	local found = false
	local W = self.W
	local NW = self.N - W
	while head <= qn do
		local t = q[head]
		head += 1
		if t == b then
			found = true
			break
		end
		local x = t % W
		for k = 1, 4 do
			local n
			if k == 1 then
				if x == 0 then
					continue
				end
				n = t - 1
			elseif k == 2 then
				if x == W - 1 then
					continue
				end
				n = t + 1
			elseif k == 3 then
				if t < W then
					continue
				end
				n = t - W
			else
				if t >= NW then
					continue
				end
				n = t + W
			end
			if readi32(region, n * 4) == r and not t_seen[n] then
				t_seen[n] = true
				t_par[n] = t
				qn += 1
				q[qn] = n
			end
		end
	end
	if not found then
		-- a and b might be diagonal neighbours across a one-tile strait: accept the jump.
		out[#out + 1] = b
		return readi32(region, b * 4) == r or readi32(region, a * 4) == r
	end
	local seg = {}
	local c = b
	while c ~= a do
		seg[#seg + 1] = c
		c = t_par[c]
	end
	for i = #seg, 1, -1 do
		out[#out + 1] = seg[i]
	end
	return true
end

-- =============================================================================================
-- Smoothing
-- =============================================================================================

function SimNav._smooth(self: any, raw: { number }, b: number): { number }
	local n = #raw
	if n <= 2 then
		return raw
	end
	local out = { raw[1] }
	-- 0-based indices into raw (raw[i + 1])
	local i = 0
	while i < n - 1 do
		-- Exponential probe then binary search for the farthest visible raw point.
		local good = i + 1
		local stride = 2
		local bad = -1
		while true do
			local j = i + stride
			if j >= n - 1 then
				j = n - 1
			end
			if self:los(raw[i + 1], raw[j + 1], b) then
				good = j
				if j == n - 1 or stride >= 256 then
					break
				end
				stride *= 2
			else
				bad = j
				break
			end
		end
		if bad > 0 then
			local lo = good
			local hi = bad
			while hi - lo > 1 do
				local mid = (lo + hi) // 2
				if self:los(raw[i + 1], raw[mid + 1], b) then
					lo = mid
				else
					hi = mid
				end
			end
			good = lo
		end
		if good == i + 1 then
			out[#out + 1] = raw[good + 1]
		else
			self:_raster(raw[i + 1], raw[good + 1], out)
		end
		i = good
	end
	return out
end

--- True when the straight tile line a→bt stays on water of body `b` without cutting land corners.
function SimNav.los(self: any, a: number, bt: number, b: number): boolean
	local body = self.body
	local W = self.W
	local x0 = a % W
	local y0 = a // W
	local x1 = bt % W
	local y1 = bt // W
	local dx = x1 - x0
	local dy = y1 - y0
	local sx = if dx > 0 then 1 else -1
	local sy = if dy > 0 then 1 else -1
	local ax = math.abs(dx)
	local ay = math.abs(dy)
	local err = ax - ay
	local x = x0
	local y = y0
	local steps = ax + ay
	local k = 0
	while k < steps do
		local e2 = err * 2
		local nx = x
		local ny = y
		if e2 > -ay then
			err -= ay
			nx = x + sx
		end
		if e2 < ax then
			err += ax
			ny = y + sy
		end
		if nx ~= x and ny ~= y then
			-- Diagonal: one orthogonal corner must be water too.
			if readu16(body, (y * W + nx) * 2) ~= b and readu16(body, (ny * W + x) * 2) ~= b then
				return false
			end
			k += 1
		end
		x = nx
		y = ny
		if readu16(body, (y * W + x) * 2) ~= b then
			return false
		end
		k += 1
	end
	return true
end

--- Tiles of the straight line a→bt (excluding a) on a grid `W` tiles wide, appended to the
--- 1-based array `out`.
local function line_tiles(W: number, a: number, bt: number, out: { number })
	local x0 = a % W
	local y0 = a // W
	local x1 = bt % W
	local y1 = bt // W
	local dx = x1 - x0
	local dy = y1 - y0
	local sx = if dx > 0 then 1 else -1
	local sy = if dy > 0 then 1 else -1
	local ax = math.abs(dx)
	local ay = math.abs(dy)
	local err = ax - ay
	local x = x0
	local y = y0
	local n = #out
	while x ~= x1 or y ~= y1 do
		local e2 = err * 2
		if e2 > -ay then
			err -= ay
			x += sx
		end
		if e2 < ax then
			err += ax
			y += sy
		end
		n += 1
		out[n] = y * W + x
	end
end

--- Appends the tiles of the line a→bt (excluding a) to out.
function SimNav._raster(self: any, a: number, bt: number, out: { number })
	line_tiles(self.W, a, bt, out)
end

--- line_tiles(W, a, bt, out): tiles of the straight line a→bt (excluding a) on any terrain — used
--- for roads and trucks.
SimNav.line_tiles = line_tiles

--- Random water tile of the same body within `radius` of `center` that is reachable by a short
--- search (used for warship patrols). Returns -1 when none found.
function SimNav.random_water_near(self: any, center: number, radius: number, rng: any): number
	local body = self.body
	local b = readu16(body, center * 2)
	if b == 0 then
		return -1
	end
	local W = self.W
	local cx = center % W
	local cy = center // W
	local rx = math.min(math.ceil(radius), W - 1)
	local r2 = radius * radius
	for _ = 1, 12 do
		local x = math.clamp(cx + rng:randi_range(-rx, rx), 0, W - 1)
		local y = math.clamp(cy + rng:randi_range(-radius, radius), 1, self.H - 2)
		local t = y * W + x
		local ddx = x - cx
		local ddy = y - cy
		if readu16(body, t * 2) == b and ddx * ddx + ddy * ddy <= r2 then
			return t
		end
	end
	return -1
end

return SimNav
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">SimNaval</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/sim_naval.gd (SimNaval, mixin of the flattened Sim class).
-- Transport boats (amphibious attacks) and trade ships between ports (warships: SimWarships).
-- Moving ships cost nothing per tick: their position is implicit from start_tick and speed;
-- only arrivals run logic.

local Defs = require("./Defs")
local Coop = require("../Net/Coop")
local Rules = require("./Rules")
local SimNav = require("./SimNav")
local SimStructures = require("./SimStructures")

local readu8 = buffer.readu8
local readu16 = buffer.readu16
local readi32 = buffer.readi32

local Unit = SimStructures.Unit

local MAXO = Defs.MAX_OWNERS

local S_PORT = Defs.S_PORT
local U_TRANSPORT = Defs.U_TRANSPORT
local U_TRADE = Defs.U_TRADE
local U_TRUCK = Defs.U_TRUCK

-- (src_sid << 20) | dst_sid (sids stay far below 2^20)
local KEY_SHIFT = 1048576

local SimNaval = {}

function SimNaval.install(C)
	function C:_init_naval()
		self.nav = SimNav.shared(self.map)
		-- (src_sid << 20) | dst_sid → water tile path
		self.trade_cache = {} :: { [number]: { number } }
		-- Uncached trade routes that may still be computed this tick.
		self.path_budget = 0
		-- Tick of the last "trade ship captured" message per victim (throttles spam).
		self._capture_msg_tick = {} :: { [number]: number }
		-- Remaining boat path searches this second per owner (refilled by refill_boat_tokens()).
		local bt = table.create(MAXO)
		for i = 0, MAXO - 1 do
			bt[i] = Rules.BOAT_SEARCHES_PER_S
		end
		self.boat_tokens = bt
	end

	function C:refill_boat_tokens()
		local bt = self.boat_tokens
		local v = Rules.BOAT_SEARCHES_PER_S
		for i = 0, MAXO - 1 do
			bt[i] = v
		end
	end

	function C:_port_water(t: number, water_body: number): number
		return self.nav:water_next_to(t, water_body)
	end

	local super_destroy_struct = C.destroy_struct
	function C:destroy_struct(s)
		local was_port = s.kind == S_PORT and not s.dead
		super_destroy_struct(self, s)
		if was_port and next(self.trade_cache) ~= nil then
			local drop = {}
			local sid = s.sid
			for k in self.trade_cache do
				if k // KEY_SHIFT == sid or k % KEY_SHIFT == sid then
					table.insert(drop, k)
				end
			end
			for _, k in drop do
				self.trade_cache[k] = nil
			end
		end
	end

	-- =========================================================================================
	-- Transports
	-- =========================================================================================

	-- Boat intent: carry `ratio` of home troops to coastal tile `t` and attack from the beachhead.
	function C:launch_boat(id: number, t: number, ratio: number): boolean
		-- Cheap rejections first; the coast scan and path search are budgeted per owner.
		if not Defs.is_finite(ratio) or t < 0 or t >= self.N then
			return false
		end
		local map = self.map
		if readu8(self.land, t) == 0 or readu8(map.coastal, t) == 0 then
			self:msg(id, Defs.MSG_INFO, "Boats can only land on a coast")
			return false
		end
		local tg = readi32(self.owner, t * 4)
		if tg == id then
			return false
		end
		if tg ~= 0 and self:allied(id, tg) then
			self:msg(id, Defs.MSG_INFO, string.format("%s is your ally", self.o_name[tg]))
			return false
		end
		if self:shielded(tg) then
			self:msg(id, Defs.MSG_INFO, self:shield_text(tg))
			return false
		end
		-- (a person: kind human and no bot; a bot player's AI holds itself to the AI's limit)
		if self.o_boats[id] >= Rules.max_boats(self.o_tiles[id], self.o_kind[id] == Defs.KIND_HUMAN and self.o_bot[id] ~= 1) then
			self:msg(id, Defs.MSG_INFO, "Too many transports at sea")
			return false
		end
		local r = math.clamp(ratio, 0.01, 1.0)
		if self.o_troops[id] * r < 1.0 then
			return false
		end
		if self.boat_tokens[id] <= 0 then
			self:msg(id, Defs.MSG_INFO, "Too many boat orders at once — wait a moment")
			return false
		end
		self.boat_tokens[id] -= 1
		local water_body = readu16(map.coast_body, t * 2)
		local src = self:nearest_own_coast(id, water_body, t)
		if src < 0 then
			self:msg(id, Defs.MSG_INFO, "You have no coast on that sea")
			return false
		end
		local nav = self.nav
		local ws = nav:water_next_to(src, water_body)
		local wd = nav:water_next_to(t, water_body)
		local path = nav:find_path(ws, wd)
		if #path < 2 then
			self:msg(id, Defs.MSG_INFO, "No sea route to that coast")
			return false
		end
		-- Launching the boat takes its troops from home (floored).
		local troops = math.floor(self.o_troops[id] * r)
		if troops < 1.0 then
			return false
		end
		self.o_troops[id] -= troops
		self.dbg_flow[id * 5 + 1] += troops
		local tick = self.tick
		local u = Unit.new()
		u.kind = U_TRANSPORT
		u.owner = id
		u.path = path
		u.start_tick = tick
		u.tpt = self.R.TRANSPORT_TPT_X100
		u.troops = troops
		u.target_tile = t
		u.body = water_body
		u.end_tick = tick + ((#path - 1) * u.tpt + 99) // 100
		self.o_boats[id] += 1
		self:add_unit(u)
		if tg ~= 0 then
			self:msg(tg, Defs.MSG_ALERT, string.format("%s sent a transport toward your coast", self.o_name[id]))
			self:_on_transport_launched(u, tg)
		end
		return true
	end

	-- Hook for the AI (a nation may answer an incoming transport).
	function C:_on_transport_launched(_u, _target_owner: number) end

	-- Owned coastal tile on `water_body` closest to `near` (-1 if none).
	function C:nearest_own_coast(id: number, water_body: number, near: number): number
		local owner = self.owner
		local map = self.map
		local cb = map.coast_body
		local coast_list = map.coast_list
		local dist2 = self.dist2
		local best = -1
		local bd = 1099511627776 -- 1 << 40
		for k = 0, map.coast_count - 1 do
			local c = readi32(coast_list, k * 4)
			if readi32(owner, c * 4) == id and readu16(cb, c * 2) == water_body then
				local d = dist2(c, near)
				if d < bd then
					bd = d
					best = c
				end
			end
		end
		return best
	end

	function C:_transport_arrive(u)
		local id = u.owner
		self:remove_unit(u, Defs.DEL_ARRIVED)
		if self.o_alive[id] == 0 then
			return
		end
		local t = u.target_tile
		if readi32(self.owner, t * 4) == id then
			-- A transport that lands on its own coast loses malusForRetreat (25 %).
			self.o_troops[id] += math.floor(u.troops * Rules.RETREAT_KEEP)
			self:msg(id, Defs.MSG_INFO, "Your transport returned its troops home")
			return
		end
		if not self:_landable(id, t) then
			t = self:_alt_landing(id, t, u.body)
			if t < 0 then
				self.o_troops[id] += math.floor(u.troops * 0.5)
				self:msg(id, Defs.MSG_BAD, "Your transport could not land")
				return
			end
		end
		local tg = readi32(self.owner, t * 4)
		if tg ~= 0 and not self:_landing_allowed(id, tg) then
			-- The coast changed hands while at sea and this attack isn't allowed (a spawn shield,
			-- human protection).
			self.o_troops[id] += u.troops
			if self:shielded(tg) then
				self:msg(id, Defs.MSG_INFO, string.format("Your transport turned back: %s just spawned", self.o_name[tg]))
			end
			return
		end
		-- On landing, the tile is taken for free and every soldier
		-- on board starts an attack from it.
		local troops = u.troops
		self:conquer(t, id, nil)
		if tg ~= 0 then
			self:msg(id, Defs.MSG_GOOD, string.format("Your transport landed in %s", self.o_name[tg]))
			self:msg(tg, Defs.MSG_ALERT, string.format("%s landed troops on your coast!", self.o_name[id]))
		else
			self:msg(id, Defs.MSG_GOOD, "Your transport landed")
		end
		-- With nothing to push into, start_attack sends the troops home.
		self:start_attack(id, tg, troops, t)
	end

	-- Overridden by Sim: may `id`'s landing start an attack on `tg` right now?
	function C:_landing_allowed(_id: number, _tg: number): boolean
		return true
	end

	function C:_landable(id: number, t: number): boolean
		if readu8(self.land, t) == 0 then
			return false
		end
		local tg = readi32(self.owner, t * 4)
		return tg ~= id and not (tg ~= 0 and self:allied(id, tg))
	end

	function C:_alt_landing(id: number, t: number, water_body: number): number
		local W = self.W
		local H = self.H
		local cx = t % W
		local cy = t // W
		local coastal = self.map.coastal
		local cb = self.map.coast_body
		-- 3 tiles of the original 1024-wide Earth (~6 full-size tiles).
		local rmax = math.max(3, math.ceil(6.0 / self.R.K_LIN))
		for r = 1, rmax do
			for dy = -r, r do
				local y = cy + dy
				if y < 0 or y >= H then
					continue
				end
				for dx = -r, r do
					local x = cx + dx
					if x < 0 or x >= W then
						continue
					end
					local c = y * W + x
					if readu8(coastal, c) == 1 and readu16(cb, c * 2) == water_body and self:_landable(id, c) then
						return c
					end
				end
			end
		end
		return -1
	end

	-- =========================================================================================
	-- Trade
	-- =========================================================================================

	-- Ports: every 10 ticks each port launches a trade ship with probability
	-- 1 / tradeShipSpawnRate(rejections, trade ships at sea) (a pity timer raises the odds after
	-- each miss) to a port of another player it may trade with.
	function C:ports_tick()
		local tick = self.tick
		local slot = tick % 10
		local o_alive = self.o_alive
		local rng = self.rng
		for _, p in self.port_list do
			if p.next_tick ~= slot or o_alive[p.owner] == 0 or p.water < 0 then
				continue
			end
			-- One spawn roll per port level.
			local hit = false
			for _ = 1, p.level do
				if rng:randi() % Rules.trade_spawn_rate(p.rejections, self.n_trade) == 0 then
					hit = true
					break
				end
				p.rejections += 1
			end
			if not hit then
				continue
			end
			p.rejections = 0
			local dst = self:_pick_trade_port(p)
			if dst == nil then
				continue
			end
			local path = self:_trade_path(p, dst)
			if #path < 2 then
				if self.path_budget <= 0 then
					p.rejections += 1
				end
				continue
			end
			local u = Unit.new()
			u.kind = U_TRADE
			u.owner = p.owner
			u.path = path
			u.start_tick = tick
			u.tpt = self.R.TRADE_TPT_X100
			u.src_sid = p.sid
			u.dst_sid = dst.sid
			u.body = p.body
			u.end_tick = tick + ((#path - 1) * u.tpt + 99) // 100
			self:add_unit(u)
		end
	end

	function C:_pick_trade_port(p)
		if #p.partners == 0 or self.tick - p.partners_tick > 1200 then
			self:_refresh_partners(p)
		end
		local partners = p.partners
		local n = #partners
		local structs = self.structs
		for _ = 1, 3 do
			if n == 0 then
				return nil
			end
			local q = structs[partners[self.rng:randi() % n + 1]]
			if
				q == nil
				or q.kind ~= S_PORT
				or q.owner == p.owner
				or self.o_alive[q.owner] == 0
				or self:hostile(p.owner, q.owner)
			then
				continue
			end
			return q
		end
		p.partners_tick = -100000
		return nil
	end

	-- Keeps up to 8 trade partners per port, sampled with the partner weights of _trade_candidates.
	-- Valid partners are kept across refreshes so routes repeat and their paths stay cached.
	function C:_refresh_partners(p)
		p.partners_tick = self.tick
		local keep = {}
		local structs = self.structs
		for _, sid in p.partners do
			local q = structs[sid]
			if q ~= nil and q.kind == S_PORT and q.owner ~= p.owner and self.o_alive[q.owner] == 1 then
				table.insert(keep, sid)
			end
		end
		local partners = table.clone(keep)
		p.partners = partners
		local cands = {}
		local weights = {}
		self:_trade_candidates(p, cands, weights)
		for _ = 1, 8 - #keep do
			local q2 = self:_weighted_pick(cands, weights)
			if q2 == nil then
				break
			end
			if table.find(partners, q2.sid) == nil then
				table.insert(partners, q2.sid)
			end
		end
	end

	-- Trading partners: ports of other players on the same water that p may trade
	-- with, sorted by distance; weight 1, +1 for the nearest clamp(n / 3, 4, n) unless closer
	-- than tradeShipShortRangeDebuff, +1 for allies unless that close.
	function C:_trade_candidates(p, cands: { any }, weights: { number })
		local dists = {}
		local o_alive = self.o_alive
		local geo_manhattan = self.geo_manhattan
		local K_LIN = self.R.K_LIN
		for _, q in self.port_list do
			if q.body ~= p.body or q.owner == p.owner or q.water < 0 or o_alive[q.owner] == 0 then
				continue
			end
			if self:hostile(p.owner, q.owner) then
				continue
			end
			table.insert(dists, { geo_manhattan(p.tile, q.tile) * K_LIN, q })
		end
		-- Godot's sort_custom (unstable): equal distances end up in the Godot version's order.
		Defs.godot_sort(dists, function(a, b)
			return a[1] < b[1]
		end)
		local n = #dists
		local bonus_n = math.clamp(n // 3, math.min(4, n), n)
		for i = 1, n do
			local q = dists[i][2]
			local far = dists[i][1] >= Rules.TRADE_SHORT_RANGE_FULL
			-- Each entry counts once per level of the destination port.
			local lv = q.level
			local w = lv
			if far and i - 1 < bonus_n then
				w += lv
			end
			if far and self:allied(p.owner, q.owner) then
				w += lv
			end
			table.insert(cands, q)
			table.insert(weights, w)
		end
	end

	function C:_weighted_pick(cands: { any }, weights: { number })
		local n = #cands
		if n == 0 then
			return nil
		end
		local total = 0.0
		for _, w in weights do
			total += w
		end
		local r = self.rng:randf() * total
		for i = 1, n do
			r -= weights[i]
			if r <= 0.0 then
				return cands[i]
			end
		end
		return cands[n]
	end

	function C:_trade_path(a, b): { number }
		local cache = self.trade_cache
		local key = a.sid * KEY_SHIFT + b.sid
		local cached = cache[key]
		if cached ~= nil then
			return cached
		end
		local rev_src = cache[b.sid * KEY_SHIFT + a.sid]
		if rev_src ~= nil then
			local n = #rev_src
			local rev = table.create(n)
			for i = 1, n do
				rev[i] = rev_src[n + 1 - i]
			end
			cache[key] = rev
			return rev
		end
		if self.path_budget <= 0 then
			return {}
		end
		self.path_budget -= 1
		local path = self.nav:find_path(a.water, b.water)
		cache[key] = path
		return path
	end

	-- Arrival: tradeShipGold(tiles sailed) to both ports' owners, or - for
	-- a captured ship - to its captor alone (to the original owner when it was retaken).
	function C:_trade_arrive(u)
		self:remove_unit(u, Defs.DEL_ARRIVED)
		local g = self.R.trade_gold(u.traveled + #u.path)
		local dst = self.structs[u.dst_sid]
		-- Each earner's map shows the gold over a port (Ev.BONUS, a person
		-- only). The sender's is the port the ship left (its home port; the one it reached when that port
		-- is gone or lost), the receiver's and a captor's the port it reached.
		if u.orig_owner ~= 0 then
			if dst ~= nil and dst.owner == u.owner then
				self:add_bonus_gold(u.owner, g, dst.tile)
			end
			return
		end
		local src = self.structs[u.src_sid]
		self:add_bonus_gold(
			u.owner,
			g,
			if src ~= nil and src.owner == u.owner then src.tile elseif dst ~= nil then dst.tile else nil
		)
		if dst ~= nil and dst.owner ~= u.owner and not self:hostile(dst.owner, u.owner) then
			self:add_bonus_gold(dst.owner, g, dst.tile)
		end
	end

	-- =========================================================================================
	-- Per-tick unit processing
	-- =========================================================================================

	-- Owners' units are removed on elimination, so only due units need work here.
	function C:units_tick()
		local list = self.unit_list
		local n = #list
		local tick = self.tick
		for i = 1, n do
			local u = list[i]
			if u.dead or tick < u.next_tick then
				continue
			end
			local k = u.kind
			if k == U_TRANSPORT then
				self:_transport_arrive(u)
			elseif k == U_TRADE then
				self:_trade_arrive(u)
			elseif k == U_TRUCK then
				self:_truck_tick(u)
			end
			if i % 32 == 0 then
				Coop.check() -- (a local match's step is spread over frames: Session._local_process)
			end
		end
		self:compact_units()
	end

	function C:remove_units_of(id: number)
		for _, u in self.unit_list do
			if not u.dead and u.owner == id then
				self:remove_unit(u, Defs.DEL_DESTROYED)
			end
		end
	end
end

return SimNaval
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">SimNukes</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/sim_nukes.gd (SimNukes, mixin of the flattened Sim class).
-- Atom bombs, hydrogen bombs and MIRVs: silo launch, SAM interception, blasts and fallout.
--
-- Event conventions (see DESIGN.md §4): a NUKE event announces every missile (MIRV warheads
-- included). BOOM with radius > 0 is a detonation; radius 0 means the missile was shot down
-- mid-air at that tile; radius -1 means a MIRV bus split into warheads at that tile. SAM_LAUNCH
-- announces a SAM firing at a bomb / warhead (it hits at intercept_tick).
--
-- Nukes fly an arc (Rules.nuke_arc: a Bezier bowed toward the top of the map, constant speed
-- along it), the same curve the renderer draws; the flight time is its length over the nuke's speed.
--
-- Luau notes: `traj` is a 1-based array; trajectory indices (`k`, `sam_k`, `plan_k`) keep the
-- GDScript 0-based meaning (ticks since launch), so traj[k + 1] is the tile at tick k.

local Defs = require("./Defs")
local Coop = require("../Net/Coop")
local Ev = require("./Ev")
local Rules = require("./Rules")
local SimState = require("./SimState")

local readu8 = buffer.readu8
local writeu8 = buffer.writeu8
local readi32 = buffer.readi32

local a_an = SimState.a_an
local cap_first = SimState.cap_first

local S_SAM = Defs.S_SAM
local S_SILO = Defs.S_SILO
local U_TRANSPORT = Defs.U_TRANSPORT
local N_ATOM = Defs.N_ATOM
local N_HYDROGEN = Defs.N_HYDROGEN
local N_MIRV = Defs.N_MIRV
local N_WARHEAD = Defs.N_WARHEAD
local N_MEGA = Defs.N_MEGA
local N_SCATTER = Defs.N_SCATTER
local N_SHELL = Defs.N_SHELL
local F_FALLOUT = Defs.F_FALLOUT

local SimNukes = {}

local function nuke_title(kind: number): string
	return Defs.NUKE_TITLES[kind]
end

export type Nuke = {
	uid: number,
	kind: number,
	owner: number,
	from_tile: number,
	to_tile: number,
	launch_tick: number,
	flight: number,
	--- Rules.nuke_arc: its flight path (the arc the renderer draws; traj samples it)
	arc: any,
	target_owner: number,
	dead: boolean,
	traj: { number },
	cands: { number },
	cand_tick: number,
	plan_fire: { [number]: number },
	plan_k: { [number]: number },
	sam_sid: number,
	sam_fire_tick: number,
	sam_hit_tick: number,
	sam_k: number,
}

local Nuke = {}
SimNukes.Nuke = Nuke

function Nuke.new(): Nuke
	return {
		uid = 0,
		kind = 0,
		owner = 0,
		from_tile = 0,
		to_tile = 0,
		launch_tick = 0,
		flight = 1,
		arc = nil,
		target_owner = 0,
		dead = false,
		-- Ground tile under the missile at each tick of its flight (traj[k + 1] = tick k since
		-- launch), computed when a SAM might reach it.
		traj = {},
		-- SAM interception planning: candidate SAM sids, refreshed every 30
		-- ticks, and per SAM the planned fire tick (-1 unreachable) and trajectory index of the
		-- intercept.
		cands = {},
		cand_tick = -100000,
		plan_fire = {},
		plan_k = {},
		-- Set once a SAM missile is on its way.
		sam_sid = 0,
		sam_fire_tick = 0,
		sam_hit_tick = 0,
		sam_k = 0,
	}
end

-- Ground tile under a missile flying from tile a to tile b (straight ground track on the flat map)
-- at fraction w of its flight, on a grid `W` tiles wide.

function SimNukes.install(C)
	function C:_init_nukes()
		self.nukes = {} :: { Nuke }
		self.nukes_launched = 0
		-- MIRVs launched this match (each one raises the next MIRV's price by Rules.MIRV_COST_STEP).
		self.mirvs_launched = 0
	end

	-- =========================================================================================
	-- Launch
	-- =========================================================================================

	-- Nuke intent. Returns true when a missile left a silo.
	function C:launch_nuke(id: number, kind_name: string, t: number): boolean
		local kind = Defs.nuke_kind_from_name(kind_name)
		if kind < 0 or kind == N_WARHEAD or kind == N_SHELL or t < 0 or t >= self.N then
			return false
		end
		-- the Arsenal's munitions need their unlock (SimArsenal)
		if not self:has_unlock(id, Defs.NUKE_UNLOCK[kind] or 0) then
			self:msg(id, Defs.MSG_INFO, string.format("Unlock the %s in the Arsenal first", nuke_title(kind)))
			return false
		end
		-- a strike (air strike, slug) leaves its own structure, takes no land and costs nothing
		local strike = Rules.NUKE_FLAT[kind] == true
		local tg = readi32(self.owner, t * 4)
		if tg == id then
			self:msg(
				id,
				Defs.MSG_INFO,
				if strike then "You can't strike your own land" else "You can't nuke your own land"
			)
			return false
		end
		if tg ~= 0 and self:allied(id, tg) then
			self:msg(
				id,
				Defs.MSG_INFO,
				if self:same_team(id, tg)
					then (if strike then "You can't strike a teammate" else "You can't nuke a teammate")
					else (if strike then "You can't strike an ally" else "You can't nuke an ally")
			)
			return false
		end
		-- Team games: no atom or hydrogen bomb with a teammate's
		-- structure inside its outer radius
		if self.team_mode and (kind == N_ATOM or kind == N_HYDROGEN) then
			local _, outer = self.R.nuke_radii(kind)
			local r = math.ceil(outer)
			local o2 = outer * outer
			for _, s in self:structs_in_box(t, r, r) do
				if s.owner ~= id and self:same_team(id, s.owner) and self.range_d2(t, s.tile) <= o2 then
					self:msg(id, Defs.MSG_INFO, "A teammate's building is too close")
					return false
				end
			end
		end
		local cost = Rules.nuke_cost(kind_name, self.mirvs_launched)
		if self.o_gold[id] < cost then
			self:msg(id, Defs.MSG_INFO, string.format("Not enough gold for %s", a_an(nuke_title(kind))))
			return false
		end
		-- Launch site: the nearest (manhattan) finished silo with a loaded missile. (A strike: the
		-- nearest loaded airfield within its reach, or railgun.)
		local geo_manhattan = self.geo_manhattan
		local launcher = Rules.NUKE_LAUNCHER[kind]
		local reload = Rules.RELOAD_TICKS[launcher]
		local reach = self.R.launch_range(kind)
		local reach2 = reach * reach
		local range_d2 = self.range_d2
		local silo = nil
		local bd = 0.0
		local out_of_reach = false
		for _, s in self:structs_of(id, launcher) do
			if not s.active or self:ready_missiles(s, reload) <= 0 then
				continue
			end
			if reach > 0 and range_d2(s.tile, t) > reach2 then
				out_of_reach = true
				continue
			end
			local d = geo_manhattan(s.tile, t)
			if silo == nil or d < bd then
				bd = d
				silo = s
			end
		end
		if silo == nil then
			local what = string.lower(Defs.STRUCT_TITLES[launcher])
			self:msg(
				id,
				Defs.MSG_INFO,
				if out_of_reach
					then string.format("That is out of your %s's reach", what)
					else string.format("No %s is ready", what)
			)
			return false
		end
		local tick = self.tick
		self.o_gold[id] -= cost
		table.insert(silo.shots, self:shot_stamp(silo))
		self:ev({ Ev.STRUCT_SHOTS, silo.sid, table.clone(silo.shots) })
		local arc = self.R.munition_arc(self.W, self.H, silo.tile, t, kind)
		local n = self:_spawn_nuke(kind, id, silo.tile, t, self.R.nuke_arc_ticks(arc, kind), arc)
		n.target_owner = tg
		if strike then
			self:msg(id, Defs.MSG_INFO, string.format("%s on its way to %s", nuke_title(kind), self:name_of(tg)))
			return true
		end
		self.nukes_launched += 1
		if kind == N_MIRV then
			self.mirvs_launched += 1
		elseif kind == N_SCATTER then
			self:_scatter_warheads(id, silo.tile, t, n.flight)
		end
		local o_name = self.o_name
		if tg ~= 0 then
			self:add_grudge(tg, id, Rules.NUKE_GRUDGE_TICKS)
			self.o_attacked_tick[tg] = tick
			self:msg(tg, Defs.MSG_ALERT, string.format("%s launched %s at you!", o_name[id], a_an(nuke_title(kind))))
		end
		self:msg(id, Defs.MSG_INFO, string.format("%s launched at %s", nuke_title(kind), self:name_of(tg)))
		if kind ~= N_ATOM then
			for _, h in self.humans do
				if h ~= tg and h ~= id then
					self:msg(
						h,
						Defs.MSG_ALERT,
						string.format("%s launched %s at %s", o_name[id], a_an(nuke_title(kind)), self:name_of(tg))
					)
				end
			end
		end
		if kind ~= N_MIRV then
			self:_break_nuked_alliances(id, t, kind)
		end
		self:_on_nuke_launched(id, tg, kind)
		return true
	end

	-- Alliance breaking: allies with at least nukeAllianceBreakThreshold weighted
	-- full-size tiles (inner radius 1, outer ring 0.5) inside the blast lose their alliance with the
	-- launcher.
	function C:_break_nuked_alliances(id: number, t: number, kind: number)
		if self.o_ally_count[id] <= 0 then
			return
		end
		local range_d2 = self.range_d2
		local inner, outer = self.R.nuke_radii(kind)
		local weight = {}
		local order = {}
		local inner2 = inner * inner
		local owner = self.owner
		for _, c in self:disk_tiles(t, outer, true) do
			local o = readi32(owner, c * 4)
			if o <= 0 or o == id or not self:has_alliance(id, o) then
				continue
			end
			local w = weight[o]
			if w == nil then
				w = 0.0
				table.insert(order, o)
			end
			weight[o] = w + (if range_d2(t, c) <= inner2 then 1.0 else 0.5)
		end
		for _, o in order do
			if weight[o] * self.R.K_AREA >= Rules.NUKE_ALLIANCE_BREAK_FULL then
				self:end_alliance(id, o, id)
			end
		end
	end

	-- Hook for the AI.
	function C:_on_nuke_launched(_id: number, _tg: number, _kind: number) end

	function C:_spawn_nuke(kind: number, id: number, from_tile: number, to_tile: number, flight: number, arc: any?): Nuke
		local tick = self.tick
		local n = Nuke.new()
		n.uid = self.next_uid
		self.next_uid += 1
		n.kind = kind
		n.owner = id
		n.from_tile = from_tile
		n.to_tile = to_tile
		n.launch_tick = tick
		n.flight = math.max(flight, 1)
		n.arc = arc or self.R.munition_arc(self.W, self.H, from_tile, to_tile, kind)
		n.target_owner = readi32(self.owner, to_tile * 4)
		table.insert(self.nukes, n)
		self:ev({ Ev.NUKE, n.uid, kind, id, from_tile, to_tile, tick, n.flight })
		return n
	end

	-- =========================================================================================
	-- Flight, interception, detonation
	-- =========================================================================================

	function C:nukes_tick()
		self:_sam_tick()
		local list = self.nukes
		local count = #list
		local tick = self.tick
		for i = 1, count do
			local n = list[i]
			if n.dead then
				continue
			end
			if n.sam_sid ~= 0 and tick >= n.sam_hit_tick and self:_sam_intercept(n) then
				continue
			end
			local age = tick - n.launch_tick
			if n.kind == N_MEGA and age > 0 and age < n.flight then
				local x, y = self.R.nuke_arc_at(n.arc, age / n.flight)
				self:_detonate(n, math.floor(y) * self.W + math.floor(x))
				Coop.check()
			end
			if age >= n.flight then
				n.dead = true
				if n.kind == N_MIRV then
					self:_split_mirv(n)
				elseif Rules.NUKE_FLAT[n.kind] then
					self:_strike(n) -- (a shell, an air strike, a slug: SimArsenal)
				else
					self:_detonate(n)
				end
				Coop.check() -- (a local match's step is spread over frames: Session._local_process)
			end
		end
		local w = 0
		local m = #list
		for i = 1, m do
			local n2 = list[i]
			if not n2.dead then
				w += 1
				list[w] = n2
			end
		end
		for i = m, w + 1, -1 do
			list[i] = nil
		end
	end

	-- SAM targeting: every non-friendly finished SAM plans, for each
	-- bomb or warhead it could reach, the latest tick to fire so its missile (12 full-size tiles per
	-- tick) meets the missile at the first trajectory tile that is inside the SAM's range and
	-- targetable (within 150 full-size tiles of the target or launch point); it fires on that tick if a
	-- missile is loaded (hydrogen bombs first, then targets nearest the SAM, then the most
	-- urgent). Always a hit.
	function C:_sam_tick()
		local list = self.nukes
		if #list == 0 then
			return
		end
		local tick = self.tick
		local structs = self.structs
		local geo_manhattan = self.geo_manhattan
		local K_LIN = self.R.K_LIN
		local sams = nil
		local fires = {}
		for _, n in list do
			if n.dead or n.sam_sid ~= 0 or Rules.NUKE_INTERCEPT_P[n.kind] <= 0 then
				continue
			end
			if tick >= n.cand_tick then
				if sams == nil then
					sams = {}
					for _, st in self.struct_list do
						if not st.dead and st.kind == S_SAM and st.active then
							table.insert(sams, st)
						end
					end
				end
				self:_sam_candidates(n, sams)
			end
			if #n.cands == 0 then
				continue
			end
			for _, sid in n.cands do
				local s = structs[sid]
				if s == nil or s.dead or not s.active or s.owner == n.owner or self:allied(s.owner, n.owner) then
					continue
				end
				local plan = n.plan_fire[sid]
				if plan == nil then
					plan = -3
				end
				if plan == -3 or (plan >= 0 and plan < tick) then
					self:_sam_plan(n, s)
					plan = n.plan_fire[sid]
				end
				if plan >= 0 and plan <= tick + 1 then
					local score = (if n.kind == N_HYDROGEN then 70001 else 0)
						+ math.max(0, 200000 - Defs.trunc(geo_manhattan(s.tile, n.to_tile) * K_LIN) * 1000)
						+ math.max(0, 10000 - (n.launch_tick + n.flight - tick) * 100)
					table.insert(fires, { score, n, s })
				end
			end
		end
		if #fires == 0 then
			return
		end
		-- Godot's sort_custom (unstable): equal scores end up in the Godot version's order.
		Defs.godot_sort(fires, function(a, b)
			return a[1] > b[1]
		end)
		for _, f in fires do
			local n2: Nuke = f[2]
			local s2 = f[3]
			if n2.sam_sid ~= 0 or self:ready_missiles(s2, Rules.SAM_COOLDOWN_TICKS) <= 0 then
				continue
			end
			table.insert(s2.shots, tick)
			self:ev({ Ev.STRUCT_SHOTS, s2.sid, table.clone(s2.shots) })
			local k = n2.plan_k[s2.sid]
			local t = n2.traj[k + 1]
			n2.sam_sid = s2.sid
			n2.sam_k = k
			n2.sam_fire_tick = tick
			n2.sam_hit_tick = tick + self:_sam_ticks_to(s2.tile, t)
			self:ev({ Ev.SAM_LAUNCH, s2.sid, n2.uid, tick, n2.sam_hit_tick, true })
		end
	end

	-- SAMs that might reach `n`: within max SAM range + the targetable zone of its target or
	-- launch.
	function C:_sam_candidates(n: Nuke, sams)
		n.cand_tick = self.tick + 30
		table.clear(n.plan_fire)
		table.clear(n.plan_k)
		local cands = {}
		n.cands = cands
		local range_d2 = self.range_d2
		local K_LIN = self.R.K_LIN
		local reach = Rules.SAM_MAX_RANGE_FULL / K_LIN + Rules.NUKE_TARGETABLE_FULL / K_LIN
		local r2 = reach * reach
		for _, s in sams do
			if s.owner == n.owner then
				continue
			end
			if range_d2(s.tile, n.to_tile) <= r2 or range_d2(s.tile, n.from_tile) <= r2 then
				table.insert(cands, s.sid)
			end
		end
		if #cands > 0 and #n.traj == 0 then
			-- the tile under the nuke on each tick of its flight, along its arc (Rules.nuke_arc: the
			-- curve the renderer draws)
			local W, H = self.W, self.H
			local R = self.R
			local arc = n.arc or R.munition_arc(W, H, n.from_tile, n.to_tile, n.kind)
			n.arc = arc
			local flight = n.flight
			local traj = table.create(flight + 1)
			for k = 0, flight do
				local x, y = R.nuke_arc_at(arc, k / flight)
				traj[k + 1] = math.clamp(math.floor(y), 0, H - 1) * W + math.clamp(math.floor(x), 0, W - 1)
			end
			n.traj = traj
		end
	end

	-- Ticks a SAM missile needs from `from` to `to` (manhattan full-size tiles / 12, rounded up).
	function C:_sam_ticks_to(from: number, to: number): number
		return math.ceil(self.geo_manhattan(from, to) * self.R.K_LIN / Rules.SAM_MISSILE_SPEED_FULL)
	end

	-- Interception tile: the first future trajectory tile in range and targetable that the
	-- SAM's missile can reach in time (or the tile before detonation when the target is in range).
	function C:_sam_plan(n: Nuke, s)
		local tick = self.tick
		local traj = n.traj
		local sid = s.sid
		local cur = tick - n.launch_tick
		local last = n.flight
		local R = self.R
		local range_d2 = self.range_d2
		local zone = Rules.NUKE_TARGETABLE_FULL / R.K_LIN
		local z2 = zone * zone
		local rmax = Rules.SAM_MAX_RANGE_FULL / R.K_LIN
		local rmax2 = rmax * rmax
		local inc = 0
		local lastd = -1.0
		for k = math.max(cur, 0), last - 1 do
			local t = traj[k + 1]
			local d = range_d2(s.tile, t)
			inc = if lastd >= 0.0 and d > lastd then inc + 1 else 0
			lastd = d
			local nt = k - cur
			local rr = R.sam_range_at(s.level, tick + nt - s.up_tick)
			if d <= rr * rr and (range_d2(n.to_tile, t) < z2 or range_d2(n.from_tile, t) < z2) then
				local st = self:_sam_ticks_to(s.tile, t)
				if nt >= st then
					n.plan_fire[sid] = tick + nt - st
					n.plan_k[sid] = k
					return
				end
			end
			if inc > 3 and d > rmax2 then
				break
			end
		end
		local kf = last - 1
		if kf >= cur then
			local rf = R.sam_range_at(s.level, tick + (last - cur) - s.up_tick)
			if range_d2(s.tile, n.to_tile) <= rf * rf then
				local st2 = self:_sam_ticks_to(s.tile, traj[kf + 1])
				if kf - cur >= st2 then
					n.plan_fire[sid] = tick + kf - cur - st2
					n.plan_k[sid] = kf
					return
				end
			end
		end
		n.plan_fire[sid] = -1
	end

	-- A SAM missile arriving: the bomb / warhead is destroyed (BOOM radius 0 at the ground
	-- tile under the intercept point) unless the SAM was lost meanwhile (then the target is free
	-- again).
	function C:_sam_intercept(n: Nuke): boolean
		local s = self.structs[n.sam_sid]
		if s == nil or s.dead or s.owner == n.owner then
			n.sam_sid = 0
			n.cand_tick = self.tick
			return false
		end
		n.dead = true
		self:ev({ Ev.BOOM, n.uid, n.kind, n.traj[n.sam_k + 1], 0, n.owner })
		if n.kind ~= N_WARHEAD then
			self:msg(
				s.owner,
				Defs.MSG_GOOD,
				string.format("Your SAM shot down %s from %s", a_an(nuke_title(n.kind)), self.o_name[n.owner])
			)
			self:msg(
				n.owner,
				Defs.MSG_BAD,
				string.format("Your %s was intercepted by %s", nuke_title(n.kind), self.o_name[s.owner])
			)
		end
		return true
	end

	-- Snapshot rows of SAM missiles in flight: [sam_sid, nuke_uid, fire_tick, intercept_tick, true].
	function C:sam_rows(): { { any } }
		local out = {}
		for _, n in self.nukes do
			if not n.dead and n.sam_sid ~= 0 then
				table.insert(out, { n.sam_sid, n.uid, n.sam_fire_tick, n.sam_hit_tick, true })
			end
		end
		return out
	end

	-- Missiles a SAM or silo can fire now: `level` minus those still reloading (each launch or
	-- upgrade reloads for `cooldown` ticks — a queue of missile timers).
	function C:ready_missiles(s, cooldown: number): number
		local shots = s.shots
		local n = #shots
		local tick = self.tick
		local k = 0
		while k < n and shots[k + 1] + cooldown <= tick do
			k += 1
		end
		if k > 0 then
			s.shots = table.move(shots, k + 1, n, 1, {})
		end
		return s.level - #s.shots
	end

	-- MIRV split: up to MIRV_WARHEADS warheads, aimed at the target's land within MIRV_SPREAD
	-- of the aim point and at least 55 full-size tiles (manhattan) apart, leave the bus when it arrives.
	function C:_split_mirv(n: Nuke)
		self:ev({ Ev.BOOM, n.uid, n.kind, n.to_tile, -1, n.owner })
		local tg = n.target_owner
		if tg > 0 and self:allied(n.owner, tg) then
			self:end_alliance(n.owner, tg, n.owner)
		end
		local R = self.R
		local W = self.W
		local range_d2 = self.range_d2
		local geo_manhattan = self.geo_manhattan
		local spread2 = R.MIRV_SPREAD * R.MIRV_SPREAD
		local gap = math.ceil(55.0 / R.K_LIN)
		local grid = {}
		local targets = { n.to_tile }
		SimNukes._mirv_mark(grid, W, n.to_tile, gap)
		local map = self.map
		local land_list = map.land_list
		local nlt = map.land_count
		local owner = self.owner
		local rng = self.rng
		local max_w = Rules.MIRV_WARHEADS
		for _ = 1, 8000 do
			if #targets >= max_w then
				break
			end
			local c = readi32(land_list, (rng:randi() % nlt) * 4)
			if readi32(owner, c * 4) ~= tg or tg == 0 or range_d2(n.to_tile, c) > spread2 then
				continue
			end
			if SimNukes._mirv_overlaps(grid, W, c, gap, geo_manhattan) then
				continue
			end
			table.insert(targets, c)
			SimNukes._mirv_mark(grid, W, c, gap)
		end
		for _, t in targets do
			local arc = R.nuke_arc(self.W, self.H, n.to_tile, t)
			local flight = R.nuke_arc_ticks(arc, N_WARHEAD) + rng:randi_range(0, 15)
			self:_spawn_nuke(N_WARHEAD, n.owner, n.to_tile, t, flight, arc).target_owner = tg
		end
	end

	-- Detonation: every tile of the inner radius and half of the outer ring (at
	-- random) is relinquished and left as fallout; each hit owner loses troops per full-size tile by
	-- nukeDeathFactor (its attacks and transports too), and every unit and structure inside the
	-- outer radius is destroyed.
	function C:_detonate(n: Nuke, sweep_tile: number?)
		local range_d2 = self.range_d2
		local inner, radius = self.R.nuke_radii(n.kind)
		local to = sweep_tile or n.to_tile
		local sweep = sweep_tile ~= nil
		if sweep then
			radius = self.R.BIJUDAMA_SWEEP_RADIUS
			inner = radius
		end
		local inner2 = inner * inner
		local tiles = self:disk_tiles(to, radius, true)
		local lost = {}
		local before = {}
		local order = {}
		local owner = self.owner
		local flags = self.flags
		local d_flags = self.d_flags
		local o_tiles = self.o_tiles
		local rng = self.rng
		for _, t in tiles do
			if range_d2(to, t) > inner2 and rng:randi() % 2 == 0 then
				continue
			end
			local o = readi32(owner, t * 4)
			if sweep and o ~= 0 and (o == n.owner or self:allied(n.owner, o)) then
				continue
			end
			if o ~= 0 then
				if before[o] == nil then
					before[o] = o_tiles[o]
					lost[o] = 0
					table.insert(order, o)
				end
				lost[o] += 1
				self:set_owner(t, 0)
			end
			local f = readu8(flags, t)
			if bit32.band(f, F_FALLOUT) == 0 then
				f = bit32.bor(f, F_FALLOUT)
				writeu8(flags, t, f)
				table.insert(d_flags, t * 256 + f)
				self.fallout_count += 1
			end
		end
		local o_killer = self.o_killer
		for _, o in order do
			self:_nuke_troops(o, n.kind, lost[o], before[o])
			if o_tiles[o] <= 0 then
				o_killer[o] = n.owner
			end
			if o ~= n.owner then
				self:add_grudge(o, n.owner, Rules.NUKE_GRUDGE_TICKS)
			end
		end
		-- Structures and units inside the outer radius are destroyed.
		local r = math.ceil(radius)
		local r2 = radius * radius
		local o_name = self.o_name
		for _, s in self:structs_in_box(to, self.geo_span(to, radius), r) do
			if not s.dead and range_d2(to, s.tile) <= r2
				and (not sweep or (s.owner ~= n.owner and not self:allied(n.owner, s.owner))) then
				local so = s.owner
				self:destroy_struct(s)
				if so ~= n.owner then
					self:msg(
						so,
						Defs.MSG_BAD,
						string.format("%s destroyed your %s", o_name[n.owner], Defs.STRUCT_TITLES[s.kind])
					)
				end
			end
		end
		for _, u in self.unit_list do
			if u.dead then
				continue
			end
			local ut = self:unit_tile(u)
			if ut >= 0 and range_d2(to, ut) <= r2
				and (not sweep or (u.owner ~= n.owner and not self:allied(n.owner, u.owner))) then
				self:remove_unit(u, Defs.DEL_DESTROYED)
			end
		end
		if sweep then return end
		self:ev({ Ev.BOOM, n.uid, n.kind, to, r, n.owner })
		local victim = n.target_owner
		if victim > 0 and n.kind ~= N_WARHEAD then
			self:msg(
				victim,
				Defs.MSG_BAD,
				string.format("%s from %s hit your land", cap_first(a_an(nuke_title(n.kind))), o_name[n.owner])
			)
		end
		if n.kind == N_HYDROGEN then
			self:msg_others(
				victim,
				Defs.MSG_INFO,
				string.format("Planetary Devastation collapsed over %s", self:name_of(victim))
			)
		end
	end

	-- nukeDeathFactor applied once per full-size tile lost: bombs remove 5 x troops / tiles left each
	-- time (so troops shrink by ((T - n) / T)^5), warheads 500 x (1 - e^(-2 excess / max)).
	function C:_nuke_troops(o: number, kind: number, n_lost: number, tiles_before: number)
		local cap = math.max(self.o_cap[o], 1.0)
		local o_troops = self.o_troops
		local dbg_flow = self.dbg_flow
		if kind ~= N_WARHEAD then
			local f = (math.max(0.0, tiles_before - n_lost) / math.max(tiles_before, 1)) ^ 5.0
			dbg_flow[o * 5 + 3] += o_troops[o] * (1.0 - f)
			o_troops[o] *= f
			for _, a in self.attacks do
				if not a.dead and a.attacker == o then
					a.troops *= f
				end
			end
			for _, u in self.unit_list do
				if not u.dead and u.owner == o and u.kind == U_TRANSPORT then
					u.troops *= f
				end
			end
			return
		end
		local k = self.R.K_AREA
		local warhead_death = Rules.warhead_death
		for _ = 1, n_lost do
			local d = math.min(k * warhead_death(o_troops[o], cap), math.max(0.0, o_troops[o] - 0.03 * cap))
			dbg_flow[o * 5 + 3] += d
			o_troops[o] -= d
		end
		for _, a in self.attacks do
			if not a.dead and a.attacker == o then
				for _ = 1, n_lost do
					a.troops -= math.min(k * warhead_death(a.troops, cap), math.max(0.0, a.troops - 0.03 * cap))
				end
			end
		end
		for _, u in self.unit_list do
			if not u.dead and u.owner == o and u.kind == U_TRANSPORT then
				for _ = 1, n_lost do
					u.troops -= math.min(k * warhead_death(u.troops, cap), math.max(0.0, u.troops - 0.03 * cap))
				end
			end
		end
	end

	function C:nuke_rows(): { { number } }
		local out = {}
		for _, n in self.nukes do
			if not n.dead then
				table.insert(out, { n.uid, n.kind, n.owner, n.from_tile, n.to_tile, n.launch_tick, n.flight })
			end
		end
		return out
	end
end

function SimNukes._mirv_mark(grid: { [number]: { number } }, W: number, t: number, gap: number)
	local k = ((t // W) // gap) * 65536 + ((t % W) // gap)
	local cell = grid[k]
	if cell == nil then
		cell = {}
		grid[k] = cell
	end
	table.insert(cell, t)
end

function SimNukes._mirv_overlaps(
	grid: { [number]: { number } },
	W: number,
	t: number,
	gap: number,
	geo_manhattan: (number, number) -> number
): boolean
	local gx = (t % W) // gap
	local gy = (t // W) // gap
	for dy = -1, 1 do
		for dx = -1, 1 do
			if gx + dx < 0 or gy + dy < 0 then
				continue
			end
			local cell = grid[(gy + dy) * 65536 + (gx + dx)]
			if cell == nil then
				continue
			end
			for _, o in cell do
				if geo_manhattan(o, t) < gap then
					return true
				end
			end
		end
	end
	return false
end

return SimNukes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">SimState</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/sim_state.gd: base of the Sim class chain
-- (SimState → SimAttacks → SimStructures → SimNaval → SimWarships → SimNukes → Sim), installed as a
-- mixin into the single Sim class table (see Sim.luau / build/notes/sim-core.md).
-- Holds every piece of mutable match state in flat arrays so the hot loops can read and write them
-- directly. Owns tile ownership changes, per-owner border lists, delta/event buffers and diplomacy.
--
-- Representation: per-tile arrays are buffers (owner/struct_at/bnext/bprev: i32 at t*4;
-- flags/def_cover/in_border: u8 at t; land/terr/coast are the map's read-only u8 buffers);
-- per-owner arrays are Luau tables keyed by owner id 0..MAXO-1 (o_scount & co. by
-- id*STRUCT_KINDS+kind); lists are 1-based arrays.
--
-- Geometry: the map's flat grid (no wrap). The instance carries its map's size (self.W / self.H /
-- self.N) and metrics (self.dist2 / range_d2 / geo_manhattan / geo_span / gc_dist, closures from
-- WorldMap — call them without ':'), and its map's scaled rules in self.R (Rules.for_map).
-- Neighbour order everywhere: west, east, north, south (tiles outside the map are skipped).
local Defs = require("./Defs")
local Ev = require("./Ev")
local Rules = require("./Rules")
local Rng = require("./Rng")
local Coop = require("../Net/Coop")

local MAXO = Defs.MAX_OWNERS
local STRUCT_KINDS = 16
local F_FALLOUT = Defs.F_FALLOUT

local readi32 = buffer.readi32
local writei32 = buffer.writei32
local readu8 = buffer.readu8
local writeu8 = buffer.writeu8

local SimState = {}
SimState.MAXO = MAXO
SimState.STRUCT_KINDS = STRUCT_KINDS

--- A table with keys 0..n-1 set to `v` (per-owner arrays; index 0 exists like a Packed array).
local function filled(n: number, v: any): { [number]: any }
	local t = table.create(n, v)
	t[0] = v
	return t
end
SimState.filled = filled

function SimState.pair_key(a: number, b: number): number
	if a < b then
		return a * 1024 + b
	end
	return b * 1024 + a
end
local pair_key = SimState.pair_key

--- "an Atom Bomb", "a City": indefinite article + word.
function SimState.a_an(word: string): string
	if word == "" then
		return word
	end
	local c = string.sub(word, 1, 1)
	if string.find("AEIOUaeiou", c, 1, true) then
		return "an " .. word
	end
	return "a " .. word
end

function SimState.cap_first(text: string): string
	if text == "" then
		return text
	end
	return string.upper(string.sub(text, 1, 1)) .. string.sub(text, 2)
end

-- =============================================================================================
-- Border list primitives (module-level for speed; also installed as methods)
-- =============================================================================================

local function _is_border(self: any, t: number, o: number): boolean
	local land = self.land
	local owner = self.owner
	local W = self.W
	local x = t % W
	local n
	if x > 0 then
		n = t - 1
		if readu8(land, n) == 1 and readi32(owner, n * 4) ~= o then
			return true
		end
	end
	if x < W - 1 then
		n = t + 1
		if readu8(land, n) == 1 and readi32(owner, n * 4) ~= o then
			return true
		end
	end
	if t >= W then
		n = t - W
		if readu8(land, n) == 1 and readi32(owner, n * 4) ~= o then
			return true
		end
	end
	if t < self.N - W then
		n = t + W
		if readu8(land, n) == 1 and readi32(owner, n * 4) ~= o then
			return true
		end
	end
	return false
end

local function _badd(self: any, t: number, o: number)
	writeu8(self.in_border, t, 1)
	local bhead = self.bhead
	local h = bhead[o]
	local bnext = self.bnext
	local bprev = self.bprev
	writei32(bnext, t * 4, h)
	writei32(bprev, t * 4, -1)
	if h ~= -1 then
		writei32(bprev, h * 4, t)
	end
	bhead[o] = t
	self.bcount[o] += 1
end

local function _bremove(self: any, t: number, o: number)
	writeu8(self.in_border, t, 0)
	local bnext = self.bnext
	local bprev = self.bprev
	local p = readi32(bprev, t * 4)
	local nx = readi32(bnext, t * 4)
	if p ~= -1 then
		writei32(bnext, p * 4, nx)
	else
		self.bhead[o] = nx
	end
	if nx ~= -1 then
		writei32(bprev, nx * 4, p)
	end
	self.bcount[o] -= 1
end

local function _cadd(self: any, t: number, o: number)
	local chead = self.chead
	local h = chead[o]
	self.cnext[t] = h
	self.cprev[t] = -1
	if h ~= -1 then
		self.cprev[h] = t
	end
	chead[o] = t
end

local function _cremove(self: any, t: number, o: number)
	local cnext = self.cnext
	local cprev = self.cprev
	local p = cprev[t]
	local nx = cnext[t]
	if p == nil then
		return
	end
	if p ~= -1 then
		cnext[p] = nx
	else
		self.chead[o] = nx
	end
	if nx ~= -1 then
		cprev[nx] = p
	end
	cnext[t] = nil
	cprev[t] = nil
end

local function _touch(self: any, n: number, old: number, nw: number)
	if readu8(self.land, n) == 0 then
		return
	end
	local on = readi32(self.owner, n * 4)
	if on == 0 then
		return
	end
	if on == nw then
		if readu8(self.in_border, n) == 1 and not _is_border(self, n, nw) then
			_bremove(self, n, nw)
		end
	elseif on == old then
		if readu8(self.in_border, n) == 0 then
			_badd(self, n, old)
		end
	end
end

--- Changes the owner of tile `t`, maintaining counts, border lists, deltas and structures.
local function set_owner(self: any, t: number, nw: number)
	local owner = self.owner
	local old = readi32(owner, t * 4)
	if old == nw then
		return
	end
	writei32(owner, t * 4, nw)
	local d_tiles = self.d_tiles
	d_tiles[#d_tiles + 1] = t * 1024 + nw
	local is_coast = readu8(self.coast, t) == 1
	local W = self.W
	local tx = t % W
	local ty = (t - tx) // W
	local o_tiles = self.o_tiles
	if old ~= 0 then
		self.o_cx[old] -= tx
		self.o_cy[old] -= ty
		o_tiles[old] -= 1
		if is_coast then
			self.o_coast[old] -= 1
			_cremove(self, t, old)
		end
		if readu8(self.in_border, t) == 1 then
			_bremove(self, t, old)
		end
		if o_tiles[old] <= 0 then
			local po = self.pending_out
			po[#po + 1] = old
			self.o_killer[old] = nw
		end
	end
	if nw ~= 0 then
		local flags = self.flags
		local f = readu8(flags, t)
		if bit32.band(f, F_FALLOUT) ~= 0 then
			f = bit32.band(f, 0xFE)
			writeu8(flags, t, f)
			local d_flags = self.d_flags
			d_flags[#d_flags + 1] = t * 256 + f
			self.fallout_count -= 1
		end
		self.o_cx[nw] += tx
		self.o_cy[nw] += ty
		o_tiles[nw] += 1
		if is_coast then
			self.o_coast[nw] += 1
			self.o_coast_tile[nw] = t
			_cadd(self, t, nw)
		end
		if _is_border(self, t, nw) then
			_badd(self, t, nw)
		end
	end
	if tx > 0 then
		_touch(self, t - 1, old, nw)
	end
	if tx < W - 1 then
		_touch(self, t + 1, old, nw)
	end
	if t >= W then
		_touch(self, t - W, old, nw)
	end
	if t < self.N - W then
		_touch(self, t + W, old, nw)
	end
	if readi32(self.struct_at, t * 4) ~= 0 then
		self:_struct_tile_changed(t, old, nw)
	end
end

--- True if `id` owns a 4-neighbour of `t`.
local function touches(self: any, t: number, id: number): boolean
	local owner = self.owner
	local W = self.W
	local x = t % W
	if x > 0 and readi32(owner, (t - 1) * 4) == id then
		return true
	end
	if x < W - 1 and readi32(owner, (t + 1) * 4) == id then
		return true
	end
	if t >= W and readi32(owner, (t - W) * 4) == id then
		return true
	end
	if t < self.N - W and readi32(owner, (t + W) * 4) == id then
		return true
	end
	return false
end

SimState.set_owner = set_owner
SimState.touches = touches
SimState._is_border = _is_border
SimState._badd = _badd
SimState._bremove = _bremove
SimState._touch = _touch

-- =============================================================================================
-- Install
-- =============================================================================================

function SimState.install(C: any)
	C.MAXO = MAXO
	C.STRUCT_KINDS = STRUCT_KINDS
	C.pair_key = SimState.pair_key
	C.a_an = SimState.a_an
	C.cap_first = SimState.cap_first

	--- Initialises every SimState member (GDScript declarations + _init_state).
	function C._init_state(self: any, world: any)
		self.map = world
		-- Grid size, metrics (closures: self.range_d2(a, b), no ':') and scaled rules of the map.
		self.W = world.W
		self.H = world.H
		self.N = world.N
		self.dist2 = world.dist2
		self.range_d2 = world.range_d2
		self.geo_manhattan = world.geo_manhattan
		self.geo_span = world.geo_span
		self.gc_dist = world.gc_dist
		self.R = Rules.for_map(world)
		local N = world.N
		if self.rng == nil then
			self.rng = Rng.new(0)
		end
		self.tick = 0
		self.phase = Defs.PHASE_SPAWN
		if self.difficulty == nil then
			self.difficulty = 1
		end
		if self.max_humans == nil then
			self.max_humans = 0
		end
		--- Tick at which PLAYING started (-1 before that).
		self.playing_since = -1
		--- Land tiles carrying fallout (fallout stays until the land is conquered again).
		self.fallout_count = 0
		--- Diagnostics (bench only): troops spent / lost per owner, reset by the reader.
		--- [id*5+0] attacks launched, +1 boats launched, +2 lost defending, +3 lost to nukes, +4 refunded
		self.dbg_flow = filled(MAXO * 5, 0.0)

		-- tiles
		self.owner = buffer.create(N * 4)
		self.flags = buffer.create(N)
		--- 1 for contestable land (the map's buffer, read-only).
		self.land = world.land
		self.terr = world.terrain -- read-only alias (GDScript kept a private copy)
		Coop.check()
		--- Structure id standing on the tile (0 = none).
		self.struct_at = buffer.create(N * 4)
		--- Number of defense posts (any owner) covering the tile.
		self.def_cover = buffer.create(N)

		-- per-owner border lists (intrusive doubly linked lists over tile indices)
		Coop.check()
		self.in_border = buffer.create(N)
		self.bnext = buffer.create(N * 4)
		self.bprev = buffer.create(N * 4)
		self.bhead = filled(MAXO, -1)
		self.bcount = filled(MAXO, 0)

		Coop.check()
		-- owners (indexed by owner id)
		self.owner_total = 0
		self.o_name = filled(MAXO, "")
		self.o_color = filled(MAXO, 0)
		self.o_kind = filled(MAXO, 0)
		self.o_alive = filled(MAXO, 0)
		self.o_spawned = filled(MAXO, 0)
		--- 1 when the AI drives this owner (nations and tribes).
		self.o_ai = filled(MAXO, 0)
		--- 1 = a bot player: an AI commander that plays (and looks) like a human (public-match fill)
		self.o_bot = filled(MAXO, 0)
		--- Team games (Core/Teams): the owner's team, 1..#team_names; 0 = none (every owner outside a
		--- team game, and tribes in one). Sent as OWNER_ADD's last field.
		self.o_team = filled(MAXO, 0)
		--- Per-owner AI difficulty (-1: the match's). Novice bot players play at 0 with Easy nation
		--- troop numbers; see Sim.ai_difficulty / Sim.add_bot_players.
		self.o_skill = filled(MAXO, -1)
		--- 1 for humans that left the match (their nation stays, passive).
		self.o_left = filled(MAXO, 0)
		self.o_tiles = filled(MAXO, 0)
		self.o_troops = filled(MAXO, 0.0)
		self.o_gold = filled(MAXO, 0.0)
		self.o_cap = filled(MAXO, 0.0)
		--- Passive income per second.
		self.o_income = filled(MAXO, 0.0)
		--- Smoothed per-second income from trade ships and trucks.
		self.o_bonus_rate = filled(MAXO, 0.0)
		self.o_bonus_acc = filled(MAXO, 0.0)
		self.o_traitor_until = filled(MAXO, 0)
		--- The tick a person's spawn shield ends (Rules.SPAWN_SHIELD_TICKS; 0 = none).
		self.o_shield_until = filled(MAXO, 0)
		self.o_spawn_tile = filled(MAXO, -1)
		self.o_killer = filled(MAXO, 0)
		--- Owners whose conquest (Ev.CONQUEST, Sim._conquest_gold) was already announced.
		self._conquest_sent = {} :: { [number]: boolean }
		--- Structure counts: o_scount[id * STRUCT_KINDS + kind].
		self.o_scount = filled(MAXO * STRUCT_KINDS, 0)
		--- Level sums of owned structures (one under construction counts 1) and of finished ones only.
		self.o_slevel = filled(MAXO * STRUCT_KINDS, 0)
		self.o_alevel = filled(MAXO * STRUCT_KINDS, 0)
		--- Structures built + levels added per owner (see cost_count); slot
		--- Rules.BUILT_WARSHIP counts warships.
		self.o_built = filled(MAXO * STRUCT_KINDS, 0)
		self.o_warships = filled(MAXO, 0)
		self.o_boats = filled(MAXO, 0)
		--- Tick of the last attack against this owner (by anyone) — AI threat sensing.
		self.o_attacked_tick = filled(MAXO, -100000)
		--- Owned coastal tiles and the most recently gained one (may be stale; validate before use).
		self.o_coast = filled(MAXO, 0)
		self.o_coast_tile = filled(MAXO, -1)
		--- Every owner's coastal tiles as a linked list (the shore border tiles): head per
		--- owner, next / previous tile keyed by tile (-1 ends the list). See coast_tiles().
		self.chead = filled(MAXO, -1)
		self.cnext = {} :: { [number]: number }
		self.cprev = {} :: { [number]: number }
		self.human_keys = {} :: { [string]: number }
		self.humans = {} :: { number }

		-- diplomacy
		--- key = min*1024+max → true
		self.alliances = {} :: { [number]: boolean }
		--- key = min*1024+max → expiry tick (formed / last renewed + Rules.ALLIANCE_TICKS)
		self.ally_expires = {} :: { [number]: number }
		--- key = min*1024+max → renewal asked: bit 1 by the lower id, bit 2 by the higher id
		self.ally_ext = {} :: { [number]: number }
		self.o_ally_count = filled(MAXO, 0)
		--- key = from*1024+to → tick the request was made
		self.requests = {} :: { [number]: number }
		--- key = from*1024+to → when the last answered or expired request was made
		--- (past outgoing requests, for the request cooldown)
		self.req_last = {} :: { [number]: number }
		--- Insertion sequence numbers of alliances / requests (GDScript Dictionaries iterate in
		--- insertion order: allies_of() and request expiry follow formation / request order).
		self._ally_seq = {} :: { [number]: number }
		self._req_seq = {} :: { [number]: number }
		self._seq = 0
		--- key = a*1024+b → tick until which a is hostile towards b (b attacked or nuked a)
		self.grudge = {} :: { [number]: number }

		-- delta buffers
		self.d_tiles = {} :: { number }
		self.d_flags = {} :: { number }
		self.d_ev = {} :: { { any } }
		self.pending_out = {} :: { number }

		-- border scan results (see scan_border)
		self.sc_list = {} :: { number }
		self.sc_count = filled(MAXO, 0)
		self.sc_tile = filled(MAXO, 0)
		self.sc_neutral = 0
		self.sc_neutral_tile = -1
		--- Unowned fallout land touching the scanned border (one sample tile).
		self.sc_fallout_tile = -1
		self.sc_cursor = filled(MAXO, -1)
		self.coast = world.coastal
		--- Sums of the owned tiles' x and y per owner (territory centroid, maintained by set_owner).
		self.o_cx = filled(MAXO, 0.0)
		self.o_cy = filled(MAXO, 0.0)
	end

	-- =========================================================================================
	-- Events
	-- =========================================================================================

	function C.ev(self: any, e: { any })
		local d = self.d_ev
		d[#d + 1] = e
	end

	--- Queues a MSG event; only emitted for humans (or everyone with to = -1) to keep deltas small.
	function C.msg(self: any, to: number, category: number, text: string)
		if to == -1 or (to > 0 and self.o_kind[to] == Defs.KIND_HUMAN and self.o_left[to] == 0) then
			local d = self.d_ev
			d[#d + 1] = { Ev.MSG, to, category, text }
		end
	end

	--- MSG to every present human except `except_id` (who usually gets a personal message).
	function C.msg_others(self: any, except_id: number, category: number, text: string)
		for _, h in self.humans do
			if h ~= except_id then
				self:msg(h, category, text)
			end
		end
	end

	--- True when world news about owners `a`/`b` (either may be 0) concerns human `h`: it is one of
	--- them, allied or bordering with one of them, or one of them is a top-5 owner.
	function C.news_relevant(self: any, h: number, a: number, b: number, top: { number }): boolean
		for k = 1, 2 do
			local x = if k == 1 then a else b
			if x <= 0 then
				continue
			end
			if x == h or self:allied(h, x) or table.find(top, x) ~= nil or self:borders(h, x) then
				return true
			end
		end
		return false
	end

	--- The (up to) `count` (default 5) owners holding the most land (1-based array).
	function C.top_owners(self: any, count: number?): { number }
		local cnt = count or 5
		local ids = {}
		local vals = {}
		local o_alive = self.o_alive
		local o_tiles = self.o_tiles
		for id = 1, self.owner_total do
			if o_alive[id] == 0 then
				continue
			end
			local v = o_tiles[id]
			local i = #ids
			while i > 0 and vals[i] < v do
				i -= 1
			end
			if i < cnt then
				table.insert(ids, i + 1, id)
				table.insert(vals, i + 1, v)
				if #ids > cnt then
					ids[#ids] = nil
					vals[#vals] = nil
				end
			end
		end
		return ids
	end

	--- True when `a` owns a tile touching land of `b` (walks a's border list).
	function C.borders(self: any, a: number, b: number): boolean
		if a <= 0 or b <= 0 or self.o_tiles[a] <= 0 or self.o_tiles[b] <= 0 then
			return false
		end
		local owner = self.owner
		local bnext = self.bnext
		local W = self.W
		local NW = self.N - W
		local t = self.bhead[a]
		while t ~= -1 do
			local x = t % W
			if x > 0 and readi32(owner, (t - 1) * 4) == b then
				return true
			end
			if x < W - 1 and readi32(owner, (t + 1) * 4) == b then
				return true
			end
			if t >= W and readi32(owner, (t - W) * 4) == b then
				return true
			end
			if t < NW and readi32(owner, (t + W) * 4) == b then
				return true
			end
			t = readi32(bnext, t * 4)
		end
		return false
	end

	function C.is_human(self: any, id: number): boolean
		return id > 0 and self.o_kind[id] == Defs.KIND_HUMAN
	end

	function C.name_of(self: any, id: number): string
		if id <= 0 then
			return "Unclaimed land"
		end
		return self.o_name[id]
	end

	-- =========================================================================================
	-- Owners
	-- =========================================================================================

	function C.add_owner(self: any, p_name: string, color: number, kind: number): number
		if self.owner_total >= MAXO - 1 then
			return 0
		end
		self.owner_total += 1
		local id = self.owner_total
		self.o_name[id] = p_name
		self.o_color[id] = color
		self.o_kind[id] = kind
		self.o_alive[id] = 1
		self.o_ai[id] = if kind ~= Defs.KIND_HUMAN then 1 else 0
		self.o_gold[id] = Rules.START_GOLD
		self:ev({ Ev.OWNER_ADD, id, p_name, color, kind, 0 })
		return id
	end

	--- Changes an owner's colour mid-match (re-sends OWNER_ADD; the mirror updates in place).
	function C.set_owner_color(self: any, id: number, color: number)
		if id <= 0 or id > self.owner_total or self.o_color[id] == color then
			return
		end
		self.o_color[id] = color
		self:ev({ Ev.OWNER_ADD, id, self.o_name[id], color, self.o_kind[id], self.o_team[id] })
	end

	function C.struct_count(self: any, id: number, kind: number): number
		return self.o_scount[id * STRUCT_KINDS + kind]
	end

	function C.is_traitor(self: any, id: number): boolean
		return id > 0 and self.o_traitor_until[id] > self.tick
	end

	--- No one may attack `id` yet (its spawn shield: Rules.SPAWN_SHIELD_TICKS).
	function C.shielded(self: any, id: number): boolean
		return id > 0 and self.o_shield_until[id] > self.tick
	end

	--- What an attack on shielded `id` tells its sender.
	function C.shield_text(self: any, id: number): string
		local s = math.max(1, math.ceil((self.o_shield_until[id] - self.tick) / Rules.TICK_RATE))
		return string.format("%s just spawned: you can attack them in %d s", self.o_name[id], s)
	end

	function C.land_share(self: any, id: number): number
		return self.o_tiles[id] / math.max(self.map.contestable_count, 1)
	end

	-- =========================================================================================
	-- Tile ownership and border lists
	-- =========================================================================================

	C.set_owner = set_owner
	C.touches = touches
	C._touch = _touch
	C._is_border = _is_border
	C._badd = _badd
	C._bremove = _bremove

	--- Overridden by SimStructures: a structure's tile changed hands.
	function C._struct_tile_changed(_self: any, _t: number, _old: number, _nw: number) end

	--- True when tile `t` is contestable, not fallout and may be claimed.
	function C.claimable(self: any, t: number): boolean
		return readu8(self.land, t) == 1 and bit32.band(readu8(self.flags, t), F_FALLOUT) == 0
	end

	-- =========================================================================================
	-- Border scan (AI perception)
	-- =========================================================================================

	local function _scan_nb(self: any, id: number, n: number)
		if readu8(self.land, n) == 0 then
			return
		end
		local on = readi32(self.owner, n * 4)
		if on == id then
			return
		end
		if on == 0 then
			if bit32.band(readu8(self.flags, n), 1) == 0 then
				self.sc_neutral += 1
				if self.sc_neutral_tile < 0 or bit32.band(self.rng:randi(), 15) == 0 then
					self.sc_neutral_tile = n
				end
			elseif self.sc_fallout_tile < 0 then
				self.sc_fallout_tile = n
			end
			return
		end
		local sc_count = self.sc_count
		if sc_count[on] == 0 then
			local l = self.sc_list
			l[#l + 1] = on
			self.sc_tile[on] = n
		end
		sc_count[on] += 1
	end
	C._scan_nb = _scan_nb

	--- Walks up to `limit` tiles of `id`'s border list (resuming where the previous scan stopped)
	--- and records neighbouring owners in sc_list / sc_count / sc_tile and unclaimed contact in
	--- sc_neutral / sc_neutral_tile (and one fallout contact in sc_fallout_tile).
	function C.scan_border(self: any, id: number, limit: number)
		local sc_count = self.sc_count
		local sc_list = self.sc_list
		for _, o in sc_list do
			sc_count[o] = 0
		end
		table.clear(sc_list)
		self.sc_neutral = 0
		self.sc_neutral_tile = -1
		self.sc_fallout_tile = -1
		local total = self.bcount[id]
		if total <= 0 then
			return
		end
		local owner = self.owner
		local bnext = self.bnext
		local b = self.sc_cursor[id]
		if b < 0 or readi32(owner, b * 4) ~= id or readu8(self.in_border, b) == 0 then
			b = self.bhead[id]
		end
		local steps = math.min(limit, total)
		local W = self.W
		local NW = self.N - W
		for _ = 1, steps do
			if b == -1 then
				b = self.bhead[id]
			end
			local x = b % W
			if x > 0 then
				_scan_nb(self, id, b - 1)
			end
			if x < W - 1 then
				_scan_nb(self, id, b + 1)
			end
			if b >= W then
				_scan_nb(self, id, b - W)
			end
			if b < NW then
				_scan_nb(self, id, b + W)
			end
			b = readi32(bnext, b * 4)
		end
		self.sc_cursor[id] = b
	end

	--- An owned tile at (or as near as possible to) the centre of `id`'s territory; -1 if none.
	function C.centre_tile(self: any, id: number): number
		local n = self.o_tiles[id]
		if n <= 0 then
			return -1
		end
		local owner = self.owner
		local W = self.W
		local H = self.H
		local cx = math.clamp(math.floor(self.o_cx[id] / n + 0.5), 0, W - 1)
		local cy = math.clamp(math.floor(self.o_cy[id] / n + 0.5), 0, H - 1)
		local c = cy * W + cx
		if readi32(owner, c * 4) == id then
			return c
		end
		-- Nearest owned tile on growing square rings (bounded).
		local rmax = math.max(39, math.ceil(40.0 / self.R.K_LIN))
		for r = 1, rmax do
			for dy = -r, r do
				local y = cy + dy
				if y < 0 or y >= H then
					continue
				end
				local step_x = if math.abs(dy) == r then 1 else 2 * r
				local dx = -r
				while dx <= r do
					local x = cx + dx
					if x >= 0 and x < W then
						local t = y * W + x
						if readi32(owner, t * 4) == id then
							return t
						end
					end
					dx += step_x
				end
			end
		end
		return self.bhead[id]
	end

	--- Every coastal tile `id` owns (1-based array, in coast-list order: newest first).
	function C.coast_tiles(self: any, id: number): { number }
		local out = table.create(math.max(self.o_coast[id], 0))
		local cnext = self.cnext
		local c = self.chead[id]
		while c ~= -1 do
			out[#out + 1] = c
			c = cnext[c]
		end
		return out
	end

	--- A coastal tile owned by `id` (-1 if none). Uses the cached tile or scans the coast list.
	function C.own_coast_tile(self: any, id: number): number
		if self.o_coast[id] <= 0 then
			return -1
		end
		local owner = self.owner
		local c = self.o_coast_tile[id]
		if c >= 0 and readi32(owner, c * 4) == id then
			return c
		end
		local map = self.map
		local coast_list = map.coast_list
		for k = 0, map.coast_count - 1 do
			local t = readi32(coast_list, k * 4)
			if readi32(owner, t * 4) == id then
				self.o_coast_tile[id] = t
				return t
			end
		end
		return -1
	end

	-- =========================================================================================
	-- Geometry helpers
	-- =========================================================================================

	--- Every tile (contestable land only when `only_land`, default true) with
	--- range_d2(center, t) <= radius² (1-based array, row by row).
	function C.disk_tiles(self: any, center: number, radius: number, only_land: boolean?): { number }
		local land_only = only_land ~= false
		local land = self.land
		local W = self.W
		local H = self.H
		local out = {}
		local n = 0
		local cx = center % W
		local cy = center // W
		local r = math.ceil(radius)
		local r2 = radius * radius
		for dy = -r, r do
			local y = cy + dy
			if y < 0 or y >= H then
				continue
			end
			local dy2 = dy * dy
			local rem = r2 - dy2
			if rem < 0.0 then
				continue
			end
			local half = math.ceil(math.sqrt(rem)) + 1
			local lo = math.max(-half, -cx)
			local hi = math.min(half, W - 1 - cx)
			local row = y * W + cx
			for dx = lo, hi do
				if dx * dx + dy2 > r2 then
					continue
				end
				local t = row + dx
				if not land_only or readu8(land, t) == 1 then
					n += 1
					out[n] = t
				end
			end
		end
		return out
	end

	-- =========================================================================================
	-- Diplomacy
	-- =========================================================================================

	--- Friendly: allies, and in a team game teammates (a teammate who has left
	--- is not, and may be attacked). Every rule that keeps two owners from fighting asks this.
	function C.allied(self: any, a: number, b: number): boolean
		if a <= 0 or b <= 0 or a == b then
			return false
		end
		if self.alliances[pair_key(a, b)] ~= nil then
			return true
		end
		local t = self.o_team[a]
		return t ~= 0 and t == self.o_team[b] and self.o_left[a] == 0 and self.o_left[b] == 0
	end

	--- An alliance (not a team): what can be renewed, broken or betrayed.
	function C.has_alliance(self: any, a: number, b: number): boolean
		if a <= 0 or b <= 0 or a == b then
			return false
		end
		return self.alliances[pair_key(a, b)] ~= nil
	end

	--- Teammates in a team game (whether present or not).
	function C.same_team(self: any, a: number, b: number): boolean
		local t = self.o_team[a]
		return a ~= b and t ~= 0 and t == self.o_team[b]
	end

	--- `victim` holds a grudge against `offender` for `ticks`.
	function C.add_grudge(self: any, victim: number, offender: number, ticks: number)
		if victim <= 0 or offender <= 0 then
			return
		end
		local k = victim * 1024 + offender
		local until_tick = self.tick + ticks
		local g = self.grudge
		if (g[k] or 0) < until_tick then
			g[k] = until_tick
		end
	end

	--- True when either side has a live grudge against the other (recent attack or nuke).
	function C.hostile(self: any, a: number, b: number): boolean
		if a <= 0 or b <= 0 or a == b then
			return false
		end
		local g = self.grudge
		local t = self.tick
		return (g[a * 1024 + b] or 0) > t or (g[b * 1024 + a] or 0) > t
	end

	function C.grudge_of(self: any, victim: number, offender: number): boolean
		return (self.grudge[victim * 1024 + offender] or 0) > self.tick
	end

	function C.form_alliance(self: any, a: number, b: number)
		if self:has_alliance(a, b) then
			return
		end
		local key = pair_key(a, b)
		self.alliances[key] = true
		-- An alliance expires ALLIANCE_TICKS after it forms.
		self.ally_expires[key] = self.tick + Rules.ALLIANCE_TICKS
		self.ally_ext[key] = 0
		self._seq += 1
		self._ally_seq[key] = self._seq
		self.o_ally_count[a] += 1
		self.o_ally_count[b] += 1
		-- (the mirror clears both requests on ALLY; accepted requests count for the cooldown)
		self:_forget_request(a * 1024 + b)
		self:_forget_request(b * 1024 + a)
		self:ev({ Ev.ALLY, a, b, self.ally_expires[key] })
		self:msg(a, Defs.MSG_ALLIANCE, "You are now allied with " .. self.o_name[b])
		self:msg(b, Defs.MSG_ALLIANCE, "You are now allied with " .. self.o_name[a])
		self:_on_alliance_formed(a, b)
	end

	--- Overridden by SimAttacks to stop fighting between new allies.
	function C._on_alliance_formed(_self: any, _a: number, _b: number) end

	--- Ends the alliance of `a` and `b`: broken by `traitor` (> 0), or ended by an elimination (0), or
	--- `expired` (no traitor, a message to both).
	function C.end_alliance(self: any, a: number, b: number, traitor: number, expired: boolean?)
		local k = pair_key(a, b)
		if self.alliances[k] == nil then
			return
		end
		self.alliances[k] = nil
		self.ally_expires[k] = nil
		self.ally_ext[k] = nil
		self._ally_seq[k] = nil
		self.o_ally_count[a] -= 1
		self.o_ally_count[b] -= 1
		self:ev({ Ev.ALLY_END, a, b, traitor, expired == true })
		if expired then
			self:msg(a, Defs.MSG_INFO, "Your alliance with " .. self.o_name[b] .. " has expired")
			self:msg(b, Defs.MSG_INFO, "Your alliance with " .. self.o_name[a] .. " has expired")
		end
		if traitor > 0 then
			local victim = if traitor == a then b else a
			self.o_traitor_until[traitor] = self.tick + Rules.TRAITOR_TICKS
			self:ev({ Ev.TRAITOR, traitor, self.o_traitor_until[traitor] })
			self:add_grudge(victim, traitor, Rules.HOSTILE_TICKS * 3)
			local o_name = self.o_name
			self:msg(victim, Defs.MSG_BAD, o_name[traitor] .. " betrayed your alliance!")
			self:msg(
				traitor,
				Defs.MSG_ALERT,
				"You broke your alliance with " .. o_name[victim] .. " — you are marked a traitor"
			)
			local top = self:top_owners()
			for _, h in self.humans do
				if h ~= traitor and h ~= victim and self:news_relevant(h, traitor, victim, top) then
					self:msg(h, Defs.MSG_INFO, o_name[traitor] .. " betrayed " .. o_name[victim])
				end
			end
		end
	end

	--- Allies of `id` (1-based array) in alliance formation order (GDScript Dictionary order).
	function C.allies_of(self: any, id: number): { number }
		local out = {}
		if self.o_ally_count[id] <= 0 then
			return out
		end
		local seq = self._ally_seq
		local keys = {}
		for k in self.alliances do
			if k // 1024 == id or k % 1024 == id then
				keys[#keys + 1] = k
			end
		end
		table.sort(keys, function(x, y)
			return seq[x] < seq[y]
		end)
		for _, k in keys do
			local a = k // 1024
			out[#out + 1] = if a == id then k % 1024 else a
		end
		return out
	end

	--- Keys of `tbl` (alliances / requests) in insertion order (GDScript Dictionary iteration).
	function C._ordered_keys(self: any, tbl: { [number]: any }): { number }
		local seq = if tbl == self.alliances then self._ally_seq else self._req_seq
		local keys = {}
		for k in tbl do
			keys[#keys + 1] = k
		end
		table.sort(keys, function(x, y)
			return (seq[x] or 0) < (seq[y] or 0)
		end)
		return keys
	end

	function C.add_request(self: any, from: number, to: number)
		local k = from * 1024 + to
		if self.requests[k] == nil then
			self._seq += 1
			self._req_seq[k] = self._seq
		end
		self.requests[k] = self.tick
		-- No MSG: the UI renders ALLY_REQ itself as an actionable card.
		self:ev({ Ev.ALLY_REQ, from, to, self.tick })
	end

	--- Drops request `k` (from*1024+to), remembering when it was made for the cooldown
	--- (an accepted or rejected request still counts for it).
	function C._forget_request(self: any, k: number): boolean
		local made = self.requests[k]
		if made == nil then
			return false
		end
		self.req_last[k] = made
		self.requests[k] = nil
		self._req_seq[k] = nil
		return true
	end

	function C.close_request(self: any, from: number, to: number)
		if self:_forget_request(from * 1024 + to) then
			self:ev({ Ev.ALLY_REQ_END, from, to })
		end
	end

	--- Ticks until `from` may ask `to` for an alliance again (ALLY_REQUEST_COOLDOWN_TICKS, counted from
	--- when the previous request was made); 0 = now.
	function C.request_cooldown_left(self: any, from: number, to: number): number
		local last = self.req_last[from * 1024 + to]
		if last == nil then
			return 0
		end
		return math.max(0, last + Rules.ALLY_REQUEST_COOLDOWN_TICKS - self.tick)
	end

	--- Tick at which the alliance of `a` and `b` expires (-1: not allied).
	function C.alliance_expires(self: any, a: number, b: number): number
		local e = self.ally_expires[pair_key(a, b)]
		return if e ~= nil then e else -1
	end

	--- True inside the renewal window (expiry <=
	--- now + ALLIANCE_EXTEND_WINDOW_TICKS).
	function C.in_extension_window(self: any, a: number, b: number): boolean
		local e = self.ally_expires[pair_key(a, b)]
		return e ~= nil and e <= self.tick + Rules.ALLIANCE_EXTEND_WINDOW_TICKS
	end

	--- True when `id` asked to renew its alliance with `other`.
	function C.asked_to_extend(self: any, id: number, other: number): boolean
		local bits = self.ally_ext[pair_key(id, other)]
		if bits == nil then
			return false
		end
		return bit32.band(bits, if id < other then 1 else 2) ~= 0
	end

	--- `id` asks to renew its alliance with `other`. Returns "renewed"
	--- when both have now asked (expiresAt = now + ALLIANCE_TICKS, both marks cleared), "asked" when
	--- only `id` has, "" when refused (no alliance, someone is out, outside the renewal window — the
	--- window is a client rule, enforced here too because clients are untrusted — or already
	--- asked).
	function C.extend_alliance(self: any, id: number, other: number): string
		if id <= 0 or other <= 0 or id == other or not self:has_alliance(id, other) then
			return ""
		end
		if self.o_alive[id] == 0 or self.o_alive[other] == 0 then
			return ""
		end
		if not self:in_extension_window(id, other) or self:asked_to_extend(id, other) then
			return ""
		end
		local k = pair_key(id, other)
		local bits = bit32.bor(self.ally_ext[k], if id < other then 1 else 2)
		local o_name = self.o_name
		if bits == 3 then
			self.ally_ext[k] = 0
			self.ally_expires[k] = self.tick + Rules.ALLIANCE_TICKS
			self:ev({ Ev.ALLY_EXT, k // 1024, k % 1024, self.ally_expires[k], 0 })
			self:msg(id, Defs.MSG_ALLIANCE, "Your alliance with " .. o_name[other] .. " was renewed")
			self:msg(other, Defs.MSG_ALLIANCE, "Your alliance with " .. o_name[id] .. " was renewed")
			return "renewed"
		end
		self.ally_ext[k] = bits
		self:ev({ Ev.ALLY_EXT, k // 1024, k % 1024, self.ally_expires[k], bits })
		self:msg(other, Defs.MSG_ALLIANCE, o_name[id] .. " wants to renew your alliance")
		return "asked"
	end

	--- Alliance expiry and the alliance request timeout, every tick
	--- (in formation / request order).
	function C._alliances_tick(self: any)
		local tick = self.tick
		if next(self.alliances) ~= nil then
			local any = false
			for _, e in self.ally_expires do
				if e <= tick then
					any = true
					break
				end
			end
			if any then
				for _, k in self:_ordered_keys(self.alliances) do
					local e = self.ally_expires[k]
					if e ~= nil and e <= tick then
						self:end_alliance(k // 1024, k % 1024, 0, true)
					end
				end
			end
		end
		if next(self.requests) ~= nil then
			local limit = tick - Rules.ALLY_REQUEST_TICKS
			local any = false
			for _, made in self.requests do
				if made < limit then
					any = true
					break
				end
			end
			if any then
				for _, k in self:_ordered_keys(self.requests) do
					local made = self.requests[k]
					if made ~= nil and made < limit then
						local from = k // 1024
						local to = k % 1024
						self:close_request(from, to)
						self:msg(from, Defs.MSG_INFO, self.o_name[to] .. " did not answer your alliance request")
					end
				end
			end
		end
	end

	function C.has_request(self: any, from: number, to: number): boolean
		return self.requests[from * 1024 + to] ~= nil
	end

	--- Credits event income (trade, trucks, captures) and tracks it for the income stat.
	--- `tile`: where it was earned (a bonus event: the "+ 25K" that
	--- rises there on the earner's map). Only a person gets the event: nobody watches an AI's.
	function C.add_bonus_gold(self: any, id: number, amount: number, tile: number?)
		if id <= 0 or self.o_alive[id] == 0 then
			return
		end
		self.o_gold[id] += amount
		self.o_bonus_acc[id] += amount
		if
			tile ~= nil
			and amount > 0
			and self.o_kind[id] == Defs.KIND_HUMAN
			and self.o_ai[id] == 0
			and self.o_left[id] == 0
		then
			self:ev({ Ev.BONUS, id, tile, math.floor(amount + 0.5) })
		end
	end
end

return SimState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">SimStructures</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/sim_structures.gd (SimStructures, mixin of the flattened Sim class).
-- Structures (city, port, factory, defense post, SAM, silo), the road network between economic
-- structures, trucks, and the registry shared by every moving unit (boats, ships, trucks).
-- Roads and trucks go by railroads, stations and trains in the names below (Rules too):
-- a factory becomes a station and turns every city, port and factory within
-- trainStationMaxRange into one; a new station snaps onto nearby railroads or links to stations it
-- isn't already within 4 hops of, over A*-routed tile paths; factories spawn trains with
-- trainSpawnRate odds towards a random city / port of their cluster, and every city / port stop
-- pays trainGold to the train's owner and the station's owner.
--
-- Luau notes: `structs` is a sid → Struct map; `struct_list` keeps them in sid (= GDScript
-- Dictionary insertion) order for every ordered iteration. `units` is uid → Unit, `unit_list` the
-- ordered list (as in GDScript). Paths are 1-based arrays of 0-based tile indices and are never
-- mutated after they were assigned to a unit (events share them).

local Defs = require("./Defs")
local Ev = require("./Ev")
local Rules = require("./Rules")
local SimState = require("./SimState")
local Coop = require("../Net/Coop")

local readu8 = buffer.readu8
local writeu8 = buffer.writeu8
local readu16 = buffer.readu16
local readi32 = buffer.readi32
local writei32 = buffer.writei32

local a_an = SimState.a_an

local MAXO = Defs.MAX_OWNERS
local STRUCT_KINDS = 16

local S_CITY = Defs.S_CITY
local S_PORT = Defs.S_PORT
local S_FACTORY = Defs.S_FACTORY
--- Order of kinds within a grid cell when a factory pulls in stations (city, port, factory)
local FACTORY_PULL_RANK = { [Defs.S_CITY] = 1, [Defs.S_PORT] = 2, [Defs.S_FACTORY] = 3 }
local S_DEFENSE = Defs.S_DEFENSE
local S_SAM = Defs.S_SAM
local S_SILO = Defs.S_SILO
local S_ARTILLERY = Defs.S_ARTILLERY
local U_TRANSPORT = Defs.U_TRANSPORT
local U_TRADE = Defs.U_TRADE
local U_WARSHIP = Defs.U_WARSHIP
local U_TRUCK = Defs.U_TRUCK

-- Spatial buckets of SCELL x SCELL tiles (self._scw x self._sch per map).
local SCELL = 32

local SimStructures = {}
SimStructures.SCELL = SCELL

-- Enum-keyed constant tables are 0-based (sim-core convention: Defs.STRUCT_TITLES[Defs.S_CITY]).
local function struct_title(kind: number): string
	return Defs.STRUCT_TITLES[kind]
end
local function build_ticks(kind: number): number
	return Rules.BUILD_TICKS[kind]
end
SimStructures.struct_title = struct_title

-- =============================================================================================
-- Struct / Unit records
-- =============================================================================================

export type Struct = {
	sid: number,
	kind: number,
	owner: number,
	tile: number,
	water: number,
	body: number,
	next_tick: number,
	rejections: number,
	level: number,
	active_tick: number,
	active: boolean,
	shots: { number },
	up_tick: number,
	last_spawn: number,
	trucks: number,
	roads: { number },
	station: boolean,
	cluster: number,
	partners: { number },
	partners_tick: number,
	owned_seq: number,
	delete_at: number,
	hp: number?,
	next_fire: number,
	dead: boolean,
}

local Struct = {}
SimStructures.Struct = Struct

function Struct.new(): Struct
	return {
		sid = 0,
		kind = 0,
		owner = 0,
		tile = 0,
		-- Ports: adjacent water tile and its body.
		water = -1,
		body = 0,
		-- Ports: tick offset of the 10-tick trade roll; pity-timer rejections.
		next_tick = 0,
		rejections = 0,
		-- Upgrade level (1 as built) and the tick construction completes (active from then on).
		level = 1,
		active_tick = 0,
		active = false,
		-- SAMs / silos: launch (or upgrade) ticks of missiles still reloading.
		shots = {},
		-- SAMs: tick of the last upgrade (range ramps up over Rules.SAM_UPGRADE_TICKS).
		up_tick = -100000,
		-- Factories: tick of the last truck (>= 10 ticks between trains).
		last_spawn = -100000,
		trucks = 0,
		-- Train station (cities, ports and factories on the rail network), its railroads and cluster.
		roads = {},
		station = false,
		cluster = 0,
		-- Ports: preferred trade partners (structure ids) and when they were chosen.
		partners = {},
		partners_tick = -100000,
		-- Order in which structures came to their current owner (built or
		-- captured), and the tick after which a structure marked for deletion goes (0: not marked;
		-- a tribe marks them, see SimAI).
		owned_seq = 0,
		delete_at = 0,
		-- Health, lowered only by a shell, an air strike or a slug (SimArsenal.damage_struct; nil =
		-- whole), and a battery's next shot.
		hp = nil,
		next_fire = 0,
		dead = false,
	}
end

export type Unit = { [string]: any }

local Unit = {}
SimStructures.Unit = Unit

function Unit.new(): Unit
	return {
		uid = 0,
		kind = 0,
		owner = 0,
		path = {},
		start_tick = 0,
		tpt = 100,
		troops = 0.0,
		end_tick = 0,
		-- Next tick at which this unit needs any processing (arrival, truck stop, warship turn).
		next_tick = 0,
		-- transports
		target_tile = -1,
		-- trade ships
		src_sid = 0,
		dst_sid = 0,
		-- trucks: stop structure ids, path index of each stop (0-based path index), tick each stop
		-- is reached; next_stop is a 1-based index into stops (GDScript 1 → Luau 2). Created in
		-- _spawn_truck only.
		stops = nil :: { number }?,
		stop_idx = nil :: { number }?,
		stop_ticks = nil :: { number }?,
		next_stop = 2,
		trade_stops = 0,
		factory_sid = 0,
		-- trade ships: full-size tiles sailed before a capture re-route; original owner (0 = never captured)
		traveled = 0,
		orig_owner = 0,
		-- warships (per-ship state, see SimWarships)
		hp = 0,
		max_hp = 0,
		vet = 0,
		vet_progress = 0,
		-- 0 patrolling, 1 retreating to a port, 2 docked (repairing).
		state = 0,
		patrol = -1,
		retreat_port = 0,
		last_shot = -100000,
		manual_tick = -100000,
		heal_rem = 0.0,
		target_uid = 0,
		hunt_uid = 0,
		hunt_path_tick = -100000,
		port_check_tick = -100000,
		-- uid → true of one-shot targets already shelled (warships only; see SimWarships).
		shelled = nil :: { [number]: boolean }?,
		shelled_n = 0,
		near_port = false,
		near_port_tick = -100000,
		body = 0,
		dead = false,
	}
end

-- =============================================================================================
-- Install
-- =============================================================================================

function SimStructures.install(C)
	-- Field initialisation (GDScript member initialisers + _init_structures()).
	function C:_init_structures()
		self.structs = {} :: { [number]: Struct }
		self.struct_list = {} :: { Struct }
		self._structs_dead = 0
		self.n_structs = 0
		self.next_sid = 1
		self._owned_seq = 0
		self.port_list = {} :: { Struct }
		self.factory_list = {} :: { Struct }
		-- Spatial buckets (32 x 32 tiles) of structure ids; cell c lives at scells[c + 1].
		local scw = (self.W + SCELL - 1) // SCELL
		local sch = (self.H + SCELL - 1) // SCELL
		self._scw = scw
		self._sch = sch
		local scells = table.create(scw * sch)
		for i = 1, scw * sch do
			scells[i] = {}
		end
		self.scells = scells
		-- rid → { sid_a, sid_b, tiles (a's end to b's end), grid cells }: the railroads
		self.roads = {} :: { [number]: { any } }
		self.n_roads = 0
		self.next_rid = 1
		-- Rail spatial grid: cell → { rid = true }
		self.rail_cells = {} :: { [number]: { [number]: boolean } }
		-- Clusters of connected stations (see _ensure_clusters)
		self._clusters_dirty = false
		self._cluster_trade = {} :: { [number]: { Struct } }
		-- Structures under construction, activated when their active_tick comes.
		self.building = {} :: { Struct }
		self.units = {} :: { [number]: Unit }
		self.n_units = 0
		self.unit_list = {} :: { Unit }
		self.next_uid = 1
		self._units_dead = 0
		-- Trade ships at sea and trucks on the roads, world-wide (they slow the spawn rates as they add up).
		self.n_trade = 0
		self.n_trucks = 0
	end

	-- Sizes of the GDScript dictionaries (Luau maps have no O(1) size).
	function C:struct_total(): number
		return self.n_structs
	end

	function C:unit_total(): number
		return self.n_units
	end

	function C:road_total(): number
		return self.n_roads
	end

	-- =========================================================================================
	-- Units registry
	-- =========================================================================================

	function C:add_unit(u: Unit)
		if u.next_tick == 0 then
			u.next_tick = if u.kind ~= U_WARSHIP then u.end_tick else 1073741824 -- 1 << 30
		end
		u.uid = self.next_uid
		self.next_uid += 1
		self.units[u.uid] = u
		self.n_units += 1
		table.insert(self.unit_list, u)
		if u.kind == U_TRADE then
			self.n_trade += 1
		elseif u.kind == U_TRUCK then
			self.n_trucks += 1
		end
		self:ev({ Ev.UNIT_ADD, u.uid, u.kind, u.owner, u.path, u.start_tick, u.tpt, Defs.trunc(u.troops) })
		self:_on_unit_added(u)
	end

	function C:remove_unit(u: Unit, reason: number)
		if u.dead then
			return
		end
		u.dead = true
		self._units_dead += 1
		self.units[u.uid] = nil
		self.n_units -= 1
		self:ev({ Ev.UNIT_DEL, u.uid, reason })
		local k = u.kind
		if k == U_TRANSPORT then
			self.o_boats[u.owner] -= 1
		elseif k == U_WARSHIP then
			self.o_warships[u.owner] -= 1
		elseif k == U_TRADE then
			self.n_trade -= 1
		elseif k == U_TRUCK then
			self.n_trucks -= 1
			local f = self.structs[u.factory_sid]
			if f ~= nil then
				f.trucks -= 1
			end
		end
	end

	-- Hook for SimWarships (warship registry).
	function C:_on_unit_added(_u: Unit) end

	-- Current tile of a unit (every unit follows its path at `tpt` ticks per tile x100).
	function C:unit_tile(u: Unit): number
		local path = u.path
		local n = #path
		if n == 0 then
			return -1
		end
		local tpt = u.tpt
		if tpt < 1 then
			tpt = 1
		end
		local idx = (self.tick - u.start_tick) * 100 // tpt
		if idx < 0 then
			idx = 0
		elseif idx > n - 1 then
			idx = n - 1
		end
		return path[idx + 1]
	end

	function C:compact_units()
		if self._units_dead == 0 then
			return
		end
		self._units_dead = 0
		local list = self.unit_list
		local w = 0
		local n = #list
		for i = 1, n do
			local u = list[i]
			if not u.dead then
				w += 1
				list[w] = u
			end
		end
		for i = n, w + 1, -1 do
			list[i] = nil
		end
	end

	function C:count_units_of(id: number, kind: number): number
		local n = 0
		for _, u in self.unit_list do
			if not u.dead and u.owner == id and u.kind == kind then
				n += 1
			end
		end
		return n
	end

	-- Drops destroyed structures from struct_list (kept in sid order).
	function C:_compact_structs()
		self._structs_dead = 0
		local list = self.struct_list
		local w = 0
		local n = #list
		for i = 1, n do
			local s = list[i]
			if not s.dead then
				w += 1
				list[w] = s
			end
		end
		for i = n, w + 1, -1 do
			list[i] = nil
		end
	end

	-- =========================================================================================
	-- Spatial index
	-- =========================================================================================

	function C:_cell_of(t: number): number
		local W = self.W
		return ((t // W) // SCELL) * self._scw + ((t % W) // SCELL)
	end

	function C:_cell_add(s: Struct)
		table.insert(self.scells[self:_cell_of(s.tile) + 1], s.sid)
	end

	function C:_cell_remove(s: Struct)
		local cell = self.scells[self:_cell_of(s.tile) + 1]
		local i = table.find(cell, s.sid)
		if i then
			local last = #cell
			cell[i] = cell[last]
			cell[last] = nil
		end
	end

	-- Structures whose tile lies within `rx` columns and `ry` rows of `center`.
	function C:structs_in_box(center: number, rx: number, ry: number, kind: number?): { Struct }
		local want = if kind == nil then -1 else kind
		local out = {}
		local W = self.W
		local scw = self._scw
		local cx = center % W
		local cy = center // W
		local y0 = math.max(cy - ry, 0) // SCELL
		local y1 = math.min(cy + ry, self.H - 1) // SCELL
		local g0 = math.max(cx - rx, 0) // SCELL
		local g1 = math.min(cx + rx, W - 1) // SCELL
		local scells = self.scells
		local structs = self.structs
		for gy = y0, y1 do
			for gx = g0, g1 do
				for _, sid in scells[gy * scw + gx + 1] do
					local s = structs[sid]
					if want >= 0 and s.kind ~= want then
						continue
					end
					local st = s.tile
					if math.abs((st % W) - cx) <= rx and math.abs((st // W) - cy) <= ry then
						table.insert(out, s)
					end
				end
			end
		end
		return out
	end

	-- =========================================================================================
	-- Placement
	-- =========================================================================================

	-- True when `id` may place a structure of `kind` exactly on `t` (own land, ports on the coast,
	-- no structure of anyone closer than Rules.STRUCT_MIN_DIST — place_site()'s per-tile test).
	function C:valid_site(id: number, kind: number, t: number): boolean
		if t < 0 or t >= self.N or readi32(self.owner, t * 4) ~= id or readu8(self.land, t) == 0 then
			return false
		end
		if kind == S_PORT and readu8(self.map.coastal, t) == 0 then
			return false
		end
		local range_d2 = self.range_d2
		local md = self.R.STRUCT_MIN_DIST
		local md2 = md * md
		for _, s in self:structs_in_box(t, self.geo_span(t, md), math.ceil(md)) do
			if range_d2(s.tile, t) < md2 then
				return false
			end
		end
		return true
	end

	-- Structure rows [sid, kind, owner, tile, level, active_tick] Rules.place_site() needs around
	-- `tile` (same reach as Rules.near_structures on a GameState), ordered by sid.
	function C:near_rows(tile: number): { { number } }
		local R = self.R
		local range_d2 = self.range_d2
		local reach = R.PLACE_SEARCH_R + R.STRUCT_MIN_DIST + 1.0
		local r2 = reach * reach
		local out = {}
		for _, s in self:structs_in_box(tile, self.geo_span(tile, reach), math.ceil(reach)) do
			if range_d2(tile, s.tile) <= r2 or range_d2(s.tile, tile) <= r2 then
				table.insert(out, { s.sid, s.kind, s.owner, s.tile, s.level, s.active_tick })
			end
		end
		table.sort(out, function(a, b)
			return a[1] < b[1]
		end)
		return out
	end

	-- Where a build click of `id` for `kind` at `t` goes: Rules.place_site() on the Sim's data.
	function C:place(id: number, kind: number, t: number)
		return self.R.place_site(self.map, self.owner, self.map.coastal, id, kind, t, self:near_rows(t), self.tick)
	end

	-- Random valid site for `kind` within `radius` of `anchor` (AI helper). -1 if none found.
	function C:find_site(id: number, kind: number, anchor: number, radius: number, tries: number): number
		if anchor < 0 then
			return -1
		end
		local W = self.W
		local cx = anchor % W
		local cy = anchor // W
		local rng = self.rng
		-- ports snap to own coast within 4 tiles of the original grid
		local coast_r = math.ceil(4 * self.R.LEGACY_LIN)
		for _ = 1, tries do
			local x = math.clamp(cx + rng:randi_range(-radius, radius), 0, W - 1)
			local y = math.clamp(cy + rng:randi_range(-radius, radius), 0, self.H - 1)
			local t = y * W + x
			if kind == S_PORT then
				t = self:_nearest_coast(id, t, coast_r)
				if t < 0 then
					continue
				end
			end
			if self:valid_site(id, kind, t) then
				return t
			end
		end
		return -1
	end

	-- Squared latitude-corrected distance from `t` to the nearest structure of `kind` owned by
	-- `id` within `r` tiles (-1 when there is none that close).
	function C:own_struct_dist2(id: number, kind: number, t: number, r: number): number
		local best = -1.0
		local rr = r * r
		local range_d2 = self.range_d2
		for _, s in self:structs_in_box(t, self.geo_span(t, r), r, kind) do
			if s.owner == id then
				local d = range_d2(s.tile, t)
				if d <= rr and (best < 0.0 or d < best) then
					best = d
				end
			end
		end
		return best
	end

	function C:_nearest_coast(id: number, t: number, r: number): number
		local W = self.W
		local H = self.H
		local cx = t % W
		local cy = t // W
		local owner = self.owner
		local coastal = self.map.coastal
		for dy = -r, r do
			local y = cy + dy
			if y < 0 or y >= H then
				continue
			end
			for dx = -r, r do
				local x = cx + dx
				if x < 0 or x >= W then
					continue
				end
				local c = y * W + x
				if readi32(owner, c * 4) == id and readu8(coastal, c) == 1 then
					return c
				end
			end
		end
		return -1
	end

	-- =========================================================================================
	-- Building / destroying
	-- =========================================================================================

	-- Build intent (also upgrades: see Rules.place_site). Returns true on success.
	--- Returns ok, and whether it was an upgrade (a level on an existing structure).
	function C:try_build(id: number, kind_name: string, t: number): (boolean, boolean?)
		if kind_name == Rules.WARSHIP_KIND_NAME then
			return self:build_warship(id, t)
		end
		local kind = Defs.struct_kind_from_name(kind_name)
		if kind < 0 or t < 0 or t >= self.N then
			return false
		end
		-- the Arsenal's structures need their unlock (SimArsenal)
		if not self:has_unlock(id, Defs.STRUCT_UNLOCK[kind] or 0) then
			self:msg(id, Defs.MSG_INFO, string.format("Unlock %s in the Arsenal first", struct_title(kind)))
			return false
		end
		local cost = Rules.build_cost_kind(kind, self:cost_count(id, kind))
		if self.o_gold[id] < cost then
			self:msg(id, Defs.MSG_INFO, string.format("Not enough gold for %s", a_an(struct_title(kind))))
			return false
		end
		local p = self:place(id, kind, t)
		local up = p.upgrade_sid
		if up ~= 0 then
			local s = self.structs[up]
			if s == nil then
				return false
			end
			self.o_gold[id] -= cost
			self:upgrade_struct(s)
			return true, true
		end
		local site = p.tile
		if site < 0 then
			local reason = p.reason
			if reason == "no_coast" then
				self:msg(id, Defs.MSG_INFO, "Ports must be built on your coast")
			elseif reason == "not_own" then
				self:msg(id, Defs.MSG_INFO, "You can only build on your own land")
			else
				self:msg(id, Defs.MSG_INFO, string.format("No room for %s there", a_an(struct_title(kind))))
			end
			return false
		end
		self.o_gold[id] -= cost
		self:add_struct(kind, id, site)
		return true
	end

	-- Count the price of `kind` grows with: per kind sharing the price, min(levels owned, levels built).
	function C:cost_count(id: number, kind: number): number
		local b = id * STRUCT_KINDS
		local o_slevel = self.o_slevel
		local o_built = self.o_built
		if kind == S_PORT or kind == S_FACTORY then
			return math.min(o_slevel[b + S_PORT], o_built[b + S_PORT])
				+ math.min(o_slevel[b + S_FACTORY], o_built[b + S_FACTORY])
		end
		return math.min(o_slevel[b + kind], o_built[b + kind])
	end

	-- Level sum of `id`'s structures of `kind` (construction counts 1).
	function C:struct_levels(id: number, kind: number): number
		return self.o_slevel[id * STRUCT_KINDS + kind]
	end

	-- An upgrade: +1 level at once; a SAM or silo gets one
	-- more missile slot, which starts reloading; a SAM's range grows over SAM_UPGRADE_TICKS.
	function C:upgrade_struct(s: Struct)
		s.level += 1
		local b = s.owner * STRUCT_KINDS + s.kind
		self.o_slevel[b] += 1
		self.o_built[b] += 1
		if s.active then
			self.o_alevel[b] += 1
		end
		if s.kind == S_SAM then
			s.up_tick = self.tick
		end
		self:ev({ Ev.STRUCT_LEVEL, s.sid, s.level, s.active_tick })
		if s.kind == S_SAM or s.kind == S_SILO then
			table.insert(s.shots, self.tick)
			self:ev({ Ev.STRUCT_SHOTS, s.sid, table.clone(s.shots) })
		end
	end

	-- Overridden by SimWarships.
	function C:build_warship(_id: number, _t: number): boolean
		return false
	end

	function C:add_struct(kind: number, id: number, t: number): Struct
		local tick = self.tick
		local s = Struct.new()
		s.sid = self.next_sid
		self.next_sid += 1
		s.kind = kind
		s.owner = id
		s.tile = t
		self._owned_seq += 1
		s.owned_seq = self._owned_seq
		s.active_tick = tick + build_ticks(kind)
		self.structs[s.sid] = s
		self.n_structs += 1
		table.insert(self.struct_list, s)
		writei32(self.struct_at, t * 4, s.sid)
		local b = id * STRUCT_KINDS + kind
		self.o_scount[b] += 1
		self.o_slevel[b] += 1
		self.o_built[b] += 1
		self:_cell_add(s)
		self:ev({ Ev.STRUCT_ADD, s.sid, kind, id, t })
		self:ev({ Ev.STRUCT_LEVEL, s.sid, 1, s.active_tick })
		if kind == S_PORT then
			s.body = readu16(self.map.coast_body, t * 2)
			s.water = self:_port_water(t, s.body)
			s.next_tick = tick % 10
		end
		if s.active_tick <= tick then
			self:_activate(s)
		else
			table.insert(self.building, s)
		end
		return s
	end

	-- Finishes construction of structures whose time has come.
	function C:construction_tick()
		-- struct_list compaction happens here, never while something iterates it.
		if self._structs_dead > 64 then
			self:_compact_structs()
		end
		local building = self.building
		if #building == 0 then
			return
		end
		local tick = self.tick
		local keep = {}
		for _, s in building do
			if s.dead then
				continue
			end
			if s.active_tick <= tick then
				self:_activate(s)
			else
				table.insert(keep, s)
			end
		end
		self.building = keep
	end

	-- A finished structure starts working: ports trade, factories dispatch trucks, posts defend,
	-- cities raise the troop cap, and stations join the road network.
	function C:_activate(s: Struct)
		s.active = true
		self.o_alevel[s.owner * STRUCT_KINDS + s.kind] += s.level
		local k = s.kind
		if k == S_PORT then
			table.insert(self.port_list, s)
		elseif k == S_FACTORY then
			table.insert(self.factory_list, s)
		elseif k == S_DEFENSE then
			self:_cover(s.tile, 1)
		elseif k == S_ARTILLERY then
			self:_battery_ready(s)
		end
		local t = s.tile
		if k == S_FACTORY then
			-- A new factory becomes a station (it runs the trains), then
			-- every city, port or factory (any owner) within trainStationMaxRange that has none.
			self:_make_station(s)
			for _, c in self:_factory_pull_order(self:_stations_near(t, true)) do
				self:_make_station(c)
			end
		elseif (k == S_CITY or k == S_PORT) and self:_factory_near(t) then
			-- A city or port: a station when a factory is in range
			self:_make_station(s)
		end
	end

	-- True when any factory stands within trainStationMaxRange of `t` (cities and
	-- ports only become stations near a factory).
	function C:_factory_near(t: number): boolean
		local range_d2 = self.range_d2
		local rmax = self.R.ROAD_MAX_TILES
		local r = math.ceil(rmax)
		for _, f in self:structs_in_box(t, self.geo_span(t, rmax), r, S_FACTORY) do
			if f.active and range_d2(f.tile, t) <= rmax * rmax then
				return true
			end
		end
		return false
	end

	-- Overridden by SimNaval (needs the nav grid).
	function C:_port_water(_t: number, _body: number): number
		return -1
	end

	function C:destroy_struct(s: Struct)
		if s.dead then
			return
		end
		s.dead = true
		self.structs[s.sid] = nil
		self.n_structs -= 1
		self._structs_dead += 1
		if readi32(self.struct_at, s.tile * 4) == s.sid then
			writei32(self.struct_at, s.tile * 4, 0)
		end
		local b = s.owner * STRUCT_KINDS + s.kind
		self.o_scount[b] -= 1
		self.o_slevel[b] -= s.level
		self:_cell_remove(s)
		self:ev({ Ev.STRUCT_DEL, s.sid })
		if s.active then
			self.o_alevel[b] -= s.level
			local k = s.kind
			if k == S_PORT then
				local i = table.find(self.port_list, s)
				if i then
					table.remove(self.port_list, i)
				end
			elseif k == S_FACTORY then
				local i = table.find(self.factory_list, s)
				if i then
					table.remove(self.factory_list, i)
				end
			elseif k == S_DEFENSE then
				self:_cover(s.tile, -1)
			end
		end
		-- A station removed: its railroads go (the network may split into clusters)
		for _, rid in table.clone(s.roads) do
			self:_remove_rail(rid)
		end
		table.clear(s.roads)
		if s.station then
			s.station = false
			self._clusters_dirty = true
		end
	end

	-- SimState hook: a structure's tile changed hands.
	function C:_struct_tile_changed(t: number, old: number, nw: number)
		local s = self.structs[readi32(self.struct_at, t * 4)]
		if s == nil then
			return
		end
		-- Captured structures change hands, except defense posts, which
		-- are destroyed. Tribes keep what they capture until they delete it (SimAI).
		-- (the Arsenal's structures too: they work only for an owner with their unlock)
		if nw == 0 or s.kind == S_DEFENSE or s.kind >= S_ARTILLERY then
			self:destroy_struct(s)
			if old > 0 and nw > 0 then
				self:msg(
					old,
					Defs.MSG_BAD,
					string.format("%s destroyed your %s", self.o_name[nw], struct_title(s.kind))
				)
			end
			return
		end
		local bo = old * STRUCT_KINDS + s.kind
		local bn = nw * STRUCT_KINDS + s.kind
		self.o_scount[bo] -= 1
		self.o_scount[bn] += 1
		self.o_slevel[bo] -= s.level
		self.o_slevel[bn] += s.level
		if s.active then
			self.o_alevel[bo] -= s.level
			self.o_alevel[bn] += s.level
		end
		s.owner = nw
		-- A capture clears a pending deletion.
		s.delete_at = 0
		self._owned_seq += 1
		s.owned_seq = self._owned_seq
		self:ev({ Ev.STRUCT_OWNER, s.sid, nw })
		if s.kind ~= S_FACTORY then
			self:msg(old, Defs.MSG_BAD, string.format("%s captured your %s", self.o_name[nw], struct_title(s.kind)))
			self:msg(
				nw,
				Defs.MSG_GOOD,
				string.format("You captured %s from %s", a_an(struct_title(s.kind)), self.o_name[old])
			)
		end
	end

	-- Marks the tiles a defense post at `t` covers (geo metric, like _defense_post_covers).
	function C:_cover(t: number, delta: number)
		local def_cover = self.def_cover
		for _, c in self:disk_tiles(t, self.R.defense_range(), false) do
			writeu8(def_cover, c, math.clamp(readu8(def_cover, c) + delta, 0, 255))
		end
	end

	-- True when a finished defense post of `id` stands within defensePostRange of `t`.
	function C:_defense_post_covers(t: number, id: number): boolean
		local R = self.R
		local range_d2 = self.range_d2
		local rf = R.defense_range()
		for _, s in self:structs_in_box(t, self.geo_span(t, rf), R.DEFENSE_RADIUS, S_DEFENSE) do
			if s.owner == id and s.active and range_d2(s.tile, t) <= rf * rf then
				return true
			end
		end
		return false
	end

	-- Structures of `id` of `kind` in sid order (linear scan; fine for AI decisions).
	function C:structs_of(id: number, kind: number): { Struct }
		local out = {}
		if self:struct_count(id, kind) <= 0 then
			return out
		end
		for _, s in self.struct_list do
			if not s.dead and s.owner == id and s.kind == kind then
				table.insert(out, s)
			end
		end
		return out
	end

	-- =========================================================================================
	-- Railroads (the roads between stations)
	-- =========================================================================================

	--- `s` becomes a train station; it snaps onto the railroads next to
	--- it, or else links to the stations in range.
	function C:_make_station(s: Struct)
		if s.station or s.dead then
			return
		end
		s.station = true
		self._clusters_dirty = true
		if not self:_snap_to_rails(s) then
			self:_link_nearby(s)
		end
	end

	--- Cities, ports and factories (any owner) within trainStationMaxRange of `t` as { d2, struct },
	--- nearest first (ties by sid); stations only unless `all`.
	function C:_stations_near(t: number, all: boolean?): { { any } }
		local range_d2 = self.range_d2
		local rmax = self.R.ROAD_MAX_TILES
		local out = {}
		for _, c in self:structs_in_box(t, self.geo_span(t, rmax), math.ceil(rmax)) do
			if c.kind > S_FACTORY or not c.active or c.dead or (not all and not c.station) then
				continue
			end
			local d2 = range_d2(t, c.tile)
			if d2 <= rmax * rmax then
				table.insert(out, { d2, c })
			end
		end
		table.sort(out, function(p, q)
			if p[1] ~= q[1] then
				return p[1] < q[1]
			end
			return p[2].sid < q[2].sid
		end)
		return out
	end

	--- The structures a new factory makes stations, in grid order
	--- (its 100-tile cells row by row, then city, port, factory, then build order), not nearest
	--- first: the order decides which cities snap onto the first long railroads (2026-10-12).
	function C:_factory_pull_order(near: { { any } }): { Struct }
		local K, W = self.R.K_LIN, self.W
		local keyed = {}
		for _, e in near do
			local c: Struct = e[2]
			local x, y = c.tile % W, c.tile // W
			table.insert(keyed, {
				c,
				math.floor((y + 0.5) * K) // 100,
				math.floor((x + 0.5) * K) // 100,
				FACTORY_PULL_RANK[c.kind] or 9,
			})
		end
		table.sort(keyed, function(p, q)
			if p[2] ~= q[2] then
				return p[2] < q[2]
			elseif p[3] ~= q[3] then
				return p[3] < q[3]
			elseif p[4] ~= q[4] then
				return p[4] < q[4]
			end
			return p[1].sid < q[1].sid
		end)
		local out = table.create(#keyed)
		for i, k in keyed do
			out[i] = k[1]
		end
		return out
	end

	--- Snapping: each railroad in the grid cells within RAIL_SNAP_FULL of `s` is split
	--- at its tile nearest `s` (unless that is an end), `s` joining both halves. True if any was.
	function C:_snap_to_rails(s: Struct): boolean
		local W = self.W
		local sx, sy = s.tile % W, s.tile // W
		local snapped = false
		for _, rid in self:_rails_near(s.tile) do
			local r = self.roads[rid]
			if r == nil then
				continue
			end
			local tiles = r[3]
			local n = #tiles
			local best, bd = 1, math.huge
			for i = 1, n do
				local t = tiles[i]
				local dx, dy = t % W - sx, t // W - sy
				local d = dx * dx + dy * dy
				if d < bd then
					bd = d
					best = i
				end
			end
			local idx = best - 1 -- 0-based index of the closest tile
			if idx == 0 or idx >= n then
				continue
			end
			local a, b = r[1], r[2]
			self:_remove_rail(rid)
			self:_add_rail(a, s.sid, table.move(tiles, 1, idx, 1, {}))
			self:_add_rail(s.sid, b, table.move(tiles, idx + 1, n, 1, {}))
			snapped = true
		end
		return snapped
	end

	--- Linking: a railroad to every station in range, nearest first, that is further
	--- than trainStationMinRange and not already within RAIL_LINK_HOPS hops of `s` (so networks stay
	--- sparse), when a short enough route exists.
	function C:_link_nearby(s: Struct)
		local rmin2 = self.R.ROAD_MIN_TILES * self.R.ROAD_MIN_TILES
		local max_path = self.R.RAIL_MAX_PATH
		for _, e in self:_stations_near(s.tile) do
			local n: Struct = e[2]
			if n == s or e[1] <= rmin2 or self:_hops(n, s, Rules.RAIL_LINK_HOPS) ~= -1 then
				continue
			end
			-- (a local match's step runs as a Coop job spread over frames: Session._local_process.
			-- A factory finishing makes every city and port in range a station, each routing its
			-- railroads here: 80 searches, 26 ms of one tick on a Mac (a solo World match, 2026-10-30))
			Coop.check()
			local path = self:rail_path(s.tile, n.tile)
			if #path > 0 and #path < max_path then
				self:_add_rail(s.sid, n.sid, path)
			end
		end
	end

	--- Hops from `from` to `to` over the railroads, -1 beyond `max_d`.
	function C:_hops(from: Struct, to: Struct, max_d: number): number
		if from == to then
			return 0
		end
		local structs = self.structs
		local seen = { [from.sid] = true }
		local frontier = { from.sid }
		for d = 1, max_d do
			local nxt = {}
			for _, sid in frontier do
				local st = structs[sid]
				if st == nil then
					continue
				end
				for _, rid in st.roads do
					local o = self:road_other(rid, sid)
					if o == to.sid then
						return d
					end
					if not seen[o] then
						seen[o] = true
						table.insert(nxt, o)
					end
				end
			end
			if #nxt == 0 then
				break
			end
			frontier = nxt
		end
		return -1
	end

	-- Rail spatial grid: railroads by the cells their tiles cross, RAIL_CELL_FULL full-size tiles square (a
	-- tile's cell is its centre's, in full-size tiles). Kept in full-size-tile units: rounding the cell and
	-- the snap radius to whole tiles of ours made the catchment 17% short on a K_LIN 1.25 map (2026-10-12).
	function C:_rail_cell(x: number, y: number): number
		local K, c = self.R.K_LIN, Rules.RAIL_CELL_FULL
		return (math.floor((y + 0.5) * K) // c) * (math.floor(self.W * K) // c + 2) + math.floor((x + 0.5) * K) // c
	end

	function C:_rail_register(rid: number, tiles: { number }): { number }
		local W = self.W
		local cells = self.rail_cells
		local mine = {}
		local seen = {}
		for _, t in tiles do
			local k = self:_rail_cell(t % W, t // W)
			if not seen[k] then
				seen[k] = true
				table.insert(mine, k)
				local set = cells[k]
				if set == nil then
					set = {}
					cells[k] = set
				end
				set[rid] = true
			end
		end
		return mine
	end

	function C:_rail_unregister(rid: number, mine: { number })
		local cells = self.rail_cells
		for _, k in mine do
			local set = cells[k]
			if set ~= nil then
				set[rid] = nil
				if next(set) == nil then
					cells[k] = nil
				end
			end
		end
	end

	--- The railroads in the cells overlapping the square of RAIL_SNAP_FULL
	--- full-size tiles around `t` (rid order).
	function C:_rails_near(t: number): { number }
		local W = self.W
		local K, c, r = self.R.K_LIN, Rules.RAIL_CELL_FULL, Rules.RAIL_SNAP_FULL
		local X, Y = math.floor((t % W + 0.5) * K), math.floor((t // W + 0.5) * K)
		local cols = math.floor(W * K) // c + 2
		local found = {}
		local out = {}
		for cy = math.max(Y - r, 0) // c, (Y + r) // c do
			for cx = math.max(X - r, 0) // c, (X + r) // c do
				local set = self.rail_cells[cy * cols + cx]
				if set ~= nil then
					for rid in set do
						if not found[rid] then
							found[rid] = true
							table.insert(out, rid)
						end
					end
				end
			end
		end
		table.sort(out)
		return out
	end

	function C:_add_rail(a: number, b: number, tiles: { number }): number
		local rid = self.next_rid
		self.next_rid += 1
		self.roads[rid] = { a, b, tiles, self:_rail_register(rid, tiles) }
		self.n_roads += 1
		table.insert(self.structs[a].roads, rid)
		table.insert(self.structs[b].roads, rid)
		self._clusters_dirty = true
		self:ev({ Ev.ROAD_ADD, rid, a, b, tiles })
		return rid
	end

	function C:_remove_rail(rid: number)
		local r = self.roads[rid]
		if r == nil then
			return
		end
		self.roads[rid] = nil
		self.n_roads -= 1
		self:_rail_unregister(rid, r[4])
		for k = 1, 2 do
			local st = self.structs[r[k]]
			if st ~= nil then
				local i = table.find(st.roads, rid)
				if i then
					table.remove(st.roads, i)
				end
			end
		end
		self._clusters_dirty = true
		self:ev({ Ev.ROAD_DEL, rid, r[1], r[2] })
	end

	function C:road_other(rid: number, sid: number): number
		local r = self.roads[rid]
		if r == nil then
			return 0
		end
		return if r[1] == sid then r[2] else r[1]
	end

	--- Cluster: connected stations share `cluster`; _cluster_trade[id] lists its cities and ports
	--- (the trains' destinations). Recomputed lazily after the network changed.
	function C:_ensure_clusters()
		if not self._clusters_dirty then
			return
		end
		self._clusters_dirty = false
		local trade = {}
		self._cluster_trade = trade
		local structs = self.structs
		for _, s in self.struct_list do
			s.cluster = 0
		end
		local next_id = 0
		for _, s in self.struct_list do
			if s.dead or not s.station or s.cluster ~= 0 then
				continue
			end
			next_id += 1
			local list = {}
			trade[next_id] = list
			s.cluster = next_id
			local queue = { s }
			local qi = 1
			while qi <= #queue do
				local cur = queue[qi]
				qi += 1
				if cur.kind ~= S_FACTORY then
					table.insert(list, cur)
				end
				for _, rid in cur.roads do
					local o = structs[self:road_other(rid, cur.sid)]
					if o ~= nil and o.station and o.cluster == 0 then
						o.cluster = next_id
						table.insert(queue, o)
					end
				end
			end
		end
	end

	--- Rail pathfinding (A* on the minimap, scaled back up): the railroad's tiles from
	--- `from` to `to`, or {} when no route is short enough. Nodes that can't lie on a path shorter
	--- than RAIL_MAX_PATH are never searched.
	function C:rail_path(from: number, to: number): { number }
		local R = self.R
		local f = R.RAIL_MINIMAP
		local W, H = self.W, self.H
		local mw = (W + f - 1) // f
		local mh = (H + f - 1) // f
		local terr = self.terr
		local ofb = self.map.tile_bytes
		local T_LAKE = Defs.T_LAKE
		local function full(m: number): number
			return (m // mw) * f * W + (m % mw) * f
		end
		local wet = {}
		local function water(m: number): boolean
			local v = wet[m]
			if v == nil then
				v = readu8(terr, full(m)) <= T_LAKE
				wet[m] = v
			end
			return v
		end
		local shores = {}
		local function shore(m: number): boolean
			local v = shores[m]
			if v == nil then
				local w = water(m)
				local x, y = m % mw, m // mw
				v = (x > 0 and water(m - 1) ~= w)
					or (x < mw - 1 and water(m + 1) ~= w)
					or (y > 0 and water(m - mw) ~= w)
					or (y < mh - 1 and water(m + mw) ~= w)
				shores[m] = v
			end
			return v
		end
		local start = ((from // W) // f) * mw + (from % W) // f
		local goal = ((to // W) // f) * mw + (to % W) // f
		local sx, sy = start % mw, start // mw
		local gx, gy = goal % mw, goal // mw
		local limit = math.ceil(R.RAIL_MAX_PATH / f) + 2
		if math.abs(sx - gx) + math.abs(sy - gy) > limit then
			return {}
		end
		local hw = Rules.RAIL_HEURISTIC_W
		local wpen = 1 + Rules.RAIL_WATER_PENALTY
		local tpen = Rules.RAIL_TURN_PENALTY
		-- binary heap of (priority, sequence, node); of equal priorities the newest comes out first (the
		-- last of its bucket). Oldest first, every L-shaped
		-- railroad was mirrored (down then along, not along then down), so later stations missed the
		-- rails they should have snapped onto (2026-10-12)
		local hp, hq, hn = {}, {}, {}
		local hsize = 0
		local seq = 0
		local function push(node: number, pri: number)
			seq += 1
			hsize += 1
			local i = hsize
			while i > 1 do
				local p = i // 2
				if hp[p] < pri or (hp[p] == pri and hq[p] > seq) then
					break
				end
				hp[i], hq[i], hn[i] = hp[p], hq[p], hn[p]
				i = p
			end
			hp[i], hq[i], hn[i] = pri, seq, node
		end
		local function pop(): number
			local top = hn[1]
			local lp, lq, ln = hp[hsize], hq[hsize], hn[hsize]
			hp[hsize], hq[hsize], hn[hsize] = nil, nil, nil
			hsize -= 1
			local i = 1
			while true do
				local c = i * 2
				if c > hsize then
					break
				end
				if c < hsize and (hp[c + 1] < hp[c] or (hp[c + 1] == hp[c] and hq[c + 1] > hq[c])) then
					c += 1
				end
				if lp < hp[c] or (lp == hp[c] and lq > hq[c]) then
					break
				end
				hp[i], hq[i], hn[i] = hp[c], hq[c], hn[c]
				i = c
			end
			if hsize > 0 then
				hp[i], hq[i], hn[i] = lp, lq, ln
			end
			return top
		end
		local g = { [start] = 0 }
		local parent = { [start] = -1 }
		local closed = {}
		push(start, hw * (math.abs(sx - gx) + math.abs(sy - gy)))
		local expanded = 0
		local found = false
		local nb = table.create(4, 0)
		while hsize > 0 do
			local node = pop()
			if closed[node] then
				continue
			end
			closed[node] = true
			if node == goal then
				found = true
				break
			end
			expanded += 1
			if expanded > 60000 or readu8(ofb, full(node)) == 0x9F then
				if expanded > 60000 then
					break
				end
				continue
			end
			local x, y = node % mw, node // mw
			local from_shore = shore(node)
			local prev = parent[node]
			local gn = g[node]
			local nn = 0
			if y > 0 then
				nn += 1
				nb[nn] = node - mw
			end
			if y < mh - 1 then
				nn += 1
				nb[nn] = node + mw
			end
			if x > 0 then
				nn += 1
				nb[nn] = node - 1
			end
			if x < mw - 1 then
				nn += 1
				nb[nn] = node + 1
			end
			for i = 1, nn do
				local m = nb[i]
				if closed[m] then
					continue
				end
				local m_water = water(m)
				if m_water and not (from_shore or shore(m)) then
					continue
				end
				local mx, my = m % mw, m // mw
				local hg = math.abs(mx - gx) + math.abs(my - gy)
				if math.abs(mx - sx) + math.abs(my - sy) + hg > limit then
					continue
				end
				local c = if m_water or shore(m) then wpen else 1
				if prev >= 0 and node - prev ~= m - node then
					c += tpen
				end
				local ng = gn + c
				local og = g[m]
				if og == nil or ng < og then
					g[m] = ng
					parent[m] = node
					push(m, ng + hw * hg)
				end
			end
		end
		if not found then
			return {}
		end
		local mini = {}
		local cur = goal
		while cur >= 0 do
			table.insert(mini, cur)
			cur = parent[cur]
		end
		-- (reversed: start first)
		local nmini = #mini
		for i = 1, nmini // 2 do
			mini[i], mini[nmini - i + 1] = mini[nmini - i + 1], mini[i]
		end
		local path = {}
		if f == 1 then
			for i = 1, nmini do
				path[i] = full(mini[i])
			end
		else
			-- Upscaling: minimap steps become f tiles, interpolated so the path stays connected
			for i = 1, nmini - 1 do
				local cx, cy = (mini[i] % mw) * f, (mini[i] // mw) * f
				local nx, ny = (mini[i + 1] % mw) * f, (mini[i + 1] // mw) * f
				table.insert(path, cy * W + cx)
				local dx, dy = nx - cx, ny - cy
				local steps = math.max(math.abs(dx), math.abs(dy))
				for step = 1, steps - 1 do
					local px = math.floor(cx + dx * step / steps + 0.5)
					local py = math.floor(cy + dy * step / steps + 0.5)
					table.insert(path, py * W + px)
				end
			end
			table.insert(path, full(mini[nmini]))
		end
		-- Ends: the path starts at `from` and ends at `to`
		local si = table.find(path, from)
		if si == nil then
			table.insert(path, 1, from)
		elseif si ~= 1 then
			path = table.move(path, si, #path, 1, {})
		end
		local di = table.find(path, to)
		if di == nil then
			table.insert(path, to)
		elseif di ~= #path then
			path = table.move(path, 1, di, 1, {})
		end
		return path
	end

	-- =========================================================================================
	-- Trains (the trucks on the roads)
	-- =========================================================================================

	--- A station trades with its owner and with anyone its owner holds
	--- no grudge against.
	function C:_trade_ok(st: Struct, player: number): boolean
		return st.owner == player or not self:hostile(st.owner, player)
	end

	--- Each finished factory station rolls `level` times per tick with odds 1 / trainSpawnRate(owner's
	--- factory levels, train units world-wide), at most one train per TRAIN_COOLDOWN_TICKS, and only
	--- when its cluster holds a city or port it may trade with; the train heads for a random one
	--- (reservoir sampling).
	function C:factories_tick()
		local list = self.factory_list
		if #list == 0 then
			return
		end
		self:_ensure_clusters()
		local units_w = self.n_trucks * Rules.TRAIN_UNITS
		local tick = self.tick
		local o_alive = self.o_alive
		local rng = self.rng
		for _, f in list do
			if not f.station or f.trucks >= Rules.TRUCKS_PER_FACTORY or o_alive[f.owner] == 0 then
				continue
			end
			if tick < f.last_spawn + Rules.TRAIN_COOLDOWN_TICKS then
				continue
			end
			local dests = self._cluster_trade[f.cluster]
			if dests == nil then
				continue
			end
			local any = false
			for _, d in dests do
				if not d.dead and self:_trade_ok(d, f.owner) then
					any = true
					break
				end
			end
			if not any then
				continue
			end
			local rate = Rules.train_spawn_rate(self:struct_levels(f.owner, S_FACTORY), units_w)
			local go = false
			for _ = 1, f.level do
				if rng:randi() % rate == 0 then
					go = true
					break
				end
			end
			if not go then
				continue
			end
			local pick = nil
			local seen = 0
			for _, d in dests do
				if not d.dead and self:_trade_ok(d, f.owner) then
					seen += 1
					if rng:randi() % seen == 0 then
						pick = d
					end
				end
			end
			if pick ~= nil and pick ~= f then
				self:_spawn_truck(f, pick)
				f.last_spawn = tick
			end
		end
	end

	--- A* over the station graph (1 per hop; the Manhattan tile heuristic makes it
	--- head straight for the destination). nil when not in the same cluster.
	function C:_station_path(a: Struct, b: Struct): { Struct }?
		self:_ensure_clusters()
		if a.cluster == 0 or a.cluster ~= b.cluster then
			return nil
		end
		local W = self.W
		local structs = self.structs
		local bx, by = b.tile % W, b.tile // W
		local function h(st: Struct): number
			return math.abs(st.tile % W - bx) + math.abs(st.tile // W - by)
		end
		local g = { [a.sid] = 0 }
		local parent = { [a.sid] = 0 }
		local open = { a }
		local closed = {}
		while #open > 0 do
			local bi, bf = 1, math.huge
			for i, st in open do
				local fv = g[st.sid] + h(st)
				if fv < bf or (fv == bf and st.sid < open[bi].sid) then
					bf = fv
					bi = i
				end
			end
			local cur = table.remove(open, bi)
			if closed[cur.sid] then
				continue
			end
			closed[cur.sid] = true
			if cur == b then
				local route = {}
				local sid = b.sid
				while sid ~= 0 do
					table.insert(route, 1, structs[sid])
					sid = parent[sid]
				end
				return route
			end
			for _, rid in cur.roads do
				local o = structs[self:road_other(rid, cur.sid)]
				if o ~= nil and o.station and not closed[o.sid] then
					local ng = g[cur.sid] + 1
					if g[o.sid] == nil or ng < g[o.sid] then
						g[o.sid] = ng
						parent[o.sid] = cur.sid
						table.insert(open, o)
					end
				end
			end
		end
		return nil
	end

	--- The factory's train runs the railroads of the station route to `dest`, stopping
	--- at every station on the way (a stop's tick: when the train, 2 full-size tiles a tick, reaches the end
	--- of the railroad leading there).
	function C:_spawn_truck(f: Struct, dest: Struct)
		local route = self:_station_path(f, dest)
		if route == nil or #route <= 1 then
			return
		end
		local path = {}
		local stop_idx = { 0 }
		for i = 1, #route - 1 do
			local a, b = route[i], route[i + 1]
			local seg = nil
			for _, rid in a.roads do
				if self:road_other(rid, a.sid) == b.sid then
					seg = self.roads[rid]
					break
				end
			end
			if seg == nil then
				return
			end
			local tiles = seg[3]
			if seg[1] == a.sid then
				for j = 1, #tiles do
					table.insert(path, tiles[j])
				end
			else
				for j = #tiles, 1, -1 do
					table.insert(path, tiles[j])
				end
			end
			table.insert(stop_idx, #path - 1)
		end
		if path[1] ~= f.tile then
			table.insert(path, 1, f.tile)
			for i = 2, #stop_idx do
				stop_idx[i] += 1
			end
		end
		local tick = self.tick
		local u = Unit.new()
		u.kind = U_TRUCK
		u.owner = f.owner
		u.factory_sid = f.sid
		u.start_tick = tick
		u.tpt = self.R.TRUCK_TPT_X100
		local stops = {}
		local stop_ticks = {}
		for i, st in route do
			stops[i] = st.sid
			stop_ticks[i] = tick + (stop_idx[i] * u.tpt + 99) // 100
		end
		u.stops = stops
		u.stop_idx = stop_idx
		u.stop_ticks = stop_ticks
		u.path = path
		u.end_tick = stop_ticks[#stop_ticks]
		u.next_stop = 2
		u.next_tick = stop_ticks[2]
		f.trucks += 1
		self:add_unit(u)
	end

	function C:_truck_tick(u: Unit)
		local tick = self.tick
		local stops = u.stops :: { number }
		local stop_ticks = u.stop_ticks :: { number }
		local nstops = #stops
		while u.next_stop <= nstops and tick >= stop_ticks[u.next_stop] do
			local s = self.structs[stops[u.next_stop]]
			-- A station that is gone or will not
			-- trade with the train's owner ends the trip there, unpaid.
			if s == nil or not s.station or self.o_alive[u.owner] == 0 or not self:_trade_ok(s, u.owner) then
				self:remove_unit(u, Defs.DEL_ARRIVED)
				return
			end
			-- City and port stops pay trainGold(relation, stops so far) to
			-- the train's owner and, when different, the same again to the station's owner.
			if s.kind ~= S_FACTORY then
				local rel = if s.owner == u.owner
					then "self"					-- (an ally; a teammate pays a stranger's rate: trainGold "team" = "other")

					elseif self:has_alliance(s.owner, u.owner) then "ally"
					else "other"
				local gold = Rules.train_gold(rel, u.trade_stops)
				-- (the earner sees "+ 25K" rise over the station)
				self:add_bonus_gold(u.owner, gold, s.tile)
				if s.owner ~= u.owner then
					self:add_bonus_gold(s.owner, gold, s.tile)
				end
				u.trade_stops += 1
			end
			u.next_stop += 1
		end
		if tick >= u.end_tick then
			self:remove_unit(u, Defs.DEL_ARRIVED)
		else
			u.next_tick = if u.next_stop <= #stop_ticks then stop_ticks[u.next_stop] else u.end_tick
		end
	end

	-- =========================================================================================
	-- Snapshot helpers
	-- =========================================================================================

	function C:struct_rows(): { { number } }
		local out = {}
		for _, s in self.struct_list do
			if not s.dead then
				-- (SAMs / silos with missiles reloading: + those launch ticks, Ev.STRUCT_SHOTS)
				table.insert(
					out,
					if #s.shots > 0
						then { s.sid, s.kind, s.owner, s.tile, s.level, s.active_tick, table.clone(s.shots) }
						else { s.sid, s.kind, s.owner, s.tile, s.level, s.active_tick }
				)
			end
		end
		return out
	end

	-- Snapshot rows [owner, built per slot...] for owners that built anything.
	function C:built_rows(): { { number } }
		local out = {}
		local o_built = self.o_built
		local slots = Rules.BUILT_SLOTS
		for id = 1, MAXO - 1 do
			local b = id * STRUCT_KINDS
			local any = false
			for k = 0, slots - 1 do
				if o_built[b + k] > 0 then
					any = true
					break
				end
			end
			if any then
				local row = { id }
				for k = 0, slots - 1 do
					table.insert(row, o_built[b + k])
				end
				table.insert(out, row)
			end
		end
		return out
	end

	function C:road_rows(): { { number } }
		local rids = {}
		for rid in self.roads do
			table.insert(rids, rid)
		end
		table.sort(rids)
		local out = {}
		for _, rid in rids do
			local r = self.roads[rid]
			table.insert(out, { rid, r[1], r[2], r[3] })
		end
		return out
	end

	function C:unit_rows(): { { any } }
		local out = {}
		for _, u in self.unit_list do
			if u.dead then
				continue
			end
			table.insert(out, {
				u.uid,
				u.kind,
				u.owner,
				u.path,
				u.start_tick,
				u.tpt,
				Defs.trunc(u.troops),
				u.hp,
				u.max_hp,
				u.vet,
				u.state,
				u.patrol,
			})
		end
		return out
	end
end

return SimStructures
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">SimWarships</string>
            <string name="Source"><![CDATA[--!native
-- Port of scripts/core/sim_warships.gd (SimWarships, mixin of the flattened Sim class).
-- Warships, shells and naval combat — patrols, shelling, move orders and trade-ship capture,
-- in full-size-tile units (self.R.K_LIN).
--
-- A warship sails a water path (UNIT_PATH) at 1 full-size tile per tick (2 while chasing a trade ship).
-- Every tick it heals (near an own port / docked), runs the repair-retreat logic and fights: it
-- picks the best target within 130 full-size tiles (transport > warship > trade ship, then nearest; the
-- search runs every SCAN_TICKS), shells transports and warships while it keeps patrolling, and
-- hunts trade ships down to capture them. Shells are projectiles: SHELL announces the impact
-- tick, damage lands then (UNIT_HP), or the shell fizzles if its target is gone or became friendly.

local Defs = require("./Defs")
local Coop = require("../Net/Coop")
local Ev = require("./Ev")
local Rules = require("./Rules")
local SimStructures = require("./SimStructures")

local readu8 = buffer.readu8
local writeu8 = buffer.writeu8
local readu16 = buffer.readu16
local readi32 = buffer.readi32

local Unit = SimStructures.Unit

local STRUCT_KINDS = 16
--- Ship grid cell size (tiles).
local GCELL = 32

local S_PORT = Defs.S_PORT
local S_DEFENSE = Defs.S_DEFENSE
local U_TRANSPORT = Defs.U_TRANSPORT
local U_TRADE = Defs.U_TRADE
local U_WARSHIP = Defs.U_WARSHIP
local U_TRUCK = Defs.U_TRUCK
local T_LAKE = Defs.T_LAKE

local SCAN_TICKS = 3
local SHIP_CELL = 32

local EMPTY = table.freeze({})

local SimWarships = {}
SimWarships.SCAN_TICKS = SCAN_TICKS
SimWarships.SHIP_CELL = SHIP_CELL

export type Shell = {
	id: number,
	kind: number, -- 0 warship, 1 defense post
	shooter: number,
	owner: number,
	target: number,
	from_tile: number,
	fire_tick: number,
	impact_tick: number,
	damage: number,
}

local Shell = {}
SimWarships.Shell = Shell

function Shell.new(): Shell
	return {
		id = 0,
		kind = 0,
		shooter = 0,
		owner = 0,
		target = 0,
		from_tile = 0,
		fire_tick = 0,
		impact_tick = 0,
		damage = 0,
	}
end

function SimWarships.install(C)
	function C:_init_warships()
		self.warship_list = {}
		self.shells = {} :: { Shell }
		self.next_shell_id = 1
		-- Water tiles 4-adjacent to land (trade ships there are safe from pirates); built once per
		-- map and shared.
		local map = self.map
		local shore_water = map._shore_water
		if shore_water == nil then
			shore_water = SimWarships.shore_water(map)
			map._shore_water = shore_water
		end
		self.shore_water = shore_water
		self.defense_posts_shoot = Rules.DEFENSE_POST_SHOOTS
		-- uid → true, plus the uids in first-insertion order (GDScript Dictionary order).
		self._hp_dirty = {} :: { [number]: boolean }
		self._hp_dirty_list = {} :: { number }
		-- Ship positions bucketed in 32 x 32 tile cells (unit_list indices), rebuilt once per tick.
		local gw = (self.W + GCELL - 1) // GCELL
		local gh = (self.H + GCELL - 1) // GCELL
		self._ship_gw = gw
		local grid = table.create(gw * gh)
		for i = 1, gw * gh do
			grid[i] = {}
		end
		self._ship_grid = grid
		self._ship_pos = {} :: { number }
		self._ship_grid_tick = -1
		self._ship_cells_used = {} :: { number }
		-- (optimisation) reusable result list of _ships_near
		self._near_scratch = {} :: { number }
		self._post_last = {} :: { [number]: number }
		self._post_shelled = {} :: { [number]: boolean }
	end

	function C:_on_unit_added(u)
		if u.kind == U_WARSHIP then
			table.insert(self.warship_list, u)
		end
	end

	function C:_mark_hp(uid: number)
		if not self._hp_dirty[uid] then
			self._hp_dirty[uid] = true
			table.insert(self._hp_dirty_list, uid)
		end
	end

	-- =========================================================================================
	-- Building and orders
	-- =========================================================================================

	-- Warship spawn (same rule as Rules.warship_port on a GameState): from the nearest (manhattan)
	-- finished own port on the clicked water body (any body when land is clicked); it patrols
	-- around the clicked sea tile.
	function C:build_warship(id: number, t: number): boolean
		local geo_manhattan = self.geo_manhattan
		local map = self.map
		local body = -1
		if t >= 0 and t < self.N and readu8(map.terrain, t) <= T_LAKE then
			body = readu16(map.water_body, t * 2)
		end
		local best = nil
		local bd = 0.0
		local coast_body = map.coast_body
		for _, p in self.port_list do
			if p.owner ~= id or p.water < 0 or (body >= 0 and readu16(coast_body, p.tile * 2) ~= body) then
				continue
			end
			local d = if t >= 0 and t < self.N then geo_manhattan(t, p.tile) else 0.0
			if best == nil or d < bd or (d == bd and p.tile < best.tile) then
				bd = d
				best = p
			end
		end
		if best == nil then
			self:msg(id, Defs.MSG_INFO, "You need a port on that sea to build warships")
			return false
		end
		local cost = Rules.build_cost(
			Rules.WARSHIP_KIND_NAME,
			math.min(self.o_warships[id], self.o_built[id * STRUCT_KINDS + Rules.BUILT_WARSHIP])
		)
		if self.o_gold[id] < cost then
			self:msg(id, Defs.MSG_INFO, "Not enough gold for a Warship")
			return false
		end
		self.o_gold[id] -= cost
		local nav = self.nav
		local tick = self.tick
		local u = Unit.new()
		u.kind = U_WARSHIP
		u.owner = id
		u.path = { best.water }
		u.start_tick = tick
		u.tpt = self.R.WARSHIP_TPT_X100
		u.end_tick = tick
		u.max_hp = Rules.warship_max_hp(0)
		u.hp = u.max_hp
		u.body = readu16(nav.body, best.water * 2)
		u.patrol = best.water
		u.shelled = {}
		u.shelled_n = 0
		if body >= 0 and readu16(nav.body, t * 2) == u.body and readi32(nav.region, t * 4) >= 0 then
			u.patrol = t
		end
		self.o_warships[id] += 1
		self.o_built[id * STRUCT_KINDS + Rules.BUILT_WARSHIP] += 1
		self:add_unit(u)
		self:ev({ Ev.UNIT_HP, u.uid, u.hp, u.max_hp })
		self:_emit_state(u)
		return true
	end

	-- Move order: a new patrol tile for one of `id`'s warships (water on the same body).
	-- It also suspends repair retreats for WARSHIP_MANUAL_NO_RETREAT_TICKS and cancels one under way.
	function C:move_warship(id: number, uid: number, t: number): boolean
		local u = self.units[uid]
		if u == nil or u.dead or u.kind ~= U_WARSHIP or u.owner ~= id then
			return false
		end
		local nav = self.nav
		if t < 0 or t >= self.N or readu8(self.map.terrain, t) > T_LAKE or readi32(nav.region, t * 4) < 0 then
			return false
		end
		if readu16(nav.body, t * 2) ~= readu16(nav.body, self:unit_tile(u) * 2) then
			return false
		end
		u.patrol = t
		u.manual_tick = self.tick
		u.target_tile = -1
		if u.state ~= 0 then
			u.state = 0
			u.retreat_port = 0
			u.heal_rem = 0.0
		end
		self:_emit_state(u)
		return true
	end

	function C:_emit_state(u)
		self:ev({ Ev.UNIT_STATE, u.uid, u.state, u.patrol })
	end

	-- Sends `u` along a fresh water path to `dest` at `tpt`; false when there is no path.
	function C:_set_course(u, dest: number, tpt: number): boolean
		local pos = self:unit_tile(u)
		local p = self.nav:short_path(pos, dest)
		if #p < 2 then
			return false
		end
		local tick = self.tick
		u.path = p
		u.start_tick = tick
		u.tpt = tpt
		u.end_tick = tick + ((#p - 1) * tpt + 99) // 100
		self:ev({ Ev.UNIT_PATH, u.uid, p, tick, tpt })
		return true
	end

	function C:_stop(u)
		local pos = self:unit_tile(u)
		local tick = self.tick
		u.path = { pos }
		u.start_tick = tick
		u.end_tick = tick
		self:ev({ Ev.UNIT_PATH, u.uid, u.path, tick, u.tpt })
	end

	-- =========================================================================================
	-- Per tick
	-- =========================================================================================

	function C:warships_tick()
		local list = self.warship_list
		if #list > 0 then
			local n = #list
			for i = 1, n do
				local u = list[i]
				if not u.dead then
					self:_warship_tick(u)
				end
				if i % 8 == 0 then
					Coop.check() -- (a local match's step is spread over frames: Session._local_process)
				end
			end
			local w = 0
			local m = #list
			for i = 1, m do
				local u2 = list[i]
				if not u2.dead then
					w += 1
					list[w] = u2
				end
			end
			for i = m, w + 1, -1 do
				list[i] = nil
			end
		end
		if self.defense_posts_shoot and self.tick % 10 == 0 then
			self:_posts_tick()
		end
		if #self.shells > 0 then
			self:_shells_tick()
		end
		local dl = self._hp_dirty_list
		if #dl > 0 then
			local units = self.units
			for _, uid in dl do
				local u3 = units[uid]
				if u3 ~= nil and not u3.dead then
					self:ev({ Ev.UNIT_HP, uid, u3.hp, u3.max_hp })
				end
			end
			table.clear(dl)
			table.clear(self._hp_dirty)
		end
	end

	function C:_warship_tick(u)
		if self.o_alive[u.owner] == 0 then
			self:remove_unit(u, Defs.DEL_DESTROYED)
			return
		end
		local pos = self:unit_tile(u)
		local hp_before = u.hp
		self:_heal(u, pos)
		if u.state == 2 then
			local port = self.structs[u.retreat_port]
			if port == nil or port.owner ~= u.owner or u.hp >= u.max_hp then
				self:_cancel_retreat(u)
			end
			if u.state == 2 then
				return
			end
		end
		if self:_handle_retreat(u, pos) then
			return
		end
		if self:_should_retreat(u, hp_before) then
			self:_start_retreat(u, pos)
			if self:_handle_retreat(u, pos) then
				return
			end
		end
		local tgt = nil
		if (self.tick + u.uid) % SCAN_TICKS == 0 then
			tgt = self:_find_target(u, pos, true)
			u.target_uid = if tgt ~= nil then tgt.uid else 0
		elseif u.target_uid ~= 0 then
			tgt = self.units[u.target_uid]
			if tgt == nil or tgt.dead or tgt.owner == u.owner or self:allied(tgt.owner, u.owner) then
				tgt = nil
				u.target_uid = 0
			end
		end
		if tgt ~= nil and tgt.kind ~= U_TRADE then
			self:_shoot(u, tgt, pos)
			self:_patrol(u)
			return
		end
		if tgt ~= nil then
			self:_hunt(u, tgt, pos)
			return
		end
		if u.hunt_uid ~= 0 then
			u.hunt_uid = 0
			u.target_tile = -1
		end
		self:_patrol(u)
	end

	-- Passive +1 HP/tick near an own port; docked ships share the port's level x 5 HP/tick.
	function C:_heal(u, pos: number)
		local range_d2 = self.range_d2
		local tick = self.tick
		if tick >= u.near_port_tick then
			u.near_port_tick = tick + 10
			u.near_port = false
			local r = Rules.WARSHIP_PASSIVE_HEAL_FULL / self.R.K_LIN
			local r2 = r * r
			for _, p in self.port_list do
				if p.owner == u.owner and range_d2(pos, p.tile) <= r2 then
					u.near_port = true
					break
				end
			end
		end
		local before = u.hp
		if u.near_port then
			u.hp = math.min(u.max_hp, u.hp + Rules.WARSHIP_PASSIVE_HEAL)
		end
		if u.state == 2 then
			local port = self.structs[u.retreat_port]
			if port ~= nil then
				local docked = self:_docked_at(port, nil)
				if docked > 0 then
					u.heal_rem += (port.level * Rules.WARSHIP_PORT_HEAL_PER_LEVEL) / docked
					local add = math.floor(u.heal_rem)
					if add > 0 then
						u.heal_rem -= add
						u.hp = math.min(u.max_hp, u.hp + add)
					end
				end
			end
		end
		if u.hp ~= before then
			self:_mark_hp(u.uid)
		end
	end

	function C:_patrol(u)
		if u.target_tile >= 0 and self.tick < u.end_tick then
			return
		end
		local pos = self:unit_tile(u)
		local t = self:_random_patrol_tile(u, pos, false)
		if t < 0 then
			t = self:_random_patrol_tile(u, pos, true)
		end
		if t < 0 or not self:_set_course(u, t, self.R.WARSHIP_TPT_X100) then
			u.target_tile = -1
			return
		end
		u.target_tile = t
	end

	-- Random patrol tile: a water tile of the ship's body within warshipPatrolRange / 2
	-- of its patrol tile (not on the shoreline unless nothing else is found; the box widens 1.5x
	-- up to three times).
	function C:_random_patrol_tile(u, pos: number, allow_shore: boolean): number
		local pt = if u.patrol >= 0 then u.patrol else pos
		local half = Rules.WARSHIP_PATROL_FULL / self.R.K_LIN / 2.0
		local nav = self.nav
		local nbody = nav.body
		local region = nav.region
		local terrain = self.map.terrain
		local shore_water = self.shore_water
		local rng = self.rng
		local bd = readu16(nbody, pos * 2)
		local W = self.W
		local H = self.H
		local cx = pt % W
		local cy = pt // W
		for _ = 1, 4 do
			local hy = Defs.trunc(half)
			local hx = self.geo_span(pt, half)
			for _ = 1, 40 do
				local x = cx + rng:randi_range(-hx, hx)
				local y = cy + rng:randi_range(-hy, hy)
				if y < 1 or y >= H - 1 or x < 0 or x >= W then
					continue
				end
				local t = y * W + x
				if readu8(terrain, t) > T_LAKE or readu16(nbody, t * 2) ~= bd or readi32(region, t * 4) < 0 then
					continue
				end
				if not allow_shore and readu8(shore_water, t) == 1 then
					continue
				end
				return t
			end
			half *= 1.5
		end
		return -1
	end

	-- =========================================================================================
	-- Targets and shells
	-- =========================================================================================

	function C:_build_ship_grid()
		local tick = self.tick
		self._ship_grid_tick = tick
		local grid = self._ship_grid
		-- (optimisation) only the cells filled last time need clearing
		local used = self._ship_cells_used
		for k = 1, #used do
			table.clear(grid[used[k]])
		end
		table.clear(used)
		local list = self.unit_list
		local n = #list
		local ship_pos = self._ship_pos
		local W = self.W
		local gw = self._ship_gw
		for i = 1, n do
			local u = list[i]
			if u.dead or u.kind == U_TRUCK then
				ship_pos[i] = -1
				continue
			end
			-- inlined unit_tile(u)
			local path = u.path
			local np = #path
			local p = -1
			if np > 0 then
				local tpt = u.tpt
				if tpt < 1 then
					tpt = 1
				end
				local idx = (tick - u.start_tick) * 100 // tpt
				if idx < 0 then
					idx = 0
				elseif idx > np - 1 then
					idx = np - 1
				end
				p = path[idx + 1]
			end
			ship_pos[i] = p
			if p >= 0 then
				local ci = ((p // W) // GCELL) * gw + (p % W) // GCELL + 1
				local cell = grid[ci]
				local m = #cell
				if m == 0 then
					used[#used + 1] = ci
				end
				cell[m + 1] = i
			end
		end
		for i = #ship_pos, n + 1, -1 do
			ship_pos[i] = nil
		end
	end

	-- Unit-list indices of ships within `r` tiles (box) of `pos`. Returns a scratch list (reused by
	-- the next call; callers never nest) and its length.
	function C:_ships_near(pos: number, r: number): ({ number }, number)
		if self._ship_grid_tick ~= self.tick then
			self:_build_ship_grid()
		end
		local out = self._near_scratch
		local n = 0
		local W = self.W
		local gw = self._ship_gw
		local px = pos % W
		local py = pos // W
		local ri = math.ceil(r)
		local rx = self.geo_span(pos, r)
		local gy0 = math.max(py - ri, 0) // GCELL
		local gy1 = math.min(py + ri, self.H - 1) // GCELL
		local gx0 = math.max(px - rx, 0) // GCELL
		local gx1 = math.min(px + rx, W - 1) // GCELL
		local grid = self._ship_grid
		for gy = gy0, gy1 do
			for g = gx0, gx1 do
				local cell = grid[gy * gw + g + 1]
				for k = 1, #cell do
					n += 1
					out[n] = cell[k]
				end
			end
		end
		return out, n
	end

	-- Best target: non-allied ships within warshipTargettingRange, transport > warship >
	-- trade ship, then nearest; skips docked warships and one-shot targets already shelled.
	-- Trade ships only with a reachable own port, within patrol range of the patrol tile, not
	-- hugging a shore (safe from pirates) and not bound for an own / allied port.
	function C:_find_target(u, pos: number, include_trade: boolean)
		local range_d2 = self.range_d2
		local r = self.R.warship_range()
		local r2 = r * r
		local pr = Rules.WARSHIP_PATROL_FULL / self.R.K_LIN
		local reachable = -1
		local best = nil
		local bp = 9
		local bd = 0.0
		local list = self.unit_list
		local ship_pos = self._ship_pos
		local shelled = u.shelled or EMPTY
		local near, nn = self:_ships_near(pos, r)
		for k = 1, nn do
			local idx = near[k]
			local v = list[idx]
			if v.dead or v == u or v.owner == u.owner or self:allied(v.owner, u.owner) or shelled[v.uid] then
				continue
			end
			local pri = 0
			local vk = v.kind
			if vk == U_TRANSPORT then
				pri = 0
			elseif vk == U_WARSHIP then
				if v.state == 2 then
					continue
				end
				pri = 1
			elseif vk == U_TRADE then
				if not include_trade then
					continue
				end
				pri = 2
			else
				continue
			end
			if pri > bp then
				continue
			end
			local vt = ship_pos[idx]
			local d = range_d2(pos, vt)
			if d > r2 then
				continue
			end
			if pri == 2 then
				if reachable < 0 then
					reachable = if self:_own_port_on(u.owner, readu16(self.nav.body, pos * 2)) ~= nil then 1 else 0
				end
				if reachable == 0 or u.patrol < 0 or self:_safe_from_pirates(v) then
					continue
				end
				local dst = self.structs[v.dst_sid]
				if dst ~= nil and (dst.owner == u.owner or self:allied(dst.owner, u.owner)) then
					continue
				end
				if range_d2(u.patrol, vt) > pr * pr then
					continue
				end
			end
			if best == nil or pri < bp or (pri == bp and d < bd) then
				best = v
				bp = pri
				bd = d
			end
		end
		return best
	end

	function C:_own_port_on(id: number, water_body: number)
		local nbody = self.nav.body
		for _, p in self.port_list do
			if p.owner == id and p.water >= 0 and readu16(nbody, p.water * 2) == water_body then
				return p
			end
		end
		return nil
	end

	-- A trade ship that sailed a shoreline tile in the last SAFE_FROM_PIRATES_TICKS is safe.
	function C:_safe_from_pirates(v): boolean
		local path = v.path
		local n = #path
		if n == 0 then
			return false
		end
		local tpt = math.max(v.tpt, 1)
		local idx = math.clamp((self.tick - v.start_tick) * 100 // tpt, 0, n - 1)
		local back = Rules.SAFE_FROM_PIRATES_TICKS * 100 // tpt + 1
		local shore_water = self.shore_water
		for i = math.max(0, idx - back), idx do
			if readu8(shore_water, path[i + 1]) == 1 then
				return true
			end
		end
		return false
	end

	-- Shooting: every WARSHIP_FIRE_TICKS (no reload between transports); one shell per
	-- one-shot target.
	function C:_shoot(u, tgt, pos: number)
		local tick = self.tick
		if tick - u.last_shot <= Rules.WARSHIP_FIRE_TICKS then
			return
		end
		if tgt.kind ~= U_TRANSPORT then
			u.last_shot = tick
		end
		self:_fire(0, u.uid, u.owner, pos, tgt, u.vet)
		if tgt.kind ~= U_WARSHIP then
			local shelled = u.shelled
			if shelled == nil then
				shelled = {}
				u.shelled = shelled
				u.shelled_n = 0
			end
			if not shelled[tgt.uid] then
				shelled[tgt.uid] = true
				u.shelled_n += 1
			end
			u.target_uid = 0
			if u.shelled_n > 64 then
				local units = self.units
				for k in shelled do
					if units[k] == nil then
						shelled[k] = nil
						u.shelled_n -= 1
					end
				end
			end
		end
	end

	function C:_fire(kind: number, shooter: number, owner_id: number, from: number, tgt, vet: number)
		local range_d2 = self.range_d2
		local tick = self.tick
		local s = Shell.new()
		s.id = self.next_shell_id
		self.next_shell_id += 1
		s.kind = kind
		s.shooter = shooter
		s.owner = owner_id
		s.target = tgt.uid
		s.from_tile = from
		s.fire_tick = tick
		s.impact_tick = tick + self.R.shell_flight_ticks(math.sqrt(range_d2(from, self:unit_tile(tgt))))
		s.damage = Rules.shell_damage(self.rng:randi_range(1, 5), vet)
		table.insert(self.shells, s)
		self:ev({ Ev.SHELL, s.id, kind, shooter, from, tgt.uid, tick, s.impact_tick, s.damage })
	end

	function C:_shells_tick()
		local tick = self.tick
		local keep = {}
		local due = {}
		for _, s in self.shells do
			if s.impact_tick > tick then
				table.insert(keep, s)
			else
				table.insert(due, s)
			end
		end
		self.shells = keep
		local units = self.units
		for _, s in due do
			local t = units[s.target]
			if t == nil or t.dead or t.owner == s.owner then
				continue
			end
			self:_hit(s, t)
		end
	end

	function C:_hit(s: Shell, t)
		local o_name = self.o_name
		local who = if s.kind == 0
			then string.format("%s's warship", o_name[s.owner])
			else string.format("%s's defenses", o_name[s.owner])
		if t.kind == U_TRANSPORT then
			self:remove_unit(t, Defs.DEL_DESTROYED)
			self:msg(t.owner, Defs.MSG_BAD, string.format("%s sank your transport", who))
			if s.kind == 0 then
				self:msg(
					s.owner,
					Defs.MSG_GOOD,
					string.format("Your warship sank a transport from %s", o_name[t.owner])
				)
			end
			self:_record_kill(s, U_TRANSPORT)
			self:_on_transport_sunk(t, s.owner)
		elseif t.kind == U_WARSHIP then
			t.hp = math.max(0, t.hp - s.damage)
			self:_mark_hp(t.uid)
			if t.hp <= 0 then
				self:remove_unit(t, Defs.DEL_DESTROYED)
				self:msg(t.owner, Defs.MSG_BAD, string.format("%s sank your warship", who))
				self:msg(s.owner, Defs.MSG_GOOD, string.format("You sank a warship from %s", o_name[t.owner]))
				self:_record_kill(s, U_WARSHIP)
			end
		end
	end

	-- Veterancy: a warship's final blow on a warship is +1 veterancy at once (progress
	-- wiped); a transport adds WARSHIP_VET_TRADES points of the TRANSPORTS x TRADES per level.
	function C:_record_kill(s: Shell, kind: number)
		if s.kind ~= 0 then
			return
		end
		local w = self.units[s.shooter]
		if w == nil or w.dead or w.kind ~= U_WARSHIP then
			return
		end
		if kind == U_WARSHIP then
			w.vet_progress = 0
			self:_vet_up(w)
		else
			self:_vet_progress(w, Rules.WARSHIP_VET_TRADES)
		end
	end

	function C:_vet_progress(w, points: number)
		local max_vet = Rules.WARSHIP_MAX_VET
		if w.vet >= max_vet then
			return
		end
		local per_level = Rules.WARSHIP_VET_TRANSPORTS * Rules.WARSHIP_VET_TRADES
		w.vet_progress += points
		while w.vet_progress >= per_level and w.vet < max_vet do
			w.vet_progress -= per_level
			self:_vet_up(w)
		end
		if w.vet >= max_vet then
			w.vet_progress = 0
		end
	end

	function C:_vet_up(w)
		if w.vet >= Rules.WARSHIP_MAX_VET then
			return
		end
		w.vet += 1
		w.max_hp = Rules.warship_max_hp(w.vet)
		self:_mark_hp(w.uid)
		self:ev({ Ev.UNIT_VET, w.uid, w.vet })
	end

	-- =========================================================================================
	-- Trade-ship hunting and capture
	-- =========================================================================================

	-- Trade-ship hunt: chase at 2 full-size tiles per tick; capture within warshipDockingRange
	-- (manhattan).
	function C:_hunt(u, tgt, pos: number)
		local geo_manhattan = self.geo_manhattan
		local tp = self:unit_tile(tgt)
		if geo_manhattan(pos, tp) <= Rules.WARSHIP_DOCK_FULL / self.R.K_LIN then
			self:_capture_trade(u, tgt, tp)
			u.target_uid = 0
			u.hunt_uid = 0
			u.target_tile = -1
			return
		end
		local tick = self.tick
		if u.hunt_uid ~= tgt.uid or tick - u.hunt_path_tick >= 10 or tick >= u.end_tick then
			u.hunt_uid = tgt.uid
			u.hunt_path_tick = tick
			u.target_tile = -2
			self:_set_course(u, tp, self.R.WARSHIP_HUNT_TPT_X100)
		end
	end

	-- The trade ship changes hands (UNIT_DEL "captured" + a new UNIT_ADD for the captor) and
	-- sails to the captor's nearest port on that water; its gold on arrival goes to the captor.
	function C:_capture_trade(u, v, vpos: number)
		local geo_manhattan = self.geo_manhattan
		local tick = self.tick
		local victim = v.owner
		local orig = if v.orig_owner ~= 0 then v.orig_owner else v.owner
		local tpt = math.max(v.tpt, 1)
		local sailed = v.traveled + math.clamp((tick - v.start_tick) * 100 // tpt, 0, math.max(#v.path - 1, 0))
		self:remove_unit(v, Defs.DEL_CAPTURED)
		self:_vet_progress(u, Rules.WARSHIP_VET_TRANSPORTS)
		local last = self._capture_msg_tick[victim]
		if tick - (if last == nil then -1000 else last) > 150 then
			self._capture_msg_tick[victim] = tick
			self:msg(
				victim,
				Defs.MSG_BAD,
				string.format("%s's warships are capturing your trade ships", self.o_name[u.owner])
			)
		end
		self:msg(
			u.owner,
			Defs.MSG_GOOD,
			string.format("Your warship captured a trade ship from %s", self.o_name[victim])
		)
		self:_on_trade_captured(victim, u.owner, vpos)
		local best = nil
		local bd = 0.0
		local nav = self.nav
		local nbody = nav.body
		local water = readu16(nbody, vpos * 2)
		for _, p in self.port_list do
			if p.owner ~= u.owner or p.water < 0 or readu16(nbody, p.water * 2) ~= water then
				continue
			end
			local d = geo_manhattan(vpos, p.tile)
			if best == nil or d < bd then
				best = p
				bd = d
			end
		end
		if best == nil then
			return
		end
		local path = nav:find_path(vpos, best.water)
		if #path < 2 then
			return
		end
		local w = Unit.new()
		w.kind = U_TRADE
		w.owner = u.owner
		w.path = path
		w.start_tick = tick
		w.tpt = self.R.TRADE_TPT_X100
		w.src_sid = v.src_sid
		w.dst_sid = best.sid
		w.body = v.body
		w.orig_owner = orig
		w.traveled = sailed
		w.end_tick = tick + ((#path - 1) * w.tpt + 99) // 100
		self:add_unit(w)
	end

	-- =========================================================================================
	-- Repair retreat and docking
	-- =========================================================================================

	function C:_should_retreat(u, hp_before: number): boolean
		if u.state ~= 0 or self.tick - u.manual_tick < Rules.WARSHIP_MANUAL_NO_RETREAT_TICKS then
			return false
		end
		if hp_before >= u.max_hp * Rules.WARSHIP_RETREAT_PCT // 100 then
			return false
		end
		return self.o_scount[u.owner * STRUCT_KINDS + S_PORT] > 0
	end

	function C:_start_retreat(u, pos: number)
		local p = self:_nearest_port(u, pos, false, nil)
		if p == nil then
			return
		end
		u.state = 1
		u.retreat_port = p.sid
		u.heal_rem = 0.0
		u.target_uid = 0
		u.hunt_uid = 0
		u.port_check_tick = self.tick + 10
		self:_emit_state(u)
	end

	function C:_cancel_retreat(u)
		u.state = 0
		u.retreat_port = 0
		u.heal_rem = 0.0
		u.target_tile = -1
		self:_emit_state(u)
	end

	-- Repair retreat: fire back at transports / warships in range, head for the retreat port
	-- (switching to a free or much nearer one), dock when within warshipDockingRange if the port
	-- has room (a port docks `level` ships).
	function C:_handle_retreat(u, pos: number): boolean
		local range_d2 = self.range_d2
		if u.state == 0 then
			return false
		end
		if (self.tick + u.uid) % SCAN_TICKS == 0 then
			local aggro = self:_find_target(u, pos, false)
			if aggro ~= nil then
				self:_shoot(u, aggro, pos)
			end
		end
		if not self:_refresh_retreat_port(u, pos) then
			self:_cancel_retreat(u)
			return false
		end
		local port = self.structs[u.retreat_port]
		local dock = Rules.WARSHIP_DOCK_FULL / self.R.K_LIN
		if range_d2(pos, port.tile) <= dock * dock then
			if self:_docked_at(port, u) < port.level then
				u.state = 2
				self:_stop(u)
				self:_emit_state(u)
				return true
			end
			if u.hp >= u.max_hp then
				self:_cancel_retreat(u)
				return false
			end
			return true
		end
		if u.target_tile ~= port.water or self.tick >= u.end_tick then
			if self:_set_course(u, port.water, self.R.WARSHIP_TPT_X100) then
				u.target_tile = port.water
			else
				local alt = self:_nearest_port(u, pos, true, u)
				if alt == nil or alt == port then
					self:_cancel_retreat(u)
					return false
				end
				u.retreat_port = alt.sid
			end
		end
		return true
	end

	function C:_refresh_retreat_port(u, pos: number): boolean
		local range_d2 = self.range_d2
		if self.o_scount[u.owner * STRUCT_KINDS + S_PORT] <= 0 then
			return false
		end
		local cur = self.structs[u.retreat_port]
		if cur == nil or cur.dead or cur.owner ~= u.owner or not cur.active then
			local np = self:_nearest_port(u, pos, true, u)
			u.retreat_port = if np ~= nil then np.sid else 0
			return np ~= nil
		end
		local tick = self.tick
		if tick < u.port_check_tick then
			return true
		end
		u.port_check_tick = tick + 10
		if self:_docked_at(cur, nil) >= cur.level then
			local alt = self:_nearest_port(u, pos, true, nil)
			if alt ~= nil then
				u.retreat_port = alt.sid
			end
			return true
		end
		local better = self:_nearest_port(u, pos, true, nil)
		if
			better ~= nil
			and better ~= cur
			and range_d2(pos, better.tile) < range_d2(pos, cur.tile) * Rules.WARSHIP_PORT_SWITCH
		then
			u.retreat_port = better.sid
		end
		return true
	end

	-- Nearest own finished port on the ship's water (optionally only ports with docking room).
	function C:_nearest_port(u, pos: number, available: boolean, exclude)
		local range_d2 = self.range_d2
		local nbody = self.nav.body
		local water = readu16(nbody, pos * 2)
		local best = nil
		local bd = 0.0
		for _, p in self.port_list do
			if p.owner ~= u.owner or p.water < 0 or readu16(nbody, p.water * 2) ~= water then
				continue
			end
			if available and self:_docked_at(p, exclude) >= p.level then
				continue
			end
			local d = range_d2(pos, p.tile)
			if best == nil or d < bd then
				best = p
				bd = d
			end
		end
		return best
	end

	function C:_docked_at(port, exclude): number
		local n = 0
		local sid = port.sid
		local owner = port.owner
		for _, w in self.warship_list do
			if not w.dead and w ~= exclude and w.state == 2 and w.retreat_port == sid and w.owner == owner then
				n += 1
			end
		end
		return n
	end

	-- =========================================================================================
	-- Defense posts (off unless defense_posts_shoot)
	-- =========================================================================================

	function C:_posts_tick()
		local range_d2 = self.range_d2
		local r = Rules.DEFENSE_POST_TARGET_FULL / self.R.K_LIN
		local r2 = r * r
		local tick = self.tick
		local list = self.unit_list
		for _, s in self.struct_list do
			if s.kind ~= S_DEFENSE or not s.active or s.dead then
				continue
			end
			local last = self._post_last[s.sid]
			if tick - (if last == nil then -100000 else last) <= Rules.DEFENSE_POST_SHELL_TICKS then
				continue
			end
			local best = nil
			local bp = 9
			local bd = 0.0
			local near, nn = self:_ships_near(s.tile, r)
			for k = 1, nn do
				local idx = near[k]
				local v = list[idx]
				if v.dead or v.owner == s.owner or self:allied(v.owner, s.owner) then
					continue
				end
				if v.kind ~= U_TRANSPORT and v.kind ~= U_WARSHIP then
					continue
				end
				if self._post_shelled[s.sid * 1048576 + v.uid] then
					continue
				end
				local d = range_d2(s.tile, self._ship_pos[idx])
				if d > r2 then
					continue
				end
				local pri = if v.kind == U_TRANSPORT then 0 else 1
				if best == nil or pri < bp or (pri == bp and d < bd) then
					best = v
					bp = pri
					bd = d
				end
			end
			if best == nil then
				continue
			end
			self._post_last[s.sid] = tick
			self:_fire(1, s.sid, s.owner, s.tile, best, 0)
			if best.kind == U_TRANSPORT then
				self._post_shelled[s.sid * 1048576 + best.uid] = true
			end
		end
	end

	-- =========================================================================================
	-- Hooks (the Sim forwards them to the AI) and snapshot
	-- =========================================================================================

	function C:_on_transport_sunk(_u, _killer: number) end

	function C:_on_trade_captured(_victim: number, _captor: number, _tile: number) end

	function C:shell_rows(): { { number } }
		local out = {}
		for _, s in self.shells do
			table.insert(out, { s.id, s.kind, s.shooter, s.from_tile, s.target, s.fire_tick, s.impact_tick, s.damage })
		end
		return out
	end
end

--- u8 buffer: 1 on water tiles 4-adjacent to contestable land (the water shoreline).
function SimWarships.shore_water(map: any): buffer
	local W, N = map.W, map.N
	local shore = buffer.create(N)
	local terrain = map.terrain
	local coast_list = map.coast_list
	for k = 0, map.coast_count - 1 do
		local c = readi32(coast_list, k * 4)
		local x = c % W
		if x > 0 and readu8(terrain, c - 1) <= T_LAKE then
			writeu8(shore, c - 1, 1)
		end
		if x < W - 1 and readu8(terrain, c + 1) <= T_LAKE then
			writeu8(shore, c + 1, 1)
		end
		if c >= W and readu8(terrain, c - W) <= T_LAKE then
			writeu8(shore, c - W, 1)
		end
		if c < N - W and readu8(terrain, c + W) <= T_LAKE then
			writeu8(shore, c + W, 1)
		end
	end
	return shore
end

return SimWarships
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Teams</string>
            <string name="Source"><![CDATA[--!strict
-- Team games: the teams of a match, who plays on which, and their colours.
-- Experimental, staging only (2026-10-10: team maps, and a party system so a player can join with
-- a friend).
--
-- The rules:
--   * the team list: a number of teams, or Duos / Trios / Quads (teams of 2 / 3 / 4: as many
--     teams as the players need, at least 2), or Humans Vs Nations. Up to 7 teams are named Red,
--     Blue, Yellow, Green, Purple, Orange, Teal;
--     more are "Team 1".."Team N";
--   * assignment: a team holds ceil(players / teams) at most. A group (a
--     party that joined together) goes whole onto the team with the fewest players. Everyone else in
--     join order goes where most of their group already is, else to the emptiest team (Duos / Trios /
--     Quads: the fullest one with room, so teams fill up one by one). The fillers come last, shuffled:
--     the bot players that fill a public match's empty slots;
--   * tribes are on no team (friendly to nobody);
--   * colours: a named team has a base colour and 64 shades of it around it (see shade);
--     a numbered team has one colour that its players share;
--   * nobody is left out: a group larger than a team spills over like anyone else, and a player
--     for whom every team is full joins the emptiest.

local Defs = require("./Defs")
local SimColors = require("./SimColors")

local Teams = {}

Teams.DUOS = "Duos"
Teams.TRIOS = "Trios"
Teams.QUADS = "Quads"
Teams.HVN = "Humans Vs Nations"
Teams.HUMANS = "Humans"
Teams.NATIONS = "Nations"
--- The named teams, in the order they are used.
Teams.NAMED = { "Red", "Blue", "Yellow", "Green", "Purple", "Orange", "Teal" }
--- The base colour of each team.
Teams.BASE = {
	Red = "#eb3333",
	Blue = "#2962ff",
	Yellow = "#e7b008",
	Green = "#41be52",
	Purple = "#9234ea",
	Orange = "#ff7f0e",
	Teal = "#06b6d4",
	Humans = "#2962ff",
	Nations = "#eb3333",
}
Teams.SHADES = 64

--- Players per team for Duos / Trios / Quads (nil: a number of teams, or Humans Vs Nations).
function Teams.group_size(config: any): number?
	if config == Teams.DUOS then
		return 2
	elseif config == Teams.TRIOS then
		return 3
	elseif config == Teams.QUADS then
		return 4
	end
	return nil
end

--- True when teams fill one by one (Duos / Trios / Quads) rather than evenly.
function Teams.packs(config: any): boolean
	return Teams.group_size(config) ~= nil
end

--- The team names for `config` (a number of teams, Duos / Trios / Quads, Humans Vs Nations) and
--- `players` players (humans and nations, counted at the start).
function Teams.resolve(config: any, players: number): { string }
	if config == Teams.HVN then
		return { Teams.HUMANS, Teams.NATIONS }
	end
	local n
	local size = Teams.group_size(config)
	if size ~= nil then
		n = math.max(2, math.ceil(players / size))
	else
		n = math.max(2, math.floor(tonumber(config) or 2))
	end
	local names = {}
	for i = 1, n do
		names[i] = if n < 8 then Teams.NAMED[i] else ("Team %d"):format(i)
	end
	return names
end

--- How a team game is described ("2 Teams", "Duos", "Humans Vs Nations").
function Teams.label(config: any): string
	if type(config) == "number" then
		return ("%d Teams"):format(config)
	end
	return tostring(config)
end

export type Player = {
	id: number,
	--- players who joined together (a party): kept on one team while it has room
	group: string?,
	--- fills the empty places after everyone else (a bot player)
	filler: boolean?,
}

--- Who plays on which team: id → team (1..#names). `players` in join order; the fillers among them are
--- placed last in `shuffle(fillers)`'s order (a seeded shuffle; nil: as given).
function Teams.assign(
	players: { Player },
	n_teams: number,
	packing: boolean,
	shuffle: ((list: { Player }) -> ())?
): { [number]: number }
	local out: { [number]: number } = {}
	local sizes = table.create(n_teams, 0)
	local max_size = math.ceil(#players / math.max(n_teams, 1))
	local function put(p: Player, t: number)
		out[p.id] = t
		sizes[t] += 1
	end
	-- the groups, largest first (stable), each onto the team with the fewest players
	local groups: { [string]: { Player } } = {}
	local order: { string } = {}
	for _, p in players do
		if p.group ~= nil and not p.filler then
			local g = groups[p.group]
			if g == nil then
				g = {}
				groups[p.group] = g
				table.insert(order, p.group)
			end
			table.insert(g, p)
		end
	end
	local rank = {}
	for i, key in order do
		rank[key] = i
	end
	table.sort(order, function(a: string, b: string): boolean
		if #groups[a] ~= #groups[b] then
			return #groups[a] > #groups[b]
		end
		return rank[a] < rank[b]
	end)
	local rest: { Player } = {}
	for _, key in order do
		local best = 1
		for t = 2, n_teams do
			if sizes[t] < sizes[best] then
				best = t
			end
		end
		for _, p in groups[key] do
			if sizes[best] < max_size then
				put(p, best)
			else
				table.insert(rest, p)
			end
		end
	end
	--- Placing a player: the team holding most of the player's group, then the emptiest
	--- (packing: the fullest) team with room, the first on ties.
	local function place(p: Player)
		local best, best_friends, best_size = 0, -1, if packing then -1 else math.huge
		for t = 1, n_teams do
			if sizes[t] >= max_size then
				continue
			end
			local friends = 0
			if p.group ~= nil then
				for _, q in players do
					if q.group == p.group and out[q.id] == t then
						friends += 1
					end
				end
			end
			local better = friends > best_friends
				or (friends == best_friends and (if packing then sizes[t] > best_size else sizes[t] < best_size))
			if better then
				best, best_friends, best_size = t, friends, sizes[t]
			end
		end
		if best == 0 then
			-- (every team full: the emptiest)
			best = 1
			for t = 2, n_teams do
				if sizes[t] < sizes[best] then
					best = t
				end
			end
		end
		put(p, best)
	end
	for _, p in rest do
		place(p)
	end
	local fillers: { Player } = {}
	for _, p in players do
		if out[p.id] == nil then
			if p.filler then
				table.insert(fillers, p)
			else
				place(p)
			end
		end
	end
	if shuffle ~= nil then
		shuffle(fillers)
	end
	for _, p in fillers do
		place(p)
	end
	return out
end

--- Shade i of a team's base colour, in OKLCH (lightness and chroma steps sized to OKLab's
--- ranges): i = 0 is the base colour.
local function shade(rgba: number, i: number): number
	if i <= 0 then
		return rgba
	end
	local lab = SimColors.oklab(rgba)
	local l, a, b = lab.x, lab.y, lab.z
	local c = math.sqrt(a * a + b * b)
	local h = math.deg(math.atan2(b, a))
	h = (h + ((i * 137.508) % 12) - 6 + 360) % 360
	c = math.clamp(c * (1 + 0.1 * math.sin(i * 0.7)), 0.03, 0.34)
	l = math.clamp(l + 0.18 * math.sin(math.rad(i * 137.508)), 0.32, 0.86)
	local hr = math.rad(h)
	return SimColors.to_rgba({ x = l, y = c * math.cos(hr), z = c * math.sin(hr) })
end

--- The colour of the `index`-th player (0-based) of team `name` (the `team`-th of the match).
function Teams.color(name: string, team: number, index: number): number
	local hex = Teams.BASE[name]
	if hex ~= nil then
		return shade(Defs.html_rgba(hex), index % Teams.SHADES)
	end
	-- a numbered team: one colour for all its players, the human palette's, spread out
	local pal = SimColors.human_palette()
	return pal[((team - 1) * 7) % #pal + 1]
end

return Teams
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">WorldMap</string>
            <string name="Source"><![CDATA[--!native
-- A playable map: static geography — terrain codes, water bodies, coasts and the flat grid
-- geometry every system uses. The maps are made by tools/maps/make_maps.py from public-domain
-- data: WorldMap.from_terrain(data) builds one from a data module,
-- WorldMap.get(id) returns the shared instance of a map id (built once per process),
-- WorldMap.shared() the default map (MapList.DEFAULT, "world").
--
-- Geometry: a flat W x H grid, no wrap; tile i = y * W + x (0-based);
-- neighbours are the 4 orthogonal tiles inside the map (our order: west, east, north, south);
-- distances are the squared euclidean distance (dist2 / range_d2) and the manhattan distance
-- (geo_manhattan) in tiles. The functions are closures stored on the map (map.dist2(a, b), no
-- ':'), so hot code captures them in locals; several maps may live in one process.
--
-- Scale: one of our tiles is `k_lin` full-resolution full-size tiles across (1.0 unless the
-- importer resampled the map to its tile budget); Rules.for_map(map) scales the rules' constants.
--
-- Representation (all 0-based by tile, read-only once built):
--   tile_bytes    u8  the full-size tile byte: bit 7 land, bit 6 shoreline, bit 5 ocean (water),
--                   bits 0-4 magnitude (land 0-30 elevation, 31 with no other bits = impassable;
--                   water min(ceil(dist to land / 2), 31) in full-res full-size tiles)
--   terrain     u8  Defs.T_* code: T_OCEAN (ocean bit) / T_LAKE water, T_PLAINS (< 10),
--                   T_HIGHLAND (10-19), T_MOUNTAIN (20-30) land, T_ICECAP impassable
--   land        u8  1 on contestable land (plains / highland / mountain)
--   water_body  u16 0 on land, 1 = the ocean (largest body), 2.. other 4-connected water bodies
--   coastal     u8  1 on contestable land 4-adjacent to water
--   coast_body  u16 the water body a coastal tile touches (first of west, east, north, south)
--   land_list / coast_list  i32 buffers of tile indices (land_count / coast_count entries)
--   nations     1-based {name, flag, x, y, tile} (tile -1 = no coordinates: random spawn)
local Defs = require("./Defs")
local MapCodec = require("./MapCodec")
local MapList = require("../Data/MapList")
local Tribes = require("../Data/Tribes")
local Coop = require("../Net/Coop")

local T_OCEAN = Defs.T_OCEAN
local T_LAKE = Defs.T_LAKE
local T_PLAINS = Defs.T_PLAINS
local T_HIGHLAND = Defs.T_HIGHLAND
local T_MOUNTAIN = Defs.T_MOUNTAIN
local T_ICECAP = Defs.T_ICECAP

local readu8 = buffer.readu8
local writeu8 = buffer.writeu8
local readu16 = buffer.readu16
local writeu16 = buffer.writeu16
local readi32 = buffer.readi32
local writei32 = buffer.writei32

local WorldMap = {}
WorldMap.__index = WorldMap

-- The ModuleScript in Roblox (nil under Lune).
local RBX_SCRIPT: any = script

--- Full-size tile byte of impassable terrain.
WorldMap.TB_IMPASSABLE = 0x9F

export type WorldMap = typeof(setmetatable(
	{} :: {
		id: string,
		name: string,
		W: number,
		H: number,
		N: number,
		k_lin: number,
		k_area: number,
		--- build size relative to the map's data (1, or < 1 for a smaller build: "id@80")
		scale: number,
		tile_bytes: buffer,
		terrain: buffer,
		land: buffer,
		water_body: buffer,
		water_body_count: number,
		coastal: buffer,
		coast_body: buffer,
		land_list: buffer,
		land_count: number,
		coast_list: buffer,
		coast_count: number,
		contestable_count: number,
		nations: { any },
		meta: { [string]: any },
		dist2: (number, number) -> number,
		range_d2: (number, number) -> number,
		geo_manhattan: (number, number) -> number,
		geo_span: (number, number) -> number,
		gc_dist: (number, number) -> number,
		ok: boolean,
	},
	WorldMap
))

-- =============================================================================================
-- Construction
-- =============================================================================================

--- Installs the flat grid metrics (closures over W) on `m`.
local function install_geometry(m: any)
	local W = m.W
	local W1 = W - 1
	--- Squared euclidean distance in tiles.
	local function dist2(a: number, b: number): number
		local dx = a % W - b % W
		local dy = a // W - b // W
		return dx * dx + dy * dy
	end
	--- Manhattan distance in tiles.
	local function manhattan(a: number, b: number): number
		local dx = a % W - b % W
		if dx < 0 then
			dx = -dx
		end
		local dy = a // W - b // W
		if dy < 0 then
			dy = -dy
		end
		return dx + dy
	end
	--- Columns a box query around a tile must span to cover a radius of `r` tiles.
	local function span(_center: number, r: number): number
		local s = math.ceil(r)
		return if s > W1 then W1 else s
	end
	--- Straight-line distance in tiles.
	local function dist(a: number, b: number): number
		local dx = a % W - b % W
		local dy = a // W - b // W
		return math.sqrt(dx * dx + dy * dy)
	end
	m.dist2 = dist2
	m.range_d2 = dist2
	m.geo_manhattan = manhattan
	m.geo_span = span
	m.gc_dist = dist
	m.tile_distance = dist
end

--- An empty W x H map (all water) with its geometry; fill tile_bytes and call _derive().
function WorldMap.new(w: number, h: number): WorldMap
	local n = w * h
	local self = setmetatable({
		id = "",
		name = "",
		W = w,
		H = h,
		N = n,
		k_lin = 1.0,
		k_area = 1.0,
		scale = 1.0,
		tile_bytes = buffer.create(n),
		terrain = buffer.create(n),
		land = buffer.create(n),
		water_body = buffer.create(n * 2),
		water_body_count = 0,
		coastal = buffer.create(n),
		coast_body = buffer.create(n * 2),
		land_list = buffer.create(0),
		land_count = 0,
		coast_list = buffer.create(0),
		coast_count = 0,
		contestable_count = 0,
		nations = {},
		meta = {},
		ok = false,
	}, WorldMap) :: any
	install_geometry(self)
	return self
end

--- Builds a map from a map data table (a src/server/MapData module, or the same fields
--- fetched from the server): {id, name, width, height, k_lin, nations = {{name, flag, x, y}},
--- terrain = base64(zstd(bytes)) string or a buffer of raw bytes, codec?, ...}.
--- `scale` (< 1): build the map that many times smaller in width and height (public matches play
--- maps a bit smaller; see WorldMap.split_id).
function WorldMap.from_terrain(data: { [string]: any }, scale: number?): WorldMap
	local w0 = data.width
	local h0 = data.height
	assert(type(w0) == "number" and type(h0) == "number" and w0 > 0 and h0 > 0, "WorldMap: bad map size")
	local s = math.clamp(scale or 1.0, 0.25, 1.0)
	local w = if s < 1.0 then math.max(8, math.floor(w0 * s + 0.5)) else w0
	local h = if s < 1.0 then math.max(8, math.floor(h0 * s + 0.5)) else h0
	local m = WorldMap.new(w, h)
	m.id = tostring(data.id or "")
	m.name = tostring(data.name or m.id)
	m.scale = w / w0
	-- a tile of a smaller build covers more full-size tiles
	m.k_lin = (tonumber(data.k_lin) or 1.0) * (w0 / w)
	m.k_area = m.k_lin * m.k_lin
	local meta = {}
	for k, v in data do
		if k ~= "terrain" and k ~= "nations" then
			meta[k] = v
		end
	end
	m.meta = meta
	Coop.check()
	local bytes = MapCodec.terrain_bytes(data)
	if w ~= w0 or h ~= h0 then
		Coop.check()
		bytes = WorldMap._resample(bytes, w0, h0, w, h)
	end
	m.tile_bytes = bytes
	Coop.check()
	m:_derive()
	local nations = {}
	for _, nd in data.nations or {} do
		local x = tonumber(nd.x)
		local y = tonumber(nd.y)
		local tile = -1
		if x ~= nil and y ~= nil then
			x = math.clamp(math.floor(x * w / w0), 0, w - 1)
			y = math.clamp(math.floor(y * h / h0), 0, h - 1)
			tile = y * w + x
		end
		table.insert(nations, { name = tostring(nd.name or "Nation"), region = nd.region, flag = nd.flag, x = x, y = y, tile = tile })
	end
	m.nations = nations
	m.ok = true
	return m
end

--- Tile bytes of a w0 x h0 map resampled to w x h (smaller): each tile takes the full-size tile
--- under its centre — elevation and water depth are in full-res full-size tiles, so they stay valid — then the
--- shoreline bit (0x40: land beside water or water beside land) is recomputed for the new grid.
function WorldMap._resample(src: buffer, w0: number, h0: number, w: number, h: number): buffer
	local out = buffer.create(w * h)
	local xs = table.create(w, 0)
	for x = 0, w - 1 do
		xs[x + 1] = math.min(w0 - 1, math.floor((x + 0.5) * w0 / w))
	end
	for y = 0, h - 1 do
		if y % 64 == 0 then
			Coop.check()
		end
		local row = math.min(h0 - 1, math.floor((y + 0.5) * h0 / h)) * w0
		local o = y * w
		for x = 0, w - 1 do
			writeu8(out, o + x, readu8(src, row + xs[x + 1]))
		end
	end
	local function is_land(i: number): boolean
		return readu8(out, i) >= 128
	end
	for y = 0, h - 1 do
		if y % 64 == 0 then
			Coop.check()
		end
		for x = 0, w - 1 do
			local i = y * w + x
			local b = readu8(out, i)
			if b == 0x9F then
				continue -- impassable keeps its byte
			end
			local l = b >= 128
			local shore = (x > 0 and is_land(i - 1) ~= l)
				or (x < w - 1 and is_land(i + 1) ~= l)
				or (y > 0 and is_land(i - w) ~= l)
				or (y < h - 1 and is_land(i + w) ~= l)
			local nb = if shore then bit32.bor(b, 0x40) else bit32.band(b, 0xBF)
			if nb ~= b then
				writeu8(out, i, nb)
			end
		end
	end
	return out
end

--- Map ids can carry a size: "world@80" is map "world" at 80 % of its width and height. The base id
--- and the linear scale (1 without a suffix).
function WorldMap.split_id(id: string): (string, number)
	local base, pct = string.match(id, "^(.-)@(%d+)$")
	if base ~= nil and base ~= "" then
		return base, math.clamp(tonumber(pct) or 100, 25, 100) / 100
	end
	return id, 1.0
end

--- Derives terrain codes, land, water bodies and coasts from tile_bytes.
function WorldMap._derive(self: WorldMap)
	local W, H, N = self.W, self.H, self.N
	local of = self.tile_bytes
	local terrain = self.terrain
	local land = self.land
	-- 1. terrain codes
	local nl = 0
	for i = 0, N - 1 do
		if i % 262144 == 0 then
			Coop.check()
		end
		local b = readu8(of, i)
		local code
		if b < 128 then
			code = if bit32.band(b, 0x20) ~= 0 then T_OCEAN else T_LAKE
		elseif b == 0x9F then
			code = T_ICECAP
		else
			local mag = bit32.band(b, 0x1F)
			code = if mag < 10 then T_PLAINS elseif mag < 20 then T_HIGHLAND else T_MOUNTAIN
			writeu8(land, i, 1)
			nl += 1
		end
		writeu8(terrain, i, code)
	end
	-- 2. water bodies (4-connected flood fill; the ocean-bit body is 1, others 2.. in scan order)
	local body = self.water_body
	local stack = buffer.create(4 * 65536)
	local cap = 65536
	local next_id = 2
	local function fill(start: number, id: number)
		writeu16(body, start * 2, id)
		writei32(stack, 0, start)
		local sp = 1
		while sp > 0 do
			sp -= 1
			local t = readi32(stack, sp * 4)
			local x = t % W
			for k = 1, 4 do
				local u
				if k == 1 then
					if x == 0 then
						continue
					end
					u = t - 1
				elseif k == 2 then
					if x == W - 1 then
						continue
					end
					u = t + 1
				elseif k == 3 then
					if t < W then
						continue
					end
					u = t - W
				else
					if t >= N - W then
						continue
					end
					u = t + W
				end
				if readu8(of, u) < 128 and readu16(body, u * 2) == 0 then
					writeu16(body, u * 2, id)
					if sp >= cap then
						local grown = buffer.create(cap * 8)
						buffer.copy(grown, 0, stack, 0, cap * 4)
						stack = grown
						cap *= 2
					end
					writei32(stack, sp * 4, u)
					sp += 1
				end
			end
		end
	end
	local ocean_done = false
	for i = 0, N - 1 do
		if i % 262144 == 0 then
			Coop.check()
		end
		local b = readu8(of, i)
		if b < 128 and readu16(body, i * 2) == 0 then
			if not ocean_done and bit32.band(b, 0x20) ~= 0 then
				ocean_done = true
				fill(i, 1)
			else
				if next_id > 65535 then
					error("WorldMap: more than 65534 water bodies")
				end
				fill(i, next_id)
				next_id += 1
			end
		end
	end
	self.water_body_count = next_id - 1
	-- 3. land and coast lists
	local land_list = buffer.create(nl * 4)
	local coastal = self.coastal
	local coast_body = self.coast_body
	local coast_tmp = buffer.create(math.max(nl, 1) * 4)
	local li, nc = 0, 0
	for i = 0, N - 1 do
		if i % 262144 == 0 then
			Coop.check()
		end
		if readu8(land, i) == 0 then
			continue
		end
		writei32(land_list, li * 4, i)
		li += 1
		local x = i % W
		local cb = 0
		if x > 0 and readu8(of, i - 1) < 128 then
			cb = readu16(body, (i - 1) * 2)
		end
		if cb == 0 and x < W - 1 and readu8(of, i + 1) < 128 then
			cb = readu16(body, (i + 1) * 2)
		end
		if cb == 0 and i >= W and readu8(of, i - W) < 128 then
			cb = readu16(body, (i - W) * 2)
		end
		if cb == 0 and i < N - W and readu8(of, i + W) < 128 then
			cb = readu16(body, (i + W) * 2)
		end
		if cb ~= 0 then
			writeu8(coastal, i, 1)
			writeu16(coast_body, i * 2, cb)
			writei32(coast_tmp, nc * 4, i)
			nc += 1
		end
	end
	local coast_list = buffer.create(nc * 4)
	buffer.copy(coast_list, 0, coast_tmp, 0, nc * 4)
	self.land_list = land_list
	self.land_count = nl
	self.coast_list = coast_list
	self.coast_count = nc
	self.contestable_count = nl
	local _ = H
end

-- =============================================================================================
-- Registry (one shared instance per map id per process)
-- =============================================================================================

local cache: { [string]: WorldMap } = {}
local data_cache: { [string]: { [string]: any } } = {}
local providers: { (string) -> { [string]: any }? } = {}

--- Registers a data source: fn(id) → map data table or nil. The server registers one that
--- requires src/server/MapData modules; the client registers what MapFetch downloaded.
function WorldMap.add_provider(fn: (string) -> { [string]: any }?)
	table.insert(providers, fn)
end

--- Makes a data table available for `id` (e.g. fetched from the server).
function WorldMap.put_data(id: string, data: { [string]: any })
	data_cache[(WorldMap.split_id(id))] = data
end

--- Raw data of map `id` (nil when no provider has it; cached). Replicated maps (MapList
--- `replicated`) are required from Data/Maps; under Lune the server MapData folder is read directly.
--- Call it once outside coroutine jobs (Session does): Lune's require may yield.
function WorldMap.load_data(id: string): { [string]: any }?
	id = (WorldMap.split_id(id))
	local d = data_cache[id]
	if d == nil then
		d = WorldMap._load_data(id)
		if d ~= nil then
			data_cache[id] = d
		end
	end
	return d
end

function WorldMap._load_data(id: string): { [string]: any }?
	for _, p in providers do
		local ok, res = pcall(p, id)
		if ok and type(res) == "table" then
			return res
		end
	end
	local row = MapList.get(id)
	local module = if row ~= nil then row.module else nil
	if module == nil then
		return nil
	end
	local ok, res = pcall(function(): any
		if RBX_SCRIPT ~= nil then
			-- Roblox: replicated maps live in ReplicatedStorage.Airfront.Data.Maps.
			local data = RBX_SCRIPT.Parent.Parent:FindFirstChild("Data")
			local maps = if data ~= nil then data:FindFirstChild("Maps") else nil
			local mod = if maps ~= nil then maps:FindFirstChild(module) else nil
			return if mod ~= nil then (require :: any)(mod) else nil
		end
		return (require :: any)("../Data/Maps/" .. module)
	end)
	if ok and type(res) == "table" then
		return res
	end
	if RBX_SCRIPT == nil then
		-- Lune: tests and tools read the server data modules straight from the source tree.
		local ok2, res2 = pcall(function()
			return (require :: any)("../../server/MapData/" .. module)
		end)
		if ok2 and type(res2) == "table" then
			return res2
		end
	end
	return nil
end

--- True when map `id` is built or its data can be loaded without a network fetch.
function WorldMap.available(id: string): boolean
	return cache[id] ~= nil or WorldMap.load_data(id) ~= nil
end

--- The shared map `id` (built on first use; errors when its data is unavailable — clients fetch
--- non-replicated maps with MapFetch first).
function WorldMap.get(id: string?): WorldMap
	local key = id or MapList.DEFAULT
	local m = cache[key]
	if m == nil then
		local data = WorldMap.load_data(key)
		if data == nil then
			error("WorldMap: map '" .. tostring(key) .. "' is not available")
		end
		local _, scale = WorldMap.split_id(key)
		m = WorldMap.from_terrain(data, scale)
		if m.id == "" or scale < 1.0 then
			m.id = key
		end
		cache[key] = m
	end
	return m :: WorldMap
end

--- Id of the default map.
WorldMap.DEFAULT = MapList.DEFAULT

--- The default map (MapList.DEFAULT).
function WorldMap.shared(): WorldMap
	return WorldMap.get(MapList.DEFAULT)
end

--- Drops a cached map (tests / memory pressure). Sims holding it keep their reference.
function WorldMap.release(id: string)
	cache[id] = nil
end

-- =============================================================================================
-- Queries
-- =============================================================================================

function WorldMap.tile_x(self: WorldMap, i: number): number
	return i % self.W
end

function WorldMap.tile_y(self: WorldMap, i: number): number
	return i // self.W
end

--- Tile at (x, y), or -1 outside the map.
function WorldMap.tile_index(self: WorldMap, x: number, y: number): number
	if x < 0 or y < 0 or x >= self.W or y >= self.H then
		return -1
	end
	return y * self.W + x
end

function WorldMap.in_bounds(self: WorldMap, i: number): boolean
	return i >= 0 and i < self.N
end

function WorldMap.is_water(self: WorldMap, i: number): boolean
	return readu8(self.terrain, i) <= T_LAKE
end

--- Land in the broad sense (contestable land or impassable terrain).
function WorldMap.is_land(self: WorldMap, i: number): boolean
	return readu8(self.terrain, i) >= T_PLAINS
end

function WorldMap.is_contestable(self: WorldMap, i: number): boolean
	return readu8(self.land, i) == 1
end

function WorldMap.is_impassable(self: WorldMap, i: number): boolean
	return readu8(self.tile_bytes, i) == 0x9F
end

function WorldMap.is_coastal(self: WorldMap, i: number): boolean
	return readu8(self.coastal, i) == 1
end

--- Water body id of tile `i` (0 on land).
function WorldMap.body_of(self: WorldMap, i: number): number
	return readu16(self.water_body, i * 2)
end

--- Water body a coastal land tile touches (0 when not coastal).
function WorldMap.coast_body_of(self: WorldMap, i: number): number
	return readu16(self.coast_body, i * 2)
end

--- Land tile number `k` (0-based, k < land_count).
function WorldMap.land_tile(self: WorldMap, k: number): number
	return readi32(self.land_list, k * 4)
end

function WorldMap.coast_tile(self: WorldMap, k: number): number
	return readi32(self.coast_list, k * 4)
end

--- 4-neighbourhood inside the map as a 1-based array (west, east, north, south; allocates —
--- avoid in hot loops, use neighbor()).
function WorldMap.neighbors4(self: WorldMap, i: number): { number }
	local W = self.W
	local x = i % W
	local out = {}
	if x > 0 then
		table.insert(out, i - 1)
	end
	if x < W - 1 then
		table.insert(out, i + 1)
	end
	if i >= W then
		table.insert(out, i - W)
	end
	if i < self.N - W then
		table.insert(out, i + W)
	end
	return out
end

--- Neighbour in direction d (0 west, 1 east, 2 north, 3 south); -1 past the map edge.
function WorldMap.neighbor(self: WorldMap, i: number, d: number): number
	local W = self.W
	local x = i % W
	if d == 0 then
		return if x > 0 then i - 1 else -1
	elseif d == 1 then
		return if x < W - 1 then i + 1 else -1
	elseif d == 2 then
		return if i >= W then i - W else -1
	end
	return if i < self.N - W then i + W else -1
end

--- Tile centre in map space (x right, y down, in tiles).
function WorldMap.tile_center(self: WorldMap, i: number): (number, number)
	local W = self.W
	return i % W + 0.5, i // W + 0.5
end

--- Tile containing map-space point (x, y) (clamped to the map).
function WorldMap.point_tile(self: WorldMap, x: number, y: number): number
	local tx = math.clamp(math.floor(x), 0, self.W - 1)
	local ty = math.clamp(math.floor(y), 0, self.H - 1)
	return ty * self.W + tx
end

--- Nation spawn list of the map (1-based {name, flag, x, y, tile}).
function WorldMap.load_nations(self: WorldMap): { any }
	return self.nations
end

--- Tribe names (1-based array; Data/Tribes).
function WorldMap.load_tribe_names(): { string }
	return (Tribes :: any).names
end

return WorldMap
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="50">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Arsenal</string>
            <string name="Source"><![CDATA[--!strict
-- The Arsenal: units and boosters a player unlocks for good (2026-10-04: units like Artillery and
-- special nukes, unlocked either by grinding Stars in game or by buying them with Robux — the same model
-- as Pixel Conquest's extra-buildings passes, with its prices).
--
--   stars    the price in Stars, the currency earned by playing (Data/Stars); nil: Robux only
--   product  the developer product that unlocks it for Robux (Data/Products; its `robux` is the
--            price shown until Roblox answers with the real one)
--   bonus    Stars paid once with the unlock, however it was bought
--   bit      the Defs.UNLOCK bit the Sim checks (0: the Sim doesn't care — 2x Stars)
--
-- An unlock is saved on the player's record (server/Purchases: `unlocks`), by ProcessReceipt for a
-- Robux purchase or by Purchases.buy_unlock for Stars. The rules and numbers of each unit are the
-- Sim's (Core/Rules "The Arsenal", Core/SimArsenal); the copy here only describes them.
local IS_ROBLOX = typeof(game) == "Instance"
local Defs: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Core.Defs)
	else require("../Core/Defs")

local Arsenal = {}

export type Item = {
	key: string,
	title: string,
	--- "structure" (built on your land), "nuke" (launched from a silo), "strike" (fired from its
	--- structure), "call" (an instant order), "boost" (always on)
	kind: string,
	icon: string,
	tagline: string,
	blurb: string,
	perks: { string },
	--- the shop's one sentence: what it does, in plain words (2026-10-24: the Arsenal UI was too
	--- confusing and had to be simpler)
	plain: string,
	--- the shop's two short facts
	facts: { string },
	stars: number?,
	product: string,
	bonus: number?,
	bit: number,
	--- the build / launch kinds it opens in a match (UIRules kinds)
	opens: { string },
	--- card colours (top, bottom), 0xRRGGBB
	color: { number },
}

--- In shop order: cheapest in Stars first, the Robux-only boosters last.
Arsenal.ITEMS = {
	{
		key = "mega",
		title = "Tailed Beast Bomb (Bijūdama)",
		kind = "nuke",
		icon = "mega",
		tagline = "Rank 3 · Jinchūriki technique",
		blurb = "Roll a Tailed Beast Bomb across the ground, crushing enemies along the way before the final blast.",
		perks = { "60-TILE OUTER RADIUS", "2.5M GOLD PER CAST" },
		plain = "Roll a Tailed Beast Bomb across the ground, crushing enemies along the way before the final blast.",
		facts = { "Jinchūriki technique", "20,000 Stars" },
		stars = 20000,
		product = "unlock_mega",
		bit = Defs.UNLOCK.mega,
		opens = { "mega" },
		color = { 0xE2483A, 0x7A1420 },
	},
	{
		key = "scatter",
		title = "Tengai Shinsei",
		kind = "nuke",
		icon = "scatter",
		tagline = "Rank 1 · Madara's meteor",
		blurb = "Drop a massive meteor from the sky. Four to six fragments strike around the impact.",
		perks = { "140-TILE OUTER RADIUS", "12M GOLD PER CAST" },
		plain = "Drop a massive meteor from the sky. Four to six fragments strike around the impact.",
		facts = { "Madara's meteor", "40,000 Stars" },
		stars = 40000,
		product = "unlock_scatter",
		bit = Defs.UNLOCK.scatter,
		opens = { "scatter" },
		color = { 0xF08A24, 0x8A3A0C },
	},
	{
		key = "reinforce",
		title = "Shadow Clone Technique",
		kind = "call",
		icon = "reinforce",
		tagline = "Summon clones for gold",
		blurb = "Summon clones equal to 20% of your troop cap for 100K gold.",
		perks = { "+20% TROOPS", "EVERY 30 SECONDS" },
		plain = "Summon clones equal to 20% of your troop cap for 100K gold.",
		facts = { "Summon clones for gold", "40,000 Stars" },
		stars = 40000,
		product = "unlock_reinforce",
		bit = Defs.UNLOCK.reinforce,
		opens = { "reinforce" },
		color = { 0x35B86B, 0x0E5A34 },
	},
	{
		key = "artillery",
		title = "Great Fireball Technique",
		kind = "structure",
		icon = "artillery",
		tagline = "Automatic Fire Release",
		blurb = "Build a shrine that casts fireballs at nearby enemies.",
		perks = { "AUTOMATIC CAST", "45-TILE RANGE" },
		plain = "Build a shrine that casts fireballs at nearby enemies.",
		facts = { "Automatic Fire Release", "5,000 bonus Stars" },
		stars = 50000,
		product = "unlock_artillery",
		bonus = 5000,
		bit = Defs.UNLOCK.artillery,
		opens = { "artillery" },
		color = { 0x4C8DF0, 0x1A3A8A },
	},
	{
		key = "airfield",
		title = "Summoning: Toad Oil Flame Bullet",
		kind = "structure",
		icon = "airfield",
		-- (2026-10-12: the tagline says this unlock is what lets you build Airfields)
		tagline = "Fire Release with a toad summon",
		blurb = "Build a Summoning Shrine and cast the jutsu within 156 tiles.",
		perks = { "156-TILE RANGE", "30-SECOND COOLDOWN" },
		plain = "Build a Summoning Shrine and cast the jutsu within 156 tiles.",
		facts = { "Fire Release with a toad summon", "5,000 bonus Stars" },
		stars = 200000,
		product = "unlock_airfield",
		bonus = 5000,
		bit = Defs.UNLOCK.airfield,
		opens = { "airfield", "airstrike" },
		color = { 0x2FB7C9, 0x0D5670 },
	},
	{
		key = "railgun",
		title = "Lightning Cutter",
		kind = "structure",
		icon = "railgun",
		tagline = "Focused Lightning Release",
		blurb = "Build a Lightning Shrine and strike structures anywhere on the map.",
		perks = { "GLOBAL RANGE", "25-SECOND COOLDOWN" },
		plain = "Build a Lightning Shrine and strike structures anywhere on the map.",
		facts = { "Focused Lightning Release", "Cannot be intercepted" },
		stars = 500000,
		product = "unlock_railgun",
		bit = Defs.UNLOCK.railgun,
		opens = { "railgun", "slug" },
		color = { 0xA35BFF, 0x3D1A8A },
	},
	{
		key = "stars2x",
		title = "2x Stars",
		kind = "boost",
		icon = "star",
		tagline = "Every match pays double, forever",
		blurb = "Doubles the Stars every match pays you, for good.",
		perks = { "DOUBLE STARS", "EVERY MATCH" },
		plain = "Every match pays you double Stars, forever.",
		facts = { "2x Stars", "Every match" },
		product = "unlock_stars2x",
		bit = 0,
		opens = {},
		color = { 0xFFC83D, 0x9A6200 },
	},
	{
		key = "reload2x",
		title = "Rapid Reload",
		kind = "boost",
		icon = "reload",
		tagline = "Everything you own reloads twice as fast",
		blurb = "Your Missile Silos, SAMs, Artillery, Airfields and Railguns all reload in half the time.",
		perks = { "2X RELOAD SPEED", "ALL STRUCTURES" },
		plain = "Your silos, SAMs, cannons, airfields and railguns reload twice as fast.",
		facts = { "2x reload", "Everything you build" },
		product = "unlock_reload2x",
		bit = Defs.UNLOCK.reload2x,
		opens = {},
		color = { 0xE85BB0, 0x7A1A5A },
	},
} :: { Item }

local BY_KEY: { [string]: Item } = {}
--- build / launch kind -> the item that opens it
local BY_KIND: { [string]: Item } = {}
for _, it in Arsenal.ITEMS do
	BY_KEY[it.key] = it
	for _, k in it.opens do
		BY_KIND[k] = it
	end
end

function Arsenal.item(key: any): Item?
	return if type(key) == "string" then BY_KEY[key] else nil
end

--- The item a build / launch kind ("artillery", "mega", "airstrike", "reinforce"...) belongs to, or nil
--- for the kinds everyone has.
function Arsenal.item_for(kind: string): Item?
	return BY_KIND[kind]
end

--- The Defs.UNLOCK mask of a set of unlock keys ({ [key] = true } or a list of keys).
function Arsenal.mask(unlocks: any): number
	local m = 0
	if type(unlocks) ~= "table" then
		return m
	end
	for k, v in unlocks do
		local it = BY_KEY[if type(k) == "string" then k else v]
		if it ~= nil and (v == true or type(k) == "number") then
			m = bit32.bor(m, it.bit)
		end
	end
	return m
end

--- The cheapest item (in Stars) the player doesn't own yet: what the Stars they earn go towards.
function Arsenal.next_goal(owned: { [string]: boolean }): Item?
	for _, it in Arsenal.ITEMS do
		if it.stars ~= nil and not owned[it.key] then
			return it
		end
	end
	return nil
end

return Arsenal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">BotNames</string>
            <string name="Source"><![CDATA[--!strict
-- Names for bot players (the AI commanders that fill empty public-match slots). By design they look
-- like ordinary player names (2026-09-26, so that bots pass for real
-- players): gamer-style handles built from word lists, e.g. "IronFalcon", "nova_ryder",
-- "Blaze27", "QuietStorm_9". Deterministic for a given random source (the Sim's RNG), unique within
-- one call's `taken` set.

local BotNames = {}

local FIRST = {
	"Iron",
	"Nova",
	"Shadow",
	"Silent",
	"Frost",
	"Blaze",
	"Storm",
	"Lunar",
	"Solar",
	"Crimson",
	"Echo",
	"Rogue",
	"Swift",
	"Atlas",
	"Ember",
	"Onyx",
	"Cobalt",
	"Viper",
	"Rapid",
	"Quiet",
	"Night",
	"Golden",
	"Wild",
	"Bright",
	"Dark",
	"Lucky",
	"Mighty",
	"Neon",
	"Pixel",
	"Turbo",
	"Arctic",
	"Stealth",
	"Hyper",
	"Royal",
	"Sly",
	"Brave",
	"Cosmic",
	"Mystic",
	"Rusty",
	"Titan",
	"Zen",
	"Aqua",
	"Lazy",
	"Epic",
	"Chill",
	"Sonic",
	"Venom",
	"Ghost",
	"Alpha",
	"Omega",
	"Red",
	"Blue",
	"Grey",
	"Jade",
	"Scarlet",
	"Amber",
	"Polar",
	"Desert",
	"Jungle",
	"Coastal",
}

local SECOND = {
	"Falcon",
	"Ryder",
	"Wolf",
	"Storm",
	"Tide",
	"Fox",
	"Hawk",
	"Knight",
	"Raven",
	"Tiger",
	"Comet",
	"Pilot",
	"Ranger",
	"Viking",
	"Ninja",
	"Dragon",
	"Panther",
	"Orbit",
	"Arrow",
	"Bolt",
	"Blade",
	"Spark",
	"Rider",
	"Hunter",
	"Legend",
	"Sniper",
	"Warden",
	"Captain",
	"Baron",
	"Rebel",
	"Nomad",
	"Phantom",
	"Racer",
	"Sparrow",
	"Bear",
	"Lynx",
	"Cobra",
	"Shark",
	"Owl",
	"Stag",
	"Mage",
	"Scout",
	"Pirate",
	"Samurai",
	"Duke",
	"General",
	"Major",
	"Titan",
	"Golem",
	"Kraken",
	"Moose",
	"Otter",
	"Badger",
	"Falcon",
	"Jester",
	"Maverick",
	"Voyager",
	"Spectre",
	"Drifter",
	"Ace",
}

local SINGLE = {
	"Kaizen",
	"Morrow",
	"Zephyr",
	"Quill",
	"Brixton",
	"Marlow",
	"Juniper",
	"Oakley",
	"Rowan",
	"Sable",
	"Tobias",
	"Wren",
	"Kestrel",
	"Lachlan",
	"Nico",
	"Ezra",
	"Milo",
	"Jasper",
	"Felix",
	"Leo",
	"Arlo",
	"Silas",
	"Theo",
	"Ivy",
	"Luna",
	"Nova",
	"Aria",
	"Zara",
	"Kira",
	"Maya",
}

--- A name from `rand` (a function returning [0, 1)).
function BotNames.one(rand: () -> number): string
	local function pick(list: { string }): string
		return list[math.floor(rand() * #list) + 1]
	end
	local style = rand()
	if style < 0.35 then
		return pick(FIRST) .. pick(SECOND)
	elseif style < 0.55 then
		return string.lower(pick(FIRST)) .. "_" .. string.lower(pick(SECOND))
	elseif style < 0.75 then
		return pick(FIRST) .. pick(SECOND) .. tostring(math.floor(rand() * 99) + 1)
	elseif style < 0.9 then
		return pick(SINGLE) .. tostring(math.floor(rand() * 900) + 100)
	end
	return pick(FIRST) .. "_" .. pick(SINGLE)
end

--- `n` distinct names not in `taken` (a set of names already used in the match; updated).
function BotNames.many(n: number, rand: () -> number, taken: { [string]: boolean }?): { string }
	local used = taken or {}
	local out = {}
	local guard = 0
	while #out < n and guard < n * 50 do
		guard += 1
		local name = BotNames.one(rand)
		if not used[name] then
			used[name] = true
			table.insert(out, name)
		end
	end
	-- the word lists are large; this never runs short in practice
	while #out < n do
		local name = "Player" .. tostring(#out + 1000)
		used[name] = true
		table.insert(out, name)
	end
	return out
end

return BotNames
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[--!strict
-- Cosmetics you unlock from crates (2026-09-29: cosmetic loot boxes of territory skins and flags to
-- unlock; 49 Robux a crate, the first 15; never a duplicate; paid only; one crate for both).
--
--   skins   a territory pattern: a 1-bit mask tiled over your land (primary vs
--           secondary tiles; mask pixels are 2^scale tiles wide). '#' = the secondary colour: your
--           own colour lightened (tone > 0) or darkened (tone < 0), or a fixed `accent` colour
--           (legendary skins). Original designs.
--   flags   country flags (Assets/Flags, public domain from Wikimedia Commons), shown by your
--           name on the map and the leaderboard. Every flag is Common.
--   exclusive skins (exclusive_skins) are made for particular players: several colours, never in a
--           crate (Cosmetics.all() is the crate catalog; Cosmetics.exclusives() these).
--   shop flags (Data/Shop: "shop_<key>") are bought one by one in the flag shop: Rare, Epic or
--           Legendary, never in a crate nor on a bot player, not in the Locker's "N of M"
--           (Cosmetics.shop_items()).
--
-- A crate rolls a rarity by RARITIES odds, then an item of that rarity the player doesn't own yet
-- (uniformly); rarities with nothing left drop out and the odds of the rest scale up (odds() gives
-- the player's own odds, shown before every purchase — Roblox's paid random items rules).
local IS_ROBLOX = typeof(game) == "Instance"
local Flags: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Assets.Flags)
	else require("../Assets/Flags")
local ShopFlags: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Assets.ShopFlags)
	else require("../Assets/ShopFlags")
local Shop: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Shop)
	else require("./Shop")

local Cosmetics = {}

Cosmetics.RARITIES = {
	{ id = "common", name = "Common", odds = 0.62, color = 0x9AA6B2 },
	{ id = "rare", name = "Rare", odds = 0.25, color = 0x3D8BFF },
	{ id = "epic", name = "Epic", odds = 0.10, color = 0xA35BFF },
	{ id = "legendary", name = "Legendary", odds = 0.03, color = 0xFFB22E },
}

--- (mask rows top to bottom; every row the same width)
Cosmetics.skins = {
	-- Common
	{ id = "stripes", name = "Stripes", rarity = "common", scale = 1, tone = -0.22, mask = { "##.." } },
	{ id = "bands", name = "Bands", rarity = "common", scale = 1, tone = -0.22, mask = { "#", "#", ".", "." } },
	{ id = "checker", name = "Checker", rarity = "common", scale = 1, tone = -0.18, mask = { "#.", ".#" } },
	{
		id = "diagonal",
		name = "Diagonal",
		rarity = "common",
		scale = 1,
		tone = -0.24,
		mask = { "#...", ".#..", "..#.", "...#" },
	},
	{
		id = "dots",
		name = "Dots",
		rarity = "common",
		scale = 1,
		tone = 0.32,
		mask = { "....", ".#..", "....", "...." },
	},
	{
		id = "grid",
		name = "Grid",
		rarity = "common",
		scale = 0,
		tone = -0.26,
		mask = { "####", "#...", "#...", "#..." },
	},
	-- Rare
	{
		id = "bricks",
		name = "Bricks",
		rarity = "rare",
		scale = 0,
		tone = -0.3,
		mask = { "########", "#.......", "#.......", "########", "....#...", "....#..." },
	},
	{
		id = "waves",
		name = "Waves",
		rarity = "rare",
		scale = 1,
		tone = -0.24,
		mask = { "#......#", ".#....#.", "..#..#..", "...##..." },
	},
	{
		id = "diamonds",
		name = "Diamonds",
		rarity = "rare",
		scale = 0,
