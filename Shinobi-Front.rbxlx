	codec = "zstd+base64",
	size = 2025720,
	terrain = "",
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">SouthAmerica</string>
            <string name="Source"><![CDATA[-- GENERATED by tools/maps/make_maps.py from public-domain data (Natural Earth, NOAA ETOPO1). Do not edit.
