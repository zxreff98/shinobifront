            <string name="Source"><![CDATA[-- GENERATED by tools/assets/upload_soundtrack.py — do not edit by hand (edit its TRACKS).
-- Music by Rodrigo Flores (Orchestral Ambients Bundle; human-made, no generative AI), CC BY 4.0.
-- tracks: key -> {id, length (s), title, pack}; moods: playlists by mood, the first title track
-- is the opener. Played whole (intro to ending) and crossfaded by AudioDirector.
return {
	credit = "Music by Rodrigo Flores",
	license = "CC BY 4.0",
	tracks = {
		a_moment_of_reflection = { id = "rbxassetid://103848943777862", length = 130.657483, title = "A Moment of Reflection", pack = "Orchestral Ambients I: Tranquil" },
