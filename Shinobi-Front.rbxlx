          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">World</string>
              <string name="Source"><![CDATA[-- GENERATED by tools/maps/make_maps.py from public-domain data (Natural Earth, NOAA ETOPO1). Do not edit.
-- terrain = base64(zstd(width * height bytes)), the tile byte format of WorldMap.luau.
return {
	id = "world",
	name = "World",
	module = "World",
	width = 2000,
	height = 1000,
	k_lin = 1.0,
	categories = { "featured", "world" },
	multiplayer_frequency = 30,
	forced_modifiers = { "isCrowded:50" },
	land_tiles = 689018,
	nations = {
		{ name = "Alaska", flag = "us", x = 90, y = 131 },
		{ name = "Yukon", flag = "ca", x = 190, y = 140 },
		{ name = "Nunavut", flag = "ca", x = 401, y = 128 },
		{ name = "Quebec", flag = "ca", x = 535, y = 201 },
