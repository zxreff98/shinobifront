      <Item class="ModuleScript" referent="77">
        <Properties>
          <string name="Name">DsGate</string>
          <string name="Source"><![CDATA[--!strict
-- A gate in front of this server's DataStores (2026-11-01). Roblox gives a server 60 + 40 x players
-- reads and as many writes a minute (an UpdateAsync is one of each), queues 30 requests past that and
-- drops the rest: "StandardWriteGameServerThrottled ... the request queue was full. API: UpdateAsync",
-- "TooManyRequests ... API: GetAsync", "DataStore request was added to queue" (~7,500 a day in the
-- error report). They came in bursts: a public match's end pays 50 players' Stars and saves their
-- settings while they all leave (and the budget shrinks with them), a new match server reads 50
-- records at once. A dropped Stars payout was lost ("could not pay ... Stars").
--
-- Through the gate a request waits until the budget has room (at most MAX_WAIT_S, then it goes
-- anyway), no more than MAX_IN_FLIGHT of a kind run at once, and one Roblox dropped for throttling is
-- sent again after RETRY_S (a dropped request did nothing, so this is safe for any request).
--
--   DsGate.wrap(store, deps?) -> store   the same GetAsync / SetAsync / UpdateAsync / RemoveAsync,
--                                         through the gate (every other method as is)
--   DsGate.throttled(err) -> boolean     Roblox refused the request for its limits (it did nothing)
--   deps = { budget = function(kind) -> number?,   -- "read" | "write": this server's budget now
--            wait = function(s), now = function() -> s, log = function(text)? }
local DsGate = {}

DsGate.MAX_WAIT_S = 15
DsGate.MAX_IN_FLIGHT = 8
--- The waits before each new try of a throttled request.
DsGate.RETRY_S = { 2, 5, 10 }
DsGate.POLL_S = 0.25

local IS_ROBLOX = typeof(game) == "Instance"

local function roblox_deps(): { [string]: any }
	local DataStoreService = game:GetService("DataStoreService")
	local types = {
		read = Enum.DataStoreRequestType.StandardRead,
		write = Enum.DataStoreRequestType.StandardWrite,
	}
	return {
		budget = function(kind: string): number?
			local ok, n = pcall(DataStoreService.GetRequestBudgetForRequestType, DataStoreService, types[kind])
			return if ok and type(n) == "number" then n else nil
		end,
		wait = task.wait,
		now = os.clock,
		log = warn,
	}
end

local default_deps: { [string]: any }? = nil

function DsGate.throttled(err: any): boolean
	local s = tostring(err)
	return string.find(s, "Throttled", 1, true) ~= nil
		or string.find(s, "TooManyRequests", 1, true) ~= nil
		or string.find(s, "queue was full", 1, true) ~= nil
		or string.find(s, "request dropped", 1, true) ~= nil
end

local KINDS: { [string]: { string } } = {
	GetAsync = { "read" },
	SetAsync = { "write" },
	UpdateAsync = { "read", "write" },
	RemoveAsync = { "write" },
}

function DsGate.wrap(store: any, deps: { [string]: any }?): any
	local d: { [string]: any } = deps or default_deps or {}
	if deps == nil and default_deps == nil and IS_ROBLOX then
		default_deps = roblox_deps()
		d = default_deps :: { [string]: any }
	end
	local in_flight: { [string]: number } = { read = 0, write = 0 }
	local gate = { waited = 0, retried = 0 }

	local function room(kinds: { string }): boolean
		for _, k in kinds do
			if in_flight[k] >= DsGate.MAX_IN_FLIGHT then
				return false
			end
			local n = if d.budget then d.budget(k) else nil
			if n ~= nil and n < 1 then
				return false
			end
		end
		return true
	end

	local function enter(kinds: { string })
		local t0 = d.now()
		local waited = false
		while not room(kinds) and d.now() - t0 < DsGate.MAX_WAIT_S do
			waited = true
			d.wait(DsGate.POLL_S)
		end
		if waited then
			gate.waited += 1
		end
		for _, k in kinds do
			in_flight[k] += 1
		end
	end

	local function leave(kinds: { string })
		for _, k in kinds do
			in_flight[k] -= 1
		end
	end

	local function through(method: string, ...: any): ...any
		local kinds = KINDS[method]
		local attempt = 1
		while true do
			enter(kinds)
			local res = table.pack(pcall(store[method], store, ...))
			leave(kinds)
			if res[1] then
				return table.unpack(res, 2, res.n)
			end
			local err = res[2]
			local pause = DsGate.RETRY_S[attempt]
			if pause == nil or not DsGate.throttled(err) then
				error(err, 0)
			end
			gate.retried += 1
			attempt += 1
			d.wait(pause)
		end
	end

	return setmetatable(gate, {
		__index = function(_, method: string): any
			if KINDS[method] ~= nil then
				return function(_self: any, ...: any): ...any
					return through(method, ...)
				end
			end
			local v = store[method]
			if type(v) == "function" then
				return function(_self: any, ...: any): ...any
					return v(store, ...)
				end
			end
			return v
		end,
	})
end

return DsGate
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">FreshServers</string>
          <string name="Source"><![CDATA[--!strict
-- Getting players onto servers that run the newest published version (2026-10-04: a player on an
-- outdated server who starts a solo game is sent to a fresh server, which moves people onto new
-- servers). A server keeps the version it started with: after a publish the old
-- servers stay up until they empty, and Roblox keeps filling them.
--
--   * every hub (a public server) announces its place version when it starts and every ANNOUNCE_S.
--     A hub that hears a higher version than its own is outdated (deps.on_outdated: ServerMain
--     tells its clients);
--   * a hub on the newest version it knows lists itself every LIST_S: its job id, players and room
--     (a shared list whose entries expire after LIST_TTL_S);
--   * an outdated hub, when a player starts a solo match, picks a listed server of the newest
--     version with ROOM seats free, and ServerMain teleports the player there with the solo they
--     asked for (it starts on arrival).
-- No listed server (none fresh yet, a full one, the list unreadable): pick() is nil and the player
-- plays where they are. Nothing here ever restarts or empties a server by itself.
--
--   FreshServers.new(deps) deps = {
--       version: number, job_id: string,
--       now = function() -> seconds,
--       players = function() -> number, max_players: number,
--       publish = function(version: number),            -- announce to every server (may throw)
--       list_put = function(job_id, entry, ttl_s),       -- may throw / yield
--       list_get = function() -> { { key, value } },     -- may throw / yield
--       on_outdated = function(latest: number)?, log = function(text)?,
--   }
--   :heard(version)   another server's announcement
--   :tick()           every few seconds: announce and list when due
--   :is_outdated(), :latest()
--   :pick() -> job_id?   a fresh server with room (yields; the list is read at most every PICK_CACHE_S)

local FreshServers = {}
FreshServers.__index = FreshServers

FreshServers.ANNOUNCE_S = 300
FreshServers.LIST_S = 45
FreshServers.LIST_TTL_S = 110
--- An entry older than this is not trusted (its server may have closed or filled).
FreshServers.STALE_S = 100
--- Seats a listed server must have free to be picked (others are on their way there too).
FreshServers.ROOM = 4
FreshServers.PICK_CACHE_S = 15
--- Among the servers with room, one of the emptiest PICK_AMONG is taken at random.
FreshServers.PICK_AMONG = 4

function FreshServers.new(deps: any)
	local self = setmetatable({}, FreshServers)
	self.deps = deps
	self.version = deps.version
	self._latest = deps.version
	self._next_announce = 0
	self._next_list = 0
	self._list = nil :: any
	self._list_at = -1e9
	return self
end

function FreshServers.latest(self: any): number
	return self._latest
end

function FreshServers.is_outdated(self: any): boolean
	return self._latest > self.version
end

--- Another server announced `version`.
function FreshServers.heard(self: any, version: any)
	if type(version) ~= "number" or version ~= version or version <= self._latest then
		return
	end
	self._latest = math.floor(version)
	if self.deps.log ~= nil then
		self.deps.log(string.format("[Fresh] version %d is out; this server runs %d", self._latest, self.version))
	end
	if self.deps.on_outdated ~= nil then
		pcall(self.deps.on_outdated, self._latest)
	end
end

function FreshServers.tick(self: any)
	local deps = self.deps
	local now = deps.now()
	if now >= self._next_announce then
		self._next_announce = now + FreshServers.ANNOUNCE_S
		pcall(deps.publish, self.version)
	end
	if now >= self._next_list then
		self._next_list = now + FreshServers.LIST_S
		if not self:is_outdated() then
			pcall(
				deps.list_put,
				deps.job_id,
				{ v = self.version, n = deps.players(), cap = deps.max_players, t = now },
				FreshServers.LIST_TTL_S
			)
		end
	end
end

--- A listed server of the newest version with room, or nil. Entries also tell of versions this
--- server has not heard announced.
function FreshServers.pick(self: any): string?
	local deps = self.deps
	local now = deps.now()
	if self._list == nil or now - self._list_at > FreshServers.PICK_CACHE_S then
		local ok, rows = pcall(deps.list_get)
		self._list = if ok and type(rows) == "table" then rows else {}
		self._list_at = now
	end
	local newest = self._latest
	for _, row in self._list do
		local e = if type(row) == "table" then row.value else nil
		if type(e) == "table" and type(e.v) == "number" and e.v > newest then
			newest = e.v
		end
	end
	if newest > self._latest then
		self:heard(newest)
	end
	if newest <= self.version then
		return nil -- (this server is as new as any)
	end
	local fit = {}
	for _, row in self._list do
		local e = if type(row) == "table" then row.value else nil
		if
			type(e) == "table"
			and type(row.key) == "string"
			and row.key ~= deps.job_id
			and e.v == newest
			and type(e.n) == "number"
			and type(e.cap) == "number"
			and type(e.t) == "number"
			and now - e.t <= FreshServers.STALE_S
			and e.cap - e.n >= FreshServers.ROOM
		then
			table.insert(fit, { key = row.key, n = e.n })
		end
	end
	if #fit == 0 then
		return nil
	end
	table.sort(fit, function(a, b)
		if a.n ~= b.n then
			return a.n < b.n
		end
		return a.key < b.key
	end)
	local among = math.min(#fit, FreshServers.PICK_AMONG)
	local chosen = fit[math.random(1, among)]
	-- (one more on its way there: the next pick from this cached list sees it fuller)
	for _, row in self._list do
		if row.key == chosen.key then
			row.value.n += 1
		end
	end
	return chosen.key
end

return FreshServers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">General</string>
          <string name="Source"><![CDATA[--!strict
-- RoWorld General (Data/Subscription; 2026-10-27): who on this server is subscribed, and their perks.
-- Roblox says who is (MarketplaceService:GetUserSubscriptionStatusAsync), when they join and whenever
-- Players.UserSubscriptionStatusChanged fires for the subscription. A General gets the day's crate
-- and the month's skin (Purchases.general_perks) on joining, on subscribing, and at the first tick of
-- each new UTC day while they stay; and +Subscription.STARS_BONUS on every match's Stars
-- (Rewards: deps.general = General.active). The client hears OP.GENERAL: { on, given? }.
--
--   General.configure(deps)   { status = fn(player) -> boolean? (nil: Roblox didn't answer),
--                               perks = fn(player, day, skin) -> given? (nil: not stored),
--                               send = fn(player, state), now = fn() -> unix s,
--                               subscribed = fn(player)? (they just subscribed), log? }
--   General.joined(player)    PlayerAdded (yields)
--   General.changed(player)   UserSubscriptionStatusChanged for this subscription (yields)
--   General.active(player) -> boolean
--   General.state(player) -> { on }   for a client that says HELLO
--   General.tick()            about once a minute (yields)
--   General.release(player)   PlayerRemoving
local IS_ROBLOX = typeof(game) == "Instance"
local Subscription: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Subscription)
	else require("../shared/Data/Subscription")

local General = {}

--- Asking Roblox whether a player is subscribed: attempts, and the wait between them (s).
General.STATUS_ATTEMPTS = 3
General.STATUS_WAIT_S = 2

--- on: subscribed; day: the UTC day whose perks were given this session
type Entry = { on: boolean, day: number? }

local deps: { [string]: any } = {}
local entries: { [any]: Entry } = {}

function General.configure(d: { [string]: any })
	for k, v in d do
		deps[k] = v
	end
end

--- Tests: forget everyone.
function General.reset()
	table.clear(entries)
end

local function now(): number
	return if deps.now then deps.now() else os.time()
end

local function send(player: any, state: any)
	if deps.send then
		pcall(deps.send, player, state)
	end
end

--- Subscribed? Asked a few times; nil when Roblox never answered.
local function status(player: any): boolean?
	for i = 1, General.STATUS_ATTEMPTS do
		local ok, on = pcall(deps.status, player)
		if ok and type(on) == "boolean" then
			return on
		end
		if i < General.STATUS_ATTEMPTS and IS_ROBLOX then
			task.wait(General.STATUS_WAIT_S)
		end
	end
	if deps.log then
		deps.log("[General] no subscription status for " .. tostring(player.UserId))
	end
	return nil
end

--- The day's perks for a General, once a day (a failed store is tried again at the next tick).
local function perks(player: any, e: Entry)
	local t = now()
	local day = Subscription.day(t)
	if not e.on or e.day == day then
		return
	end
	local ok, given = pcall(deps.perks, player, day, Subscription.skin_for(t))
	if ok and given ~= nil then
		e.day = day
		if next(given) ~= nil then
			send(player, { on = true, given = given })
		end
	end
end

function General.joined(player: any)
	if Subscription.id() == "" or deps.status == nil then
		return
	end
	local on = status(player)
	if entries[player] ~= nil or (IS_ROBLOX and player.Parent == nil) then
		return -- (changed() got there first, or they left while Roblox answered)
	end
	local e: Entry = { on = on == true }
	entries[player] = e
	send(player, { on = e.on })
	perks(player, e)
end

function General.changed(player: any)
	if Subscription.id() == "" or deps.status == nil then
		return
	end
	local on = status(player)
	if on == nil then
		return
	end
	local e = entries[player]
	if e == nil then
		e = { on = false }
		entries[player] = e
	end
	if e.on ~= on then
		e.on = on
		if on and deps.subscribed then
			pcall(deps.subscribed, player)
		end
		if deps.log then
			deps.log(
				string.format(
					"[General] %s %s",
					tostring(player.UserId),
					if on then "subscribed" else "is no longer subscribed"
				)
			)
		end
		send(player, { on = on })
	end
	perks(player, e)
end

function General.active(player: any): boolean
	local e = entries[player]
	return e ~= nil and e.on
end

function General.state(player: any): any
	return { on = General.active(player) }
end

function General.tick()
	for player, e in entries do
		if e.on then
			perks(player, e)
		end
	end
end

function General.release(player: any)
	entries[player] = nil
end

return General
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">Handoff</string>
          <string name="Source"><![CDATA[--!strict
-- What a server knew about a player, handed to the server it teleports them to (2026-11-03).
--
-- Every join read the player's settings and Purchases record from their DataStores, and a public match
-- is two joins (its match server, then a hub): four reads a match for every player. At busy times
-- Roblox's backend refused a share of them ("DataStoreService: TooManyRequests: Too many requests, try
-- again later. API: GetAsync" on both stores, ~9,000 a day; a refused settings read meant defaults for
-- the session). Now a server that teleports a player sends a fresh id in the teleport data and, once the
-- player has left and their last writes have landed, puts what it knew of them (both records) in a
-- MemoryStore hash map under their user id, with that id, for HOLD_S. The server they arrive on uses it
-- when the ids match, and reads the DataStores only when they don't (a join from outside the game, a
-- server of an older version, a record that wasn't known for sure). Teleport data passes through the
-- player's client, so it carries only the id: the records come from MemoryStore under the player's own
-- user id, and a stale or made-up id finds nothing.
--
--   Handoff.new(deps) -> h
--     deps = {
--       map = MemoryStoreHashMap?,          -- GetAsync / SetAsync (nil: off, every join reads the stores)
--       guid = function() -> string,
--       join_data = function(player) -> any, -- player:GetJoinData()
--       encode = function(v) -> string,      -- JSON, for the size check
--       spawn, wait, now,
--       log = function(text)?,
--     }
--   h:stamp(players, data?) -> data      a teleport is about to start: a copy of `data` with the id
--   h:leaving(player) -> boolean         PlayerRemoving: true when the player is on a stamped teleport
--   h:part(player, name, value?)         a leaving player's "p" (Purchases record) or "s" (settings);
--                                        nil: not known for sure. The entry goes when both are in.
--   h:arrived(player) -> { p?, s? }?     what the last server knew (yields; one read for all callers)
local Handoff = {}
Handoff.__index = Handoff

Handoff.MAP = "handoff_v1"
--- How long an entry is kept: a teleport, and a reserved match server starting up.
Handoff.HOLD_S = 300
--- A leaving player's entry goes when both parts are in, or after this long with what is there.
Handoff.PART_WAIT_S = 30
Handoff.PARTS = { "p", "s" }
--- Arriving: the waits between reads while the entry isn't there yet (its last writes still landing).
Handoff.POLL_S = { 0.5, 1, 1.5, 2 }
--- A hash map item holds at most 32 KB: a bigger entry goes without its records.
Handoff.MAX_BYTES = 30000

local function key(uid: number): string
	return "u" .. tostring(uid)
end

function Handoff.new(deps: { [string]: any })
	local self = setmetatable({}, Handoff)
	self.deps = deps
	--- user id -> the id of the teleport they are on
	self._ids = {} :: { [number]: string }
	--- user id -> a leaving player's entry, while its parts come in
	self._out = {} :: { [number]: any }
	--- player -> the arrival read ({ done, entry })
	self._got = {} :: { [any]: any }
	-- counts (tests, diagnostics)
	self.sent = 0
	self.hits = 0
	self.misses = 0
	--- joins that weren't one of our teleports (from outside the game, an older server)
	self.none = 0
	return self
end

function Handoff.stamp(self: any, players: { any }, data: { [string]: any }?): { [string]: any }
	local out = if data ~= nil then table.clone(data) else {}
	if self.deps.map == nil then
		return out
	end
	local id = self.deps.guid()
	out.handoff = id
	for _, p in players do
		self._ids[p.UserId] = id
	end
	return out
end

--- The entry of a player leaving on a stamped teleport (made on the first call; nil when there's none).
function Handoff._start(self: any, uid: number): any
	local out = self._out[uid]
	if out ~= nil then
		return out
	end
	local id = self._ids[uid]
	if id == nil then
		return nil
	end
	self._ids[uid] = nil
	out = { id = id, parts = {}, have = {}, n = 0 }
	self._out[uid] = out
	local d = self.deps
	d.spawn(function()
		local t0 = d.now()
		while out.n < #Handoff.PARTS and d.now() - t0 < Handoff.PART_WAIT_S do
			d.wait(0.1)
		end
		if self._out[uid] == out then
			self._out[uid] = nil
		end
		self:_put(uid, out)
	end)
	return out
end

function Handoff.leaving(self: any, player: any): boolean
	self._got[player] = nil
	return self:_start(player.UserId) ~= nil
end

function Handoff.part(self: any, player: any, name: string, value: any)
	local out = self:_start(player.UserId)
	if out == nil or out.have[name] then
		return
	end
	out.have[name] = true
	out.parts[name] = value
	out.n += 1
end

function Handoff._put(self: any, uid: number, out: any)
	local d = self.deps
	local entry = { id = out.id, p = out.parts.p, s = out.parts.s }
	if d.encode ~= nil then
		-- (the entry still goes without them: the next server stops waiting and reads the stores)
		for _, name in { "p", "s" } do
			local ok, json = pcall(d.encode, entry)
			if ok and type(json) == "string" and #json <= Handoff.MAX_BYTES then
				break
			end
			entry[name] = nil
		end
	end
	local ok, err = pcall(function()
		d.map:SetAsync(key(uid), entry, Handoff.HOLD_S)
	end)
	local log = d.log
	if ok then
		self.sent += 1
	elseif log ~= nil then
		log("[Handoff] could not hand " .. tostring(uid) .. " on: " .. tostring(err))
	end
end

--- The entry the last server put for this teleport: read again over POLL_S while it isn't there.
function Handoff._fetch(self: any, player: any): any
	local d = self.deps
	if d.map == nil then
		return nil
	end
	local ok, jd = pcall(d.join_data, player)
	local td = if ok and type(jd) == "table" then jd.TeleportData else nil
	local id = if type(td) == "table" then td.handoff else nil
	if type(id) ~= "string" or #id == 0 or #id > 64 then
		self.none += 1 -- (not from one of our teleports)
		return nil
	end
	local k = key(player.UserId)
	for i = 1, #Handoff.POLL_S + 1 do
		if i > 1 then
			d.wait(Handoff.POLL_S[i - 1])
		end
		local got, v = pcall(function()
			return d.map:GetAsync(k)
		end)
		if got and type(v) == "table" and v.id == id then
			self.hits += 1
			return {
				p = if type(v.p) == "table" then v.p else nil,
				s = if type(v.s) == "table" then v.s else nil,
			}
		end
	end
	self.misses += 1
	return nil
end

function Handoff.arrived(self: any, player: any): any
	local got = self._got[player]
	if got == nil then
		got = { done = false, entry = nil }
		self._got[player] = got
		got.entry = self:_fetch(player)
		got.done = true
		return got.entry
	end
	local d = self.deps
	local t0 = d.now()
	while not got.done and d.now() - t0 < 30 do
		d.wait(0.1)
	end
	return got.entry
end

return Handoff
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="81">
        <Properties>
          <string name="Name">Lobbies</string>
        </Properties>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">LobbyDirectory</string>
            <string name="Source"><![CDATA[--!strict
-- The public-lobby directory on a hub server (a public server of the place): keeps the game-wide
-- list of open lobbies fresh, creates new ones when too few are open (one hub at a time, elected by
-- a short store lock), shows them to its players and sends joiners to the lobby's reserved server.
-- Every hub reads the same store, so all players across the game see the same lobbies.
--
--   deps = {
--     store = {                                -- LobbyStore (the lobby service / MemoryStore live)
--       list = function() -> { any },          -- lobby records, earliest start first
--       put = function(lobby, ttl_s),
--       update = function(id, fn(any?) -> any?) -> any?,   -- atomic; fn returns nil to abort
--       remove = function(id),
--       lock = function(name, ttl_s) -> boolean,
--       bind_psid = function(psid, id, ttl_s),
--       take = function(LobbyRules.TakeSpec) -> any?,     -- seats in the soonest lobby that fits
--       release = function(id, uids) -> (any?, number),   -- seats given back
--     },
--     teleport = {
--       reserve = function() -> (code, psid),  -- a new reserved server
--       send = function(players, code, data) -> (ok, err?),
--     },
--     maps = function() -> { { id, name, weight, land, k_lin } },
--     now = function() -> number,              -- os.time() seconds (shared by all servers)
--     rand = function() -> number,             -- [0, 1)
--     new_id = function() -> string,
--     log = function(text)?,
--     team_games = boolean?,                   -- also keep a team game open (staging only for now)
--     server_size = function() -> number?,     -- most players a server holds (Players.MaxPlayers; seats cap)
--     uid_of = function(player) -> string?,    -- a player's user id (default: tostring(player.UserId))
--   }
local LobbyRules = require("./LobbyRules")

local LobbyDirectory = {}
LobbyDirectory.__index = LobbyDirectory

LobbyDirectory.REFRESH_S = 3.0
LobbyDirectory.LOCK_TTL_S = 10
--- A hub refused the "scheduler" lock asks again only after a random wait in this range (seconds),
--- not at every refresh. With ~700 hubs at 23,000 players they asked ~150 times a second, a third of
--- the lobby service's requests (2026-10-21; its one core at 54%). The holder renews at every refresh
--- as before, and the service hands the lock on after 20 s (LOCK_MAX_HOLD_S), so with hundreds of hubs
--- asking every 8-16 s the next one takes it within a fraction of a second.
LobbyDirectory.LOCK_RETRY_S = { 8.0, 16.0 }
--- Open lobbies whose start passed this long ago without a match server marking them started had
--- nobody join: they are removed.
LobbyDirectory.STALE_AFTER_S = 30
--- Tries at reserving a slot before joining without one (join).
LobbyDirectory.JOIN_TRIES = 3
--- join_public's reason when no lobby of the kind has room now (the caller puts the player in line).
LobbyDirectory.NO_ROOM = "no room"
--- join_public's reason when the store can't be reached and the hub's list has no room either.
LobbyDirectory.UNREACHABLE = "Couldn't reach the lobby list. Try again in a moment."
--- Players in line (Quick Play) are tried again this often...
LobbyDirectory.QUEUE_RETRY_S = 1.0
--- ...this many at most each time (store calls: a server may make 500 HTTP requests a minute)...
LobbyDirectory.QUEUE_BATCH = 4
--- ...and wait this long at most.
LobbyDirectory.QUEUE_MAX_S = 120

--- Someone waiting in line for a seat: `key` (one per player or party leader), `mode`, `since`;
--- `members()` -> (the players to seat, the party data for join) or nil when they no longer can go
--- (left, started a solo match); `done(ok, reason, lobby, players)` once they are seated (the players
--- sent) or out of the line.
export type QueueEntry = {
	key: string,
	mode: string,
	since: number,
	members: () -> ({ any }?, { [string]: any }?),
	done: (boolean, string?, LobbyRules.Lobby?, { any }?) -> (),
}

function LobbyDirectory.new(deps: { [string]: any })
	local self = setmetatable({}, LobbyDirectory)
	self.deps = deps
	self._lobbies = {} :: { LobbyRules.Lobby }
	self._refresh_in = 0.0
	self._recent = {} :: { string }
	self._busy = false
	self._queue = {} :: { QueueEntry }
	self._queue_in = 0.0
	self._queue_busy = false
	--- deps.now() before which this hub doesn't ask for the scheduler lock again (it was refused)
	self._lock_retry_at = -math.huge
	--- the demand per kind at the last refresh (LobbyRules.demand), for diagnostics
	self.demand = {} :: { [string]: LobbyRules.Demand }
	return self
end

function LobbyDirectory._log(self: any, text: string)
	local log = self.deps.log
	if log then
		log("[Lobbies] " .. text)
	end
end

--- The cached lobbies (refreshed every REFRESH_S by tick).
function LobbyDirectory.lobbies(self: any): { LobbyRules.Lobby }
	return self._lobbies
end

--- What clients see: open lobbies that can still be joined (earliest first; a full one, or one whose
--- joins closed JOIN_CLOSE_S before its start, is hidden so players go for the next — missing_starts
--- has already scheduled one; since 2026-09-28 a match in its starting phase isn't listed, as it can't
--- be joined), then up to MAX_LIVE_LISTED running matches to watch (most players first).
function LobbyDirectory.view(self: any): { any }
	local now = self.deps.now()
	local out = {}
	local live = {}
	for _, l in self._lobbies do
		if l.status == "open" and l.starts > now then
			if LobbyRules.joinable(l, now) then
				table.insert(out, LobbyRules.public_view(l, now))
			end
		elseif LobbyRules.watchable(l, now) then
			table.insert(live, l)
		end
	end
	table.sort(live, function(a, b)
		if a.players ~= b.players then
			return a.players > b.players
		end
		return a.starts > b.starts
	end)
	for i = 1, math.min(#live, LobbyRules.MAX_LIVE_LISTED) do
		table.insert(out, LobbyRules.public_view(live[i], now))
	end
	return out
end

--- Teleport `player` to a running match as a spectator (no slot is taken).
function LobbyDirectory.spectate(self: any, player: any, id: string): (boolean, string?)
	local deps = self.deps
	local ok, v = pcall(deps.store.get, id)
	local l = if ok then LobbyRules.decode(v) else nil
	if l == nil or not LobbyRules.watchable(l, deps.now()) then
		return false, "That match has ended."
	end
	local sent, terr = deps.teleport.send({ player }, l.code, { lobby = l.id, map = l.map, spectate = true })
	if not sent then
		return false, terr or "The teleport failed. Try again."
	end
	return true, nil
end

--- Per-frame: refresh the list and top it up now and then. Store calls yield, so the refresh runs in
--- its own thread; `spawn` (task.spawn on Roblox) is injectable for tests.
function LobbyDirectory.tick(self: any, dt: number, spawn: ((() -> ()) -> ())?)
	self._refresh_in -= dt
	if self._refresh_in > 0 or self._busy then
		return
	end
	self._refresh_in = LobbyDirectory.REFRESH_S
	self._busy = true
	local run = function()
		local ok, err = pcall(self.refresh, self)
		if not ok then
			self:_log("refresh failed: " .. tostring(err))
		end
		self._busy = false
	end
	if spawn then
		spawn(run)
	else
		run()
	end
end

--- Read the store, drop stale lobbies, create missing ones (when this hub holds the lock).
function LobbyDirectory.refresh(self: any)
	local deps = self.deps
	local now = deps.now()
	local list: { LobbyRules.Lobby } = {}
	for _, v in deps.store.list() do
		local l = LobbyRules.decode(v)
		if l == nil then
			continue
		end
		if l.status == "open" and l.starts < now - LobbyDirectory.STALE_AFTER_S then
			-- nobody joined before the start: gone
			pcall(deps.store.remove, l.id)
			continue
		end
		if l.status == "open" and not LobbyRules.plausible(l, now) then
			-- written with a wrong clock (a server whose clock ran fast): not listed, not counted
			continue
		end
		table.insert(list, l)
	end
	table.sort(list, function(a, b)
		return a.starts < b.starts
	end)
	self._lobbies = list
	-- the demand per kind: the seats of the lobbies made lately (the list from the service holds only
	-- the latest running matches, so it covers since the oldest record in it at most)
	local oldest = now
	for _, l in list do
		oldest = math.min(oldest, l.created)
	end
	local window = math.min(LobbyRules.DEMAND_WINDOW_S, now - oldest)
	local kinds = LobbyRules.kinds(deps.team_games)
	for _, k in kinds do
		self.demand[k.mode] = LobbyRules.demand(list, now, k.mode, window)
	end
	local want = {}
	-- the free-for-alls' starts, made and about to be: World's keep clear of them (WORLD_STAGGER_S), so
	-- PUBLIC MATCH, which takes World's seats too, finds World's lobby the soonest about half the time
	local ffa_starts = {}
	for _, l in list do
		if LobbyRules.mode_of(l) == LobbyRules.MODE_FFA and l.status == "open" and l.starts > now then
			table.insert(ffa_starts, l.starts)
		end
	end
	for _, k in kinds do
		-- (without team games the free-for-all keeps its old schedule: no `mode`, TARGET_OPEN)
		local plain = k.mode == LobbyRules.MODE_FFA and not deps.team_games
		local mode = if plain then nil else k.mode
		local avoid = nil
		if k.mode == LobbyRules.MODE_WORLD then
			table.sort(ffa_starts)
			avoid = ffa_starts
		end
		for _, starts in
			LobbyRules.missing_starts(list, now, mode, if plain then nil else k.target, self.demand[k.mode], avoid)
		do
			table.insert(want, { starts, k.mode })
			if k.mode == LobbyRules.MODE_FFA then
				table.insert(ffa_starts, starts)
			end
		end
	end
	if #want > 0 and now >= self._lock_retry_at then
		if deps.store.lock("scheduler", LobbyDirectory.LOCK_TTL_S) then
			self._lock_retry_at = -math.huge
			for _, w in want do
				local ok, l = pcall(self.create, self, w[1], w[2])
				if ok and l ~= nil then
					table.insert(self._lobbies, l)
				elseif not ok then
					self:_log("create failed: " .. tostring(l))
				end
			end
		else
			-- another hub has it (or this one's turn just ended): it makes the lobbies meanwhile
			local r = LobbyDirectory.LOCK_RETRY_S
			self._lock_retry_at = now + r[1] + math.random() * (r[2] - r[1])
		end
	end
end

--- Create one lobby starting at `starts` (a reserved server + a store record); `mode`:
--- LobbyRules.MODE_TEAM for a team game (team playlist and team sizes), MODE_WORLD for
--- World's own free-for-all (that map only).
function LobbyDirectory.create(self: any, starts: number, mode: string?): LobbyRules.Lobby?
	local deps = self.deps
	local maps = deps.maps()
	local team = mode == LobbyRules.MODE_TEAM
	local world = mode == LobbyRules.MODE_WORLD
	local weights = if world
		then { { id = LobbyRules.WORLD_ID, weight = 1 } }
		elseif team then LobbyRules.team_weights(maps)
		else LobbyRules.public_weights(maps)
	-- the maps of the latest lobbies of this kind game-wide (every hub reads the same list; this
	-- hub's own memory only while the list is empty), newest first
	local latest = {}
	for _, l in self._lobbies do
		if LobbyRules.mode_of(l) == (mode or LobbyRules.MODE_FFA) then
			table.insert(latest, l)
		end
	end
	table.sort(latest, function(a, b)
		return a.starts > b.starts
	end)
	local recent = {}
	for _, l in latest do
		if #recent >= LobbyRules.RECENT_MAPS then
			break
		end
		table.insert(recent, l.map)
	end
	if #recent == 0 and not team and not world then
		recent = self._recent
	end
	local map_id = if world then LobbyRules.WORLD_ID else LobbyRules.pick_map(weights, recent, deps.rand())
	if map_id == nil then
		return nil
	end
	local info
	for _, m in maps do
		if m.id == map_id then
			info = m
			break
		end
	end
	if not world then
		table.insert(self._recent, 1, map_id)
		while #self._recent > LobbyRules.RECENT_MAPS do
			table.remove(self._recent)
		end
	end
	-- (never more seats than a server of the place holds: deps.server_size, Players.MaxPlayers)
	local max = LobbyRules.max_players(
		if info then info.land else nil,
		if info then info.k_lin else nil,
		if type(deps.server_size) == "function" then deps.server_size() else nil
	)
	local teams = nil
	if team then
		max, teams = LobbyRules.team_slots(max, LobbyRules.team_config(map_id, deps.rand(), deps.rand()))
	end
	local code, psid = deps.teleport.reserve()
	local now = deps.now()
	local l: LobbyRules.Lobby = {
		id = deps.new_id(),
		map = map_id,
		map_name = if info then info.name else map_id,
		max = max,
		starts = starts,
		created = now,
		players = 0,
		status = "open",
		code = code,
		psid = psid,
		mode = if team then LobbyRules.MODE_TEAM elseif world then LobbyRules.MODE_WORLD else nil,
		teams = teams,
	}
	local ttl = math.max(60, starts - now + LobbyRules.RECORD_TTL_AFTER_START_S)
	deps.store.put(l, ttl)
	if psid ~= nil then
		deps.store.bind_psid(psid, l.id, ttl)
	end
	self:_log(
		string.format(
			"created %s on %s (%d players%s) starting in %ds",
			l.id,
			l.map,
			l.max,
			if team then ", " .. tostring(teams) .. " teams" else "",
			starts - now
		)
	)
	return l
end

--- Send `player` to lobby `id`: reserve a slot (atomic), then teleport. Returns ok, message.
--- Yields (store + teleport).
function LobbyDirectory.join(self: any, player: any, id: string, party: { [string]: any }?): (boolean, string?)
	local deps = self.deps
	local reserved: LobbyRules.Lobby? = nil
	-- a party (Party.luau): `party.players` go together, a seat each, in one teleport; the match
	-- server reads `party` from the teleport data (who came together: one team in a team game)
	local players = if party ~= nil and type(party.players) == "table" then party.players else { player }
	local n = math.max(1, #players)
	-- a slot is reserved in the lobby's record; with hundreds joining one lobby from many hubs the
	-- store refuses some updates, so: a few tries with a random pause, then (the store still busy)
	-- go anyway when this hub's copy of the list has room — the match server seats up to
	-- MatchServer.MP_MAX_HUMANS and its presence count corrects the record
	local ok, err = false, nil
	for attempt = 1, LobbyDirectory.JOIN_TRIES do
		reserved = nil
		ok, err = pcall(function()
			deps.store.update(id, function(v: any): any?
				-- the store may run this again on a newer record (a write in between: UpdateAsync
				-- and the lobby service both retry), so only the last run's seat counts — a seat from
				-- a run that lost the race and then found the lobby full is no seat
				reserved = nil
				local l = LobbyRules.decode(v)
				if l == nil or not LobbyRules.joinable(l, deps.now()) or l.players + n > l.max then
					return nil
				end
				l.players += n
				reserved = l
				return l
			end)
		end)
		if ok then
			break
		end
		if attempt < LobbyDirectory.JOIN_TRIES then
			local tl = task :: any -- (nil under Lune)
			local wait = deps.wait or (if tl ~= nil then tl.wait else nil)
			if wait then
				wait(0.15 + (deps.rand and deps.rand() or math.random()) * 0.4 * attempt)
			end
		end
	end
	if not ok then
		local mine = nil
		for _, c in self._lobbies do
			if c.id == id then
				mine = c
			end
		end
		if mine == nil or mine.code == nil or not LobbyRules.joinable(mine, deps.now()) or mine.players + n > mine.max then
			self:_log("join failed: " .. tostring(err))
			return false, "Couldn't reach the lobby list. Try again in a moment."
		end
		self:_log("join without a reservation (store busy): " .. tostring(err))
		mine.players += n
		reserved = table.clone(mine)
	end
	local l = reserved
	if l == nil or l.code == nil then
		return false, if n > 1 then "That match has no room for your whole party." else "That match is full or already starting."
	end
	local data: { [string]: any } = { lobby = l.id, map = l.map }
	if n > 1 and party ~= nil then
		data.party = { key = party.key, uids = party.uids, leader = party.leader }
	end
	local sent, terr = deps.teleport.send(players, l.code, data)
	if not sent then
		-- give the slot back (the one reserved in the store; a join without one only counted it here)
		if not ok then
			return false, terr or "The teleport failed. Try again."
		end
		pcall(deps.store.update, id, function(v: any): any?
			local lb = LobbyRules.decode(v)
			if lb == nil then
				return nil
			end
			lb.players = math.max(0, lb.players - n)
			return lb
		end)
		return false, terr or "The teleport failed. Try again."
	end
	-- mirror the reservation locally so the list shows it at once
	for _, c in self._lobbies do
		if c.id == l.id then
			c.players = l.players
		end
	end
	return true, nil
end

-- ---------------------------------------------------------------------------------------------
-- Quick Play (2026-10-11): a seat in the soonest public match of a kind, or a place in line
-- ---------------------------------------------------------------------------------------------

function LobbyDirectory._uid(self: any, p: any): string
	local f = self.deps.uid_of
	if f ~= nil then
		local u = f(p)
		if u ~= nil then
			return u
		end
	end
	local ok, u = pcall(function()
		return p.UserId
	end)
	return if ok and u ~= nil then tostring(u) else tostring(p)
end

--- This hub's open lobbies a join of `mode` may take (LobbyRules.takes_from: a free-for-all join takes
--- World's too) that still take joins, soonest first (what a store that can't search tries in turn,
--- and where to go while the store is unreachable).
function LobbyDirectory._open_of(self: any, mode: string, now: number): { LobbyRules.Lobby }
	local out = {}
	local kinds = LobbyRules.takes_from(mode)
	for _, l in self._lobbies do
		if
			l.status == "open"
			and table.find(kinds, LobbyRules.mode_of(l)) ~= nil
			and l.starts > now + LobbyRules.JOIN_CLOSE_S
			and LobbyRules.plausible(l, now)
		then
			table.insert(out, l)
		end
	end
	-- (a tie: its own kind first, so PUBLIC MATCH plays World only when World's lobby is sooner)
	table.sort(out, function(a, b)
		if a.starts ~= b.starts then
			return a.starts < b.starts
		end
		return LobbyRules.mode_of(a) == mode and LobbyRules.mode_of(b) ~= mode
	end)
	return out
end

--- Seats `players` (one player, or a party: `opts.party` = { key, uids, leader } as in join) in the
--- soonest public match of `mode` (or one it takes from: LobbyRules.takes_from) with room for all of them, in one store step, and sends them
--- there (yields). `opts.id`: only that lobby; `opts.wanted()`: checked before the teleport (false:
--- the seats go back). Returns ok, reason, lobby: reason NO_ROOM when no lobby has room now.
function LobbyDirectory.join_public(self: any, players: { any }, mode: string, opts: { [string]: any }?): (boolean, string?, LobbyRules.Lobby?)
	local deps = self.deps
	local o: { [string]: any } = opts or {}
	local n = math.max(1, #players)
	local uids = {}
	for _, p in players do
		table.insert(uids, self:_uid(p))
	end
	local now = deps.now()
	local spec = LobbyRules.take_spec(mode, n, uids, now, o.id)
	local open = self:_open_of(mode, now)
	local ids = {}
	for _, l in open do
		table.insert(ids, l.id)
	end
	spec.candidates = ids
	local ok, v = false, nil
	for attempt = 1, LobbyDirectory.JOIN_TRIES do
		ok, v = pcall(deps.store.take, spec)
		if ok then
			break
		end
		if attempt < LobbyDirectory.JOIN_TRIES then
			local tl = task :: any -- (nil under Lune)
			local wait = deps.wait or (if tl ~= nil then tl.wait else nil)
			if wait then
				wait(0.15 + (deps.rand and deps.rand() or math.random()) * 0.4 * attempt)
			end
		end
	end
	local l: LobbyRules.Lobby? = nil
	if ok then
		l = LobbyRules.decode(v)
		if l == nil then
			return false, LobbyDirectory.NO_ROOM, nil
		end
	else
		-- the store unreachable: the soonest lobby with room in this hub's copy of the list (the match
		-- server seats up to MatchServer.MP_MAX_HUMANS, and its presence count corrects the record)
		for _, c in open do
			if LobbyRules.fits(c, spec) and c.code ~= nil then
				c.players += n
				l = table.clone(c)
				break
			end
		end
		if l == nil then
			self:_log("join failed: " .. tostring(v))
			return false, LobbyDirectory.UNREACHABLE, nil
		end
		self:_log("join without a reservation (store busy): " .. tostring(v))
	end
	local lobby = l :: LobbyRules.Lobby
	local function give_back()
		if ok then
			pcall(deps.store.release, lobby.id, uids)
		end
	end
	if lobby.code == nil then
		give_back()
		return false, "That match is gone.", nil
	end
	if o.wanted ~= nil and not o.wanted() then
		give_back()
		return false, "cancelled", lobby
	end
	local data: { [string]: any } = { lobby = lobby.id, map = lobby.map }
	if n > 1 and o.party ~= nil then
		data.party = { key = o.party.key, uids = o.party.uids, leader = o.party.leader }
	end
	local sent, terr = deps.teleport.send(players, lobby.code, data)
	if not sent then
		give_back()
		return false, terr or "The teleport failed. Try again.", lobby
	end
	-- mirror the seats locally so the list shows them at once
	for _, c in self._lobbies do
		if c.id == lobby.id then
			c.players = lobby.players
		end
	end
	return true, nil, lobby
end

--- Gives back the seats of `uids` in lobby `id` (a teleport that failed after it began). Yields.
function LobbyDirectory.release(self: any, id: string, uids: { string }): number
	local ok, res, n = pcall(self.deps.store.release, id, uids)
	if not ok then
		self:_log("release failed: " .. tostring(res))
		return 0
	end
	return tonumber(n) or 0
end

--- Puts someone in line for a seat (QueueEntry); one entry per key (a new one replaces it).
function LobbyDirectory.enqueue(self: any, e: QueueEntry)
	self:dequeue(e.key)
	table.insert(self._queue, e)
end

--- Takes `key` out of the line (true if it was in it). Its `done` is not called.
function LobbyDirectory.dequeue(self: any, key: string): boolean
	for i, e in self._queue do
		if e.key == key then
			table.remove(self._queue, i)
			return true
		end
	end
	return false
end

function LobbyDirectory.queued(self: any, key: string): QueueEntry?
	for _, e in self._queue do
		if e.key == key then
			return e
		end
	end
	return nil
end

function LobbyDirectory.queue_size(self: any): number
	return #self._queue
end

--- One pass over the line: oldest first, up to QUEUE_BATCH store calls; per kind, once n seats were
--- missing, nobody needing n or more is tried this pass (someone smaller still may fit). Yields.
function LobbyDirectory.serve_queue(self: any)
	local now = self.deps.now()
	local calls = 0
	local blocked: { [string]: number } = {}
	for _, e in table.clone(self._queue) do
		if calls >= LobbyDirectory.QUEUE_BATCH then
			break
		end
		if self:queued(e.key) ~= e then
			continue -- (left the line meanwhile)
		end
		if now - e.since > LobbyDirectory.QUEUE_MAX_S then
			self:dequeue(e.key)
			e.done(false, "timeout", nil)
			continue
		end
		local players, party = e.members()
		if players == nil or #players == 0 then
			self:dequeue(e.key)
			e.done(false, "gone", nil)
			continue
		end
		local n = #players
		if blocked[e.mode] ~= nil and n >= blocked[e.mode] then
			continue
		end
		calls += 1
		local ok, reason, l = self:join_public(players, e.mode, {
			party = party,
			wanted = function(): boolean
				return self:queued(e.key) == e
			end,
		})
		if ok then
			self:dequeue(e.key)
			e.done(true, nil, l, players)
		elseif reason == LobbyDirectory.NO_ROOM then
			blocked[e.mode] = math.min(blocked[e.mode] or math.huge, n)
		elseif reason ~= "cancelled" then
			self:dequeue(e.key)
			e.done(false, reason, l, players)
		end
	end
end

--- Per-frame: serve the line every QUEUE_RETRY_S (in its own thread; `spawn` as in tick).
function LobbyDirectory.tick_queue(self: any, dt: number, spawn: ((() -> ()) -> ())?)
	self._queue_in -= dt
	if self._queue_in > 0 or self._queue_busy or #self._queue == 0 then
		return
	end
	self._queue_in = LobbyDirectory.QUEUE_RETRY_S
	self._queue_busy = true
	local run = function()
		local ok, err = pcall(self.serve_queue, self)
		if not ok then
			self:_log("queue failed: " .. tostring(err))
		end
		self._queue_busy = false
	end
	if spawn then
		spawn(run)
	else
		run()
	end
end

return LobbyDirectory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">LobbyHttp</string>
            <string name="Source"><![CDATA[--!strict
-- Client of the lobby service on easy-1 (services/lobbies, docs/lobby-service.md): signed JSON POSTs
-- with our own deadline, every reply's signature checked, a health state, and a clock correction for
-- signing (a server's clock can be minutes out; the service tells a correctly signed request with a
-- stale timestamp its time, and the request is sent once more).
--
-- It is reached at https://rofront.snick.co (Cloudflare, then easy-1's Caddy; 2026-10-12: the
-- studio's services live under the snick.co domain). While the domain fails (no answer, or an answer
-- that isn't the service's: a Cloudflare block or error page) a server uses the service's own port
-- instead, and tries the domain again after RETRY_PRIMARY_S.
--
--   LobbyHttp.new(deps) -> client
--     deps = {
--       base_url = string, fallback_url = string?, secret = string, job_id = string,
--       transport = function(req) -> (ok, res | err),  -- req {Url, Method, Headers, Body};
--                                                       -- res {StatusCode, Body, Headers}
--       encode = function(t) -> string, decode = function(s) -> any,
--       now = function() -> number,                     -- unix seconds (SharedClock.now live)
--       nonce = function() -> string,                   -- 32 hex
--       log = function(text)?,
--     }
--   client:post(path, body) -> (reply?, err?)   reply = the decoded, verified reply (check .ok)
--   client:healthy() -> boolean                 false after FAIL_THRESHOLD failures in a row
--   LobbyHttp.roblox(deps?) -> client | nil     the live client (nil: HTTP off / not configured)
local Signing = require("./Signing")

local LobbyHttp = {}
LobbyHttp.__index = LobbyHttp

--- The service (easy-1, behind Cloudflare: HTTPS; http:// is redirected).
LobbyHttp.BASE_URL = "https://rofront.snick.co"
--- Its own port, straight (until it closes, docs/lobby-service.md "Ops"): used while the domain fails.
--- "" = none.
LobbyHttp.FALLBACK_URL = "http://54.39.159.132:3002"
--- How long a server stays on the fallback before it tries the domain again.
LobbyHttp.RETRY_PRIMARY_S = 300
--- Live servers use the service (MemoryStore stays the fallback). false = MemoryStore only.
--- (On since 2026-09-28, once easy-1's firewall let port 3002 in; the service's LOBBIES switch turns it
--- off without a publish.)
LobbyHttp.ENABLED = true
LobbyHttp.TIMEOUT_S = 5
--- Transport failures in a row before the service counts as down.
LobbyHttp.FAIL_THRESHOLD = 3

function LobbyHttp.new(deps: { [string]: any })
	local self = setmetatable({}, LobbyHttp)
	self.deps = deps
	self._failures = 0
	--- seconds added to deps.now() for request timestamps (learned from the service)
	self._skew = 0.0
	--- on the fallback until this time (deps.now()), else on base_url
	self._fallback_until = nil :: number?
	self.stats = { requests = 0, failures = 0, ms = 0, last_error = "", url = deps.base_url, switches = 0 }
	return self
end

--- The URL requests go to now.
function LobbyHttp._url(self: any): string
	local d = self.deps
	local untl = self._fallback_until
	if untl ~= nil then
		if d.now() < untl then
			return d.fallback_url
		end
		self._fallback_until = nil
		self.stats.url = d.base_url
		if d.log then
			d.log("[LobbyService] trying " .. d.base_url .. " again")
		end
	end
	return d.base_url
end

--- The domain failed this way (no answer / not the service's answer): the fallback for a while.
function LobbyHttp._route_failed(self: any, url: string, err: string)
	local d = self.deps
	if d.fallback_url == nil or d.fallback_url == "" or url ~= d.base_url then
		return
	end
	self._fallback_until = d.now() + LobbyHttp.RETRY_PRIMARY_S
	self.stats.url = d.fallback_url
	self.stats.switches += 1
	if d.log then
		d.log(string.format("[LobbyService] %s failed (%s): using %s", d.base_url, err, d.fallback_url))
	end
end

function LobbyHttp.healthy(self: any): boolean
	return self._failures < LobbyHttp.FAIL_THRESHOLD
end

function LobbyHttp._fail(self: any, err: string): (nil, string)
	self._failures += 1
	self.stats.failures += 1
	self.stats.last_error = err
	if self._failures == LobbyHttp.FAIL_THRESHOLD and self.deps.log then
		self.deps.log("[LobbyService] unreachable (" .. err .. ")")
	end
	return nil, err
end

function LobbyHttp._ok(self: any)
	if self._failures >= LobbyHttp.FAIL_THRESHOLD and self.deps.log then
		self.deps.log("[LobbyService] reachable again")
	end
	self._failures = 0
end

function LobbyHttp.post(self: any, path: string, body: { [string]: any }): (any?, string?)
	local d = self.deps
	body.protocol = 1
	body.jobId = d.job_id
	local ok_enc, raw = pcall(d.encode, body)
	if not ok_enc then
		return nil, "encode: " .. tostring(raw)
	end
	for attempt = 1, 2 do
		local ts = math.floor(d.now() + self._skew)
		local nonce = d.nonce()
		self.stats.requests += 1
		local t0 = os.clock()
		local base = self:_url()
		local ok, res = d.transport({
			Url = base .. path,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
				["X-TM-Ts"] = tostring(ts),
				["X-TM-Nonce"] = nonce,
				["X-TM-Sig"] = Signing.request(d.secret, ts, nonce, "POST", path, raw),
			},
			Body = raw,
		})
		self.stats.ms = math.floor((os.clock() - t0) * 1000)
		if not ok then
			self:_route_failed(base, tostring(res))
			return self:_fail(tostring(res))
		end
		local status = tonumber(res.StatusCode) or 0
		local text = res.Body or ""
		if status == 401 then
			-- a stale timestamp: the (unsigned) reply carries the service's time; correct and resend once
			local okd, j = pcall(d.decode, text)
			local st = if okd and type(j) == "table" then tonumber(j.serverTime) else nil
			if attempt == 1 and st ~= nil and math.abs(st - (d.now() + self._skew)) < 24 * 3600 then
				self._skew = st - d.now()
				if d.log then
					d.log(string.format("[LobbyService] clock corrected by %+.0fs for signing", self._skew))
				end
				continue
			end
			return self:_fail("http 401 (signature or clock)")
		end
		if not Signing.verify_response(d.secret, nonce, status, text, Signing.header(res.Headers, "X-TM-Sig")) then
			-- a reply we can't trust (a proxy's error page, tampering): unreachable
			local err = string.format("unsigned reply (http %d)", status)
			self:_route_failed(base, err)
			return self:_fail(err)
		end
		self:_ok()
		local okd, decoded = pcall(d.decode, text)
		if not okd or type(decoded) ~= "table" then
			return nil, "bad json"
		end
		return decoded, nil
	end
	return self:_fail("http 401")
end

--- RequestAsync with our own deadline (the call itself can hang ~30 s).
local function roblox_transport(HttpService: any, timeout: number): (any) -> (boolean, any)
	return function(req: any): (boolean, any)
		local thread = coroutine.running()
		local done = false
		task.spawn(function()
			local ok, res = pcall(function()
				return HttpService:RequestAsync(req)
			end)
			if done then
				return
			end
			done = true
			task.spawn(thread, ok, res)
		end)
		task.delay(timeout, function()
			if done then
				return
			end
			done = true
			task.spawn(thread, false, "timeout")
		end)
		return coroutine.yield()
	end
end

--- The live client, or nil when HTTP requests are off for the place / the service is not in use.
--- `url` overrides BASE_URL (Studio: the AF_LOBBY_URL attribute points at a test service); the
--- fallback is FALLBACK_URL for BASE_URL only.
function LobbyHttp.roblox(secret: string, now: () -> number, url: string?, log: ((string) -> ())?): any
	local HttpService = game:GetService("HttpService")
	local ok, enabled = pcall(function()
		return HttpService.HttpEnabled
	end)
	if not ok or enabled ~= true then
		return nil
	end
	local job = game.JobId
	if job == "" then
		job = "studio-" .. string.gsub(HttpService:GenerateGUID(false), "-", "")
	end
	local base = url or LobbyHttp.BASE_URL
	return LobbyHttp.new({
		base_url = base,
		fallback_url = if base == LobbyHttp.BASE_URL and LobbyHttp.FALLBACK_URL ~= ""
			then LobbyHttp.FALLBACK_URL
			else nil,
		secret = secret,
		job_id = job,
		transport = roblox_transport(HttpService, LobbyHttp.TIMEOUT_S),
		encode = function(t: any): string
			return HttpService:JSONEncode(t)
		end,
		decode = function(s: string): any
			return HttpService:JSONDecode(s)
		end,
		now = now,
		nonce = function(): string
			return string.lower((string.gsub(HttpService:GenerateGUID(false), "-", "")))
		end,
		log = log,
	})
end

return LobbyHttp
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">LobbyRules</string>
            <string name="Source"><![CDATA[--!strict
-- Public-lobby rules: pure logic,
-- no services, so it runs in Lune tests and on the server.
--
-- A lobby is one upcoming public match: a map, a player cap, a start time (wall clock, os.time()
-- seconds — every server shares it), and the reserved server that will run it. Hub servers (public
-- servers) list the open lobbies to their players and teleport joiners into the lobby's reserved
-- server; the match server runs a countdown to the start, then fills every empty player slot with a
-- bot player and plays the match.
--   * TARGET_OPEN lobbies are kept open, starting LOBBY_INTERVAL_S apart; each is open for
--     LOBBY_OPEN_S (90 s).
--   * Joining closes JOIN_CLOSE_S before the start (a teleport takes a few seconds).
--   * Maps rotate by the registry's multiplayer_frequency (the playlist weights), never
--     repeating the last RECENT_MAPS maps.
--   * Player cap: 50 per million full-size land tiles x 1.5 (round to 5), clamped to [MIN_PLAYERS,
--     MAX_PLAYERS]: World and larger maps host 50 (and never more than a server holds: max_players).
--   * Kinds: a free-for-all, a team game, and World's own free-for-all (MODE_WORLD, always open).

local LobbyRules = {}

LobbyRules.TARGET_OPEN = 2
--- Public match kinds: every player for itself (a record without `mode`), a team game (Core/Teams), or
--- World's own free-for-all (MODE_WORLD, 2026-10-19: a simple way to queue for a World PvP match, rather
--- than hunting for one among the others and joining matches on maps a player doesn't want; the
--- one map this mode plays is World, always open; it was the Giant World Map's for a day).
--- Its lobbies are always on World (WORLD_ID). The free-for-all rotation no longer plays World: a
--- free-for-all join takes World's seats too (takes_from), so PUBLIC MATCH and WORLD fill the same game
--- when World is the soonest.
LobbyRules.MODE_FFA = "ffa"
LobbyRules.MODE_TEAM = "team"
LobbyRules.MODE_WORLD = "world"
--- Joinable lobbies kept open per kind where team games are on (2026-10-10: one solo public match and
--- one team public match are joinable at all times). Elsewhere: TARGET_OPEN
--- free-for-all lobbies. World's: one, either way.
LobbyRules.TARGETS_WITH_TEAMS = { ffa = 1, team = 1, world = 1 }

--- The kinds of lobby a join of `mode` may seat in, in no order (the soonest that fits wins): a
--- free-for-all join (PUBLIC MATCH, any map) takes World's lobbies too (2026-10-19: the
--- WORLD and PUBLIC MATCH buttons match into the same game when World is the
--- active map); World's join and a team game's take only their own.
function LobbyRules.takes_from(mode: string): { string }
	if mode == LobbyRules.MODE_FFA then
		return { LobbyRules.MODE_FFA, LobbyRules.MODE_WORLD }
	end
	return { mode }
end

--- The kinds of public match offered, in the title's order, and how many joinable lobbies each keeps
--- open at least (more when the demand calls for them: missing_starts).
function LobbyRules.kinds(team_games: boolean?): { { mode: string, target: number } }
	if team_games then
		return {
			{ mode = LobbyRules.MODE_FFA, target = LobbyRules.TARGETS_WITH_TEAMS.ffa },
			{ mode = LobbyRules.MODE_WORLD, target = LobbyRules.TARGETS_WITH_TEAMS.world },
			{ mode = LobbyRules.MODE_TEAM, target = LobbyRules.TARGETS_WITH_TEAMS.team },
		}
	end
	return {
		{ mode = LobbyRules.MODE_FFA, target = LobbyRules.TARGET_OPEN },
		{ mode = LobbyRules.MODE_WORLD, target = LobbyRules.TARGETS_WITH_TEAMS.world },
	}
end
--- Public matches play their map at this % of its width and height (the full-size maps felt huge,
--- 2026-09-27); tribes scale with the area (Sim.default_tribes).
LobbyRules.MAP_SCALE_PCT = 80
--- (it was 2 minutes: players left long waits, so on 2026-09-27 the start
--- timers were lowered to 90 seconds. A new lobby starts at least MIN_LEAD_S out, one every
--- LOBBY_INTERVAL_S: every listed match starts within LOBBY_OPEN_S.)
LobbyRules.LOBBY_OPEN_S = 90
LobbyRules.LOBBY_INTERVAL_S = 45
LobbyRules.MIN_LEAD_S = 45
--- World's lobbies keep this far from the free-for-alls' starts (missing_starts `avoid`): the two kinds
--- kept the same schedule (each LOBBY_INTERVAL_S after its last), so their lobbies started on the same
--- second and PUBLIC MATCH, which takes World's seats when World's lobby is the sooner (takes_from),
--- never was. Half an interval apart, the soonest alternates.
LobbyRules.WORLD_STAGGER_S = 22
LobbyRules.JOIN_CLOSE_S = 6
LobbyRules.RECENT_MAPS = 3
LobbyRules.MIN_PLAYERS = 10
LobbyRules.MAX_PLAYERS = 50
LobbyRules.PLAYERS_PER_MILLION_LAND = 50 * 1.5
--- A lobby record lives this long past its start (the match server reads it on boot).
LobbyRules.RECORD_TTL_AFTER_START_S = 15 * 60
--- A running match's server refreshes its record (`beat`) this often; hubs list it as live (to watch)
--- only while the last beat is recent, so a crashed match server drops off the lists.
LobbyRules.LIVE_BEAT_S = 30
LobbyRules.LIVE_STALE_S = 100
--- Running matches listed to watch at most (most players first; the phone list shows them all).
LobbyRules.MAX_LIVE_LISTED = 8

export type Lobby = {
	id: string,
	map: string,
	map_name: string,
	max: number,
	starts: number, -- os.time() seconds
	created: number,
	players: number, -- humans in (or on their way to) the match server
	status: string, -- "open" | "started" | "closed"
	beat: number?, -- os.time() of the running match's last heartbeat
	code: string?, -- reserved-server access code (server-only; never sent to clients)
	psid: string?, -- reserved server's PrivateServerId
	mode: string?, -- MODE_TEAM for a team game, MODE_WORLD for World's own; nil: free for all
	teams: any?, -- a team game's teams: a number of teams, or Teams.DUOS / TRIOS / QUADS / HVN
	seats: { [string]: number }?, -- the seat ledger: user id -> when its seat was taken (take)
}

-- ---------------------------------------------------------------------------------------------
-- Seats (Quick Play, 2026-10-11)
-- ---------------------------------------------------------------------------------------------
-- 2026-10-11 (10k players): public matches had become too hard to get into, as they filled so
-- fast. One joinable lobby per kind filled in ~8 s, and a player clicked a card
-- the hub had listed up to ~5 s before. Now a player asks for a public match of a kind and the store
-- seats them in the soonest lobby of that kind with room, in one step (`take`); with no room
-- anywhere they wait in line on their hub until a seat is free. A lobby record keeps who holds its
-- seats (`seats`), so a seat whose player never arrives, or leaves the waiting room, is given back.

--- Seat-ledger entries a record keeps at most (the lobby service's MAX_SEATS).
LobbyRules.MAX_SEATS = 60
--- A seat whose player has not reached the match server this long after taking it is given back
--- (a teleport that failed after it began, a player who quit on the way).
LobbyRules.ARRIVE_S = 30

--- What `take` asks for: `n` seats for `uids` in the soonest open lobby of one of `modes` (takes_from
--- `mode`) with room that still takes joins (`close_before`) and was not written with a wrong clock
--- (`start_before`); `id`: only that lobby; `candidates`: lobby ids to try in order, for stores that
--- can't search (MemoryStore, the local store).
export type TakeSpec = {
	mode: string,
	modes: { string },
	n: number,
	uids: { string },
	at: number,
	close_before: number,
	start_before: number,
	id: string?,
	candidates: { string }?,
}

function LobbyRules.take_spec(mode: string, n: number, uids: { string }, now: number, id: string?): TakeSpec
	return {
		mode = mode,
		modes = LobbyRules.takes_from(mode),
		n = n,
		uids = uids,
		at = now,
		close_before = now + LobbyRules.JOIN_CLOSE_S,
		start_before = now + LobbyRules.MAX_AHEAD_S,
		id = id,
	}
end

--- True when `l` can seat what `spec` asks for (the service's take compares the same).
function LobbyRules.fits(l: Lobby, spec: TakeSpec): boolean
	return l.status == "open"
		and table.find(spec.modes or { spec.mode }, LobbyRules.mode_of(l)) ~= nil
		and l.starts > spec.close_before
		and l.starts <= spec.start_before
		and l.players + spec.n <= l.max
		and (spec.id == nil or spec.id == l.id)
end

--- `l` with `spec`'s seats taken (a new table; `l` is left as it was).
function LobbyRules.seated(l: Lobby, spec: TakeSpec): Lobby
	local c = table.clone(l)
	local seats = if l.seats ~= nil then table.clone(l.seats) else {}
	local count = 0
	for _ in seats do
		count += 1
	end
	for _, u in spec.uids do
		if seats[u] == nil and count < LobbyRules.MAX_SEATS then
			seats[u] = spec.at
			count += 1
		end
	end
	c.players += spec.n
	c.seats = seats
	return c
end

--- `l` with the seats of `uids` given back (only seats in its ledger, and only while open): the new
--- record and how many went back (0: unchanged).
function LobbyRules.released(l: Lobby, uids: { string }): (Lobby, number)
	if l.status ~= "open" or l.seats == nil then
		return l, 0
	end
	local seats = table.clone(l.seats)
	local n = 0
	for _, u in uids do
		if seats[u] ~= nil then
			seats[u] = nil
			n += 1
		end
	end
	if n == 0 then
		return l, 0
	end
	local c = table.clone(l)
	c.seats = seats
	c.players = math.max(0, l.players - n)
	return c, n
end

--- Seats of a waiting lobby to give back (MatchHost, before the start): of `l`'s ledger, those whose
--- player arrived and has left (`arrived` but not `present`), and those whose player has not arrived
--- ARRIVE_S after taking the seat.
function LobbyRules.lapsed_seats(l: Lobby, present: { [string]: boolean }, arrived: { [string]: boolean }, now: number): { string }
	local out = {}
	for u, at in l.seats or {} do
		if present[u] then
			continue
		end
		if arrived[u] or now - at >= LobbyRules.ARRIVE_S then
			table.insert(out, u)
		end
	end
	table.sort(out)
	return out
end

-- Demand: with more players joining than one lobby holds for long, more lobbies of a kind are kept
-- open, starting one after another, so a free seat is always there to take.

--- Seats taken lately over this many seconds measure the demand for a kind of lobby.
LobbyRules.DEMAND_WINDOW_S = 120
--- Free seats kept open per kind: this many seconds of joins at the measured demand.
LobbyRules.FILL_AHEAD_S = 20
--- Joinable lobbies of one kind at most.
LobbyRules.MAX_OPEN_PER_KIND = 4
--- Lobbies of one kind start at least this far apart (and at most LOBBY_INTERVAL_S).
LobbyRules.MIN_INTERVAL_S = 8

export type Demand = { rate: number, size: number }

--- The demand for `mode` lobbies: `rate` = seats taken a second (the players of the lobbies of that
--- kind made in the last DEMAND_WINDOW_S: seats taken so far while open, the humans who started a
--- started one), `size` = their average size. `window`: seconds the list covers (less when it holds
--- only the latest running matches).
function LobbyRules.demand(list: { Lobby }, now: number, mode: string, window: number?): Demand
	local w = math.clamp(window or LobbyRules.DEMAND_WINDOW_S, 30, LobbyRules.DEMAND_WINDOW_S)
	local seats, sizes, n = 0, 0, 0
	for _, l in list do
		if LobbyRules.mode_of(l) == mode and l.created > now - w and l.created <= now then
			seats += math.min(l.players, l.max)
			sizes += l.max
			n += 1
		end
	end
	return { rate = seats / w, size = if n > 0 then sizes / n else LobbyRules.max_players(nil) }
end

local function round5(n: number): number
	return math.floor(n / 5 + 0.5) * 5
end

--- Player cap for a map with `land_tiles` land tiles at full resolution (`k_lin` = full-size tiles
--- per our tile: our land count * k_lin^2 = the full-size map's) x PLAYERS_PER_MILLION_LAND / 1e6, rounded
--- to 5, 10..50, and at most `server` (the most players a Roblox server of the place holds,
--- Players.MaxPlayers: a seat past it is a "GameFull" teleport).
--- (2026-10-19: up to 50 players a lobby, where the map supports it. It was that
--- count times MAP_SCALE_PCT's area, so 50-player maps hosted 30 (2026-09-27: smaller maps, fewer
--- players). The map is still played at MAP_SCALE_PCT.)
function LobbyRules.max_players(land_tiles: number?, k_lin: number?, server: number?): number
	local full = LobbyRules.MAX_PLAYERS
	if land_tiles ~= nil and land_tiles > 0 then
		local k = k_lin or 1.0
		local src_land = land_tiles * k * k
		full = math.clamp(round5(src_land / 1e6 * LobbyRules.PLAYERS_PER_MILLION_LAND), LobbyRules.MIN_PLAYERS, LobbyRules.MAX_PLAYERS)
	end
	if type(server) == "number" and server >= LobbyRules.MIN_PLAYERS then
		full = math.min(full, math.floor(server))
	end
	return full
end

--- Weighted map pick: entries { id, weight } (weight <= 0 never picked), skipping `recent` ids;
--- `r` in [0, 1). Falls back to any map when every candidate is recent.
function LobbyRules.pick_map(entries: { { id: string, weight: number } }, recent: { string }, r: number): string?
	-- World only waits for one other map (a rotation that has it: the team playlist); every other map
	-- waits out RECENT_MAPS
	local function held(skip_recent: boolean, id: string): boolean
		if not skip_recent then
			return false
		end
		if id == LobbyRules.WORLD_ID then
			return recent[1] == id
		end
		return table.find(recent, id) ~= nil
	end
	local function pick(skip_recent: boolean): string?
		local total = 0.0
		for _, e in entries do
			if e.weight > 0 and not held(skip_recent, e.id) then
				total += e.weight
			end
		end
		if total <= 0 then
			return nil
		end
		local x = r * total
		for _, e in entries do
			if e.weight > 0 and not held(skip_recent, e.id) then
				x -= e.weight
				if x < 0 then
					return e.id
				end
			end
		end
		-- rounding: the last eligible entry
		for i = #entries, 1, -1 do
			local e = entries[i]
			if e.weight > 0 and not held(skip_recent, e.id) then
				return e.id
			end
		end
		return nil
	end
	return pick(true) or pick(false)
end

--- The free-for-all playlist (2026-09-29: fewer odd maps in public matches, and regular World much
--- more common): the playlist weights
--- (multiplayer_frequency), the odd maps (WEIRD_CATEGORIES: fictional, cosmic, arcade) at WEIRD_FACTOR
--- of their weight, and no World: World's own lobby (MODE_WORLD, always open) takes PUBLIC MATCH's seats
--- whenever it is the soonest (takes_from), which is how World stays common (it was weighted to
--- WORLD_SHARE, 40% of this rotation, until 2026-10-19).
LobbyRules.WORLD_ID = "shinobi"
LobbyRules.WEIRD_FACTOR = 0.15
LobbyRules.WEIRD_CATEGORIES = { fictional = true, cosmic = true, arcade = true }

function LobbyRules.public_weights(maps: { any }): { { id: string, weight: number } }
	local out = {}
	for _, m in maps do
		local w = math.max(0, tonumber(m.weight) or 0)
		if m.id ~= LobbyRules.WORLD_ID then
			for _, c in (if type(m.categories) == "table" then m.categories else {}) do
				if LobbyRules.WEIRD_CATEGORIES[c] then
					w *= LobbyRules.WEIRD_FACTOR
					break
				end
			end
			table.insert(out, { id = m.id, weight = w })
		end
	end
	-- (2026-10-26: World is the only map, so the playlist is World: without it no lobby is made)
	if #out == 0 then
		for _, m in maps do
			if m.id == LobbyRules.WORLD_ID then
				table.insert(out, { id = m.id, weight = math.max(0, tonumber(m.weight) or 0) })
			end
		end
	end
	return out
end

--- True while players may still join (open, not full, far enough from the start).
function LobbyRules.joinable(l: Lobby, now: number): boolean
	return l.status == "open" and l.players < l.max and now < l.starts - LobbyRules.JOIN_CLOSE_S
end

--- Start times of the lobbies to create now so that TARGET_OPEN joinable lobbies exist: after the
--- latest joinable start (or now + MIN_LEAD_S), LOBBY_INTERVAL_S apart. Full lobbies don't push the
--- next ones back: when players pour in (1.1k at once, 2026-09-27) a full lobby is replaced at once,
--- so the matches on offer keep up with the players.
--- Never more than LOBBY_OPEN_S out: a start that would land later waits until it fits (a later
--- refresh makes it). Each vote-started or filled lobby used to put its replacement LOBBY_INTERVAL_S
--- after the latest one, and a few in a row marched the schedule out to 4+ minutes (2026-09-28: it
--- should be about 90 seconds at most). The soonest lobby stays joinable meanwhile, and the next one is
--- made by the time it is LOBBY_INTERVAL_S from its start.
--- `mode`, `target`: per kind (team games on). Then a lobby within half LOBBY_INTERVAL_S of its start
--- no longer counts, so the next one is made before it closes (JOIN_CLOSE_S): with one lobby of each
--- kind wanted, there is always one to join (the soonest is listed; the next waits behind it).
--- `demand` (LobbyRules.demand): more lobbies while the free seats of the joinable ones would last
--- less than FILL_AHEAD_S at that rate (MAX_OPEN_PER_KIND at most), each starting about as long after
--- the one before as it takes to fill (MIN_INTERVAL_S..LOBBY_INTERVAL_S). At 10k players a lobby
--- filled in ~8 s and 27% of the time no lobby of a kind had a free seat (2026-10-11).
--- `avoid` (World's: the free-for-alls' starts, made and about to be): on the quiet schedule the first
--- new start that would fall within WORLD_STAGGER_S of one moves to WORLD_STAGGER_S after it (once, and
--- not past LOBBY_OPEN_S), so a schedule that started level (every lobby until 2026-10-19) comes apart.
function LobbyRules.missing_starts(
	open: { Lobby },
	now: number,
	mode: string?,
	target: number?,
	demand: Demand?,
	avoid: { number }?
): { number }
	local joinable = 0
	local free = 0
	local latest = 0
	local want = mode or LobbyRules.MODE_FFA
	local cover = if mode ~= nil then LobbyRules.LOBBY_INTERVAL_S / 2 else 0
	for _, l in open do
		if LobbyRules.mode_of(l) == want and LobbyRules.joinable(l, now) then
			if l.starts - now > cover then
				joinable += 1
				free += l.max - l.players
			end
			if l.starts > latest then
				latest = l.starts
			end
		end
	end
	local base = target or LobbyRules.TARGET_OPEN
	local want_free = 0
	local interval = LobbyRules.LOBBY_INTERVAL_S
	local size = LobbyRules.max_players(nil)
	if demand ~= nil and demand.rate > 0 then
		want_free = demand.rate * LobbyRules.FILL_AHEAD_S
		size = math.max(1, demand.size)
		interval = math.clamp(size / demand.rate, LobbyRules.MIN_INTERVAL_S, LobbyRules.LOBBY_INTERVAL_S)
	end
	local out = {}
	local next_start = math.max(now + LobbyRules.MIN_LEAD_S, latest + interval)
	if avoid ~= nil and interval >= LobbyRules.LOBBY_INTERVAL_S then
		for _, a in avoid do
			if math.abs(next_start - a) < LobbyRules.WORLD_STAGGER_S then
				local moved = a + LobbyRules.WORLD_STAGGER_S
				if moved <= now + LobbyRules.LOBBY_OPEN_S then
					next_start = moved
				end
				break
			end
		end
	end
	while joinable < base or (free < want_free and joinable < math.max(base, LobbyRules.MAX_OPEN_PER_KIND)) do
		if next_start > now + LobbyRules.LOBBY_OPEN_S then
			break
		end
		table.insert(out, next_start)
		joinable += 1
		free += size
		next_start += interval
	end
	return out
end

--- The map id a public match on `map` plays ("world@80").
function LobbyRules.match_map_id(map: string): string
	return if LobbyRules.MAP_SCALE_PCT < 100 then map .. "@" .. LobbyRules.MAP_SCALE_PCT else map
end

--- No lobby is ever scheduled further ahead than this (the open window plus the queue behind it,
--- with slack). A record beyond it was written with a wrong clock: ignored by the hubs, and its match
--- server does not wait past it.
LobbyRules.MAX_AHEAD_S = LobbyRules.LOBBY_OPEN_S + LobbyRules.TARGET_OPEN * LobbyRules.LOBBY_INTERVAL_S + 120

function LobbyRules.plausible(l: Lobby, now: number): boolean
	return l.starts <= now + LobbyRules.MAX_AHEAD_S
end

--- A running match anyone may watch (its server is alive and reachable).
function LobbyRules.watchable(l: Lobby, now: number): boolean
	return l.status == "started" and l.code ~= nil and (l.beat or l.starts) > now - LobbyRules.LIVE_STALE_S
end

--- A lobby's kind (MODE_FFA / MODE_TEAM / MODE_WORLD).
function LobbyRules.mode_of(l: Lobby): string
	return if l.mode == LobbyRules.MODE_TEAM or l.mode == LobbyRules.MODE_WORLD then l.mode else LobbyRules.MODE_FFA
end

--- Is `mode` a kind of public match ("ffa" | "team" | "world")?
function LobbyRules.is_mode(mode: any): boolean
	return mode == LobbyRules.MODE_FFA or mode == LobbyRules.MODE_TEAM or mode == LobbyRules.MODE_WORLD
end

--- What a client sees of a lobby (no access code / server id). Live matches: `live`, `elapsed`.
function LobbyRules.public_view(l: Lobby, now: number): { [string]: any }
	local live = l.status == "started"
	return {
		mode = if l.mode == LobbyRules.MODE_TEAM or l.mode == LobbyRules.MODE_WORLD then l.mode else nil,
		teams = if l.mode == LobbyRules.MODE_TEAM then l.teams else nil,
		id = l.id,
		map = l.map,
		map_name = l.map_name,
		max = l.max,
		players = math.min(l.players, l.max),
		starts_in = math.max(0, l.starts - now),
		joinable = LobbyRules.joinable(l, now),
		live = live,
		elapsed = if live then math.max(0, now - l.starts) else 0,
		watchable = LobbyRules.watchable(l, now),
	}
end

--- Bot players to add at the start so the match has `max` players.
function LobbyRules.bot_fill(max: number, humans: number): number
	return math.max(0, max - humans)
end

--- Sanitises a lobby record read back from a store (anything a client or a stale version could have
--- left malformed); nil when unusable.
function LobbyRules.decode(v: any): Lobby?
	if type(v) ~= "table" then
		return nil
	end
	-- (a team game's size is `slots` in the store: LobbyStore.encode)
	local size = if type(v.max) == "number" then v.max elseif type(v.slots) == "number" then v.slots else nil
	if type(v.id) ~= "string" or type(v.map) ~= "string" or type(v.starts) ~= "number" or size == nil then
		return nil
	end
	-- the seat ledger (an empty one may come back as an array: Roblox writes {} as [])
	local seats = nil
	if type(v.seats) == "table" then
		seats = {}
		local n = 0
		for u, at in v.seats do
			if type(u) == "string" and #u <= 24 and type(at) == "number" and n < LobbyRules.MAX_SEATS then
				seats[u] = at
				n += 1
			end
		end
	end
	return {
		id = v.id,
		map = v.map,
		map_name = if type(v.map_name) == "string" then v.map_name else v.map,
		max = math.clamp(math.floor(size), 1, 200),
		starts = v.starts,
		created = if type(v.created) == "number" then v.created else v.starts,
		players = if type(v.players) == "number" then math.max(0, math.floor(v.players)) else 0,
		status = if v.status == "started" or v.status == "closed" then v.status else "open",
		beat = if type(v.beat) == "number" then v.beat else nil,
		code = if type(v.code) == "string" then v.code else nil,
		psid = if type(v.psid) == "string" then v.psid else nil,
		mode = if v.mode == LobbyRules.MODE_TEAM or v.mode == LobbyRules.MODE_WORLD then v.mode else nil,
		teams = if v.mode == LobbyRules.MODE_TEAM and (type(v.teams) == "number" or type(v.teams) == "string")
			then v.teams
			else nil,
		seats = seats,
	}
end

-- ---------------------------------------------------------------------------------------------
-- Team games (staging only for now)
-- ---------------------------------------------------------------------------------------------

LobbyRules.DUOS = "Duos"
LobbyRules.TRIOS = "Trios"
LobbyRules.QUADS = "Quads"
LobbyRules.HVN = "Humans Vs Nations"
--- Team-count weights (total 100).
LobbyRules.TEAM_COUNT_WEIGHTS = ({
	{ 2, 10 },
	{ 3, 10 },
	{ 4, 10 },
	{ 5, 10 },
	{ 6, 10 },
	{ 7, 10 },
	{ LobbyRules.DUOS, 5 },
	{ LobbyRules.TRIOS, 7.5 },
	{ LobbyRules.QUADS, 7.5 },
	{ LobbyRules.HVN, 20 },
} :: { { any } })
--- Maps made for a number of teams, played with it 3 times in 4.
LobbyRules.SPECIAL_TEAM_COUNT = {
	aegean = 2,
	babelmandebstrait = 2,
	baikal = 2,
	beringsea = 2,
	beringstrait = 2,
	bosphorusstraits = 2,
	caspiansea = 2,
	conakry = 2,
	falklandislands = 2,
	korea = 2,
	madagascar = 2,
	pulicatlake = 2,
	straitofgibraltar = 2,
	straitofhormuz = 2,
	taiwanstrait = 2,
	vietnam = 2,
	gulfofstlawrence = 3,
	irishsea = 3,
	juandefucastrait = 3,
}
LobbyRules.SPECIAL_TEAM_CHANCE = 0.75
--- A map's weight in team games; a map not listed weighs its multiplayer_frequency.
LobbyRules.TEAM_FREQUENCY = {
	babelmandebstrait = 10,
	beringsea = 10,
	beringstrait = 5,
	bosphorusstraits = 10,
	canaryislands = 10,
	caspiansea = 10,
	channelislands = 7,
	conakry = 6,
	falklandislands = 8,
	gulfofstlawrence = 8,
	juandefucastrait = 8,
	korea = 10,
	madagascar = 10,
	straitofgibraltar = 10,
	straitofhormuz = 8,
	taiwanstrait = 10,
	vietnam = 8,
	archipelagosea = 0,
}
--- A team game holds 1.5 times the free-for-all count, up to this many.
LobbyRules.TEAM_PLAYERS_FACTOR = 1.5
LobbyRules.MAX_TEAM_PLAYERS = 30

--- The team playlist's weights: { id, weight } (TEAM_FREQUENCY, else the map's weight).
function LobbyRules.team_weights(maps: { any }): { { id: string, weight: number } }
	local out = {}
	for _, m in maps do
		local f: number? = (LobbyRules.TEAM_FREQUENCY :: { [string]: number })[m.id]
		local w = if f ~= nil then f else math.max(0, tonumber(m.weight) or 0)
		table.insert(out, { id = m.id, weight = w })
	end
	return out
end

--- A team game's teams on `map` (`r1`, `r2` in [0, 1)): the map's own count 3 times in 4, else
--- TEAM_COUNT_WEIGHTS.
function LobbyRules.team_config(map: string, r1: number, r2: number): any
	local special = LobbyRules.SPECIAL_TEAM_COUNT[map]
	if special ~= nil and r1 < LobbyRules.SPECIAL_TEAM_CHANCE then
		return special
	end
	local total = 0
	for _, e in LobbyRules.TEAM_COUNT_WEIGHTS do
		total += e[2] :: number
	end
	local x = r2 * total
	for _, e in LobbyRules.TEAM_COUNT_WEIGHTS do
		x -= e[2] :: number
		if x < 0 then
			return e[1]
		end
	end
	return 2
end

--- A team game's player slots and teams for a map whose free-for-all count is `ffa_slots`:
--- 1.5 times as many (MAX_TEAM_PLAYERS at most), then a multiple
--- of the team size; a number of teams too large for 2 players each becomes as many as fit. Humans
--- Vs Nations: the slots are the humans' half (as many nations join them).
function LobbyRules.team_slots(ffa_slots: number, teams: any): (number, any)
	local p = math.min(LobbyRules.MAX_TEAM_PLAYERS, math.ceil(ffa_slots * LobbyRules.TEAM_PLAYERS_FACTOR))
	if teams == LobbyRules.HVN then
		return math.max(2, p // 2), teams
	end
	local size = if teams == LobbyRules.DUOS then 2 elseif teams == LobbyRules.TRIOS then 3 elseif teams == LobbyRules.QUADS then 4 else nil
	if size ~= nil then
		return math.max(size * 2, p - p % size), teams
	end
	local n = math.max(2, math.floor(tonumber(teams) or 2))
	if p // n < 2 then
		n = math.max(2, p // 2)
	end
	return p - p % n, n
end

return LobbyRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">LobbyStore</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby storage for LobbyDirectory / MatchHost:
--   LobbyStore.memory()  the live game: MemoryStoreService (shared by every server of the
--                        experience) — a sorted map of lobby records (sort key = start time), a
--                        hash map PrivateServerId -> lobby id, and a sorted map of short locks;
--   LobbyStore.localstore() one process only (Lune tests, Studio when MemoryStore is unavailable).
-- Both expose: list(), get(id), put(lobby, ttl_s), update(id, fn), remove(id), lock(name, ttl_s),
-- bind_psid(psid, id, ttl_s), lobby_for_psid(psid), take(spec), release(id, uids). All MemoryStore
-- calls yield and may throw (callers pcall).
local LobbyRules = require("./LobbyRules")

local LobbyStore = {}

LobbyStore.NAMESPACE = "rofront_v1"
LobbyStore.LIST_LIMIT = 50

--- What a record is written as. A team game's record (and World's own kind's, 2026-10-19) keeps its
--- size as `slots`, not `max`: older servers decode only records with a numeric `max`, so while they
--- still run (a delayed restart) they leave those kinds alone (not listed, not counted, never
--- rewritten without their `mode`). LobbyRules.decode reads either.
function LobbyStore.encode(v: any): any
	if type(v) == "table" and (v.mode == "team" or v.mode == "world") and type(v.max) == "number" then
		local c = table.clone(v)
		c.slots = v.max
		c.max = nil
		return c
	end
	return v
end
local encode = LobbyStore.encode

--- `take` over `update` (stores that can't search: MemoryStore, the local store): the spec's
--- candidates in order (or its one `id`), the first that fits gets the seats. Returns the record.
local function take_via_update(store: any, spec: LobbyRules.TakeSpec): any
	local ids = if spec.id ~= nil then { spec.id } else (spec.candidates or {})
	for _, id in ids do
		local got: any = nil
		store.update(id, function(v: any): any?
			-- (UpdateAsync may run this again on a newer record: only the last run counts)
			got = nil
			local l = LobbyRules.decode(v)
			if l == nil or not LobbyRules.fits(l, spec) then
				return nil
			end
			got = LobbyRules.seated(l, spec)
			return got
		end)
		if got ~= nil then
			return got
		end
	end
	return nil
end

--- `release` over `update`: the record after, and how many seats went back.
local function release_via_update(store: any, id: string, uids: { string }): (any, number)
	local n = 0
	local after: any = nil
	store.update(id, function(v: any): any?
		n = 0
		local l = LobbyRules.decode(v)
		if l == nil then
			return nil
		end
		local c, k = LobbyRules.released(l, uids)
		after = c
		n = k
		return if k > 0 then c else nil
	end)
	return after, n
end

--- MemoryStoreService-backed store (live servers).
--- `now`: the shared clock (SharedClock.now) — lock expiry times are compared across servers.
function LobbyStore.memory(job_id: string, now: (() -> number)?)
	local MSS = game:GetService("MemoryStoreService")
	return LobbyStore.memory_with(
		MSS:GetSortedMap(LobbyStore.NAMESPACE .. "_lobbies"),
		MSS:GetHashMap(LobbyStore.NAMESPACE .. "_psid"),
		MSS:GetSortedMap(LobbyStore.NAMESPACE .. "_locks"),
		job_id,
		now
	)
end

--- The memory store over given maps (tests pass fakes).
function LobbyStore.memory_with(lobbies: any, psids: any, locks: any, job_id: string, now: (() -> number)?)
	local clock = now or os.time
	local store = {}

	--- Both ends of the start-time order: the oldest records (running matches) and the newest (the
	--- open lobbies), so many live matches never push the open lobbies off the list.
	function store.list(): { any }
		local out = {}
		local seen = {}
		for _, dir in { Enum.SortDirection.Ascending, Enum.SortDirection.Descending } do
			local items = lobbies:GetRangeAsync(dir, LobbyStore.LIST_LIMIT)
			for _, it in items do
				if not seen[it.key] then
					seen[it.key] = true
					table.insert(out, it.value)
				end
			end
		end
		return out
	end

	function store.get(id: string): any
		return (lobbies:GetAsync(id))
	end

	function store.put(l: any, ttl_s: number)
		lobbies:SetAsync(l.id, encode(l), math.floor(ttl_s), l.starts)
	end

	--- Atomic read-modify-write; `fn` returns the new record or nil (leave unchanged).
	function store.update(id: string, fn: (any) -> any): any
		return lobbies:UpdateAsync(id, function(old: any, _sort: any): (any, any)
			local new = fn(old)
			if new == nil then
				return nil
			end
			return encode(new), new.starts
		end, 15 * 60)
	end

	function store.remove(id: string)
		lobbies:RemoveAsync(id)
	end

	--- A short lease: true when this server holds `name` now.
	function store.lock(name: string, ttl_s: number): boolean
		local got = false
		local now = clock()
		locks:UpdateAsync(name, function(old: any): any
			local exp = if type(old) == "table" then (tonumber(old.exp) or 0) else 0
			-- held, unless it claims to last far longer than any lease (a wrong clock wrote it)
			if type(old) == "table" and old.owner ~= job_id and exp > now and exp <= now + ttl_s + 60 then
				return nil
			end
			got = true
			return { owner = job_id, exp = now + ttl_s }
		end, ttl_s + 5)
		return got
	end

	function store.bind_psid(psid: string, id: string, ttl_s: number)
		psids:SetAsync(psid, id, math.floor(ttl_s))
	end

	function store.lobby_for_psid(psid: string): any
		local id = psids:GetAsync(psid)
		if type(id) ~= "string" then
			return nil
		end
		return (lobbies:GetAsync(id))
	end

	function store.take(spec: LobbyRules.TakeSpec): any
		return take_via_update(store, spec)
	end

	function store.release(id: string, uids: { string }): (any, number)
		return release_via_update(store, id, uids)
	end

	return store
end

--- update() tries at most this many compare-and-sets (each conflict reply carries the current row,
--- so a retry costs one round trip).
LobbyStore.CAS_TRIES = 12
--- An update keeps the record this long (as UpdateAsync's expiration did in the memory store).
LobbyStore.UPDATE_TTL_S = 15 * 60
--- Running matches a list from the service carries (the latest started), with every open lobby: a
--- hub shows a few running matches and needs the latest maps, not every match of the last 15
--- minutes (2026-10-11: 250 records to each of ~530 hubs every 3 s).
LobbyStore.LIST_LIVE = 64

--- The lobby service on easy-1 (LobbyHttp client; docs/lobby-service.md): the same API over signed
--- HTTP, so hundreds of servers reading the list every few seconds don't hit MemoryStore's
--- per-partition limits. `role` ("hub" | "match") only labels the caller in the service's health.
--- `store.enabled` is the service's LOBBIES switch from the last list.
--- `presence` (hubs): who on this server is doing what (Analytics.presence), sent with every list for
--- the service's live stats page.
function LobbyStore.http(client: any, role: string?, wait: ((number) -> ())?, presence: (() -> any)?)
	local store = {}
	store.enabled = true
	local tl = task :: any -- (nil under plain Luau)
	local pause = wait or (if tl ~= nil then tl.wait else nil)

	local function call(path: string, body: { [string]: any }): any
		body.role = role
		local r, err = client:post(path, body)
		if r == nil then
			error("lobby service: " .. tostring(err), 0)
		end
		if r.ok ~= true and r.err ~= "conflict" then
			error("lobby service: " .. tostring(r.err), 0)
		end
		return r
	end

	local function value(r: any): any
		return if type(r.value) == "table" then r.value else nil
	end

	function store.list(): { any }
		local body = {}
		if presence ~= nil then
			local ok, p = pcall(presence)
			if ok and type(p) == "table" then
				body.presence = p
			end
		end
		body.live = LobbyStore.LIST_LIVE
		local r = call("/v1/lobbies/list", body)
		store.enabled = r.enabled ~= false
		local out = {}
		for _, it in (if type(r.items) == "table" then r.items else {}) do
			if type(it) == "table" and type(it.value) == "table" then
				table.insert(out, it.value)
			end
		end
		return out
	end

	function store.get(id: string): any
		return value(call("/v1/lobbies/get", { id = id }))
	end

	function store.put(l: any, ttl_s: number)
		call("/v1/lobbies/put", { id = l.id, value = encode(l), sort = l.starts, ttl = math.floor(ttl_s) })
	end

	--- Read, apply `fn`, write if nobody wrote in between (else `fn` again on the row the conflict
	--- reply carries). `fn` returns the new record or nil (leave unchanged), as UpdateAsync's.
	function store.update(id: string, fn: (any) -> any): any
		local r = call("/v1/lobbies/get", { id = id })
		for attempt = 1, LobbyStore.CAS_TRIES do
			if attempt > 2 and pause ~= nil then
				-- many servers writing one lobby (a flood of joins): spread the retries out
				pause(math.random() * 0.03 * attempt)
			end
			local new = fn(value(r))
			if new == nil then
				return nil
			end
			local w = call("/v1/lobbies/cas", {
				id = id,
				expect = tonumber(r.version) or 0,
				value = encode(new),
				sort = new.starts,
				ttl = LobbyStore.UPDATE_TTL_S,
			})
			if w.ok == true then
				return new
			end
			r = w
		end
		error("lobby service: busy (" .. id .. ")", 0)
	end

	function store.remove(id: string)
		call("/v1/lobbies/remove", { id = id })
	end

	function store.lock(name: string, ttl_s: number): boolean
		return call("/v1/locks/acquire", { name = name, ttl = ttl_s }).got == true
	end

	function store.bind_psid(psid: string, id: string, ttl_s: number)
		call("/v1/psid/bind", { psid = psid, id = id, ttl = math.floor(ttl_s) })
	end

	function store.lobby_for_psid(psid: string): any
		return value(call("/v1/psid/lookup", { psid = psid }))
	end

	--- Seats in one step: the service picks the soonest lobby that fits (LobbyRules.TakeSpec) and
	--- writes the seats at once (no read, no conflicts). The record, or nil when none has room.
	function store.take(spec: LobbyRules.TakeSpec): any
		return value(call("/v1/lobbies/take", {
			mode = spec.mode,
			-- (the kinds it takes: a free-for-all join takes World's lobbies too; a service from before
			-- 2026-10-19 reads only `mode`)
			modes = spec.modes,
			n = spec.n,
			uids = spec.uids,
			at = spec.at,
			closeBefore = spec.close_before,
			startBefore = spec.start_before,
			id = spec.id,
		}))
	end

	function store.release(id: string, uids: { string }): (any, number)
		local r = call("/v1/lobbies/release", { id = id, uids = uids })
		return value(r), tonumber(r.released) or 0
	end

	return store
end

--- Two stores as one: `primary` (the lobby service) while it answers and is switched on, else
--- `fallback` (MemoryStore). A lobby stays in the store it was listed from or written to, so a
--- match server keeps updating the store its lobby lives in whichever one hubs use now.
--- A failed list while the service still counts as healthy (a blip) fails the refresh (the hub
--- keeps its cached list) instead of switching: only a down (or switched off) service moves hubs
--- to MemoryStore, and they try the service again every PROBE_S.
---   deps = { healthy = function() -> boolean, clock = function() -> number, log = function(text)? }
LobbyStore.PROBE_S = 15
function LobbyStore.failover(primary: any, fallback: any, deps: { [string]: any })
	local clock = deps.clock or os.clock
	local home: { [string]: any } = {}
	local on_primary = true
	local retry_at = 0.0
	local store = {}

	local function switch(to_primary: boolean, why: string)
		if on_primary ~= to_primary then
			on_primary = to_primary
			if deps.log then
				deps.log(
					if to_primary
						then "[Lobbies] using the lobby service"
						else "[Lobbies] using MemoryStore (" .. why .. ")"
				)
			end
		end
		if not to_primary then
			retry_at = clock() + LobbyStore.PROBE_S
		end
	end

	local function active(): any
		return if on_primary then primary else fallback
	end

	local function mark(list: { any }, s: any)
		for _, v in list do
			if type(v) == "table" and type(v.id) == "string" then
				home[v.id] = s
			end
		end
	end

	--- Which store is in use now ("service" | "memory"), for logs and diagnostics.
	function store.backend(): string
		return if on_primary then "service" else "memory"
	end

	--- On MemoryStore: is the service back? Checked in its own thread where there is one (Roblox), so a
	--- service that doesn't answer never holds up the refresh; inline otherwise (Lune tests).
	local probing = false
	local probe_ok = false
	local function probe()
		local ok, list = pcall(primary.list)
		probe_ok = ok and primary.enabled ~= false and type(list) == "table"
		probing = false
		if not probe_ok then
			retry_at = clock() + LobbyStore.PROBE_S
		end
	end

	function store.list(): { any }
		if not on_primary and not probing and clock() >= retry_at then
			probing = true
			local tl = task :: any -- (nil under plain Luau)
			if deps.spawn then
				deps.spawn(probe)
			elseif tl ~= nil then
				tl.spawn(probe)
			else
				probe()
			end
		end
		if on_primary or probe_ok then
			probe_ok = false
			local ok, list = pcall(primary.list)
			if ok then
				if primary.enabled == false then
					switch(false, "switched off on the service")
				else
					switch(true, "")
					mark(list, primary)
					return list
				end
			elseif on_primary and deps.healthy() then
				error(list, 0)
			else
				switch(false, tostring(list))
			end
		end
		local list = fallback.list()
		mark(list, fallback)
		return list
	end

	function store.get(id: string): any
		return (home[id] or active()).get(id)
	end

	function store.put(l: any, ttl_s: number)
		local s = active()
		s.put(l, ttl_s)
		home[l.id] = s
	end

	function store.update(id: string, fn: (any) -> any): any
		return (home[id] or active()).update(id, fn)
	end

	function store.remove(id: string)
		local s = home[id] or active()
		home[id] = nil
		s.remove(id)
	end

	function store.lock(name: string, ttl_s: number): boolean
		return active().lock(name, ttl_s)
	end

	function store.bind_psid(psid: string, id: string, ttl_s: number)
		local s = home[id] or active()
		s.bind_psid(psid, id, ttl_s)
	end

	--- Seats from the store in use (a lobby the service seats in lives there).
	function store.take(spec: LobbyRules.TakeSpec): any
		local s = if spec.id ~= nil then (home[spec.id] or active()) else active()
		local v = s.take(spec)
		if type(v) == "table" and type(v.id) == "string" then
			home[v.id] = s
		end
		return v
	end

	function store.release(id: string, uids: { string }): (any, number)
		return (home[id] or active()).release(id, uids)
	end

	--- A match server finds its lobby in whichever store the hub that made it used.
	function store.lobby_for_psid(psid: string): any
		local ok, v = pcall(primary.lobby_for_psid, psid)
		if ok and type(v) == "table" then
			home[v.id] = primary
			return v
		end
		local fv = fallback.lobby_for_psid(psid)
		if type(fv) == "table" and type(fv.id) == "string" then
			home[fv.id] = fallback
		end
		return fv
	end

	return store
end

--- In-process store with the same API (no expiry handling beyond the TTL timestamps).
function LobbyStore.localstore(now: (() -> number)?)
	local clock = now or os.time
	local rows: { [string]: { value: any, exp: number } } = {}
	local psid_rows: { [string]: string } = {}
	local lock_rows: { [string]: { owner: string, exp: number } } = {}
	local store = {}

	local function live(id: string): any
		local r = rows[id]
		if r == nil then
			return nil
		end
		if r.exp <= clock() then
			rows[id] = nil
			return nil
		end
		return table.clone(r.value)
	end

	function store.list(): { any }
		local out = {}
		for id in rows do
			local v = live(id)
			if v ~= nil then
				table.insert(out, v)
			end
		end
		table.sort(out, function(a, b)
			return a.starts < b.starts
		end)
		return out
	end

	function store.get(id: string): any
		return live(id)
	end

	function store.put(l: any, ttl_s: number)
		rows[l.id] = { value = table.clone(encode(l)), exp = clock() + ttl_s }
	end

	function store.update(id: string, fn: (any) -> any): any
		local new = fn(live(id))
		if new == nil then
			return nil
		end
		local exp = if rows[id] then rows[id].exp else clock() + 15 * 60
		rows[id] = { value = table.clone(encode(new)), exp = exp }
		return new
	end

	function store.remove(id: string)
		rows[id] = nil
	end

	function store.lock(name: string, ttl_s: number, owner: string?): boolean
		local who = owner or "local"
		local r = lock_rows[name]
		local t = clock()
		if r ~= nil and r.owner ~= who and r.exp > t and r.exp <= t + ttl_s + 60 then
			return false
		end
		lock_rows[name] = { owner = who, exp = clock() + ttl_s }
		return true
	end

	function store.bind_psid(psid: string, id: string, _ttl_s: number)
		psid_rows[psid] = id
	end

	function store.lobby_for_psid(psid: string): any
		local id = psid_rows[psid]
		return if id then live(id) else nil
	end

	function store.take(spec: LobbyRules.TakeSpec): any
		if spec.id == nil and spec.candidates == nil then
			-- (one process: the local store can search, as the service does)
			local ids = {}
			for _, v in store.list() do
				table.insert(ids, v.id)
			end
			spec = table.clone(spec)
			spec.candidates = ids
		end
		return take_via_update(store, spec)
	end

	function store.release(id: string, uids: { string }): (any, number)
		return release_via_update(store, id, uids)
	end

	return store
end

return LobbyStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">MatchHost</string>
            <string name="Source"><![CDATA[--!strict
-- The match side of a public lobby: runs on the lobby's reserved server. Finds its lobby record
-- (by the server's PrivateServerId), keeps the record's player count current while the lobby is
-- open, says when the match starts (the lobby's start time, pushed back while nobody has arrived
-- yet so an early teleport doesn't start an empty match), marks the lobby started (it leaves the
-- joinable lists and shows as live: a heartbeat keeps it watchable while the match runs), and sends
-- everyone back to a hub server after the match (the record goes away).
--
--   deps = {
--     store = LobbyStore,
--     psid = string,                         -- game.PrivateServerId
--     now = function() -> number,            -- os.time()
--     to_hub = function(players) -> (ok, err?),
--     log = function(text)?,
--   }
local LobbyRules = require("./LobbyRules")

local MatchHost = {}
MatchHost.__index = MatchHost

MatchHost.SYNC_S = 3.0
--- Seconds to wait for the first player when the record is not found yet (store lag).
MatchHost.LOOKUP_RETRY_S = 2.0
--- The match waits at least this long after the first human arrives (their client boots).
MatchHost.MIN_WAIT_AFTER_FIRST_S = 8

function MatchHost.new(deps: { [string]: any })
	local self = setmetatable({}, MatchHost)
	self.deps = deps
	self.lobby = nil :: LobbyRules.Lobby?
	self.started = false
	self.finished = false
	self._beat_in = 0.0
	self._first_arrival = nil :: number?
	--- when this server found its lobby record (starts_in never waits past _found_at + MAX_AHEAD_S)
	self._found_at = nil :: number?
	self._sync_in = 0.0
	self._lookup_in = 0.0
	self._present = 0
	--- user ids of the humans here now, and of everyone who has been here (the seat ledger's checks)
	self._present_uids = {} :: { [string]: boolean }
	self._arrived = {} :: { [string]: boolean }
	--- seats given back while the lobby was open (logs)
	self.released = 0
	self._busy = false
	return self
end

function MatchHost._log(self: any, text: string)
	if self.deps.log then
		self.deps.log("[MatchHost] " .. text)
	end
end

--- Find the lobby record (yields). True once known.
function MatchHost.lookup(self: any): boolean
	if self.lobby ~= nil then
		return true
	end
	local ok, v = pcall(self.deps.store.lobby_for_psid, self.deps.psid)
	if ok then
		self.lobby = LobbyRules.decode(v)
	end
	if self.lobby ~= nil then
		self._found_at = self.deps.now()
		self:_log(
			string.format(
				"lobby %s on %s, %d players, starts in %ds",
				self.lobby.id,
				self.lobby.map,
				self.lobby.max,
				self.lobby.starts - self.deps.now()
			)
		)
	end
	return self.lobby ~= nil
end

--- Humans now on this server (the match server reports it; ServerMain calls on arrivals / leaves).
function MatchHost.set_present(self: any, n: number)
	if n > 0 and self._first_arrival == nil then
		self._first_arrival = self.deps.now()
	end
	self._present = n
end

--- Who is here (user ids of the humans who came to play): a seat whose player arrived and left, or
--- never arrived (LobbyRules.ARRIVE_S), is given back while the lobby is open.
function MatchHost.set_roster(self: any, uids: { string })
	local now: { [string]: boolean } = {}
	for _, u in uids do
		now[u] = true
		self._arrived[u] = true
	end
	self._present_uids = now
end

--- Seconds until the match should start (nil while the lobby is unknown).
function MatchHost.starts_in(self: any): number?
	local l = self.lobby
	if l == nil then
		return nil
	end
	local now = self.deps.now()
	local at = l.starts
	-- never wait past the longest a lobby can be scheduled ahead (from when this server found it)
	if self._found_at ~= nil then
		at = math.min(at, self._found_at + LobbyRules.MAX_AHEAD_S)
	end
	if self._first_arrival ~= nil then
		at = math.max(at, self._first_arrival + MatchHost.MIN_WAIT_AFTER_FIRST_S)
	end
	return math.max(0, at - now)
end

--- Per-frame: lookup / sync the record (in a spawned thread; store calls yield).
function MatchHost.tick(self: any, dt: number, spawn: ((() -> ()) -> ())?)
	if self._busy then
		return
	end
	local run: (() -> ())? = nil
	if self.lobby == nil then
		self._lookup_in -= dt
		if self._lookup_in <= 0 then
			self._lookup_in = MatchHost.LOOKUP_RETRY_S
			run = function()
				self:lookup()
			end
		end
	elseif not self.started then
		self._sync_in -= dt
		if self._sync_in <= 0 then
			self._sync_in = MatchHost.SYNC_S
			run = function()
				self:_sync()
			end
		end
	elseif not self.finished then
		self._beat_in -= dt
		if self._beat_in <= 0 then
			self._beat_in = LobbyRules.LIVE_BEAT_S
			run = function()
				self:_beat()
			end
		end
	end
	if run then
		self._busy = true
		local body = run
		local wrapped = function()
			local ok, err = pcall(body)
			if not ok then
				self:_log("sync failed: " .. tostring(err))
			end
			self._busy = false
		end
		if spawn then
			spawn(wrapped)
		else
			wrapped()
		end
	end
end

--- While open: the record's player count is at least the humans present (hubs add reservations for
--- players still in flight; they arrive and become present), and the seats of players who left the
--- waiting room, or never came (a teleport that failed, a player who quit on the way), go back so
--- the hubs seat others in them. Full 30-seat lobbies started with 25.5 humans on average, and only
--- 1% with all 30 (2026-10-11): a seat was only ever added.
function MatchHost._sync(self: any)
	local l = self.lobby
	if l == nil then
		return
	end
	local present = self._present
	local now = self.deps.now()
	local lapsed: { string } = {}
	local new = self.deps.store.update(l.id, function(v: any): any?
		local cur = LobbyRules.decode(v)
		if cur == nil then
			return nil
		end
		lapsed = LobbyRules.lapsed_seats(cur, self._present_uids, self._arrived, now)
		if cur.players >= present then
			return nil
		end
		cur.players = present
		return cur
	end)
	local d = LobbyRules.decode(new)
	if d then
		self.lobby = d
	end
	if #lapsed > 0 and self.deps.store.release ~= nil then
		local after, n = self.deps.store.release(l.id, lapsed)
		n = tonumber(n) or 0
		if n > 0 then
			self.released += n
			self:_log(string.format("gave back %d seat(s) of players who left or never came", n))
			local da = LobbyRules.decode(after)
			if da then
				self.lobby = da
			end
		end
	end
end

--- While the match runs: the record stays fresh (watchable) and shows the humans still here.
function MatchHost._beat(self: any)
	local l = self.lobby
	if l == nil then
		return
	end
	local now = self.deps.now()
	local present = self._present
	self.deps.store.update(l.id, function(v: any): any?
		local cur = LobbyRules.decode(v)
		if cur == nil then
			return nil
		end
		cur.beat = now
		cur.players = present
		return cur
	end)
end

--- The waiting players voted to start: the lobby now starts within `seconds` (hubs stop offering
--- it once joins close). Yields.
function MatchHost.start_early(self: any, seconds: number)
	local l = self.lobby
	if l == nil then
		return
	end
	local at = self.deps.now() + math.ceil(seconds)
	if at >= l.starts then
		return
	end
	l.starts = at
	pcall(self.deps.store.update, l.id, function(v: any): any?
		local cur = LobbyRules.decode(v)
		if cur == nil or cur.status ~= "open" or cur.starts <= at then
			return nil
		end
		cur.starts = at
		return cur
	end)
end

--- The match is over: its record goes (nothing left to watch). Yields.
function MatchHost.finish(self: any)
	if self.finished then
		return
	end
	self.finished = true
	local l = self.lobby
	if l ~= nil then
		pcall(self.deps.store.remove, l.id)
	end
end

--- The match is starting: the lobby leaves the lists (yields). Returns the bot players to add.
function MatchHost.start(self: any, humans: number): number
	self.started = true
	local l = self.lobby
	if l == nil then
		return 0
	end
	pcall(self.deps.store.update, l.id, function(v: any): any?
		local cur = LobbyRules.decode(v)
		if cur == nil then
			return nil
		end
		cur.status = "started"
		cur.players = humans
		cur.beat = self.deps.now()
		return cur
	end)
	local bots = LobbyRules.bot_fill(l.max, humans)
	self:_log(string.format("starting %s with %d humans + %d bot players", l.id, humans, bots))
	return bots
end

--- After the match: everyone back to a hub server.
function MatchHost.return_to_hub(self: any, players: { any }, data: { [string]: any }?): (boolean, string?)
	if #players == 0 then
		return true, nil
	end
	return self.deps.to_hub(players, data)
end

return MatchHost
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">Sha256</string>
            <string name="Source"><![CDATA[--!strict
--!native
-- SHA-256 and HMAC-SHA256 in pure Luau (buffer + bit32), for signing lobby-service requests
-- (docs/lobby-service.md "Auth"; from the Tribes matchmaker). Luau/Roblox has no built-in hash. Server-only.
--
--   Sha256.Digest(msg: string) -> string        32 raw bytes
--   Sha256.Hex(msg: string) -> string           64 lowercase hex chars
--   Sha256.Hmac(key: string, msg: string) -> string   32 raw bytes (RFC 2104)
--   Sha256.HmacHex(key: string, msg: string) -> string
--   Sha256.ToHex(raw: string) -> string
--   Sha256.Equal(a: string, b: string) -> boolean     constant-time compare (equal lengths)
--   Sha256.SelfTest() -> (ok: boolean, failures: {string})   NIST + RFC 4231 vectors
--
-- Tested by tools/mm/test_sha256.luau (standalone .bin/luau) and cross-checked against Node's crypto in
-- services/matchmaker (npm test: random messages hashed on both sides).

local band, bor, bxor, bnot = bit32.band, bit32.bor, bit32.bxor, bit32.bnot
local rrotate, rshift, byteswap = bit32.rrotate, bit32.rshift, bit32.byteswap
local readu32, writeu32 = buffer.readu32, buffer.writeu32

local K = {
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
}

local w = table.create(64, 0) :: { number } -- message schedule (reused; Digest never yields)

local function digest(msg: string): string
	local len = #msg
	local total = ((len + 8) // 64 + 1) * 64 -- message + 0x80 + zero pad + 64-bit length
	local buf = buffer.create(total)
	buffer.writestring(buf, 0, msg)
	buffer.writeu8(buf, len, 0x80)
	local bits = len * 8
	writeu32(buf, total - 8, byteswap(bits // 4294967296))
	writeu32(buf, total - 4, byteswap(bits % 4294967296))

	local h0, h1, h2, h3 = 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a
	local h4, h5, h6, h7 = 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19

	for off = 0, total - 1, 64 do
		for i = 1, 16 do
			w[i] = byteswap(readu32(buf, off + (i - 1) * 4))
		end
		for i = 17, 64 do
			local w15, w2 = w[i - 15], w[i - 2]
			local s0 = bxor(rrotate(w15, 7), rrotate(w15, 18), rshift(w15, 3))
			local s1 = bxor(rrotate(w2, 17), rrotate(w2, 19), rshift(w2, 10))
			w[i] = bor(w[i - 16] + s0 + w[i - 7] + s1, 0)
		end
		local a, b, c, d, e, f, g, h = h0, h1, h2, h3, h4, h5, h6, h7
		for i = 1, 64 do
			local S1 = bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
			local ch = bxor(band(e, f), band(bnot(e), g))
			local t1 = h + S1 + ch + K[i] + w[i]
			local S0 = bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
			local maj = bxor(band(a, b), band(a, c), band(b, c))
			h = g
			g = f
			f = e
			e = bor(d + t1, 0)
			d = c
			c = b
			b = a
			a = bor(t1 + S0 + maj, 0)
		end
		h0 = bor(h0 + a, 0)
		h1 = bor(h1 + b, 0)
		h2 = bor(h2 + c, 0)
		h3 = bor(h3 + d, 0)
		h4 = bor(h4 + e, 0)
		h5 = bor(h5 + f, 0)
		h6 = bor(h6 + g, 0)
		h7 = bor(h7 + h, 0)
	end

	local out = buffer.create(32)
	writeu32(out, 0, byteswap(h0))
	writeu32(out, 4, byteswap(h1))
	writeu32(out, 8, byteswap(h2))
	writeu32(out, 12, byteswap(h3))
	writeu32(out, 16, byteswap(h4))
	writeu32(out, 20, byteswap(h5))
	writeu32(out, 24, byteswap(h6))
	writeu32(out, 28, byteswap(h7))
	return buffer.tostring(out)
end

local function toHex(raw: string): string
	return (string.gsub(raw, ".", function(ch)
		return string.format("%02x", string.byte(ch))
	end))
end

local function xorPad(key: string, byte: number): string
	local b = buffer.create(64)
	for i = 0, 63 do
		local k = if i < #key then string.byte(key, i + 1) else 0
		buffer.writeu8(b, i, bxor(k, byte))
	end
	return buffer.tostring(b)
end

local function hmac(key: string, msg: string): string
	if #key > 64 then
		key = digest(key)
	end
	local inner = digest(xorPad(key, 0x36) .. msg)
	return digest(xorPad(key, 0x5c) .. inner)
end

local Sha256 = {}

Sha256.Digest = digest
Sha256.ToHex = toHex
Sha256.Hmac = hmac

function Sha256.Hex(msg: string): string
	return toHex(digest(msg))
end

function Sha256.HmacHex(key: string, msg: string): string
	return toHex(hmac(key, msg))
end

-- Constant-time for equal lengths (signatures are fixed-length hex).
function Sha256.Equal(a: string, b: string): boolean
	if #a ~= #b then
		return false
	end
	local diff = 0
	for i = 1, #a do
		diff = bor(diff, bxor(string.byte(a, i), string.byte(b, i)))
	end
	return diff == 0
end

-- NIST FIPS 180-2 examples + RFC 4231 HMAC-SHA256 test cases 1, 2, 3, 4, 6, 7.
function Sha256.SelfTest(): (boolean, { string })
	local failures = {}
	local function check(name: string, got: string, want: string)
		if got ~= want then
			table.insert(failures, `{name}: got {got}, want {want}`)
		end
	end
	check("sha256('')", Sha256.Hex(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
	check("sha256('abc')", Sha256.Hex("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
	check(
		"sha256(448 bits)",
		Sha256.Hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
		"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
	)
	check(
		"sha256(896 bits)",
		Sha256.Hex("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"),
		"cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1"
	)
	-- boundary lengths around the 55/56/64-byte padding edges
	check("sha256(55 x 'a')", Sha256.Hex(string.rep("a", 55)), "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318")
	check("sha256(56 x 'a')", Sha256.Hex(string.rep("a", 56)), "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a")
	check("sha256(64 x 'a')", Sha256.Hex(string.rep("a", 64)), "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb")
	check("hmac rfc4231 #1", Sha256.HmacHex(string.rep("\x0b", 20), "Hi There"), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
	check("hmac rfc4231 #2", Sha256.HmacHex("Jefe", "what do ya want for nothing?"), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
	check("hmac rfc4231 #3", Sha256.HmacHex(string.rep("\xaa", 20), string.rep("\xdd", 50)), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
	local key4 = ""
	for i = 1, 25 do
		key4 ..= string.char(i)
	end
	check("hmac rfc4231 #4", Sha256.HmacHex(key4, string.rep("\xcd", 50)), "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
	check(
		"hmac rfc4231 #6",
		Sha256.HmacHex(string.rep("\xaa", 131), "Test Using Larger Than Block-Size Key - Hash Key First"),
		"60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"
	)
	check(
		"hmac rfc4231 #7",
		Sha256.HmacHex(
			string.rep("\xaa", 131),
			"This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."
		),
		"9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2"
	)
	check("equal", tostring(Sha256.Equal("abc", "abc") and not Sha256.Equal("abc", "abd") and not Sha256.Equal("ab", "abc")), "true")
	return #failures == 0, failures
end

return Sha256
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">SharedClock</string>
            <string name="Source"><![CDATA[--!strict
-- A wall clock every server agrees on, for the public lobbies (start times, heartbeats, locks are
-- written by one server and read by others). Roblox servers' own clocks (os.time) can be minutes
-- apart — a hub whose clock ran ~15 min fast created lobbies that every other server listed as
-- "starts in 17:29" — so each server measures its offset from Roblox's backend clock: a DataStore
-- write's DataStoreKeyInfo.UpdatedTime is stamped by the backend, and the local time halfway through
-- the call is compared with it (error: half the round trip). Re-measured now and then; offset 0 when
-- DataStores are unavailable (Studio without API access), where there is only one server anyway.
--
--   SharedClock.start(deps?)  measure now and every RESYNC_S (deps: datastore, log — injectable)
--   SharedClock.now()         os.time() corrected by the offset (seconds, fractional)
--   SharedClock.ready()       measured once, or gave up (lobby scheduling waits for this)

local SharedClock = {}

SharedClock.STORE = "rofront_clock"
SharedClock.KEY = "probe"
--- Each measurement writes one of this many keys ("probe1" .. "probe256", at random). A DataStore key
--- takes a write every few seconds, and every server wrote "probe": at ~880 servers most of those writes
--- were refused ("TooManyRequests ... API: UpdateAsync", 2026-10-14), and a server that was refused three
--- times ran on its own clock until the next try, 20 minutes on.
SharedClock.KEYS = 256
SharedClock.RESYNC_S = 20 * 60
--- Give up waiting for the first measurement after this long (the lobbies must not stall).
SharedClock.READY_TIMEOUT_S = 15
--- A measurement whose round trip took longer than this is too imprecise to use.
SharedClock.MAX_RTT_S = 4.0

SharedClock.offset = 0.0
SharedClock.synced = false
SharedClock._started_at = os.clock()
SharedClock._given_up = false

local function millis(): number
	return DateTime.now().UnixTimestampMillis
end

function SharedClock.now(): number
	return os.time() + SharedClock.offset
end

function SharedClock.ready(): boolean
	return SharedClock.synced
		or SharedClock._given_up
		or os.clock() - SharedClock._started_at > SharedClock.READY_TIMEOUT_S
end

--- One measurement (yields). True when the offset was updated.
function SharedClock.measure(deps: { [string]: any }?): boolean
	local d = deps or {}
	local store = d.datastore
	if store == nil then
		local ok, ds = pcall(function()
			return game:GetService("DataStoreService"):GetDataStore(SharedClock.STORE)
		end)
		if not ok then
			return false
		end
		store = ds
	end
	local t0 = (d.millis or millis)()
	local ok, info = pcall(function()
		local key = SharedClock.KEY .. tostring(math.random(1, SharedClock.KEYS))
		local _, key_info = store:UpdateAsync(key, function(old: any): any
			return (tonumber(old) or 0) + 1
		end)
		return key_info
	end)
	local t1 = (d.millis or millis)()
	if not ok or info == nil or type(info.UpdatedTime) ~= "number" then
		return false
	end
	local rtt = (t1 - t0) / 1000.0
	if rtt > SharedClock.MAX_RTT_S then
		return false
	end
	-- the backend stamped the write somewhere inside the call: assume the middle
	local backend_s = info.UpdatedTime / 1000.0
	local local_mid_s = (t0 + t1) / 2000.0
	-- os.time() and DateTime share the local clock, so the offset applies to os.time() too
	SharedClock.offset = backend_s - local_mid_s
	SharedClock.synced = true
	if d.log then
		d.log(string.format("[SharedClock] offset %+.1fs (rtt %.0fms)", SharedClock.offset, rtt * 1000))
	end
	return true
end

--- Measure now (in the background) and every RESYNC_S. Gives up waiting after a failed first try.
function SharedClock.start(deps: { [string]: any }?)
	SharedClock._started_at = os.clock()
	task.spawn(function()
		local tries = 0
		while not SharedClock.measure(deps) do
			tries += 1
			if tries >= 3 then
				SharedClock._given_up = true
				break
			end
			task.wait(2)
		end
		while true do
			task.wait(SharedClock.RESYNC_S)
			SharedClock.measure(deps)
		end
	end)
end

return SharedClock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">Signing</string>
            <string name="Source"><![CDATA[--!strict
-- Wire signing for the lobby service (docs/lobby-service.md "Auth"); pure, so Lune tests it against
-- the Node service. Same format as the Tribes matchmaker:
--   request:  X-TM-Sig = hex HMAC-SHA256(secret, "v1\n" .. ts .. "\n" .. nonce .. "\n" .. METHOD .. "\n" .. path .. "\n" .. body)
--   response: X-TM-Sig = hex HMAC-SHA256(secret, "v1r\n" .. requestNonce .. "\n" .. status .. "\n" .. body)
local Sha256 = require("./Sha256")

local Signing = {}

function Signing.request(secret: string, ts: number, nonce: string, method: string, path: string, body: string): string
	return Sha256.HmacHex(secret, `v1\n{string.format("%d", ts)}\n{nonce}\n{string.upper(method)}\n{path}\n{body}`)
end

function Signing.response(secret: string, nonce: string, status: number, body: string): string
	return Sha256.HmacHex(secret, `v1r\n{nonce}\n{string.format("%d", status)}\n{body}`)
end

function Signing.verify_response(secret: string, nonce: string, status: number, body: string, sig: string?): boolean
	if type(sig) ~= "string" or #sig ~= 64 then
		return false
	end
	return Sha256.Equal(string.lower(sig), Signing.response(secret, nonce, status, body))
end

--- Response headers keep the server's casing; look them up case-insensitively.
function Signing.header(headers: { [string]: string }?, name: string): string?
	if not headers then
		return nil
	end
	local want = string.lower(name)
	for k, v in headers do
		if string.lower(k) == want then
			return v
		end
	end
	return nil
end

return Signing
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">Teleports</string>
            <string name="Source"><![CDATA[--!strict
-- TeleportService wrapper for public lobbies: reserve a match server, send players to it, send them
-- back to a hub (a public server of the same place). Teleports cannot run in Studio: there `studio`
-- returns stand-ins (a fake reserved server; `send` reports "studio" so the caller can run the match
-- on the same server instead).
-- `stamp(players, data?) -> data` (server/Handoff) adds the id under which the players' records follow
-- them to the server they arrive on.

local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

local Teleports = {}

Teleports.RETRIES = 3
--- A return teleport already under way for a player is not started again within this long (a
--- LEAVE pressed twice, or the match ending while one is in flight, made TeleportAsync fail with
--- "already in progress" — 600 warnings a day).
Teleports.PENDING_S = 20

function Teleports.live(place_id: number, stamp: ((any, any) -> any)?)
	local t = {}
	local pending: { [Player]: number } = {}
	TeleportService.TeleportInitFailed:Connect(function(player: Player)
		pending[player] = nil
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(player: Player)
		pending[player] = nil
	end)

	function t.reserve(): (string, string)
		local code, psid = TeleportService:ReserveServer(place_id)
		return code, psid
	end

	function t.send(players: { Player }, code: string, data: { [string]: any }): (boolean, string?)
		local opts = Instance.new("TeleportOptions")
		opts.ReservedServerAccessCode = code
		opts:SetTeleportData(if stamp ~= nil then stamp(players, data) else data)
		local last: any = nil
		for attempt = 1, Teleports.RETRIES do
			local ok, err = pcall(function()
				TeleportService:TeleportAsync(place_id, players, opts)
			end)
			if ok then
				return true, nil
			end
			last = err
			task.wait(attempt)
		end
		warn("[Lobbies] teleport failed: " .. tostring(last))
		return false, "The teleport failed. Try again."
	end

	--- `data` (optional) reaches the hub as the teleport data (who was in which party).
	function t.to_hub(players: { Player }, data: { [string]: any }?): (boolean, string?)
		local now = os.clock()
		local list = {}
		for _, p in players do
			if p.Parent ~= nil and (pending[p] == nil or now - pending[p] > Teleports.PENDING_S) then
				pending[p] = now
				table.insert(list, p)
			end
		end
		if #list == 0 then
			return true, nil -- (all on their way already)
		end
		local d = if stamp ~= nil then stamp(list, data) else data
		local ok, err = pcall(function()
			if d ~= nil then
				local opts = Instance.new("TeleportOptions")
				opts:SetTeleportData(d)
				TeleportService:TeleportAsync(place_id, list, opts)
			else
				TeleportService:TeleportAsync(place_id, list)
			end
		end)
		if not ok then
			for _, p in list do
				pending[p] = nil
			end
			local msg = tostring(err)
			if string.find(msg, "already in progress", 1, true) then
				return true, nil
			end
			warn("[Lobbies] return teleport failed: " .. msg)
		end
		return ok, if ok then nil else tostring(err)
	end

	return t
end

--- Studio stand-ins.
function Teleports.studio()
	local n = 0
	local t = {}
	function t.reserve(): (string, string)
		n += 1
		return "studio-code-" .. n, "studio-psid-" .. n
	end
	function t.send(_players: { Player }, _code: string, _data: any): (boolean, string?)
		return false, "studio"
	end
	function t.to_hub(_players: { Player }): (boolean, string?)
		return true, nil
	end
	return t
end

function Teleports.for_place(place_id: number, stamp: ((any, any) -> any)?)
	if RunService:IsStudio() then
		return Teleports.studio()
	end
	return Teleports.live(place_id, stamp)
end

return Teleports
]]></string>
          </Properties>
        </Item>
      </Item>
