          <Item class="ModuleScript" referent="203">
            <Properties>
              <string name="Name">JutsuGlyph</string>
              <string name="Source"><![CDATA[-- Bundled Shinobi icons and the Mangekyou status emblem.
local JutsuGlyph = {}
local HudArt = require("./HudArt")

-- Indices in the supplied sprite sheet atlas, left to right and top to bottom.
local ICONS = {
	city = 0, port = 1, factory = 3, defense = 10, sam = 2, silo = 11, warship = 1,
	artillery = 7, airfield = 9, railgun = 8, airstrike = 5, slug = 7, reinforce = 6,
	atom = 0, hydrogen = 3, mirv = 6, mega = 5, scatter = 8,
	arsenal = 9, settings = 12, help = 13, chat = 14, exit = 15, music = 4,
}
local MANGEKYOU_INK = Color3.fromRGB(22, 6, 13)
local function circle(x, y, r)
	local p = {}
	for i = 0, 18 do
		local a = i * math.pi / 9
		table.insert(p, Vector2.new(x + math.cos(a) * r, y + math.sin(a) * r))
	end
	return p
end
local function path(...)
	local p = {}
	local n = select("#", ...)
	for i = 1, n, 2 do
		local x, y = select(i, ...)
		table.insert(p, Vector2.new(x, y))
	end
	return p
end
local blades = {}
for i = 0, 2 do
	local rotation = i * math.pi * 2 / 3
	local cos, sin = math.cos(rotation), math.sin(rotation)
	local blade = {}
	for _, p in path(0.5,0.5,0.37,0.34,0.32,0.18,0.43,0.25,0.51,0.33,0.56,0.46,0.5,0.5) do
		local x, y = p.X - 0.5, p.Y - 0.5
		table.insert(blade, Vector2.new(0.5 + x*cos - y*sin, 0.5 + x*sin + y*cos))
	end
	table.insert(blades, blade)
end
table.insert(blades, circle(0.5, 0.5, 0.055))


function JutsuGlyph.apply(image: ImageLabel, kind: string, transparency: number?): boolean
	local slot = ICONS[kind]
	local shape = if kind == "mangekyou" then blades else nil
	local root = image:FindFirstChild("JutsuGlyph")
	if root and root:GetAttribute("Jutsu") ~= kind then
		root:Destroy()
		root = nil
	end
	if slot ~= nil then
		image.Image = ""
		if root == nil then
			local icon = HudArt.add(image, "symbols", image.ZIndex)
			if icon == nil then return true end
			icon.Name = "JutsuGlyph"
			icon.Size = UDim2.fromScale(1, 1)
			icon.ScaleType = Enum.ScaleType.Fit
			icon.ImageRectOffset = Vector2.new(slot % 4 * 96, slot // 4 * 96)
			icon.ImageRectSize = Vector2.new(96, 96)
			icon:SetAttribute("Jutsu", kind)
			root = icon
		end
		(root :: ImageLabel).ImageTransparency = transparency or 0
		return true
	end
	if shape == nil then
		if root then root:Destroy() end
		return false
	end
	if root == nil then
		root = Instance.new("Frame")
		root.Name = "JutsuGlyph"
		root.BackgroundTransparency = if kind == "mangekyou" then 0 else 1
		root.BackgroundColor3 = Color3.fromRGB(203, 39, 57)
		root.BorderSizePixel = 0
		if kind == "mangekyou" then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.5, 0)
			corner.Parent = root
		end
		root.AnchorPoint = Vector2.new(0.5, 0.5)
		root.Position = UDim2.fromScale(0.5, 0.5)
		root.Size = UDim2.fromScale(0.95, 0.95)
		root.ZIndex = image.ZIndex
		root:SetAttribute("Jutsu", kind)
		local square = Instance.new("UIAspectRatioConstraint")
		square.Parent = root
		for _, points in shape do
			for i = 2, #points do
				local a, b = points[i-1], points[i]
				local center = (a + b) * 0.5
				local direction = b - a
				local line = Instance.new("Frame")
				line.BorderSizePixel = 0
				line.AnchorPoint = Vector2.new(0.5, 0.5)
				line.Position = UDim2.fromScale(center.X, center.Y)
				line.Size = UDim2.fromScale(direction.Magnitude + 0.035, 0.073)
				line.Rotation = math.deg(math.atan2(direction.Y, direction.X))
				line.BackgroundColor3 = MANGEKYOU_INK
				line.ZIndex = root.ZIndex
				line.Parent = root
			end
		end
		root.Parent = image
	end
	local alpha = transparency or 0
	if root:GetAttribute("Alpha") ~= alpha then
		root:SetAttribute("Alpha", alpha)
		for _, line in root:GetChildren() do
			if line:IsA("Frame") then line.BackgroundTransparency = alpha end
		end
	end
	image.Image = ""
	return true
end

return JutsuGlyph
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="204">
            <Properties>
              <string name="Name">Leaderboard</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/leaderboard.gd (UILeaderboard)
-- Right-side leaderboard: top 10 by land share with colour, name, land % and troops. Your own row
-- is pinned when you are outside the top 10; allies and traitors are marked. Clicking a row focuses
-- the camera on that nation. On phones it collapses into a rank pill. Game admins see a person icon on
-- real players' rows, and every real player outside the top is pinned below it (one click away).
--
-- Every match starts with the board closed (close_for_match): the pill (the status pill on phones)
-- opens it, and it stays as the player leaves it until the match ends (since 2026-10-09).
-- Until then a desktop started open and remembered the player's
-- last choice in the saved settings (leaderboard_open_desktop / _touch: old records keep the keys,
-- nothing reads them); a report of the same week: the logs on the left-hand side blocked parts of the
-- map.
--
-- Signals: toggled(open). Members: panel, _pill, expanded, user_hidden, pill_enabled.
-- Methods: set_open(on), toggle(), close_for_match(), apply_layout(top), place_pill_left_of(rect),
-- bottom_edge(), my_rank(), mark_dirty(), refresh(); per frame update(dt).

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local Cosmetics: any = if typeof(game) == "Instance"
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Cosmetics)
	else (require :: any)("../../shared/Data/Cosmetics")
local Signal = UITheme.core("Signal")

local Leaderboard = W.class(W.Control)

Leaderboard.ROWS = 10
--- Game admins: real players outside the top rows pinned below them (desktop / phones).
Leaderboard.ADMIN_PINS = 8
Leaderboard.ADMIN_PINS_COMPACT = 3
--- Phones: the board is a peek (opened from the status pill) that folds itself away again.
Leaderboard.PEEK_SECONDS = 8.0

local function msec(): number
	return os.clock() * 1000.0
end

-- ---------------------------------------------------------------------------------------------
-- Row
-- ---------------------------------------------------------------------------------------------

local Row = W.class(W.Button)
Leaderboard.Row = Row

function Row.new(c: any)
	local self = setmetatable({}, Row.__mt)
	W.Control._init(self, "TextButton")
	W.Button._init_button(self, "", "GlassButton")
	local T = UITheme
	self.ctx = c
	self.owner_id = 0
	self.is_me = false
	self.flat = true
	self:set_min_size(Vector2.new(0, 28))
	for _, st in ipairs(W.BUTTON_STATES) do
		self:add_theme_stylebox_override(st, T.empty_box())
	end
	self._sv.inset = { 2, 1, 2, 1 }
	local h = T.hbox(8)
	h:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	h.offset_left = 10.0
	h.offset_right = -10.0
	self:add_child(h)
	self.rank = T.label("1", 12, 600, T.TEXT_3)
	T.fix_width(self.rank, 26.0, W.ALIGN_RIGHT)
	self.rank.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self.rank)
	self.sw = T.swatch(T.TEXT, 10.0, 3)
	h:add_child(self.sw)
	-- the owner's flag (Data/Cosmetics), when one is equipped: placed to the left of the head shot
	-- (2026-10-22)
	local fimg = Instance.new("ImageLabel")
	fimg.BackgroundTransparency = 1
	fimg.ScaleType = Enum.ScaleType.Fit
	self._flag_img = fimg
	self.flag = W.wrap(fimg)
	self.flag:set_min_size(Vector2.new(18, 12))
	self.flag.size_flags_vertical = W.SHRINK_CENTER
	self.flag:set_mouse_filter(W.MOUSE_IGNORE)
	self.flag:set_visible(false)
	self._flag_id = ""
	h:add_child(self.flag)
	-- a person's Roblox head shot (the cosmetics map's `face`; 2026-10-04): a small profile picture
	-- next to each name
	local himg = Instance.new("ImageLabel")
	himg.BackgroundColor3 = Color3.fromRGB(40, 52, 82)
	himg.BorderSizePixel = 0
	local hc = Instance.new("UICorner")
	hc.CornerRadius = UDim.new(0.5, 0)
	hc.Parent = himg
	self._face_img = himg
	self.face = W.wrap(himg)
	self.face:set_min_size(Vector2.new(18, 18))
	self.face.size_flags_vertical = W.SHRINK_CENTER
	self.face:set_mouse_filter(W.MOUSE_IGNORE)
	self.face:set_visible(false)
	self._face_id = 0
	h:add_child(self.face)
	self.name_l = T.label("", 13, 600)
	self.name_l.text_overrun_behavior = W.OVERRUN_ELLIPSIS
	self.name_l.size_flags_horizontal = W.EXPAND_FILL
	self.name_l:set_min_size(Vector2.new(40, 0))
	self.name_l.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self.name_l)
	self.mark = T.icon_rect("alliance", 13.0, T.GREEN)
	self.mark.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self.mark)
	-- game admins only: a person icon on real players' rows (Session.admin_bots; nobody else gets it)
	self.human = T.icon_rect("users", 13.0, T.CYAN)
	self.human.size_flags_vertical = W.SHRINK_CENTER
	self.human:set_visible(false)
	h:add_child(self.human)
	self.land = T.label("", 13, 700)
	T.fix_width(self.land, T.text_width("88.88%", 13, 700) + 2.0, W.ALIGN_RIGHT)
	self.land.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self.land)
	self.troops = T.label("", 12, 500, T.TEXT_2)
	T.fix_width(self.troops, T.text_width("888.8K", 12, 500) + 2.0, W.ALIGN_RIGHT)
	self.troops.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self.troops)
	self.mouse_entered:Connect(function()
		if self.ctx.touch then
			return
		end
		self.ctx:world_call("set_hover_owner", { self.owner_id })
		self:_redraw()
	end)
	self.mouse_exited:Connect(function()
		self.ctx:world_call("set_hover_owner", { 0 })
		self:_redraw()
	end)
	self.pressed:Connect(function()
		if self.owner_id ~= 0 then
			local ctx = self.ctx
			-- spectating (a watcher, or knocked out): Airship BedWars' switch sound
			local my = ctx:my()
			if ctx:me() == 0 or (my ~= nil and my.alive == false) then
				ctx:sfx("spectate_switch")
			end
			ctx:world_call("focus_owner", { self.owner_id })
		end
	end)
	return self
end

function Row.set_row(self, o: any, r: number)
	local ctx = self.ctx
	local T = UITheme
	local s = ctx.state
	self.owner_id = o.id
	self.is_me = o.id == ctx:me()
	self.rank:set_text(tostring(r))
	T.set_swatch_color(self.sw, o.color)
	local cz = s.cosmetics and s.cosmetics[o.id]
	local face = if cz ~= nil and cz.face ~= nil then cz.face else 0
	if face ~= self._face_id then
		self._face_id = face
		self._face_img.Image = if face > 0 then Cosmetics.face_image(face) else ""
		self.face:set_visible(face > 0)
	end
	local fid = if cz ~= nil and cz.flag ~= nil then cz.flag else ""
	if fid ~= self._flag_id then
		self._flag_id = fid
		local it = if fid ~= "" then Cosmetics.item(fid) else nil
		if it ~= nil and it.kind == "flag" then
			self._flag_img.Image = Cosmetics.flag_image(it)
			self._flag_img.ImageRectOffset = Vector2.new(it.x, it.y)
			self._flag_img.ImageRectSize = Vector2.new(it.w, it.h)
			self.flag:set_visible(true)
		else
			self.flag:set_visible(false)
		end
	end
	self.name_l:set_text(o.name)
	self.land:set_text(T.fmt_pct(s:land_share(o.id)))
	self.troops:set_text(T.fmt_troops(o.troops))
	-- Threat context: a neighbour with over 3x our army reads red.
	local mine = ctx:my()
	local threat = mine ~= nil
		and not self.is_me
		and mine.troops > 0
		and o.troops > 3 * mine.troops
		and not s:are_allies(ctx:me(), o.id)
		and ctx.borders ~= nil
		and ctx.borders:borders_owner(o.id)
	T.set_font_color(self.troops, if threat then T.RED else T.TEXT_2)
	local ally = s:are_allies(ctx:me(), o.id)
	local traitor = s:is_traitor(o.id)
	self.mark:set_visible(ally or traitor)
	if traitor then
		self.mark:set_icon("betray")
		self.mark:set_color(T.RED)
	elseif ally then
		self.mark:set_icon("alliance")
		self.mark:set_color(T.GREEN)
	end
	local nc = T.TEXT
	if self.is_me then
		nc = T.AMBER_HI
	elseif traitor then
		nc = Color3.new(1.0, 0.7, 0.72)
	end
	T.set_font_color(self.name_l, nc)
	T.set_font_color(self.rank, if r == 1 then T.GOLD else T.TEXT_3)
	self.human:set_visible(Leaderboard.is_real_player(ctx, o))
	self:_redraw()
end

function Row._draw_state(self)
	self:_redraw()
end

function Row._draw(self)
	self:_redraw()
end

function Row._redraw(self)
	if self.ctx == nil then
		return
	end
	local T = UITheme
	if self.is_me then
		self._sv:set(T.flat(T.c(T.AMBER, 0.12), 7, T.c(T.AMBER, 0.35), 1))
	elseif self._hover and not self.ctx.touch then
		self._sv:set(T.flat(T.rgba(1, 1, 1, 0.07), 7))
	elseif self._sv.style ~= nil then
		self._sv:set(nil)
	end
end

-- ---------------------------------------------------------------------------------------------
-- Leaderboard
-- ---------------------------------------------------------------------------------------------

--- Game admins only (Session.admin_bots): a real player, not a bot filling the lobby.
function Leaderboard.is_real_player(ctx: any, o: any): boolean
	local bots = if ctx.session ~= nil then ctx.session.admin_bots else nil
	return bots ~= nil and o.kind == UITheme.core("Defs").KIND_HUMAN and not bots[o.id]
end

function Leaderboard.new(c: any)
	local self = setmetatable({}, Leaderboard.__mt)
	W.Control._init(self)
	local T = UITheme
	self.ctx = c
	self.toggled = Signal.new()
	self.expanded = false
	self.user_hidden = false
	self._rows = {}
	self._accum = 0.0
	self._dirty = true
	self._opened_msec = 0
	self._layout_key = ""
	--- Phones: no separate rank pill (the status panel shows the rank and opens the board).
	self.pill_enabled = true
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self.panel = GlassPanel.new(8.0, 10.0, T.R_LG, true, 18)
	self:add_child(self.panel)
	local v = T.vbox(4)
	self.panel:add_child(v)

	self._header = T.hbox(8)
	local hm = W.Margin.new()
	hm:set_mouse_filter(W.MOUSE_IGNORE)
	hm:add_theme_constant_override("margin_left", 10)
	hm:add_theme_constant_override("margin_right", 4)
	hm:add_child(self._header)
	self._header:add_child(T.icon_rect("leaderboard", 14.0, T.AMBER))
	self._header:add_child(T.label("LEADERBOARD", 12, 800, T.TEXT, 2))
	local sp = W.Control.new()
	sp.size_flags_horizontal = W.EXPAND_FILL
	sp:set_mouse_filter(W.MOUSE_IGNORE)
	self._header:add_child(sp)
	-- game admins only: show just the real players
	self.humans_only = false
	local hf = T.button("HUMANS", "ChipButton", "", 22.0)
	hf.toggle_mode = true
	hf:set_font_size(10)
	hf.pressed:Connect(function()
		self.humans_only = hf.button_pressed
		self:mark_dirty()
	end)
	hf:set_visible(false)
	self._humans_btn = hf
	self._header:add_child(hf)
	self._count = T.label("", 11, 600, T.TEXT_3)
	T.fix_width(self._count, 64.0, W.ALIGN_RIGHT)
	self._header:add_child(self._count)
	local close = W.Button.new("", "GhostButton")
	close:set_icon("close")
	close.expand_icon = true
	close:set_min_size(Vector2.new(26, 26))
	close:add_theme_constant_override("icon_max_width", 11)
	close:add_theme_stylebox_override("normal", T.empty_box(6, 6))
	close:add_theme_stylebox_override("hover", T.flat(T.FILL, 6, T.CLEAR, 0, 6, 6))
	close.pressed:Connect(function()
		self:set_open(false)
	end)
	self._close = close
	self._header:add_child(close)
	v:add_child(hm)

	self._cols = T.hbox(8)
	local cm = W.Margin.new()
	cm:set_mouse_filter(W.MOUSE_IGNORE)
	cm:add_theme_constant_override("margin_left", 10)
	cm:add_theme_constant_override("margin_right", 10)
	cm:add_child(self._cols)
	local c1 = T.caption("#", 10)
	c1:set_min_size(Vector2.new(22, 0))
	c1.horizontal_alignment = W.ALIGN_RIGHT
	self._cols:add_child(c1)
	local c2 = T.caption("Nation", 10)
	c2.size_flags_horizontal = W.EXPAND_FILL
	c2:set_min_size(Vector2.new(18, 0))
	self._cols:add_child(c2)
	local c3 = T.caption("Land", 10)
	c3:set_min_size(Vector2.new(50, 0))
	c3.horizontal_alignment = W.ALIGN_RIGHT
	self._cols:add_child(c3)
	local c4 = T.caption("Troops", 10)
	c4:set_min_size(Vector2.new(46, 0))
	c4.horizontal_alignment = W.ALIGN_RIGHT
	self._cols:add_child(c4)
	v:add_child(cm)
	self._cols_margin = cm
	v:add_child(T.hdivider())

	self._list = T.vbox(0)
	v:add_child(self._list)
	for _ = 1, Leaderboard.ROWS do
		local r = Row.new(c)
		r.pressed:Connect(function()
			self._opened_msec = msec()
		end)
		table.insert(self._rows, r)
		self._list:add_child(r)
	end
	self._pin_sep = T.label("···", 12, 700, T.TEXT_3)
	self._pin_sep.horizontal_alignment = W.ALIGN_CENTER
	self._list:add_child(self._pin_sep)
	--- rows pinned below the top: yours, and (admins) real players; grown on demand
	self._pins = {}
	self._pin_more = T.label("", 11, 600, T.TEXT_3)
	self._pin_more.horizontal_alignment = W.ALIGN_CENTER
	self._pin_more:set_visible(false)
	self._list:add_child(self._pin_more)

	local pill = W.Button.new("", "GlassButton")
	pill:set_icon("leaderboard")
	pill:add_theme_constant_override("icon_max_width", 16)
	pill:set_min_size(Vector2.new(0, 40))
	pill:add_theme_stylebox_override("normal", T.flat(T.GLASS, 999, T.LINE, 1, 14, 6))
	pill:add_theme_stylebox_override("hover", T.flat(T.GLASS_RAISED, 999, T.LINE_2, 1, 14, 6))
	pill:add_theme_stylebox_override("pressed", T.flat(T.GLASS_RAISED, 999, T.LINE_2, 1, 14, 6))
	pill:add_theme_stylebox_override("hover_pressed", T.flat(T.GLASS_RAISED, 999, T.LINE_2, 1, 14, 6))
	pill:set_font_size(13)
	pill.pressed:Connect(function()
		self:set_open(true)
	end)
	self._pill = pill
	self:add_child(pill)
	pill:set_visible(false)
	return self
end

function Leaderboard.set_open(self, on: boolean)
	local ctx = self.ctx
	local was = self.expanded
	self.expanded = on
	self.user_hidden = not on
	self._opened_msec = msec()
	self:_apply_visibility()
	if on and not was then
		W.pop_in(self.panel, 0.0, 0.97, 0.3)
		ctx:sfx("open", -8.0)
	elseif not on and was then
		ctx:sfx("close", -8.0)
	end
	self:refresh()
	if on ~= was then
		self.toggled:Fire(on)
	end
end

function Leaderboard.toggle(self)
	self:set_open(not self.expanded)
end

--- A new match: the board is closed, without the sound or the signal of a player closing it.
function Leaderboard.close_for_match(self)
	self.expanded = false
	self.user_hidden = false
	self:_apply_visibility()
end

function Leaderboard._apply_visibility(self)
	self.panel:set_visible(self.expanded)
	self._pill:set_visible(not self.expanded and self.pill_enabled)
end

function Leaderboard.apply_layout(self, top: number)
	local ctx = self.ctx
	self.pill_enabled = not ctx.compact
	-- Phones never keep the board open (it is a peek): a screen that turns into one closes it. Other
	-- screens keep it as it is (closed since the match began, or as the player left it).
	local key = if ctx.compact then "compact" else (if ctx.touch then "touch" else "desktop")
	if key ~= self._layout_key then
		self._layout_key = key
		if ctx.compact then
			self.expanded = false
		end
	end
	local right = 12.0 + ctx.insets.z
	local w = if ctx.compact then 250.0 else 300.0
	for _, c in ipairs({ self.panel, self._pill }) do
		c.anchor_left, c.anchor_right, c.anchor_top, c.anchor_bottom = 1.0, 1.0, 0.0, 0.0
		c.grow_horizontal = W.GROW_BEGIN
		c.grow_vertical = W.GROW_END
		c.offset_left = -right
		c.offset_right = -right
		c.offset_top = top
		c.offset_bottom = top
	end
	self.panel:set_min_size(Vector2.new(w, 0))
	for _, r in ipairs(self._rows) do
		r:set_min_size(Vector2.new(0, if ctx.touch then 44 else 28))
	end
	for _, r in ipairs(self._pins) do
		r:set_min_size(Vector2.new(0, if ctx.touch then 44 else 28))
	end
	self._close:set_min_size(if ctx.touch then Vector2.new(44, 44) else Vector2.new(26, 26))
	self._pill:set_min_size(Vector2.new(170, if ctx.touch then 44 else 40))
	self._pill:set_clip_text(true)
	self._cols_margin:set_visible(not ctx.compact)
	self:_apply_visibility()
	self.panel:reset_size()
	self._pill:reset_size()
	self._dirty = true
end

--- Phones: put the collapsed rank pill to the left of `status` (same row) to save height.
function Leaderboard.place_pill_left_of(self, status: Rect)
	local ctx = self.ctx
	local p = self._pill
	local right_edge = ctx.vp.X - status.Min.X + 8.0
	p.anchor_left = 1.0
	p.anchor_right = 1.0
	p.offset_left = -right_edge
	p.offset_right = -right_edge
	p.offset_top = status.Min.Y + (status.Height - p:get_combined_minimum_size().Y) * 0.5
	p.offset_bottom = p.offset_top
	p:reset_size()
end

function Leaderboard.bottom_edge(self): number
	if self.panel.visible then
		return self.panel:get_rect().Max.Y
	end
	if self._pill.visible then
		return self._pill:get_rect().Max.Y
	end
	return -1.0
end

--- My rank (1-based) for other panels; 0 when unranked.
function Leaderboard.my_rank(self): number
	local ctx = self.ctx
	if ctx.state == nil or ctx:me() == 0 then
		return 0
	end
	return ctx:rank_of(ctx:me())
end

function Leaderboard.mark_dirty(self)
	self._dirty = true
end

function Leaderboard.refresh(self)
	local ctx = self.ctx
	self._dirty = false
	local s = ctx.state
	if s == nil then
		return
	end
	local admin = ctx.session ~= nil and ctx.session.admin_bots ~= nil
	self._humans_btn:set_visible(admin)
	local humans_only = admin and self.humans_only
	-- Closed (every match starts so): only the pill can show (not on a phone); the rows and the panel
	-- are filled when it opens (set_open). (2026-10-27: a closed board sorted the ranking, filled its
	-- hidden rows and laid its hidden panel out every second.)
	if not self.expanded and not humans_only then
		local me = ctx:me()
		self:_set_pill(if me ~= 0 then ctx:rank_of(me) else 0, ctx:leader())
		return
	end
	local ranking = s:ranking()
	if humans_only then
		local only = {}
		for _, o in ipairs(ranking) do
			if Leaderboard.is_real_player(ctx, o) then
				table.insert(only, o)
			end
		end
		ranking = only
	end
	local me = ctx:me()
	local shown = math.min(if not ctx.compact then Leaderboard.ROWS else 5, #ranking)
	local my_rank = -1
	for i, o in ipairs(ranking) do
		if o.id == me then
			my_rank = i
			break
		end
	end
	for i, r in ipairs(self._rows) do
		r:set_visible(i <= shown)
		if i <= shown then
			r:set_row(ranking[i], i)
		end
	end
	-- pinned below the top: your own row, and for admins the real players (up to a cap)
	local cap = if ctx.compact then Leaderboard.ADMIN_PINS_COMPACT else Leaderboard.ADMIN_PINS
	local pins, humans, more = {}, 0, 0
	for i = shown + 1, #ranking do
		local o = ranking[i]
		if o.id == me and me ~= 0 then
			table.insert(pins, i)
		elseif Leaderboard.is_real_player(ctx, o) then
			if humans < cap then
				humans += 1
				table.insert(pins, i)
			else
				more += 1
			end
		end
	end
	for j, i in ipairs(pins) do
		local r = self._pins[j]
		if r == nil then
			r = Row.new(ctx)
			r:set_min_size(Vector2.new(0, if ctx.touch then 44 else 28))
			r.pressed:Connect(function()
				self._opened_msec = msec()
			end)
			self._pins[j] = r
			self._list:add_child(r)
			self._list:move_child(self._pin_more, -1)
		end
		r:set_visible(true)
		r:set_row(ranking[i], i)
	end
	for j = #pins + 1, #self._pins do
		self._pins[j]:set_visible(false)
		self._pins[j].owner_id = 0
	end
	self._pin_sep:set_visible(#pins > 0)
	self._pin_more:set_visible(more > 0)
	if more > 0 then
		self._pin_more:set_text(string.format("+%d more %s", more, if more == 1 then "human" else "humans"))
	end
	self:_refresh_teams()
	self._count:set_text(string.format(if humans_only then "%d humans" else "%d alive", #ranking))
	self:_set_pill(my_rank, ranking[1])
	self.panel:reset_size()
end

--- The pill: my rank (`my_rank` > 0) and land, else the leader's name (cut to 10 characters) and
--- land. (Written when it changed: a button's text lays the HUD out again even when it is the same.)
function Leaderboard._set_pill(self, my_rank: number, leader: any)
	local ctx = self.ctx
	local T = UITheme
	local s = ctx.state
	local text = "Leaderboard"
	if my_rank > 0 then
		text = string.format("#%d  ·  %s", my_rank, T.fmt_pct(s:land_share(ctx:me())))
	elseif leader ~= nil then
		local nm = leader.name
		if utf8.len(nm) and (utf8.len(nm) :: number) > 10 then
			local cut = utf8.offset(nm, 10)
			nm = string.sub(nm, 1, (cut or 10) - 1) .. "…"
		end
		text = string.format("%s  %s", nm, T.fmt_pct(s:land_share(leader.id)))
	end
	if text ~= self._pill.text then
		self._pill:set_text(text)
	end
end

--- A team game (Core/Teams): the teams above the players, by land: the
--- team's colour, its name, its players still standing and its share of the land that counts; the
--- player's own team in its colour. Phones show the top 3 (and the player's team).
Leaderboard.TEAM_ROWS = 7
function Leaderboard._refresh_teams(self)
	local ctx = self.ctx
	local T = UITheme
	local s = ctx.state
	local on = s ~= nil and type(s.is_team_game) == "function" and s:is_team_game()
	if not on then
		if self._team_box ~= nil then
			self._team_box:set_visible(false)
		end
		return
	end
	if self._team_box == nil then
		self._team_box = T.vbox(2)
		self._list:add_child(self._team_box)
		self._list:move_child(self._team_box, 0)
	end
	local box = self._team_box
	box:set_visible(true)
	for _, ch in ipairs(box:get_children()) do
		box:remove_child(ch)
		ch:queue_free()
	end
	local mine = if ctx:me() ~= 0 then s:team_of(ctx:me()) else 0
	local teams = s:team_ranking()
	local limit = if ctx.compact then 3 else Leaderboard.TEAM_ROWS
	for i, r in ipairs(teams) do
		if i > limit and r.team ~= mine then
			continue
		end
		local row = T.hbox(6)
		row:set_min_size(Vector2.new(0, 22))
		local col = s:team_color(r.team)
		local sw = T.swatch(col, 10.0, 3)
		sw.size_flags_vertical = W.SHRINK_CENTER
		row:add_child(sw)
		local nm = T.label(ctx:team_label(r.team), 12, if r.team == mine then 800 else 600, if r.team == mine then T.owner_ui_color(col) else T.TEXT)
		nm.size_flags_horizontal = W.EXPAND_FILL
		nm.size_flags_vertical = W.SHRINK_CENTER
		nm.text_overrun_behavior = W.OVERRUN_ELLIPSIS
		nm.clip_text = true
		row:add_child(nm)
		local n = T.label(tostring(r.members), 11, 600, T.TEXT_3)
		n.size_flags_vertical = W.SHRINK_CENTER
		row:add_child(n)
		local sh = T.label(T.fmt_pct(ctx:team_share(r.team)), 12, 700, T.TEXT)
		sh.size_flags_vertical = W.SHRINK_CENTER
		row:add_child(sh)
		box:add_child(row)
	end
	local sep = T.hdivider()
	box:add_child(sep)
end

--- Per frame (GDScript _process).
function Leaderboard.update(self, delta: number)
	local ctx = self.ctx
	if ctx.compact and self.expanded and msec() - self._opened_msec > Leaderboard.PEEK_SECONDS * 1000.0 then
		self:set_open(false)
	end
	self._accum += delta
	if self._accum >= 1.0 and self:is_visible_in_tree() and self._dirty then
		self._accum = 0.0
		self:refresh()
	end
end

return Leaderboard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="205">
            <Properties>
              <string name="Name">Locker</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The Locker (2026-09-29: cosmetic loot boxes of territory skins and flags to unlock):
-- a modal from the title with the crate card on the left and what you own on the right.
--   crate card  the crate art, "a territory skin or a flag you don't own yet", the player's own odds
--               per rarity (Cosmetics.odds, shown before every purchase: Roblox's paid random items
--               rules), how many items they own, and the button: 15 Robux for the first crate, 49
--               after (Data/Products), "Open" while a bought crate waits; under it three crates for
--               less (Data/Products crate3, _pack_saving). Hidden where paid random
--               items are restricted (Session.inventory.crates_allowed, PolicyService on the server).
--   grid        Skins / Flags tabs: every item (owned bright, the rest dimmed as a preview of what a
--               crate can give); press an owned one to wear it, "None" to wear nothing. An exclusive
--               skin (Cosmetics.exclusives) shows only to its owner, first, "EXCLUSIVE" in pink.
--   reveal      after a crate opens: the item in its rarity's colour, Equip / Open another / Done.
-- The purchase goes like the takeover's (Takeover.luau): Roblox's prompt, the server stores the crate
-- (server/Purchases), the client opens it (Session.open_crate), the server rolls it.
-- Signals: closed.
local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local ChestView = require("./ChestView")
local UICtx = require("./UICtx")
local Signal = UITheme.core("Signal")

local IS_ROBLOX = typeof(game) == "Instance"
local function shared(name: string): any
	if IS_ROBLOX then
		return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data[name]) :: any
	end
	return (require :: any)("../../shared/Data/" .. name)
end
local Cosmetics = shared("Cosmetics")
local Products = shared("Products")
local Prices = require("./Prices")
local SkinPreviews: any = (function()
	local ok, m = pcall(function()
		if IS_ROBLOX then
			return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Assets.SkinPreviews)
		end
		return (require :: any)("../../shared/Assets/SkinPreviews")
	end)
	return if ok and type(m) == "table" then m else {}
end)()

local Locker = W.class(W.Control)

Locker.TABS = { { "Skins", "skin" }, { "Flags", "flag" } }
Locker.SKIN_CARD = Vector2.new(116, 128)
Locker.FLAG_CARD = Vector2.new(104, 96)
Locker.GRID_SIZE = Vector2.new(560, 430)
Locker.CRATE_W = 250
--- the colour skins are previewed in (the player's own varies by match)
Locker.PREVIEW_COLOR = Color3.fromRGB(64, 132, 230)
Locker.PREVIEW_TILES = 24
Locker.CREDIT_WAIT_S = 30

local FONT = Font.fromId(12187365977, Enum.FontWeight.Bold)
local FONT_M = Font.fromId(12187365977, Enum.FontWeight.Medium)

local function c3(hex: number): Color3
	return Color3.fromRGB((hex // 65536) % 256, (hex // 256) % 256, hex % 256)
end

-- A skin's preview: its pattern in PREVIEW_COLOR over sand, the way the map draws it
-- (MapSurface: fill alpha 150, secondary Cosmetics.SECONDARY_ALPHA, a darker edge). Cached per skin.
local previews: { [string]: any } = {}
local function skin_preview(skin: any): any
	local cached = previews[skin.id]
	if cached ~= nil then
		return cached or nil
	end
	if not IS_ROBLOX then
		return nil
	end
	-- (a skin with several colours shows twice the tiles: its pattern is larger, as in the atlas)
	local n = if skin.colors ~= nil then Locker.PREVIEW_TILES * 2 else Locker.PREVIEW_TILES
	local ok, img = pcall(function()
		return game:GetService("AssetService"):CreateEditableImage({ Size = Vector2.new(n, n) })
	end)
	if not ok or img == nil then
		previews[skin.id] = false
		return nil
	end
	local mask, mw, mh = Cosmetics.mask(skin)
	local c = Locker.PREVIEW_COLOR
	local r, g, b = c.R, c.G, c.B
	local sr, sg, sb = Cosmetics.secondary(skin, r, g, b)
	local tr, tg, tb = 221 / 255, 205 / 255, 160 / 255
	local a1, a2 = 150 / 255, Cosmetics.SECONDARY_ALPHA / 255
	local buf = buffer.create(n * n * 4)
	for y = 0, n - 1 do
		for x = 0, n - 1 do
			local cr, cg, cb, a
			if x == 0 or y == 0 or x == n - 1 or y == n - 1 then
				cr, cg, cb, a = r * 0.875, g * 0.875, b * 0.875, 1
			else
				local mx = bit32.rshift(x, skin.scale or 0) % mw
				local my = bit32.rshift(y, skin.scale or 0) % mh
				local k = buffer.readu8(mask, my * mw + mx)
				local kr, kg, kb
				if skin.colors ~= nil and k ~= 0 then
					kr, kg, kb = Cosmetics.color(skin, k)
				end
				if kr ~= nil then
					cr, cg, cb, a = kr, kg :: number, kb :: number, Cosmetics.skin_alpha(skin) / 255
				elseif k ~= 0 and skin.colors == nil then
					cr, cg, cb, a = sr, sg, sb, a2
				else
					cr, cg, cb, a = r, g, b, a1
				end
			end
			local k = (y * n + x) * 4
			buffer.writeu8(buf, k, math.floor((tr * (1 - a) + cr * a) * 255 + 0.5))
			buffer.writeu8(buf, k + 1, math.floor((tg * (1 - a) + cg * a) * 255 + 0.5))
			buffer.writeu8(buf, k + 2, math.floor((tb * (1 - a) + cb * a) * 255 + 0.5))
			buffer.writeu8(buf, k + 3, 255)
		end
	end
	local wrote = pcall(function()
		img:WritePixelsBuffer(Vector2.zero, Vector2.new(n, n), buf)
	end)
	previews[skin.id] = if wrote then img else false
	return if wrote then img else nil
end

--- Show item `it` in ImageLabel `img` (a skin's preview or a flag from its atlas).
local function show_item(img: ImageLabel, it: any)
	img.ImageRectOffset = Vector2.zero
	img.ImageRectSize = Vector2.zero
	img.ImageContent = Content.none
	img.Image = ""
	if it == nil then
		return
	end
	if it.kind == "flag" then
		img.ResampleMode = Enum.ResamplerMode.Default
		img.Image = Cosmetics.flag_image(it)
		img.ImageRectOffset = Vector2.new(it.x, it.y)
		img.ImageRectSize = Vector2.new(it.w, it.h)
	else
		img.ResampleMode = Enum.ResamplerMode.Pixelated
		-- the uploaded atlas (Assets/SkinPreviews); a runtime EditableImage only without it (phones can
		-- run out of EditableImage budget: an Epic reveal card came out empty live, 2026-09-29)
		local cell = SkinPreviews.cells and SkinPreviews.cells[it.id]
		if cell ~= nil and SkinPreviews.image then
			img.Image = SkinPreviews.image
			img.ImageRectOffset = Vector2.new(cell[1], cell[2])
			img.ImageRectSize = Vector2.new(cell[3], cell[4])
			return
		end
		local ed = skin_preview(it)
		if ed ~= nil then
			img.ImageContent = Content.fromObject(ed)
		end
	end
end
Locker.show_item = show_item

function Locker.new(c: any)
	local self = setmetatable({}, Locker.__mt)
	W.Control._init(self)
	self.ctx = c
	self.closed = Signal.new()
	self.is_open = false
	-- (Roblox's price of the crate arrives a moment after the first look: UI/Prices)
	self:_connect(Prices.changed:Connect(function()
		if self.is_open then
			self:_refresh_crate()
		end
	end))
	self._tab = 1
	self._pending = nil
	self._cards = {}
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	self:set_visible(false)
	self._dim = W.ColorRect.new(UITheme.rgba(0.01, 0.015, 0.05, 0.78))
	self._dim:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._dim.gui_input:Connect(function(e)
		-- (a press on the window's own ground reaches the dim too: only one outside it closes)
		if
			e.pressed
			and not (self.opening ~= nil and self.opening.is_open)
			and not self._panel:has_global_point(e.global_position)
		then
			self:close()
		end
	end)
	self:add_child(self._dim)
	self._panel = GlassPanel.new(22.0, 20.0, 18, true, 34)
	self._panel:set_tint(UITheme.rgba(0.045, 0.065, 0.13, 0.96))
	self:add_child(self._panel)
	local v = UITheme.vbox(12)
	self._v = v
	self._panel:add_child(v)
	-- head: title, owned count, close
	local head = UITheme.hbox(12)
	local title = UITheme.label("LOCKER", 20, 800, UITheme.TEXT, 3)
	title.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(title)
	self._count = UITheme.label("", 13, 600, UITheme.TEXT_2)
	self._count.size_flags_horizontal = W.EXPAND_FILL
	self._count.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(self._count)
	local close = W.Button.new("", "GhostButton")
	close:set_icon("close")
	close.expand_icon = true
	close:set_min_size(Vector2.new(34, 34))
	close:add_theme_constant_override("icon_max_width", 13)
	close:add_theme_stylebox_override("normal", UITheme.empty_box(8, 8))
	close:add_theme_stylebox_override("hover", UITheme.flat(UITheme.FILL, 8, UITheme.CLEAR, 0, 8, 8))
	close.size_flags_vertical = W.SHRINK_CENTER
	close.pressed:Connect(function()
		self:close()
	end)
	head:add_child(close)
	v:add_child(head)
	-- body: crate card | tabs + grid
	local body = UITheme.hbox(16)
	self._body = body
	v:add_child(body)
	self:_build_crate(body)
	local right = UITheme.vbox(10)
	self._right = right
	body:add_child(right)
	local tabs = UITheme.hbox(6)
	self._tabs = {}
	for i, t in ipairs(Locker.TABS) do
		local chip = UITheme.button(t[1], "ChipButton", "", 32.0)
		chip.toggle_mode = true
		chip:set_font_size(12)
		chip:set_pressed_no_signal(i == self._tab)
		chip.pressed:Connect(function()
			self._tab = i
			for j, ch in ipairs(self._tabs) do
				ch:set_pressed_no_signal(j == i)
			end
			self:_rebuild()
		end)
		table.insert(self._tabs, chip)
		tabs:add_child(chip)
	end
	right:add_child(tabs)
	local host = W.Control.new()
	host:set_min_size(Locker.GRID_SIZE)
	host:set_mouse_filter(W.MOUSE_PASS)
	self._host = host
	right:add_child(host)
	local sf = Instance.new("ScrollingFrame")
	sf.Name = "LockerGrid"
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.Size = UDim2.fromScale(1, 1)
	sf.ScrollBarThickness = 6
	sf.ScrollBarImageColor3 = Color3.new(1, 1, 1)
	sf.ScrollBarImageTransparency = 0.6
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.CanvasSize = UDim2.new(0, 0, 0, 0)
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	sf.ZIndex = 40
	sf.Parent = host.gui
	host:_part(sf, "ScrollBarImageTransparency", 0.4)
	self._sf = sf
	local grid = Instance.new("UIGridLayout")
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = sf
	self._grid = grid
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 2)
	pad.PaddingLeft = UDim.new(0, 2)
	pad.Parent = sf
	self._foot = UITheme.label("Flags: Wikimedia Commons (public domain)", 11, 500, UITheme.TEXT_3)
	v:add_child(self._foot)
	-- Roblox: the purchase prompt (the session's signals: bind, once UIRoot has one)
	if IS_ROBLOX then
		game:GetService("MarketplaceService").PromptProductPurchaseFinished:Connect(function(_u, product_id, purchased)
			self:_on_prompt_done(product_id, purchased)
		end)
	end
	return self
end

--- The session's inventory, credits and crate answers (UIRoot.setup, when the session exists).
function Locker.bind(self, s: any)
	if s == nil or self._bound == s then
		return
	end
	self._bound = s
	if s.inventory_changed then
		s.inventory_changed:Connect(function()
			self:_on_inventory()
		end)
	end
	if s.credits_changed then
		s.credits_changed:Connect(function()
			self:_on_credits()
		end)
	end
	if s.crate_result then
		s.crate_result:Connect(function(ok, res)
			self:_on_result(ok, res)
		end)
	end
end

-- ---------------------------------------------------------------------------------------------
-- The crate card
-- ---------------------------------------------------------------------------------------------

function Locker._build_crate(self, parent: any)
	local card = W.Panel.new()
	card:set_mouse_filter(W.MOUSE_IGNORE)
	card:add_theme_stylebox_override(
		"panel",
		UITheme.flat(UITheme.c(UITheme.GOLD, 0.07), 16, UITheme.c(UITheme.GOLD, 0.45), 1, 16.0, 14.0)
	)
	self._crate = card
	parent:add_child(card)
	local v = UITheme.vbox(8)
	self._crate_v = v
	card:add_child(v)
	-- the 3D chest (ChestView: the opening's chest), bobbing and wiggling while the Locker is open
	local vpf = Instance.new("ViewportFrame")
	vpf.BackgroundTransparency = 1
	self._chest_view = ChestView.build(vpf)
	self._chest_P = ChestView.rest()
	self._chest_t = 0.0
	ChestView.pose(self._chest_view, self._chest_P)
	self._art = W.wrap(vpf)
	self._art:_part(vpf, "ImageTransparency", 1.0)
	self._art:set_min_size(Vector2.new(Locker.CRATE_W - 32, 150))
	self._art:set_mouse_filter(W.MOUSE_IGNORE)
	self._art.size_flags_horizontal = W.SHRINK_CENTER
	v:add_child(self._art)
	self._crate_title = UITheme.label("COSMETIC CRATE", 16, 800, UITheme.TEXT, 2)
	self._crate_title:set_alignment(W.ALIGN_CENTER)
	v:add_child(self._crate_title)
	self._crate_sub = UITheme.label("A territory skin or a flag you don't own yet", 12, 500, UITheme.TEXT_2)
	self._crate_sub:set_alignment(W.ALIGN_CENTER)
	self._crate_sub:set_autowrap(true)
	self._crate_sub:set_min_size(Vector2.new(Locker.CRATE_W - 32, 0))
	v:add_child(self._crate_sub)
	-- the odds (the player's own; shown before any purchase)
	local odds = UITheme.vbox(3)
	self._odds_box = odds
	self._odds = {}
	self._odds_labels = {}
	for _, r in Cosmetics.RARITIES do
		local row = UITheme.hbox(8)
		local sw = UITheme.swatch(c3(r.color), 10.0, 3)
		sw.size_flags_vertical = W.SHRINK_CENTER
		row:add_child(sw)
		local name = UITheme.label(r.name, 12, 600, UITheme.TEXT)
		name.size_flags_horizontal = W.EXPAND_FILL
		row:add_child(name)
		local pct = UITheme.label("", 12, 700, UITheme.TEXT)
		row:add_child(pct)
		self._odds[r.id] = pct
		table.insert(self._odds_labels, name)
		table.insert(self._odds_labels, pct)
		odds:add_child(row)
	end
	v:add_child(odds)
	self._buy = UITheme.button("49", "PrimaryButton", "robux", 48.0)
	self._buy:set_min_size(Vector2.new(Locker.CRATE_W - 32, 48))
	self._buy.pressed:Connect(function()
		self:_buy_pressed()
	end)
	v:add_child(self._buy)
	-- three crates at once, for less than three (Data/Products crate3; 2026-10-19)
	self._buy3 = UITheme.button("", "GlassButton", "robux", 42.0)
	self._buy3:set_min_size(Vector2.new(Locker.CRATE_W - 32, 42))
	self._buy3:set_font_size(13)
	self._buy3:set_visible(false)
	self._buy3.pressed:Connect(function()
		self:_buy_pressed(Products.crate3)
	end)
	v:add_child(self._buy3)
	-- and ten (Data/Products crate10; 2026-10-27)
	self._buy10 = UITheme.button("", "GlassButton", "robux", 42.0)
	self._buy10:set_min_size(Vector2.new(Locker.CRATE_W - 32, 42))
	self._buy10:set_font_size(13)
	self._buy10:set_visible(false)
	self._buy10.pressed:Connect(function()
		self:_buy_pressed(Products.crate10)
	end)
	v:add_child(self._buy10)
	self._note = UITheme.label("", 11, 500, UITheme.TEXT_3)
	self._note:set_alignment(W.ALIGN_CENTER)
	self._note:set_autowrap(true)
	self._note:set_min_size(Vector2.new(Locker.CRATE_W - 32, 0))
	v:add_child(self._note)
end

function Locker._inv(self): any
	local s = self.ctx.session
	return if s ~= nil and s.inventory ~= nil
		then s.inventory
		else { owned = {}, equipped = {}, crates_bought = 0, crates_allowed = false }
end

function Locker._crates(self): number
	local s = self.ctx.session
	local c = if s ~= nil then s.credits else nil
	return if type(c) == "table" then (tonumber(c.crate) or 0) else 0
end

--- The crate product to sell now: the first crate's price until one was bought.
function Locker._product(self): any
	local inv = self:_inv()
	if (inv.crates_bought or 0) <= 0 and Products.crate_first and Products.crate_first.id ~= 0 then
		return Products.crate_first
	end
	return Products.crate
end

--- Its price in Robux: Roblox's for this player (UI/Prices).
function Locker._price(self): number
	return Prices.robux(if self:_product() == Products.crate_first then "crate_first" else "crate")
end

--- A crate pack's (`key`: "crate3", "crate10") Robux saved against its crates one by one at Roblox's
--- price for this player; nil when it isn't offered: not created here, not cheaper (Managed Pricing
--- moves each price on its own), or fewer than its crates' worth of items left to find (a crate never
--- gives a duplicate).
function Locker._pack_saving(self, left: number, key: string): number?
	local p = Products[key]
	if p == nil or p.id == 0 then
		return nil
	end
	local n = math.max(1, tonumber(p.count) or 3)
	local save = n * Prices.robux("crate") - Prices.robux(key)
	if save <= 0 or left - self:_crates() < n then
		return nil
	end
	return save
end

function Locker._refresh_crate(self)
	local inv = self:_inv()
	local total = #Cosmetics.all()
	local owned = Cosmetics.crate_owned(inv.owned)
	self._count:set_text(string.format("%d of %d unlocked", owned, total))
	for _, e in Cosmetics.odds(inv.owned) do
		local l = self._odds[e.rarity.id]
		if l then
			l:set_text(if e.left > 0 then string.format("%.0f%%", e.odds * 100) else "all owned")
		end
	end
	local all_owned = owned >= total
	local waiting = self:_crates()
	local busy = self._pending ~= nil
	local prod = self:_product()
	local allowed = inv.crates_allowed == true
	self._buy:set_visible(allowed and not all_owned)
	self._odds_box:set_visible(allowed and not all_owned)
	self._buy:set_disabled(busy)
	local packs = allowed and not busy and waiting <= 0
	local save = if packs then self:_pack_saving(total - owned, "crate3") else nil
	local save10 = if packs then self:_pack_saving(total - owned, "crate10") else nil
	self._buy3:set_visible(save ~= nil and (self._tight or 0) < 2)
	if save ~= nil then
		self._buy3:set_text(string.format("%d  ·  %d CRATES", Prices.robux("crate3"), Products.crate3.count or 3))
	end
	self._buy10:set_visible(save10 ~= nil and (self._tight or 0) < 3)
	if save10 ~= nil then
		self._buy10:set_text(string.format("%d  ·  %d CRATES", Prices.robux("crate10"), Products.crate10.count or 10))
	end
	-- (the note names the bigger saving)
	local pack_n = if save10 ~= nil then Products.crate10.count or 10 else Products.crate3.count or 3
	save = save10 or save
	if busy then
		self._buy:set_icon("")
		self._buy:set_text("OPENING…")
	elseif waiting > 0 then
		self._buy:set_icon("crate")
		self._buy:set_text(if waiting > 1 then string.format("OPEN CRATE (%d)", waiting) else "OPEN CRATE")
	else
		self._buy:set_icon("robux")
		self._buy:set_text(tostring(self:_price()))
	end
	if not allowed then
		self._note:set_text("Crates aren't available in your country. What you own stays yours.")
	elseif all_owned then
		self._note:set_text("You own every skin and flag.")
	elseif waiting <= 0 and prod == Products.crate_first then
		self._note:set_text(string.format("Your first crate: %d instead of %d", self:_price(), Prices.robux("crate")))
	elseif save ~= nil then
		-- (phones: one line; the crate card is all the height a phone has)
		self._note:set_text(
			if self.ctx.compact
				then string.format("%d crates save %d", pack_n, save)
				else string.format("%d crates save %d  ·  Never a duplicate", pack_n, save)
		)
	else
		self._note:set_text("Never a duplicate")
	end
end

-- ---------------------------------------------------------------------------------------------
-- Buying and opening
-- ---------------------------------------------------------------------------------------------

--- A short notice (UIRoot sets this to its toasts).
function Locker._toast(_self, _text: string) end

function Locker._report(self, kind: string)
	local s = self.ctx.session
	if s ~= nil and type(s.report) == "function" then
		s:report(kind)
	end
end

--- `pack`: the 3-crate pack's button (Products.crate3); otherwise the main button (or OPEN ANOTHER).
function Locker._buy_pressed(self, pack: any?)
	local inv = self:_inv()
	if self._pending ~= nil or inv.crates_allowed ~= true then
		return
	end
	self:_report("crate_click")
	if self:_crates() > 0 then
		self:_open()
		return
	end
	local prod = pack or self:_product()
	if prod == nil or prod.id == 0 or not IS_ROBLOX then
		return
	end
	self._pending = { phase = "prompt", product = prod.id, since = os.clock() }
	self:_refresh_crate()
	local ok = pcall(function()
		game:GetService("MarketplaceService"):PromptProductPurchase(game:GetService("Players").LocalPlayer, prod.id)
	end)
	if not ok then
		self:_cancel("Purchases aren't available right now.")
	end
end

function Locker._open(self)
	self._pending = { phase = "opening", since = os.clock() }
	self:_refresh_crate()
	-- the show starts at once: the server's roll lands while the chest drops / shakes
	if self.opening ~= nil then
		self.opening:play(self:_offer())
	end
	local s = self.ctx.session
	if s == nil or not s:open_crate() then
		if self.opening ~= nil then
			self.opening:fail("Couldn't reach the server. Try again in a moment.")
		end
		self:_cancel("Couldn't reach the server. Try again in a moment.")
	end
end

--- What the opening show offers next: waiting crates, the next price, whether more can come, and
--- what the player wears.
function Locker._offer(self): any
	local inv = self:_inv()
	local owned = Cosmetics.crate_owned(inv.owned)
	return {
		crates = self:_crates(),
		price = self:_price(),
		can_more = inv.crates_allowed == true and owned < #Cosmetics.all(),
		wearing = function(slot: string): string?
			return self:_equipped(slot)
		end,
	}
end

--- The opening show (UIRoot makes it, above the Locker).
function Locker.set_opening(self, o: any)
	self.opening = o
	o.preview_of = skin_preview
	o.show_item = show_item
	o.info_of = function()
		return self:_offer()
	end
	o.wear:Connect(function(id: string)
		local it = Cosmetics.item(id)
		local se = self.ctx.session
		if it ~= nil and se ~= nil then
			self.ctx:sfx("click")
			se:equip(it.kind, it.id)
		end
	end)
	o.again:Connect(function()
		self:_buy_pressed()
	end)
	o.closed:Connect(function(fail_text: string?)
		if fail_text then
			self:_toast(fail_text)
		end
		if self.is_open then
			self:_refresh_crate()
			self:_rebuild()
		end
	end)
end

function Locker._cancel(self, message: string?)
	self._pending = nil
	if message then
		self:_toast(message)
	end
	self:_refresh_crate()
end

function Locker._on_prompt_done(self, product_id: number, purchased: boolean)
	local p = self._pending
	if p == nil or p.phase ~= "prompt" or product_id ~= p.product then
		return
	end
	if not purchased then
		self:_cancel(nil)
		return
	end
	-- bought: the server stores the crate and says so (credits); then it opens
	p.phase = "credit"
	p.since = os.clock()
	if self:_crates() > 0 then
		self:_open()
	end
end

function Locker._on_credits(self)
	local p = self._pending
	if p ~= nil and p.phase == "credit" and self:_crates() > 0 then
		self:_open()
	end
	if self.is_open then
		self:_refresh_crate()
	end
end

function Locker._on_inventory(self)
	if self.is_open then
		self:_refresh_crate()
		self:_rebuild()
	end
	if self.opening ~= nil and self.opening.is_open then
		self.opening:refresh_buttons()
	end
end

function Locker._on_result(self, ok: boolean, res: string)
	local p = self._pending
	if p == nil or p.phase ~= "opening" then
		return
	end
	self._pending = nil
	self:_refresh_crate()
	local o = self.opening
	if ok then
		local it = Cosmetics.item(res)
		if it ~= nil then
			-- the grid behind shows the new item's tab
			self._tab = if it.kind == "flag" then 2 else 1
			for j, ch in ipairs(self._tabs) do
				ch:set_pressed_no_signal(j == self._tab)
			end
		end
		if o ~= nil then
			o:resolve(res)
		end
	elseif o ~= nil then
		o:fail(
			if res == "everything owned"
				then "You own every skin and flag already."
				else "Couldn't open the crate right now. It's saved: try again."
		)
	end
end

--- Once a second while open: a purchase that never came back gives up (a crate bought stays saved).
function Locker.tick(self)
	local p = self._pending
	if p ~= nil then
		local limit = if p.phase == "prompt" then 180 else Locker.CREDIT_WAIT_S
		if os.clock() - p.since > limit then
			self:_cancel(if p.phase == "prompt" then nil else "Your crate is saved: open it in a moment.")
		end
	end
end

-- ---------------------------------------------------------------------------------------------
-- The grid
-- ---------------------------------------------------------------------------------------------

function Locker._equipped(self, slot: string): string?
	local inv = self:_inv()
	return inv.equipped and inv.equipped[slot] or nil
end

function Locker._card(self, it: any, order: number, slot: string): TextButton
	local s = UITheme.scale
	local inv = self:_inv()
	local owned = it == nil or inv.owned[it.id] == true
	local equipped = if it == nil then self:_equipped(slot) == nil else self:_equipped(slot) == it.id
	local rar = if it ~= nil then Cosmetics.rarity(it.rarity) else nil
	local b = Instance.new("TextButton")
	b.Name = if it then it.id else "none"
	b.Text = ""
	b.AutoButtonColor = false
	b.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	b.BackgroundTransparency = 0.94
	b.LayoutOrder = order
	b.ZIndex = 41
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, math.floor(10 * s))
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = if equipped then UITheme.color3(UITheme.to_rgba(UITheme.AMBER)) else Color3.new(1, 1, 1)
	stroke.Transparency = if equipped then 0 else 0.88
	stroke.Thickness = if equipped then 2 else 1
	stroke.Parent = b
	local img = Instance.new("ImageLabel")
	img.Name = "Preview"
	img.BackgroundTransparency = 1
	img.ScaleType = Enum.ScaleType.Fit
	img.Position = UDim2.fromOffset(math.floor(10 * s), math.floor(10 * s))
	img.Size = UDim2.new(1, -math.floor(20 * s), 1, -math.floor(46 * s))
	img.ZIndex = 42
	img.Parent = b
	show_item(img, it)
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.FontFace = FONT
	name.TextSize = math.floor(12 * s)
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextTruncate = Enum.TextTruncate.AtEnd
	name.Text = if it then it.name else "None"
	name.Position = UDim2.new(0, math.floor(8 * s), 1, -math.floor(34 * s))
	name.Size = UDim2.new(1, -math.floor(16 * s), 0, math.floor(16 * s))
	name.ZIndex = 42
	name.Parent = b
	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.FontFace = FONT_M
	sub.TextSize = math.floor(10 * s)
	sub.TextColor3 = if equipped
		then UITheme.color3(UITheme.to_rgba(UITheme.AMBER))
		elseif rar and owned then c3(rar.color)
		else Color3.fromRGB(150, 158, 180)
	sub.Text = if equipped then "WEARING" elseif not owned then "LOCKED" elseif rar then string.upper(rar.name) else ""
	sub.Position = UDim2.new(0, math.floor(8 * s), 1, -math.floor(18 * s))
	sub.Size = UDim2.new(1, -math.floor(16 * s), 0, math.floor(12 * s))
	sub.ZIndex = 42
	sub.Parent = b
	local host = self._host
	host:_part(b, "BackgroundTransparency", 0.06)
	host:_part(stroke, "Transparency", 1 - stroke.Transparency)
	host:_part(img, "ImageTransparency", if owned then 1.0 else 0.3)
	host:_part(name, "TextTransparency", if owned then 1.0 else 0.45)
	host:_part(sub, "TextTransparency", 1.0)
	b.MouseEnter:Connect(function()
		host:_part(b, "BackgroundTransparency", 0.12)
	end)
	b.MouseLeave:Connect(function()
		host:_part(b, "BackgroundTransparency", 0.06)
	end)
	b.Activated:Connect(function()
		if not owned then
			self.ctx:sfx("deny", -6.0)
			return
		end
		local se = self.ctx.session
		if se ~= nil then
			self.ctx:sfx("click")
			se:equip(slot, if it then it.id else false)
		end
	end)
	b.Parent = self._sf
	return b
end

function Locker._rebuild(self)
	for _, b in self._cards do
		self._host:_drop_part(b)
		for _, d in b:GetDescendants() do
			self._host:_drop_part(d)
		end
		b:Destroy()
	end
	table.clear(self._cards)
	local s = UITheme.scale
	local slot = Locker.TABS[self._tab][2]
	local cell = if slot == "skin" then Locker.SKIN_CARD else Locker.FLAG_CARD
	if self.ctx.compact then
		cell *= 0.82
	end
	self._grid.CellSize = UDim2.fromOffset(math.floor(cell.X * s), math.floor(cell.Y * s))
	self._grid.CellPadding = UDim2.fromOffset(math.floor(8 * s), math.floor(8 * s))
	local inv = self:_inv()
	-- None first, then owned (by rarity, rarest first), then the rest
	local list = {}
	for _, it in Cosmetics.all() do
		if it.kind == slot then
			table.insert(list, it)
		end
	end
	-- (an exclusive only for whoever owns it: nobody else can get one; a shop flag once bought, the
	-- crate can't give one)
	for _, it in Cosmetics.exclusives() do
		if it.kind == slot and inv.owned[it.id] == true then
			table.insert(list, it)
		end
	end
	-- (a General skin once given: Data/Subscription)
	for _, it in Cosmetics.generals() do
		if it.kind == slot and inv.owned[it.id] == true then
			table.insert(list, it)
		end
	end
	for _, it in Cosmetics.shop_items() do
		if it.kind == slot and inv.owned[it.id] == true then
			table.insert(list, it)
		end
	end
	local rank = { exclusive = 0, general = 0, legendary = 1, epic = 2, rare = 3, common = 4 }
	table.sort(list, function(a, b)
		local oa, ob = inv.owned[a.id] == true, inv.owned[b.id] == true
		if oa ~= ob then
			return oa
		end
		local ra, rb = rank[a.rarity] or 9, rank[b.rarity] or 9
		if ra ~= rb then
			return ra < rb
		end
		return a.name < b.name
	end)
	table.insert(self._cards, self:_card(nil, 0, slot))
	for i, it in list do
		table.insert(self._cards, self:_card(it, i, slot))
	end
end

-- ---------------------------------------------------------------------------------------------
-- Open / close / layout
-- ---------------------------------------------------------------------------------------------

function Locker.open(self)
	if self.is_open then
		return
	end
	self.is_open = true
	self:_report("crate_shop")
	Prices.fetch()
	self:_refresh_crate()
	self:_rebuild()
	self:set_visible(true)
	self:apply_layout()
	self._panel:set_modulate_a(1.0)
	self._dim:set_modulate_a(0.0)
	W.fade(self._dim, 1.0, 0.2)
	UICtx.pop_in(self._panel, 0.0, 0.94, 0.3)
	self.ctx:sfx("open")
	if self._chest_conn == nil and IS_ROBLOX then
		self._chest_conn = game:GetService("RunService").RenderStepped:Connect(function(dt)
			self._chest_t += dt
			ChestView.idle(self._chest_P, self._chest_t, 2.4)
			ChestView.pose(self._chest_view, self._chest_P)
		end)
	end
end

function Locker.close(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	self.ctx:sfx("close")
	local t = self:create_tween():set_parallel(true)
	t:tween_property(self._dim, "modulate:a", 0.0, 0.15)
	t:tween_property(self._panel, "modulate:a", 0.0, 0.15)
	t:chain():tween_callback(function()
		if not self.is_open then
			self:set_visible(false)
			if self._chest_conn then
				self._chest_conn:Disconnect()
				self._chest_conn = nil
			end
		end
	end)
	self.closed:Fire()
end

function Locker.apply_layout(self)
	local ctx = self.ctx
	local area = ctx:clear_rect()
	local compact = ctx.compact
	-- phones (landscape: wide, short): the same side-by-side layout with a slim crate card (no art,
	-- smaller type) so the grid keeps the height
	local cw = if compact then 196 else Locker.CRATE_W
	self._art:set_visible(not compact)
	-- phones (2026-10-22, from a phone's screenshot: the crates menu overflowed vertically, as the
	-- window ran past the screen's foot): no line under the title (the odds name the rarities), no
	-- footer (the title screen credits the flags), slimmer edges, tighter odds, a one-line note
	self._crate_sub:set_visible(not compact)
	self._foot:set_visible(not compact)
	self._panel:set_padding(if compact then 14 else 22, if compact then 10 else 20, if compact then 14 else 22, if compact then 10 else 20)
	self._v:set_separation(if compact then 8 else 12)
	self._odds_box:set_separation(if compact then 1 else 3)
	for _, l in self._odds_labels do
		l:set_font_size(if compact then 11 else 12)
	end
	self._crate_title:set_font_size(if compact then 13 else 16)
	self._crate_sub:set_font_size(if compact then 11 else 12)
	self._crate_sub:set_min_size(Vector2.new(cw - 32, 0))
	self._note:set_min_size(Vector2.new(cw - 32, 0))
	self._buy:set_min_size(Vector2.new(cw - 32, if compact then 40 else 48))
	self._buy3:set_min_size(Vector2.new(cw - 32, if compact then 34 else 42))
	self._buy3:set_font_size(if compact then 12 else 13)
	self._buy10:set_min_size(Vector2.new(cw - 32, if compact then 34 else 42))
	self._buy10:set_font_size(if compact then 12 else 13)
	self._crate_v:set_separation(if compact then 5 else 8)
	local gw = math.clamp(area.Width - cw - 110, 300, Locker.GRID_SIZE.X)
	local gh = math.clamp(area.Height - (if compact then 120 else 170), 120, Locker.GRID_SIZE.Y)
	self._host:set_min_size(Vector2.new(gw, gh))
	-- still taller than the screen (a short phone): the grid gives up what it can, then the card its
	-- note (the price is on the button), then the 3-crate button, then the 10-crate one
	self._tight = 0
	self._note:set_visible(true)
	if self.is_open then
		self:_refresh_crate()
	end
	local function over(): number
		return self._panel:get_combined_minimum_size().Y - (area.Height - 4)
	end
	if over() > 0 then
		self._host:set_min_size(Vector2.new(gw, math.max(100, gh - over())))
	end
	if compact and over() > 0 then
		self._tight = 1
		self._note:set_visible(false)
	end
	if compact and over() > 0 then
		self._tight = 2
		self._buy3:set_visible(false)
	end
	if compact and over() > 0 then
		self._tight = 3
		self._buy10:set_visible(false)
	end
	if self.is_open then
		self:_refresh_crate()
		self:_rebuild()
	end
	self:_center()
end

function Locker._center(self)
	local ctx = self.ctx
	local area = ctx:clear_rect()
	for _, pn in { self._panel } do
		local sz = pn:get_combined_minimum_size()
		local p = area.Min + (Vector2.new(area.Width, area.Height) - sz) * 0.5
		local y = math.max(p.Y, area.Min.Y + 4.0)
		local rp = Vector2.new(math.floor(p.X + 0.5), math.floor(y + 0.5))
		pn:set_offsets(rp.X, rp.Y, rp.X, rp.Y)
		pn:reset_size()
	end
end

return Locker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="206">
            <Properties>
              <string name="Name">MapPicker</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Map picker (the single-player map list): a modal grid of map cards (thumbnail, name, size) under
-- category tabs. The footer names the public-domain data the World map is made from. The grid is a Roblox
-- ScrollingFrame with a UIGridLayout hosted in a kit Control (the kit has no scroll container); card
-- sizes follow UITheme.scale.
-- Signals: picked(map_id), closed.
-- Entries come from set_entries({ {id, name, width, height, categories, thumb}, ... }).

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local Signal = UITheme.core("Signal")

local MapPicker = W.class(W.Control)

--- Tabs: { label, predicate on the categories set }.
MapPicker.TABS = {
	{ "Featured", { featured = true } },
	{ "World", { world = true, continental = true } },
	{ "Europe", { europe = true } },
	{ "Asia", { asia = true } },
	{ "Americas", { north_america = true, south_america = true } },
	{ "Africa · Oceania", { africa = true, oceania = true, antarctica = true } },
	{ "All", nil },
}
MapPicker.CARD = Vector2.new(168, 132)
MapPicker.GRID_SIZE = Vector2.new(740, 420)
MapPicker.ATTRIBUTION = "Made with Natural Earth and NOAA ETOPO1 data (public domain)"

function MapPicker.new(c: any)
	local self = setmetatable({}, MapPicker.__mt)
	W.Control._init(self)
	self.ctx = c
	self.picked = Signal.new()
	self.closed = Signal.new()
	self.is_open = false
	self.entries = {} :: { any }
	self.selected = ""
	self._tab = 1
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	self:set_visible(false)
	self._dim = W.ColorRect.new(UITheme.rgba(0.01, 0.015, 0.05, 0.6))
	self._dim:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._dim.gui_input:Connect(function(e)
		-- (a press on the window's own ground reaches the dim too: only one outside it closes)
		if e.pressed and not self._panel:has_global_point(e.global_position) then
			self:close()
		end
	end)
	self:add_child(self._dim)
	self._panel = GlassPanel.new(22.0, 20.0, 18, true, 34)
	self._panel:set_tint(UITheme.rgba(0.045, 0.065, 0.13, 0.95))
	self:add_child(self._panel)
	local v = UITheme.vbox(12)
	self._panel:add_child(v)
	-- head: title + close
	local head = UITheme.hbox(10)
	local title = UITheme.label("CHOOSE A MAP", 20, 800, UITheme.TEXT, 3)
	title.size_flags_horizontal = W.EXPAND_FILL
	title.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(title)
	local close = W.Button.new("", "GhostButton")
	close:set_icon("close")
	close.expand_icon = true
	close:set_min_size(Vector2.new(34, 34))
	close:add_theme_constant_override("icon_max_width", 13)
	close:add_theme_stylebox_override("normal", UITheme.empty_box(8, 8))
	close:add_theme_stylebox_override("hover", UITheme.flat(UITheme.FILL, 8, UITheme.CLEAR, 0, 8, 8))
	close.size_flags_vertical = W.SHRINK_CENTER
	close.pressed:Connect(function()
		self:close()
	end)
	head:add_child(close)
	v:add_child(head)
	-- tabs
	local tabs = UITheme.hbox(6)
	self._tabs = {}
	for i, t in ipairs(MapPicker.TABS) do
		local chip = UITheme.button(t[1], "ChipButton", "", 32.0)
		chip.toggle_mode = true
		chip:set_font_size(12)
		chip:set_pressed_no_signal(i == self._tab)
		chip.pressed:Connect(function()
			self._tab = i
			for j, ch in ipairs(self._tabs) do
				ch:set_pressed_no_signal(j == i)
			end
			self:_rebuild()
		end)
		table.insert(self._tabs, chip)
		tabs:add_child(chip)
	end
	v:add_child(tabs)
	-- grid host
	local host = W.Control.new()
	host:set_min_size(MapPicker.GRID_SIZE)
	host:set_mouse_filter(W.MOUSE_PASS)
	self._host = host
	v:add_child(host)
	local sf = Instance.new("ScrollingFrame")
	sf.Name = "MapGrid"
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.Size = UDim2.fromScale(1, 1)
	sf.ScrollBarThickness = 6
	sf.ScrollBarImageColor3 = Color3.new(1, 1, 1)
	sf.ScrollBarImageTransparency = 0.6
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.CanvasSize = UDim2.new(0, 0, 0, 0)
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	sf.ZIndex = 40
	sf.Parent = host.gui
	host:_part(sf, "ScrollBarImageTransparency", 0.4)
	self._sf = sf
	local grid = Instance.new("UIGridLayout")
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = sf
	self._grid = grid
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 2)
	pad.PaddingLeft = UDim.new(0, 2)
	pad.Parent = sf
	-- footer
	self._foot = UITheme.label(MapPicker.ATTRIBUTION, 11, 500, UITheme.TEXT_3)
	v:add_child(self._foot)
	self._cards = {} :: { [string]: TextButton }
	return self
end

function MapPicker.set_entries(self, entries: { any })
	self.entries = entries or {}
	if self.is_open then
		self:_rebuild()
	end
end

local function in_tab(e: any, set: { [string]: boolean }?): boolean
	if set == nil then
		return true
	end
	for _, c in e.categories or {} do
		if set[c] then
			return true
		end
	end
	return false
end

function MapPicker._card(self, e: any, order: number): TextButton
	local s = UITheme.scale
	local b = Instance.new("TextButton")
	b.Name = e.id
	b.Text = ""
	b.AutoButtonColor = false
	b.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	b.BackgroundTransparency = 0.94
	b.LayoutOrder = order
	b.ZIndex = 41
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, math.floor(10 * s))
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Transparency = 0.88
	stroke.Thickness = 1
	stroke.Parent = b
	local img = Instance.new("ImageLabel")
	img.Name = "Thumb"
	img.BackgroundTransparency = 1
	img.Image = e.thumb or ""
	img.ScaleType = Enum.ScaleType.Fit
	img.Position = UDim2.fromOffset(math.floor(8 * s), math.floor(8 * s))
	img.Size = UDim2.new(1, -math.floor(16 * s), 1, -math.floor(46 * s))
	img.ZIndex = 42
	img.Parent = b
	local name = Instance.new("TextLabel")
	name.Name = "MapName"
	name.BackgroundTransparency = 1
	name.FontFace = Font.fromId(12187365977, Enum.FontWeight.Bold)
	name.TextSize = math.floor(14 * s)
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextTruncate = Enum.TextTruncate.AtEnd
	name.Text = e.name or e.id
	name.Position = UDim2.new(0, math.floor(8 * s), 1, -math.floor(36 * s))
	name.Size = UDim2.new(1, -math.floor(16 * s), 0, math.floor(18 * s))
	name.TextXAlignment = Enum.TextXAlignment.Left
	name.ZIndex = 42
	name.Parent = b
	local sub = Instance.new("TextLabel")
	sub.Name = "Size"
	sub.BackgroundTransparency = 1
	sub.FontFace = Font.fromId(12187365977, Enum.FontWeight.Medium)
	sub.TextSize = math.floor(11 * s)
	sub.TextColor3 = Color3.fromRGB(170, 180, 205)
	sub.Text = if e.width and e.height then string.format("%d × %d", e.width, e.height) else ""
	sub.Position = UDim2.new(0, math.floor(8 * s), 1, -math.floor(18 * s))
	sub.Size = UDim2.new(1, -math.floor(16 * s), 0, math.floor(14 * s))
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.ZIndex = 42
	sub.Parent = b
	-- Every piece is a part of the grid host, so the panel's pop-in / fade-out reaches the cards
	-- (raw instances showed at full strength before the panel did).
	local host = self._host
	host:_part(b, "BackgroundTransparency", 0.06)
	host:_part(stroke, "Transparency", 0.12)
	host:_part(img, "ImageTransparency", 1.0)
	host:_part(name, "TextTransparency", 1.0)
	host:_part(sub, "TextTransparency", 1.0)
	b.MouseEnter:Connect(function()
		host:_part(b, "BackgroundTransparency", 0.12)
	end)
	b.MouseLeave:Connect(function()
		host:_part(b, "BackgroundTransparency", 0.06)
	end)
	b.Activated:Connect(function()
		self.selected = e.id
		self.ctx:sfx("click")
		self.picked:Fire(e.id)
		self:close()
	end)
	b.Parent = self._sf
	return b
end

function MapPicker._rebuild(self)
	for _, b in self._cards do
		self._host:_drop_part(b)
		for _, d in b:GetDescendants() do
			self._host:_drop_part(d)
		end
		b:Destroy()
	end
	table.clear(self._cards)
	local s = UITheme.scale
	self._grid.CellSize = UDim2.fromOffset(math.floor(MapPicker.CARD.X * s), math.floor(MapPicker.CARD.Y * s))
	self._grid.CellPadding = UDim2.fromOffset(math.floor(10 * s), math.floor(10 * s))
	local set = MapPicker.TABS[self._tab][2]
	local list = {}
	for _, e in self.entries do
		if in_tab(e, set) then
			table.insert(list, e)
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = a.featured_rank or 999, b.featured_rank or 999
		if ra ~= rb then
			return ra < rb
		end
		return (a.name or a.id) < (b.name or b.id)
	end)
	for i, e in list do
		local b = self:_card(e, i)
		if e.id == self.selected then
			local st = b:FindFirstChildOfClass("UIStroke") :: UIStroke
			st.Color = UITheme.color3(UITheme.to_rgba(UITheme.AMBER))
			self._host:_part(st, "Transparency", 1.0)
			st.Thickness = 2
		end
		self._cards[e.id] = b
	end
	self._sf.CanvasPosition = Vector2.zero
end

function MapPicker.open(self, selected: string?)
	if self.is_open then
		return
	end
	self.is_open = true
	self.selected = selected or self.selected
	-- open on the tab that shows the selected map
	self._tab = #MapPicker.TABS
	for i, t in ipairs(MapPicker.TABS) do
		for _, e in self.entries do
			if e.id == self.selected and in_tab(e, t[2]) then
				self._tab = i
				break
			end
		end
		if self._tab == i then
			break
		end
	end
	for j, ch in ipairs(self._tabs) do
		ch:set_pressed_no_signal(j == self._tab)
	end
	self:_rebuild()
	self:set_visible(true)
	self._panel:set_modulate_a(1.0)
	self:_center()
	self._dim:set_modulate_a(0.0)
	W.fade(self._dim, 1.0, 0.2)
	UICtx.pop_in(self._panel, 0.0, 0.94, 0.3)
	self.ctx:sfx("open")
end

function MapPicker.close(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	self.ctx:sfx("close")
	local t = self:create_tween():set_parallel(true)
	t:tween_property(self._dim, "modulate:a", 0.0, 0.15)
	t:tween_property(self._panel, "modulate:a", 0.0, 0.15)
	t:chain():tween_callback(function()
		if not self.is_open then
			self:set_visible(false)
		end
	end)
	self.closed:Fire()
end

function MapPicker.apply_layout(self)
	local ctx = self.ctx
	local area = ctx:clear_rect()
	-- the grid takes what the screen allows (phones: fewer columns / rows)
	local gw = math.clamp(area.Width - 80, 360, MapPicker.GRID_SIZE.X)
	local gh = math.clamp(area.Height - 190, 200, MapPicker.GRID_SIZE.Y)
	self._host:set_min_size(Vector2.new(gw, gh))
	if self.is_open then
		self:_rebuild()
	end
	self:_center()
end

function MapPicker._center(self)
	local ctx = self.ctx
	local sz = self._panel:get_combined_minimum_size()
	local area = ctx:clear_rect()
	local p = area.Min + (Vector2.new(area.Width, area.Height) - sz) * 0.5
	local y = math.max(p.Y, area.Min.Y + 4.0)
	local rp = Vector2.new(math.floor(p.X + 0.5), math.floor(y + 0.5))
	self._panel:set_offsets(rp.X, rp.Y, rp.X, rp.Y)
	self._panel:reset_size()
end

return MapPicker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="207">
            <Properties>
              <string name="Name">PartyPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The party on the title screen (server/Party; team games on: Rofront Staging only for now). Who is
-- in it (the leader picks the public match and everyone goes with them; a team game puts them on one
-- team), the invites to answer, and an invite list: the players on this server, and a Roblox invite
-- for friends elsewhere (accepting it brings them to this server).
--   PartyPanel.new(ctx) · set_state(state) · apply_layout() · on_action = function(action, user_id?)
-- Phones: a PARTY button that opens and closes the panel.

local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")
local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local Scroll = (require("./HelpOverlay") :: any).Scroll

local PartyPanel = W.class(W.Control)

PartyPanel.WIDTH = 250.0
--- More members than this show in two columns, the panel this wide (parties of up to 8 since
--- 2026-11-01: eight rows ran past a phone's screen).
PartyPanel.ONE_COLUMN_MAX = 4
PartyPanel.WIDTH_WIDE = 360.0
--- An invite button shows SENT this long.
PartyPanel.SENT_S = 3.0
--- The invite list's rows (px) and what the list leaves of the screen's height for its head, the Roblox
--- invite and the padding: the rows scroll in the rest (a full server is 30+ players; 2026-10-10: the
--- party invite menu overflowed and did not scroll).
PartyPanel.ROW_H = 34.0
PartyPanel.ROW_GAP = 6.0
PartyPanel.LIST_CHROME = 190.0
PartyPanel.LIST_CHROME_COMPACT = 165.0
--- Dev only (Dev/SessionDiag "party fake"): stand-ins for the server's players, to see a full list.
PartyPanel.fake_players = nil :: { any }?

function PartyPanel.new(c: any)
	local self = setmetatable({}, PartyPanel.__mt)
	W.Control._init(self)
	local T = UITheme
	self.ctx = c
	self.state = nil
	self.on_action = nil
	self._open = false
	self._sent = {}
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)

	-- the panel
	local p = GlassPanel.new(14.0, 12.0, 14, true, 24)
	self._panel = p
	self:add_child(p)
	local v = T.vbox(8)
	p:add_child(v)
	local head = T.hbox(8)
	local ic = T.icon_rect("users", 18.0, T.CYAN)
	ic.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(ic)
	local title = T.label("PARTY", 14, 800, T.TEXT, 2)
	title.size_flags_horizontal = W.EXPAND_FILL
	title.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(title)
	self._count = T.label("", 12, 600, T.TEXT_2)
	self._count.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(self._count)
	v:add_child(head)
	self._members = T.hbox(12)
	v:add_child(self._members)
	self._invites = T.vbox(6)
	v:add_child(self._invites)
	self._hint = T.label("", 11, 500, T.TEXT_2)
	self._hint:set_autowrap(true)
	self._hint:set_min_size(Vector2.new(PartyPanel.WIDTH - 28, 0))
	v:add_child(self._hint)
	local btns = T.hbox(8)
	self._invite_btn = T.button("INVITE", "GlassButton", "users", 36.0)
	self._invite_btn:set_font_size(12)
	self._invite_btn:add_theme_constant_override("icon_max_width", 14)
	self._invite_btn.size_flags_horizontal = W.EXPAND_FILL
	self._invite_btn.pressed:Connect(function()
		self:open_list()
	end)
	btns:add_child(self._invite_btn)
	self._leave_btn = T.button("LEAVE", "GhostButton", "exit", 36.0)
	self._leave_btn:set_font_size(12)
	self._leave_btn:add_theme_constant_override("icon_max_width", 14)
	self._leave_btn.pressed:Connect(function()
		self:_act("leave")
	end)
	btns:add_child(self._leave_btn)
	v:add_child(btns)

	-- phones: the button that opens / closes the panel
	self._pill = T.button("PARTY", "GlassButton", "users", 40.0)
	self._pill:set_font_size(12)
	self._pill:add_theme_constant_override("icon_max_width", 16)
	self._pill.pressed:Connect(function()
		self._open = not self._open
		self:apply_layout()
	end)
	self:add_child(self._pill)

	-- the invite list
	local lp = GlassPanel.new(16.0, 14.0, 16, true, 40)
	self._list = lp
	self:add_child(lp)
	local lv = T.vbox(10)
	lp:add_child(lv)
	local lh = T.hbox(10)
	local lic = T.icon_rect("users", 20.0, T.CYAN)
	lic.size_flags_vertical = W.SHRINK_CENTER
	lh:add_child(lic)
	local lt = T.label("INVITE TO PARTY", 16, 800, T.TEXT, 2)
	lt.size_flags_horizontal = W.EXPAND_FILL
	lt.size_flags_vertical = W.SHRINK_CENTER
	lh:add_child(lt)
	local close = T.button("", "GhostButton", "close", 40.0)
	close.expand_icon = true
	close.icon_alignment = W.ALIGN_CENTER
	close:add_theme_constant_override("icon_max_width", 14)
	close:set_min_size(Vector2.new(40, 40))
	close.pressed:Connect(function()
		self:close_list()
	end)
	lh:add_child(close)
	lv:add_child(lh)
	self._roblox_btn = T.button("INVITE ROBLOX FRIENDS", "PrimaryButton", "users", 42.0)
	self._roblox_btn:set_font_size(13)
	self._roblox_btn:add_theme_constant_override("icon_max_width", 16)
	self._roblox_btn.pressed:Connect(function()
		-- (a friend who accepts lands on this server, where the party can take them in)
		pcall(function()
			SocialService:PromptGameInvite(Players.LocalPlayer)
		end)
	end)
	lv:add_child(self._roblox_btn)
	local note = T.label("Friends who accept join you on this server.", 11, 500, T.TEXT_3)
	note:set_alignment(W.ALIGN_CENTER)
	self._note = note
	lv:add_child(note)
	self._list_caption = T.caption("On this server", 11, T.TEXT_2)
	lv:add_child(self._list_caption)
	self._list_empty = T.label("Nobody else is on this server yet.", 12, 500, T.TEXT_2)
	lv:add_child(self._list_empty)
	-- the players scroll once they no longer fit on screen (friends first)
	self._list_scroll = Scroll.new()
	self._list_rows = T.vbox(PartyPanel.ROW_GAP)
	self._list_rows.size_flags_horizontal = W.EXPAND_FILL
	local inner = T.hbox(0)
	inner:add_child(self._list_rows)
	-- (room for the scroll bar on the right)
	local gutter = W.Control.new()
	gutter:set_mouse_filter(W.MOUSE_IGNORE)
	gutter:set_min_size(Vector2.new(10, 0))
	inner:add_child(gutter)
	self._list_scroll:add_child(inner)
	lv:add_child(self._list_scroll)
	--- user id → whether the local player is friends with them (asked once each, in the background)
	self._friends = {} :: { [number]: boolean }
	self._asking = {} :: { [number]: boolean }
	lp:set_visible(false)

	self._conns = {
		Players.PlayerAdded:Connect(function()
			if self._list.visible then
				self:_refresh_list()
			end
		end),
		Players.PlayerRemoving:Connect(function()
			if self._list.visible then
				task.defer(function()
					self:_refresh_list()
				end)
			end
		end),
	}
	self:set_visible(false)
	return self
end

function PartyPanel._act(self, action: string, user_id: number?)
	if self.on_action ~= nil then
		self.on_action(action, user_id)
	end
	self.ctx:sfx("click")
end

local function clear(box)
	for _, ch in ipairs(box:get_children()) do
		box:remove_child(ch)
		ch:queue_free()
	end
end

--- The party as the server sees it (server/Party.state), or nil (parties off: hidden).
function PartyPanel.set_state(self, st: any)
	self.state = st
	self:set_visible(st ~= nil)
	if st == nil then
		return
	end
	local T = UITheme
	local me = Players.LocalPlayer.UserId
	local members = if type(st.members) == "table" then st.members else {}
	local leader = st.leader == true
	clear(self._members)
	local columns = if #members > PartyPanel.ONE_COLUMN_MAX then 2 else 1
	self._wide = columns > 1
	local per_column = math.ceil(#members / columns)
	local cols = {}
	for c = 1, columns do
		cols[c] = T.vbox(4)
		cols[c].size_flags_horizontal = W.EXPAND_FILL
		self._members:add_child(cols[c])
	end
	for i, m in members do
		local row = T.hbox(6)
		-- (rows with and without a kick button line up across the columns)
		row:set_min_size(Vector2.new(0, 26))
		local crown = T.icon_rect(if m.leader then "crown" else "users", 14.0, if m.leader then T.AMBER else T.TEXT_3)
		crown.size_flags_vertical = W.SHRINK_CENTER
		row:add_child(crown)
		local nm = T.label(tostring(m.name) .. (if m.uid == me then "  (you)" else ""), 13, 600, T.TEXT)
		nm.text_overrun_behavior = W.OVERRUN_ELLIPSIS
		nm.clip_text = true
		nm.size_flags_horizontal = W.EXPAND_FILL
		nm.size_flags_vertical = W.SHRINK_CENTER
		row:add_child(nm)
		if leader and m.uid ~= me then
			local kick = T.button("", "GhostButton", "close", 26.0)
			kick.expand_icon = true
			kick.icon_alignment = W.ALIGN_CENTER
			kick:add_theme_constant_override("icon_max_width", 10)
			kick:set_min_size(Vector2.new(26, 26))
			kick.pressed:Connect(function()
				self:_act("kick", m.uid)
			end)
			row:add_child(kick)
		end
		cols[(i - 1) // per_column + 1]:add_child(row)
	end
	clear(self._invites)
	for _, inv in if type(st.invites) == "table" then st.invites else {} do
		local box = T.vbox(4)
		local who = T.label(tostring(inv.name) .. " invited you", 12, 600, T.CYAN)
		who.text_overrun_behavior = W.OVERRUN_ELLIPSIS
		who.clip_text = true
		box:add_child(who)
		local row = T.hbox(6)
		local yes = T.button("JOIN", "PrimaryButton", "check", 32.0)
		yes:set_font_size(12)
		yes:add_theme_constant_override("icon_max_width", 12)
		yes.size_flags_horizontal = W.EXPAND_FILL
		yes.pressed:Connect(function()
			self:_act("accept", inv.uid)
		end)
		row:add_child(yes)
		local no = T.button("NO", "GhostButton", "close", 32.0)
		no:set_font_size(12)
		no:add_theme_constant_override("icon_max_width", 10)
		no.pressed:Connect(function()
			self:_act("decline", inv.uid)
		end)
		row:add_child(no)
		box:add_child(row)
		self._invites:add_child(box)
	end
	local n = #members
	local max = tonumber(st.max) or 4
	self._count:set_text(if n >= 2 then ("%d / %d"):format(n, max) else "")
	self._leave_btn:set_visible(n >= 2)
	self._invite_btn:set_disabled(n >= max)
	self._hint:set_text(
		if n < 2
			then "Play public matches with friends: in a team game you're on the same team."
			elseif leader then "You pick the match. Your party comes with you."
			else "Your party leader picks the match."
	)
	self._pill:set_text(if n >= 2 then ("PARTY  %d"):format(n) elseif #self._invites:get_children() > 0 then "PARTY  •" else "PARTY")
	if #self._invites:get_children() > 0 then
		-- an invite to answer: phones open the panel
		self._open = true
	end
	if self._list.visible then
		self:_refresh_list()
	end
	self:apply_layout()
end

function PartyPanel.open_list(self)
	-- (phones: the list takes the small panel's place)
	if self.ctx.compact then
		self._open = false
	end
	-- (placed first: the rows' scroll height depends on where the list starts)
	self:apply_layout()
	self._list:set_visible(true)
	self:_refresh_list()
	W.pop_in(self._list, 0.0, 0.94, 0.25)
	self.ctx:sfx("open")
end

function PartyPanel.close_list(self)
	if self._list.visible then
		self._list:set_visible(false)
		self.ctx:sfx("close")
	end
end

--- The players on this server who could be invited (not already in the party).
function PartyPanel._refresh_list(self)
	local T = UITheme
	clear(self._list_rows)
	local inside = {}
	for _, m in if self.state and type(self.state.members) == "table" then self.state.members else {} do
		inside[m.uid] = true
	end
	local me = Players.LocalPlayer
	local shown = 0
	local now = os.clock()
	local list = {}
	for _, p in PartyPanel.fake_players or Players:GetPlayers() do
		if p ~= me and not inside[p.UserId] then
			table.insert(list, p)
			self:_ask_friend(p.UserId)
		end
	end
	local friends = self._friends
	table.sort(list, function(a, b)
		local fa, fb = friends[a.UserId] == true, friends[b.UserId] == true
		if fa ~= fb then
			return fa
		end
		return string.lower(a.DisplayName) < string.lower(b.DisplayName)
	end)
	for _, p in list do
		shown += 1
		local row = T.hbox(8)
		local friend = friends[p.UserId] == true
		local nm = T.label(
			(if p.DisplayName ~= "" then p.DisplayName else p.Name) .. (if friend then "  · friend" else ""),
			13,
			600,
			if friend then T.CYAN else T.TEXT
		)
		nm.text_overrun_behavior = W.OVERRUN_ELLIPSIS
		nm.clip_text = true
		nm.size_flags_horizontal = W.EXPAND_FILL
		nm.size_flags_vertical = W.SHRINK_CENTER
		nm:set_min_size(Vector2.new(150, 0))
		row:add_child(nm)
		local sent = self._sent[p.UserId] ~= nil and now - self._sent[p.UserId] < PartyPanel.SENT_S
		local b = T.button(if sent then "SENT" else "INVITE", if sent then "GhostButton" else "GlassButton", "", 34.0)
		b:set_font_size(12)
		b:set_min_size(Vector2.new(84, 34))
		b:set_disabled(sent)
		local uid = p.UserId
		b.pressed:Connect(function()
			self._sent[uid] = os.clock()
			self:_act("invite", uid)
			self:_refresh_list()
			task.delay(PartyPanel.SENT_S + 0.1, function()
				if self._list.visible then
					self:_refresh_list()
				end
			end)
		end)
		row:add_child(b)
		self._list_rows:add_child(row)
	end
	self._list_empty:set_visible(shown == 0)
	self._list_caption:set_visible(shown > 0)
	-- as tall as the rows, never past the screen
	local ctx = self.ctx
	local rows_h = if shown > 0 then shown * PartyPanel.ROW_H + (shown - 1) * PartyPanel.ROW_GAP else 0.0
	local room = if ctx.vp ~= nil
		then ctx:clear_rect().Max.Y
			- (self._list_top or 60.0)
			- 8.0
			- (if ctx.compact then PartyPanel.LIST_CHROME_COMPACT else PartyPanel.LIST_CHROME)
		else 300.0
	self._list_scroll:set_visible(shown > 0)
	self._list_scroll:set_min_size(Vector2.new(0, math.max(PartyPanel.ROW_H, math.min(rows_h, room))))
	self._list:reset_size()
end

--- Asks once (in the background) whether the local player is friends with `uid`; the list puts friends
--- first once it knows.
function PartyPanel._ask_friend(self, uid: number)
	if self._friends[uid] ~= nil or self._asking[uid] then
		return
	end
	self._asking[uid] = true
	task.spawn(function()
		local ok, yes = pcall(function()
			return Players.LocalPlayer:IsFriendsWith(uid)
		end)
		self._asking[uid] = nil
		self._friends[uid] = ok and yes == true
		if ok and yes == true and self._list.visible and not self._resort then
			-- (one re-sort for a burst of answers)
			self._resort = true
			task.delay(0.3, function()
				self._resort = false
				if self._list.visible then
					self:_refresh_list()
				end
			end)
		end
	end)
end

function PartyPanel.apply_layout(self)
	local ctx = self.ctx
	if ctx.vp == nil then
		return
	end
	local compact = ctx.compact
	local p, pill = self._panel, self._pill
	local x = 12.0 + ctx.insets.x
	local width = if self._wide then PartyPanel.WIDTH_WIDE else PartyPanel.WIDTH
	p:set_min_size(Vector2.new(width, 0))
	self._hint:set_min_size(Vector2.new(width - 28, 0))
	pill:set_visible(compact)
	if compact then
		-- phones: the PARTY button under the top bar on the left; the panel under it while open
		local y = math.max(ctx.reserved_top_left.Max.Y, 44.0) + 6.0 + ctx.insets.y
		pill:set_anchors(0, 0, 0, 0)
		pill:set_offsets(x, y, x + 120, y + 40)
		p:set_visible(self._open)
		p.anchor_left, p.anchor_right, p.anchor_top, p.anchor_bottom = 0, 0, 0, 0
		p.grow_horizontal = W.GROW_END
		p.grow_vertical = W.GROW_END
		p.offset_left, p.offset_right = x, x
		p.offset_top, p.offset_bottom = y + 46, y + 46
	else
		-- desktop: on the left, halfway down
		p:set_visible(true)
		p.anchor_left, p.anchor_right, p.anchor_top, p.anchor_bottom = 0, 0, 0.5, 0.5
		p.grow_horizontal = W.GROW_END
		p.grow_vertical = W.GROW_BOTH
		p.offset_left, p.offset_right = x + 4.0, x + 4.0
		p.offset_top, p.offset_bottom = 0, 0
	end
	p:reset_size()
	-- the invite list: under the top bar row (its buttons draw above our layer), growing down, its rows
	-- scrolling in what the screen leaves (_refresh_list)
	local lp = self._list
	local clear = ctx:clear_rect()
	local top = math.max(clear.Min.Y + 8.0, if compact then 0.0 else ctx.vp.Y * 0.1)
	self._list_top = top
	-- (phones: no note line and a shorter button, so more rows fit)
	self._note:set_visible(not compact)
	self._roblox_btn:set_min_size(Vector2.new(0, if compact then 36 else 42))
	lp:set_min_size(Vector2.new(if compact then math.min(360, ctx.vp.X - 24) else 380, 0))
	lp.anchor_left, lp.anchor_right, lp.anchor_top, lp.anchor_bottom = 0.5, 0.5, 0, 0
	lp.grow_horizontal = W.GROW_BOTH
	lp.grow_vertical = W.GROW_END
	lp.offset_left, lp.offset_right, lp.offset_top, lp.offset_bottom = 0, 0, top, top
	lp:reset_size()
	if lp.visible then
		-- (the screen changed: the rows' room too)
		self:_refresh_list()
	end
end

function PartyPanel.destroy_conns(self)
	for _, c in self._conns do
		c:Disconnect()
	end
end

return PartyPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="208">
            <Properties>
              <string name="Name">PauseMenu</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/pause_menu.gd (UIPauseMenu)
-- Game menu: resume, how to play, settings, and leave / surrender with a confirmation step.
--
-- The same window has a second page, SETTINGS (2026-10-07, with a new switch to turn off the
-- pop expansion sound): the music, border pop, territory label and
-- "select before attacking" switches and "Show tips again", which stood in the game menu itself
-- before. The top bar's gear opens the window on that page (on the title too); the game menu's
-- Settings row turns to it, and DONE turns back.

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local Signal = UITheme.core("Signal")
local Defs = UICtx.core("Defs")
local UserInputService = game:GetService("UserInputService")

local PauseMenu = W.class(W.Control)

-- =============================================================================================
-- Switch (a row button with an animated toggle on the right)
-- =============================================================================================

local Switch = W.class(W.Button)
PauseMenu.Switch = Switch

function Switch.new(text: string, icon_name: string)
	local self = setmetatable({}, Switch.__mt)
	W.Control._init(self, "TextButton")
	W.Button._init_button(self, "", "GlassButton")
	self.on = false
	self._k = 0.0
	self:set_min_size(Vector2.new(0, 46))
	local normal = UITheme.flat(UITheme.rgba(1, 1, 1, 0.04), 10, UITheme.rgba(1, 1, 1, 0.08), 1)
	local hover = UITheme.flat(UITheme.rgba(1, 1, 1, 0.07), 10, UITheme.rgba(1, 1, 1, 0.08), 1)
	self:add_theme_stylebox_override("normal", normal)
	self:add_theme_stylebox_override("pressed", normal)
	self:add_theme_stylebox_override("disabled", normal)
	self:add_theme_stylebox_override("hover", hover)
	self:add_theme_stylebox_override("hover_pressed", hover)
	local h = UITheme.hbox(12)
	h:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	h.offset_left = 14.0
	h.offset_right = -70.0
	self:add_child(h)
	local ic = UITheme.icon_rect(icon_name, 18.0, UITheme.TEXT_2)
	ic.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(ic)
	local l = UITheme.label(text, 14, 600)
	l.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(l)
	-- Track + knob (drawn parts).
	local track = Instance.new("Frame")
	track.Name = "Track"
	track.BorderSizePixel = 0
	track.AnchorPoint = Vector2.new(1, 0.5)
	track.ZIndex = 6
	track.Parent = self.gui
	self._track_corner = Instance.new("UICorner")
	self._track_corner.Parent = track
	self._track = track
	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.BorderSizePixel = 0
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.ZIndex = 7
	knob.Parent = self.gui
	local kc = Instance.new("UICorner")
	kc.CornerRadius = UDim.new(0.5, 0)
	kc.Parent = knob
	self._knob = knob
	self:_part(knob, "BackgroundTransparency", 1.0)
	self.pressed:Connect(function()
		self:set_on(not self.on)
	end)
	self:_draw_switch()
	return self
end

function Switch.set_on(self, v: boolean)
	self.on = v
	self:set_process(true)
end

function Switch._process(self, delta: number)
	local target = if self.on then 1.0 else 0.0
	if math.abs(self._k - target) > 1e-4 then
		self._k = Defs.move_toward(self._k, target, delta * 8.0)
		self:_draw_switch()
	else
		self:set_process(false)
	end
end

function Switch._draw(self)
	self:_draw_switch()
end

function Switch._draw_switch(self)
	local s = UITheme.scale
	local k = self._k
	local tw, th = 40.0, 22.0
	local track = self._track
	track.Position = UDim2.new(1, -math.floor(14 * s + 0.5), 0.5, 0)
	track.Size = UDim2.fromOffset(math.floor(tw * s + 0.5), math.floor(th * s + 0.5))
	self._track_corner.CornerRadius = UDim.new(0, math.floor(11 * s + 0.5))
	local col = UITheme.lerp(UITheme.rgba(1, 1, 1, 0.14), UITheme.to_rgba(UITheme.AMBER), k)
	track.BackgroundColor3 = UITheme.color3(col)
	self:_part(track, "BackgroundTransparency", UITheme.alpha(col))
	local kx = (-14 - tw + 11) + (tw - 22) * k
	self._knob.Position = UDim2.new(1, math.floor(kx * s + 0.5), 0.5, 0)
	self._knob.Size = UDim2.fromOffset(math.floor(16 * s + 0.5), math.floor(16 * s + 0.5))
end

-- =============================================================================================
-- VolumeRow (a row like a Switch with a slider on the right: the music's level)
-- =============================================================================================

--- A music volume slider (2026-10-21). It began as a Music switch with a Volume row under it; two rows
--- were one too many, so it is one row as a Switch's
--- (icon and label on the left), with Tribes' slider on the right: a track and the value in a fixed column.
--- Tap or drag the track (the grab area is the row's right part, its full height), or the mouse wheel over
--- the row; `changed(v, final)`: v in 0..1, final once the finger lifts (save then).
local VolumeRow = W.class(W.Control)
PauseMenu.VolumeRow = VolumeRow
--- Logical px: the room the icon and label keep on the left, the gap at the right, the value's column,
--- the gap before it, and the track's limits (it takes the room left between).
VolumeRow.LEFT_W = 112.0
VolumeRow.RIGHT = 14.0
VolumeRow.PCT_W = 40.0
VolumeRow.GAP = 10.0
VolumeRow.TRACK_MIN = 80.0
VolumeRow.TRACK_MAX = 170.0
--- A wheel notch moves it this much.
VolumeRow.WHEEL_STEP = 0.05

local FONT_PCT = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Bold)

function VolumeRow.new(text: string, icon_name: string)
	local self = setmetatable({}, VolumeRow.__mt)
	W.Control._init(self)
	self.gui.Name = "MusicVolume"
	--- (set by the menu: a tick as the value steps)
	self.ctx = nil :: any
	self.value = 1.0
	self.changed = Signal.new()
	self._drag = false
	self:set_min_size(Vector2.new(0, 46))
	self:set_mouse_filter(W.MOUSE_STOP)
	local g = self.gui
	local bg = Instance.new("Frame")
	bg.Name = "Bg"
	bg.BorderSizePixel = 0
	bg.BackgroundColor3 = Color3.new(1, 1, 1)
	bg.Size = UDim2.fromScale(1, 1)
	bg.ZIndex = 4
	bg.Parent = g
	self._bg_corner = Instance.new("UICorner")
	self._bg_corner.Parent = bg
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Parent = bg
	-- (a Switch's look: 4% white, 7% under the mouse, a 8% line)
	self:_part(bg, "BackgroundTransparency", 0.04)
	self:_part(stroke, "Transparency", 0.08)
	self:_connect(g.MouseEnter:Connect(function()
		self:_part(bg, "BackgroundTransparency", 0.07)
	end))
	self:_connect(g.MouseLeave:Connect(function()
		self:_part(bg, "BackgroundTransparency", 0.04)
	end))
	local h = UITheme.hbox(12)
	h:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	h.offset_left = 14.0
	h.offset_right = -(VolumeRow.RIGHT + VolumeRow.PCT_W + VolumeRow.GAP + VolumeRow.TRACK_MIN)
	h:set_mouse_filter(W.MOUSE_IGNORE)
	self:add_child(h)
	local ic = UITheme.icon_rect(icon_name, 18.0, UITheme.TEXT_2)
	ic.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(ic)
	local l = UITheme.label(text, 14, 600)
	l.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(l)
	local function part(name: string, z: number): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.new(0, 0.5)
		f.ZIndex = z
		f.Parent = g
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = f
		return f
	end
	self._track = part("VolTrack", 6)
	self._fill = part("VolFill", 7)
	self._knob = part("VolKnob", 8)
	self._knob.AnchorPoint = Vector2.new(0.5, 0.5)
	self._knob.BackgroundColor3 = Color3.new(1, 1, 1)
	local ks = Instance.new("UIStroke")
	ks.Color = Color3.fromRGB(120, 72, 8)
	ks.Thickness = 2
	ks.Parent = self._knob
	self:_part(self._knob, "BackgroundTransparency", 1.0)
	self:_part(ks, "Transparency", 0.9)
	self:_part(self._fill, "BackgroundTransparency", 1.0)
	local pct = Instance.new("TextLabel")
	pct.Name = "VolPct"
	pct.BackgroundTransparency = 1
	pct.AnchorPoint = Vector2.new(1, 0.5)
	pct.FontFace = FONT_PCT
	pct.TextXAlignment = Enum.TextXAlignment.Right
	pct.TextColor3 = UITheme.color3(UITheme.to_rgba(UITheme.TEXT_2))
	pct.Text = "100%"
	pct.ZIndex = 6
	pct.Parent = g
	self:_part(pct, "TextTransparency", 1.0)
	self._pct = pct
	self:_connect(g.InputBegan:Connect(function(io: InputObject)
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			local x = self:_local_x(io)
			if x >= self:_track_x() - 18.0 then
				self._drag = true
				self._drag_input = io
				self:_set_from_x(x, false)
				self:_draw_row()
			end
		end
	end))
	self:_connect(g.InputChanged:Connect(function(io: InputObject)
		if io.UserInputType == Enum.UserInputType.MouseWheel and io.Position.Z ~= 0 then
			local v = math.clamp(self.value + VolumeRow.WHEEL_STEP * math.sign(io.Position.Z), 0.0, 1.0)
			self:_set(math.floor(v * 20 + 0.5) / 20, true)
		end
	end))
	self:_connect(UserInputService.InputChanged:Connect(function(io: InputObject)
		if not self._drag then
			return
		end
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseMovement or (t == Enum.UserInputType.Touch and io == self._drag_input) then
			self:_set_from_x(self:_local_x(io), false)
		end
	end))
	self:_connect(UserInputService.InputEnded:Connect(function(io: InputObject)
		if not self._drag then
			return
		end
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseButton1 or (t == Enum.UserInputType.Touch and io == self._drag_input) then
			self._drag = false
			self._drag_input = nil
			self:_draw_row()
			self.changed:Fire(self.value, true)
		end
	end))
	self:_draw_row()
	return self
end

--- The pointer's x in the row (logical px).
function VolumeRow._local_x(self, io: InputObject): number
	return W.screen_to_logical(W.input_pos(io), self).X - self:get_global_position().X
end

--- The track's width: the room the row leaves after the icon and label and the value (logical px).
function VolumeRow._track_w(self): number
	local room = self.size.X - VolumeRow.LEFT_W - (VolumeRow.RIGHT + VolumeRow.PCT_W + VolumeRow.GAP)
	return math.clamp(room, VolumeRow.TRACK_MIN, VolumeRow.TRACK_MAX)
end

--- The track's left edge in the row (logical px).
function VolumeRow._track_x(self): number
	return self.size.X - VolumeRow.RIGHT - VolumeRow.PCT_W - VolumeRow.GAP - self:_track_w()
end

function VolumeRow._set_from_x(self, x: number, final: boolean)
	local v = math.clamp((x - self:_track_x()) / self:_track_w(), 0.0, 1.0)
	self:_set(math.floor(v * 20 + 0.5) / 20, final) -- (steps of 5%)
end

function VolumeRow._set(self, v: number, final: boolean)
	if v ~= self.value or final then
		if v ~= self.value and self.ctx ~= nil then
			self.ctx:sfx("ui_click", -10.0, 0, 0.8 + v * 0.6) -- (a tick per step, as Tribes', higher as it rises)
		end
		self:set_value(v)
		self.changed:Fire(self.value, final)
	end
end

--- Show `v` (0..1) without firing changed.
function VolumeRow.set_value(self, v: number)
	self.value = math.clamp(tonumber(v) or 1.0, 0.0, 1.0)
	self._pct.Text = string.format("%d%%", math.floor(self.value * 100 + 0.5))
	self:_draw_row()
end

function VolumeRow._on_geometry(self)
	self:_draw_row()
end

function VolumeRow._draw(self)
	self:_draw_row()
end

-- (raw instances in px: logical px x UITheme.scale)
function VolumeRow._draw_row(self)
	local sc = UITheme.scale
	local px = function(v: number): number
		return math.floor(v * sc + 0.5)
	end
	self._bg_corner.CornerRadius = UDim.new(0, px(10))
	local tw = self:_track_w()
	local from_right = VolumeRow.RIGHT + VolumeRow.PCT_W + VolumeRow.GAP + tw
	local th = 6.0
	self._track.Position = UDim2.new(1, -px(from_right), 0.5, 0)
	self._track.Size = UDim2.fromOffset(px(tw), px(th))
	local tcol = UITheme.rgba(1, 1, 1, 0.14)
	self._track.BackgroundColor3 = UITheme.color3(tcol)
	self:_part(self._track, "BackgroundTransparency", UITheme.alpha(tcol))
	local fw = tw * self.value
	self._fill.Visible = fw > 0.5
	self._fill.Position = UDim2.new(1, -px(from_right), 0.5, 0)
	self._fill.Size = UDim2.fromOffset(px(math.max(fw, th)), px(th))
	self._fill.BackgroundColor3 = UITheme.color3(UITheme.to_rgba(UITheme.AMBER))
	self._knob.Position = UDim2.new(1, -px(from_right - fw), 0.5, 0)
	local k = if self._drag then 19 else 16
	self._knob.Size = UDim2.fromOffset(px(k), px(k))
	self._pct.Position = UDim2.new(1, -px(VolumeRow.RIGHT), 0.5, 0)
	self._pct.Size = UDim2.fromOffset(px(VolumeRow.PCT_W), px(20))
	self._pct.TextSize = math.max(px(13), 8)
end

-- =============================================================================================
-- Menu
-- =============================================================================================

function PauseMenu.new(c: any)
	local self = setmetatable({}, PauseMenu.__mt)
	W.Control._init(self)
	self.ctx = c
	self.closed = Signal.new()
	self.help_requested = Signal.new()
	self.leave_requested = Signal.new()
	self.labels_toggled = Signal.new()
	self.music_toggled = Signal.new()
	--- (v 0..1, final): the music volume slider; final once the drag ends (UIRoot saves then)
	self.music_volume_changed = Signal.new()
	self.pops_toggled = Signal.new()
	self.restart_requested = Signal.new()
	self.tips_reset = Signal.new()
	--- Rofront Staging, and game admins: "Replay as new player" was pressed and confirmed
	self.new_player_requested = Signal.new()
	self.is_open = false
	self._layout_compact = -1
	--- "menu" or "settings", and whether the settings page was reached from the menu (DONE goes back)
	self._page = "menu"
	self._from_menu = false
	self._confirm_action = ""
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	self:set_visible(false)
	self._dim = W.ColorRect.new(UITheme.rgba(0.01, 0.015, 0.05, 0.6))
	self._dim:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._dim.gui_input:Connect(function(e)
		-- (a press on the window's own ground reaches the dim too, as in Arsenal: only one outside it
		-- closes. Found 2026-10-21 with the music slider, whose every press closed the window)
		if e.pressed and not self._panel:has_global_point(e.global_position) then
			self:close()
		end
	end)
	self:add_child(self._dim)
	self._panel = GlassPanel.new(22.0, 22.0, 18, true, 34)
	self._panel:set_tint(UITheme.rgba(0.045, 0.065, 0.13, 0.94))
	self._panel:set_min_size(Vector2.new(380, 0))
	self:add_child(self._panel)
	local v = UITheme.vbox(14)
	self._v = v
	self._panel:add_child(v)
	-- the head: the title and its line, and (the settings page on a phone) the page's own buttons
	-- beside them, so the window is no taller than its switches
	local head_row = UITheme.hbox(10)
	v:add_child(head_row)
	local head = UITheme.vbox(2)
	head.size_flags_horizontal = W.EXPAND_FILL
	head.size_flags_vertical = W.SHRINK_CENTER
	self._title = UITheme.label("GAME MENU", 20, 800, UITheme.TEXT, 3)
	head:add_child(self._title)
	self._sub = UITheme.label("", 13, 500, UITheme.TEXT_2)
	head:add_child(self._sub)
	head_row:add_child(head)
	self._head_actions = UITheme.hbox(8)
	self._head_actions.size_flags_vertical = W.SHRINK_CENTER
	self._head_actions:set_visible(false)
	head_row:add_child(self._head_actions)

	-- Items live in one column on desktop and in two side-by-side columns on phones (short screens).
	self._main = UITheme.hbox(12)
	v:add_child(self._main)
	self._col_a = UITheme.vbox(8)
	self._col_a:set_min_size(Vector2.new(336, 0))
	self._col_b = UITheme.vbox(8)
	self._col_b:set_min_size(Vector2.new(336, 0))
	self._main:add_child(self._col_a)
	self._main:add_child(self._col_b)
	self._resume = UITheme.button("RESUME", "PrimaryButton", "play", 50.0)
	self._resume.pressed:Connect(function()
		self:close()
	end)
	self._help_btn = UITheme.button("How to play", "GlassButton", "help", 46.0)
	self._help_btn.alignment = W.ALIGN_LEFT
	self._help_btn.pressed:Connect(function()
		self:close()
		self.help_requested:Fire()
	end)
	self._settings_btn = UITheme.button("Settings", "GlassButton", "settings", 46.0)
	self._settings_btn.alignment = W.ALIGN_LEFT
	self._settings_btn.pressed:Connect(function()
		self._from_menu = true
		self:_show_page("settings")
	end)
	self._done = UITheme.button("DONE", "PrimaryButton", "check", 50.0)
	self._done.pressed:Connect(function()
		if self._from_menu then
			self._from_menu = false
			self:_show_page("menu")
		else
			self:close()
		end
	end)
	self._labels = Switch.new("Territory labels", "layers")
	self._labels.pressed:Connect(function()
		self.labels_toggled:Fire(self._labels.on)
	end)
	-- Music: one slider row (0% = off), as Tribes' settings. Music stays on/off underneath (the top bar's
	-- button and M toggle it): 0% is silent at once and switches it off when the finger lifts, any level
	-- above switches it on, and the level saved and kept for the button is the last one above 0.
	self._music = VolumeRow.new("Music", "music_on")
	self._music.ctx = c
	self._music_on = true
	self._music_keep = 1.0
	self._music.changed:Connect(function(v: number, final: boolean)
		if v <= 0 then
			self.music_volume_changed:Fire(0, false)
			if final and self._music_on then
				self._music_on = false
				self.music_toggled:Fire(false)
			end
			return
		end
		self.music_volume_changed:Fire(v, final)
		if final then
			self._music_keep = v
		end
		if not self._music_on then
			self._music_on = true
			self.music_toggled:Fire(true)
		end
	end)
	self._pops = Switch.new("Border pop sound", "pops")
	self._pops.pressed:Connect(function()
		self.pops_toggled:Fire(self._pops.on)
	end)
	self._confirm_sw = Switch.new("Select before attacking", "target")
	self._confirm_sw.pressed:Connect(function()
		self.ctx:set_setting(self:_confirm_key(), self._confirm_sw.on)
	end)
	self._tips = UITheme.button("Show tips again", "GhostButton", "info", 44.0)
	self._tips.alignment = W.ALIGN_LEFT
	self._tips:set_font_size(13)
	self._tips.pressed:Connect(function()
		self.tips_reset:Fire()
		self._tips:set_text("Tips will show again")
		self._tips:set_disabled(true)
	end)
	-- Rofront Staging (and Studio), and game admins on production (2026-10-27): be a new player again,
	-- to see the tutorial and every other first-time thing (2026-10-04: "Replay as new player"). Asked
	-- first: it ends the match being played, and on production it is a real account's match count.
	self._new_player = UITheme.button("Replay as new player", "GhostButton", "retreat", 44.0)
	self._new_player.alignment = W.ALIGN_LEFT
	self._new_player:set_font_size(13)
	self._new_player.pressed:Connect(function()
		self:_ask_new_player()
	end)
	self._new_player:set_visible(false)
	self._divider = UITheme.hdivider()
	self._restart = UITheme.button("Restart match", "GlassButton", "retreat", 46.0)
	self._restart.alignment = W.ALIGN_LEFT
	self._restart.pressed:Connect(function()
		self:_ask_restart()
	end)
	-- (big and solid red since 2026-10-19, at a player's request; it was a
	-- tinted row like the others)
	self._leave = UITheme.button("LEAVE MATCH", "SurrenderButton", "exit", 56.0)
	self._leave.pressed:Connect(function()
		self:_ask_leave()
	end)
	self:_reflow(false)

	self._confirm = UITheme.vbox(12)
	self._confirm:set_visible(false)
	v:add_child(self._confirm)
	self._confirm_text = UITheme.label("", 14, 500, UITheme.TEXT)
	self._confirm_text:set_autowrap(true)
	self._confirm_text:set_min_size(Vector2.new(320, 0))
	self._confirm:add_child(self._confirm_text)
	local row = UITheme.hbox(10)
	local cancel = UITheme.button("Stay", "GlassButton", "", 46.0)
	cancel.size_flags_horizontal = W.EXPAND_FILL
	cancel.pressed:Connect(function()
		self._confirm:set_visible(false)
		self._main:set_visible(true)
		self:_center()
	end)
	row:add_child(cancel)
	self._confirm_go = UITheme.button("Leave", "SurrenderButton", "exit", 46.0)
	self._confirm_go.size_flags_horizontal = W.EXPAND_FILL
	self._confirm_go.pressed:Connect(function()
		self:close()
		if self._confirm_action == "restart" then
			self.restart_requested:Fire()
		elseif self._confirm_action == "new_player" then
			self.new_player_requested:Fire()
		else
			self.leave_requested:Fire()
		end
	end)
	row:add_child(self._confirm_go)
	self._confirm:add_child(row)
	return self
end

function PauseMenu._ask_restart(self)
	self._confirm_action = "restart"
	self._confirm_text:set_text("Restart with a fresh world? This match will be lost.")
	self._confirm_go:set_text("Restart")
	self._confirm_go:set_icon("retreat")
	self._main:set_visible(false)
	self._confirm:set_visible(true)
	self:_center()
end

function PauseMenu._ask_new_player(self)
	local ctx = self.ctx
	self._confirm_action = "new_player"
	self._confirm_text:set_text(
		"Play as a new player again? Your match count and the tutorial start over"
			.. (if ctx:in_match() then ", and this match ends." else ".")
			.. " What you own stays."
	)
	self._confirm_go:set_text("Replay")
	self._confirm_go:set_icon("retreat")
	self._main:set_visible(false)
	self._confirm:set_visible(true)
	self:_center()
end

function PauseMenu._ask_leave(self)
	local ctx = self.ctx
	self._confirm_action = "leave"
	self._confirm_go:set_text("Leave")
	self._confirm_go:set_icon("exit")
	if not ctx:in_match() then
		self:close()
		self.leave_requested:Fire()
		return
	end
	local o = ctx:my()
	local mp = ctx:mode() == UICtx.MODE_MULTI
	if o ~= nil and o.alive and ctx.state ~= nil and ctx.state.phase == Defs.PHASE_PLAYING then
		self._confirm_text:set_text(
			"Surrender and return to the title screen? "
				.. (if mp then "Your nation stays on the map without a commander." else "This campaign will end.")
		)
	else
		self._confirm_text:set_text("Return to the title screen?")
	end
	self._main:set_visible(false)
	self._confirm:set_visible(true)
	self:_center()
end

--- `page`: "settings" opens on the settings page (the top bar's gear), else the game menu.
function PauseMenu.open(self, labels_on: boolean, page: string?)
	if self.is_open then
		return
	end
	local ctx = self.ctx
	self.is_open = true
	self._page = if page == "settings" then "settings" else "menu"
	self._from_menu = false
	self._labels.on = labels_on
	self._labels._k = if labels_on then 1.0 else 0.0
	self._labels:_draw_switch()
	self._music_on = ctx:music_enabled()
	if ctx:music_volume() > 0 then
		self._music_keep = ctx:music_volume()
	end
	self._music:set_value(if self._music_on then ctx:music_volume() else 0)
	self._pops.on = ctx:pops_enabled()
	self._pops._k = if self._pops.on then 1.0 else 0.0
	self._pops:_draw_switch()
	local cs = if ctx.touch
		then ctx:setting(self:_confirm_key(), ctx.touch_device or ctx.touch)
		else ctx:setting(self:_confirm_key(), false)
	self._confirm_sw.on = cs == true
	self._confirm_sw._k = if self._confirm_sw.on then 1.0 else 0.0
	self._confirm_sw:_draw_switch()
	local mp = ctx:mode() == UICtx.MODE_MULTI
	local on_title = not ctx:in_match()
	self._on_title = on_title
	local diff = { [0] = "Relaxed", "Standard", "Brutal" }
	local d =
		math.clamp(tonumber(ctx:setting("difficulty", UICtx.DEFAULT_DIFFICULTY)) or UICtx.DEFAULT_DIFFICULTY, 0, 2)
	if on_title then
		self._menu_sub = if ctx:mp_waiting() then "Waiting for the next multiplayer match" else "Main menu"
	else
		self._menu_sub = if mp then "Multiplayer match" else string.format("Solo match · %s · paused", diff[d])
	end
	self._restart:set_visible(not mp and not on_title)
	self._labels:set_visible(not on_title)
	self._confirm_sw:set_visible(not on_title)
	self._tips:set_text("Show tips again")
	self._tips:set_disabled(false)
	self._new_player:set_visible(ctx.staging == true or ctx:admin())
	local o = ctx:my()
	local alive = o ~= nil and o.alive and ctx.state ~= nil and ctx.state.phase == Defs.PHASE_PLAYING
	self._leave:set_visible(not on_title or ctx:mp_waiting())
	if on_title then
		self._leave:set_text("LEAVE QUEUE")
	else
		self._leave:set_text(if alive then "SURRENDER" else "LEAVE MATCH")
	end
	self._main:set_visible(true)
	self._confirm:set_visible(false)
	self:set_visible(true)
	self._panel:set_modulate_a(1.0)
	self:_show_page(self._page)
	self._dim:set_modulate_a(0.0)
	W.fade(self._dim, 1.0, 0.2)
	UICtx.pop_in(self._panel, 0.0, 0.94, 0.3)
	ctx:sfx("open")
end

--- Separate settings for touch and mouse (UIInteract.confirm_orders reads the same keys).
function PauseMenu._confirm_key(self): string
	return if self.ctx.touch then "confirm_orders" else "confirm_orders_desktop"
end

function PauseMenu.sync_music(self, on: boolean)
	self._music_on = on
	if on and self.ctx:music_volume() <= 0 then
		-- (back on from the top bar or M after the slider went to 0: the last level above 0)
		self.ctx:set_music_volume(self._music_keep, false)
	end
	self._music:set_value(if on then self.ctx:music_volume() else 0)
end

function PauseMenu.sync_pops(self, on: boolean)
	self._pops:set_on(on)
end

--- The page shown: "menu" or "settings".
function PauseMenu.page(self): string
	return self._page
end

--- The settings page while the window is open (the top bar's gear pressed over the game menu).
function PauseMenu.show_settings(self)
	if self.is_open and self._page ~= "settings" then
		self._from_menu = true
		self:_show_page("settings")
	end
end

function PauseMenu._show_page(self, page: string)
	self._page = page
	local settings = page == "settings"
	self._title:set_text(if settings then "SETTINGS" else "GAME MENU")
	self._sub:set_text(if settings then "Saved for next time" else (self._menu_sub or ""))
	self._confirm:set_visible(false)
	self._main:set_visible(true)
	self._layout_compact = -1
	self:_reflow(self.ctx.compact)
	self:_center()
end

function PauseMenu.close(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	self.ctx:sfx("close")
	local t = self:create_tween():set_parallel(true)
	t:tween_property(self._dim, "modulate:a", 0.0, 0.15)
	t:tween_property(self._panel, "modulate:a", 0.0, 0.15)
	t:chain():tween_callback(function()
		if not self.is_open then
			self:set_visible(false)
		end
	end)
	self.closed:Fire()
end

function PauseMenu.apply_layout(self)
	self:_reflow(self.ctx.compact)
	self:_center()
end

function PauseMenu._reflow(self, compact: boolean)
	local want = if compact then 1 else 0
	if want == self._layout_compact then
		return
	end
	self._layout_compact = want
	for _, cc in ipairs({
		self._resume,
		self._help_btn,
		self._settings_btn,
		self._labels,
		self._music,
		self._pops,
		self._confirm_sw,
		self._tips,
		self._new_player,
		self._divider,
		self._restart,
		self._leave,
		self._done,
	}) do
		if cc:get_parent() ~= nil then
			cc:get_parent():remove_child(cc)
		end
	end
	local h = if compact then 44.0 else 46.0
	self._leave:set_min_size(Vector2.new(0, if compact then 46.0 else 56.0))
	for _, b in ipairs({
		self._help_btn,
		self._settings_btn,
		self._restart,
		self._labels,
		self._music,
		self._pops,
		self._confirm_sw,
	}) do
		b:set_min_size(Vector2.new(0, h))
	end
	self._resume:set_min_size(Vector2.new(0, if compact then 46.0 else 50.0))
	-- one column on desktop, two side by side on phones (short screens)
	local a, b
	-- the settings page on a phone: DONE and "Show tips again" stand in the head beside the title, and
	-- the title's line goes (2026-10-07: the settings page wasted vertical space on phones;
	-- it was a head of two lines over three rows, 235 px of a 390 px screen)
	local slim = compact and self._page == "settings"
	self._head_actions:set_visible(slim)
	self._sub:set_visible(not slim)
	self._title:set_font_size(if slim then 18 else 20)
	self._v.separation = if slim then 10 else 14
	self._done:set_min_size(if slim then Vector2.new(120, 38) else Vector2.new(0, if compact then 46.0 else 50.0))
	self._tips:set_min_size(Vector2.new(0, if slim then 38.0 else 44.0))
	if slim then
		for _, sw in ipairs({ self._labels, self._music, self._pops, self._confirm_sw }) do
			sw:set_min_size(Vector2.new(0, 42.0))
		end
		self._head_actions:add_child(self._tips)
		self._head_actions:add_child(self._done)
		if self._on_title then
			-- (no labels or orders on the title: the music slider and the pops side by side; Staging's
			-- "Replay as new player" under them, the game menu's main page being out of reach on the title)
			a = { self._music, self._new_player }
			b = { self._pops }
		else
			a = { self._music, self._pops, self._new_player }
			b = { self._labels, self._confirm_sw }
		end
	elseif self._page == "settings" then
		-- (Staging: "Replay as new player" here too: the title's gear only opens this page,
		-- so before 2026-10-15 the Staging title screen had no way to it)
		a = {
			self._music,
			self._pops,
			self._labels,
			self._confirm_sw,
			self._tips,
			self._new_player,
			self._done,
		}
	elseif compact then
		-- (Staging: "Replay as new player" stands under How to play)
		-- (SURRENDER at the foot of the second column, as tall as RESUME: a row of its own under both
		-- made the window taller than a phone's screen)
		a = { self._resume, self._help_btn, self._new_player }
		b = { self._settings_btn, self._restart, self._leave }
	else
		a = {
			self._resume,
			self._help_btn,
			self._settings_btn,
			self._new_player,
			self._divider,
			self._restart,
			self._leave,
		}
	end
	for _, c2 in ipairs(a) do
		self._col_a:add_child(c2)
	end
	for _, c3 in ipairs(b or {}) do
		self._col_b:add_child(c3)
	end
	local w = if compact then 290 else 336
	self._col_a:set_min_size(Vector2.new(w, 0))
	self._col_b:set_min_size(Vector2.new(w, 0))
	self._col_b:set_visible(b ~= nil)
	self._panel:set_padding(
		if compact then 16.0 else 22.0,
		if slim then 12.0 elseif compact then 14.0 else 22.0,
		if compact then 16.0 else 22.0,
		if slim then 12.0 elseif compact then 14.0 else 22.0
	)
end

function PauseMenu._center(self)
	local ctx = self.ctx
	local sz = self._panel:get_combined_minimum_size()
	local area = ctx:clear_rect()
	local p = area.Min + (Vector2.new(area.Width, area.Height) - sz) * 0.5
	local y = math.max(p.Y, area.Min.Y + 4.0)
	local rp = Vector2.new(math.floor(p.X + 0.5), math.floor(y + 0.5))
	self._panel:set_offsets(rp.X, rp.Y, rp.X, rp.Y)
	self._panel:reset_size()
end

return PauseMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="209">
            <Properties>
              <string name="Name">PlaceConfirm</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/place_confirm.gd (UIPlaceConfirm)
-- Touch placement / launch confirmation: a small caption and two big buttons (✕ cancel, ✓ build
-- or launch) floating next to the ghost on the globe, never over it. The buttons follow the
-- ghost's screen position every frame; UIInteract moves the ghost (tap elsewhere, map drag).

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local Signal = UITheme.core("Signal")

local PlaceConfirm = W.class(W.Control)

PlaceConfirm.BTN = 52.0
--- Keep this far (px) from the ghost's centre so the target stays visible and tappable.
PlaceConfirm.CLEAR = 34.0

local function darkened(c: Color3, amount: number): Color3
	return Color3.new(c.R * (1 - amount), c.G * (1 - amount), c.B * (1 - amount))
end

function PlaceConfirm.new(c: any)
	local self = setmetatable({}, PlaceConfirm.__mt)
	W.Control._init(self)
	self.ctx = c
	self.confirmed = Signal.new()
	self.cancelled = Signal.new()
	self.tile = -1
	self.is_open = false
	--- function() -> {Rect}: HUD panels the buttons must stay clear of.
	self.blockers = nil
	self._side = -1
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._panel = GlassPanel.new(8.0, 6.0, UITheme.R_LG, true, 16)
	self:add_child(self._panel)
	local v = UITheme.vbox(6)
	self._panel:add_child(v)
	self._caption = UITheme.label("", 12, 700, UITheme.TEXT)
	self._caption:set_alignment(W.ALIGN_CENTER)
	self._caption.text_overrun_behavior = W.OVERRUN_ELLIPSIS
	self._caption.clip_text = true
	v:add_child(self._caption)
	local h = UITheme.hbox(8)
	h:set_alignment(W.ALIGN_CENTER)
	self._no = self:_round_button("close", false)
	self._no.name = "PlaceCancel"
	self._no.gui.Name = "PlaceCancel"
	self._no.pressed:Connect(function()
		self.cancelled:Fire()
	end)
	h:add_child(self._no)
	self._ok = self:_round_button("check", true)
	self._ok.name = "PlaceConfirm"
	self._ok.gui.Name = "PlaceConfirm"
	self._ok.pressed:Connect(function()
		self.confirmed:Fire()
	end)
	h:add_child(self._ok)
	v:add_child(h)
	self:set_visible(false)
	self:set_process(true)
	return self
end

function PlaceConfirm._round_button(self, icon_name: string, primary: boolean)
	local BTN = PlaceConfirm.BTN
	local b = W.Button.new("", "Button")
	b:set_icon(icon_name)
	b.expand_icon = true
	b.icon_alignment = W.ALIGN_CENTER
	b:add_theme_constant_override("icon_max_width", 22)
	b:set_min_size(Vector2.new(BTN, BTN))
	local r = math.floor(BTN * 0.5)
	local bg = UITheme.flat(
		if primary then UITheme.AMBER else UITheme.rgba(0.08, 0.1, 0.16, 0.92),
		r,
		if primary then UITheme.AMBER_LO else UITheme.LINE_2,
		if not primary then 1 else 0,
		4.0,
		4.0
	)
	if primary then
		bg.bw_bottom = 3
		bg.border = UITheme.to_rgba(UITheme.AMBER_LO)
	end
	local hot = UITheme.dup(bg)
	hot.bg = UITheme.to_rgba(if primary then UITheme.AMBER_HI else UITheme.rgba(0.14, 0.17, 0.25, 0.95))
	for _, st in ipairs({ "normal", "disabled" }) do
		b:add_theme_stylebox_override(st, bg)
	end
	for _, st2 in ipairs({ "hover", "pressed", "hover_pressed" }) do
		b:add_theme_stylebox_override(st2, hot)
	end
	local ic = if primary then UITheme.INK else UITheme.TEXT
	for _, cn in ipairs({
		"icon_normal_color",
		"icon_hover_color",
		"icon_pressed_color",
		"icon_hover_pressed_color",
		"icon_disabled_color",
	}) do
		b:add_theme_color_override(cn, ic)
	end
	return b
end

--- Show the buttons for the ghost at `t`. `danger` paints ✓ red (nuke launch).
function PlaceConfirm.show_for(self, t: number, caption: string, danger: boolean, ok: boolean?)
	local okv = if ok == nil then true else ok
	self.tile = t
	self._caption:set_text(caption)
	self._caption:set_min_size(Vector2.new(math.min(UITheme.text_width(caption, 12, 700) + 4.0, 230.0), 0))
	self._ok:set_disabled(not okv)
	local col = if danger then UITheme.RED else UITheme.AMBER
	local sb = UITheme.dup(self._ok:get_theme_stylebox("normal"))
	sb.bg = if okv then UITheme.to_rgba(col) else UITheme.rgba(1, 1, 1, 0.1)
	sb.border = UITheme.to_rgba(darkened(col, 0.3))
	self._ok:add_theme_stylebox_override("normal", sb)
	self._ok:add_theme_stylebox_override("disabled", sb)
	local was = self.is_open
	self.is_open = true
	self:set_visible(true)
	self._panel:reset_size()
	self._side = -1
	self:_follow(true)
	if not was then
		UICtx.pop_in(self._panel, 0.0, 0.9, 0.2, true)
	end
end

function PlaceConfirm.hide_confirm(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	self.tile = -1
	self:set_visible(false)
end

function PlaceConfirm.panel_rect(self): Rect
	return if self.is_open then self._panel:get_global_rect() else UICtx.EMPTY_RECT
end

function PlaceConfirm.button_rects(self): { Rect }
	return if self.is_open then { self._ok:get_global_rect(), self._no:get_global_rect() } else {}
end

function PlaceConfirm._process(self, _delta: number)
	if self.is_open then
		self:_follow(false)
	end
end

--- Beside the ghost: right, left, above or below — the first spot inside the free screen area
--- that keeps CLEAR px from the ghost and off the HUD; the chosen side sticks while it still fits.
function PlaceConfirm._follow(self, force: boolean)
	local ctx = self.ctx
	local CLEAR = PlaceConfirm.CLEAR
	local p = ctx:tile_screen_pos(self.tile)
	if p.X < 0.0 then
		self._panel:set_visible(false) -- behind the globe: nothing to confirm against right now
		return
	end
	self._panel:set_visible(true)
	local sz = self._panel:get_combined_minimum_size()
	local area = ctx:clear_rect()
	local bar = self:get_meta("bar", nil)
	if bar ~= nil and bar:is_visible_in_tree() then
		area = Rect.new(area.Min.X, area.Min.Y, area.Max.X, math.min(area.Max.Y, bar:top_edge() - 6.0))
	end
	local cands = {
		Vector2.new(p.X + CLEAR, p.Y - sz.Y * 0.5), -- right
		Vector2.new(p.X - CLEAR - sz.X, p.Y - sz.Y * 0.5), -- left
		Vector2.new(p.X - sz.X * 0.5, p.Y - CLEAR - sz.Y), -- above
		Vector2.new(p.X - sz.X * 0.5, p.Y + CLEAR), -- below
	}
	local blocked = if self.blockers then self.blockers() else {}
	local order = { 0, 1, 2, 3 }
	if not force and self._side >= 0 then
		table.remove(order, table.find(order, self._side) :: number)
		table.insert(order, 1, self._side)
	end
	local best = -1
	local best_pos = Vector2.zero
	for _, i in ipairs(order) do
		local q = cands[i + 1]
		local r = UICtx.rect_ps(q, sz)
		if not UICtx.rect_encloses(area, r) then
			continue
		end
		local hit = false
		for _, b in ipairs(blocked) do
			if UICtx.rect_intersects(r, b) then
				hit = true
				break
			end
		end
		if hit then
			continue
		end
		best = i
		best_pos = q
		break
	end
	if best < 0 then
		-- Nothing fits cleanly: clamp the right-hand spot into the area, then push it off the ghost.
		local q2 = cands[1]
		local x = math.clamp(q2.X, area.Min.X, math.max(area.Min.X, area.Max.X - sz.X))
		local y = math.clamp(q2.Y, area.Min.Y, math.max(area.Min.Y, area.Max.Y - sz.Y))
		if UICtx.rect_has_point(UICtx.rect_grow(UICtx.rect_ps(Vector2.new(x, y), sz), CLEAR * 0.5), p) then
			y = if p.Y - CLEAR - sz.Y >= area.Min.Y then p.Y - CLEAR - sz.Y else p.Y + CLEAR
		end
		best_pos = Vector2.new(x, y)
	end
	self._side = best
	UICtx.move_node(self._panel, Vector2.new(math.floor(best_pos.X + 0.5), math.floor(best_pos.Y + 0.5)))
end

return PlaceConfirm
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="210">
            <Properties>
              <string name="Name">Prices</string>
              <string name="Source"><![CDATA[--!strict
-- The Robux prices the interface shows: Roblox's own for this player (MarketplaceService), never
-- the number in Data/Products once Roblox has answered. With Managed Pricing (dynamic pricing,
-- on since 2026-10-05) a product's price differs by region and while Roblox tests prices, and a
-- button that prints 49 beside a prompt that charges 20 loses the sale. Roblox asks for prices to be
-- read this way before it lets an experience opt in (it looks for hard-coded ones).
--
--   Prices.robux(key)  the price of Data/Products[key]: Roblox's, or the set one until it answers
--   Prices.fetch()     ask Roblox for every product's price (at most once every REFRESH_S), but the
--                      flag shop's (Products' `shop_flag`: dozens, of which the shop shows a few)
--   Prices.fetch_keys(keys)   ask for these products' prices (each at most once every REFRESH_S)
--   Prices.changed     Signal(): a price arrived or moved
local UITheme = require("./UITheme")
local Signal = UITheme.core("Signal")

local IS_ROBLOX = typeof(game) == "Instance"
local Products: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Products)
	else (require :: any)("../../shared/Data/Products")

local Prices = {}

--- A price is asked for again after this long (a price test starts or ends while a server is up).
Prices.REFRESH_S = 600
Prices.changed = Signal.new()

local known: { [string]: number } = {}
local asked_at = -1e9
local asking = false
--- (fetch_keys: when each product was last asked for)
local key_asked: { [string]: number } = {}

function Prices.robux(key: string): number
	local p = Products[key]
	return known[key] or (if type(p) == "table" then tonumber(p.robux) or 0 else 0)
end

--- Roblox's price of product `key` is `robux` (fetch; tests).
function Prices.set(key: string, robux: number)
	if known[key] ~= robux then
		known[key] = robux
		Prices.changed:Fire()
	end
end

function Prices.fetch()
	if not IS_ROBLOX or asking or os.clock() - asked_at < Prices.REFRESH_S then
		return
	end
	asking = true
	task.spawn(function()
		local mps = game:GetService("MarketplaceService")
		local moved = false
		for key, p in Products do
			if type(p) == "table" and (tonumber(p.id) or 0) ~= 0 and p.shop_flag == nil and p.shop_set == nil then
				local ok, info = pcall(function()
					return mps:GetProductInfo(p.id, Enum.InfoType.Product)
				end)
				if ok and type(info) == "table" and type(info.PriceInRobux) == "number" then
					if known[key] ~= info.PriceInRobux then
						known[key] = info.PriceInRobux
						moved = true
					end
				end
			end
		end
		asked_at = os.clock()
		asking = false
		if moved then
			Prices.changed:Fire()
		end
	end)
end

function Prices.fetch_keys(keys: { string })
	if not IS_ROBLOX then
		return
	end
	local want = {}
	for _, key in keys do
		local p = Products[key]
		if
			type(p) == "table"
			and (tonumber(p.id) or 0) ~= 0
			and os.clock() - (key_asked[key] or -1e9) >= Prices.REFRESH_S
		then
			key_asked[key] = os.clock()
			table.insert(want, key)
		end
	end
	if #want == 0 then
		return
	end
	task.spawn(function()
		local mps = game:GetService("MarketplaceService")
		local moved = false
		for _, key in want do
			local ok, info = pcall(function()
				return mps:GetProductInfo(Products[key].id, Enum.InfoType.Product)
			end)
			if
				ok
				and type(info) == "table"
				and type(info.PriceInRobux) == "number"
				and known[key] ~= info.PriceInRobux
			then
				known[key] = info.PriceInRobux
				moved = true
			end
		end
		if moved then
			Prices.changed:Fire()
		end
	end)
end

return Prices
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="211">
            <Properties>
              <string name="Name">RadialMenu</string>
              <string name="Source"><![CDATA[-- Port of scripts/ui/radial_menu.gd
-- Circular context menu (right-click / long-press). Segments carry an icon and a short label;
-- unavailable actions are greyed and explain themselves in the caption under the ring. Items with
-- a `sub` list open a second ring (Build ▸, Nuke ▸); the centre button goes back / closes.
--
-- Roblox: drawn with plain instances in a logical-px canvas. Ring segments are static annular
-- sector masks (Assets/UiShapes, tools/ui/make_shapes.py) rotated into place and tinted; circles
-- are Frames with UICorner / UIStroke. While open, a full-screen button swallows pointer input
-- (Godot MOUSE_FILTER_STOP) and the opening finger of a long-press is followed through
-- UserInputService (press-slide-release picks).

local UICtx = require("./UICtx") :: any
local JutsuGlyph = require("./JutsuGlyph")
local Signal = UICtx.core("Signal")

local _T: any = nil
local function T(): any
	if _T == nil then
		_T = UICtx.mod("UITheme")
	end
	return _T
end

local _Shapes: any = nil
local function Shapes(): any
	if _Shapes == nil then
		local ok, m = pcall(function()
			if UICtx.IS_ROBLOX then
				local rs = game:GetService("ReplicatedStorage")
				return require((rs:WaitForChild("Airfront") :: any):WaitForChild("Assets"):WaitForChild("UiShapes"))
			end
			return (require :: any)("../../shared/Assets/UiShapes")
		end)
		_Shapes = if ok then m else {}
	end
	return _Shapes
end

local TAU = 2 * math.pi

local RadialMenu = {}
RadialMenu.__index = RadialMenu

--- How far (logical px) the opening finger must slide before its release picks an item (was 16: a
--- lift's wobble picked whatever the finger rested on, so press and hold felt glitchy; 2026-09-29).
RadialMenu.SLIDE_PICK_PX = 30.0

local function rgb(r: number, g: number, b: number): Color3
	return Color3.new(r, g, b)
end

--- easeOutBack (GDScript _ease)
local function ease(t: number): number
	local c1 = 1.70158
	local c3 = c1 + 1.0
	return 1.0 + c3 * (t - 1.0) ^ 3 + c1 * (t - 1.0) ^ 2
end

function RadialMenu.new(c: any)
	local self = setmetatable({}, RadialMenu)
	self.ctx = c
	self.picked = Signal.new() -- (id, tile)
	self.closed = Signal.new()
	self.tile = -1
	self.center = Vector2.zero
	self.items = {} :: { any }
	self.title = ""
	self.title_color = T().TEXT
	self.is_open = false
	self._root_items = {} :: { any }
	self._in_sub = false
	--- the rings above the current sub-ring (nested sub-rings)
	self._stack = {} :: { any }
	self._sub_title = ""
	self._hover = -1
	self._center_hover = false
	self._anim = 0.0
	self._closing = false
	--- False until a press lands on the open menu: a release before that ends a long-press-and-slide.
	self._saw_press = false
	self._press_pos = Vector2.zero
	--- The opening finger has moved off its press point (press-slide-release may pick).
	self._slid = false
	self.r_in = 44.0
	self.r_out = 116.0
	self._conns = {} :: { any }
	self._segs = {} :: { any }
	self._built_for = nil :: any
	self:_build()
	return self
end

-- ---------------------------------------------------------------------------------------------
-- Instances
-- ---------------------------------------------------------------------------------------------

function RadialMenu._build(self: any)
	local canvas = UICtx.canvas(nil, "Radial")
	canvas.Visible = false
	self.gui = canvas
	-- Input sink (Godot mouse_filter STOP while open).
	local blocker = UICtx.make("TextButton", {
		Name = "Blocker",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		Active = true,
		Selectable = false,
		ZIndex = 1,
	}, canvas)
	self._blocker = blocker
	-- Ring: everything positioned relative to the centre, scaled by the open animation.
	local ring = UICtx.frame(canvas)
	ring.Name = "Ring"
	ring.ZIndex = 2
	self._ring = ring
	self._ring_scale = UICtx.make("UIScale", { Scale = 1 }, ring)
	self._backdrop = UICtx.circle(ring, Vector2.zero, 10, rgb(0.0, 0.01, 0.04), 1)
	self._backdrop.ZIndex = 1
	self._seg_holder = UICtx.frame(ring)
	self._seg_holder.ZIndex = 2
	self._gap_disc = UICtx.circle(ring, Vector2.zero, 10, rgb(0.02, 0.03, 0.07), 1)
	self._gap_disc.ZIndex = 5
	self._center_btn = UICtx.circle(ring, Vector2.zero, 10, rgb(0.09, 0.12, 0.22), 0)
	self._center_btn.ZIndex = 6
	self._center_stroke =
		UICtx.make("UIStroke", { Thickness = 1, Color = Color3.new(1, 1, 1), Transparency = 0.84 }, self._center_btn)
	self._center_icon = UICtx.make("ImageLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 7,
	}, self._center_btn)
	-- Title / caption pills (outside the scaled group: fixed text size like the original).
	self._title_pill = self:_make_pill(canvas, 13, 800, 1)
	self._cap_pill = self:_make_pill(canvas, 12, 600, 0)
end

function RadialMenu._make_pill(self: any, parent: Instance, fs: number, weight: number, spacing: number): any
	local Th = T()
	local f = UICtx.make("Frame", {
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = rgb(0.04, 0.055, 0.11),
		ZIndex = 10,
		Visible = false,
	}, parent)
	UICtx.make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
	local st = UICtx.make("UIStroke", { Thickness = 1, Color = Color3.new(1, 1, 1), Transparency = 0.88 }, f)
	local l = UICtx.make("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		FontFace = Th.font(weight),
		TextSize = UICtx.ts(fs),
		TextColor3 = Th.TEXT,
		Text = "",
		ZIndex = 11,
	}, f)
	return { frame = f, stroke = st, label = l, fs = fs, weight = weight, spacing = spacing, text = "" }
end

function RadialMenu._set_pill(self: any, pill: any, c: Vector2, text: string, col: Color3, alpha: number)
	local Th = T()
	if text == "" or alpha <= 0.0 then
		pill.frame.Visible = false
		return
	end
	if text ~= pill.text then
		pill.text = text
		pill.label.Text = text
		pill.w = Th.text_width(text, pill.fs, pill.weight, 0) + 22.0
	end
	local h = pill.fs + 12.0
	pill.frame.Visible = true
	pill.frame.Position = UDim2.fromOffset(c.X, c.Y)
	pill.frame.Size = UDim2.fromOffset(pill.w, h)
	pill.frame.BackgroundTransparency = 1 - alpha
	pill.stroke.Transparency = 1 - 0.12 * alpha
	pill.label.TextColor3 = col
	pill.label.TextTransparency = 1 - alpha
end

--- One pooled segment: fill + outline masks, icon, label.
function RadialMenu._seg(self: any, i: number): any
	local s = self._segs[i]
	if s ~= nil then
		return s
	end
	local Th = T()
	local holder = self._seg_holder
	local function mask(z: number): ImageLabel
		return UICtx.make("ImageLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			ScaleType = Enum.ScaleType.Stretch,
			ZIndex = z,
		}, holder)
	end
	s = {
		fill = mask(2),
		line = mask(3),
		icon = UICtx.make("ImageLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(24, 24),
			ZIndex = 4,
		}, holder),
		label = UICtx.make("TextLabel", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0),
			Size = UDim2.fromOffset(90, UICtx.ts(11)),
			FontFace = Th.font(600),
			TextSize = UICtx.ts(11),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 4,
		}, holder),
		key = "",
	}
	self._segs[i] = s
	return s
end

-- ---------------------------------------------------------------------------------------------
-- Open / close
-- ---------------------------------------------------------------------------------------------

function RadialMenu.open_at(self: any, t: number, pos: Vector2, its: { any }, title_text: string, title_col: Color3)
	local ctx = self.ctx
	self.tile = t
	self._root_items = its
	self.items = its
	self._in_sub = false
	self._stack = {}
	self.title = title_text
	self.title_color = title_col
	self.r_in = if ctx.touch then 50.0 else 44.0
	self.r_out = if ctx.touch then 128.0 else 116.0
	if ctx.compact then
		self.r_in = 44.0
		self.r_out = 112.0
	end
	local area: Rect = ctx:clear_rect()
	-- (above the command bar: on phones the ring ran over it and its caption hid under the bar)
	if self.bottom_limit ~= nil then
		local b = self.bottom_limit()
		if type(b) == "number" and b > area.Min.Y + 200.0 and b < area.Max.Y then
			area = Rect.new(area.Min.X, area.Min.Y, area.Max.X, b - 4.0)
		end
	end
	-- Room for the ring plus its title pill above (≈34 px) and caption pill below (≈40 px).
	local fit = (area.Height - 34.0 - 40.0) * 0.5
	if self.r_out > fit then
		self.r_in = math.max(34.0, self.r_in * fit / self.r_out)
		self.r_out = math.max(80.0, fit)
	end
	local m = self.r_out + 12.0
	local lo_y = area.Min.Y + self.r_out + 34.0
	self.center = Vector2.new(
		math.clamp(pos.X, area.Min.X + m, math.max(area.Min.X + m, area.Max.X - m)),
		math.clamp(pos.Y, lo_y, math.max(lo_y, area.Max.Y - self.r_out - 40.0))
	)
	self.is_open = true
	self._closing = false
	self._saw_press = false
	-- Where the finger rests: the ring may be shifted to fit, so a release there is not a pick.
	self._press_pos = pos
	self._slid = false
	self._hover = -1
	self._anim = 0.0
	ctx:fit_canvas(self.gui)
	self.gui.Visible = true
	self._blocker.Active = true
	self._blocker.Visible = true
	self._built_for = nil
	self:_connect_input()
	ctx:sfx("open", -6.0)
	self:_redraw()
end

function RadialMenu.close(self: any, emit: boolean?)
	if not self.is_open then
		return
	end
	self.is_open = false
	self._closing = true
	-- Stay input-opaque until the close animation ends (the press that closed us must not fall
	-- through to the globe).
	if emit ~= false then
		self.closed:Fire()
	end
end

function RadialMenu._enter_sub(self: any, item: any)
	local sub = {}
	for _, d in item.sub or {} do
		table.insert(sub, d)
	end
	-- (rings nest: Build ▸ City ▸ ×1 ×5 ×10 ×Max; the centre button goes back one ring)
	if self._in_sub then
		table.insert(self._stack, { items = self.items, title = self._sub_title })
	end
	self.items = sub
	self._in_sub = true
	self._sub_title = tostring(item.label or "")
	self._hover = -1
	self._anim = 0.35
	self._built_for = nil
	self.ctx:sfx("click", -4.0)
	self:_redraw()
end

function RadialMenu._back(self: any)
	local prev = table.remove(self._stack)
	if prev ~= nil then
		self.items = prev.items
		self._sub_title = prev.title
		self._hover = -1
		self._anim = 0.35
		self._built_for = nil
		self.ctx:sfx("click", -6.0)
		self:_redraw()
		return
	end
	self.items = self._root_items
	self._in_sub = false
	self._hover = -1
	self._anim = 0.35
	self._built_for = nil
	self.ctx:sfx("click", -6.0)
	self:_redraw()
end

--- Per frame (UIRoot's loop).
function RadialMenu.update(self: any, delta: number)
	if self._closing then
		self._anim = math.max(0.0, self._anim - delta * 7.0)
		if self._anim <= 0.0 then
			self._closing = false
			self.gui.Visible = false
			self._blocker.Active = false
			self._blocker.Visible = false
			self:_disconnect_input()
		end
		self:_redraw()
	elseif self.is_open and self._anim < 1.0 then
		self._anim = math.min(1.0, self._anim + delta * 6.0)
		self:_redraw()
	end
end

-- ---------------------------------------------------------------------------------------------
-- Hit testing & input
-- ---------------------------------------------------------------------------------------------

function RadialMenu._index_at(self: any, p: Vector2): number
	local d = p - self.center
	local r = d.Magnitude
	self._center_hover = r < self.r_in - 4.0
	local n = #self.items
	if r < self.r_in - 4.0 or r > self.r_out + 18.0 or n == 0 then
		return -1
	end
	local span = TAU / n
	local a = (math.atan2(d.Y, d.X) + math.pi * 0.5 + span * 0.5) % TAU
	return math.clamp(math.floor(a / span), 0, n - 1)
end

function RadialMenu._set_hover(self: any, h: number)
	local prev_center = self._center_hover_drawn
	if h ~= self._hover or prev_center ~= self._center_hover then
		if h ~= self._hover and h >= 0 then
			self.ctx:sfx("hover", -12.0)
		end
		self._hover = h
		self:_redraw()
	end
end

--- Long-press, slide onto an item, release: pick it. A release on the centre / outside just
--- leaves the menu open for a normal tap.
function RadialMenu._release_at(self: any, pos: Vector2)
	self._saw_press = true
	if not self._slid then
		return -- a plain long-press: the menu stays open for a tap
	end
	local ri = self:_index_at(pos)
	if ri >= 0 then
		local it = self.items[ri + 1]
		if it.ok and it.sub == nil then
			local rid = tostring(it.id or "")
			local rt = self.tile
			self:close(false)
			self.picked:Fire(rid, rt)
		elseif it.sub ~= nil and it.ok then
			self:_enter_sub(it)
		end
	end
end

function RadialMenu._press(self: any, pos: Vector2, right: boolean)
	if not self.is_open then
		return
	end
	self._saw_press = true
	if right then
		if self._in_sub then
			self:_back()
		else
			self:close()
		end
		return
	end
	local i = self:_index_at(pos)
	self._hover = i
	if i < 0 then
		if self._center_hover and self._in_sub then
			self:_back()
		else
			self:close()
		end
		return
	end
	local it = self.items[i + 1]
	if not it.ok then
		self.ctx:sfx("deny", -4.0)
		self:_redraw()
		return
	end
	if it.sub ~= nil then
		self:_enter_sub(it)
		return
	end
	local id = tostring(it.id or "")
	local t = self.tile
	self:close(false)
	self.picked:Fire(id, t)
end

function RadialMenu._connect_input(self: any)
	if not UICtx.IS_ROBLOX or #self._conns > 0 then
		return
	end
	local ctx = self.ctx
	local UIS = game:GetService("UserInputService")
	local GuiService = game:GetService("GuiService")
	local function lpos(io: InputObject): Vector2
		local p = Vector2.new(io.Position.X, io.Position.Y)
		if io.UserInputType == Enum.UserInputType.Touch then
			p += GuiService:GetGuiInset()
		else
			p = UIS:GetMouseLocation()
		end
		return ctx:to_logical(p)
	end
	local b = self._blocker
	table.insert(
		self._conns,
		b.InputBegan:Connect(function(io: InputObject)
			local ty = io.UserInputType
			if ty == Enum.UserInputType.Touch and io.UserInputState ~= Enum.UserInputState.Begin then
				-- not a new touch: a finger already down "begins" on the blocker when it next moves or
				-- lifts over it, and the blocker has just appeared under the finger that opened the menu.
				-- Taken for a press at the ring's centre, the wobble of that finger lifting closed the
				-- menu as soon as the finger let go, which made press and hold useless on phones
				-- (2026-10-04). Its slide and release are followed below.
				return
			end
			if ty == Enum.UserInputType.MouseButton1 or ty == Enum.UserInputType.Touch then
				self:_press(lpos(io), false)
			elseif ty == Enum.UserInputType.MouseButton2 then
				self:_press(lpos(io), true)
			end
		end)
	)
	-- Hover (mouse) and the opening finger's slide / release (touch or mouse long-press).
	table.insert(
		self._conns,
		UIS.InputChanged:Connect(function(io: InputObject)
			if not self.is_open then
				return
			end
			local ty = io.UserInputType
			if ty == Enum.UserInputType.MouseMovement or (ty == Enum.UserInputType.Touch and not self._saw_press) then
				local p = lpos(io)
				-- a deliberate slide (not a finger's wobble on lifting: the ring may have shifted to fit, so
				-- the finger can rest on a segment) before a release there picks it
				if not self._saw_press and (p - self._press_pos).Magnitude > RadialMenu.SLIDE_PICK_PX then
					self._slid = true
				end
				self:_set_hover(self:_index_at(p))
			end
		end)
	)
	table.insert(
		self._conns,
		UIS.InputEnded:Connect(function(io: InputObject)
			if not self.is_open or self._saw_press then
				return
			end
			local ty = io.UserInputType
			if ty == Enum.UserInputType.Touch or ty == Enum.UserInputType.MouseButton1 then
				self:_release_at(lpos(io))
			end
		end)
	)
end

function RadialMenu._disconnect_input(self: any)
	for _, c in self._conns do
		c:Disconnect()
	end
	table.clear(self._conns)
end

-- ---------------------------------------------------------------------------------------------
-- Drawing
-- ---------------------------------------------------------------------------------------------

--- Variant of the segment masks closest to the ring's r_in / r_out ratio.
local function variant_for(ri: number, ro: number): (string?, number)
	local S = Shapes()
	local best, bq = nil, math.huge
	if S.variants == nil then
		return nil, 1
	end
	local q = ri / ro
	for name, v in S.variants do
		local d = math.abs(v.ri / v.ro - q)
		if d < bq then
			bq = d
			best = name
		end
	end
	return best, if best then ro / S.variants[best].ro else 1
end

function RadialMenu._redraw(self: any)
	local Th = T()
	local S = Shapes()
	local anim = self._anim
	if anim <= 0.0 then
		self._ring.Visible = false
		self._title_pill.frame.Visible = false
		self._cap_pill.frame.Visible = false
		return
	end
	self._ring.Visible = true
	local e = ease(anim)
	local s = 0.72 + (1.0 - 0.72) * e
	local alpha = math.clamp(anim * 1.6, 0.0, 1.0)
	local c = self.center
	local ri = self.r_in
	local ro = self.r_out
	self._ring.Position = UDim2.fromOffset(c.X, c.Y)
	self._ring_scale.Scale = s
	-- Soft backdrop disc.
	UICtx.set_circle(self._backdrop, Vector2.zero, ro + 36.0)
	self._backdrop.BackgroundTransparency = 1 - 0.36 * alpha
	local n = #self.items
	local span = TAU / math.max(n, 1)
	local S_px = S.px or 2
	for i = 1, math.max(n, #self._segs) do
		local sg = self._segs[i]
		if i > n then
			if sg then
				sg.fill.Visible = false
				sg.line.Visible = false
				sg.icon.Visible = false
				sg.label.Visible = false
			end
			continue
		end
		sg = self:_seg(i)
		local it = self.items[i]
		local ok = it.ok == true
		local danger = it.danger == true
		local hov = (i - 1) == self._hover
		local fill = rgb(0.06, 0.085, 0.17)
		local edge_a = 0.12
		local icol = Th.TEXT
		local icol_a = 1.0
		if danger and ok then
			icol = rgb(1.0, 0.8, 0.8)
		end
		if not ok then
			fill = rgb(0.05, 0.065, 0.12)
			icol = Th.TEXT
			icol_a = 0.28
		end
		if hov and ok then
			fill = if danger then Th.RED else Th.AMBER
			edge_a = 0.5
			icol = if danger then Color3.new(1, 1, 1) else Th.INK
		elseif hov then
			fill = rgb(0.12, 0.13, 0.2)
		end
		local ro2 = ro + (if hov and ok then 6.0 else 0.0)
		local rad = (i - 1) * span -- clockwise from 12 o'clock (segment centre)
		local ang = math.deg(rad)
		local vname, k = variant_for(ri, ro2)
		local fkey = if vname and n >= 2 then string.format("%s_%d_fill", vname, math.min(n, 8)) else nil
		local lkey = if vname and n >= 2 then string.format("%s_%d_line", vname, math.min(n, 8)) else nil
		local fd = if fkey and S.segments then S.segments[fkey] else nil
		local ld = if lkey and S.segments then S.segments[lkey] else nil
		local cs, sn = math.cos(rad), math.sin(rad)
		local function place(img: ImageLabel, d: any)
			if d == nil then
				img.Visible = false
				return
			end
			local sc = k / S_px -- logical px per mask px
			img.Visible = true
			img.Image = S.pages[d.page] or ""
			img.ImageRectOffset = Vector2.new(d.x, d.y)
			img.ImageRectSize = Vector2.new(d.w, d.h)
			img.Size = UDim2.fromOffset(d.w * sc, d.h * sc)
			local vx, vy = (d.w * 0.5 - d.cx) * sc, (d.h * 0.5 - d.cy) * sc
			img.Position = UDim2.fromOffset(vx * cs - vy * sn, vx * sn + vy * cs)
			img.Rotation = ang
		end
		if n == 1 then
			-- A single item: the whole annulus (no gap) as a thick stroked circle.
			sg.fill.Visible = false
			sg.line.Visible = false
			self:_single_ring(true, ri, ro2, fill, alpha, edge_a)
		else
			self:_single_ring(false)
			place(sg.fill, fd)
			place(sg.line, ld)
		end
		sg.fill.ImageColor3 = fill
		sg.fill.ImageTransparency = 1 - alpha
		sg.line.ImageColor3 = Color3.new(1, 1, 1)
		sg.line.ImageTransparency = 1 - edge_a * alpha
		-- Icon and label
		local mid = rad - math.pi * 0.5
		local rm = (ri + ro2) * 0.5
		local ip = Vector2.new(math.cos(mid), math.sin(mid)) * (rm - 5.0)
		sg.icon.Visible = true
		local iconName = tostring(it.icon or "info")
		if not JutsuGlyph.apply(sg.icon, iconName, 1 - icol_a * alpha) then
			sg.icon.Image = Th.icon(iconName) or ""
		end
		sg.icon.Position = UDim2.fromOffset(ip.X, ip.Y - 5)
		sg.icon.ImageColor3 = icol
		sg.icon.ImageTransparency = 1 - icol_a * alpha
		sg.label.Visible = true
		sg.label.Text = tostring(it.label or "")
		sg.label.TextSize = UICtx.ts(math.max(11, Th.min_font_size or 0))
		-- Godot draws the label with its baseline at ip.y + 12 + 9; Rubik ascent 0.935 em.
		sg.label.Position = UDim2.fromOffset(ip.X, ip.Y + 21 - 0.935 * math.max(11, Th.min_font_size or 0))
		sg.label.TextColor3 = icol
		sg.label.TextTransparency = 1 - icol_a * alpha * (if ok then 0.95 else 1.0)
	end
	-- Centre button (the ring's inner gap is tinted so the map does not bleed through).
	UICtx.set_circle(self._gap_disc, Vector2.zero, ri - 1.0)
	self._gap_disc.BackgroundTransparency = 1 - 0.55 * alpha
	local cr = ri - 8.0
	UICtx.set_circle(self._center_btn, Vector2.zero, cr)
	self._center_btn.BackgroundColor3 = if self._center_hover then rgb(0.14, 0.18, 0.3) else rgb(0.09, 0.12, 0.22)
	self._center_btn.BackgroundTransparency = 1 - alpha
	self._center_stroke.Transparency = 1 - 0.16 * alpha
	self._center_hover_drawn = self._center_hover
	self._center_icon.Image = Th.icon(if self._in_sub then "retreat" else "close") or ""
	self._center_icon.ImageColor3 = Th.TEXT_2
	self._center_icon.ImageTransparency = 1 - alpha
	-- Title above, caption below.
	local head = if self._in_sub then string.upper(self._sub_title) else self.title
	local hcol = if self._in_sub then Th.TEXT else self.title_color
	self:_set_pill(self._title_pill, Vector2.new(c.X, c.Y - ro * s - 16.0), head, hcol, alpha)
	local cap_text = ""
	local cap_col = Th.TEXT
	if self._hover >= 0 and self._hover < n then
		local it2 = self.items[self._hover + 1]
		local cap = tostring(it2.label or "")
		local sub = ""
		local sub_col = Th.TEXT_2
		if not it2.ok then
			sub = tostring(it2.reason or "")
			sub_col = rgb(1.0, 0.6, 0.62)
		elseif it2.cost ~= nil then
			sub = Th.fmt_cost(it2.cost) .. " gold"
			sub_col = Th.GOLD
		elseif it2.id == "donate" and it2.troops ~= nil then
			-- capped at the ally's troop headroom (UIRules.donate_plan)
			sub = if it2.capped
				then string.format("%s troops (fills their cap)", Th.fmt_troops(it2.troops))
				else string.format(
					"%s troops (%d%%)",
					Th.fmt_troops(it2.troops),
					math.floor(self.ctx.ratio * 100 + 0.5)
				)
		elseif it2.id == "attack" or it2.id == "boat" or it2.id == "donate" then
			sub = string.format(
				"%s troops (%d%%)",
				Th.fmt_troops(self.ctx:troops_for_ratio()),
				math.floor(self.ctx.ratio * 100 + 0.5)
			)
		end
		cap_text = if sub == "" then cap else cap .. "  ·  " .. sub
		cap_col = if sub ~= "" then sub_col else Th.TEXT
	end
	self:_set_pill(self._cap_pill, Vector2.new(c.X, c.Y + ro * s + 26.0), cap_text, cap_col, alpha)
end

--- n == 1: the full annulus (Frame circle with a thick stroke) + its two outlines.
function RadialMenu._single_ring(
	self: any,
	on: boolean,
	ri: number?,
	ro: number?,
	fill: Color3?,
	alpha: number?,
	edge_a: number?
)
	if not on then
		if self._solo then
			self._solo.fill.Visible = false
			self._solo.outer.Visible = false
			self._solo.inner.Visible = false
		end
		return
	end
	if self._solo == nil then
		self._solo = {
			fill = UICtx.ring(self._seg_holder, Vector2.zero, 10, 10, Color3.new(), 0),
			outer = UICtx.ring(self._seg_holder, Vector2.zero, 10, 1, Color3.new(1, 1, 1), 0),
			inner = UICtx.ring(self._seg_holder, Vector2.zero, 10, 1, Color3.new(1, 1, 1), 0),
		}
		self._solo.fill.ZIndex = 2
		self._solo.outer.ZIndex = 3
		self._solo.inner.ZIndex = 3
	end
	local a = alpha :: number
	local r_i = ri :: number
	local r_o = ro :: number
	local mid = (r_i + r_o) * 0.5
	local w = r_o - r_i
	UICtx.set_circle(self._solo.fill, Vector2.zero, mid)
	local st = self._solo.fill:FindFirstChild("Stroke") :: UIStroke
	st.Thickness = w
	st.Color = fill :: Color3
	st.Transparency = 1 - a
	for _, pair in { { self._solo.outer, r_o }, { self._solo.inner, r_i } } do
		local f = pair[1]
		f.Visible = true
		UICtx.set_circle(f, Vector2.zero, pair[2])
		local s2 = f:FindFirstChild("Stroke") :: UIStroke
		s2.Transparency = 1 - (edge_a :: number) * a
	end
	self._solo.fill.Visible = true
end

return RadialMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="212">
            <Properties>
              <string name="Name">RatioSlider</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The Attack bar: the share of the army an order sends, bound to UICtx.ratio. Five stops in one row
-- (UICtx.RATIO_STOPS: 10% 25% 35% 50% 75%), each one a labelled target: tap a stop, or drag across
-- them, and the amber thumb moves to it. The mouse wheel steps one stop.
--
-- It was a slider (a port of scripts/ui/ratio_slider.gd): 1% to 100% in steps of 1%, on a phone a
-- knob on a 96 px track, replaced 2026-10-08: it was too small and hard to drag to the right spot,
-- and a few fixed stops are simpler, at better breakpoints (10%, 25%, 35%,
-- 50%, 75%). The tutorial's step on it lost 19.4% of the players who reached it (Tutorial funnel,
-- 2026-10-07): what it asked for, 27% to 45%, was 17 px of that track.
--
-- A stop above UICtx.ratio_max (the tutorial stops at 50%) is drawn faint, and a tap on it sets the
-- highest stop allowed.

local UserInputService = game:GetService("UserInputService")

local UICtx = require("./UICtx") :: any
local UITheme = require("./UITheme")
local W = require("./Widgets")

local RatioSlider = W.class(W.Control)

function RatioSlider.new(c: any)
	local self = setmetatable({}, RatioSlider.__mt)
	W.Control._init(self)
	self.ctx = c
	self.gui.Name = "RatioSlider"
	--- The row's height (it sits in the middle of the control, whose whole rect takes input).
	self.track_height = 26.0
	--- The stops' text.
	self.font_size = 12
	self._drag = false
	self._hover = -1
	local _, at = UICtx.ratio_stop(c.ratio, c.ratio_max)
	--- Where the thumb is drawn: a stop's index, or between two while it moves.
	self._shown = at
	self:set_min_size(Vector2.new(170, 26))
	self:set_mouse_filter(W.MOUSE_STOP)
	local g = self.gui
	local function frame(name: string, z: number): (Frame, UICorner)
		local f = Instance.new("Frame")
		f.Name = name
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.zero
		f.ZIndex = z
		f.Active = false
		f.Parent = g
		local cr = Instance.new("UICorner")
		cr.Parent = f
		return f, cr
	end
	self._track, self._track_corner = frame("Track", 1)
	local ts = Instance.new("UIStroke")
	ts.Thickness = 1
	ts.Color = Color3.new(1, 1, 1)
	ts.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ts.Parent = self._track
	self._track_stroke = ts
	self._glow, self._glow_corner = frame("Glow", 2)
	self._thumb, self._thumb_corner = frame("Thumb", 3)
	self._labels = {}
	for i, stop in UICtx.RATIO_STOPS do
		local t = Instance.new("TextLabel")
		t.Name = "Stop" .. i
		t.BackgroundTransparency = 1
		t.BorderSizePixel = 0
		t.AnchorPoint = Vector2.zero
		t.RichText = false
		t.Active = false
		t.ZIndex = 4
		t.Text = string.format("%d%%", math.floor(stop * 100 + 0.5))
		t.TextXAlignment = Enum.TextXAlignment.Center
		t.TextYAlignment = Enum.TextYAlignment.Center
		t.Parent = g
		self._labels[i] = t
	end
	self:_connect(c.ratio_changed:Connect(function(_r)
		self:set_process(true)
		self:_redraw()
	end))
	self:_connect(g.MouseLeave:Connect(function()
		self._hover = -1
		self:_redraw()
	end))
	self:_connect(g.InputBegan:Connect(function(io: InputObject)
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			self._drag = true
			self._drag_input = io
			self:_set_from_global(W.screen_to_logical(W.input_pos(io), self))
			self.ctx:sfx("click", -10.0)
			self:_redraw()
		end
	end))
	self:_connect(g.InputChanged:Connect(function(io: InputObject)
		if io.UserInputType == Enum.UserInputType.MouseWheel and io.Position.Z ~= 0 then
			self.ctx:step_ratio(io.Position.Z)
		elseif io.UserInputType == Enum.UserInputType.MouseMovement then
			-- (the stop under the cursor reads brighter)
			local p = W.screen_to_logical(W.input_pos(io), self)
			local i = self:_stop_at(p.X - self:get_global_position().X)
			if i ~= self._hover then
				self._hover = i
				self:_redraw()
			end
		end
	end))
	self:_connect(UserInputService.InputChanged:Connect(function(io: InputObject)
		if not self._drag then
			return
		end
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseMovement or (t == Enum.UserInputType.Touch and io == self._drag_input) then
			local before = self.ctx.ratio
			self:_set_from_global(W.screen_to_logical(W.input_pos(io), self))
			if self.ctx.ratio ~= before then
				self.ctx:sfx("click", -14.0) -- (a tick for every stop the finger crosses)
			end
		end
	end))
	self:_connect(UserInputService.InputEnded:Connect(function(io: InputObject)
		if not self._drag then
			return
		end
		local t = io.UserInputType
		if t == Enum.UserInputType.MouseButton1 or (t == Enum.UserInputType.Touch and io == self._drag_input) then
			self._drag = false
			self._drag_input = nil
			self:_redraw()
		end
	end))
	return self
end

function RatioSlider._process(self, delta: number)
	local _, target = UICtx.ratio_stop(self.ctx.ratio, self.ctx.ratio_max)
	self._shown = self._shown + (target - self._shown) * (1 - math.exp(-delta * 24.0))
	if math.abs(self._shown - target) < 0.004 then
		self._shown = target
		self:set_process(false)
	end
	self:_redraw()
end

--- Second-finger drags (UITouchRouter): position in logical screen coordinates.
function RatioSlider.drag_to_global(self, p: Vector2)
	self:_set_from_global(p)
end

--- The stop (index in RATIO_STOPS) under local x.
function RatioSlider._stop_at(self, x: number): number
	local n = #UICtx.RATIO_STOPS
	return math.clamp(math.floor(x / math.max(self.size.X, 1.0) * n) + 1, 1, n)
end

function RatioSlider._set_from_global(self, p: Vector2)
	self:_set_from_x(p.X - self:get_global_position().X)
end

function RatioSlider._set_from_x(self, x: number)
	self.ctx:set_ratio(UICtx.RATIO_STOPS[self:_stop_at(x)])
end

--- The rect of the stop for `ratio` in logical screen coordinates (the tutorial points at it), or
--- nil when the bar has no stop there.
function RatioSlider.stop_rect(self, ratio: number): any
	local stops = UICtx.RATIO_STOPS
	for i, stop in stops do
		if math.abs(stop - ratio) < 1e-6 then
			local r = self:get_global_rect()
			local cw = r.Width / #stops
			local h = math.min(self.track_height, r.Height)
			return Rect.new(r.Min.X + (i - 1) * cw, r.Min.Y + (r.Height - h) * 0.5, r.Min.X + i * cw, r.Min.Y + (r.Height + h) * 0.5)
		end
	end
	return nil
end

function RatioSlider._on_geometry(self)
	self:_redraw()
end

function RatioSlider._restyle(self)
	self:_redraw()
end

local function set_rect(f: GuiObject, x: number, y: number, w: number, h: number)
	local s = UITheme.scale
	local x0 = math.floor(x * s + 0.5)
	local y0 = math.floor(y * s + 0.5)
	local x1 = math.floor((x + w) * s + 0.5)
	local y1 = math.floor((y + h) * s + 0.5)
	f.Position = UDim2.fromOffset(x0, y0)
	f.Size = UDim2.fromOffset(math.max(0, x1 - x0), math.max(0, y1 - y0))
end

function RatioSlider._redraw(self)
	if self._geo == nil then
		return
	end
	local ctx = self.ctx
	local s = UITheme.scale
	local stops = UICtx.RATIO_STOPS
	local n = #stops
	local w = self.size.X
	local th = math.min(self.track_height, self.size.Y)
	local ty = (self.size.Y - th) * 0.5
	local cw = w / n
	local _, at = UICtx.ratio_stop(ctx.ratio, ctx.ratio_max)
	local radius = math.min(th * 0.5, 10.0)
	-- the row
	set_rect(self._track, 0, ty, w, th)
	self._track_corner.CornerRadius = UDim.new(0, math.floor(radius * s + 0.5))
	self._track.BackgroundColor3 = Color3.new(1, 1, 1)
	self:_part(self._track, "BackgroundTransparency", 0.07)
	self:_part(self._track_stroke, "Transparency", 0.12)
	-- the thumb, on the stop in use (and a soft edge around it while it is held)
	local inset = 2.0
	local x = (self._shown - 1) * cw + inset
	local hot = self._drag
	self._glow.Visible = hot
	if hot then
		set_rect(self._glow, x - 2.0, ty + inset - 2.0, cw - inset * 2.0 + 4.0, th - inset * 2.0 + 4.0)
		self._glow_corner.CornerRadius = UDim.new(0, math.floor((radius - inset + 2.0) * s + 0.5))
		self._glow.BackgroundColor3 = UITheme.AMBER
		self:_part(self._glow, "BackgroundTransparency", 0.3)
	end
	set_rect(self._thumb, x, ty + inset, cw - inset * 2.0, th - inset * 2.0)
	self._thumb_corner.CornerRadius = UDim.new(0, math.floor((radius - inset) * s + 0.5))
	self._thumb.BackgroundColor3 = if hot then UITheme.AMBER_HI else UITheme.AMBER
	self:_part(self._thumb, "BackgroundTransparency", 1.0)
	-- the stops
	local ts = UITheme.text_size(self.font_size)
	local top = (ctx.ratio_max or 1.0) + 1e-6
	for i, t in self._labels do
		set_rect(t, (i - 1) * cw, ty, cw, th)
		t.TextSize = ts
		local on = i == at
		local locked = stops[i] > top
		t.FontFace = UITheme.font(if on then 800 else 700)
		if on then
			t.TextColor3 = UITheme.INK
			self:_part(t, "TextTransparency", 1.0)
		elseif locked then
			t.TextColor3 = UITheme.TEXT_3
			self:_part(t, "TextTransparency", 0.4)
		else
			t.TextColor3 = if i == self._hover then UITheme.TEXT else UITheme.TEXT_2
			self:_part(t, "TextTransparency", 1.0)
		end
	end
end

return RatioSlider
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="213">
            <Properties>
              <string name="Name">RotateCard</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/rotate_card.gd (UIRotateCard)
-- Full-screen "Rotate your phone" card shown on touch devices while the viewport is portrait
-- (the game is designed for landscape; StarterGui.ScreenOrientation normally keeps us there).

local UITheme = require("./UITheme")
local W = require("./Widgets")
local Signal = UITheme.core("Signal")

local RotateCard = W.class(W.Control)

function RotateCard.new(c: any)
	local self = setmetatable({}, RotateCard.__mt)
	W.Control._init(self)
	self.ctx = c
	self.changed = Signal.new()
	self._t = 0.0
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	local bg = W.ColorRect.new(UITheme.rgba(0.01, 0.015, 0.05, 0.96))
	bg:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	bg:set_mouse_filter(W.MOUSE_IGNORE)
	self:add_child(bg)
	local cc = UITheme.vbox(14)
	cc:set_alignment(W.ALIGN_CENTER)
	cc.anchor_left, cc.anchor_top, cc.anchor_right, cc.anchor_bottom = 0.5, 0.5, 0.5, 0.5
	cc.grow_horizontal = W.GROW_BOTH
	cc.grow_vertical = W.GROW_BOTH
	self:add_child(cc)
	self._icon = UITheme.icon_rect("app_icon", 72.0, Color3.new(1, 1, 1))
	self._icon.size_flags_horizontal = W.SHRINK_CENTER
	cc:add_child(self._icon)
	local t = UITheme.label("ROTATE YOUR PHONE", 22, 900, UITheme.AMBER, 3)
	t:set_alignment(W.ALIGN_CENTER)
	cc:add_child(t)
	local s = UITheme.label(
		"Shinobi Front is played in landscape.\nTurn your device sideways to continue.",
		15,
		500,
		UITheme.TEXT_2
	)
	s:set_alignment(W.ALIGN_CENTER)
	cc:add_child(s)
	self:set_visible(false)
	return self
end

--- Shows / hides the card for the current viewport; fires `changed` when that flips (UIRoot then
--- re-evaluates its world-input gate, so rotating back never re-enables input under a modal).
function RotateCard.refresh(self)
	local ctx = self.ctx
	local want = (ctx.touch_device or ctx.touch) and ctx.vp.Y > ctx.vp.X
	self:set_process(want)
	if want ~= self.visible then
		self:set_visible(want)
		self.changed:Fire(want)
	end
end

function RotateCard._process(self, delta: number)
	self._t += delta
	self._icon:set_rotation(math.sin(self._t * 2.2) * 0.35)
end

return RotateCard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="214">
            <Properties>
              <string name="Name">ShopButton</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The title screen's flag shop button (Data/Shop; 2026-10-22: a daily rotating shop of flags for
-- sale), under the Arsenal and crate buttons: a purple card with the shop's flags taking
-- turns on its left, FLAG SHOP, the running set's name (HALLOWEEN FLAGS) or NEW FLAGS DAILY, and the
-- clock to the next shop. A NEW sticker until the player has opened today's shop (setting
-- "shop_seen_day"). pressed() -> UIRoot opens the shop (FlagShop). Shown while the shop has something
-- on sale here (FlagShop.on_sale).
local UITheme = require("./UITheme")
local W = require("./Widgets")
local Signal = UITheme.core("Signal")
local FlagShop = require("./FlagShop")

local IS_ROBLOX = typeof(game) == "Instance"
local function shared(name: string): any
	if IS_ROBLOX then
		return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data[name]) :: any
	end
	return (require :: any)("../../shared/Data/" .. name)
end
local Shop = shared("Shop")
local Cosmetics = shared("Cosmetics")
local TweenService = if IS_ROBLOX then game:GetService("TweenService") else nil

local ShopButton = W.class(W.Control)

--- The card, desktop logical px (phones: PHONE_K of it).
ShopButton.SIZE = Vector2.new(232, 74)
ShopButton.PHONE_K = 0.72
--- A new flag on the card this often.
ShopButton.TURN_S = 2.6

local WHITE = Color3.new(1, 1, 1)
local PUMPKIN = Color3.fromRGB(255, 160, 60)
local LILAC = Color3.fromRGB(214, 196, 255)
local FONT_H = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Heavy)

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	if TweenService ~= nil then
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
			:Play()
	end
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.BackgroundTransparency = 1
	props.FontFace = props.FontFace or FONT_H
	props.TextColor3 = props.TextColor3 or WHITE
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return new("TextLabel", props, parent)
end

function ShopButton.new(c: any)
	local self = setmetatable({}, ShopButton.__mt)
	W.Control._init(self)
	self.ctx = c
	self.pressed = Signal.new()
	self._k = 1.0
	self._turn_t = 0.0
	self._turn = 0
	self._day = -1
	self._keys = {}
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:_build()
	self:set_visible(false)
	self:set_process(true)
	return self
end

function ShopButton._build(self)
	local root = self.gui
	root.ClipsDescendants = false
	local S = ShopButton.SIZE
	-- (built at SIZE and scaled, anchored at its middle: it grows from the centre, like the starter's)
	local body = new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(S.X, S.Y),
		ZIndex = 1,
	}, root)
	self._scale = new("UIScale", {}, body)
	local card = new("Frame", {
		Name = "Card",
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0, 14) }, card)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(122, 62, 214), Color3.fromRGB(42, 18, 92)),
		Rotation = 90,
	}, card)
	new("UIStroke", { Color = LILAC, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, card)
	self._flag = new("ImageLabel", {
		Name = "Flag",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(42, 37),
		Size = UDim2.fromOffset(66, 44),
		Rotation = -4,
		ZIndex = 4,
	}, card)
	new("UICorner", { CornerRadius = UDim.new(0, 5) }, self._flag)
	new("UIStroke", { Color = WHITE, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, self._flag)
	self._flag_scale = new("UIScale", {}, self._flag)
	text(card, {
		Text = "FLAG SHOP",
		TextSize = 17,
		Position = UDim2.fromOffset(84, 8),
		Size = UDim2.fromOffset(144, 20),
		ZIndex = 5,
	})
	self._what = text(card, {
		Text = "NEW FLAGS DAILY",
		TextSize = 12,
		TextColor3 = LILAC,
		Position = UDim2.fromOffset(84, 30),
		Size = UDim2.fromOffset(144, 16),
		ZIndex = 5,
	})
	self._clock = text(card, {
		Text = "NEW IN 0:00:00",
		TextSize = 12,
		TextColor3 = Color3.fromRGB(236, 230, 255),
		Position = UDim2.fromOffset(84, 48),
		Size = UDim2.fromOffset(144, 16),
		ZIndex = 5,
	})
	local sticker = new("Frame", {
		Name = "New",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(46, 190, 104),
		Position = UDim2.fromOffset(S.X - 12, 4),
		Size = UDim2.fromOffset(44, 22),
		Rotation = 10,
		Visible = false,
		ZIndex = 9,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0, 8) }, sticker)
	new("UIStroke", { Color = WHITE, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, sticker)
	text(sticker, {
		Text = "NEW",
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
	})
	self._sticker = sticker
	local hit = new("TextButton", {
		Name = "Hit",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
	}, body)
	local hover = false
	hit.MouseEnter:Connect(function()
		hover = true
		tween(self._scale, 0.12, { Scale = self:_k_px() * 1.05 })
	end)
	hit.MouseLeave:Connect(function()
		hover = false
		tween(self._scale, 0.12, { Scale = self:_k_px() })
	end)
	hit.MouseButton1Down:Connect(function()
		tween(self._scale, 0.08, { Scale = self:_k_px() * 0.95 })
	end)
	hit.MouseButton1Up:Connect(function()
		tween(self._scale, 0.12, { Scale = self:_k_px() * (if hover then 1.05 else 1) })
	end)
	hit.Activated:Connect(function()
		self.ctx:sfx("click")
		self.pressed:Fire()
	end)
end

function ShopButton._k_px(self): number
	return self._k * UITheme.scale
end

--- `k`: 1 on desktop, PHONE_K on phones (also follows UITheme.scale: call it from apply_layout).
function ShopButton.set_scale(self, k: number)
	self._k = k
	self._scale.Scale = self:_k_px()
	self:set_min_size(self:size_px())
end

function ShopButton.size_px(self): Vector2
	return ShopButton.SIZE * self._k
end

--- Shown while the shop sells something here; today's flags (the set's first) take turns on it.
function ShopButton.refresh(self)
	local on = FlagShop.on_sale()
	if on ~= self.visible then
		self:set_visible(on)
		if on then
			self._scale.Scale = self:_k_px() * 0.5
			tween(self._scale, 0.35, { Scale = self:_k_px() }, Enum.EasingStyle.Back)
		end
	end
	local t = FlagShop.now()
	local c = FlagShop.contents(t)
	self._day = c.day
	local keys = {}
	for _, s in c.sets do
		for _, k in s.keys do
			table.insert(keys, k)
		end
	end
	for _, k in c.daily do
		table.insert(keys, k)
	end
	self._keys = keys
	self._what.Text = if #c.sets > 0 then string.upper(c.sets[1].name) .. " FLAGS" else "NEW FLAGS DAILY"
	self._what.TextColor3 = if #c.sets > 0 then PUMPKIN else LILAC
	self._sticker.Visible = self.ctx:setting("shop_seen_day", -1) ~= c.day
	self:_show_flag()
end

function ShopButton._show_flag(self)
	local key = self._keys[(self._turn % math.max(1, #self._keys)) + 1]
	local it = if key ~= nil then Cosmetics.item(Shop.item_id(key)) else nil
	if it == nil then
		self._flag.Image = ""
		return
	end
	local image, x, y, w, h = Cosmetics.flag_big(it)
	self._flag.Image = image
	self._flag.ImageRectOffset = Vector2.new(x, y)
	self._flag.ImageRectSize = Vector2.new(w, h)
end

function ShopButton._process(self, dt: number)
	if not self.visible then
		return
	end
	local t = FlagShop.now()
	if Shop.day(t) ~= self._day then
		self:refresh()
	end
	self._clock.Text = "NEW IN " .. FlagShop.clock(Shop.next_in(t))
	self._turn_t += dt
	if self._turn_t >= ShopButton.TURN_S and #self._keys > 1 then
		self._turn_t = 0
		self._turn += 1
		self:_show_flag()
		self._flag_scale.Scale = 0.6
		tween(self._flag_scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	self._flag.Rotation = -4 + math.sin(os.clock() * 1.6) * 2
end

return ShopButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="215">
            <Properties>
              <string name="Name">ShopLayout</string>
              <string name="Source"><![CDATA[--!strict
-- The flag shop's layout (UI/FlagShop), apart so tests can run it without Roblox: the order of a
-- section's cards and where each goes, with a section's Legendary on a FEATURED card 2 x 2 cells big
-- (2026-10-24).
local IS_ROBLOX = typeof(game) == "Instance"
local Shop: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Shop)
	else (require :: any)("../../shared/Data/Shop")

local ShopLayout = {}

--- Where the cards go in a grid `cols` wide: with `hero`, the first is the FEATURED card on the
--- top-left 2 x 2 cells and the other `n` - 1 fill the cells around it row by row. { {col, row} } (0-based,
--- the hero's first), and the rows used.
function ShopLayout.place(n: number, hero: boolean, cols: number): ({ { number } }, number)
	cols = math.max(2, cols)
	local taken: { [number]: boolean } = {}
	local cells = {}
	local rows = 0
	local start = 1
	if hero and n > 0 then
		table.insert(cells, { 0, 0 })
		for _, c in { 0, 1, cols, cols + 1 } do
			taken[c] = true
		end
		rows = 2
		start = 2
	end
	local k = 0
	for _ = start, n do
		while taken[k] do
			k += 1
		end
		taken[k] = true
		table.insert(cells, { k % cols, k // cols })
		rows = math.max(rows, k // cols + 1)
		k += 1
	end
	return cells, rows
end

--- The keys rarest first (the priciest as the shop's eye-catchers), and whether the first is a Legendary
--- that gets the FEATURED card.
function ShopLayout.order(keys: { string }): ({ string }, boolean)
	local list = table.clone(keys)
	local rank = { legendary = 1, epic = 2, rare = 3 }
	table.sort(list, function(a, b)
		local fa, fb = Shop.flag(a), Shop.flag(b)
		local ra, rb = rank[fa and fa.rarity or ""] or 9, rank[fb and fb.rarity or ""] or 9
		if ra ~= rb then
			return ra < rb
		end
		return (fa and fa.name or a) < (fb and fb.name or b)
	end)
	local top = Shop.flag(list[1])
	return list, #list > 1 and top ~= nil and top.rarity == "legendary"
end

return ShopLayout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="216">
            <Properties>
              <string name="Name">ShopSlot</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The SHOP button that closes the build row (CommandBar): one gold button, a little wider than a build
-- slot, that opens the Arsenal (2026-10-12: one button instead of six sub-buttons, as too few players
-- were opening the shop and more of them should click it; from 2026-10-05
-- it held a small card for each locked unit, before that it was a plain glass slot).
--
-- Solid gold with SHOP on it in dark letters. Over the word, the render of something the player has
-- yet to get (Assets/ArsenalArt.renders, the shop cards' pictures), a new one every CYCLE_S; a shine
-- crosses it every SHINE_S. Until the player has opened the Arsenal in this session, a red badge
-- counts what there is to get and the button gives a little shake every WIGGLE_S. With everything
-- got it is the Arsenal's shield over SHOP, still gold.
--
-- A press opens the Arsenal on the item it shows.
--
-- Signals: wanted(key: string?, from: string) (from: "match", for the analytics).
local UITheme = require("./UITheme")
local JutsuGlyph = require("./JutsuGlyph")
local W = require("./Widgets")
local Signal = UITheme.core("Signal")

local IS_ROBLOX = typeof(game) == "Instance"
local TweenService = if IS_ROBLOX then game:GetService("TweenService") else nil
local function airfront(folder: string, name: string): any
	if IS_ROBLOX then
		return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront")[folder][name]) :: any
	end
	return (require :: any)("../../shared/" .. folder .. "/" .. name)
end
local Catalog = airfront("Data", "Arsenal")
local Art: any = (function()
	local ok, m = pcall(airfront, "Assets", "ArsenalArt")
	return if ok and type(m) == "table" then m else {}
end)()

local ShopSlot = W.class(W.Control)

--- A new item every this long, the crossfade's length, a shine every this long, a shake every this
--- long (while the badge shows).
ShopSlot.CYCLE_S = 2.4
ShopSlot.FADE_S = 0.3
ShopSlot.SHINE_S = 3.2
ShopSlot.WIGGLE_S = 6.4
--- The strip at the bottom the word SHOP sits in, logical px.
ShopSlot.CAPTION_H = 17.0

local GOLD_LIGHT = Color3.fromRGB(255, 226, 122)
local GOLD_DEEP = Color3.fromRGB(238, 148, 28)
local INK = Color3.fromRGB(52, 28, 2)
local RED = Color3.fromRGB(232, 52, 52)
local FONT_H = Font.fromId(12187365977, Enum.FontWeight.Heavy)

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	if TweenService ~= nil then
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
			:Play()
	end
end

function ShopSlot.new(c: any)
	local self = setmetatable({}, ShopSlot.__mt)
	W.Control._init(self)
	self.ctx = c
	self.wanted = Signal.new()
	--- the items shown, in shop order
	self._items = {} :: { any }
	self._sig = nil :: string?
	--- the Arsenal was opened from here in this session (the badge and the shake stop)
	self._seen = false
	self._t = 0.0
	self._hover = false
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:_build()
	self:set_block(58.0, 60.0)
	self:set_process(true)
	return self
end

function ShopSlot._build(self)
	local root = self.gui
	root.ClipsDescendants = false
	local body = new("Frame", {
		Name = "Shop",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
	}, root)
	self._body = body
	self._scale = new("UIScale", {}, body)
	local ground = new("Frame", {
		Name = "Ground",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
	}, body)
	self._corner = new("UICorner", {}, ground)
	-- (a UIGradient multiplies the frame's colour: the frame is white)
	self._grad = new("UIGradient", { Color = ColorSequence.new(GOLD_LIGHT, GOLD_DEEP), Rotation = 90 }, ground)
	self._stroke = new("UIStroke", {
		Color = INK,
		Thickness = 1.5,
		Transparency = 0.25,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, ground)
	-- the two pictures it crossfades between, and its shield when there is nothing left to get
	self._pics = {}
	for i = 1, 2 do
		self._pics[i] = new("ImageLabel", {
			Name = "Item" .. i,
			BackgroundTransparency = 1,
			Image = "",
			ImageTransparency = 1,
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 3,
		}, body)
	end
	self._shield = new("ImageLabel", {
		Name = "Shield",
		BackgroundTransparency = 1,
		Image = UITheme.icon("arsenal") or "",
		ImageColor3 = INK,
		ScaleType = Enum.ScaleType.Fit,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 3,
	}, body)
	JutsuGlyph.apply(self._shield, "arsenal")
	self._cap = new("TextLabel", {
		Name = "Caption",
		BackgroundTransparency = 1,
		Text = "SHOP",
		FontFace = FONT_H,
		TextColor3 = INK,
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 4,
	}, body)
	-- the shine: a bright band in a gradient's transparency, moved across by its offset
	local shine = new("Frame", {
		Name = "Shine",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 5,
	}, body)
	self._shine_corner = new("UICorner", {}, shine)
	self._shine = new("UIGradient", {
		Rotation = 24,
		Offset = Vector2.new(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.4, 1),
			NumberSequenceKeypoint.new(0.5, 0.45),
			NumberSequenceKeypoint.new(0.6, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, shine)
	-- the count of what there is to get, top right
	local badge = new("TextLabel", {
		Name = "Badge",
		BackgroundColor3 = RED,
		Text = "",
		FontFace = FONT_H,
		TextColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 7,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, badge)
	new(
		"UIStroke",
		{ Color = Color3.fromRGB(90, 10, 10), Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border },
		badge
	)
	self._badge = badge
	local hit = new("TextButton", {
		Name = "Hit",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
	}, root)
	hit.MouseEnter:Connect(function()
		self._hover = true
		tween(self._scale, 0.12, { Scale = 1.06 })
		if not self.ctx.touch then
			self.ctx:sfx("hover", -12.0)
		end
	end)
	hit.MouseLeave:Connect(function()
		self._hover = false
		tween(self._scale, 0.12, { Scale = 1 })
	end)
	hit.MouseButton1Down:Connect(function()
		tween(self._scale, 0.08, { Scale = 0.93 })
	end)
	hit.MouseButton1Up:Connect(function()
		tween(self._scale, 0.12, { Scale = if self._hover then 1.06 else 1 })
	end)
	hit.Activated:Connect(function()
		self._seen = true
		self._badge.Visible = false
		self.wanted:Fire(self:_current_key(), "match")
	end)
end

--- The slot's size in the row (logical px).
function ShopSlot.set_block(self, w: number, h: number)
	self:set_min_size(Vector2.new(w, h))
	self:_place()
end

--- The Arsenal items the player has yet to get, in shop order.
function ShopSlot.locked(self): { any }
	local out = {}
	local s = self.ctx.session
	local has = s ~= nil and type(s.has_unlock) == "function"
	for _, it in Catalog.ITEMS do
		if not (has and s:has_unlock(it.key)) then
			table.insert(out, it)
		end
	end
	return out
end

--- Sizes the parts (raw instances: px, logical x UITheme.scale).
function ShopSlot._place(self)
	local size = if self.size.X > 0 and self.size.Y > 0 then self.size else self.custom_minimum_size
	local u = UITheme.scale
	local w, h = size.X * u, size.Y * u
	local r = UDim.new(0, UITheme.R_MD * u)
	self._corner.CornerRadius = r
	self._shine_corner.CornerRadius = r
	local cap_h = ShopSlot.CAPTION_H * u
	self._cap.TextSize = math.floor(12 * u)
	self._cap.Position = UDim2.new(0.5, 0, 1, -3 * u)
	self._cap.Size = UDim2.new(1, 0, 0, cap_h)
	local art_h = math.max(8, h - cap_h - 5 * u)
	self._art_cy = 3 * u + art_h / 2
	for _, p in self._pics do
		p.Size = UDim2.fromOffset(w - 10 * u, art_h)
		p.Position = UDim2.fromOffset(w / 2, self._art_cy)
	end
	self._shield.Size = UDim2.fromOffset(art_h * 0.8, art_h * 0.8)
	self._shield.Position = UDim2.fromOffset(w / 2, self._art_cy)
	local bd = math.floor(16 * u)
	self._badge.Size = UDim2.fromOffset(bd, bd)
	self._badge.TextSize = math.floor(11 * u)
	self._badge.Position = UDim2.new(1, -3 * u, 0, 3 * u)
	self._art_w, self._art_h = w - 10 * u, art_h
end

function ShopSlot._on_resized(self)
	self:_place()
end

--- The item the button shows now (nil: it shows the shield).
function ShopSlot._current_key(self): string?
	local n = #self._items
	if n == 0 then
		return nil
	end
	local i = math.floor(self._t / ShopSlot.CYCLE_S) % n + 1
	return self._items[i].key
end

--- Follows what the player has yet to get (true when that changed: the slot may want another
--- width).
function ShopSlot.refresh(self): boolean
	local items = self:locked()
	local keys = {}
	for i, it in items do
		keys[i] = it.key
	end
	local sig = table.concat(keys, ",")
	local changed = sig ~= self._sig
	if changed then
		self._sig = sig
		-- (only items with a picture cycle; every item has one)
		local shown = {}
		for _, it in items do
			if type(Art.renders) == "table" and Art.renders[it.key] ~= nil then
				table.insert(shown, it)
			end
		end
		self._items = shown
		self._shield.Visible = #shown == 0
		self._badge.Text = tostring(#items)
		self._badge.Visible = #items > 0 and not self._seen
		for _, p in self._pics do
			p.Visible = #shown > 0
		end
	end
	return changed
end

function ShopSlot._process(self, dt: number)
	if not self:is_visible_in_tree() then
		return
	end
	self._t += dt
	local t = self._t
	-- the pictures: the current one fades and pops in over the one before
	local n = #self._items
	if n > 0 then
		local i = math.floor(t / ShopSlot.CYCLE_S)
		local cur = self._pics[i % 2 + 1]
		local prev = self._pics[(i + 1) % 2 + 1]
		local k = math.clamp((t % ShopSlot.CYCLE_S) / ShopSlot.FADE_S, 0, 1)
		local current = self._items[i % n + 1]
		local previous = self._items[(i - 1) % n + 1]
		JutsuGlyph.apply(cur, if current.kind == "boost" then "arsenal" else current.icon, 1 - k)
		JutsuGlyph.apply(prev, if previous.kind == "boost" then "arsenal" else previous.icon, if n > 1 then k else 1)
		local bob = math.sin(t * 2.2) * (self._art_h or 30) * 0.03
		local pop = 0.82 + 0.18 * (1 - (1 - k) ^ 3)
		local aw, ah = self._art_w or 50, self._art_h or 30
		cur.Size = UDim2.fromOffset(aw * pop, ah * pop)
		cur.Position = UDim2.fromOffset(cur.Position.X.Offset, (self._art_cy or 20) + bob)
		prev.Size = UDim2.fromOffset(aw, ah)
		prev.Position = UDim2.fromOffset(prev.Position.X.Offset, (self._art_cy or 20) + bob)
		cur.Rotation = math.sin(t * 1.4) * 3
		prev.Rotation = cur.Rotation
	end
	-- the shine, now and then
	local sk = (t % ShopSlot.SHINE_S) / 0.75
	self._shine.Offset = Vector2.new(if sk < 1 then -1 + 2 * sk else -1, 0)
	-- and the shake, until the Arsenal has been opened from here
	local rot = 0
	if not self._seen then
		local wk = (t % ShopSlot.WIGGLE_S) / 0.55
		if wk < 1 then
			rot = math.sin(wk * math.pi * 4) * 7 * (1 - wk)
		end
	end
	self._body.Rotation = rot
end

return ShopSlot
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="217">
            <Properties>
              <string name="Name">SpawnOverlay</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/spawn_overlay.gd (UISpawnOverlay)
-- Spawn-phase banner: "Choose your starting location", a countdown ring, the solo "Deploying in 5…"
-- count and, in multiplayer, how many commanders have placed their capitals.
--
-- One slim row: two lines of text, the count (on a wide screen with a few of the commanders' head
-- shots before it) and the ring. It was a tall panel once: an icon disc, a line of advice and a
-- chip per commander, up to twelve of them over five rows: too big, so it was redesigned smaller
-- (2026-10-05).

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local Defs = UICtx.core("Defs")

local _Rules = nil
local function Rules()
	if _Rules == nil then
		_Rules = UICtx.core("Rules")
	end
	return _Rules
end

local SpawnOverlay = W.class(W.Control)

--- The title's size on a wide screen (phones: 13).
SpawnOverlay.TITLE_PX = 14
--- The ring's side on a wide screen (phones: 36).
SpawnOverlay.RING_PX = 40
--- A wide screen shows up to HEADS commanders' head shots, HEAD_PX wide, each over the last by
--- HEAD_OVERLAP: the ones who have placed first, the rest dimmed.
SpawnOverlay.HEADS = 5
SpawnOverlay.HEAD_PX = 20
SpawnOverlay.HEAD_OVERLAP = 6

--- Countdown ring (GDScript inner class Ring): track circle, amber / red arc, seconds.
local function make_ring()
	local ring = UICtx.draw_node(function(n)
		n:_draw_ring()
	end)
	ring.frac = 1.0
	ring.secs = 0
	ring.urgent = false
	ring:set_min_size(Vector2.new(54, 54))
	ring.track = UICtx.ring(ring.canvas, Vector2.zero, 10, 4, Color3.new(1, 1, 1), 0.9)
	ring.arc = UICtx.arc(ring.canvas)
	ring.num = UICtx.make("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = UITheme.font(800),
		TextSize = UICtx.ts(20),
		TextColor3 = UITheme.TEXT,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
		ZIndex = 3,
	}, ring.canvas)
	function ring._draw_ring(self)
		local sz = self.size
		local c = sz * 0.5
		local r = math.min(sz.X, sz.Y) * 0.5 - 3.0
		UICtx.set_circle(self.track, c, r)
		self.arc:place(c, r, 4)
		local col = if self.urgent then UITheme.RED else UITheme.AMBER
		self.arc:set(if self.frac > 0 then self.frac else 0, col, 0)
		self.arc.frame.Visible = self.frac > 0
		-- draw_string(font 800, size 20) with its baseline at c.y + 20 * 0.36
		self.num.Text = tostring(self.secs)
		self.num.Size = UDim2.fromOffset(sz.X, UICtx.ts(20))
		self.num.Position = UDim2.fromOffset(0, UICtx.top_for_baseline(c.Y + 20 * 0.36, 20))
	end
	function ring.queue_redraw(self)
		if self._geo ~= nil then
			self:_draw_ring()
		end
	end
	return ring
end

function SpawnOverlay.new(c: any)
	local self = setmetatable({}, SpawnOverlay.__mt)
	W.Control._init(self)
	self.ctx = c
	self._end_tick = -1.0
	self._total = 1.0
	self._last_sec = -1
	self._accum = 0.0
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	local panel = GlassPanel.new(22.0, 14.0, UITheme.R_LG, true, 24)
	panel:set_mouse_filter(W.MOUSE_IGNORE)
	self.panel = panel
	self:add_child(panel)
	local row = UITheme.hbox(14)
	self._row = row
	panel:add_child(row)
	local v = UITheme.vbox(1)
	v.size_flags_vertical = W.SHRINK_CENTER
	self._title = UITheme.label("CHOOSE YOUR STARTING LOCATION", SpawnOverlay.TITLE_PX, 800, UITheme.TEXT, 1.5)
	v:add_child(self._title)
	self._sub = UITheme.label("Click any unclaimed land to place your capital.", 12, 500, UITheme.TEXT_2)
	v:add_child(self._sub)
	-- phones: the count is a third line under the text
	self._placed = UITheme.label("", 12, 600, UITheme.TEXT_3)
	self._placed:set_visible(false)
	v:add_child(self._placed)
	row:add_child(v)
	-- a wide screen: the count beside the text, behind a few head shots
	self._side = UITheme.hbox(8)
	self._side.size_flags_vertical = W.SHRINK_CENTER
	self._side:add_child(UITheme.vdivider(26.0))
	self._heads = UITheme.hbox(-SpawnOverlay.HEAD_OVERLAP)
	self._heads.size_flags_vertical = W.SHRINK_CENTER
	self._side:add_child(self._heads)
	self._count = UITheme.label("", 12, 700, UITheme.TEXT_2)
	self._count.size_flags_vertical = W.SHRINK_CENTER
	self._side:add_child(self._count)
	self._side:set_visible(false)
	row:add_child(self._side)
	self._ring = make_ring()
	self._ring.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(self._ring)
	self:set_process(true)
	return self
end

function SpawnOverlay.apply_layout(self)
	local ctx = self.ctx
	local panel = self.panel
	panel:set_mouse_filter(if ctx.touch then W.MOUSE_STOP else W.MOUSE_IGNORE)
	local top = 12.0 + ctx.insets.y
	if ctx.compact then
		-- Phones: slimmer still, leaving the globe to the player.
		top = 8.0 + ctx.insets.y
		self._title:set_font_size(13)
		panel:set_padding(12.0, 4.0, 8.0, 4.0)
		self._ring:set_min_size(Vector2.new(36, 36))
		self._row:set_separation(10)
	else
		self._title:set_font_size(SpawnOverlay.TITLE_PX)
		panel:set_padding(16.0, 8.0, 12.0, 8.0)
		self._ring:set_min_size(Vector2.new(SpawnOverlay.RING_PX, SpawnOverlay.RING_PX))
		self._row:set_separation(14)
	end
	panel.anchor_left = 0.5
	panel.anchor_right = 0.5
	panel.anchor_top = 0.0
	panel.anchor_bottom = 0.0
	panel.grow_horizontal = W.GROW_BOTH
	panel.grow_vertical = W.GROW_END
	local dx, y = ctx:place_top(panel:get_combined_minimum_size().X, top)
	panel.offset_left = dx
	panel.offset_right = dx
	panel.offset_top = y
	panel.offset_bottom = y
	panel:reset_size()
end

function SpawnOverlay.bottom_edge(self): number
	local r = self.panel:get_global_rect()
	return r.Max.Y
end

function SpawnOverlay.on_show(self)
	self._last_sec = -1
	self:refresh()
	UICtx.pop_in(self.panel, 0.05, 0.94, 0.45)
end

function SpawnOverlay.on_phase(self, ticks_left: number)
	local ctx = self.ctx
	local s = ctx.state
	if s == nil then
		return
	end
	self._end_tick = if ticks_left > 0 then s.tick + ticks_left else -1.0
	if ticks_left > 0 then
		local R = Rules()
		local solo_total = if ctx:mode() == UICtx.MODE_SOLO then R.SOLO_COUNTDOWN_TICKS else R.DEFAULT_SPAWN_TICKS
		self._total = math.max(ticks_left, solo_total) / Defs.TICK_RATE
	end
	self:refresh()
end

function SpawnOverlay.refresh(self)
	local ctx = self.ctx
	local s = ctx.state
	if s == nil then
		return
	end
	local o = ctx:my()
	local placed = o ~= nil and o.spawned
	local solo = ctx:mode() == UICtx.MODE_SOLO
	local left = -1.0
	if self._end_tick > 0.0 then
		left = math.max(0.0, (self._end_tick - ctx:render_tick()) / Defs.TICK_RATE)
	end
	local ring = self._ring
	ring:set_visible(left >= 0.0 and s.phase == Defs.PHASE_SPAWN)
	if left >= 0.0 then
		ring.frac = math.clamp(left / math.max(self._total, 0.1), 0.0, 1.0)
		ring.secs = math.ceil(left)
		ring.urgent = left <= 5.0
		ring:queue_redraw()
		local sec = math.ceil(left)
		if sec ~= self._last_sec and sec <= 5 and sec > 0 and self._last_sec >= 0 then
			ctx:sfx("tick", if sec > 1 then -4.0 else 0.0, 0.0)
		end
		self._last_sec = sec
	end
	local late = s.phase == Defs.PHASE_PLAYING
	local verb = if ctx.touch then "Tap" else "Click"
	if ctx:me() == 0 then
		self._title:set_text("COMMANDERS ARE DEPLOYING")
		self._sub:set_text("You are spectating this match.")
	elseif late and not placed then
		self._title:set_text("DROP INTO THE WAR")
		self._sub:set_text(verb .. " any unclaimed land to deploy your capital.")
	elseif placed and solo and left >= 0.0 then
		self._title:set_text(string.format("DEPLOYING IN %d", math.ceil(left)))
		self._sub:set_text(verb .. " elsewhere to relocate your capital.")
	elseif placed then
		self._title:set_text("CAPITAL PLACED")
		self._sub:set_text(verb .. " elsewhere to relocate until the countdown ends.")
	else
		self._title:set_text("CHOOSE YOUR STARTING LOCATION")
		self._sub:set_text(
			if not ctx.touch
				then "Click any unclaimed land to place your capital."
				else "Tap any unclaimed land to place your capital."
		)
	end
	self:_refresh_players()
	self.panel:reset_size()
end

function SpawnOverlay._refresh_players(self)
	local ctx = self.ctx
	local s = ctx.state
	local mp = ctx:mode() == UICtx.MODE_MULTI
	self._side:set_visible(mp and not ctx.compact)
	self._placed:set_visible(mp and ctx.compact)
	if not mp or s == nil then
		return
	end
	local humans = {}
	local placed = 0
	for _, o in pairs(s.owners) do
		if o.kind == Defs.KIND_HUMAN and o.alive then
			table.insert(humans, o)
			if o.spawned then
				placed += 1
			end
		end
	end
	if ctx.compact then
		self._placed:set_text(string.format("%d / %d commanders placed", placed, #humans))
		return
	end
	self._count:set_text(string.format("%d / %d placed", placed, #humans))
	-- the head shots (the cosmetics map's `face`, as in the leaderboard and on the map): those who
	-- have placed first
	table.sort(humans, function(a, b)
		if a.spawned ~= b.spawned then
			return a.spawned == true
		end
		return a.id < b.id
	end)
	local cosmetics = s.cosmetics or {}
	local shown = {}
	local key = ""
	for _, h in ipairs(humans) do
		local cz = cosmetics[h.id]
		if cz ~= nil and cz.face ~= nil then
			table.insert(shown, h)
			key ..= string.format("%d:%d:%d;", h.id, if h.spawned then 1 else 0, cz.face)
			if #shown >= SpawnOverlay.HEADS then
				break
			end
		end
	end
	if self._heads:get_meta("key", "") == key then
		return
	end
	self._heads:set_meta("key", key)
	for _, ch in ipairs(self._heads:get_children()) do
		ch:queue_free()
	end
	self._heads:set_visible(#shown > 0)
	for _, h in ipairs(shown) do
		local img = Instance.new("ImageLabel")
		img.BackgroundColor3 = Color3.fromRGB(40, 52, 82)
		img.BorderSizePixel = 0
		img.Image = UICtx.data("Cosmetics").face_image(cosmetics[h.id].face)
		img.ImageTransparency = if h.spawned then 0 else 0.55
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = img
		-- (a rim of the panel's colour parts it from the head under it; green once they have placed)
		local rim = Instance.new("UIStroke")
		rim.Thickness = 1.5
		rim.Color = UITheme.color3(if h.spawned then UITheme.GREEN else Color3.fromRGB(16, 22, 40))
		rim.Parent = img
		local head = W.wrap(img)
		head:set_min_size(Vector2.new(SpawnOverlay.HEAD_PX, SpawnOverlay.HEAD_PX))
		head.size_flags_vertical = W.SHRINK_CENTER
		head:set_mouse_filter(W.MOUSE_IGNORE)
		self._heads:add_child(head)
	end
end

function SpawnOverlay._process(self, delta: number)
	self._accum += delta
	if self._accum >= 0.1 and self:is_visible_in_tree() then
		self._accum = 0.0
		self:refresh()
	end
end

return SpawnOverlay
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="218">
            <Properties>
              <string name="Name">StarterButton</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The title screen's starter pack button, under the Arsenal and crate buttons, while the starter pack's
-- offer runs (Data/Starter; 2026-10-15: available for a limited time only): a red card with the
-- Mega Nuke's render, STARTER PACK, the regular price struck through
-- beside the offer's, ENDS IN and the clock, a red "-76%" sticker on its corner and a light that
-- crosses it every few seconds. pressed() -> UIRoot opens the offer (StarterOffer). Hidden when there
-- is no running offer.
local UITheme = require("./UITheme")
local W = require("./Widgets")
local Signal = UITheme.core("Signal")
local StarterOffer = require("./StarterOffer")

local IS_ROBLOX = typeof(game) == "Instance"
local function shared(folder: string, name: string): any
	if IS_ROBLOX then
		return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront")[folder][name]) :: any
	end
	return (require :: any)("../../shared/" .. folder .. "/" .. name)
end
local Art: any = (function()
	local ok, m = pcall(shared, "Assets", "ArsenalArt")
	return if ok and type(m) == "table" then m else {}
end)()
local TweenService = if IS_ROBLOX then game:GetService("TweenService") else nil

local StarterButton = W.class(W.Control)

--- The card, desktop logical px (phones: PHONE_K of it).
StarterButton.SIZE = Vector2.new(232, 82)
StarterButton.PHONE_K = 0.72
--- The light crosses it this often.
StarterButton.SHINE_S = 3.4

local GOLD = Color3.fromRGB(255, 200, 61)
local WHITE = Color3.new(1, 1, 1)
local PINK = Color3.fromRGB(255, 186, 186)
local RED = Color3.fromRGB(232, 46, 56)
local ROBUX = "rbxasset://textures/ui/common/robux@3x.png"
local FONT_H = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Heavy)

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	if TweenService ~= nil then
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
			:Play()
	end
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.BackgroundTransparency = 1
	props.FontFace = props.FontFace or FONT_H
	props.TextColor3 = props.TextColor3 or WHITE
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return new("TextLabel", props, parent)
end

function StarterButton.new(c: any)
	local self = setmetatable({}, StarterButton.__mt)
	W.Control._init(self)
	self.ctx = c
	self.pressed = Signal.new()
	self._k = 1.0
	self._t = 0.0
	self._shine_t = 0.0
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:_build()
	self:set_visible(false)
	self:set_process(true)
	return self
end

function StarterButton._build(self)
	local root = self.gui
	root.ClipsDescendants = false
	local S = StarterButton.SIZE
	-- everything is built at SIZE and scaled (phones, UITheme.scale, hover / press); anchored at its middle
	-- so it pops in and grows from the centre, not from its top-left corner (2026-10-15),
	-- and at its resting scale it fills the control exactly
	local body = new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(S.X, S.Y),
		ZIndex = 1,
	}, root)
	self._scale = new("UIScale", {}, body)
	self._body = body
	local card = new("Frame", {
		Name = "Card",
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0, 14) }, card)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(236, 64, 60), Color3.fromRGB(124, 12, 34)),
		Rotation = 90,
	}, card)
	new("UIStroke", { Color = GOLD, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, card)
	local crate = UITheme.crate_art()
	new("ImageLabel", {
		Name = "Glow",
		BackgroundTransparency = 1,
		Image = crate.glow or "",
		ImageColor3 = Color3.fromRGB(255, 190, 120),
		ImageTransparency = 0.35,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(40, 42),
		Size = UDim2.fromOffset(96, 90),
		ZIndex = 3,
	}, card)
	local r = (Art.renders or {}).mega
	local iw, ih = 56, 70
	if type(r) == "table" and r.w and r.h then
		local k = math.min(64 / r.w, 70 / r.h)
		iw, ih = r.w * k, r.h * k
	end
	self._art = new("ImageLabel", {
		Name = "Art",
		BackgroundTransparency = 1,
		Image = if type(r) == "table" then r.id else "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(40, 42),
		Size = UDim2.fromOffset(iw, ih),
		ZIndex = 4,
	}, card)
	text(card, {
		Text = "STARTER PACK",
		TextSize = 17,
		Position = UDim2.fromOffset(78, 7),
		Size = UDim2.fromOffset(150, 20),
		ZIndex = 5,
	})
	-- the prices: the regular one struck through, the offer's in gold
	local row = new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(78, 28),
		Size = UDim2.fromOffset(150, 26),
		ZIndex = 5,
	}, card)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, row)
	self._was = text(row, {
		Text = "165",
		TextSize = 14,
		TextColor3 = PINK,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 26),
		LayoutOrder = 1,
		ZIndex = 5,
	})
	self._strike = new("Frame", {
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -2, 0.5, 0),
		Size = UDim2.new(1, 4, 0, 2),
		ZIndex = 6,
	}, self._was)
	new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = ROBUX,
		ImageColor3 = GOLD,
		Size = UDim2.fromOffset(18, 18),
		LayoutOrder = 2,
		ZIndex = 5,
	}, row)
	self._price = text(row, {
		Text = "39",
		TextSize = 24,
		TextColor3 = GOLD,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 26),
		LayoutOrder = 3,
		ZIndex = 5,
	})
	self._clock = text(card, {
		Text = "ENDS IN 48:00:00",
		TextSize = 12,
		TextColor3 = Color3.fromRGB(255, 232, 220),
		Position = UDim2.fromOffset(78, 56),
		Size = UDim2.fromOffset(150, 18),
		ZIndex = 5,
	})
	self._shine = new("Frame", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(-0.2, 0, 0.5, 0),
		Size = UDim2.new(0, 26, 1.8, 0),
		Rotation = 18,
		ZIndex = 7,
	}, card)
	-- the sticker, out over the corner
	local sticker = new("Frame", {
		Name = "Sticker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = RED,
		Position = UDim2.fromOffset(S.X - 14, 6),
		Size = UDim2.fromOffset(46, 46),
		Rotation = 14,
		ZIndex = 9,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, sticker)
	new("UIStroke", { Color = WHITE, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, sticker)
	self._sticker = sticker
	self._off = text(sticker, {
		Text = "-76%",
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
	})
	-- the hit area
	local hit = new("TextButton", {
		Name = "Hit",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
	}, body)
	local hover = false
	hit.MouseEnter:Connect(function()
		hover = true
		tween(self._scale, 0.12, { Scale = self:_k_px() * 1.05 })
	end)
	hit.MouseLeave:Connect(function()
		hover = false
		tween(self._scale, 0.12, { Scale = self:_k_px() })
	end)
	hit.MouseButton1Down:Connect(function()
		tween(self._scale, 0.08, { Scale = self:_k_px() * 0.95 })
	end)
	hit.MouseButton1Up:Connect(function()
		tween(self._scale, 0.12, { Scale = self:_k_px() * (if hover then 1.05 else 1) })
	end)
	hit.Activated:Connect(function()
		self.ctx:sfx("click")
		self.pressed:Fire()
	end)
end

--- The UIScale for the card's px: the phone factor times UITheme.scale.
function StarterButton._k_px(self): number
	return self._k * UITheme.scale
end

--- `k`: 1 on desktop, PHONE_K on phones (also follows UITheme.scale: call it from apply_layout).
function StarterButton.set_scale(self, k: number)
	self._k = k
	self._scale.Scale = self:_k_px()
	self:set_min_size(self:size_px())
end

--- Its size in logical px.
function StarterButton.size_px(self): Vector2
	return StarterButton.SIZE * self._k
end

function StarterButton.bind(self, s: any)
	if s == nil or self._bound == s then
		return
	end
	self._bound = s
	s.inventory_changed:Connect(function()
		self:refresh()
	end)
	-- (Roblox's prices for this player: UI/Prices)
	self:_connect(StarterOffer.prices_changed():Connect(function()
		self:refresh()
	end))
	self:refresh()
end

function StarterButton._offer(self): any
	local s = self.ctx.session
	local inv = if s ~= nil then s.inventory else nil
	return if inv ~= nil then inv.starter else nil
end

--- Shown while the offer runs (its clock started: the window has been on the player's screen).
function StarterButton.refresh(self)
	local o = self:_offer()
	local on = type(o) == "table" and o.state == "active"
	if on ~= self.visible then
		self:set_visible(on)
		if on then
			self._scale.Scale = self:_k_px() * 0.5
			tween(self._scale, 0.35, { Scale = self:_k_px() }, Enum.EasingStyle.Back)
		end
	end
	local price, regular, off = StarterOffer.prices()
	self._price.Text = tostring(price)
	self._was.Text = tostring(regular)
	self._off.Text = "-" .. tostring(off) .. "%"
end

function StarterButton._process(self, dt: number)
	if not self.visible then
		return
	end
	self._t += dt
	local o = self:_offer()
	if type(o) == "table" and o.ends_at ~= nil then
		local left = o.ends_at - os.clock()
		if left <= 0 then
			self:set_visible(false) -- (time's up: gone for good)
			return
		end
		self._clock.Text = "ENDS IN " .. StarterOffer.clock(left)
	end
	self._sticker.Rotation = 14 + math.sin(self._t * 2.6) * 4
	self._art.Rotation = math.sin(self._t * 1.7) * 3
	self._shine_t += dt
	if self._shine_t >= StarterButton.SHINE_S then
		self._shine_t = 0
		self._shine.Position = UDim2.new(-0.2, 0, 0.5, 0)
		tween(self._shine, 0.7, { Position = UDim2.new(1.2, 0, 0.5, 0) })
	end
end

return StarterButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="219">
            <Properties>
              <string name="Name">StarterOffer</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The starter pack's offer (Data/Starter; 2026-10-15: the starter pack at 39 Robux, on sale for a
-- limited time only). A window over the title: LIMITED-TIME OFFER,
-- STARTER PACK, the three items it unlocks (their shop renders on a glow of their colour, name and one
-- line), the regular price struck through beside the offer's with a red "-76%" sticker (both Roblox's
-- live prices: the discount is always the real one), ENDS IN 47:59:12 counting down, "Then it's gone for
-- good." (the pack goes, not just its price), BUY NOW and NOT NOW.
--
-- It opens by itself on the title once nothing else is going on (UIRoot._starter_auto): the first time
-- (the server's clock starts then: Session.starter_seen) and once a session after that while the
-- offer runs; the title's starter button (StarterButton) opens it any time. NOT NOW or a press outside
-- the window closes it. BUY NOW opens Roblox's prompt; the server's receipt unlocks the items (server/Purchases),
-- the inventory says so and the window closes with the unlock sound.
--
-- Built at DESIGN logical px and scaled to fit (a UIScale), the same layout on phones and desktop.
-- Signals: closed.
local UITheme = require("./UITheme")
local W = require("./Widgets")
local Signal = UITheme.core("Signal")
local Prices = require("./Prices")

local IS_ROBLOX = typeof(game) == "Instance"
local function shared(folder: string, name: string): any
	if IS_ROBLOX then
		return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront")[folder][name]) :: any
	end
	return (require :: any)("../../shared/" .. folder .. "/" .. name)
end
local Starter = shared("Data", "Starter")
local Catalog = shared("Data", "Arsenal")
local Products = shared("Data", "Products")
local Art: any = (function()
	local ok, m = pcall(shared, "Assets", "ArsenalArt")
	return if ok and type(m) == "table" then m else {}
end)()
local TweenService = if IS_ROBLOX then game:GetService("TweenService") else nil

local StarterOffer = W.class(W.Control)

--- The window as designed, logical px; it is scaled down to fit the screen (up to MAX_K on big ones).
StarterOffer.DESIGN = Vector2.new(640, 340)
StarterOffer.MAX_K = 1.25
--- A purchase whose unlock never shows up gives up waiting after this long (it is saved on the server).
StarterOffer.WAIT_S = 30.0

local GOLD = Color3.fromRGB(255, 200, 61)
local GOLD_LIGHT = Color3.fromRGB(255, 232, 160)
local RED = Color3.fromRGB(232, 46, 56)
local RED_DARK = Color3.fromRGB(150, 16, 34)
local INK = Color3.fromRGB(52, 28, 2)
local WHITE = Color3.new(1, 1, 1)
local MUTED = Color3.fromRGB(168, 182, 214)
local NIGHT = Color3.fromRGB(8, 12, 26)
local ROBUX = "rbxasset://textures/ui/common/robux@3x.png"
local FONT_H = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Heavy)
local FONT_B = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Bold)
local FONT_M = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Medium)

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	if TweenService ~= nil then
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
			:Play()
	end
end

local function c3(hex: number): Color3
	return Color3.fromRGB((hex // 65536) % 256, (hex // 256) % 256, hex % 256)
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.BackgroundTransparency = 1
	props.FontFace = props.FontFace or FONT_B
	props.TextColor3 = props.TextColor3 or WHITE
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
	return new("TextLabel", props, parent)
end

--- 7 hours 5 minutes 9 seconds -> "7:05:09" (always hours, so the width holds still).
function StarterOffer.clock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return string.format("%d:%02d:%02d", s // 3600, (s // 60) % 60, s % 60)
end

--- The offer's price, the three items' regular prices added up, and the discount in whole percent:
--- Roblox's live prices (UI/Prices), Data/Products' until it answers.
function StarterOffer.prices(): (number, number, number)
	local price = Prices.robux(Starter.PRODUCT)
	local regular = 0
	for _, k in Starter.ITEMS do
		local it = Catalog.item(k)
		if it ~= nil then
			regular += Prices.robux(it.product)
		end
	end
	local off = if regular > 0 then math.floor((1 - price / regular) * 100 + 0.5) else 0
	return price, regular, math.clamp(off, 0, 99)
end

--- Prices.changed (for the title's button).
function StarterOffer.prices_changed(): any
	return Prices.changed
end

function StarterOffer.new(c: any)
	local self = setmetatable({}, StarterOffer.__mt)
	W.Control._init(self)
	self.ctx = c
	self.closed = Signal.new()
	self.is_open = false
	--- a purchase on its way: { phase = "prompt" | "granting", since }
	self._pending = nil :: any
	self._t = 0.0
	self._sweep = 0.0
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	self:set_visible(false)
	self:_build()
	self:_connect(Prices.changed:Connect(function()
		if self.is_open then
			self:refresh()
		end
	end))
	if IS_ROBLOX then
		game:GetService("MarketplaceService").PromptProductPurchaseFinished:Connect(function(_u, product_id, purchased)
			self:_on_prompt_done(product_id, purchased)
		end)
	end
	self:set_process(true)
	return self
end

function StarterOffer._build(self)
	local root = self.gui
	root.ClipsDescendants = false
	-- the dim: a press on it (outside the window) closes
	local dim = new("TextButton", {
		Name = "Dim",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(2, 4, 12),
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 60,
	}, root)
	dim.Activated:Connect(function()
		self:close()
	end)
	self._dim = dim
	local D = StarterOffer.DESIGN
	local win = new("Frame", {
		Name = "StarterWindow",
		Active = true, -- (a press on the window doesn't reach the dim)
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(16, 22, 44),
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(D.X, D.Y),
		ZIndex = 61,
	}, root)
	new("UICorner", { CornerRadius = UDim.new(0, 18) }, win)
	new("UIStroke", { Color = GOLD, Thickness = 2, Transparency = 0.25, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, win)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 120, 140)),
		Rotation = 90,
	}, win)
	self._scale = new("UIScale", {}, win)
	self._win = win
	local crate = UITheme.crate_art()
	-- behind the items: a warm sunburst
	self._rays = new("ImageLabel", {
		Name = "Rays",
		BackgroundTransparency = 1,
		Image = crate.rays or "",
		ImageColor3 = Color3.fromRGB(255, 120, 60),
		ImageTransparency = 0.86,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(212, 214),
		Size = UDim2.fromOffset(520, 520),
		ZIndex = 61,
	}, win)
	new("UICorner", { CornerRadius = UDim.new(0, 18) }, self._rays)
	-- head
	local tag = new("Frame", {
		Name = "Tag",
		BackgroundColor3 = RED,
		Position = UDim2.fromOffset(24, 18),
		Size = UDim2.fromOffset(176, 24),
		ZIndex = 63,
	}, win)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, tag)
	self._tag = tag
	self._tag_text = text(tag, {
		Text = "LIMITED-TIME OFFER",
		FontFace = FONT_H,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 64,
	})
	local title = text(win, {
		Text = "STARTER PACK",
		FontFace = FONT_H,
		TextSize = 40,
		Position = UDim2.fromOffset(22, 44),
		Size = UDim2.fromOffset(380, 46),
		ZIndex = 63,
	})
	new("UIGradient", { Color = ColorSequence.new(WHITE, GOLD_LIGHT), Rotation = 90 }, title)
	new("UIStroke", { Color = Color3.fromRGB(40, 12, 4), Thickness = 2, Transparency = 0.35 }, title)
	self._sub = text(win, {
		Text = "Three Arsenal unlocks, yours for good.",
		FontFace = FONT_M,
		TextSize = 14,
		TextColor3 = MUTED,
		Position = UDim2.fromOffset(24, 90),
		Size = UDim2.fromOffset(380, 20),
		ZIndex = 63,
	})
	-- the items
	self._tiles = {}
	for i, key in Starter.ITEMS do
		self._tiles[key] = self:_tile(win, Catalog.item(key), 24 + (i - 1) * 128, 120)
	end
	-- the price, right
	local sticker = new("Frame", {
		Name = "Sticker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = RED,
		Position = UDim2.fromOffset(StarterOffer.DESIGN.X - 18, 14),
		Size = UDim2.fromOffset(96, 96),
		Rotation = 12,
		ZIndex = 70,
	}, win)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, sticker)
	new("UIStroke", { Color = WHITE, Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, sticker)
	new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 92, 80), RED_DARK), Rotation = 90 }, sticker)
	self._sticker_scale = new("UIScale", {}, sticker)
	self._sticker = sticker
	self._off = text(sticker, {
		Text = "-76%",
		FontFace = FONT_H,
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.fromOffset(96, 32),
		ZIndex = 71,
	})
	text(sticker, {
		Text = "OFF",
		FontFace = FONT_H,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.fromOffset(96, 18),
		ZIndex = 71,
	})
	local x0 = 420
	-- the regular price, struck through
	local was = new("Frame", {
		Name = "Was",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x0, 74),
		Size = UDim2.fromOffset(196, 26),
		ZIndex = 63,
	}, win)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, was)
	new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = ROBUX,
		ImageColor3 = MUTED,
		Size = UDim2.fromOffset(18, 18),
		LayoutOrder = 1,
		ZIndex = 63,
	}, was)
	self._was = text(was, {
		Text = "165",
		FontFace = FONT_H,
		TextSize = 24,
		TextColor3 = MUTED,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 26),
		LayoutOrder = 2,
		ZIndex = 63,
	})
	local strike = new("Frame", {
		Name = "Strike",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = RED,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(x0 + 98, 87),
		Size = UDim2.fromOffset(78, 3),
		Rotation = -8,
		ZIndex = 64,
	}, win)
	self._strike = strike
	-- the offer's price
	local now = new("Frame", {
		Name = "Now",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x0, 100),
		Size = UDim2.fromOffset(196, 64),
		ZIndex = 63,
	}, win)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, now)
	new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = ROBUX,
		ImageColor3 = GOLD,
		Size = UDim2.fromOffset(38, 38),
		LayoutOrder = 1,
		ZIndex = 63,
	}, now)
	self._price = text(now, {
		Text = "39",
		FontFace = FONT_H,
		TextSize = 62,
		TextColor3 = GOLD,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 64),
		LayoutOrder = 2,
		ZIndex = 63,
	})
	new("UIStroke", { Color = Color3.fromRGB(60, 30, 0), Thickness = 2, Transparency = 0.3 }, self._price)
	-- the clock
	text(win, {
		Text = "ENDS  IN",
		FontFace = FONT_H,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(255, 120, 110),
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(x0, 170),
		Size = UDim2.fromOffset(196, 16),
		ZIndex = 63,
	})
	self._clock = text(win, {
		Text = "48:00:00",
		FontFace = FONT_H,
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(x0, 186),
		Size = UDim2.fromOffset(196, 32),
		ZIndex = 63,
	})
	self._gone = text(win, {
		Text = "Then it's gone for good.",
		FontFace = FONT_M,
		TextSize = 12,
		TextColor3 = MUTED,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(x0 - 10, 218),
		Size = UDim2.fromOffset(216, 16),
		ZIndex = 63,
	})
	-- BUY NOW
	local buy = new("TextButton", {
		Name = "Buy",
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = WHITE,
		Position = UDim2.fromOffset(x0 + 98, 270),
		Size = UDim2.fromOffset(196, 54),
		ZIndex = 65,
	}, win)
	new("UICorner", { CornerRadius = UDim.new(0, 14) }, buy)
	new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 220, 110), Color3.fromRGB(242, 150, 30)), Rotation = 90 }, buy)
	new("UIStroke", { Color = INK, Thickness = 2, Transparency = 0.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, buy)
	self._buy_scale = new("UIScale", {}, buy)
	self._buy_text = text(buy, {
		Text = "BUY NOW",
		FontFace = FONT_H,
		TextSize = 24,
		TextColor3 = INK,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 66,
	})
	-- a light that crosses the button now and then
	local shine_clip = new("Frame", {
		Name = "Shine",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 66,
	}, buy)
	new("UICorner", { CornerRadius = UDim.new(0, 14) }, shine_clip)
	self._shine = new("Frame", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(-0.3, 0, 0.5, 0),
		Size = UDim2.new(0, 22, 1.6, 0),
		Rotation = 18,
		ZIndex = 66,
	}, shine_clip)
	self:_press_feel(buy, self._buy_scale)
	buy.Activated:Connect(function()
		self:_buy()
	end)
	-- (not `self._buy`: that is the method above, and a field of that name hid it, so every press
	-- called the button and failed: no purchase in production v86, 2026-10-16)
	self._buy_btn = buy
	-- NOT NOW
	local later = new("TextButton", {
		Name = "Later",
		Text = "NOT NOW",
		FontFace = FONT_B,
		TextSize = 14,
		TextColor3 = MUTED,
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x0 + 98, 316),
		Size = UDim2.fromOffset(196, 28),
		ZIndex = 65,
	}, win)
	later.Activated:Connect(function()
		self:close()
	end)
end

--- Hover grows, a press squeezes (raw buttons: the kit's own feel isn't on them).
function StarterOffer._press_feel(_self, b: GuiButton, sc: UIScale)
	local hover = false
	b.MouseEnter:Connect(function()
		hover = true
		tween(sc, 0.12, { Scale = 1.05 })
	end)
	b.MouseLeave:Connect(function()
		hover = false
		tween(sc, 0.12, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		tween(sc, 0.08, { Scale = 0.95 })
	end)
	b.MouseButton1Up:Connect(function()
		tween(sc, 0.12, { Scale = if hover then 1.05 else 1 })
	end)
end

--- One item: its render on a glow of its colour, its name and one line (an owned one says what it pays
--- instead).
function StarterOffer._tile(_self, win: Instance, it: any, x: number, y: number): any
	local W_, H_ = 118, 196
	local top, bottom = c3(it.color[1]), c3(it.color[2])
	local tile = new("Frame", {
		Name = "Item_" .. it.key,
		BackgroundColor3 = WHITE,
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(W_, H_),
		ZIndex = 62,
	}, win)
	new("UICorner", { CornerRadius = UDim.new(0, 12) }, tile)
	new("UIGradient", { Color = ColorSequence.new(top:Lerp(NIGHT, 0.45), bottom:Lerp(NIGHT, 0.82)), Rotation = 90 }, tile)
	new("UIStroke", { Color = top:Lerp(WHITE, 0.4), Thickness = 1.5, Transparency = 0.45 }, tile)
	local crate = UITheme.crate_art()
	new("ImageLabel", {
		Name = "Glow",
		BackgroundTransparency = 1,
		Image = crate.glow or "",
		ImageColor3 = top:Lerp(WHITE, 0.25),
		ImageTransparency = 0.25,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(W_ / 2, 66),
		Size = UDim2.fromOffset(140, 130),
		ZIndex = 62,
	}, tile)
	local r = (Art.renders or {})[it.key]
	local bw, bh = 104, 112
	local iw, ih = bw, bh
	if type(r) == "table" and r.w and r.h then
		local k = math.min(bw / r.w, bh / r.h)
		iw, ih = r.w * k, r.h * k
	end
	local art = new("ImageLabel", {
		Name = "Art",
		BackgroundTransparency = 1,
		Image = if type(r) == "table" then r.id else "",
		ScaleType = Enum.ScaleType.Fit,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(W_ / 2, 66),
		Size = UDim2.fromOffset(iw, ih),
		ZIndex = 63,
	}, tile)
	text(tile, {
		Text = it.title,
		FontFace = FONT_H,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(4, 128),
		Size = UDim2.fromOffset(W_ - 8, 20),
		ZIndex = 63,
	})
	local line = text(tile, {
		Text = it.tagline,
		FontFace = FONT_M,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(214, 222, 240),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(6, 150),
		Size = UDim2.fromOffset(W_ - 12, 42),
		ZIndex = 63,
	})
	local owned = new("Frame", {
		Name = "Owned",
		BackgroundColor3 = Color3.fromRGB(38, 170, 90),
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.fromOffset(58, 18),
		Visible = false,
		ZIndex = 64,
	}, tile)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, owned)
	text(owned, {
		Text = "OWNED",
		FontFace = FONT_H,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 65,
	})
	return { tile = tile, art = art, line = line, owned = owned, it = it, y = 66 }
end

function StarterOffer.bind(self, s: any)
	if s == nil or self._bound == s then
		return
	end
	self._bound = s
	s.inventory_changed:Connect(function()
		self:_on_inventory()
	end)
end

function StarterOffer._offer(self): any
	local s = self.ctx.session
	local inv = if s ~= nil then s.inventory else nil
	return if inv ~= nil then inv.starter else nil
end

function StarterOffer._report(self, kind: string, a: any?, b: any?)
	local s = self.ctx.session
	if s ~= nil and type(s.report) == "function" then
		s:report(kind, a, b)
	end
end

function StarterOffer.product_id(_self): number
	local p = Products[Starter.PRODUCT]
	return if type(p) == "table" then (tonumber(p.id) or 0) else 0
end

--- `from`: "auto" (opened by itself on the title) | "button" (the title's starter button).
function StarterOffer.open(self, from: string?)
	if self.is_open then
		return
	end
	self.is_open = true
	self._pending = nil
	self:set_visible(true)
	Prices.fetch()
	self:apply_layout()
	self:refresh()
	self._dim.BackgroundTransparency = 1
	tween(self._dim, 0.2, { BackgroundTransparency = 0.25 })
	local k = self._k or 1
	self._scale.Scale = k * 0.9
	tween(self._scale, 0.3, { Scale = k }, Enum.EasingStyle.Back)
	self._sticker_scale.Scale = 0.2
	task.delay(0.15, function()
		tween(self._sticker_scale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	self.ctx:sfx("open")
	self:_report("starter", "opened", from or "button")
end

function StarterOffer.close(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	self.ctx:sfx("close")
	self:set_visible(false)
	self.closed:Fire()
end

--- Prices, the owned items and the button's state.
function StarterOffer.refresh(self)
	local price, regular, off = StarterOffer.prices()
	self._price.Text = tostring(price)
	self._was.Text = tostring(regular)
	self._off.Text = "-" .. tostring(off) .. "%"
	self._strike.Size = UDim2.fromOffset(28 + #tostring(regular) * 15, 3)
	local s = self.ctx.session
	local inv = if s ~= nil then s.inventory else nil
	for key, t in self._tiles do
		local have = inv ~= nil and inv.unlocks ~= nil and inv.unlocks[key] == true
		t.owned.Visible = have
		t.art.ImageTransparency = if have then 0.35 else 0
		if have then
			t.line.Text = "Owned already: you get its price in Stars"
		else
			t.line.Text = t.it.tagline
		end
	end
	local p = self._pending
	self._buy_text.Text = if p == nil then "BUY NOW" elseif p.phase == "granting" then "UNLOCKING…" else "…"
	self:_tick_clock()
end

function StarterOffer._tick_clock(self)
	local o = self:_offer()
	local left = if type(o) == "table" and o.state == "active" and o.ends_at ~= nil
		then o.ends_at - os.clock()
		else Starter.DURATION_S
	self._clock.Text = StarterOffer.clock(left)
end

function StarterOffer._buy(self)
	if self._pending ~= nil then
		return
	end
	local id = self:product_id()
	self:_report("starter", "clicked")
	if id == 0 or not IS_ROBLOX then
		self.ctx:sfx("deny", -4.0)
		return
	end
	self._pending = { phase = "prompt", since = os.clock() }
	local ok = pcall(function()
		game:GetService("MarketplaceService")
			:PromptProductPurchase(game:GetService("Players").LocalPlayer, id)
	end)
	if not ok then
		self._pending = nil
	end
	self:refresh()
end

function StarterOffer._on_prompt_done(self, product_id: number, purchased: boolean)
	local p = self._pending
	if p == nil or product_id ~= self:product_id() then
		return
	end
	if not purchased then
		if p.phase == "prompt" then
			self._pending = nil
			self:refresh()
		end
		return
	end
	-- bought: the server's receipt unlocks the items, and the inventory says so
	p.phase = "granting"
	p.since = os.clock()
	self:refresh()
	self:_on_inventory()
end

--- True when every item of the pack is unlocked.
function StarterOffer._all_unlocked(self): boolean
	local s = self.ctx.session
	local u = if s ~= nil and s.inventory ~= nil then s.inventory.unlocks else nil
	if u == nil then
		return false
	end
	for _, k in Starter.ITEMS do
		if not u[k] then
			return false
		end
	end
	return true
end

--- The inventory moved: a purchase that landed ends here (the offer is gone, its items unlocked; the
--- receipt can come before Roblox's prompt says it closed).
function StarterOffer._on_inventory(self)
	local p = self._pending
	if p ~= nil and self:_offer() == false and self:_all_unlocked() then
		self._pending = nil
		--- (UIRoot: the items' own "unlocked!" toasts give way to this one)
		self.bought_at = os.clock()
		self.ctx:sfx("unlock")
		if self.ui_notice ~= nil then
			self.ui_notice("Starter Pack unlocked! Mega Nuke, Scattershot and 2x Stars are yours.")
		end
		self:close()
		return
	end
	if self.is_open then
		local o = self:_offer()
		if (o == false or o == nil) and p == nil then
			self:close() -- (it ended, or was bought elsewhere)
			return
		end
		self:refresh()
	end
end

function StarterOffer._process(self, dt: number)
	if not self.is_open then
		return
	end
	self._t += dt
	self._rays.Rotation = (self._rays.Rotation + dt * 8) % 360
	-- the sticker breathes; the button's light crosses every few seconds
	self._sticker.Rotation = 12 + math.sin(self._t * 2.4) * 3
	self._sweep += dt
	if self._sweep >= 2.6 then
		self._sweep = 0
		self._shine.Position = UDim2.new(-0.3, 0, 0.5, 0)
		tween(self._shine, 0.6, { Position = UDim2.new(1.3, 0, 0.5, 0) })
	end
	-- the items float a little
	local i = 0
	for _, t in self._tiles do
		i += 1
		t.art.Position = UDim2.fromOffset(59, t.y + math.sin(self._t * 1.6 + i * 1.1) * 3)
	end
	self:_tick_clock()
	local p = self._pending
	local o = self:_offer()
	if p == nil and type(o) == "table" and o.ends_at ~= nil and o.ends_at - os.clock() <= 0 then
		self:close() -- (time's up while it stood open: gone for good)
		return
	end
	if p ~= nil and p.phase == "granting" and os.clock() - p.since > StarterOffer.WAIT_S then
		self._pending = nil
		if self.ui_notice ~= nil then
			self.ui_notice("Your Starter Pack is saved and will unlock in a moment.")
		end
		self:close()
	end
end

function StarterOffer.apply_layout(self)
	local ctx = self.ctx
	local area = ctx:clear_rect()
	local D = StarterOffer.DESIGN
	local k = math.min((area.Width - 32) / D.X, (area.Height - 24) / D.Y, StarterOffer.MAX_K)
	k = math.max(k, 0.3)
	self._k = k * UITheme.scale
	self._scale.Scale = self._k
	local u = UITheme.scale
	self._win.Position = UDim2.fromOffset(
		(area.Min.X + area.Width * 0.5) * u,
		(area.Min.Y + area.Height * 0.5) * u
	)
end

return StarterOffer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="220">
            <Properties>
              <string name="Name">Takeover</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Solo: take over the nation that eliminated you, for 25 Robux (2026-09-28). Offered on the
-- ELIMINATED screen and the spectating pill while the nation that conquered you is still alive.
-- A press pauses the match, then spends a saved credit or opens Roblox's purchase prompt; the server
-- stores the purchase as a credit (server/Purchases), spends it, and the player takes over
-- (Session.take_over: its land, army, gold and buildings, its AI off). A purchase whose moment passed
-- stays saved for the next time a nation conquers the player.
--
-- UIRoot drives it: tick() once a second, on_credits() / on_result() from the session, refresh()
-- when the ELIMINATED screen opens; pending() pauses the solo match.
local UICtx = require("./UICtx")

local Takeover = {}
Takeover.__index = Takeover

Takeover.KIND = "takeover"
--- Seconds to wait for the stored purchase / the spend before giving up (the credit stays saved).
Takeover.CREDIT_WAIT_S = 30
--- Roblox's prompt left open this long without an answer: give up (the match unpauses).
Takeover.PROMPT_WAIT_S = 180

local IS_ROBLOX = typeof(game) == "Instance"
local products_mod: any = nil
local function products(): any
	if products_mod == nil then
		products_mod = {}
		if IS_ROBLOX then
			local ok, m = pcall(function()
				return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Products)
			end)
			if ok and type(m) == "table" then
				products_mod = m
			end
		end
	end
	return products_mod
end

local prices_mod: any = nil
local function Prices(): any
	if prices_mod == nil then
		prices_mod = require("./Prices") :: any
	end
	return prices_mod
end

function Takeover.new(ui: any)
	local self = setmetatable({}, Takeover)
	self.ui = ui
	self.ctx = ui.ctx
	--- { target, phase = "prompt" | "credit" | "using", since }
	self._pending = nil
	--- the match state each milestone was reported for (once per match)
	self._offer_for = nil
	self._click_for = nil
	self._shown_key = ""
	if IS_ROBLOX then
		local mps = game:GetService("MarketplaceService")
		self._conn = mps.PromptProductPurchaseFinished:Connect(
			function(user_id: number, product_id: number, purchased: boolean)
				self:_on_prompt_done(user_id, product_id, purchased)
			end
		)
	end
	return self
end

function Takeover.product_id(self): number
	if self._preview_id ~= nil then
		return self._preview_id -- (dev diagnostics: preview the priced offer before the product exists)
	end
	local p = products()[Takeover.KIND]
	return if type(p) == "table" then (tonumber(p.id) or 0) else 0
end

--- Roblox's price for this player (UI/Prices), the set one until it answers.
function Takeover.price(_self): number
	local p = products()[Takeover.KIND]
	if type(p) ~= "table" then
		return 25
	end
	Prices().fetch()
	local r = Prices().robux(Takeover.KIND)
	return if r > 0 then r else (tonumber(p.robux) or 25)
end

--- Takeovers bought and not used yet.
function Takeover.saved(self): number
	local s = self.ctx.session
	local c = if s ~= nil then s.credits else nil
	return if type(c) == "table" then (tonumber(c[Takeover.KIND]) or 0) else 0
end

function Takeover.pending(self): boolean
	return self._pending ~= nil
end

--- The nation the player could take over now (0: no offer).
function Takeover.target(self): number
	local ctx = self.ctx
	local m = ctx:mode()
	if (m ~= UICtx.MODE_SOLO and m ~= UICtx.MODE_MULTI) or not ctx:in_match() or ctx.state == nil then
		return 0
	end
	local st = self.ui._stats
	local k = if st ~= nil then (tonumber(st.killer) or 0) else 0
	if st == nil or not st.elim or k == 0 then
		return 0
	end
	if self:product_id() == 0 and self:saved() <= 0 then
		return 0
	end
	local s = ctx.session
	if s == nil or type(s.can_take_over) ~= "function" or not s:can_take_over(k) then
		return 0
	end
	return k
end

function Takeover._report(self, kind: string)
	local t = self.ui.telemetry
	if t ~= nil and type(t._send) == "function" then
		t:_send(kind)
	end
end

function Takeover._notice(self, text: string, severity: number?)
	self.ui:_on_notice(text, severity or 0)
end

--- The TAKE OVER button.
function Takeover.start(self)
	local target = self:target()
	if target == 0 or self._pending ~= nil then
		return
	end
	if self._click_for ~= self.ctx.state then
		self._click_for = self.ctx.state
		self:_report("takeover_click")
	end
	self._pending = { target = target, phase = "", since = os.clock() }
	self.ui:_update_pause()
	if self:saved() > 0 then
		self:_use()
	else
		local id = self:product_id()
		if id == 0 or not IS_ROBLOX then
			self:_cancel(nil)
			return
		end
		self._pending.phase = "prompt"
		local ok = pcall(function()
			local mps = game:GetService("MarketplaceService")
			mps:PromptProductPurchase(game:GetService("Players").LocalPlayer, id)
		end)
		if not ok then
			self:_cancel("Purchases aren't available right now.")
			return
		end
	end
	self:refresh()
end

function Takeover._use(self)
	local p = self._pending
	if p == nil then
		return
	end
	p.phase = "using"
	p.since = os.clock()
	local s = self.ctx.session
	-- (a public match's server makes the takeover itself: it needs the nation)
	local target = if self.ctx:mode() == UICtx.MODE_MULTI then p.target else nil
	if s == nil or not s:use_credit(Takeover.KIND, target) then
		self:_cancel("Couldn't reach the server. Try again in a moment.")
	end
end

function Takeover._cancel(self, message: string?)
	self._pending = nil
	self.ui:_update_pause()
	if message ~= nil then
		self:_notice(message, 0)
	end
	self:refresh()
end

function Takeover._on_prompt_done(self, _user_id: number, product_id: number, purchased: boolean)
	local p = self._pending
	if p == nil or p.phase ~= "prompt" or product_id ~= self:product_id() then
		return
	end
	if not purchased then
		self:_cancel(nil)
		return
	end
	-- bought: the server stores it (a credit) and says so; then it is spent
	p.phase = "credit"
	p.since = os.clock()
	if self:saved() > 0 then
		self:_use()
	end
	self:refresh()
end

--- The session's credits changed (a purchase stored, a credit spent).
function Takeover.on_credits(self)
	local p = self._pending
	if p ~= nil and p.phase == "credit" and self:saved() > 0 then
		self:_use()
	end
	self:refresh()
end

--- The server's answer to use_credit.
function Takeover.on_result(self, kind: string, ok: boolean, reason: string?)
	local p = self._pending
	if kind ~= Takeover.KIND or p == nil or p.phase ~= "using" then
		return
	end
	self._pending = nil
	local s = self.ctx.session
	-- (a takeover that happens goes on in UIRoot._on_took_over, from the session's took_over signal;
	-- a public match's server already made it and said so with OWNER_CHANGED)
	local multi = self.ctx:mode() == UICtx.MODE_MULTI
	local took = ok and (multi or (s ~= nil and s:take_over(p.target)))
	if ok and not took then
		self:_notice("That nation has fallen, so the takeover couldn't happen.", 1)
	elseif not ok and reason == "gone" then
		self:_notice("That nation has fallen. Your takeover is still saved.", 1)
	elseif not ok then
		self:_notice("Couldn't use your takeover right now. It's still saved.", 0)
	end
	self.ui:_update_pause()
	self:refresh()
end

--- Once a second: the offer's first showing (analytics), timeouts, the buttons.
function Takeover.tick(self)
	local p = self._pending
	if p ~= nil then
		local wait = if p.phase == "prompt" then Takeover.PROMPT_WAIT_S else Takeover.CREDIT_WAIT_S
		if os.clock() - p.since > wait then
			self:_cancel(
				if p.phase == "prompt"
					then nil
					else "Your takeover is saved. Use it the next time a nation conquers you."
			)
		end
	end
	if self:target() ~= 0 and self._offer_for ~= self.ctx.state then
		self._offer_for = self.ctx.state
		self:_report("takeover_offer")
	end
	self:refresh()
end

--- Show / update the offer on the ELIMINATED screen and the spectating pill.
function Takeover.refresh(self)
	local target = self:target()
	local info = nil
	if target ~= 0 then
		local st = self.ctx.state
		local o = st:get_owner(target)
		info = {
			target = target,
			name = st:owner_name(target),
			color = if o ~= nil then o.color else nil,
			price = self:price(),
			saved = self:saved(),
			busy = self._pending ~= nil,
		}
	end
	local key = if info == nil
		then ""
		else string.format("%d|%s|%d|%s|%d", info.target, info.name, info.saved, tostring(info.busy), info.price)
	if key == self._shown_key then
		return
	end
	self._shown_key = key
	self.ui.over:set_takeover(info)
	self.ui:_set_spec_takeover(info)
end

return Takeover
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="221">
            <Properties>
              <string name="Name">TargetCard</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/target_card.gd (UITargetCard)
-- Touch "look before you act" card: the first tap on a foreign nation (or a coast reached by boat)
-- selects it and shows who it is, with a big primary order button ("Attack · 12.3K"). A second
-- tap on the same target, or the button, fires; Ally proposes an alliance; ✕ or a tap elsewhere
-- closes it. For an ally (kind "ally") it offers Donate and Break alliance, which first asks for
-- confirmation and spells out the Traitor penalty.

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local Signal = UITheme.core("Signal")
local Defs = UICtx.core("Defs")

local _Rules = nil
local function Rules()
	if _Rules == nil then
		_Rules = UICtx.core("Rules")
	end
	return _Rules
end

local TargetCard = W.class(W.Control)

TargetCard.LIFETIME = 12.0

local function close_button(icon_px: number)
	local b = UITheme.button("", "GhostButton", "close", 44.0)
	b.expand_icon = true
	b.icon_alignment = W.ALIGN_CENTER
	b:add_theme_constant_override("icon_max_width", icon_px)
	b:set_min_size(Vector2.new(44, 44))
	return b
end
TargetCard.close_button = close_button

function TargetCard.new(c: any)
	local self = setmetatable({}, TargetCard.__mt)
	W.Control._init(self)
	self.ctx = c
	self.fire = Signal.new()
	self.ally = Signal.new()
	self.closed = Signal.new()
	--- Break the alliance; `attack` = also attack them right away (a betrayal).
	self.betray = Signal.new()
	self.donate = Signal.new()
	self.tile = -1
	self.owner_id = 0
	self.kind = "" -- "attack", "boat" or "ally"
	self.confirming = false
	self.shown_msec = 0
	self.is_open = false
	self._age = 0.0
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	local panel = GlassPanel.new(12.0, 10.0, UITheme.R_LG, true, 20)
	panel:set_accent(UITheme.AMBER)
	self._panel = panel
	self:add_child(panel)
	local v = UITheme.vbox(8)
	panel:add_child(v)
	local head = UITheme.hbox(8)
	self._sw = UITheme.swatch(UITheme.TEXT, 12.0, 3)
	head:add_child(self._sw)
	self._name = UITheme.label("", 15, 700)
	UITheme.fix_width(self._name, 150.0, W.ALIGN_LEFT, false)
	self._name.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(self._name)
	self._badge = W.Panel.new()
	self._badge:set_mouse_filter(W.MOUSE_IGNORE)
	self._badge.size_flags_vertical = W.SHRINK_CENTER
	self._badge_l = UITheme.label("", 12, 700, UITheme.TEXT_2, 1)
	self._badge:add_child(self._badge_l)
	head:add_child(self._badge)
	local sp = W.Control.new()
	sp.size_flags_horizontal = W.EXPAND_FILL
	sp:set_mouse_filter(W.MOUSE_IGNORE)
	head:add_child(sp)
	self._close = close_button(14)
	self._close.pressed:Connect(function()
		self:hide_card(true)
	end)
	head:add_child(self._close)
	v:add_child(head)
	self._sub = UITheme.label("", 12, 500, UITheme.TEXT_2)
	v:add_child(self._sub)
	local stats = UITheme.hbox(14)
	self._stats = stats
	self._troops = UITheme.label("", 13, 600)
	UITheme.fix_width(self._troops, 110.0, W.ALIGN_LEFT, false)
	stats:add_child(self._troops)
	self._land = UITheme.label("", 13, 600, UITheme.TEXT_2)
	UITheme.fix_width(self._land, 96.0, W.ALIGN_LEFT, false)
	stats:add_child(self._land)
	v:add_child(stats)
	self._odds = UITheme.label("", 12, 600, UITheme.TEXT_3)
	self._odds_warn = false
	v:add_child(self._odds)
	self._warn = UITheme.label("", 13, 600, Color3.new(1.0, 0.82, 0.8))
	self._warn:set_autowrap(true)
	self._warn:set_min_size(Vector2.new(240, 0))
	self._warn:set_visible(false)
	v:add_child(self._warn)
	local btns = UITheme.hbox(8)
	self._go = UITheme.button("Attack", "PrimaryButton", "attack", 48.0)
	self._go:set_font_size(15)
	self._go.size_flags_horizontal = W.EXPAND_FILL
	self._go.pressed:Connect(function()
		self:_on_go()
	end)
	btns:add_child(self._go)
	self._donate = UITheme.button("Donate", "GlassButton", "donate", 48.0)
	self._donate:set_font_size(13)
	self._donate.pressed:Connect(function()
		self.donate:Fire()
	end)
	self._donate:set_visible(false)
	btns:add_child(self._donate)
	self._ally = UITheme.button("Ally", "GlassButton", "alliance", 48.0)
	self._ally:set_font_size(13)
	self._ally.pressed:Connect(function()
		self.ally:Fire()
	end)
	btns:add_child(self._ally)
	v:add_child(btns)
	-- Confirmation row: break without attacking, or keep the alliance.
	self._btns2 = UITheme.hbox(8)
	self._break_only = UITheme.button("Break only", "GlassButton", "betray", 44.0)
	self._break_only:set_font_size(13)
	self._break_only.size_flags_horizontal = W.EXPAND_FILL
	self._break_only.pressed:Connect(function()
		self.betray:Fire(false)
	end)
	self._btns2:add_child(self._break_only)
	self._keep = UITheme.button("Keep ally", "GlassButton", "alliance", 44.0)
	self._keep:set_font_size(13)
	self._keep.size_flags_horizontal = W.EXPAND_FILL
	self._keep.pressed:Connect(function()
		self:hide_card(true)
	end)
	self._btns2:add_child(self._keep)
	self._btns2:set_visible(false)
	v:add_child(self._btns2)
	panel:set_min_size(Vector2.new(300, 0))
	self:set_visible(false)
	self:set_process(true)
	return self
end

--- Select `t` for order `k` ("attack" / "boat" / "ally"); `act` is UIRules.primary() for that tile.
function TargetCard.show_target(self, t: number, k: string, act: any)
	local ctx = self.ctx
	local s = ctx.state
	if s == nil then
		return
	end
	self.tile = t
	self.kind = k
	self.confirming = false
	self.owner_id = s:tile_owner(t)
	self.shown_msec = UICtx.msec()
	self._age = 0.0
	local troops = UITheme.fmt_troops(tonumber(act.troops) or 0.0)
	local c = ctx.compact
	if self.owner_id ~= 0 then
		local o = s:get_owner(self.owner_id)
		UITheme.set_swatch_color(self._sw, if o ~= nil then o.color else UITheme.TEXT)
		self._sw:set_visible(true)
		self._name:set_text(s:owner_name(self.owner_id))
		local rel = ctx:relation(self.owner_id)
		self._badge:set_visible(rel ~= "")
		local rc = ctx:relation_color(rel)
		self._badge_l:set_text(string.upper(rel))
		self._badge_l:set_color(rc)
		self._badge:add_theme_stylebox_override(
			"panel",
			UITheme.flat(UITheme.c(rc, 0.14), 999, UITheme.c(rc, 0.5), 1, 8.0, 1.0)
		)
		self._sub:set_text(
			string.format("%s  ·  %s", ctx:kind_title(if o ~= nil then o.kind else 0), ctx:terrain_title(t))
		)
		self._troops:set_text("Troops " .. UITheme.fmt_troops(if o ~= nil then o.troops else 0))
		self._land:set_text("Land " .. UITheme.fmt_pct(s:land_share(self.owner_id)))
		local mine = tonumber(act.troops) or 0.0
		local theirs = if o ~= nil then o.troops else 0
		self._odds:set_visible(true)
		if theirs > mine * 1.5 then
			self._odds:set_text(string.format("They outnumber the %s troops you would send", troops))
			self._odds:set_color(UITheme.ORANGE)
			self._odds_warn = true
		else
			self._odds:set_text(string.format("You would send %s troops", troops))
			self._odds:set_color(UITheme.TEXT_3)
			self._odds_warn = false
		end
		self._ally:set_visible(self.kind == "attack" or self.kind == "boat")
		self._ally:set_disabled(s:has_request(ctx:me(), self.owner_id))
	else
		self._sw:set_visible(false)
		self._name:set_text("Unclaimed land")
		self._badge:set_visible(false)
		self._sub:set_text(ctx:terrain_title(t) .. "  ·  across the sea")
		self._troops:set_text("")
		self._land:set_text("")
		self._odds:set_visible(true)
		self._odds:set_text(string.format("A transport lands %s troops here", troops))
		self._odds:set_color(UITheme.TEXT_3)
		self._odds_warn = false
		self._ally:set_visible(false)
	end
	self._sub:set_visible(true)
	local plan = nil
	if self.kind == "ally" and self.owner_id ~= 0 then
		local oa = s:get_owner(self.owner_id)
		plan = if ctx.rules ~= nil then ctx.rules:donate_plan(self.owner_id) else nil
		-- Near their troop cap: say how much still fits (a gift above the cap evaporates).
		local who = if s:same_team(ctx:me(), self.owner_id) then "Your teammate" else "Your ally"
		self._sub:set_text(
			if plan ~= nil and plan.capped
				then string.format(
					"%s · %s troops · room for %s",
					who,
					UITheme.fmt_troops(if oa ~= nil then oa.troops else 0),
					UITheme.fmt_troops(plan.room)
				)
				else string.format(
					"%s · %s troops · %s land",
					who,
					UITheme.fmt_troops(if oa ~= nil then oa.troops else 0),
					UITheme.fmt_pct(s:land_share(self.owner_id))
				)
		)
	end
	-- Phones: one info line (who · troops · land); the odds line only when it is a warning.
	self._stats:set_visible(not c)
	if c and self.owner_id ~= 0 and self.kind ~= "ally" then
		local o2 = s:get_owner(self.owner_id)
		self._sub:set_text(
			string.format(
				"%s · %s troops · %s land",
				ctx:kind_title(if o2 ~= nil then o2.kind else 0),
				UITheme.fmt_troops(if o2 ~= nil then o2.troops else 0),
				UITheme.fmt_pct(s:land_share(self.owner_id))
			)
		)
		self._odds:set_visible(self._odds_warn)
	elseif c and self.owner_id == 0 then
		self._odds:set_visible(false)
		self._sub:set_text(string.format("%s · across the sea · lands %s troops", ctx:terrain_title(t), troops))
	end
	for _, b in ipairs({ self._go, self._ally }) do
		b:set_min_height(if c then 44.0 else 48.0)
	end
	self._panel:set_min_size(Vector2.new(if c then 250 else 300, 0))
	UITheme.fix_width(self._name, if c then 110.0 else 150.0, W.ALIGN_LEFT, false)
	self._panel:set_padding(
		if c then 10.0 else 12.0,
		if c then 2.0 else 10.0,
		if c then 4.0 else 12.0,
		if c then 8.0 else 10.0
	)
	local verb = if self.kind == "attack" then "Attack" else "Invade"
	self._go:set_text(string.format("%s · %s", verb, troops))
	self._go:set_icon(if self.kind == "attack" then "attack" else "boat")
	self:_set_variation(self._go, "PrimaryButton")
	self._panel:set_accent(if self.kind == "attack" then UITheme.AMBER else UITheme.CYAN)
	self._warn:set_visible(false)
	self._btns2:set_visible(false)
	self._donate:set_visible(false)
	self._go:set_visible(true)
	if self.kind == "ally" then
		self._odds:set_visible(false)
		-- (a teammate: no alliance to break)
		self._go:set_visible(not s:same_team(ctx:me(), self.owner_id))
		self._ally:set_visible(false)
		self._donate:set_visible(true)
		local amt = if plan ~= nil then plan.amount else ctx:troops_for_ratio()
		local full = plan ~= nil and plan.full
		self._donate:set_text(if full then "At troop cap" else "Donate " .. UITheme.fmt_troops(amt))
		self._donate:set_disabled(amt < 1.0 or full)
		self._go:set_text("Break alliance")
		self._go:set_icon("betray")
		self:_set_variation(self._go, "DangerButton")
		self._panel:set_accent(UITheme.VIOLET)
	end
	local was = self.is_open
	self.is_open = true
	self:set_visible(true)
	self:place()
	if not was then
		UICtx.pop_in(self._panel, 0.0, 0.94, 0.25)
	end
	ctx:sfx("click", -8.0)
end

function TargetCard._set_variation(_self, b, variation: string)
	if b.theme_type_variation ~= variation then
		b.theme_type_variation = variation
		b:_theme_changed()
		b:_restyle_label()
	end
end

--- Same target as the current selection (owner for attacks; nearby coast for boats), still fresh.
function TargetCard.matches(self, t: number, k: string): boolean
	if not self.is_open or k ~= self.kind or UICtx.msec() - self.shown_msec > TargetCard.LIFETIME * 1000.0 then
		return false
	end
	local s = self.ctx.state
	if s == nil then
		return false
	end
	if k == "attack" then
		return s:tile_owner(t) == self.owner_id and self.owner_id ~= 0
	end
	return Defs.tile_distance(t, self.tile) <= 4.0 or (self.owner_id ~= 0 and s:tile_owner(t) == self.owner_id)
end

--- Ally card: ask before breaking the alliance (the Traitor penalty is spelled out).
function TargetCard.confirm_betray(self)
	if not self.is_open or self.kind ~= "ally" then
		return
	end
	local ctx = self.ctx
	local R = Rules()
	self.confirming = true
	self._age = 0.0
	local secs = Defs.round(R.TRAITOR_TICKS / R.TICK_RATE)
	self._warn:set_text(
		string.format(
			"Break the alliance with %s? For %d s you are a TRAITOR: every nation sees it and attacks on you cost only %d%% of the troops.",
			if ctx.state ~= nil then ctx.state:owner_name(self.owner_id) else "them",
			secs,
			Defs.round(R.TRAITOR_DEFENSE_DEBUFF * 100.0)
		)
	)
	self._warn:set_visible(true)
	self._sub:set_visible(false)
	self._donate:set_visible(false)
	self._btns2:set_visible(true)
	self._go:set_text("Betray & attack · " .. UITheme.fmt_troops(ctx:troops_for_ratio()))
	self._go:set_icon("attack")
	self._panel:set_accent(UITheme.RED)
	self:place()
	ctx:sfx("open", -8.0)
end

function TargetCard._on_go(self)
	if self.kind ~= "ally" then
		self.fire:Fire()
	elseif not self.confirming then
		self:confirm_betray()
	else
		self.betray:Fire(true)
	end
end

function TargetCard.hide_card(self, user: boolean?)
	if not self.is_open then
		return
	end
	self.is_open = false
	local t = self:create_tween()
	t:tween_property(self, "modulate:a", 0.0, 0.12)
	t:tween_callback(function()
		if not self.is_open then
			self:set_visible(false)
		end
		self:set_modulate_a(1.0)
	end)
	if user then
		self.ctx:sfx("close", -8.0)
	end
	self.closed:Fire()
end

--- Bottom-left above the command bar on phones (the thumb side, clear of the Attacks column);
--- centred above the bar on larger screens.
function TargetCard.place(self)
	local ctx = self.ctx
	local area = ctx:clear_rect()
	local sz = self._panel:get_combined_minimum_size()
	local bottom = area.Max.Y
	local ui_bar = self:get_meta("bar", nil)
	if ui_bar ~= nil and ui_bar:is_visible_in_tree() then
		bottom = math.min(bottom, ui_bar:top_edge())
	end
	local y = math.max(bottom - sz.Y - 10.0, area.Min.Y + 4.0)
	local left = Vector2.new(area.Min.X + 10.0, y)
	local right = Vector2.new(area.Max.X - sz.X - 10.0, y)
	local top_y = area.Min.Y + 4.0
	local cands = {}
	if not ctx.compact then
		table.insert(cands, Vector2.new((ctx.vp.X - sz.X) * 0.5, y))
	end
	table.insert(cands, left)
	table.insert(cands, right)
	-- Narrow screens: a mid-screen target can sit under both bottom corners; try the top ones.
	table.insert(cands, Vector2.new(left.X, top_y))
	table.insert(cands, Vector2.new(right.X, top_y))
	-- Never cover the target itself (the second tap must reach it).
	local tp = if self.tile >= 0 then ctx:tile_screen_pos(self.tile) else Vector2.new(-1, -1)
	local p = cands[1]
	for _, cnd in ipairs(cands) do
		if not (tp.X >= 0 and UICtx.rect_has_point(UICtx.rect_grow(UICtx.rect_ps(cnd, sz), 24.0), tp)) then
			p = cnd
			break
		end
	end
	local rp = Vector2.new(math.floor(p.X + 0.5), math.floor(p.Y + 0.5))
	self._panel:set_offsets(rp.X, rp.Y, rp.X, rp.Y)
	self._panel:reset_size()
end

function TargetCard.panel_rect(self): Rect
	return if self.is_open then self._panel:get_global_rect() else UICtx.EMPTY_RECT
end

function TargetCard._process(self, delta: number)
	if not self.is_open then
		return
	end
	-- The betray confirm is a destructive choice: it waits for an answer (Break only / Keep ally /
	-- ✕) instead of closing under the pointer. Any card also holds while the mouse rests on it.
	-- (review P2-3; the original expires every variant after LIFETIME.)
	local ctx = self.ctx
	if self.confirming then
		-- ...unless the question is moot (the alliance already ended some other way).
		local s = ctx.state
		if s == nil or not s:are_allies(ctx:me(), self.owner_id) then
			self:hide_card()
		end
		return
	end
	if not ctx.touch and UICtx.rect_has_point(self._panel:get_global_rect(), ctx:mouse_pos()) then
		return
	end
	self._age += delta
	if self._age > TargetCard.LIFETIME then
		self:hide_card()
	end
end

return TargetCard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="222">
            <Properties>
              <string name="Name">Telemetry</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Match milestones for the Creator Dashboard (src/server/Analytics.luau logs them with Roblox's
-- AnalyticsService). Solo matches run on this client, so the client reports for every match it plays:
-- started (mode, map), spawned, first attack, whole minutes alive, eliminated (by whom), the end (won
-- or lost, rank) or leaving early; plus the title screen, How to Play and Spectate. Sent through
-- Session.report (OP.ANALYTICS); the server validates and dedupes. Nothing here affects the game.
-- Every STATE_EVERY_S (and right before leaving) a snapshot: what is happening to the player, where
-- they stand on land, and the frame rate. The server keeps the latest and logs it when the match ends
-- with the player quitting or leaving (why do players close the game ~2 minutes in? 2026-09-28).
--
-- Once a match, the first SLOW_WINDOW_S in a row under SLOW_FPS is reported with what the frame was
-- made of ("slow": Telemetry.slow_cause). A player's report, 2026-10-09: down to about 3 fps
-- near the end of a match, on a desktop, and nothing here could say on what: a MIRV's
-- warheads did that (Map/TrailBudget) and the player had seen none.
--
-- UIRoot drives it: bind(state) on every state change, tick() once a second, title_shown(),
-- help(where), spectate(); UICtx.send passes every intent to on_intent(intent).

local UITheme = require("./UITheme")

local Telemetry = {}
Telemetry.__index = Telemetry

local MODE_SOLO, MODE_MULTI = 1, 2

Telemetry.STATE_EVERY_S = 10
--- Land changes over this window decide "Losing land" / "Growing" (by more than LAND_CHANGE of it).
Telemetry.LAND_WINDOW_S = 30
Telemetry.LAND_CHANGE = 0.03
--- No intent sent for this long: "Idle".
Telemetry.IDLE_S = 60
--- "slow": a window of SLOW_WINDOW_S under SLOW_FPS, the window in front the whole time, no sooner
--- than SLOW_AFTER_S into the match (its first seconds build the map). A frame longer than
--- SLOW_STALL_S is the game set aside, not a slow frame: its window does not count.
Telemetry.SLOW_FPS = 12
Telemetry.SLOW_WINDOW_S = 10
Telemetry.SLOW_AFTER_S = 30
Telemetry.SLOW_STALL_S = 2.0
--- slow_cause: this many munitions in flight are the cause whatever else is going on; our own script
--- is, when it is SLOW_SCRIPT_SHARE of the frame or more; else the engine: its GPU time or its
--- render CPU time (Stats.RenderGPUFrameTime / RenderCPUFrameTime, averaged over the window), the
--- bigger one when it is SLOW_ENGINE_SHARE of the frame or more, or neither.
Telemetry.SLOW_NUKES = 40
--- The map's parts besides units, labels and territory (MapView.perf_stats keys), each its own cause
--- "map_<part>"; "map" is what none of them holds.
Telemetry.MAP_PARTS = { "camera", "glow", "roads", "ranges", "structures", "fx", "fronts", "markers", "input" }
Telemetry.SLOW_SCRIPT_SHARE = 0.5
Telemetry.SLOW_ENGINE_SHARE = 1 / 3

function Telemetry.new(ctx: any)
	local self = setmetatable({}, Telemetry)
	self.ctx = ctx
	self._conns = {}
	--- the match being reported: { state, me, mode, map, minutes, sent_min, spawned, attacked, ended }
	self._match = nil
	self._title_sent = false
	self._title_wanted = false
	--- matches reported started this session, and the matches counted before it (nil: the saved
	--- [stats] section's); matches_before() is what the server counts
	self.matches_started = 0
	self.matches_base = nil :: number?
	--- frame rate over the current state window
	self._frames = 0
	self._frame_time = 0.0
	--- the "slow" window: frames, their time, whether it counts, and the local Sim's work at its start
	self._slow_frames = 0
	self._slow_time = 0.0
	self._slow_at = os.clock()
	self._slow_void = false
	self._slow_step_s = 0.0
	--- the other script clocks at the window's start: Session.process, the network handler, the
	--- HUD's own step and the UI kit's (cumulative seconds, see _script_clocks)
	self._slow_clocks = { process = 0.0, net = 0.0, ui = 0.0, kit = 0.0 }
	--- UIRoot's { process, kit } (cumulative seconds), set by UIRoot
	self.ui_perf = nil
	--- the engine's own render times summed over the window (s), and where they are read (nil: nowhere)
	self._slow_render_s = 0.0
	self._slow_gpu_s = 0.0
	self._stats = nil
	--- the game's window is in front (a window behind others is drawn slowly on purpose)
	self._focused = true
	if typeof ~= nil and typeof(game) == "Instance" then
		pcall(function()
			local stats = game:GetService("Stats")
			local _ = stats.RenderCPUFrameTime + stats.RenderGPUFrameTime
			self._stats = stats
		end)
		pcall(function()
			local UIS = game:GetService("UserInputService")
			UIS.WindowFocusReleased:Connect(function()
				self._focused = false
				self._slow_void = true
			end)
			UIS.WindowFocused:Connect(function()
				self._focused = true
				self._slow_void = true
			end)
		end)
	end
	return self
end

--- Every frame (UIRoot._process): counts frames for the snapshot's frame rate.
function Telemetry.frame(self, dt: number)
	self._frames += 1
	self._frame_time += dt
	self._slow_frames += 1
	self._slow_time += dt
	if dt > Telemetry.SLOW_STALL_S then
		self._slow_void = true
	end
	local stats = self._stats
	if stats ~= nil then
		self._slow_render_s += stats.RenderCPUFrameTime
		self._slow_gpu_s += stats.RenderGPUFrameTime
	end
end

--- What a slow frame was made of, as a key of server/Analytics.SLOW_CAUSES. `s`, all per frame:
--- frame_ms (the frame's length), nukes (munitions in flight), map (MapView.perf_stats: ms by layer,
--- and `total`), sim_ms (the local Sim's steps), net_ms (the network handler: a public match's
--- updates decoded and applied), session_ms (the rest of Session.process), ui_ms (the HUD's own
--- step), hud_ms (the UI kit's), render_ms and gpu_ms (the engine's render CPU and GPU time).
---   * v71 and v72 counted the map, the kit and the Sim only. A public match's biggest script is the
---     network handler (7 ms a tick on a Mac in a match's first minute), so those versions named the
---     engine for frames that were ours.
function Telemetry.slow_cause(s: any): string
	if (tonumber(s.nukes) or 0) >= Telemetry.SLOW_NUKES then
		return "nukes"
	end
	local map = if type(s.map) == "table" then s.map else {}
	local function ms(v: any): number
		local n = tonumber(v) or 0
		return if n == n and n > 0 then n else 0
	end
	local units, labels, territory = ms(map.units), ms(map.labels), ms(map.territory)
	local parts = {
		{ "units", units },
		{ "labels", labels },
		{ "territory", territory },
	}
	-- the rest of the map by its own parts (2026-10-27: the rest as one was half of all slow frames,
	-- 70% of them on phones), and what none of them holds
	local rest = ms(map.total) - units - labels - territory
	for _, k in Telemetry.MAP_PARTS do
		local v = ms(map[k])
		table.insert(parts, { "map_" .. k, v })
		rest -= v
	end
	for _, part in {
		{ "map", math.max(rest, 0) },
		{ "hud", ms(s.hud_ms) },
		{ "sim", ms(s.sim_ms) },
		{ "net", ms(s.net_ms) },
		{ "session", ms(s.session_ms) },
		{ "ui", ms(s.ui_ms) },
	} do
		table.insert(parts, part)
	end
	local total, top = 0.0, parts[1]
	for _, part in parts do
		total += part[2]
		if part[2] > top[2] then
			top = part
		end
	end
	if total >= Telemetry.SLOW_SCRIPT_SHARE * math.max(ms(s.frame_ms), 1e-3) then
		return top[1]
	end
	local frame = math.max(ms(s.frame_ms), 1e-3)
	local gpu, render = ms(s.gpu_ms), ms(s.render_ms)
	if math.max(gpu, render) >= Telemetry.SLOW_ENGINE_SHARE * frame then
		return if gpu >= render then "gpu" else "render"
	end
	return "engine"
end

--- The script clocks outside the map and the Sim, cumulative seconds: Session.process, the network
--- handler, the HUD's step and the UI kit's.
function Telemetry._script_clocks(self): { [string]: number }
	local session = self.ctx.session
	local perf = if session ~= nil then session.perf else nil
	local net = if session ~= nil and type(session.env) == "table" then session.env.net else nil
	local ui = self.ui_perf
	return {
		process = if type(perf) == "table" then tonumber(perf.process_s) or 0.0 else 0.0,
		net = if type(net) == "table" then tonumber(net.busy_s) or 0.0 else 0.0,
		ui = if type(ui) == "table" then tonumber(ui.process) or 0.0 else 0.0,
		kit = if type(ui) == "table" then tonumber(ui.kit) or 0.0 else 0.0,
	}
end

--- Once a second (tick): closes a "slow" window when it is SLOW_WINDOW_S old, and reports the match's
--- first one that was slow. `m`: the match's record (it may have ended: a spectator's frames count).
function Telemetry._slow_check(self, m: any)
	local now = os.clock()
	if now - self._slow_at < Telemetry.SLOW_WINDOW_S then
		return
	end
	local frames, time, void = self._slow_frames, self._slow_time, self._slow_void or not self._focused
	local render_s, gpu_s = self._slow_render_s, self._slow_gpu_s
	self._slow_render_s, self._slow_gpu_s = 0.0, 0.0
	local ctx = self.ctx
	local perf = if ctx.session ~= nil then ctx.session.perf else nil
	local step_s = if type(perf) == "table" then tonumber(perf.step_s) or 0.0 else 0.0
	local sim_s = math.max(step_s - self._slow_step_s, 0.0)
	local clocks, was = self:_script_clocks(), self._slow_clocks
	self._slow_clocks = clocks
	self._slow_frames, self._slow_time, self._slow_at, self._slow_void = 0, 0.0, now, false
	self._slow_step_s = step_s
	local st = m.state
	if m.slow_sent or void or frames < 2 or time <= 0 or st == nil then
		return
	end
	local fps = frames / time
	if fps >= Telemetry.SLOW_FPS or Telemetry.minutes(st) * 60 < Telemetry.SLOW_AFTER_S then
		return
	end
	local nukes = 0
	for _ in st.nukes or {} do
		nukes += 1
	end
	local map = nil
	local world = ctx.world
	if type(world) == "table" and type(world.perf_stats) == "function" then
		local ok, stats = pcall(world.perf_stats, world)
		map = if ok then stats else nil
	end
	local mem_mb = 0.0
	pcall(function()
		mem_mb = game:GetService("Stats"):GetTotalMemoryUsageMb()
	end)
	local function per_frame(k: string): number
		return math.max(clocks[k] - (was[k] or 0.0), 0.0) * 1000 / frames
	end
	local cause = Telemetry.slow_cause({
		frame_ms = 1000 / fps,
		nukes = nukes,
		map = map,
		hud_ms = per_frame("kit"),
		sim_ms = sim_s * 1000 / frames,
		net_ms = per_frame("net"),
		session_ms = math.max(per_frame("process") - sim_s * 1000 / frames, 0.0),
		ui_ms = per_frame("ui"),
		render_ms = render_s * 1000 / frames,
		gpu_ms = gpu_s * 1000 / frames,
	})
	m.slow_sent = self:_send("slow", cause, Telemetry.minutes(st), math.floor(fps + 0.5))
	if m.slow_sent and mem_mb > 0 then
		self:_send("slow_mem", cause, math.floor(mem_mb + 0.5))
	end
end

--- What is happening to `me` now (the snapshot's first field). `land` holds {clock, tiles} samples.
function Telemetry.situation(st: any, me: number, land: { { number } }, idle_s: number): string
	local o = st.owners[me]
	if (tonumber(st.playing_since) or -1) < 0 then
		return "Choosing spawn"
	end
	if o == nil or o.tiles <= 0 then
		return "Not spawned"
	end
	for _, a in st.attacks or {} do
		if a.target == me and a.attacker ~= me and not a.retreating then
			return "Under attack"
		end
	end
	local was = if #land > 0 then land[1][2] else o.tiles
	if was > 0 and o.tiles < was * (1 - Telemetry.LAND_CHANGE) then
		return "Losing land"
	end
	if idle_s >= Telemetry.IDLE_S then
		return "Idle"
	end
	if o.tiles > was * (1 + Telemetry.LAND_CHANGE) then
		return "Growing"
	end
	return "Holding"
end

--- Where `me` stands on land among the living.
function Telemetry.standing(st: any, me: number): string
	for i, o in st:ranking() do
		if o.id == me then
			return if i <= 3 then "Top 3" elseif i <= 10 then "Top 10" else "Lower"
		end
	end
	return "No land"
end

--- The snapshot for the open match (sent now; frame counters restart).
function Telemetry._send_state(self, m: any)
	local st = m.state
	local now = os.clock()
	local o = st.owners[m.me]
	-- land samples at most LAND_WINDOW_S old (the oldest is what "was")
	table.insert(m.land, { now, if o then o.tiles else 0 })
	while #m.land > 1 and now - m.land[1][1] > Telemetry.LAND_WINDOW_S do
		table.remove(m.land, 1)
	end
	local fps = if self._frame_time > 0.25 then self._frames / self._frame_time else 0
	self._frames = 0
	self._frame_time = 0.0
	m.state_at = now
	self:_send(
		"state",
		Telemetry.situation(st, m.me, m.land, now - m.last_intent),
		Telemetry.standing(st, m.me),
		math.floor(fps + 0.5)
	)
end

function Telemetry._send(self, kind: string, a: any?, b: any?, c: any?): boolean
	local s = self.ctx.session
	if s ~= nil and type(s.report) == "function" then
		return s:report(kind, a, b, c) == true
	end
	return false
end

--- Minutes since play began in `st` (0 before).
function Telemetry.minutes(st: any): number
	local since = tonumber(st and st.playing_since) or -1
	if since < 0 then
		return 0.0
	end
	local Defs = UITheme.core("Defs")
	return math.max(0.0, (st.tick - since) / Defs.TICK_RATE / 60.0)
end

function Telemetry._open(self): any
	local m = self._match
	if m ~= nil and not m.ended then
		return m
	end
	return nil
end

--- The player's matches before the one being played (before the next one, between matches): the
--- server's count when this session began (the saved [stats] section) and the matches started since.
function Telemetry.matches_before(self): number
	local base = self.matches_base
	if base == nil then
		local s = self.ctx.session
		local stats = if s ~= nil and type(s.load_settings) == "function" then s:load_settings("stats") else nil
		base = if type(stats) == "table" then tonumber(stats.matches) or 0 else 0
	end
	local n = self.matches_started
	if self:_open() ~= nil and n > 0 then
		n -= 1
	end
	return (base :: number) + n
end

--- "Replay as new player": no match counted again.
function Telemetry.new_player(self)
	self.matches_base = 0
	self.matches_started = 0
end

function Telemetry.title_shown(self)
	self._title_wanted = true
	if not self._title_sent then
		-- (retried by tick() when the connection wasn't up yet)
		self._title_sent = self:_send("title")
	end
end

function Telemetry.help(self, where: string)
	self:_send("help", where)
end

function Telemetry.spectate(self)
	self:_send("spectate")
end

--- A new state (match, title backdrop, or a multiplayer resync). Leaving a match before its end
--- reports "left" — except for a multiplayer state, which tick() matches up with the open match.
function Telemetry.bind(self, st: any)
	for _, c in self._conns do
		c:Disconnect()
	end
	table.clear(self._conns)
	local m = self:_open()
	if m ~= nil and m.state ~= st and not (m.multi and self.ctx.state_mode == MODE_MULTI) then
		m.ended = true
		pcall(self._send_state, self, m)
		self:_send("left", m.minutes)
	end
	if st == nil then
		return
	end
	local function c(name: string, cb: (...any) -> ())
		local sig = st[name]
		if type(sig) == "table" and sig.Connect then
			table.insert(self._conns, sig:Connect(cb))
		end
	end
	c("owner_eliminated", function(id: number, killer: number)
		local mm = self:_open()
		if mm == nil or mm.state ~= st or id ~= mm.me then
			return
		end
		mm.ended = true
		local Defs = UITheme.core("Defs")
		local k = st.owners[killer]
		local kind = "unknown"
		if k ~= nil then
			kind = if k.kind == Defs.KIND_NATION then "nation" elseif k.kind == Defs.KIND_TRIBE then "tribe" else "player"
		end
		self:_send("eliminated", Telemetry.minutes(st), kind, killer)
	end)
	c("game_over", function(winner: number, _reason: number)
		local mm = self:_open()
		if mm == nil or mm.state ~= st then
			return
		end
		mm.ended = true
		local rank = 0
		for i, o in st:ranking() do
			if o.id == mm.me then
				rank = i
				break
			end
		end
		self:_send("over", winner ~= 0 and winner == mm.me, Telemetry.minutes(st), rank)
	end)
end

--- Once a second: start the match once this client controls a nation in it, then spawned, whole
--- minutes alive.
function Telemetry.tick(self)
	local ctx = self.ctx
	if self._title_wanted and not self._title_sent then
		self:title_shown()
	end
	local st = ctx.state
	local sm = ctx.state_mode
	if st == nil or (sm ~= MODE_SOLO and sm ~= MODE_MULTI) then
		return
	end
	local me = st.local_owner or 0
	if me == 0 then
		return
	end
	local m = self._match
	if m == nil or m.state ~= st then
		if m ~= nil and not m.ended and m.multi then
			if sm == MODE_MULTI and m.me == me and m.map == st.map_id then
				m.state = st -- the same match after a resync
			else
				m.ended = true
				pcall(self._send_state, self, m)
				self:_send("left", m.minutes)
				m = nil
			end
		else
			m = nil
		end
		if m == nil then
			local mode = "public"
			if sm == MODE_SOLO then
				local d = math.clamp(tonumber(ctx.session and ctx.session.difficulty) or 1, 0, 2)
				mode = "solo" .. tostring(math.floor(d))
			end
			m = {
				state = st,
				me = me,
				multi = sm == MODE_MULTI,
				map = st.map_id,
				minutes = 0.0,
				sent_min = 0,
				spawned = false,
				attacked = false,
				ended = false,
				land = {},
				last_intent = os.clock(),
				state_at = -math.huge,
			}
			self._match = m
			self.matches_started += 1
			self:_send("match_start", mode, tostring(st.map_id or ""))
		end
	end
	self:_slow_check(m)
	if m.ended then
		return
	end
	if os.clock() - m.state_at >= Telemetry.STATE_EVERY_S then
		self:_send_state(m)
	end
	local o = st.owners[me]
	if not m.spawned and o ~= nil and o.tiles > 0 then
		m.spawned = true
		self:_send("spawned")
	end
	if o ~= nil and o.alive then
		m.minutes = Telemetry.minutes(st)
		local whole = math.floor(m.minutes)
		if whole > m.sent_min then
			m.sent_min = whole
			self:_send("alive", m.minutes)
		end
	end
end

--- Every intent the player sends (UICtx.send): the first attack or boat of the match; any intent
--- means the player is not idle.
function Telemetry.on_intent(self, intent: any)
	local m = self:_open()
	if m == nil or type(intent) ~= "table" then
		return
	end
	m.last_intent = os.clock()
	if m.attacked then
		return
	end
	if intent.type == "attack" or intent.type == "boat" then
		m.attacked = true
		self:_send("attack")
	end
end

return Telemetry
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="223">
            <Properties>
              <string name="Name">TitleScreen</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/title_screen.gd (UITitleScreen)
-- Title screen over the live attract-mode globe: AIRFRONT wordmark, Play Solo with difficulty
-- chips, Multiplayer with live server status, How to Play, credits. Also shows the "joining
-- multiplayer" queue card while a match is being prepared.
--
-- Also defines GradientText (the wordmark / game-over headline): per-glyph Rubik Heavy with letter
-- spacing, the WORD_SHADER vertical gradient, the diagonal shine sweep and the fat drop shadow.
-- Roblox caps TextSize at 100, so glyphs render at a smaller TextSize under a UIScale.

local UITheme = require("./UITheme")
local HudArt = require("./HudArt")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UIMaps = require("./UIMaps")
local UICtx = require("./UICtx")
local CrateButton = require("./CrateButton")
local ArsenalButton = require("./ArsenalButton")
local StarterButton = require("./StarterButton")
local GeneralButton = require("./GeneralButton")
local ShopButton = require("./ShopButton")
local PartyPanel = require("./PartyPanel")
local Signal = UITheme.core("Signal")

local TitleScreen = W.class(W.Control)

-- =============================================================================================
-- GradientText
-- =============================================================================================

local GradientText = W.class(W.Control)
TitleScreen.GradientText = GradientText
--- The original's desktop top-left reserve for the wordmark (Airship chat panel; ui_layout_probe.gd).
TitleScreen.DESKTOP_WORD_RESERVE = 440.0
--- The wordmark is at most this share of the screen's width: the width the old name had ("ROWORLD",
--- since 2026-10-25, is wider than "ROFRONT" and reached under the Arsenal and crate buttons, top right).
TitleScreen.WORD_MAX_W = 0.35
--- The credits line under the dock (desktop, phones). It points at the help window by its top-bar name
--- (2026-10-25: "See Help & Credits" instead of "see How to play"; 2026-10-26: no map credit, the World
--- map is RoWorld's own, made from public-domain data).
TitleScreen.CREDITS = "© OpenFront and Contributors  ·  Music by Rodrigo Flores  ·  "
	.. "GNU AGPL v3, no warranty: See Help & Credits"
TitleScreen.CREDITS_SHORT = "© OpenFront and Contributors  ·  Music: Rodrigo Flores  ·  GNU AGPL v3"

local SHINE_HALF = 70.0 -- smoothstep(0, 70, |x - sweep - (y - y0) * 0.35|)

function GradientText.new(text: string, px: number, weight: number?)
	local self = setmetatable({}, GradientText.__mt)
	W.Control._init(self)
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self.text = text
	self.px = px
	self.weight = weight or 900
	self.spacing = 0
	self.top_color = Color3.new(1, 1, 1)
	self.bottom_color = Color3.new(1.0, 0.8, 0.52)
	self.y0 = 0.0 -- gradient start (logical px from the top of the line)
	self.span = 100.0
	self.sweep = -10000.0 -- shine centre x (logical px), off by default
	self.shine = 0.4
	self.shadow = { color = Color3.new(0.0, 0.02, 0.08), alpha = 0.55, offset_y = 6, outline = 14 }
	local canvas = UICtx.canvas(self.gui, "Word")
	canvas.ZIndex = 1
	self._canvas = canvas
	local inner = UICtx.frame(canvas)
	inner.Name = "Inner"
	self._inner = inner
	self._inner_scale = UICtx.make("UIScale", { Scale = 1 }, inner)
	self._glyphs = {}
	self._ts = 1
	self:_rebuild()
	return self
end

--- Roblox TextSize used for the glyphs and the extra scale to reach the Godot font size.
function GradientText._sizes(self): (number, number)
	local want = self.px * UITheme.LINE_EM
	local ts = math.clamp(math.floor(want + 0.5), 1, 100)
	return ts, want / ts
end

function GradientText._rebuild(self)
	for _, g in ipairs(self._glyphs) do
		for _, inst in ipairs({ g.shadow, g.text, g.shine, g.shadow_stroke }) do
			self:_drop_part(inst)
		end
		g.shadow:Destroy()
		g.text:Destroy()
		g.shine:Destroy()
	end
	table.clear(self._glyphs)
	local ts = self:_sizes()
	self._ts = ts
	for _, cp in utf8.codes(self.text) do
		local ch = utf8.char(cp)
		local function lab(z: number): TextLabel
			return UICtx.make("TextLabel", {
				BackgroundTransparency = 1,
				Text = ch,
				FontFace = UITheme.font(self.weight),
				TextSize = ts,
				TextColor3 = Color3.new(1, 1, 1),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				ZIndex = z,
			}, self._inner)
		end
		local g = { ch = ch, shadow = lab(1), text = lab(2), shine = lab(3) }
		local sst = UICtx.make("UIStroke", { Thickness = 1, LineJoinMode = Enum.LineJoinMode.Round }, g.shadow)
		g.shadow_stroke = sst
		-- Register as parts so the node's modulate (fades) reaches them.
		self:_part(g.text, "TextTransparency", 1.0)
		self:_part(g.shine, "TextTransparency", 1.0)
		self:_part(g.shadow, "TextTransparency", self.shadow.alpha)
		self:_part(sst, "Transparency", self.shadow.alpha)
		g.grad = UICtx.make("UIGradient", { Rotation = 90 }, g.text)
		g.shine_grad = UICtx.make("UIGradient", {}, g.shine)
		table.insert(self._glyphs, g)
	end
	self:update_minimum_size()
	self:_redraw()
end

function GradientText.set_text(self, t: string)
	if t == self.text then
		return
	end
	self.text = t
	self:_rebuild()
end

function GradientText.set_px(self, px: number)
	if px == self.px then
		return
	end
	self.px = px
	local ts = self:_sizes()
	if ts ~= self._ts then
		self:_rebuild()
	else
		self:update_minimum_size()
		self:_redraw()
	end
end

function GradientText.set_colors(self, top: Color3, bottom: Color3)
	self.top_color = top
	self.bottom_color = bottom
	self:_redraw()
end

--- Glyph pen positions in logical px (kerning of the whole string, + spacing after each glyph).
function GradientText._pens(self): ({ number }, number)
	local ts, k = self:_sizes()
	local xs = {}
	local prefix = ""
	local n = 0
	for _, cp in utf8.codes(self.text) do
		n += 1
		table.insert(xs, UITheme.measure_px(prefix, ts, self.weight) * k + (n - 1) * self.spacing)
		prefix ..= utf8.char(cp)
	end
	local total = UITheme.measure_px(self.text, ts, self.weight) * k + n * self.spacing
	return xs, total
end

function GradientText._get_minimum_size(self): Vector2
	if self._logo ~= nil then
		local height = self.px * 1.38
		return Vector2.new(height * self._logo_aspect, height)
	end
	local _, total = self:_pens()
	return Vector2.new(math.ceil(total), self.px * UITheme.LINE_EM)
end

function GradientText._on_geometry(self)
	self:_redraw()
end

function GradientText._restyle(self)
	self:_redraw()
end

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

function GradientText._redraw(self)
	if self._logo ~= nil then return end
	local canvas = self._canvas
	canvas.Size = UDim2.fromOffset(self.size.X, self.size.Y);
	(canvas:FindFirstChild("Scale") :: UIScale).Scale = UITheme.scale
	local ts, k = self:_sizes()
	self._inner_scale.Scale = k
	local line_h = self.px * UITheme.LINE_EM
	local xs, total = self:_pens()
	-- Centre the word horizontally in the node (Label HORIZONTAL_ALIGNMENT_CENTER).
	local x0 = math.floor((self.size.X - total) * 0.5 + 0.5)
	-- Vertical gradient from y0 to y0 + span (WORD_SHADER): keypoints in the glyph's own [0, 1].
	local a = clamp01(self.y0 / line_h)
	local b = clamp01((self.y0 + self.span) / line_h)
	if b <= a then
		b = math.min(1, a + 0.001)
	end
	local cseq = ColorSequence.new({
		ColorSequenceKeypoint.new(0, self.top_color),
		ColorSequenceKeypoint.new(a, self.top_color),
		ColorSequenceKeypoint.new(b, self.bottom_color),
		ColorSequenceKeypoint.new(1, self.bottom_color),
	})
	local sh = self.shadow
	for i, g in ipairs(self._glyphs) do
		local gx = x0 + xs[i]
		local next_x = if i < #self._glyphs then x0 + xs[i + 1] - self.spacing else x0 + total - self.spacing
		local gw = math.max(1, next_x - gx)
		-- Inner units: logical / k.
		local ix, iw, ih = gx / k, gw / k + ts * 0.3, ts
		for _, lab in ipairs({ g.text, g.shadow, g.shine }) do
			lab.Position = UDim2.fromOffset(ix, 0)
			lab.Size = UDim2.fromOffset(iw, ih)
		end
		g.grad.Color = cseq
		-- Shadow: offset down, expanded by an outline (Godot shadow_outline_size).
		g.shadow.Position = UDim2.fromOffset(ix, sh.offset_y / k)
		g.shadow.TextColor3 = sh.color
		self:_part(g.shadow, "TextTransparency", sh.alpha)
		g.shadow_stroke.Color = sh.color
		g.shadow_stroke.Thickness = math.max(0, sh.outline * 0.5 / k)
		self:_part(g.shadow_stroke, "Transparency", sh.alpha)
		-- Shine band: + shine * (1 - smoothstep(0, 70, |x - sweep - (y - y0) * 0.35|)), drawn as a
		-- white copy whose transparency gradient is that band in this glyph's box (rotated by the
		-- 0.35 shear converted to the box's aspect).
		local rel = self.sweep - gx -- band centre at the glyph's y0 row, in glyph logical px
		if rel < -SHINE_HALF - gw - line_h or rel > gw + SHINE_HALF + line_h then
			g.shine.Visible = false
		else
			g.shine.Visible = true
			local W_px, H_px = iw * k, ih * k
			-- isolines x - 0.35 y = c  ->  gradient axis along (1, -0.35) in px; in UV space the
			-- direction becomes (1 / W, -0.35 / H) scaled by the box: angle = atan2(-0.35 H, W)...
			local ang = math.deg(math.atan2(-0.35 * H_px, W_px))
			g.shine_grad.Rotation = ang
			-- Distance along the gradient axis per unit t: project the box onto the axis.
			local c, s = math.cos(math.rad(ang)), math.sin(math.rad(ang))
			local L = math.abs(W_px * c) + math.abs(H_px * s) -- px spanned by t = 0..1
			local half_t = SHINE_HALF / math.max(L, 1) * math.sqrt(1 + 0.35 * 0.35)
			-- centre of the band: pixel (rel + y0*0.35 ... ) -> t of the band line through (rel, y0)
			local px_c = rel + 0.35 * self.y0
			local tc = 0.5 + ((px_c - W_px * 0.5) * c + (0 - H_px * 0.5) * s) / L
			local pts = {}
			local function kp(t: number, v: number)
				if t > 0.0005 and t < 0.9995 then
					table.insert(pts, NumberSequenceKeypoint.new(t, v))
				end
			end
			table.insert(pts, NumberSequenceKeypoint.new(0, 1))
			for j = -4, 4 do
				local d = j / 4 -- -1..1 of the half width
				local sm = 1
					- (function(x)
						local u = clamp01(x)
						return u * u * (3 - 2 * u)
					end)(math.abs(d))
				kp(tc + d * half_t, 1 - self.shine * sm)
			end
			table.insert(pts, NumberSequenceKeypoint.new(1, 1))
			table.sort(pts, function(p, q)
				return p.Time < q.Time
			end)
			-- NumberSequence needs strictly increasing times.
			local clean = {}
			local last = -1
			for _, p in ipairs(pts) do
				if p.Time > last + 1e-4 then
					table.insert(clean, p)
					last = p.Time
				end
			end
			if clean[#clean].Time < 1 then
				table.insert(clean, NumberSequenceKeypoint.new(1, 1))
			end
			g.shine_grad.Transparency = NumberSequence.new(clean)
		end
	end
end

-- =============================================================================================
-- Title screen
-- =============================================================================================

--- A lobby card goes when its countdown here reaches this (the server closes joins at
--- LobbyRules.JOIN_CLOSE_S = 6 s; the card's whole seconds round up).
TitleScreen.JOIN_CLOSE_S = 5
TitleScreen.DIFFS = { [0] = "Relaxed", "Standard", "Brutal" }
TitleScreen.DIFF_BLURB = {
	[0] = "Gentle AI: slower growth and a long early peace.",
	"A fair fight: nations respect a short early peace.",
	"Aggressive AI that grows fast and hunts you early.",
}

local INK = Color3.new(0.01, 0.015, 0.05)

--- Full-rect image node (radial gradient textures), alpha follows modulate.
local function image_node(image: string, color: Color3?, alpha: number?)
	local g = Instance.new("ImageLabel")
	g.BackgroundTransparency = 1
	g.BorderSizePixel = 0
	g.ScaleType = Enum.ScaleType.Stretch
	g.Image = image or ""
	g.ImageColor3 = color or Color3.new(1, 1, 1)
	local n = W.wrap(g)
	n:set_mouse_filter(W.MOUSE_IGNORE)
	n:_part(g, "ImageTransparency", alpha or 1.0)
	return n
end

--- Full-rect vertical gradient node: colour c, alpha keypoints {t, a}.
local function vgrad_node(c: Color3, keys: { { number } })
	local g = Instance.new("Frame")
	g.BorderSizePixel = 0
	g.BackgroundColor3 = c
	local seq = {}
	for _, kpt in ipairs(keys) do
		table.insert(seq, NumberSequenceKeypoint.new(kpt[1], 1 - kpt[2]))
	end
	UICtx.make("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(seq) }, g)
	local n = W.wrap(g)
	n:set_mouse_filter(W.MOUSE_IGNORE)
	n:_part(g, "BackgroundTransparency", 1.0)
	return n
end

--- Horizontal amber hairline fading to one side (tag lines).
local function tag_line(flip: boolean)
	local g = Instance.new("Frame")
	g.BorderSizePixel = 0
	g.BackgroundColor3 = UITheme.AMBER
	local seq = if flip
		then NumberSequence.new({ NumberSequenceKeypoint.new(0, 1 - 0.85), NumberSequenceKeypoint.new(1, 1) })
		else NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 1 - 0.85) })
	UICtx.make("UIGradient", { Transparency = seq }, g)
	local n = W.wrap(g)
	n:set_mouse_filter(W.MOUSE_IGNORE)
	n:_part(g, "BackgroundTransparency", 1.0)
	n:set_min_size(Vector2.new(72, 2))
	n.size_flags_vertical = W.SHRINK_CENTER
	return n
end

function TitleScreen.new(c: any)
	local self = setmetatable({}, TitleScreen.__mt)
	W.Control._init(self)
	self.ctx = c
	self.play_solo = Signal.new()
	--- the map button: UIRoot opens the map picker
	self.pick_map = Signal.new()
	self.play_multi = Signal.new()
	self.show_help = Signal.new()
	self.leave_queue = Signal.new()
	--- the waiting room's vote-to-start toggle
	self.vote_start = Signal.new()
	--- (lobby_id) a public lobby card was clicked
	self.join_lobby = Signal.new()
	--- (mode) Quick Play: a seat in the soonest public match of that kind ("ffa" | "team")
	self.join_public = Signal.new()
	--- Quick Play: leave the line
	self.leave_line = Signal.new()
	--- the crate button (top right): UIRoot opens the Locker
	self.open_locker = Signal.new()
	self.open_arsenal = Signal.new()
	--- the starter pack's button (under the pair, while its offer runs): UIRoot opens the offer
	self.open_starter = Signal.new()
	self.open_shop = Signal.new()
	--- RoWorld General's button (Data/Subscription): UIRoot opens its window
	self.open_general = Signal.new()
	--- (action, user_id?) the party panel (Session.party_action)
	self.party_action = Signal.new()
	self.difficulty =
		math.clamp(tonumber(c:setting("difficulty", UICtx.DEFAULT_DIFFICULTY)) or UICtx.DEFAULT_DIFFICULTY, 0, 2)
	self._dock_compact = -1
	self._sweep_t = -1.0
	self._lobby = {}
	self._lobby_msec = 0
	self._lobbies = nil :: { any }?
	self._lobbies_msec = 0
	self._joining = nil :: string?
	self._joining_msec = 0
	--- the kinds of public match the hub offers (nil: not said yet)
	self._kinds = nil :: { string }?
	--- Quick Play (Session.public): asking / in line / on the way, and since when (UICtx.msec)
	self._public = { state = "idle" } :: { [string]: any }
	self._public_msec = 0
	self._public_since = 0
	self._accum = 0.0
	self._dot_t = 0.0
	self._tick_sec = -1
	self._hide_tween = nil
	self._chips = {}
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:_build_backdrop()
	self:_build_head()
	self:_build_dock()
	self:_build_queue()
	self:_build_solo_menu()
	-- credits: the copyright notice the code's licence asks to keep visible, Rodrigo Flores'
	-- soundtrack (Orchestral Ambients) and the licence (2026-10-25: the full
	-- notices are in How to play, HelpOverlay.LEGAL); phones get the short line (apply_layout)
	self._credits = UITheme.label(
		TitleScreen.CREDITS,
		11,
		500,
		UITheme.c(UITheme.TEXT_3, 0.85),
		1
	)
	self._credits:set_alignment(W.ALIGN_CENTER)
	self:add_child(self._credits)
	-- cosmetic crates: a big animated chest top right (the top bar's small icon was easy to miss)
	self._crate_btn = CrateButton.new(c)
	self._crate_btn.pressed:Connect(function()
		self.open_locker:Fire()
	end)
	self:add_child(self._crate_btn)
	-- its twin, beside it: the Arsenal (Data/Arsenal) and the player's Stars
	self._arsenal_btn = ArsenalButton.new(c)
	self._arsenal_btn.pressed:Connect(function()
		self.open_arsenal:Fire()
	end)
	self:add_child(self._arsenal_btn)
	-- under them, the flag shop (Data/Shop; shown while it sells something here)
	self._shop_btn = ShopButton.new(c)
	self._shop_btn.pressed:Connect(function()
		self.open_shop:Fire()
	end)
	self:add_child(self._shop_btn)
	-- under those, while the starter pack's offer runs (Data/Starter)
	self._starter_btn = StarterButton.new(c)
	self._starter_btn.pressed:Connect(function()
		self.open_starter:Fire()
	end)
	self:add_child(self._starter_btn)
	-- and RoWorld General's (Data/Subscription; 2026-10-27), once the subscription exists
	self._general_btn = GeneralButton.new(c)
	self._general_btn.pressed:Connect(function()
		self.open_general:Fire()
	end)
	self:add_child(self._general_btn)
	-- the party (team games on: staging only for now; hidden until the server sends one)
	self._party = PartyPanel.new(c)
	self._party.on_action = function(action: string, uid: number?)
		self.party_action:Fire(action, uid)
	end
	self:add_child(self._party)
	--- in a party, and whether this player leads it (only the leader picks a public match)
	self._in_party = false
	self._party_leader = true
	self:set_process(true)
	return self
end

--- The player's party (server/Party.state), or nil (parties are off).
function TitleScreen.set_party(self, st: any)
	self._party:set_state(st)
	local n = if type(st) == "table" and type(st.members) == "table" then #st.members else 0
	self._in_party = n >= 2
	self._party_leader = not self._in_party or st.leader == true
	self:_refresh_mp()
end

function TitleScreen._build_backdrop(self)
	local S = UICtx.shapes()
	self._vignette = image_node(S.title_vignette, INK, 1.0)
	self._vignette:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:add_child(self._vignette)
	self._bottom_shade = vgrad_node(INK, { { 0, 0.0 }, { 1, 0.8 } })
	self._bottom_shade:set_anchors(0, 0.5, 1, 1)
	self:add_child(self._bottom_shade)
	self._top_shade = vgrad_node(Color3.new(0.005, 0.01, 0.035), { { 0, 0.92 }, { 0.55, 0.6 }, { 1, 0.0 } })
	self._top_shade:set_anchors(0, 0, 1, 0.5)
	self:add_child(self._top_shade)
	self._fade = W.ColorRect.new(UITheme.rgba(0.005, 0.008, 0.03, 0.72))
	self._fade:set_mouse_filter(W.MOUSE_IGNORE)
	self._fade:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._fade:set_modulate_a(0.0)
	self:add_child(self._fade)
end

function TitleScreen._build_head(self)
	local S = UICtx.shapes()
	self._head = UITheme.vbox(0)
	self._head:set_alignment(W.ALIGN_CENTER)
	self:add_child(self._head)
	self._emblem = UITheme.icon_rect("app_icon", 64.0, Color3.new(1, 1, 1))
	self._emblem.size_flags_horizontal = W.SHRINK_CENTER
	self._head:add_child(self._emblem)
	-- Warm glow behind the wordmark (placed after the shades, before the fade).
	self._glow = image_node(S.title_glow, Color3.new(1, 1, 1), 1.0)
	self:add_child(self._glow)
	self:move_child(self._glow, 3)

	local word = GradientText.new("SHINOBI FRONT", 120, 900)
	word.spacing = 14
	word.shadow = { color = Color3.new(0.0, 0.02, 0.08), alpha = 0.55, offset_y = 6, outline = 14 }
	word:set_colors(Color3.new(1, 1, 1), Color3.new(1.0, 0.8, 0.52))
	word.size_flags_horizontal = W.SHRINK_CENTER
	local logo, aspect = HudArt.add(word.gui, "logo", 2)
	if logo ~= nil then
		word._logo = logo
		word._logo_aspect = aspect
		word._canvas.Visible = false
		logo.Size = UDim2.fromScale(1, 1)
		logo.ScaleType = Enum.ScaleType.Fit
		word:_part(logo, "ImageTransparency", 1)
		word:update_minimum_size()
	end
	self._word = word
	self._head:add_child(word)

	self._tag_row = UITheme.hbox(16)
	self._tag_row:set_alignment(W.ALIGN_CENTER)
	self._tag_l = tag_line(false)
	self._tag_r = tag_line(true)
	self._tag = UITheme.label("", 15, 600, Color3.new(0.86, 0.89, 0.97), 6)
	self._tag_row:add_child(self._tag_l)
	self._tag_row:add_child(self._tag)
	self._tag_row:add_child(self._tag_r)
	self._head:add_child(self._tag_row)
	self._tag_row:set_visible(false)
end

function TitleScreen._build_dock(self)
	local ctx = self.ctx
	self._dock = GlassPanel.new(20.0, 18.0, 18, true, 28)
	self:add_child(self._dock)
	local v = UITheme.vbox(12)
	self._dock_v = v
	self._dock:add_child(v)
	self._greet = UITheme.label("", 13, 500, UITheme.TEXT_2)
	self._greet:set_alignment(W.ALIGN_CENTER)

	self._solo = UITheme.button("PLAY SOLO", "PrimaryButton", "play", 58.0)
	self._solo:add_theme_constant_override("icon_max_width", 18)
	self._solo:set_font_size(19)
	self._solo.pressed:Connect(function()
		self:open_solo_menu()
	end)

	-- the solo map (from the map list; UIRoot.set_map_name keeps the label current)
	local mb = UITheme.button("", "GlassButton", "globe", 42.0)
	mb.alignment = W.ALIGN_LEFT
	mb:set_font_size(14)
	mb.pressed:Connect(function()
		self.pick_map:Fire()
	end)
	self._map_btn = mb
	self:set_map_name("Shinobi World")

	local dr = UITheme.hbox(8)
	self._diff_row = dr
	self._diff_caption = UITheme.caption("Difficulty")
	self._diff_caption.size_flags_vertical = W.SHRINK_CENTER
	self._diff_caption:set_min_size(Vector2.new(84, 0))
	dr:add_child(self._diff_caption)
	for i = 0, 2 do
		local chip = UITheme.button(TitleScreen.DIFFS[i], "ChipButton", "", 34.0)
		chip.toggle_mode = true
		chip.size_flags_horizontal = W.EXPAND_FILL
		chip:set_pressed_no_signal(i == self.difficulty)
		chip.pressed:Connect(function()
			-- ButtonGroup: exactly one chip stays pressed.
			self.difficulty = i
			for j, ch in ipairs(self._chips) do
				ch:set_pressed_no_signal(j - 1 == i)
			end
			ctx:set_setting("difficulty", i)
			self:_refresh_diff()
		end)
		table.insert(self._chips, chip)
		dr:add_child(chip)
	end
	self._diff_desc = UITheme.label("", 12, 500, UITheme.TEXT_2)
	self._diff_desc:set_alignment(W.ALIGN_CENTER)
	self._diff_desc:set_autowrap(true)
	self._diff_desc:set_min_size(Vector2.new(360, 0))
	self:_refresh_diff()
	-- desktop: "PUBLIC MATCHES" between two rules, above the lobby cards
	local sec = UITheme.hbox(10)
	local l1 = UITheme.hdivider()
	l1.size_flags_horizontal = W.EXPAND_FILL
	l1.size_flags_vertical = W.SHRINK_CENTER
	sec:add_child(l1)
	local cap = UITheme.caption("Public matches", 11, UITheme.CYAN)
	cap.size_flags_vertical = W.SHRINK_CENTER
	sec:add_child(cap)
	local l2 = UITheme.hdivider()
	l2.size_flags_horizontal = W.EXPAND_FILL
	l2.size_flags_vertical = W.SHRINK_CENTER
	sec:add_child(l2)
	self._dock_div = sec

	local row = UITheme.hbox(10)
	self._mp_row = row
	-- public-match cards (Quick Play): one per kind; before the list arrives the first card shows the
	-- server status.
	-- (three cards, one per kind of public match, 2026-10-19: the world map is always open; and the
	-- title screen's spectating was no longer needed, so the live match card, its eye button and
	-- WATCH LIVE went)
	local c1 = self:_lobby_card(1)
	self._cards = { c1, self:_lobby_card(2), self:_lobby_card(3) }
	local mp = c1.btn
	self._mp = mp
	self._mp_title = c1.title
	self._mp_dot = c1.dot
	self._mp_status = c1.status
	self._mp_join = c1.pill
	self._mp_join_l = c1.pill_l
	self._mp_content = c1.content
	self._mp2 = self._cards[2].btn
	--- phones: the two next public matches, one above the other, between PLAY SOLO and the buttons
	self._mp_col = UITheme.vbox(6)
	self._mp3 = self._cards[3].btn
	self._mp3:set_visible(false)
	row:add_child(mp)

	self._help = UITheme.button("HOW TO PLAY", "GlassButton", "help", 62.0)
	self._help:set_font_size(13)
	self._help.pressed:Connect(function()
		self.show_help:Fire()
	end)
	row:add_child(self._help)
	-- The dock children are placed by _reflow_dock.
	self._dock_nodes = {
		self._greet,
		self._solo,
		self._dock_div,
		self._mp_row,
		self._mp,
		self._mp2,
		self._mp3,
		self._help,
		self._mp_col,
	}
end

--- The solo map's name on the map button.
function TitleScreen.set_map_name(self, name: string)
	self._map_btn:set_text("Map:  " .. name)
end

--- One public-match card: map thumbnail, title, status line with a dot, and a JOIN pill.
function TitleScreen._lobby_card(self, index: number): { [string]: any }
	local btn = W.Button.new("", if index == 1 then "PublicButton" else "GlassButton")
	btn:set_min_size(Vector2.new(0, 62))
	btn.size_flags_horizontal = W.EXPAND_FILL
	local card: { [string]: any } = { btn = btn, lobby = nil }
	btn.pressed:Connect(function()
		if card.mode ~= nil then
			-- Quick Play: the kind of match, not a lobby (the hub seats us in the soonest with room)
			local pub = self._public
			if pub.state == "line" and pub.mode == card.mode then
				self.leave_line:Fire()
			elseif pub.state == "idle" and self._joining == nil then
				self:set_public({ state = "joining", mode = card.mode })
				self.join_public:Fire(card.mode)
			end
		elseif index == 1 then
			self.play_multi:Fire()
		end
	end)
	local mm = W.Margin.new()
	mm:set_mouse_filter(W.MOUSE_IGNORE)
	mm:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	mm:add_theme_constant_override("margin_left", 10)
	mm:add_theme_constant_override("margin_right", 12)
	btn:add_child(mm)
	local mh = UITheme.hbox(12)
	mm:add_child(mh)
	-- map thumbnail (a raw ImageLabel in a sized kit node; the users icon until a map is known)
	local th = W.Control.new()
	th:set_min_size(Vector2.new(58, 40))
	th:set_mouse_filter(W.MOUSE_IGNORE)
	th.size_flags_vertical = W.SHRINK_CENTER
	local img = Instance.new("ImageLabel")
	img.Name = "Thumb"
	img.BackgroundTransparency = 1
	img.ScaleType = Enum.ScaleType.Fit
	img.Size = UDim2.fromScale(1, 1)
	img.ZIndex = 20
	img.Parent = th.gui
	-- a registered part follows the title's fades (a raw image showed before its card did)
	th:_part(img, "ImageTransparency", 1.0)
	card.thumb = img
	th:set_visible(false)
	mh:add_child(th)
	local uic = UITheme.icon_rect("users", 22.0, UITheme.CYAN)
	uic.size_flags_vertical = W.SHRINK_CENTER
	card.icon = uic
	card.thumb_node = th
	mh:add_child(uic)
	local mv = UITheme.vbox(1)
	mv.size_flags_vertical = W.SHRINK_CENTER
	mv.size_flags_horizontal = W.EXPAND_FILL
	card.title = UITheme.label("PUBLIC MATCH", 15, 800, UITheme.TEXT, 2)
	card.title.text_overrun_behavior = W.OVERRUN_ELLIPSIS
	card.title.clip_text = true
	mv:add_child(card.title)
	local sr = UITheme.hbox(6)
	card.dot = W.Panel.new()
	card.dot:set_min_size(Vector2.new(7, 7))
	card.dot.size_flags_vertical = W.SHRINK_CENTER
	card.dot:set_mouse_filter(W.MOUSE_IGNORE)
	card.dot:add_theme_stylebox_override("panel", UITheme.flat(UITheme.TEXT_3, 4))
	sr:add_child(card.dot)
	card.status = UITheme.label("Connecting…", 12, 500, UITheme.TEXT_2)
	card.status.text_overrun_behavior = W.OVERRUN_ELLIPSIS
	card.status.clip_text = true
	card.status.size_flags_horizontal = W.EXPAND_FILL
	card.status:set_min_size(Vector2.new(60, 0))
	sr:add_child(card.status)
	mv:add_child(sr)
	mh:add_child(mv)
	card.pill = W.Panel.new()
	card.pill:set_mouse_filter(W.MOUSE_IGNORE)
	card.pill.size_flags_vertical = W.SHRINK_CENTER
	card.pill:add_theme_stylebox_override(
		"panel",
		UITheme.flat(UITheme.c(UITheme.CYAN, 0.16), 999, UITheme.c(UITheme.CYAN, 0.55), 1, 10.0, 3.0)
	)
	card.pill_l = UITheme.label("JOIN", 11, 800, UITheme.CYAN, 1)
	card.pill:add_child(card.pill_l)
	mh:add_child(card.pill)
	card.content = mh
	return card
end

--- The game-wide public lobbies ({id, map, map_name, max, players, starts_in, joinable}, soonest
--- first) from the hub server, and the kinds of public match it offers (Quick Play).
function TitleScreen.set_lobbies(self, list: { any }?, kinds: { string }?)
	self._lobbies = list
	self._lobbies_msec = UICtx.msec()
	if kinds ~= nil then
		self._kinds = kinds
	end
	if self._joining ~= nil and UICtx.msec() - (self._joining_msec or 0) > 20000 then
		self._joining = nil -- the teleport never happened (a notice explains why)
	end
	-- asking, or seated and on the way, with no word for 20 s: the teleport never happened
	local st = self._public.state
	if (st == "joining" or st == "going") and UICtx.msec() - self._public_msec > 20000 then
		self._public = { state = "idle" }
	end
	self:_refresh_mp()
end

--- Quick Play's state from the hub (Session.public): { state = "joining" | "line" | "going" |
--- "idle", mode, info = { map, map_name }? }.
function TitleScreen.set_public(self, st: { [string]: any })
	local prev = self._public.state
	self._public = table.clone(st)
	if st.state ~= prev then
		self._public_msec = UICtx.msec()
		if prev == "idle" then
			self._public_since = UICtx.msec()
		end
	end
	self:_refresh_mp()
end

--- True while asking for, waiting for, or on the way to a public match.
function TitleScreen.public_busy(self): boolean
	return self._public.state ~= "idle"
end

--- A join attempt ended without a teleport (the server said why).
function TitleScreen.join_failed(self)
	self._joining = nil
	if self._public.state == "joining" then
		self._public = { state = "idle" }
	end
	self:_refresh_mp()
end

function TitleScreen._build_queue(self)
	self._queue = GlassPanel.new(26.0, 22.0, 18, true, 28)
	self:add_child(self._queue)
	local v = UITheme.vbox(10)
	self._queue:add_child(v)
	local h = UITheme.hbox(12)
	local uic = UITheme.icon_rect("users", 26.0, UITheme.CYAN)
	uic.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(uic)
	self._q_title = UITheme.label("JOINING MULTIPLAYER", 18, 800, UITheme.TEXT, 2)
	self._q_title.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self._q_title)
	v:add_child(h)
	self._q_status = UITheme.label("Contacting the server…", 14, 600, UITheme.AMBER)
	v:add_child(self._q_status)
	self._q_players = UITheme.label("", 12, 500, UITheme.TEXT_2)
	self._q_players:set_autowrap(true)
	self._q_players:set_min_size(Vector2.new(340, 0))
	v:add_child(self._q_players)
	local vote = UITheme.button("Vote to start", "PrimaryButton", "play", 44.0)
	self._q_vote = vote
	vote.pressed:Connect(function()
		self.vote_start:Fire()
	end)
	vote:set_visible(false)
	v:add_child(vote)
	local leave = UITheme.button("Leave queue", "GlassButton", "exit", 44.0)
	self._q_leave = leave
	leave.pressed:Connect(function()
		self.leave_queue:Fire()
	end)
	v:add_child(leave)
	self._queue:set_visible(false)
end

-- ---------------------------------------------------------------------------------------------
-- Layout & state
-- ---------------------------------------------------------------------------------------------

function TitleScreen.apply_layout(self)
	local ctx = self.ctx
	local vp = ctx.vp
	local compact = ctx.compact
	local word_px = math.clamp(math.min(vp.X * 0.078, vp.Y * 0.15), 44.0, 132.0)
	self:_size_word(word_px)
	local w_cap = vp.X * TitleScreen.WORD_MAX_W
	local w_now = self._word:get_combined_minimum_size().X
	if w_now > w_cap then
		word_px = math.max(44.0, word_px * w_cap / w_now)
		self:_size_word(word_px)
	end
	-- Keep the wordmark clear of the reserved top-left HUD: shrink it while it can stay centred,
	-- otherwise move the whole composition into the free column on the right.
	local col_x = vp.X * 0.5
	if not compact then
		local min_left = ctx.reserved_top_left.Max.X + 16.0
		-- The original's desktop always reserved Airship's chat panel (airship_reserved: 440 px wide,
		-- the desktop app opens it by default), so its wordmark was fitted to 1600 - 2 x 456 px at
		-- 1600x900. Roblox's collapsed chat reserves only the top-bar row, which left the word 11.7 %
		-- larger (review_visual P1-8). Keep the original's desktop proportions for the word's size;
		-- the real reserve still decides when the composition must move aside.
		local fitted = false
		if not ctx.touch then
			local want_left = math.max(min_left, TitleScreen.DESKTOP_WORD_RESERVE + 16.0)
			local w0 = self._word:get_combined_minimum_size().X
			if col_x - w0 * 0.5 < want_left then
				local fit_px = word_px * (vp.X - 2.0 * want_left) / math.max(w0, 1.0)
				if fit_px >= 88.0 then
					word_px = fit_px
					self:_size_word(word_px)
					fitted = true
				end
			end
		end
		local w = self._word:get_combined_minimum_size().X
		if not fitted and col_x - w * 0.5 < min_left then
			local fit_px = word_px * (vp.X - 2.0 * min_left) / math.max(w, 1.0)
			if fit_px >= 88.0 then
				word_px = fit_px
			else
				col_x = (min_left + vp.X - 24.0) * 0.5
				word_px = math.min(word_px, word_px * (vp.X - 24.0 - min_left) / math.max(w, 1.0))
			end
			self:_size_word(word_px)
		end
	end
	local dx = col_x - vp.X * 0.5
	local emblem_px = if compact or self._word._logo ~= nil then 0.0 else math.clamp(word_px * 0.56, 44.0, 76.0)
	self._emblem:set_visible(emblem_px > 0.0)
	self._emblem:set_min_size(Vector2.new(emblem_px, emblem_px))
	self._tag:set_font_size(if compact then 11 else 15)
	self._tag_l:set_min_size(Vector2.new(if compact then 40 else 72, 2))
	self._tag_r:set_min_size(self._tag_l.custom_minimum_size)
	local head_top = (if compact then 56.0 else math.max(vp.Y * 0.07, 40.0)) + ctx.insets.y
	if compact then
		-- Phones: keep the wordmark centred, below the top bar row when they would touch.
		local ww = self._word:get_combined_minimum_size().X
		if (vp.X - ww) * 0.5 < ctx.reserved_top_left.Max.X + 8.0 then
			head_top = math.max(head_top, ctx.reserved_top_left.Max.Y + 2.0)
		end
	end
	local head = self._head
	head.anchor_left, head.anchor_right, head.anchor_top, head.anchor_bottom = 0.5, 0.5, 0.0, 0.0
	head.grow_horizontal = W.GROW_BOTH
	head.grow_vertical = W.GROW_END
	head.offset_left, head.offset_right = dx, dx
	head.offset_top, head.offset_bottom = head_top, head_top
	head:reset_size()
	local wsize = self._word:get_combined_minimum_size()
	self._word.y0 = wsize.Y * 0.18
	self._word.span = wsize.Y * 0.66
	self._word:_redraw()
	-- Warm glow behind the wordmark.
	local gw = wsize.X * 1.5
	local gh = wsize.Y * 2.4
	local gy = head_top + emblem_px + wsize.Y * 0.5 - gh * 0.5
	self._glow:set_offsets(col_x - gw * 0.5, gy, col_x + gw * 0.5, gy + gh)

	self:_reflow_dock(compact)
	self._diff_caption:set_visible(not compact)
	local dock_w = if not compact then 560.0 else math.min(760.0, vp.X - ctx.insets.x - ctx.insets.z - 16.0)
	self._dock:set_min_size(Vector2.new(dock_w, 0))
	if compact then
		self._dock:set_padding(10.0, 8.0, 10.0, 8.0)
	else
		self._dock:set_padding(20.0, 18.0, 20.0, 18.0)
	end
	local pv = if compact then self:_phone_dock() else ""
	local grid = pv == "grid" or pv == "grid2"
	self._solo:set_min_size(
		Vector2.new(if compact and not grid then 150 else 0, if grid then 44 elseif compact then 52 else 50)
	)
	self._solo:set_font_size(if compact then 15 else 17)
	self._solo_panel:set_min_size(Vector2.new(dock_w, 0))
	if compact then
		self._solo_panel:set_padding(12.0, 10.0, 12.0, 10.0)
		self._solo_v:set_separation(8)
	else
		self._solo_panel:set_padding(20.0, 18.0, 20.0, 18.0)
		self._solo_v:set_separation(12)
	end
	self._start:set_min_size(Vector2.new(0, if compact then 48 else 58))
	self._start:set_font_size(if compact then 16 else 19)
	self._mp:set_min_size(
		Vector2.new(
			if compact and pv ~= "stack"
				then 0
				else math.max(if compact then 250.0 else 0.0, self._mp_content:get_combined_minimum_size().X + 28.0),
			if compact then 52 else 62
		)
	)
	self._mp2:set_min_size(Vector2.new(0, if compact then 52 else 62))
	self._mp3:set_min_size(Vector2.new(0, if compact then 52 else 62))
	-- icon-only everywhere: the lobby card beside it needs the width for its status line
	self._help:set_min_size(Vector2.new(if compact then 56 else 62, if compact then 56 else 62))
	self._help:set_text("")
	self._help.icon_alignment = W.ALIGN_CENTER
	for _, ch in ipairs(self._chips) do
		ch:set_min_size(Vector2.new(if compact then 64 else 0, if ctx.touch then 44 else 34))
		ch:set_font_size(if compact then 12 else 13)
	end
	self._diff_desc:set_font_size(if compact then 11 else 12)
	self._diff_desc:set_min_size(Vector2.new(if compact then 0 else 360, 0))
	self._diff_desc:set_autowrap(not compact)
	self._greet:set_visible(not compact)
	-- (phones: room under the dock for the credits line)
	local bottom = (if not compact then 40.0 else 20.0) + ctx.insets.w
	for _, cn in ipairs({ self._dock, self._queue, self._solo_panel }) do
		cn.anchor_left, cn.anchor_right, cn.anchor_top, cn.anchor_bottom = 0.5, 0.5, 1.0, 1.0
		cn.grow_horizontal = W.GROW_BOTH
		cn.grow_vertical = W.GROW_BEGIN
		cn.offset_left, cn.offset_right = dx, dx
		cn.offset_top, cn.offset_bottom = -bottom, -bottom
		cn:reset_size()
	end
	-- phones too: a line under the dock
	self._credits:set_visible(true)
	self._credits:set_text(if compact then TitleScreen.CREDITS_SHORT else TitleScreen.CREDITS)
	self._credits:set_font_size(if compact then 10 else 11)
	local cb = if compact then 2.0 else 14.0
	self._credits:set_anchors(0, 1, 1, 1)
	self._credits:set_offsets(0, -(cb + ctx.insets.w + 14.0), 0, -(cb + ctx.insets.w))
	self:_place_crate_button(compact, head_top)
	self._party:apply_layout()
end

--- The crate button, top right: level with the wordmark's top on desktop; on phones up in the
--- screen's top right corner (2026-10-04: it and the Arsenal button moved up nearer the top and
--- further right), under Roblox's top bar row only when that row has controls of its own on the
--- right.
function TitleScreen._place_crate_button(self, compact: boolean, head_top: number)
	local ctx = self.ctx
	local vp = ctx.vp
	local ins = ctx.insets
	local b = self._crate_btn
	b:set_scale(if compact then CrateButton.PHONE_K else 1.0)
	local size = b:size_px()
	-- (phones: halfway into the safe-area band beside the notch, which sits at mid height and leaves
	-- the corner free; the rest of the band keeps the pair off the screen's round corner)
	local right = if compact then vp.X - math.max(14.0, ins.z * 0.45) else vp.X - ins.z - 28.0
	local top = if compact then math.max(6.0, ins.y * 0.5) else head_top
	local ok, inset = pcall(function()
		return game:GetService("GuiService").TopbarInset
	end)
	if ok and inset.Height > 0 then
		-- TopbarInset is the row's free part, in px from the safe area's corner. (It was compared
		-- with full-screen logical px before, so on a notched phone the pair always went under the
		-- row, though nothing of Roblox's was on the right.)
		local free = ctx:to_logical(Vector2.new(inset.Max.X, inset.Max.Y))
		if (vp.X - ins.z) - free.X > 24.0 and right > free.X and top < free.Y then
			top = free.Y + 6.0
		end
	end
	b:set_anchors(0, 0, 0, 0)
	b:set_offsets(right - size.X, top, right, top + size.Y)
	-- the Arsenal button sits beside it, to its left (the top left belongs to Roblox's chat window)
	local a = self._arsenal_btn
	a:set_scale(if compact then ArsenalButton.PHONE_K else 1.0)
	local asz = a:size_px()
	local aright = right - size.X - (if compact then 4.0 else 22.0)
	local atop = top + (size.Y - asz.Y)
	a:set_anchors(0, 0, 0, 0)
	a:set_offsets(aright - asz.X, atop, aright, atop + asz.Y)
	-- the flag shop's button under the pair, right-aligned with the crate button (always there while
	-- the shop sells: the starter pack's, which comes and goes, goes under it)
	local gap = if compact then 10.0 else 22.0
	local shb = self._shop_btn
	shb:set_scale(if compact then ShopButton.PHONE_K else 1.0)
	local shsz = shb:size_px()
	local shtop = top + size.Y + gap
	shb:set_anchors(0, 0, 0, 0)
	shb:set_offsets(right - shsz.X, shtop, right, shtop + shsz.Y)
	shb:refresh()
	-- the starter pack's button under it
	local sb = self._starter_btn
	sb:set_scale(if compact then StarterButton.PHONE_K else 1.0)
	local ssz = sb:size_px()
	local stop = if shb.visible then shtop + shsz.Y + (if compact then 8.0 else 14.0) else shtop
	sb:set_anchors(0, 0, 0, 0)
	sb:set_offsets(right - ssz.X, stop, right, stop + ssz.Y)
	-- RoWorld General's under them all
	local gb = self._general_btn
	gb:set_scale(if compact then GeneralButton.PHONE_K else 1.0)
	local gsz = gb:size_px()
	local below = if sb.visible then stop + ssz.Y else (if shb.visible then shtop + shsz.Y else top + size.Y)
	local gtop = below + (if compact then 8.0 else 14.0)
	gb:set_anchors(0, 0, 0, 0)
	gb:set_offsets(right - gsz.X, gtop, right, gtop + gsz.Y)
end

--- RoWorld General's button says whether the player is one (Session.general).
function TitleScreen.refresh_general(self)
	self._general_btn:refresh()
	self:_refresh_greeting()
end

function TitleScreen._refresh_greeting(self)
	local n = self.ctx:username()
	-- (a RoWorld General is greeted as one: Data/Subscription)
	local s0 = self.ctx.session
	local rank = if s0 ~= nil and s0.general == true then "General" else "Commander"
	local text = if n ~= "Commander" and n ~= "" then ("Welcome, " .. rank .. " " .. n) else ("Welcome, " .. rank)
	-- game admins (the server told this client which players are bots): say so, so it's easy to check
	local s = self.ctx.session
	if s ~= nil and s.admin_bots ~= nil then
		text ..= "  ·  Admin"
	end
	self._greet:set_text(text)
end

--- Phones' dock layout: "grid2" (shipped 2026-09-27) the public-match cards side by side over PLAY
--- SOLO; also "grid" (those rows swapped), "row" (one cramped row) and "stack"
--- (v35: the matches stacked between PLAY SOLO and the buttons). Studio: workspace attribute
--- AF_PHONE_DOCK overrides it.
TitleScreen.PHONE_DOCK = "grid2"
--- World's own kind of public match (LobbyRules.MODE_WORLD, on LobbyRules.WORLD_ID): its card always
--- shows it.
TitleScreen.WORLD_MAP = UIMaps.DEFAULT_ID

function TitleScreen._phone_dock(_self): string
	local v = TitleScreen.PHONE_DOCK
	pcall(function()
		if game:GetService("RunService"):IsStudio() then
			local a = workspace:GetAttribute("AF_PHONE_DOCK")
			if type(a) == "string" and a ~= "" then
				v = a
			end
		end
	end)
	return v
end

--- Desktop: a stacked card (PLAY SOLO, then the public matches). Phones: one row
--- [PLAY SOLO | ? | the public matches], so most of the globe stays visible. The solo map and
--- difficulty live in the PLAY SOLO menu (_build_solo_menu).
function TitleScreen._reflow_dock(self, compact: boolean)
	local variant = if compact then self:_phone_dock() else ""
	local want = if compact then "c:" .. variant else "d"
	if want == self._dock_compact then
		return
	end
	self._dock_compact = want
	for _, n in ipairs(self._dock_nodes) do
		if n:get_parent() ~= nil then
			n:get_parent():remove_child(n)
		end
	end
	for _, ch in ipairs(self._dock_v:get_children()) do
		self._dock_v:remove_child(ch)
		ch:queue_free()
	end
	local v = self._dock_v
	self._dock_variant = variant
	if compact and variant ~= "stack" then
		v:set_separation(6)
		self._mp.size_flags_horizontal = W.EXPAND_FILL
		self._mp2.size_flags_horizontal = W.EXPAND_FILL
		self._mp3.size_flags_horizontal = W.EXPAND_FILL
		self._solo.size_flags_vertical = W.FILL
		if variant == "row" then
			-- [PLAY SOLO | match | match | match]
			local line = UITheme.hbox(8)
			self._solo.size_flags_horizontal = W.FILL
			line:add_child(self._solo)
			line:add_child(self._mp)
			line:add_child(self._mp2)
			line:add_child(self._mp3)
			v:add_child(line)
		else
			-- two rows: [PLAY SOLO] and [match | match | match]
			local top = UITheme.hbox(8)
			self._solo.size_flags_horizontal = W.EXPAND_FILL
			top:add_child(self._solo)
			local bottom = UITheme.hbox(8)
			bottom:add_child(self._mp)
			bottom:add_child(self._mp2)
			bottom:add_child(self._mp3)
			if variant == "grid2" then
				v:add_child(bottom)
				v:add_child(top)
			else
				v:add_child(top)
				v:add_child(bottom)
			end
		end
	elseif compact then
		-- [PLAY SOLO | ? | the public matches, stacked (the widest)]
		v:set_separation(6)
		local line = UITheme.hbox(8)
		line:add_child(self._solo)
		line:add_child(self._help)
		self._solo.size_flags_horizontal = W.FILL
		local col = self._mp_col
		col.size_flags_horizontal = W.EXPAND_FILL
		col:add_child(self._mp)
		col:add_child(self._mp2)
		col:add_child(self._mp3)
		self._mp.size_flags_horizontal = W.EXPAND_FILL
		self._mp2.size_flags_horizontal = W.EXPAND_FILL
		self._mp3.size_flags_horizontal = W.EXPAND_FILL
		line:add_child(col)
		for _, b in { self._solo, self._help } do
			b.size_flags_vertical = W.SHRINK_CENTER
		end
		v:add_child(line)
	else
		v:set_separation(12)
		-- [PLAY SOLO | ?], then the public matches (2026-10-19: the "?" button moved from beside the
		-- public match to beside PLAY SOLO)
		self._solo.size_flags_horizontal = W.EXPAND_FILL
		for _, b in { self._solo, self._help } do
			b.size_flags_vertical = W.FILL
		end
		for _, c2 in ipairs({ self._greet, self._mp_row, self._dock_div }) do
			v:add_child(c2)
		end
		self._mp_row:add_child(self._solo)
		self._mp_row:add_child(self._help)
		v:add_child(self._mp)
		v:add_child(self._mp2)
		v:add_child(self._mp3)
	end
end

--- The PLAY SOLO menu: map, difficulty and START (it takes the dock's place while open).
function TitleScreen._build_solo_menu(self)
	local T = UITheme
	local p = GlassPanel.new(20.0, 18.0, 18, true, 28)
	self._solo_panel = p
	self._solo_open = false
	self:add_child(p)
	local v = T.vbox(12)
	self._solo_v = v
	p:add_child(v)
	local head = T.hbox(10)
	local ic = T.icon_rect("play", 18.0, T.AMBER)
	ic.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(ic)
	local title = T.label("PLAY SOLO", 17, 800, T.TEXT, 2)
	title.size_flags_horizontal = W.EXPAND_FILL
	title.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(title)
	local close = T.button("", "GhostButton", "close", 44.0)
	close.expand_icon = true
	close.icon_alignment = W.ALIGN_CENTER
	close:add_theme_constant_override("icon_max_width", 16)
	close:set_min_size(Vector2.new(44, 44))
	close.pressed:Connect(function()
		self:close_solo_menu()
	end)
	head:add_child(close)
	v:add_child(head)
	self._map_btn.size_flags_horizontal = W.FILL
	v:add_child(self._map_btn)
	self._diff_row.size_flags_horizontal = W.FILL
	v:add_child(self._diff_row)
	v:add_child(self._diff_desc)
	local start = T.button("START", "PrimaryButton", "play", 58.0)
	start:add_theme_constant_override("icon_max_width", 18)
	start:set_font_size(19)
	start.pressed:Connect(function()
		self.play_solo:Fire(self.difficulty)
	end)
	self._start = start
	v:add_child(start)
	p:set_visible(false)
end

function TitleScreen.open_solo_menu(self)
	if self._solo_open then
		return
	end
	self._solo_open = true
	self._dock:set_visible(false)
	self._solo_panel:set_visible(true)
	UICtx.pop_in(self._solo_panel, 0.0, 0.96, 0.25)
	self.ctx:sfx("open", -6.0)
end

--- Back to the dock (`quiet`: no sound, e.g. when the title hides).
function TitleScreen.close_solo_menu(self, quiet: boolean?)
	if not self._solo_open then
		return
	end
	self._solo_open = false
	self._solo_panel:set_visible(false)
	self._dock:set_visible(not self.ctx:mp_waiting())
	if not quiet then
		self.ctx:sfx("close", -6.0)
	end
end

function TitleScreen._refresh_diff(self)
	local txt = TitleScreen.DIFF_BLURB[self.difficulty]
	local grace = self.ctx:rules_call("human_grace_ticks", { self.difficulty })
	if type(grace) == "number" then
		local secs = grace / 10.0
		if secs > 0.0 then
			txt ..= "  Nations leave you alone for " .. UITheme.fmt_time(secs) .. "."
		end
	end
	self._diff_desc:set_text(txt)
end

function TitleScreen._size_word(self, px: number)
	self._word:set_px(px)
	self._word.spacing = math.floor(px * 0.12)
	self._word_target_spacing = self._word.spacing
	self._word.shadow.outline = math.floor(px * 0.1)
	self._word:update_minimum_size()
	self._word:_redraw()
end

function TitleScreen.on_show(self)
	self:_refresh_greeting()
	if self._hide_tween ~= nil then
		self._hide_tween:kill()
		self._hide_tween = nil
	end
	self:_refresh_queue_mode()
	self:_refresh_mp()
	self:set_modulate_a(1.0)
	self:_refresh_diff()
	-- Entrance, timed against the attract sim's ~4 s time-lapse bloom: the shades lift as the world
	-- fills in, the wordmark lands mid-bloom, the menu rises, and a shine crosses the logo as the
	-- bloom settles.
	local word = self._word
	local target_sp = self._word_target_spacing or word.spacing
	word.spacing = target_sp + 30
	word:update_minimum_size()
	word:set_modulate_a(0.0)
	word:set_scale(1.18)
	local t = self:create_tween():set_parallel(true)
	self._fade:set_modulate_a(1.0)
	t:tween_property(self._fade, "modulate:a", 0.0, 1.8):set_trans(W.TRANS_SINE):set_ease(W.EASE_OUT)
	self._emblem:set_modulate_a(0.0)
	t:tween_property(self._emblem, "modulate:a", 1.0, 0.7):set_delay(0.5)
	t:tween_property(word, "modulate:a", 1.0, 0.8):set_delay(1.0):set_trans(W.TRANS_CUBIC):set_ease(W.EASE_OUT)
	t:tween_property(word, "scale", 1.0, 1.2):set_delay(1.0):set_trans(W.TRANS_EXPO):set_ease(W.EASE_OUT)
	t:tween_method(function(v: number)
		word.spacing = v
		word:update_minimum_size()
		word:_redraw()
	end, target_sp + 30, target_sp, 1.5)
		:set_delay(1.0)
		:set_trans(W.TRANS_EXPO)
		:set_ease(W.EASE_OUT)
	self._glow:set_modulate_a(0.0)
	t:tween_property(self._glow, "modulate:a", 1.0, 1.6):set_delay(1.4)
	self._tag_row:set_modulate_a(0.0)
	t:tween_property(self._tag_row, "modulate:a", 1.0, 0.7):set_delay(2.1)
	W.slide_in(self._dock, Vector2.new(0, 40), 1.7, 0.7)
	W.slide_in(self._queue, Vector2.new(0, 36), 0.3, 0.5)
	self._credits:set_modulate_a(0.0)
	t:tween_property(self._credits, "modulate:a", 1.0, 0.8):set_delay(2.6)
	self._sweep_t = 0.0
end

--- Play Solo was pressed: the new world is being built in the background.
function TitleScreen.set_building(self, on: boolean)
	self._solo:set_disabled(on)
	self._start:set_disabled(on)
	self._start:set_text(if on then "DEPLOYING…" else "START")
	for _, ch in ipairs(self._chips) do
		ch:set_disabled(on)
	end
end

function TitleScreen.hide_animated(self)
	if not self.visible or (self._hide_tween ~= nil and self._hide_tween:is_running()) then
		return
	end
	self._hide_tween = self:create_tween()
	self._hide_tween:tween_property(self, "modulate:a", 0.0, 0.3):set_trans(W.TRANS_CUBIC):set_ease(W.EASE_IN)
	self._hide_tween:tween_callback(function()
		self:set_visible(false)
		self:set_modulate_a(1.0)
		-- next time the title shows, it opens on the dock again
		self:close_solo_menu(true)
	end)
end

function TitleScreen.set_lobby(self, info: any)
	self._lobby = info or {}
	self._lobby_msec = UICtx.msec()
	self:_refresh_mp()
end

function TitleScreen._refresh_queue_mode(self)
	local waiting = self.ctx:mp_waiting()
	if waiting and not self._was_waiting then
		self.ctx:sfx("queue_start") -- (Airship BedWars' queue sound: the waiting room opens)
	end
	self._was_waiting = waiting
	if waiting then
		self:close_solo_menu(true)
	end
	self._queue:set_visible(waiting)
	self._dock:set_visible(not waiting and not self._solo_open)
end

function TitleScreen._countdown(self): number
	local cd = tonumber(self._lobby.countdown_s) or 0.0
	return math.max(0.0, cd - (UICtx.msec() - self._lobby_msec) / 1000.0)
end

--- Public-match cards from the lobby list (hub servers).
function TitleScreen._refresh_lobby_cards(self)
	local ctx = self.ctx
	local elapsed = (UICtx.msec() - self._lobbies_msec) / 1000.0
	-- the open lobbies with room (running matches aren't shown: the title screen's spectating went,
	-- 2026-10-19)
	local open = {}
	for _, lb in self._lobbies or {} do
		if lb.live then
			continue
		elseif
			((tonumber(lb.max) or 0) <= 0 or (tonumber(lb.players) or 0) < (tonumber(lb.max) or 0))
			and lb.joinable ~= false
			and math.ceil((tonumber(lb.starts_in) or 0) - elapsed) > TitleScreen.JOIN_CLOSE_S
		then
			-- (a lobby that filled up, or whose joins closed while the list counted down here, is
			-- hidden: the next one is the one to join)
			table.insert(open, lb)
		end
	end
	-- Quick Play: a card per kind of public match on offer (the free-for-all, World's,
	-- the team game), showing the soonest of the lobbies its JOIN may seat in; JOIN asks the hub for a
	-- seat in that kind, and with every match of it full the player waits in line (CANCEL).
	local soonest: { [string]: any } = {}
	local has_team = false
	for _, lb in open do
		local k = if lb.mode == "team" or lb.mode == "world" then lb.mode else "ffa"
		soonest[k] = soonest[k] or lb
		has_team = has_team or k == "team"
	end
	-- PUBLIC MATCH takes World's seats too (the server's LobbyRules.takes_from; 2026-10-19: the World
	-- and PUBLIC MATCH buttons can still put players into the same match):
	-- its next match is World's when that starts sooner (a tie: the free-for-all, as the server picks)
	local cards_of: { [string]: any } = table.clone(soonest)
	local w, f = soonest.world, soonest.ffa
	if w ~= nil and (f == nil or (tonumber(w.starts_in) or 0) < (tonumber(f.starts_in) or 0)) then
		cards_of.ffa = w
	end
	local kinds = self._kinds or (if has_team then { "ffa", "team" } else { "ffa" })
	-- phones with three kinds side by side: each card is only its title and status line (the whole
	-- card is the button), or the titles and lines were cut to "GIANT W", "World ·…" (2026-10-19)
	self._tight = ctx.compact and self._dock_variant ~= "stack" and #kinds >= 3
	for i, card in self._cards do
		local kind = kinds[i]
		card.mode = kind
		if i >= 2 then
			card.btn:set_visible(kind ~= nil)
		end
		if kind == nil then
			card.lobby = nil
			continue
		end
		card.lobby = cards_of[kind]
		self:_refresh_kind_card(card, kind, cards_of[kind], elapsed)
	end
end

--- One Quick Play card: the kind's soonest lobby with room (`l`, nil: none listed — JOIN still puts
--- the player in line), or what the player's ask is doing.
function TitleScreen._refresh_kind_card(self, card: { [string]: any }, kind: string, l: any?, elapsed: number)
	local ctx = self.ctx
	local pub = self._public
	local mine = pub.state ~= "idle" and pub.mode == kind
	local busy_other = pub.state ~= "idle" and not mine
	local follower = self._in_party and not self._party_leader
	-- the map: the one we are going to once seated, else the soonest with room (none while in line:
	-- every match of the kind is full)
	local going = mine and pub.state == "going" and type(pub.info) == "table"
	local map = if going
		then pub.info.map
		elseif kind == "world" then TitleScreen.WORLD_MAP
		elseif mine and pub.state == "line" then nil
		else (if l then l.map else nil)
	local map_name = if going
		then pub.info.map_name
		elseif kind == "world" then "Shinobi World"
		else (if l then (l.map_name or l.map) else nil)
	-- a free-for-all is any map: its card isn't titled with the next one, which a seat may not be in
	-- (a player, 2026-10-19, kept joining maps they didn't want to play); the status line names it
	local next_map = nil
	if kind == "ffa" and not going then
		next_map = map_name
		map, map_name = nil, nil
	end
	local tight = self._tight == true
	if tight then
		card.icon:set_visible(false)
		card.thumb_node:set_visible(false)
		card.title:set_text(
			if going then string.upper(tostring(map_name or map))
				elseif kind == "team" then "TEAM GAME"
				elseif kind == "world" then "SHINOBI WORLD"
				else "PUBLIC MATCH"
		)
	elseif map ~= nil then
		card.icon:set_visible(false)
		card.thumb_node:set_visible(true)
		local e = UIMaps.get(map)
		card.thumb.Image = if e and e.thumb then e.thumb else ""
		card.title:set_text(string.upper(tostring(map_name or map)))
	else
		card.icon:set_visible(true)
		card.thumb_node:set_visible(false)
		card.title:set_text(if kind == "team" then "TEAM GAME" elseif kind == "world" then "SHINOBI WORLD" else "PUBLIC MATCH")
	end
	-- a team game: its teams first ("4 Teams", "Duos", "Humans Vs Nations")
	local teams = if l ~= nil and l.mode == "team" and l.teams ~= nil
		then (
			if type(l.teams) == "number"
				then string.format("%d Teams", l.teams)
				elseif l.teams == "Humans Vs Nations" and ctx.compact then "H vs N"
				else tostring(l.teams)
		)
		else nil
	local text
	if mine and pub.state == "line" then
		local w = UITheme.fmt_time(math.max(0, math.floor((UICtx.msec() - self._public_since) / 1000)))
		text = if ctx.compact then ("In line  ·  " .. w) else ("Waiting for a free seat  ·  " .. w)
	elseif mine then
		text = if pub.state == "going" then "Joining…" else "Finding a seat…"
	elseif l ~= nil then
		local left = math.max(0, math.ceil((tonumber(l.starts_in) or 0) - elapsed))
		local players = string.format("%d / %d players", tonumber(l.players) or 0, tonumber(l.max) or 0)
		if teams ~= nil then
			text = if ctx.compact and self._dock_variant ~= "stack"
				then string.format("%s · %d/%d · %s", teams, tonumber(l.players) or 0, tonumber(l.max) or 0, UITheme.fmt_time(left))
				else string.format("%s  ·  %s  ·  %s", teams, players, UITheme.fmt_time(left))
		else
			text = if ctx.compact and self._dock_variant ~= "stack"
				then string.format("%d/%d  ·  %s", tonumber(l.players) or 0, tonumber(l.max) or 0, UITheme.fmt_time(left))
				else string.format("%s  ·  starts in %s", players, UITheme.fmt_time(left))
			if next_map ~= nil then
				text = (if ctx.compact then "" else "Next: ") .. tostring(next_map) .. "  ·  " .. text
			end
		end
	else
		text = if ctx.compact then "Next match soon" else "Next match opening soon"
	end
	if tight and mine and pub.state == "line" then
		-- (no CANCEL pill here: a press on the card leaves the line, and the line says so)
		text = "In line  ·  " .. UITheme.fmt_time(math.max(0, math.floor((UICtx.msec() - self._public_since) / 1000))) .. "  ·  tap to cancel"
	end
	card.status:set_text(text)
	UITheme.set_swatch_color(card.dot, if l ~= nil or mine then UITheme.GREEN else UITheme.AMBER)
	card.pill:set_visible(not tight)
	card.pill_l:set_text(
		if follower
			then "LEADER"
			elseif mine and pub.state == "line" then "CANCEL"
			elseif mine then "…"
			elseif teams ~= nil and not ctx.compact then "JOIN TEAMS"
			else "JOIN"
	)
	local ready = not follower and not busy_other and (pub.state == "idle" or (mine and pub.state == "line"))
	card.btn:set_disabled(not ready or self._joining ~= nil)
end

function TitleScreen._refresh_mp(self)
	local ctx = self.ctx
	if self._lobbies ~= nil and not ctx:mp_waiting() then
		self:_refresh_lobby_cards()
		return
	end
	-- no lobby list (yet): the first card shows the server status
	self._mp2:set_visible(false)
	self._mp3:set_visible(false)
	self._cards[1].thumb_node:set_visible(false)
	self._cards[1].icon:set_visible(true)
	self._cards[1].lobby = nil
	self._cards[1].mode = nil
	local mpa = ctx:session_call("multiplayer_available")
	local st = ctx:session_call("multiplayer_status")
	local status = if type(st) == "string" then st else (if mpa == true then "connected" else "offline")
	local avail = status == "connected"
	local stage = tostring(self._lobby.stage or "idle")
	local players = self._lobby.players or {}
	local n = #players
	local dot = UITheme.TEXT_3
	local text = ""
	local join = "JOIN"
	local clickable = avail
	if status == "connecting" then
		dot = UITheme.AMBER
		text = if ctx.compact then "Connecting…" else "Connecting to server…"
		join = ""
		clickable = false
	elseif not avail then
		text = if ctx.compact then "Offline" else "Offline  ·  play solo for now"
		join = "RETRY"
		clickable = true
	else
		if stage == "lobby" then
			dot = UITheme.AMBER
			local cd = UITheme.fmt_time(math.ceil(self:_countdown()))
			text = if ctx.compact then ("Next in " .. cd) else string.format("Next match in %s  ·  %d queued", cd, n)
			join = "QUEUE"
		elseif stage == "spawn" or stage == "playing" then
			dot = UITheme.GREEN
			local el = (tonumber(self._lobby.elapsed_s) or 0.0) + (UICtx.msec() - self._lobby_msec) / 1000.0
			text = if ctx.compact
				then string.format("%d online  ·  %s", n, UITheme.fmt_time(el))
				else string.format(
					"%d commander%s  ·  in progress %s",
					n,
					if n == 1 then "" else "s",
					UITheme.fmt_time(el)
				)
		elseif stage == "over" then
			dot = UITheme.AMBER
			text = "Match ending  ·  next one soon"
			join = "QUEUE"
		else
			dot = UITheme.GREEN
			text = "Server online  ·  start a new match"
			join = "START"
		end
	end
	self._mp_join:set_visible(join ~= "")
	self._mp_join_l:set_text(join)
	local jc = if avail then UITheme.CYAN else UITheme.TEXT_2
	self._mp_join_l:set_color(jc)
	if self._mp_join_c ~= jc then
		self._mp_join_c = jc
		self._mp_join:add_theme_stylebox_override(
			"panel",
			UITheme.flat(UITheme.c(jc, 0.14), 999, UITheme.c(jc, 0.5), 1, 10.0, 3.0)
		)
	end
	self._mp_status:set_text(text)
	UITheme.set_swatch_color(self._mp_dot, dot)
	self._mp:set_disabled(not clickable)
	self._mp_title:set_color(if avail then UITheme.TEXT else UITheme.TEXT_2)
	-- Queue card
	if ctx:mp_waiting() and self._lobby.kind == "match" then
		-- a public lobby's own server: the waiting room until the match starts
		local e = UIMaps.get(self._lobby.map_id)
		-- a team game says so: "TEAM GAME · 4 TEAMS · FOUR ISLANDS"
		local tm = self._lobby.teams
		local kind = if tm == nil
			then "PUBLIC MATCH"
			elseif type(tm) == "number" then string.format("TEAM GAME  ·  %d TEAMS", tm)
			else "TEAM GAME  ·  " .. string.upper(tostring(tm))
		self._q_title:set_text(kind .. "  ·  " .. string.upper(if e then e.name else "Shinobi World"))
		local maxp = tonumber(self._lobby.max) or 0
		local votes = tonumber(self._lobby.votes) or 0
		local need = math.max(tonumber(self._lobby.votes_needed) or 1, 1)
		local started = self._lobby.vote_started == true
		if stage == "lobby" then
			self._q_status:set_text(
				(if started then "Voted to start  ·  starting in " else "Match starts in ")
					.. UITheme.fmt_time(math.ceil(self:_countdown()))
			)
		elseif stage == "spawn" or stage == "playing" then
			self._q_status:set_text("Joining the match…")
		else
			self._q_status:set_text("Getting the match ready…")
		end
		local names = {}
		for _, p in ipairs(players) do
			table.insert(names, tostring(p))
		end
		local head = if maxp > 0 then string.format("%d / %d players", n, maxp) else string.format("%d players", n)
		self._q_players:set_text(if n > 0 then (head .. ":  " .. table.concat(names, ", ")) else head)
		self._q_leave:set_text("Leave match")
		-- vote to start: two thirds of the players here start the match in 10 s (MatchServer.VOTE_SHARE)
		local can_vote = stage == "lobby" and self._lobby.spectating ~= true
		self._q_vote:set_visible(can_vote)
		if can_vote then
			local tally = string.format("%d / %d", math.min(votes, need), need)
			local min_players = tonumber(self._lobby.vote_min_players) or 2
			local lonely = (tonumber(self._lobby.vote_players) or n) < min_players
			-- alone: a lone vote may start the match after a short wait (MatchServer.VOTE_SOLO_AFTER_S)
			local solo_in = tonumber(self._lobby.vote_solo_in)
			if solo_in ~= nil then
				solo_in = math.max(0, math.ceil(solo_in - (UICtx.msec() - self._lobby_msec) / 1000.0))
			end
			self._q_vote:set_text(
				if started
					then "Starting…"
					elseif lonely and solo_in ~= nil then "Vote to start in " .. UITheme.fmt_time(solo_in)
					elseif lonely then string.format("Vote to start needs %d players", min_players)
					elseif self._lobby.voted == true then "Voted  ·  " .. tally .. "  (tap to undo)"
					else "Vote to start  ·  " .. tally
			)
			self._q_vote:set_disabled(started or (lonely and self._lobby.voted ~= true))
		end
	elseif ctx:mp_waiting() then
		self._q_vote:set_visible(false)
		self._q_title:set_text("JOINING MULTIPLAYER")
		self._q_leave:set_text("Leave queue")
		if stage == "lobby" then
			self._q_status:set_text("Match starts in " .. UITheme.fmt_time(math.ceil(self:_countdown())))
		elseif stage == "spawn" or stage == "playing" then
			self._q_status:set_text("Joining the match in progress…")
		elseif stage == "over" then
			self._q_status:set_text("Previous match wrapping up…")
		else
			self._q_status:set_text("Contacting the server…")
		end
		local names = {}
		for _, p in ipairs(players) do
			table.insert(names, tostring(p))
		end
		self._q_players:set_text(
			if n > 0 then ("Commanders: " .. table.concat(names, ", ")) else "You are the first commander here."
		)
	end
end

function TitleScreen._process(self, delta: number)
	if not self.visible then
		return
	end
	if self._sweep_t >= 0.0 then
		self._sweep_t += delta
		local w = self._word.size.X
		local x = -240.0 + (w + 480.0) * math.clamp((self._sweep_t - 3.6) / 1.2, 0.0, 1.0)
		self._word.sweep = x
		self._word:_redraw()
		if self._sweep_t > 4.9 then
			self._sweep_t = -1.0
			self._word.sweep = -10000.0
			self._word:_redraw()
		end
	end
	self._accum += delta
	self._dot_t += delta
	if self._accum >= 0.25 then
		self._accum = 0.0
		self:_refresh_queue_mode()
		self:_refresh_mp()
		self:_refresh_greeting()
		-- the party: on the title itself, not over the waiting room
		local party_on = self._party.state ~= nil and not self.ctx:mp_waiting()
		if self._party.visible ~= party_on then
			self._party:set_visible(party_on)
		end
	end
	self._mp_dot:set_modulate_a(0.55 + 0.45 * (0.5 + 0.5 * math.sin(self._dot_t * 4.0)))
	self:_countdown_ticks()
end

TitleScreen.TICK_FROM_S = 10

--- Public-match waiting room: BedWars' countdown — its tick each second over the last TICK_FROM_S
--- before the match starts, its numbered ticks over the last five, its start sound at zero.
function TitleScreen._countdown_ticks(self)
	local ctx = self.ctx
	if not ctx:mp_waiting() or tostring(self._lobby.stage) ~= "lobby" then
		self._tick_sec = -1
		return
	end
	local sec = math.ceil(self:_countdown())
	local prev = self._tick_sec or -1
	if sec == prev then
		return
	end
	self._tick_sec = sec
	-- (the first reading only arms it; a countdown that jumps back up doesn't tick)
	if prev < 0 or sec >= prev or sec > TitleScreen.TICK_FROM_S then
		return
	end
	if sec <= 0 then
		ctx:sfx("countdown_gamestart", -2.0, 0.0)
	elseif sec <= 5 then
		ctx:sfx("countdown_tick_" .. sec, -2.0, 0.0)
	else
		ctx:sfx("tick", -6.0, 0.0)
	end
end

return TitleScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="224">
            <Properties>
              <string name="Name">Tooltip</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/tooltip.gd (UITooltip)
-- Small glass info card. Three placements: following the cursor (tile hover), anchored above a
-- control (button hints) or pinned in a corner (tap-to-inspect on touch screens).
--
-- Spec table: {title, title_color, swatch (Color3), badge, badge_color, sub, rows: {{k, v, color}},
-- body, hint, hint_color, hint_icon, footer}

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local Signal = UITheme.core("Signal")

local Tooltip = W.class(W.Control)

Tooltip.Place = { FOLLOW = 0, ANCHOR = 1, PINNED = 2 }
local Place = Tooltip.Place
--- Tap-to-inspect cards close on their own after this many seconds.
Tooltip.PIN_SECONDS = 6.0

--- Stable key of a spec (GDScript var_to_str(spec)).
local function spec_key(spec: any, p: number): string
	local parts = {}
	local keys = {}
	for k in pairs(spec) do
		table.insert(keys, k)
	end
	table.sort(keys)
	for _, k in ipairs(keys) do
		local v = spec[k]
		if k == "rows" then
			for _, r in ipairs(v) do
				table.insert(parts, tostring(r[1]) .. "=" .. tostring(r[2]) .. "/" .. tostring(r[3]))
			end
		else
			table.insert(parts, k .. "=" .. tostring(v))
		end
	end
	return table.concat(parts, "|") .. "#" .. p
end

function Tooltip.new(c: any)
	local self = setmetatable({}, Tooltip.__mt)
	W.Control._init(self)
	self.ctx = c
	self.closed = Signal.new()
	self.place = Place.FOLLOW
	self._anchor = nil
	self._key = ""
	self._shown = false
	self._tween = nil
	self._target = Vector2.zero
	self._close = nil
	self._pin_rect = Rect.new(0, 0, 0, 0)
	self._pin_age = 0.0
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_TOP_LEFT)
	self._panel = GlassPanel.new(12.0, 10.0, UITheme.R_MD, true, 14)
	self._panel:set_mouse_filter(W.MOUSE_IGNORE)
	self:add_child(self._panel)
	self._box = UITheme.vbox(6)
	self._panel:add_child(self._box)
	self:set_modulate_a(0.0)
	self:set_visible(false)
	return self
end

function Tooltip.is_shown(self): boolean
	return self._shown
end

function Tooltip.anchor_is(self, c: any): boolean
	return self._anchor == c
end

function Tooltip.show_follow(self, spec: any)
	self:_show(spec, Place.FOLLOW, nil)
end

function Tooltip.show_anchor(self, spec: any, anchor: any)
	self:_show(spec, Place.ANCHOR, anchor)
end

function Tooltip.show_pinned(self, spec: any, rect: Rect)
	self._pin_rect = rect
	self._pin_age = 0.0
	self:_show(spec, Place.PINNED, nil)
end

function Tooltip.hide_tip(self)
	if not self._shown then
		return
	end
	self._shown = false
	self._key = ""
	if self._tween then
		self._tween:kill()
	end
	self._tween = self:create_tween()
	self._tween:tween_property(self, "modulate:a", 0.0, 0.1)
	self._tween:tween_callback(function()
		if not self._shown then
			self:set_visible(false)
			self:set_process(false)
		end
	end)
end

--- The card's current rect (logical px) — UIInteract.show_inspect keeps it off the tapped spot.
function Tooltip.target_rect(self): Rect
	local sz = self._panel:get_combined_minimum_size()
	return UICtx.rect_ps(self._target, sz)
end

function Tooltip._show(self, spec: any, p: number, anchor: any)
	if self:has_meta("stats") then
		self:remove_meta("stats") -- UIRoot tags its strip-details card after showing it
	end
	local key = spec_key(spec, p)
	local was = self._shown
	self.place = p
	self._anchor = anchor
	self._panel:set_mouse_filter(if p == Place.PINNED then W.MOUSE_STOP else W.MOUSE_IGNORE)
	if key ~= self._key then
		self._key = key
		self:_build(spec)
	end
	self._shown = true
	self:set_visible(true)
	self:set_process(true)
	self._panel:reset_size()
	self._target = self:_compute_target()
	if not was then
		self:_set_pos(self._target)
		if self._tween then
			self._tween:kill()
		end
		self._tween = self:create_tween()
		self._tween:tween_property(self, "modulate:a", 1.0, 0.12)
	elseif self.modulate_a < 1.0 and (self._tween == nil or not self._tween:is_running()) then
		self:set_modulate_a(1.0)
	end
end

function Tooltip._set_pos(self, p: Vector2)
	UICtx.move_node(self, p)
end

function Tooltip._build(self, spec: any)
	for _, ch in ipairs(self._box:get_children()) do
		ch:queue_free()
	end
	local ctx = self.ctx
	local compact = ctx.compact
	local head = UITheme.hbox(8)
	if spec.swatch ~= nil then
		head:add_child(UITheme.swatch(spec.swatch, 11.0, 3))
	end
	local tc = spec.title_color or UITheme.TEXT
	local title = UITheme.label(tostring(spec.title or ""), if compact then 14 else 15, 700, tc)
	title.size_flags_horizontal = W.EXPAND_FILL
	head:add_child(title)
	if spec.badge ~= nil and tostring(spec.badge) ~= "" then
		head:add_child(self:_badge(tostring(spec.badge), spec.badge_color or UITheme.TEXT_2))
	end
	self._close = nil
	if self.place == Place.PINNED then
		local b = UITheme.button("", "GhostButton", "close", 44.0)
		b.expand_icon = true
		b:add_theme_constant_override("icon_max_width", 16)
		b:set_min_size(Vector2.new(44, 44))
		b.icon_alignment = W.ALIGN_CENTER
		b:add_theme_color_override("icon_normal_color", UITheme.TEXT)
		b:add_theme_stylebox_override("normal", UITheme.flat(UITheme.FILL, 10, UITheme.LINE, 1, 12.0, 12.0))
		b.pressed:Connect(function()
			self:hide_tip()
			self.closed:Fire()
		end)
		self._close = b
		head:add_child(b)
	end
	self._box:add_child(head)
	if spec.sub ~= nil and tostring(spec.sub) ~= "" then
		self._box:add_child(UITheme.label(tostring(spec.sub), 12, 500, UITheme.TEXT_2))
	end
	local rows = spec.rows or {}
	if #rows > 0 then
		-- GridContainer(2 columns, h_separation 18, v_separation 3): key column shrinks, the value
		-- column expands and right-aligns (tabular digits).
		local grid = UITheme.vbox(3)
		for _, r in ipairs(rows) do
			local line = UITheme.hbox(18)
			line:add_child(UITheme.label(tostring(r[1]), 12, 500, UITheme.TEXT_3))
			local vc = r[3] or UITheme.TEXT
			local v = UITheme.label(tostring(r[2]), 13, 600, vc)
			v:set_tabular(true)
			v:set_alignment(W.ALIGN_RIGHT)
			v.size_flags_horizontal = W.EXPAND_FILL
			line:add_child(v)
			grid:add_child(line)
		end
		self._box:add_child(grid)
	end
	if spec.body ~= nil and tostring(spec.body) ~= "" then
		local body = UITheme.label(tostring(spec.body), 12, 500, UITheme.TEXT_2)
		body:set_autowrap(true)
		body:set_min_size(Vector2.new(220, 0))
		self._box:add_child(body)
	end
	if spec.hint ~= nil and tostring(spec.hint) ~= "" then
		local hc = spec.hint_color or UITheme.AMBER
		local hint = UITheme.hbox(6)
		self._box:add_child(UITheme.hdivider())
		if spec.hint_icon ~= nil then
			local ic = UITheme.icon_rect(tostring(spec.hint_icon), 14.0, hc)
			ic.size_flags_vertical = W.SHRINK_CENTER
			hint:add_child(ic)
		end
		local hl = UITheme.label(tostring(spec.hint), 12, 600, hc)
		hl:set_autowrap(true)
		hl.size_flags_horizontal = W.EXPAND_FILL
		hl:set_min_size(Vector2.new(196, 0))
		hint:add_child(hl)
		self._box:add_child(hint)
	end
	if spec.footer ~= nil and tostring(spec.footer) ~= "" then
		self._box:add_child(UITheme.label(tostring(spec.footer), 11, 500, UITheme.TEXT_3))
	end
	self._panel:set_min_size(Vector2.new(if self.place ~= Place.ANCHOR then 236 else 220, 0))
end

function Tooltip._badge(self, text: string, c: any)
	local p = W.Panel.new()
	p:set_mouse_filter(W.MOUSE_IGNORE)
	p:add_theme_stylebox_override("panel", UITheme.flat(UITheme.c(c, 0.16), 999, UITheme.c(c, 0.5), 1, 7.0, 1.0))
	p:add_child(UITheme.label(string.upper(text), 10, 700, c, 1))
	p.size_flags_vertical = W.SHRINK_CENTER
	return p
end

function Tooltip._compute_target(self): Vector2
	local ctx = self.ctx
	local vp = ctx.vp
	local sz = self._panel:get_combined_minimum_size()
	local ins = ctx.insets
	local margin = 8.0
	local p = Vector2.zero
	if self.place == Place.FOLLOW then
		local m = ctx:mouse_pos()
		p = m + Vector2.new(20, 22)
		local x, y = p.X, p.Y
		if x + sz.X > vp.X - margin - ins.z then
			x = m.X - 16 - sz.X
		end
		if y + sz.Y > vp.Y - margin - ins.w then
			y = m.Y - 14 - sz.Y
		end
		p = Vector2.new(x, y)
	elseif self.place == Place.ANCHOR then
		local a = self._anchor
		if a ~= nil and not a._freed then
			local r = a:get_global_rect()
			local x = r.Min.X + r.Width * 0.5 - sz.X * 0.5
			local y = r.Min.Y - sz.Y - 10.0
			if y < margin then
				y = r.Max.Y + 10.0
			end
			p = Vector2.new(x, y)
		end
	else
		local pr = self._pin_rect
		p = Vector2.new(pr.Min.X + pr.Width - sz.X, pr.Min.Y + pr.Height - sz.Y)
	end
	return Vector2.new(
		math.clamp(p.X, margin + ins.x, math.max(margin, vp.X - sz.X - margin - ins.z)),
		math.clamp(p.Y, margin + ins.y, math.max(margin, vp.Y - sz.Y - margin - ins.w))
	)
end

function Tooltip._process(self, delta: number)
	if not self._shown then
		return
	end
	if self.place == Place.ANCHOR then
		local a = self._anchor
		if a == nil or a._freed or not a:is_visible_in_tree() then
			self:hide_tip()
			return
		end
	end
	if self.place == Place.PINNED then
		self._pin_age += delta
		if self._pin_age > Tooltip.PIN_SECONDS then
			self:hide_tip()
			return
		end
	end
	self._target = self:_compute_target()
	local cur = Vector2.new(self.offset_left, self.offset_top)
	if (cur - self._target).Magnitude < 0.25 then
		if cur ~= self._target then
			self:_set_pos(self._target)
		end
		return
	end
	if self.place == Place.FOLLOW then
		self:_set_pos(cur:Lerp(self._target, 1.0 - math.exp(-delta * 22.0)))
	else
		self:_set_pos(self._target)
	end
end

return Tooltip
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="225">
            <Properties>
              <string name="Name">TopStatus</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/top_status.gd (UITopStatus)
-- Top-centre status pill: match clock (and time limit), phase, and world-control progress
-- towards the 80 % victory share for you and the current leader. Phones get a one-line mini pill
-- (clock · rank · share, a tiny Protected chip) whose tap opens the leaderboard.
--
-- Signals: tapped(). Members: panel, rank_provider (() -> number, set by UIRoot).
-- Methods: apply_layout(), bottom_edge(), on_phase(phase, ticks_left), on_bind(), refresh(),
-- grace_left(); per frame update(dt).

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local FillBar = require("./FillBar")
local Signal = UITheme.core("Signal")

local TopStatus = W.class(W.Control)

local function spacer()
	local sp = W.Control.new()
	sp.size_flags_horizontal = W.EXPAND_FILL
	sp:set_mouse_filter(W.MOUSE_IGNORE)
	return sp
end

local function on_release(node, fn)
	node.gui_input:Connect(function(e)
		if e.kind == "button" and e.button == 1 and not e.pressed then
			fn()
		end
	end)
end

function TopStatus.new(c: any)
	local self = setmetatable({}, TopStatus.__mt)
	W.Control._init(self)
	local T = UITheme
	local Rules = T.core("Rules")
	self.ctx = c
	self.tapped = Signal.new()
	self._phase_end_tick = -1.0
	--- () -> number: my leaderboard rank (phones show it here instead of a separate pill).
	self.rank_provider = nil
	self._accum = 0.0
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self.panel = GlassPanel.new(18.0, 10.0, T.R_LG, true, 18)
	self.panel:set_mouse_filter(W.MOUSE_IGNORE)
	on_release(self.panel, function()
		self.tapped:Fire()
	end)
	self:add_child(self.panel)
	local row = T.hbox(16)
	self._full = row
	self.panel:add_child(row)

	local tb = T.vbox(0)
	tb.size_flags_vertical = W.SHRINK_CENTER
	self._phase = T.caption("Match time")
	tb:add_child(self._phase)
	local tv = T.hbox(4)
	self._clock = T.label("0:00", 20, 700)
	self._clock.rolling = true
	tv:add_child(self._clock)
	self._limit = T.label("", 12, 600, T.TEXT_3)
	self._limit.size_flags_vertical = W.SHRINK_END
	tv:add_child(self._limit)
	tb:add_child(tv)
	self._grace_row = T.hbox(4)
	local gic = T.icon_rect("defense", 11.0, T.GREEN)
	gic.size_flags_vertical = W.SHRINK_CENTER
	self._grace_row:add_child(gic)
	self._grace = T.label("", 11, 700, T.GREEN, 1)
	self._grace.rolling = true
	self._grace_row:add_child(self._grace)
	self._grace_row:set_visible(false)
	tb:add_child(self._grace_row)
	tb:move_child(self._grace_row, 0)
	tb:set_min_size(Vector2.new(88, 0))
	row:add_child(tb)
	row:add_child(T.vdivider(38.0))

	local sb = T.vbox(5)
	sb.size_flags_vertical = W.SHRINK_CENTER
	local head = T.hbox(6)
	self._head = head
	head:add_child(T.icon_rect("mangekyou", 18.0, T.TEXT))
	head:add_child(T.caption("Territory control"))
	head:add_child(spacer())
	self._goal = T.caption("Goal 80%", 11, T.GOLD)
	head:add_child(self._goal)
	sb:add_child(head)
	self._bar = FillBar.new(7.0, T.AMBER)
	self._bar.goal = Rules.WIN_SHARE
	self._bar:set_min_size(Vector2.new(280, 12))
	sb:add_child(self._bar)
	local who = T.hbox(6)
	self._you_sw = T.swatch(T.AMBER, 9.0, 2)
	who:add_child(self._you_sw)
	self._you = T.label("You 0.0%", 12, 600, T.TEXT)
	who:add_child(self._you)
	who:add_child(spacer())
	self._lead_box = T.hbox(6)
	local crown = T.icon_rect("crown", 12.0, T.GOLD)
	crown.size_flags_vertical = W.SHRINK_CENTER
	self._lead_box:add_child(crown)
	self._lead_sw = T.swatch(T.TEXT, 9.0, 2)
	self._lead_box:add_child(self._lead_sw)
	self._lead = T.label("", 12, 600, T.TEXT_2)
	self._lead_box:add_child(self._lead)
	who:add_child(self._lead_box)
	sb:add_child(who)
	row:add_child(sb)
	self:_build_mini()
	return self
end

function TopStatus._build_mini(self)
	local T = UITheme
	self._mini = T.hbox(7)
	self._mini:set_visible(false)
	self._m_grace = W.Panel.new()
	self._m_grace:set_mouse_filter(W.MOUSE_IGNORE)
	self._m_grace.size_flags_vertical = W.SHRINK_CENTER
	self._m_grace:add_theme_stylebox_override("panel", T.flat(T.c(T.GREEN, 0.14), 999, T.c(T.GREEN, 0.45), 1, 6.0, 1.0))
	local gh = T.hbox(3)
	local gi = T.icon_rect("defense", 11.0, T.GREEN)
	gi.size_flags_vertical = W.SHRINK_CENTER
	gh:add_child(gi)
	self._m_grace_l = T.label("", 12, 700, T.GREEN)
	self._m_grace_l.rolling = true
	gh:add_child(self._m_grace_l)
	self._m_grace:add_child(gh)
	self._m_grace:set_visible(false)
	self._mini:add_child(self._m_grace)
	self._m_clock = T.label("0:00", 14, 700)
	self._m_clock.rolling = true
	self._m_clock.size_flags_vertical = W.SHRINK_CENTER
	local eye = T.icon_rect("mangekyou", 16.0, T.TEXT)
	eye.size_flags_vertical = W.SHRINK_CENTER
	self._mini:add_child(eye)
	self._mini:add_child(self._m_clock)
	self._m_sw = T.swatch(T.AMBER, 8.0, 2)
	self._m_sw.size_flags_vertical = W.SHRINK_CENTER
	self._mini:add_child(self._m_sw)
	self._m_you = T.label("", 13, 600)
	self._m_you.size_flags_vertical = W.SHRINK_CENTER
	self._mini:add_child(self._m_you)
	self._m_chev = T.icon_rect("leaderboard", 12.0, T.TEXT_3)
	self._m_chev.size_flags_vertical = W.SHRINK_CENTER
	self._mini:add_child(self._m_chev)
	self.panel:add_child(self._mini)
	self._hit = W.Control.new()
	self._hit.name = "StatusHit"
	self._hit:set_mouse_filter(W.MOUSE_IGNORE)
	on_release(self._hit, function()
		self.tapped:Fire()
	end)
	self:add_child(self._hit)
	self.panel.item_rect_changed:Connect(function()
		self:_fit_hit()
	end)
	self.panel.visibility_changed:Connect(function()
		self:_fit_hit()
	end)
end

--- The mini pill is ~30 px tall; its tap area is a full 44 px.
function TopStatus._fit_hit(self)
	if self._hit == nil then
		return
	end
	local ctx = self.ctx
	local on = ctx.compact and ctx.touch and self.panel.visible
	self._hit:set_mouse_filter(if on then W.MOUSE_STOP else W.MOUSE_IGNORE)
	self._hit:set_visible(on)
	if on then
		local p, s = self.panel.position, self.panel.size
		local pad = math.max(0.0, (44.0 - s.Y) * 0.5)
		self._hit:set_anchors(0, 0, 0, 0)
		self._hit:set_offsets(p.X - 4.0, p.Y - pad, p.X + s.X + 4.0, p.Y + s.Y + pad)
	end
end

function TopStatus.apply_layout(self)
	local ctx = self.ctx
	local T = UITheme
	local p = self.panel
	local top = 12.0 + ctx.insets.y
	-- Phones drop the "WORLD CONTROL · GOAL 80%" header: the bar and its gold goal line say it.
	self._head:set_visible(not ctx.compact)
	self._full:set_visible(not ctx.compact)
	self._mini:set_visible(ctx.compact)
	-- Very narrow phones drop the leaderboard hint icon (the pill still opens the board).
	self._m_chev:set_visible(ctx.vp.X >= 800.0)
	-- On touch the pill swallows taps (and on phones opens the leaderboard).
	p:set_mouse_filter(if ctx.touch then W.MOUSE_STOP else W.MOUSE_IGNORE)
	if ctx.compact then
		-- Phones: tuck into the top-right corner, clear of the top-left bar.
		p.anchor_left = 1.0
		p.anchor_right = 1.0
		p.grow_horizontal = W.GROW_BEGIN
		p.offset_left = -(8.0 + ctx.insets.z)
		p.offset_right = -(8.0 + ctx.insets.z)
		top = 8.0 + ctx.insets.y
		self._bar:set_min_size(Vector2.new(200, 10))
		self._clock:set_font_size(16)
		p:set_padding(12.0, 5.0, 10.0, 5.0)
	else
		p.anchor_left = 0.5
		p.anchor_right = 0.5
		p.grow_horizontal = W.GROW_BOTH
		p.offset_left = 0.0
		p.offset_right = 0.0
		self._bar:set_min_size(Vector2.new(if ctx.vp.X >= 1200.0 then 340 else 260, 12))
		self._clock:set_font_size(20)
		p:set_padding(18.0, 10.0, 18.0, 10.0)
	end
	self:_fix_widths()
	p.anchor_top = 0.0
	p.anchor_bottom = 0.0
	p.grow_vertical = W.GROW_END
	local w = p:get_combined_minimum_size().X
	if ctx.compact then
		-- Right-aligned; drop below the top-left bar row when the phone is too narrow for both.
		if ctx.vp.X - ctx.insets.z - 8.0 - w < ctx.reserved_top_left.Max.X + 8.0 then
			top = ctx.reserved_top_left.Max.Y + 4.0
		end
	else
		local dx, y = ctx:place_top(w, top)
		p.offset_left = dx
		p.offset_right = dx
		top = y
	end
	p.offset_top = top
	p.offset_bottom = top
	p:reset_size()
	self:_fit_hit()
	local _ = T
end

--- Fixed boxes for every changing text (tabular digits) so the pill never resizes or jitters.
function TopStatus._fix_widths(self)
	local ctx = self.ctx
	local T = UITheme
	local small = math.max(11, T.min_font_size)
	local cs = if ctx.compact then 16 else 20
	local ws = math.max(12, T.min_font_size)
	local w_block =
		math.max(T.text_width("SPAWN PHASE", small, 700) + 12.0, T.text_width("PROTECTED 8:88", small, 700) + 20.0)
	T.fix_width(self._phase, w_block, W.ALIGN_LEFT, false)
	T.fix_width(self._grace, w_block - 16.0)
	local w_clock = T.text_width("8:88:88", cs, 700) + 2.0
	T.fix_width(self._clock, w_clock)
	T.fix_width(self._limit, math.max(w_block - w_clock - 4.0, T.text_width("/ 88:88", ws, 600) + 2.0))
	self._phase.parent:set_min_size(Vector2.new(w_block, 0))
	self._grace_row:set_min_size(Vector2.new(w_block, self._phase:get_combined_minimum_size().Y))
	local bar_w = self._bar.custom_minimum_size.X
	local w_you = T.text_width("You lead · 88.88%", ws, 600) + 2.0
	T.fix_width(self._you, w_you, W.ALIGN_LEFT, false)
	local lead_w = math.max(40.0, bar_w - w_you - 12.0 - 9.0 - 12.0 - 18.0)
	T.fix_width(self._lead, lead_w, W.ALIGN_LEFT, false)
	-- The Protected chip and the clock take turns in one slot of fixed width (the pill never resizes).
	local slot = math.max(
		T.text_width("88:88", 14, 700) + 2.0,
		6.0 + 11.0 + 3.0 + T.text_width("8:88", 12, 700) + 2.0 + 6.0 + 2.0
	)
	T.fix_width(self._m_clock, slot, W.ALIGN_LEFT)
	self._m_grace:set_min_width(slot)
	T.fix_width(self._m_you, T.text_width("#888 · 88.88%", 13, 600) + 2.0, W.ALIGN_LEFT)
	T.fix_width(self._m_grace_l, T.text_width("8:88", 12, 700) + 2.0, W.ALIGN_LEFT)
end

function TopStatus.bottom_edge(self): number
	local r = self.panel:get_rect()
	return r.Max.Y
end

--- Call on bind and on every phase change.
function TopStatus.on_phase(self, phase: number, ticks_left: number)
	local s = self.ctx.state
	if s == nil then
		return
	end
	local Defs = UITheme.core("Defs")
	self._phase_end_tick = if ticks_left > 0 and phase ~= Defs.PHASE_OVER then s.tick + ticks_left else -1.0
	-- MATCH OVER: the clock stops at the final time (the Sim keeps ticking for the spectators;
	-- review P2-5, the original kept counting).
	if phase == Defs.PHASE_OVER then
		if self._over_secs == nil then
			self._over_secs = self.ctx:match_seconds()
		end
	else
		self._over_secs = nil
	end
	self:refresh()
end

function TopStatus.on_bind(self)
	self._phase_end_tick = -1.0
	self._over_secs = nil
	local s = self.ctx.state
	if s == nil then
		return
	end
	self:on_phase(s.phase, s.phase_ticks_left)
end

function TopStatus.refresh(self)
	local ctx = self.ctx
	local T = UITheme
	local Defs = T.core("Defs")
	local s = ctx.state
	if s == nil then
		return
	end
	local now = ctx:render_tick()
	local tr = Defs.TICK_RATE
	if s.phase == Defs.PHASE_SPAWN then
		self._phase:set_text("SPAWN PHASE")
		if self._phase_end_tick > 0 then
			self._clock:set_text(T.fmt_time(math.ceil((self._phase_end_tick - now) / tr)))
		else
			self._clock:set_text("--:--")
		end
		self._limit:set_text("")
	elseif s.phase == Defs.PHASE_PLAYING then
		local elapsed = ctx:match_seconds()
		if s.time_limit_ticks > 0 then
			-- time_limit_ticks is the absolute tick at which the match ends.
			local left = math.max(0, (s.time_limit_ticks - now) / tr)
			self._phase:set_text("TIME LEFT")
			self._clock:set_text(T.fmt_time(math.ceil(left)))
			T.set_font_color(self._clock, if left < 120 then T.RED else T.TEXT)
			local total = if ctx.play_start_tick >= 0
				then (s.time_limit_ticks - ctx.play_start_tick) / tr
				else ctx:match_limit_s()
			self._limit:set_text("/ " .. T.fmt_time(math.floor(total + 0.5)))
		else
			self._phase:set_text("MATCH TIME")
			self._clock:set_text(T.fmt_time(elapsed))
			self._limit:set_text("")
		end
	else
		self._phase:set_text("MATCH OVER")
		self._limit:set_text("")
		if self._over_secs == nil then
			self._over_secs = ctx:match_seconds()
		end
		self._clock:set_text(T.fmt_time(self._over_secs))
	end
	-- While protected the one timer is the protection's countdown (the match clock counting up beside
	-- it read badly, 2026-09-28); the match clock comes back when protection ends.
	local grace = self:grace_left()
	if grace > 0 then
		self._clock:set_text(T.fmt_time(math.ceil(grace)))
		T.set_font_color(self._clock, T.GREEN)
		self._limit:set_text("")
	elseif s.phase == Defs.PHASE_PLAYING and s.time_limit_ticks <= 0 then
		T.set_font_color(self._clock, T.TEXT)
	end
	self:_refresh_grace()
	-- (the leader alone, from one pass: not the whole ranking sorted, 2026-10-27)
	local leader = ctx:leader()
	local me = ctx:me()
	local my_share = if me ~= 0 then s:land_share(me) else 0.0
	local mo = ctx:my()
	local mcol = if mo ~= nil then T.owner_ui_color(mo.color) else T.AMBER
	self._you_sw:set_visible(me ~= 0)
	T.set_swatch_color(self._you_sw, mcol)
	self._you:set_text(if me ~= 0 then ("You " .. T.fmt_pct(my_share)) else "Spectating")
	if ctx.compact and me ~= 0 and self.rank_provider ~= nil then
		local rk = tonumber(self.rank_provider()) or 0
		if rk > 0 then
			self._you:set_text(string.format("#%d · %s", rk, T.fmt_pct(my_share)))
		end
	end
	self._bar.fill_color = mcol
	self._bar:set_target(if me ~= 0 then ctx:win_share(me) else 0.0)
	table.clear(self._bar.markers)
	if leader ~= nil then
		local ls = s:land_share(leader.id)
		self._lead_box:set_visible(leader.id ~= me)
		T.set_swatch_color(self._lead_sw, leader.color)
		self._lead:set_text(if ctx.compact then T.fmt_pct(ls) else string.format("%s %s", leader.name, T.fmt_pct(ls)))
		if leader.id ~= me then
			table.insert(self._bar.markers, { v = ctx:win_share(leader.id), color = T.owner_ui_color(leader.color) })
		else
			self._you:set_text((if ctx.compact then "#1 · " else "You lead · ") .. T.fmt_pct(my_share))
		end
	else
		self._lead_box:set_visible(false)
	end
	-- a team game: the team's land together, and the team ahead
	if type(s.is_team_game) == "function" and s:is_team_game() then
		self:_refresh_teams(me)
	end
	self._bar:queue_redraw()
	if ctx.compact then
		self._m_clock:set_text(self._clock.text)
		if #self._m_clock.text > 5 and self._m_clock.custom_minimum_size.X < T.text_width("8:88:88", 14, 700) then
			T.fix_width(self._m_clock, T.text_width("8:88:88", 14, 700) + 2.0, W.ALIGN_LEFT)
			self._m_grace:set_min_width(self._m_clock.custom_minimum_size.X)
		end
		T.set_font_color(self._m_clock, self._clock.color)
		T.set_swatch_color(self._m_sw, mcol)
		self._m_sw:set_visible(me ~= 0)
		local yt = string.gsub(self._you.text, "You lead · ", "#1 · ")
		yt = string.gsub(yt, "You ", "")
		self._m_you:set_text(yt)
		-- While protected, the shield countdown takes the clock's place (the match is young).
		local gl = self:grace_left()
		self._m_grace:set_visible(gl > 0)
		self._m_clock:set_visible(gl <= 0)
		if gl > 0 then
			self._m_grace_l:set_text(T.fmt_time(math.ceil(gl)))
		end
	end
end

--- A team game (Core/Teams): the bar is the player's team's land together (it wins at the same share),
--- the lead box the team ahead.
function TopStatus._refresh_teams(self, me: number)
	local ctx = self.ctx
	local T = UITheme
	local s = ctx.state
	local mine = if me ~= 0 then s:team_of(me) else 0
	local teams = s:team_ranking()
	local share = if mine ~= 0 then ctx:team_share(mine) else 0.0
	local mcol = if mine ~= 0 then T.owner_ui_color(s:team_color(mine)) else T.AMBER
	T.set_swatch_color(self._you_sw, mcol)
	self._bar.fill_color = mcol
	self._bar:set_target(share)
	table.clear(self._bar.markers)
	local rank = 0
	for i, r in teams do
		if r.team == mine then
			rank = i
		end
	end
	local Defs = T.core("Defs")
	if mine ~= 0 and s.phase == Defs.PHASE_SPAWN then
		-- before the land counts: which team you're on ("Your team:" in the spawn phase)
		self._you:set_text(if ctx.compact then ctx:team_label(mine) else "Your team: " .. ctx:team_label(mine))
		self._lead_box:set_visible(false)
		return
	end
	if mine ~= 0 then
		self._you:set_text(
			if ctx.compact
				then string.format("#%d · %s", rank, T.fmt_pct(share))
				elseif rank == 1 then "Your team leads · " .. T.fmt_pct(share)
				else string.format("%s %s", ctx:team_label(mine), T.fmt_pct(share))
		)
	end
	local top = teams[1]
	if top ~= nil and top.team ~= mine then
		local ts = ctx:team_share(top.team)
		local tcol = s:team_color(top.team)
		self._lead_box:set_visible(true)
		T.set_swatch_color(self._lead_sw, tcol)
		self._lead:set_text(if ctx.compact then T.fmt_pct(ts) else string.format("%s %s", ctx:team_label(top.team), T.fmt_pct(ts)))
		table.insert(self._bar.markers, { v = ts, color = T.owner_ui_color(tcol) })
	else
		self._lead_box:set_visible(false)
	end
end

--- Early peace: nations will not declare war on a commander during the grace window
--- (Rules.human_grace_ticks(difficulty), counted from the start of play).
function TopStatus._refresh_grace(self)
	local left = self:grace_left()
	local show = left > 0
	self._grace_row:set_visible(show)
	self._phase:set_visible(not show)
	if show then
		self._grace:set_text("PROTECTED")
	end
end

function TopStatus.grace_left(self): number
	local ctx = self.ctx
	local Defs = UITheme.core("Defs")
	local s = ctx.state
	if s == nil or s.phase ~= Defs.PHASE_PLAYING or not ctx:alive_player() or ctx.play_start_tick < 0 then
		return 0.0
	end
	-- (a public match: Easy nations, and bot players no harsher towards a player than
	-- Rules.SMART_VS_PLAYERS; it read 3:00 while the smart ones came for players at Medium's)
	local diff = tonumber(UITheme.core("Rules").SMART_VS_PLAYERS) or 0
	if ctx:mode() == 1 and ctx.session ~= nil then
		diff = tonumber(ctx.session.difficulty) or 1
	end
	local g = ctx:rules_call("human_grace_ticks", { diff })
	if type(g) ~= "number" then
		return 0.0
	end
	return (ctx.play_start_tick + g - ctx:render_tick()) / Defs.TICK_RATE
end

--- Per frame (GDScript _process).
function TopStatus.update(self, delta: number)
	self._accum += delta
	if self._accum >= 0.25 then
		self._accum = 0.0
		if self:is_visible_in_tree() then
			self:refresh()
		end
	end
end

return TopStatus
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="226">
            <Properties>
              <string name="Name">TouchRouter</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/touch_router.gd (UITouchRouter)
-- Multi-touch for the HUD. In Godot only the first finger drove the (mouse-based) ratio slider, so
-- this node routed any other finger that lands on the slider to it. Roblox GUI objects receive
-- every finger's InputBegan / InputChanged, so a slider that handles Touch itself needs no routing:
-- the router then only watches (and never double-drives it). It routes fingers only to a slider
-- that declares `handles_touch = false` and exposes drag_to_global(logical_pos).
--
-- Nothing is consumed here: WorldView tracks every finger too (a HUD finger can still become part
-- of a pinch); a finger WorldView:touch_owned_by_world(index) claims stops driving the slider.

local UICtx = require("./UICtx")

local TouchRouter = {}
TouchRouter.__index = TouchRouter

function TouchRouter.new(root: any)
	local self = setmetatable({}, TouchRouter)
	self.ui = root
	--- Fingers on the slider: InputObject -> slider.
	self._routed = {}
	self._first = nil
	--- Test counter: slider updates driven by a routed finger.
	self.routed_actions = 0
	self._conns = {}
	return self
end

function TouchRouter.connect(self)
	if not UICtx.IS_ROBLOX then
		return
	end
	local UIS = game:GetService("UserInputService")
	table.insert(
		self._conns,
		UIS.InputBegan:Connect(function(io: InputObject)
			if io.UserInputType == Enum.UserInputType.Touch then
				self:_on_touch(io, true)
			end
		end)
	)
	table.insert(
		self._conns,
		UIS.InputEnded:Connect(function(io: InputObject)
			if io.UserInputType == Enum.UserInputType.Touch then
				self:_on_touch(io, false)
			end
		end)
	)
	table.insert(
		self._conns,
		UIS.InputChanged:Connect(function(io: InputObject)
			if io.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local c = self._routed[io]
			if c == nil or c._freed or self:_world_owns(io) then
				return -- gone, or the finger turned into a pinch
			end
			c:drag_to_global(self:_pos(io))
			self.routed_actions += 1
		end)
	)
end

function TouchRouter.destroy(self)
	for _, c in ipairs(self._conns) do
		c:Disconnect()
	end
	table.clear(self._conns)
end

function TouchRouter._pos(self, io: InputObject): Vector2
	local inset = game:GetService("GuiService"):GetGuiInset()
	return self.ui.ctx:to_logical(Vector2.new(io.Position.X, io.Position.Y) + inset)
end

function TouchRouter._on_touch(self, io: InputObject, pressed: boolean)
	if pressed then
		if self._first == nil then
			self._first = io -- the GUI drives the HUD from this finger directly
			return
		end
		local target = self:_hit(self:_pos(io))
		if target == nil then
			return
		end
		self._routed[io] = target
		target:drag_to_global(self:_pos(io))
		self.routed_actions += 1
		return
	end
	if io == self._first then
		self._first = nil
	end
	self._routed[io] = nil
end

function TouchRouter._world_owns(self, io: InputObject): boolean
	local w = self.ui.ctx.world
	if w == nil or type(w.touch_owned_by_world) ~= "function" then
		return false
	end
	return w:touch_owned_by_world(io) == true
end

--- The ratio slider under `pos` when it needs routing (handles_touch == false), else nil.
function TouchRouter._hit(self, pos: Vector2): any
	local bar = self.ui.bar
	local sl = bar and bar._slider
	if sl == nil or sl._freed or sl.handles_touch ~= false or not sl:is_visible_in_tree() then
		return nil
	end
	if UICtx.rect_has_point(sl:get_global_rect(), pos) then
		return sl
	end
	return nil
end

return TouchRouter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="227">
            <Properties>
              <string name="Name">TrayFit</string>
              <string name="Source"><![CDATA[--!strict
-- Widths in the build row (CommandBar): its slots, and the gold SHOP button that closes it (ShopSlot),
-- a little wider than a slot while there is anything left to get. The row must stay one row wherever
-- it can (2026-10-04: the build menu was too big; only the SHOP button shows, so it all stays on
-- one row), so on a phone the slots narrow first, then the SHOP button narrows to one slot's width,
-- and only then does the tray take a second row.
--
-- Numbers only (no widgets): tests/tray_fit.luau.
local TrayFit = {}

--- A phone tray slot: its usual width, and the narrowest it gets.
TrayFit.SLOT_MAX = 60.0
TrayFit.SLOT_MIN = 54.0
--- Gap between slots: the usual one, and the one of a tight row.
TrayFit.SEP = 8.0
TrayFit.SEP_TIGHT = 5.0
--- What a row holds besides its slots: the divider before the nukes and the tray's padding.
TrayFit.CHROME = 33.0
--- The SHOP button's width while there is anything left to get (2026-10-12: one button, where it
--- held a card for each locked unit; it is wider than a slot so it stands out).
TrayFit.SHOP_W = 72.0

--- The width the SHOP button wants with `n` items left to get (0: none, a slot's width will do).
function TrayFit.shop_width(n: number): number
	return if n > 0 then TrayFit.SHOP_W else 0.0
end

--- The phone tray. `avail`: the width between the safe edges; `slots`: the build slots besides SHOP
--- (the ten everyone has and the unlocked Arsenal kinds); `locked`: the Arsenal items left to get.
--- Returns { slot_w, sep, shop_w, two_rows }.
function TrayFit.fit(avail: number, slots: number, locked: number): { [string]: any }
	local want = TrayFit.shop_width(locked)
	local function need(slot_w: number, sep: number, shop_w: number): number
		return slots * (slot_w + sep) + shop_w + sep + TrayFit.CHROME
	end
	local slot_w, sep = TrayFit.SLOT_MAX, TrayFit.SEP
	local shop_w = math.max(want, slot_w)
	if need(slot_w, sep, shop_w) <= avail then
		return { slot_w = slot_w, sep = sep, shop_w = shop_w, two_rows = false }
	end
	sep = TrayFit.SEP_TIGHT
	-- the slots narrow, a pixel at a time
	while slot_w > TrayFit.SLOT_MIN and need(slot_w, sep, math.max(want, slot_w)) > avail do
		slot_w -= 1
	end
	shop_w = math.max(want, slot_w)
	if need(slot_w, sep, shop_w) > avail then
		-- then the SHOP slot, to no less than a slot
		shop_w = math.max(slot_w, math.floor(avail - need(slot_w, sep, 0.0)))
	end
	if need(slot_w, sep, shop_w) > avail then
		-- builds over nukes: the second row has the room
		return {
			slot_w = TrayFit.SLOT_MAX,
			sep = TrayFit.SEP,
			shop_w = math.max(want, TrayFit.SLOT_MAX),
			two_rows = true,
		}
	end
	return { slot_w = slot_w, sep = sep, shop_w = shop_w, two_rows = false }
end

return TrayFit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="228">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!nonstrict
-- A new player's first match, step by step (Data/Tutorial: the steps and why; 2026-10-04: a new
-- tutorial for new players, made for phones first). One small goal at a time:
--   * a card at the top of the screen: "2 / 6", one short line, a bar for a goal with progress, and
--     Skip. Short enough to read at a glance on a phone; it never covers the map's middle or the
--     command bar;
--   * a tap mark where to tap (two rings closing on a dot, with "Tap here" under it): the map spot or
--     the control the step is about. It hides while the player is busy and comes back after
--     Data/Tutorial.NUDGE_S without an order;
--   * a finished step turns the card green for a moment, with a sound, then the next one comes.
-- The spawn step has no card (the spawn banner is up there): only the mark on a roomy spot, which
-- is taken for the player after AUTO_SPAWN_S. The City step tops the player's gold up to a City's
-- price. A step nobody finishes in STEP_MAX_S is passed over. While it runs the coach's tips are
-- off (UIRoot); they take over afterwards. While it runs the Attack bar starts at its default and
-- stops at Data.RATIO_CAP, and an order leaves Data.TROOP_FLOOR of the army's cap at home (UICtx
-- .ratio_max / .troop_floor): a new player can't empty their nation.
--
--   Tutorial.new(ctx, ui)
--   :begin()                 the tutorial match was asked for
--   :stop(how)               "done" | "skipped" | "left"
--   .active, .finished (Signal: how), .step_done (Signal: funnel step, name), .closed (Signal: the
--   last card is gone)
local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local Signal = UITheme.core("Signal")
local Defs = UICtx.core("Defs")
local Data = UICtx.data("Tutorial")

local Tutorial = W.class(W.Control)

--- The card stays green this long after a step, and the last card this long.
Tutorial.DONE_S = 0.9
Tutorial.END_S = 9.0
--- Spawn spots tried for the roomiest one.
Tutorial.SPAWN_TRIES = 240
--- Free land this far (tiles) from every nation is roomy enough.
Tutorial.SPAWN_ROOM = 35.0
--- The camera shows the suggested spot with tiles this many px across.
Tutorial.SPAWN_PX = 5.0

function Tutorial.new(c: any, ui: any)
	local self = setmetatable({}, Tutorial.__mt)
	W.Control._init(self)
	self.ctx = c
	self.ui = ui
	self.active = false
	self.finished = Signal.new()
	self.step_done = Signal.new()
	--- the last card (the reward) is gone: the screen is the coach's again
	self.closed = Signal.new()
	self._i = 0
	self._t = 0.0
	self._step_t = 0.0
	self._flash = 0.0
	self._ending = 0.0
	self._sent = 0
	self._idle = 0.0
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	-- the tap mark
	self._mark = UICtx.canvas(self.gui, "TutorialMark")
	self._mark.ZIndex = 1
	self._ring_a = UICtx.ring(self._mark, Vector2.zero, 10, 3, UITheme.AMBER, 1)
	self._ring_b = UICtx.ring(self._mark, Vector2.zero, 10, 2, UITheme.AMBER, 1)
	self._dot = UICtx.circle(self._mark, Vector2.zero, 6, UITheme.AMBER, 0)
	self._tap = UICtx.make("TextLabel", {
		BackgroundColor3 = Color3.fromRGB(14, 20, 38),
		BackgroundTransparency = 0.15,
		Text = "Tap here",
		FontFace = Font.fromId(12187365977, Enum.FontWeight.Bold),
		TextSize = 13,
		TextColor3 = Color3.new(1, 1, 1),
		AutomaticSize = Enum.AutomaticSize.XY,
		AnchorPoint = Vector2.new(0.5, 0),
	}, self._mark)
	UICtx.make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, self._tap)
	UICtx.make("UIPadding", {
		PaddingLeft = UDim.new(0, 9),
		PaddingRight = UDim.new(0, 9),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
	}, self._tap)
	self._mark.Visible = false
	-- the card
	local card = GlassPanel.new(12.0, 8.0, UITheme.R_MD, true, 18)
	card:set_accent(UITheme.AMBER)
	card:set_border(UITheme.c(UITheme.AMBER, 0.5))
	self._card = card
	local h = UITheme.hbox(10)
	card:add_child(h)
	self._count = UITheme.label("1 / 6", 12, 800, UITheme.AMBER)
	self._count.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self._count)
	local v = UITheme.vbox(5)
	v.size_flags_horizontal = W.EXPAND_FILL
	v.size_flags_vertical = W.SHRINK_CENTER
	self._text = UITheme.label("", 14, 700, UITheme.TEXT)
	self._text:set_autowrap(true)
	self._text:set_min_size(Vector2.new(220, 0))
	v:add_child(self._text)
	-- (a goal with progress: a thin bar under the line)
	local bar = UICtx.make("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 5),
	})
	UICtx.make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, bar)
	self._fill = UICtx.make("Frame", {
		BackgroundColor3 = UITheme.AMBER,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
	}, bar)
	UICtx.make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, self._fill)
	self._bar = W.wrap(bar)
	self._bar:set_min_size(Vector2.new(0, 5))
	self._bar:set_mouse_filter(W.MOUSE_IGNORE)
	v:add_child(self._bar)
	h:add_child(v)
	self._skip = UITheme.button("Skip", "GhostButton", "", 36.0)
	self._skip:set_font_size(12)
	self._skip:set_min_size(Vector2.new(52, 36))
	self._skip.size_flags_vertical = W.SHRINK_CENTER
	self._skip.pressed:Connect(function()
		if self._ending > 0.0 then
			self:_close()
		else
			self:stop("skipped")
		end
	end)
	h:add_child(self._skip)
	self:add_child(card)
	card:set_visible(false)
	self:set_process(true)
	return self
end

--- The tutorial match was asked for: the steps begin with its spawn phase.
function Tutorial.begin(self)
	self.active = true
	self._i = 1
	self._step_t = 0.0
	self._flash = 0.0
	self._ending = 0.0
	self._idle = 0.0
	self._spot = nil
	self._spot_state = nil
	self._picked = false
	self._base = nil
	self._neighbour = nil
	self._gold_given = false
	self._sent = #self.ctx.sent_log
	self._card:set_visible(false)
	self._started = false
	-- the Attack bar: from its default, never past the cap; the floor under the army comes from the
	-- FLOOR_FROM step, once it arms (Data.floor_armed; _process)
	local ctx = self.ctx
	ctx.ratio_max = 1.0
	ctx:set_ratio(UICtx.DEFAULT_RATIO)
	ctx:set_ratio_max(Data.RATIO_CAP)
	ctx.troop_floor = nil
end

function Tutorial.stop(self, how: string)
	if not self.active then
		return
	end
	self.active = false
	self._mark.Visible = false
	self.ctx:set_ratio_max(1.0)
	self.ctx.troop_floor = nil
	if how == "done" then
		-- the last card: the reward, and where it goes
		self._ending = Tutorial.END_S
		self._count:set_text("★")
		self._text:set_text(
			string.format("Tutorial complete! +%s Stars\nSpend them in the ARSENAL", UICtx.commas(Data.STARS))
		)
		self._bar:set_visible(false)
		self._skip:set_text("OK")
		self:_tint(UITheme.GREEN)
		self._card:set_visible(true)
		self:_place()
		self.ctx:sfx("unlock", -4.0)
	else
		self._card:set_visible(false)
	end
	self.finished:Fire(how)
	if how ~= "done" then
		self.closed:Fire()
	end
end

function Tutorial._close(self)
	self._ending = 0.0
	self._card:set_visible(false)
	self.closed:Fire()
end

function Tutorial._tint(self, col: any)
	self._card:set_accent(col)
	self._card:set_border(UITheme.c(col, 0.5))
	UITheme.set_font_color(self._count, col)
end

function Tutorial.apply_layout(self)
	if self._card.visible then
		self:_place()
	end
end

--- The card: top centre, under Roblox's top bar row and the match's status pill.
function Tutorial._place(self)
	local ctx = self.ctx
	local vp, ins = ctx.vp, ctx.insets
	local c = ctx.compact
	self._text:set_font_size(if c then 13 else 15)
	-- (the reward's two lines are a little longer than a step's)
	self._text:set_min_size(Vector2.new(if self._ending > 0.0 then 256 elseif c then 200 else 260, 0))
	self._card:reset_size()
	local sz = self._card:get_combined_minimum_size()
	local x = math.clamp((vp.X - sz.X) * 0.5, ins.x + 8.0, math.max(ins.x + 8.0, vp.X - ins.z - sz.X - 8.0))
	UICtx.move_node(self._card, Vector2.new(math.floor(x), math.floor(ins.y + (if c then 62.0 else 74.0))))
end

-- ---------------------------------------------------------------------------------------------
-- What the player did
-- ---------------------------------------------------------------------------------------------

--- The orders sent since the last look: any, an attack on a neighbour, on empty land.
function Tutorial._orders(self): (boolean, boolean, boolean)
	local log = self.ctx.sent_log
	local s = self.ctx.state
	local any, on_owner, on_land = false, false, false
	-- (the log is a window of the last orders: after it wraps, count from its end)
	if self._sent > #log then
		self._sent = 0
	end
	for i = self._sent + 1, #log do
		local it = log[i].intent
		if type(it) == "table" and (it.type == "attack" or it.type == "boat") then
			any = true
			local target = tonumber(it.target)
			if target == nil and type(it.tile) == "number" and s ~= nil then
				target = s:tile_owner(it.tile)
			end
			if target ~= nil and target > 0 then
				on_owner = true
			else
				on_land = true
			end
		end
	end
	self._sent = #log
	return any, on_owner, on_land
end

--- A roomy place to start: of SPAWN_TRIES free land tiles, one far from every nation's start
--- (SPAWN_ROOM tiles is far enough) and away from the map's top and bottom edges (the first pick on
--- the world map was the middle of Antarctica: empty, and nothing to see).
function Tutorial._find_spot(self): number?
	local s = self.ctx.state
	local map = s and s.map
	if map == nil or type(map.land_tile) ~= "function" or (map.land_count or 0) <= 0 then
		return nil
	end
	local starts = {}
	for _, o in s.owners do
		if type(o.spawn_tile) == "number" and o.spawn_tile >= 0 then
			table.insert(starts, o.spawn_tile)
		end
	end
	local best, best_d = nil, -1.0
	for _ = 1, Tutorial.SPAWN_TRIES do
		local t = map:land_tile(math.random(0, map.land_count - 1))
		if map:is_contestable(t) and s:tile_owner(t) == 0 and not map:is_coastal(t) then
			local d = math.huge
			for _, o in starts do
				d = math.min(d, Defs.tile_distance(t, o))
			end
			d = math.min(d, Tutorial.SPAWN_ROOM)
			local W, H = map.W or Defs.W, map.H or Defs.H
			local off = math.abs((t // W) / H - 0.45)
			d -= math.max(0.0, off - 0.27) * 300.0
			if d > best_d then
				best, best_d = t, d
			end
		end
	end
	return best
end

function Tutorial._say(self, i: number, arg: string?)
	local step = Data.STEPS[i]
	local txt = if self.ctx.touch then step.touch else step.desktop
	if string.find(txt, "%s", 1, true) then
		txt = string.format(txt, arg or "them")
	end
	self._count:set_text(string.format("%d / %d", i, #Data.STEPS))
	self._text:set_text(txt)
	self._bar:set_visible(step.bar == true)
	self._fill.Size = UDim2.fromScale(0, 1)
	self._fill.BackgroundColor3 = UITheme.AMBER
	self._fill_f = 0.0
	self._skip:set_text("Skip")
	self:_tint(UITheme.AMBER)
	self._card:set_visible(i > 1)
	if i > 1 then
		self:_place()
		UICtx.pop_in(self._card, 0.0, 0.94, 0.3, true)
	end
end

--- Step `i` is finished (`passed`: nobody did it in time, it is passed over without a tick).
function Tutorial._advance(self, passed: boolean?)
	local step = Data.STEPS[self._i]
	if not passed then
		self.step_done:Fire(Data.funnel_step(step.id), Data.FUNNEL[Data.funnel_step(step.id)])
		self.ctx:sfx("confirm", -4.0)
		if self._card.visible then
			self:_tint(UITheme.GREEN)
			self._text:set_text("Nice!")
			self._bar:set_visible(false)
			self._flash = Tutorial.DONE_S
		end
	end
	self._i += 1
	self._step_t = 0.0
	self._idle = 0.0
	self._shown = nil
	if self._i > #Data.STEPS then
		self.step_done:Fire(#Data.FUNNEL, Data.FUNNEL[#Data.FUNNEL])
		self:stop("done")
	end
end

-- ---------------------------------------------------------------------------------------------
-- Per frame
-- ---------------------------------------------------------------------------------------------

function Tutorial._process(self, delta: number)
	self._t += delta
	if self._ending > 0.0 then
		self._ending -= delta
		if self._ending <= 0.0 then
			self:_close()
		end
		return
	end
	if not self.active then
		return
	end
	local ctx = self.ctx
	local ui = self.ui
	local s = ctx.state
	if s == nil or ctx:mode() ~= UICtx.MODE_SOLO then
		return
	end
	if s.phase == Defs.PHASE_OVER then
		self:stop("left")
		return
	end
	-- a finished step's green card stands a moment before the next line
	if self._flash > 0.0 then
		self._flash -= delta
		self._mark.Visible = false
		if self._flash > 0.0 then
			return
		end
	end
	local i = self._i
	local step = Data.STEPS[i]
	local o = ctx:my()
	local any, on_owner, on_land = self:_orders()
	self._step_t += delta
	if
		ctx.troop_floor == nil
		and i >= (Data.step_index(Data.FLOOR_FROM) or 1)
		and o ~= nil
		and Data.floor_armed(o.troops or 0, o.max_troops or 0, ctx:alive_seconds())
	then
		ctx.troop_floor = Data.TROOP_FLOOR
	end
	if not self._started and self._step_t > 1.0 then
		-- the match is up (and reported: the server logs a step for a match it knows of)
		self._started = true
		self.step_done:Fire(1, Data.FUNNEL[1])
	end
	self._idle = if any then 0.0 else self._idle + delta
	local point = Vector2.new(-1, -1)
	--- (a control's radius, when the mark is for one: it goes around it)
	local around: number? = nil
	--- (what the mark says, when not the step's own word)
	local word: string? = nil
	local id = step.id
	if id == "spawn" then
		if o ~= nil and o.spawned then
			self:_advance()
			return
		end
		if self._spot == nil or self._spot_state ~= s then
			self._spot = self:_find_spot()
			self._spot_state = s
			self._step_t = 0.0
			if self._spot ~= nil then
				-- the camera goes there, close enough that a thumb hits the land around it
				local w = ctx.world
				local d = if w ~= nil and w.rig ~= nil and type(w.rig.scale_to_distance) == "function"
					then w.rig:scale_to_distance(Tutorial.SPAWN_PX)
					else -1.0
				ctx:world_call("focus_tile", { self._spot, d, 0.9 })
			end
		end
		if self._spot ~= nil then
			point = ctx:tile_screen_pos(self._spot)
			if self._step_t > Data.AUTO_SPAWN_S and not self._picked and s:tile_owner(self._spot) == 0 then
				-- nobody picked: this spot is theirs
				self._picked = true
				ctx:send({ type = "spawn", tile = self._spot })
			end
		end
	elseif o ~= nil and o.spawned and o.alive == false then
		self:stop("left") -- (conquered: the result screen takes over)
		return
	elseif o == nil or not ctx:alive_player() or s.phase ~= Defs.PHASE_PLAYING then
		self._mark.Visible = false
		return
	else
		if self._shown ~= i then
			-- the step's line (and what it needs) once, when it comes up
			self._shown = i
			if id == "grow" then
				self._taps = 0
				self._ready = nil
				self._refill = nil
				self._line = nil
				-- (an order sent while "expand"'s card was green was that step's second tap)
				any = false
			elseif id == "attack" then
				self._neighbour = nil
			elseif id == "ratio" then
				self._ratio_ok = 0.0
				self._ratio_high = false
			elseif id == "city" and not self._gold_given then
				self._gold_given = true
				local sim = ctx:session_call("local_sim")
				local cost = ctx.rules:cost("city")
				if sim ~= nil and type(sim.o_gold) == "table" and cost > 0 and (sim.o_gold[ctx:me()] or 0) < cost then
					sim.o_gold[ctx:me()] = cost
				end
			end
			self:_say(i, if self._neighbour ~= nil then s:owner_name(self._neighbour) else nil)
		end
		if id == "expand" then
			if any then
				self:_advance()
				return
			end
			point = ui.advisor:frontier_point()
		elseif id == "grow" then
			-- let the troops refill (Data.GROW_READY: the bar fills towards ready), then expand. An
			-- expansion sent before counts too: its card says to let the bar fill next time
			if any then
				local early = not self._ready
				self._taps += 1
				if early then
					-- (it spent the refill: the bar drops)
					self._refill = nil
				end
				if self._taps >= Data.GROW_TAPS then
					self:_advance()
					if early and self._card.visible then
						self._text:set_text(step.early)
						self._flash = Data.EARLY_S
					end
					return
				end
			end
			local cap = o.max_troops or 0
			local f = if cap > 0 then Data.refill(o.troops, cap, self._refill) else 1.0
			self._refill = f
			-- (a full bar stays full, so ready stays ready while the cap climbs under it)
			local ready = f >= 1.0
			if ready ~= self._ready then
				if ready and self._ready == false then
					-- refilled: the card says so, so eyes on the troop count come back up
					ctx:sfx("tick", -6.0)
					UICtx.pop_in(self._card, 0.0, 0.97, 0.25, true)
				end
				self._ready = ready
				self._fill.BackgroundColor3 = if ready then UITheme.GREEN else UITheme.AMBER
			end
			local line = if ready then (if ctx.touch then step.touch else step.desktop) else step.wait
			if line ~= self._line then
				self._line = line
				self._text:set_text(line)
			end
			if math.abs(f - (self._fill_f or 0.0)) >= 0.005 or (ready and self._fill_f ~= 1.0) then
				self._fill_f = f
				self._fill.Size = UDim2.fromScale(f, 1)
			end
			if not ready then
				-- the troop count, filling
				local tc = self:_troops_control()
				if tc ~= nil then
					local r = tc:get_global_rect()
					point = UICtx.rect_center(r)
					around = math.max(r.Width, r.Height) * 0.5
					word = "Refilling"
				end
			elseif self._taps == 0 or self._idle > Data.NUDGE_S then
				point = ui.advisor:frontier_point()
			end
		elseif id == "ratio" then
			-- a moderate share, and left there: never a push to send everything
			local r = ctx.ratio
			if r >= Data.RATIO_LOW and r <= Data.RATIO_HIGH then
				self._ratio_ok = (self._ratio_ok or 0.0) + delta
				if self._ratio_ok >= Data.RATIO_HOLD_S then
					self:_advance()
					return
				end
			else
				self._ratio_ok = 0.0
			end
			local high = r > Data.RATIO_HIGH
			if high ~= self._ratio_high then
				self._ratio_high = high
				self._text:set_text(
					if high then Data.RATIO_TOO_MUCH elseif ctx.touch then step.touch else step.desktop
				)
				self:_tint(if high then UITheme.RED else UITheme.AMBER)
			end
			-- the mark goes around the stop to tap
			local sl = ui.bar._slider
			if sl ~= nil and sl:is_visible_in_tree() then
				local r = sl:stop_rect(Data.RATIO_GOAL) or sl:get_global_rect()
				point = UICtx.rect_center(r)
				around = math.min(r.Width, r.Height) * 0.5
			end
		elseif id == "attack" then
			if on_owner then
				self:_advance()
				return
			end
			if self._neighbour == nil or s:get_owner(self._neighbour) == nil then
				local ns = ctx.borders:neighbour_ids()
				if #ns > 0 then
					self._neighbour = ns[1]
					self:_say(i, s:owner_name(ns[1]))
				elseif self._step_t > Data.CONTACT_WAIT_S then
					self:_advance(true) -- nobody to attack yet
					return
				else
					-- no neighbour yet: keep growing towards one
					self._text:set_text(if ctx.touch then "Keep growing until you meet a neighbour" else "Keep growing until you meet a neighbour")
					if self._idle > Data.NUDGE_S then
						point = ui.advisor:frontier_point()
					end
				end
			end
			if self._neighbour ~= nil and s:get_owner(self._neighbour) ~= nil then
				point = ctx:tile_screen_pos(s:label_tile(self._neighbour))
			end
		elseif id == "city" then
			for _, st in s.structures do
				if st.owner == ctx:me() and st.kind == Defs.S_CITY then
					self:_advance()
					return
				end
			end
			local cb = ui.bar:button("city")
			local b = if cb ~= nil and cb:is_visible_in_tree() then cb else ui.bar._tray_btn
			local pc = ui.place_confirm
			local placing = ui.interact.aim_kind == "city"
			-- (while the City is in hand the game's own line stands where the card does: the card
			-- steps aside and only the mark leads on)
			if self._card.visible == placing then
				self._card:set_visible(not placing)
			end
			if pc ~= nil and pc.is_open and pc._ok:is_visible_in_tree() then
				-- a spot is picked: the tick builds it
				local r = pc._ok:get_global_rect()
				point = UICtx.rect_center(r)
				around = math.max(r.Width, r.Height) * 0.5
			elseif placing then
				-- the City is in hand: the mark moves to the player's land
				point = ctx:tile_screen_pos(s:label_tile(ctx:me()))
			elseif b ~= nil and b:is_visible_in_tree() then
				local r = b:get_global_rect()
				point = UICtx.rect_center(r)
				around = math.max(r.Width, r.Height) * 0.5
			end
		end
		if self._step_t > (step.max_s or Data.STEP_MAX_S) then
			self:_advance(true)
			return
		end
	end
	self:_draw_mark(point, word or step.mark, around)
end

--- The command bar's troop count as it shows (phones' compact bar has its own), or nil.
function Tutorial._troops_control(self): any
	local bar = self.ui.bar
	if bar == nil then
		return nil
	end
	for _, c in { bar._troops_box, bar._m_troops } do
		if c ~= nil and c:is_visible_in_tree() then
			return c
		end
	end
	return nil
end

--- The tap mark at logical point `p` ((-1, -1): none); `word`: what it says instead of "Tap here".
--- `around`: the mark is for a control of this radius, and goes around it, not on it (on the
--- confirm tick the dot and rings sat on the icon, which looked bad; 2026-10-04).
--- Without it (a spot on the map) two rings close on a dot.
function Tutorial._draw_mark(self, p: Vector2, word: string?, around: number?)
	local ctx = self.ctx
	local mark = self._mark
	if p.X < 0.0 or p.Y < 0.0 or p.X > ctx.vp.X or p.Y > ctx.vp.Y then
		mark.Visible = false
		return
	end
	ctx:fit_canvas(mark)
	mark.Visible = true
	-- two rings closing on the dot, half a beat apart: a finger coming down
	local k1 = (self._t % 1.1) / 1.1
	local k2 = ((self._t + 0.55) % 1.1) / 1.1
	-- (a control: the rings close from outside onto its edge and stop there, and there is no dot)
	local inner = if around ~= nil then around + 4.0 else 12.0
	local outer = inner + (if around ~= nil then 16.0 else 22.0)
	UICtx.set_circle(self._ring_a, p, outer - (outer - inner) * k1)
	UICtx.set_circle(self._ring_b, p, outer - (outer - inner) * k2);
	(self._ring_a:FindFirstChild("Stroke") :: UIStroke).Transparency = 1 - k1 * 0.95;
	(self._ring_b:FindFirstChild("Stroke") :: UIStroke).Transparency = 1 - k2 * 0.95
	self._dot.Visible = around == nil
	UICtx.set_circle(self._dot, p, 6.0)
	self._tap.Text = word or (if ctx.touch then "Tap here" else "Click here")
	-- (under the mark; over it when the mark is near the bottom of the screen, on the command bar)
	local gap = outer + 6.0
	local below = p.Y + gap + 26 < ctx.vp.Y - ctx.insets.w
	self._tap.AnchorPoint = Vector2.new(0.5, if below then 0 else 1)
	self._tap.Position = UDim2.fromOffset(p.X, if below then p.Y + gap else p.Y - gap)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="229">
            <Properties>
              <string name="Name">UIAdvisor</string>
              <string name="Source"><![CDATA[-- Port of scripts/ui/ui_advisor.gd
-- Reactions to the match for the HUD: sounds and toasts for game events that involve you, threat
-- warnings (a neighbour massing 5x your army, being attacked), first-match coach-mark triggers and
-- filtering of Sim messages that the UI already presents in a richer form.

local UICtx = require("./UICtx") :: any
local Defs = UICtx.core("Defs")

local _T: any = nil
local function T(): any
	if _T == nil then
		_T = UICtx.mod("UITheme")
	end
	return _T
end
local _Rules: any = nil
local function Rules(): any
	if _Rules == nil then
		_Rules = UICtx.core("Rules")
	end
	return _Rules
end

local UIAdvisor = {}
UIAdvisor.__index = UIAdvisor

function UIAdvisor.new(root: any)
	local self = setmetatable({}, UIAdvisor)
	self.ui = root
	self.ctx = root.ctx
	--- Cool-downs for warnings, keyed "atk:<id>" / "big:<id>" -> msec.
	self._warned = {} :: { [string]: number }
	--- nuke uid -> owner of the SAM that fired at it (from sam_launched).
	self._sam_by_nuke = {} :: { [number]: number }
	--- MIRV volleys: nuke owner -> {total, down_by_me, down_mine, sam, msec}.
	self._volleys = {} :: { [number]: { [string]: number } }
	--- Shells in flight: id -> {target_uid, last known target tile, own involved}.
	self._shells = {} :: { [number]: { any } }
	self._throttle = {} :: { [string]: number }
	--- Own warships: announce a retreat for repairs once per retreat and each veterancy rank gained.
	self._ship_state = {} :: { [number]: number }
	self._ship_vet = {} :: { [number]: number }
	--- ally -> the expires_at whose renewal window we already prompted for.
	self._renew_prompted = {} :: { [number]: number }
	return self
end

function UIAdvisor.reset(self: any)
	table.clear(self._warned)
	table.clear(self._renew_prompted)
end

--- Alliance renewals: when an alliance of ours enters its
--- renewal window (the last ALLIANCE_EXTEND_WINDOW_TICKS), a Renew / Ignore card, once per window.
--- The card closes once we asked, the alliance was renewed or it ended.
function UIAdvisor.check_renewals(self: any)
	local ctx = self.ctx
	local s = ctx.state
	local feed = self.ui.feed
	local me = ctx:me()
	if s == nil or me == 0 or not ctx:in_match() then
		return
	end
	local live = {}
	for _, other in s:allies_of(me) do
		live[other] = true
		local ai = s:alliance_info(me, other)
		if ai ~= nil and ai.can_extend then
			if self._renew_prompted[other] ~= ai.expires_at then
				self._renew_prompted[other] = ai.expires_at
				feed:alliance_renewal(other, ai.expires_at, ai.other_asked)
				ctx:sfx("ally_request")
			end
		elseif feed:has_renewal_card(other) then
			feed:close_renewal(other)
		end
	end
	for other in self._renew_prompted do
		if not live[other] then
			self._renew_prompted[other] = nil
			feed:close_renewal(other)
		end
	end
end

function UIAdvisor.cooldown(self: any, key: string, ms: number): boolean
	local now = UICtx.msec()
	local w = self._warned[key]
	if w ~= nil and now - w < ms then
		return false
	end
	self._warned[key] = now
	return true
end

--- A neighbour massing 5x our army is worth a warning before it strikes.
function UIAdvisor.check_threats(self: any)
	local ctx = self.ctx
	local s = ctx.state
	local o = ctx:my()
	if s == nil or o == nil or not ctx:alive_player() or s.phase ~= Defs.PHASE_PLAYING or o.troops <= 0 then
		return
	end
	local worst = 0
	local worst_troops = 0
	for _, id in ctx.borders:neighbour_ids() do
		local n = s:get_owner(id)
		if n == nil or not n.alive or s:are_allies(o.id, id) then
			continue
		end
		if n.troops >= 5 * o.troops and n.troops > worst_troops then
			worst = id
			worst_troops = n.troops
		end
	end
	if worst ~= 0 and self:cooldown("big:" .. worst, 120000) and self:cooldown("big:any", 25000) then
		local ratio_x = math.floor(worst_troops / math.max(o.troops, 1))
		self.ui.feed:toast(
			Defs.MSG_BAD,
			string.format(
				"%s (%s troops) borders you with %d× your army. Fortify or find allies.",
				s:owner_name(worst),
				T().fmt_troops(worst_troops),
				ratio_x
			),
			"defense"
		)
	end
end

--- First-match coach marks driven by what is happening.
function UIAdvisor.check_tips(self: any)
	local ctx = self.ctx
	local ui = self.ui
	local s = ctx.state
	local o = ctx:my()
	if s == nil or o == nil or not ctx:alive_player() or s.phase ~= Defs.PHASE_PLAYING or ui:screen() ~= "play" then
		return
	end
	local secs = ctx:match_seconds()
	if secs > 3.4 then -- after "THE WAR BEGINS" has faded
		ui.coach:offer("expand", function()
			return self:frontier_point()
		end)
	end
	if secs > 22.0 then
		ui.coach:offer("ratio", function()
			local sl = ui.bar._slider
			if sl ~= nil and sl:is_visible_in_tree() then
				return UICtx.rect_center(sl:get_global_rect())
			end
			return Vector2.new(-1, -1)
		end)
	end
	local city_cost = ctx.rules:cost("city")
	if secs > 25.0 and o.gold >= city_cost and city_cost > 0 then
		ui.coach:offer("city", function()
			local cb = ui.bar:button("city")
			local b = if cb ~= nil and cb:is_visible_in_tree() then cb else ui.bar._tray_btn
			if b ~= nil and b:is_visible_in_tree() then
				return UICtx.rect_center(b:get_global_rect())
			end
			return Vector2.new(-1, -1)
		end)
	end
	local ns = ctx.borders:neighbour_ids()
	if #ns > 0 and secs > 8.0 then
		local first = ns[1]
		ui.coach:offer("contact", function()
			return if s:get_owner(first) ~= nil then ctx:tile_screen_pos(s:label_tile(first)) else Vector2.new(-1, -1)
		end, s:owner_name(first))
	end
	if ctx.borders:has_coast() and secs > 40.0 then
		ui.coach:offer("boat")
	end
end

--- A new player's floor under the army outside the tutorial (which keeps its own while it runs):
--- in the player's first Data/Tutorial.ROOKIE_MATCHES matches an order leaves ROOKIE_FLOOR of the
--- army's cap at home, from the time it arms (Data/Tutorial.floor_armed: FLOOR_ARM of the cap, or
--- FLOOR_ARM_S seconds in play) (UICtx.troop_floor; UIRoot clears it for every new match).
function UIAdvisor.check_floor(self: any)
	local ui = self.ui
	local ctx = self.ctx
	-- (first: the seconds count from the nation's first second in play, the tutorial's too)
	local played = ctx:alive_seconds()
	if ctx.troop_floor ~= nil or (ui.tutorial ~= nil and ui.tutorial.active) or not ctx:alive_player() then
		return
	end
	local o = ctx:my()
	local Tut = UICtx.data("Tutorial")
	if o == nil or not Tut.rookie(ui.telemetry:matches_before()) then
		return
	end
	if Tut.floor_armed(o.troops or 0, o.max_troops or 0, played) then
		ctx.troop_floor = Tut.ROOKIE_FLOOR
	end
end

--- The floor held an order back (UICtx.floor_held): the first time in a match, and then at most
--- once a minute, a tip on the Attack bar says why (the tutorial's card does while it runs).
function UIAdvisor.on_floor_held(self: any)
	local ui = self.ui
	if (ui.tutorial ~= nil and ui.tutorial.active) or not self:cooldown("floor", 60000) then
		return
	end
	ui.coach:offer("floor", function()
		local sl = ui.bar._slider
		if sl ~= nil and sl:is_visible_in_tree() then
			return UICtx.rect_center(sl:get_global_rect())
		end
		return Vector2.new(-1, -1)
	end)
end

--- Screen point of a neutral tile on our frontier (for the "expand" tip), or (-1, -1).
function UIAdvisor.frontier_point(self: any): Vector2
	local ctx = self.ctx
	local s = ctx.state
	if s == nil then
		return Vector2.new(-1, -1)
	end
	local me = ctx:me()
	local n = 0
	local map = s.map
	for t in ctx.borders.border do
		n += 1
		if n > 400 then
			break
		end
		for _, nb in map:neighbors4(t) do
			if s:tile_owner(nb) == 0 and map:is_contestable(nb) and not s:has_fallout(nb) then
				local p = ctx:tile_screen_pos(nb)
				if p.X >= 0.0 then
					return p
				end
			end
		end
	end
	return if me ~= 0 then ctx:tile_screen_pos(s:label_tile(me)) else Vector2.new(-1, -1)
end

--- Sim messages the interface already shows in a richer form (cards, threat toasts, alliance toasts).
function UIAdvisor.duplicate_message(text: string): boolean
	local low = string.lower(text)
	local function has(sub: string): boolean
		return string.find(low, sub, 1, true) ~= nil
	end
	if has("alliance") and (has("request") or has("propos")) and not has("did not answer") and not has("declined") then
		return true
	end
	if string.sub(low, -#"is attacking you!") == "is attacking you!" then
		return true
	end
	if
		string.sub(low, 1, #"you are now allied with") == "you are now allied with"
		or has("betrayed your alliance")
		or string.sub(low, 1, #"you broke your alliance") == "you broke your alliance"
	then
		return true
	end
	return false
end

-- ---------------------------------------------------------------------------------------------
-- GameState events (connected by UIRoot._bind_state)
-- ---------------------------------------------------------------------------------------------

--- The sound of your border growing (2026-10-04):
--- every batch of tile changes, the land the local player just gained goes to AudioDirector.pop,
--- which turns it into a run of pops (their rate follows the speed, see AudioDirector.POP_*).
--- `changed` = GameState.tiles_changed: { tile * 1024 + new owner }.
function UIAdvisor.on_tiles_changed(self: any, changed: { number })
	local ctx = self.ctx
	local a = ctx.audio
	local me = ctx:me()
	local s = ctx.state
	if me == 0 or s == nil or a == nil or type(a.pop) ~= "function" or not ctx:in_match() then
		return
	end
	if s.phase ~= Defs.PHASE_PLAYING then
		return -- (picking a start has its own sound)
	end
	local n = 0
	for _, v in changed do
		if v % 1024 == me then
			n += 1
		end
	end
	if n == 0 then
		return
	end
	local R = s.rules or Rules()
	local progress = 0.0
	local o = ctx:my()
	if o ~= nil and s.map ~= nil then
		local land = math.max((s.map.land_count or 0) - (s.fallout_count or 0), 1)
		progress = (o.tiles or 0) / (land * R.WIN_SHARE)
	end
	a:pop(n * (R.K_AREA or 1), progress)
end

function UIAdvisor.on_structure_added(self: any, sid: number)
	local ctx = self.ctx
	local st = ctx.state.structures[sid]
	if st == nil or not ctx.rules:on_structure(st.kind, 0, st.owner) then
		return
	end
	if ctx:in_match() then
		ctx:sfx("build")
	end
	self.ui.bar:refresh_buttons()
end

function UIAdvisor.on_unit_added(self: any, uid: number)
	local ctx = self.ctx
	local u = ctx.state.units[uid]
	if u == nil or not ctx.rules:on_unit(u.kind, u.owner, 1) then
		return
	end
	if u.kind == Defs.U_TRANSPORT then
		ctx:sfx("boat")
	elseif u.kind == Defs.U_WARSHIP then
		ctx:sfx("warship")
		self.ui.bar:refresh_buttons()
	end
end

function UIAdvisor.on_nuke_launched(self: any, uid: number)
	local ctx = self.ctx
	local n = ctx.state.nukes[uid]
	if n == nil or not ctx:in_match() then
		return
	end
	-- a shell, an air strike, a slug (the Arsenal): a shot, never the nuke alarm
	if Rules().NUKE_FLAT[n.kind] then
		local mine = n.owner == ctx:me() and ctx:me() ~= 0
		if n.kind == Defs.N_SHELL then
			if ctx:tile_screen_pos(n.from_tile).X >= 0.0 then
				ctx:sfx("shell_fire", if mine then -8.0 else -12.0, 0.08)
			end
		elseif mine or ctx:tile_screen_pos(n.from_tile).X >= 0.0 then
			ctx:sfx(if n.kind == Defs.N_SLUG then "shell_fire" else "sam_launch", if mine then -2.0 else -8.0, 0.0, if n.kind == Defs.N_SLUG then 0.6 else 0.85)
		end
		return
	end
	self:on_warhead_launched(n)
	if n.owner == ctx:me() and ctx:me() ~= 0 and n.kind ~= Defs.N_WARHEAD then
		ctx:sfx("nuke_launch")
	end
	local aimed_at_me, banner_came_up = self.ui.alert:track(uid)
	if aimed_at_me then
		ctx:sfx("alarm")
		-- (the banner is placed when it comes up: its width is fixed, so the hundreds of warheads that
		-- follow a MIRV's first don't move it)
		if banner_came_up then
			self.ui:relayout_alert()
		end
	end
end

--- BOOM radius: > 0 blast, 0 = shot down by a SAM, -1 = MIRV split into warheads (no blast).
function UIAdvisor.on_nuke_detonated(
	self: any,
	uid: number,
	kind: number,
	tile: number,
	radius: number,
	owner_id: number
)
	local ctx = self.ctx
	self.ui.alert:resolve(uid, radius == 0)
	if not ctx:in_match() or radius < 0 then
		return
	end
	local near = ctx:tile_screen_pos(tile).X >= 0.0
	local me = ctx:me()
	local mine = me ~= 0 and (owner_id == me or ctx.state:tile_owner(tile) == me)
	-- a strike (the Arsenal): a hit, not a nuclear blast (no ducked music for a shell every few seconds)
	if Rules().NUKE_FLAT[kind] then
		if kind == Defs.N_SHELL then
			if near then
				ctx:sfx("shell_hit", if mine then -6.0 else -11.0, 0.08)
			end
		elseif near or mine then
			ctx:sfx("intercept", if mine then -1.0 else -6.0, 0.0, if kind == Defs.N_SLUG then 1.25 else 0.8)
		end
		return
	end
	if radius == 0 then
		local sam_owner = self._sam_by_nuke[uid] or 0
		self._sam_by_nuke[uid] = nil
		-- (silent: the message says it)
		self:_note_intercept(kind, owner_id, sam_owner)
		return
	end
	if near or mine then
		ctx:sfx("explosion", if mine then 0.0 else -3.0)
	end
end

-- ---------------------------------------------------------------------------------------------
-- SAM interceptions
-- ---------------------------------------------------------------------------------------------

local SAM_FIELDS = { "sam_sid", "nuke_uid", "fire_tick", "intercept_tick", "will_hit" }

local function rec_field(rec: any, fname: string, fallback: any): any
	if type(rec) == "table" then
		local v = rec[fname]
		if v ~= nil then
			return v
		end
		local i = table.find(SAM_FIELDS, fname)
		if i ~= nil and rec[i] ~= nil then
			return rec[i]
		end
	end
	return fallback
end
UIAdvisor._rec_field = rec_field

--- Sim SAM_LAUNCH via GameState.sam_launched(nuke_uid). Reads the launch record defensively.
function UIAdvisor.on_sam_launched(self: any, id: number)
	local ctx = self.ctx
	local s = ctx.state
	if s == nil or not ctx:in_match() then
		return
	end
	local rec = nil
	for _, store in { "sam_missiles", "sam_launches", "sam_shots" } do
		local d = s[store]
		if type(d) == "table" and d[id] ~= nil then
			rec = d[id]
			break
		end
	end
	local sam_sid = tonumber(rec_field(rec, "sam_sid", 0)) or 0
	local nuke_uid = tonumber(rec_field(rec, "nuke_uid", id)) or id
	local st = s.structures[sam_sid]
	local sam_owner = if st ~= nil then st.owner else 0
	if nuke_uid ~= 0 then
		self._sam_by_nuke[nuke_uid] = sam_owner
	end
end

-- ---------------------------------------------------------------------------------------------
-- Naval combat sounds
-- ---------------------------------------------------------------------------------------------

--- Volume (dB) for a combat sound (shells, sinkings, SAM launches): full when the local player is
--- involved, otherwise silent (-100). Other players' fights make no sound: on-screen battles between
--- others made a constant patter of unexplained noises (2026-09-26).
function UIAdvisor.combat_level(_self: any, _tile: number, own: boolean): number
	return if own then 0.0 else -100.0
end

function UIAdvisor._unit_owner(self: any, uid: number): number
	local u = self.ctx.state.units[uid]
	return if u ~= nil then u.owner else 0
end

--- Where a unit is now (warships sit on path[1]; others move along their path).
function UIAdvisor._unit_tile(self: any, uid: number): number
	local ctx = self.ctx
	local u = ctx.state.units[uid]
	if u == nil or u.path == nil or #u.path == 0 then
		return -1
	end
	if u.kind == Defs.U_WARSHIP then
		return u.path[1]
	end
	local px, py, pz = ctx.state:unit_pose_xyz(u, ctx:render_tick())
	return Defs.xyz_tile(px, py, pz)
end

function UIAdvisor.on_shell_fired(self: any, id: number)
	local ctx = self.ctx
	local s = ctx.state
	local sh = if s ~= nil then s.shells[id] else nil
	if sh == nil or not ctx:in_match() then
		return
	end
	local shooter = 0
	if sh.shooter_kind == 0 then
		shooter = self:_unit_owner(sh.shooter_id)
	else
		local st = s.structures[sh.shooter_id]
		shooter = if st ~= nil then st.owner else 0
	end
	local me = ctx:me()
	local own = me ~= 0 and (shooter == me or self:_unit_owner(sh.target_uid) == me)
	self._shells[id] = { sh.target_uid, self:_unit_tile(sh.target_uid), own }
end

--- (warship and defense-post gunfire is silent: every shot, hit and splash made a
--- constant racket once the player had a warship out, 2026-09-27)
function UIAdvisor.on_shell_impact(self: any, id: number, _hit: boolean)
	self._shells[id] = nil
end

--- A unit is gone: forget its warship bookkeeping (sinkings make no sound).
function UIAdvisor.on_unit_removed(self: any, uid: number, _reason: number)
	self._ship_state[uid] = nil
	self._ship_vet[uid] = nil
end

--- An intercept: toast for the local player (one per volley for MIRV warheads).
function UIAdvisor._note_intercept(self: any, kind: number, nuke_owner: number, sam_owner: number)
	local ctx = self.ctx
	local me = ctx:me()
	if me == 0 or (sam_owner ~= me and nuke_owner ~= me) then
		return
	end
	local s = ctx.state
	if kind == Defs.N_WARHEAD then
		local v = self._volleys[nuke_owner] or { total = 0, down_by_me = 0, down_mine = 0, sam = 0, msec = 0 }
		if sam_owner == me then
			v.down_by_me += 1
		end
		if nuke_owner == me then
			v.down_mine += 1
			v.sam = sam_owner
		end
		v.msec = UICtx.msec()
		self._volleys[nuke_owner] = v
		return
	end
	local what = if kind >= 0 and kind < Defs.NUKE_KIND_COUNT then Defs.NUKE_TITLES[kind] else "nuke"
	if not self:cooldown(string.format("icpt:%d:%d", sam_owner, nuke_owner), 2500) then
		return
	end
	if sam_owner == me then
		self.ui.feed:toast(
			Defs.MSG_GOOD,
			string.format("Your SAM shot down %s's %s", s:owner_name(nuke_owner), what),
			"sam"
		)
	else
		self.ui.feed:toast(
			Defs.MSG_BAD,
			string.format("%s's SAM intercepted your %s", if sam_owner ~= 0 then s:owner_name(sam_owner) else "A", what),
			"sam"
		)
	end
end

--- Counts MIRV warheads as they launch (the volley total) and reports each volley once it is over.
function UIAdvisor.on_warhead_launched(self: any, n: any)
	if n.kind ~= Defs.N_WARHEAD then
		return
	end
	local v = self._volleys[n.owner] or { total = 0, down_by_me = 0, down_mine = 0, sam = 0, msec = 0 }
	v.total += 1
	v.msec = UICtx.msec()
	self._volleys[n.owner] = v
end

--- Called about once a second: flush volleys that have been quiet for a while.
function UIAdvisor.flush_volleys(self: any)
	local ctx = self.ctx
	local now = UICtx.msec()
	local s = ctx.state
	local done = {}
	for owner_id, v in self._volleys do
		if now - v.msec >= 3000 then
			table.insert(done, owner_id)
		end
	end
	table.sort(done)
	for _, owner_id in done do
		local v = self._volleys[owner_id]
		self._volleys[owner_id] = nil
		if s == nil or not ctx:in_match() then
			continue
		end
		local total = math.max(v.total, math.max(v.down_by_me, v.down_mine))
		if v.down_by_me > 0 then
			self.ui.feed:toast(
				Defs.MSG_GOOD,
				string.format(
					"Your SAMs shot down %d of %d warheads from %s",
					v.down_by_me,
					total,
					s:owner_name(owner_id)
				),
				"sam"
			)
		elseif v.down_mine > 0 then
			self.ui.feed:toast(
				Defs.MSG_BAD,
				string.format("SAMs shot down %d of your %d warheads", v.down_mine, total),
				"sam"
			)
		end
	end
end

function UIAdvisor.on_attack_started(self: any, aid: number)
	local ctx = self.ctx
	local ui = self.ui
	ui.attacks:mark_dirty()
	local a = ctx.state.attacks[aid]
	local me = ctx:me()
	if a == nil or me == 0 or not ctx:in_match() then
		return
	end
	-- (no sound for launching or receiving attacks: they were more annoying
	-- than useful, 2026-09-27)
	if a.attacker == me then
		return
	end
	if a.target == me and a.attacker ~= 0 and ctx:alive_player() then
		local att = ctx.state:get_owner(a.attacker)
		if att ~= nil and self:cooldown("atk:" .. a.attacker, 20000) then
			ui.feed:toast(
				Defs.MSG_ALERT,
				string.format("%s (%s) is attacking you!", att.name, T().fmt_troops(att.troops)),
				"attack"
			)
		end
		ui.coach:offer("attacked", function()
			local p = ui.attacks.panel
			if p ~= nil and p.visible then
				return UICtx.rect_center(p:get_global_rect())
			end
			return Vector2.new(-1, -1)
		end)
	end
end

function UIAdvisor.on_alliance_requested(self: any, from: number, to: number)
	local ctx = self.ctx
	if to == ctx:me() and to ~= 0 and ctx:in_match() then
		self.ui.feed:alliance_request(from)
		ctx:sfx("ally_request")
	end
end

function UIAdvisor.on_alliance_request_closed(self: any, from: number, to: number)
	if to == self.ctx:me() then
		self.ui.feed:close_request(from)
	end
end

function UIAdvisor.on_alliance_changed(
	self: any,
	a: number,
	b: number,
	formed: boolean,
	traitor: number,
	expired: boolean?
)
	local ctx = self.ctx
	local ui = self.ui
	ui.board:mark_dirty()
	local me = ctx:me()
	if me == 0 or (a ~= me and b ~= me) or not ctx:in_match() then
		return
	end
	local other = if a == me then b else a
	local nm = ctx.state:owner_name(other)
	ui.feed:close_request(other)
	if formed then
		ctx:sfx("alliance")
		ui.feed:toast(Defs.MSG_ALLIANCE, "Alliance formed with " .. nm, "alliance")
	elseif traitor == me then
		ctx:sfx("betrayal")
		ui.feed:toast(
			Defs.MSG_BAD,
			string.format(
				"You broke your alliance with %s. For %d s you are a Traitor: attacks on you cost half the troops.",
				nm,
				Rules().TRAITOR_TICKS // Defs.TICK_RATE
			),
			"betray"
		)
	elseif traitor == other then
		ctx:sfx("betrayal")
		ui.feed:toast(Defs.MSG_ALERT, nm .. " betrayed you!", "betray")
	elseif not expired then
		-- (an expiry is announced by the Sim's own message)
		ui.feed:toast(Defs.MSG_INFO, "Your alliance with " .. nm .. " has ended", "alliance")
	end
	ui.feed:close_renewal(other)
	ui.bar:refresh_buttons()
end

--- Which naval event a Sim message reports ("" = none).
function UIAdvisor._naval_sfx(text: string): string
	local t = string.lower(text)
	local function has(sub: string): boolean
		return string.find(t, sub, 1, true) ~= nil
	end
	if has("sank your") or has("your transport was sunk") or has("your warship was sunk") then
		return "ship_lost"
	end
	if has("you sank") or has("your warship sank") then
		return "ship_kill"
	end
	if has("captured a trade ship") and string.sub(t, 1, 4) == "your" then
		return "trade_captured"
	end
	if has("trade ship") then
		return "trade_lost"
	end
	return ""
end

function UIAdvisor.on_message(self: any, _to: number, category: number, text: string)
	local ctx = self.ctx
	if not ctx:in_match() or UIAdvisor.duplicate_message(text) then
		return
	end
	-- Naval news from the Sim: a sound per kind (throttled), and repeated captures fold together.
	local naval = UIAdvisor._naval_sfx(text)
	if naval == "trade_captured" and self:_throttled("toast_capture", 6000) then
		return
	end
	self.ui.feed:toast(category, text, if naval ~= "" then "warship" else "")
	-- (naval news is silent — sinkings and trade captures played every few seconds
	-- once warships were out and grew annoying, 2026-09-27)
	if naval == "" and category == Defs.MSG_ALERT then
		ctx:sfx("toast", -4.0)
	end
end

function UIAdvisor._throttled(self: any, key: string, ms: number): boolean
	local now = UICtx.msec()
	if now - (self._throttle[key] or -1000000) < ms then
		return true
	end
	self._throttle[key] = now
	return false
end

function UIAdvisor.on_unit_changed(self: any, uid: number)
	local ctx = self.ctx
	local ui = self.ui
	local s = ctx.state
	local u = if s ~= nil then s.units[uid] else nil
	if u == nil or u.kind ~= Defs.U_WARSHIP or u.owner ~= ctx:me() or ctx:me() == 0 or not ctx:in_match() then
		return
	end
	local stt = tonumber(u.state) or 0
	local prev = self._ship_state[uid] or 0
	self._ship_state[uid] = stt
	if stt == 1 and prev ~= 1 and not self:_throttled("retreat", 8000) then
		ui.feed:toast(Defs.MSG_INFO, "Your warship is returning to port for repairs", "warship")
	end
	local vet = tonumber(u.veterancy) or 0
	local pv = self._ship_vet[uid] or 0
	self._ship_vet[uid] = vet
	if vet > pv and not self:_throttled("vet", 3000) then
		ui.feed:toast(Defs.MSG_GOOD, string.format("Your warship reached veterancy %d", vet), "warship")
	end
	if ui.unit_card.is_open and ui.unit_card.uid == uid then
		ui.unit_card:refresh()
	end
end

-- ---------------------------------------------------------------------------------------------
-- Match end: elimination, game over, the war-begins moment
-- ---------------------------------------------------------------------------------------------

function UIAdvisor.track_stats(self: any)
	local ctx = self.ctx
	local ui = self.ui
	local s = ctx.state
	local o = ctx:my()
	if s ~= nil and o ~= nil and ctx:in_match() and o.alive then
		ui._stats.peak_share = math.max(ui._stats.peak_share or 0.0, s:land_share(o.id))
		ui._stats.max_troops = math.max(ui._stats.max_troops or 0, o.troops)
	end
end

function UIAdvisor.on_owner_eliminated(self: any, id: number, killer: number)
	local ctx = self.ctx
	local ui = self.ui
	ui.board:mark_dirty()
	if not ctx:in_match() then
		return
	end
	local me = ctx:me()
	local st = ui._stats
	if killer == me and me ~= 0 and id ~= me then
		st.kills = (st.kills or 0) + 1
		ctx:sfx("eliminate")
	end
	if id == me and me ~= 0 and not st.over and not st.elim then
		self:track_stats()
		st.elim = true
		ui.coach:clear()
		ui.alert:clear()
		ui.feed:close_all_requests()
		st.killer = killer
		st.duration_s = ctx:match_seconds()
		ui.interact:cancel_aim(false)
		ui.radial:close(false)
		-- Let the last tiles fall on screen before the curtain comes down.
		ui:_start_elim_timer(0.8, killer)
		ui:_request_apply()
	end
end

function UIAdvisor.on_elim_timeout(self: any, killer: number)
	local ctx = self.ctx
	local ui = self.ui
	if ui._stats.over or not ctx:in_match() or ui.over.is_open then
		return
	end
	ctx:sfx("defeat")
	ui.over:open("eliminated", 0, killer, ui._stats)
	ui:_update_input_gate()
end

function UIAdvisor.on_game_over(self: any, winner: number, reason: number)
	local ctx = self.ctx
	local ui = self.ui
	local st = ui._stats
	if not ctx:in_match() or st.over then
		return
	end
	self:track_stats()
	ui.coach:clear()
	st.over = true
	-- the whole match's length for the result screen (duration_s stays the moment we fell)
	st.match_s = ctx:match_seconds()
	local me = ctx:me()
	local mine = ctx:my()
	local dead = st.elim or (mine ~= nil and not mine.alive and mine.spawned)
	ui.interact:cancel_aim(false)
	ui.radial:close(false)
	ui.tooltip:hide_tip()
	if dead and reason == Defs.OVER_DEFEATED and ctx:mode() == UICtx.MODE_SOLO then
		-- Solo ended because we fell: that is an elimination, not someone else's "victory".
		local killer = if (st.killer or 0) ~= 0 then st.killer else (if mine ~= nil then (mine.killer or 0) else 0)
		if not st.elim then
			st.duration_s = ctx:match_seconds()
		end
		st.elim = true
		-- (GameOver.open swaps the copy in place when the elimination screen is still up.)
		if not ui:_elim_timer_pending() then
			ctx:sfx("defeat")
		end
		ui.over:open("eliminated", 0, killer, st)
		ui:_request_apply()
		return
	end
	if not dead then
		st.duration_s = ctx:match_seconds()
	end
	local kind = "result"
	if me ~= 0 and not dead then
		kind = if winner == me then "victory" else "defeat"
	end
	-- a team game: the team wins together (a fallen member's team too; every member who spawned is
	-- credited)
	local s = ctx.state
	local wt = if s ~= nil then tonumber(s.winner_team) or 0 else 0
	if wt ~= 0 and me ~= 0 and s:team_of(me) ~= 0 then
		kind = if s:team_of(me) == wt then "victory" else (if dead then "result" else "defeat")
	end
	ctx:sfx(if kind == "victory" then "victory" else "defeat")
	-- An ELIMINATED screen still up turns into the result in place (no close + reopen race).
	ui.over:open(kind, winner, if mine ~= nil then (mine.killer or 0) else 0, st, reason)
	ui:_request_apply()
end

--- Spawn phase camera. The globe turned away from an ocean-only view here; flat maps show the whole
--- map during the spawn phase, so there is nothing to do (UIRoot still calls it).
function UIAdvisor.spawn_view(_self: any) end

--- Spawn -> play: a short "the war begins" moment and a push-in on the capital.
function UIAdvisor.war_begins(self: any)
	local ctx = self.ctx
	local ui = self.ui
	local me = ctx:me()
	if me ~= 0 then
		ctx:world_call("focus_owner", { me })
	end
	-- The camera lands the capital in the middle of the HUD-free band; use the roomier side of it,
	-- and a title-only banner on very short screens.
	local band: Rect = if ui._world_safe.Height > 1.0 then ui._world_safe else ctx:clear_rect()
	local cap_y = UICtx.rect_center(band).Y
	local gap = if ctx.compact then 30.0 else 60.0
	local above = cap_y - gap - band.Min.Y
	local below = band.Max.Y - (cap_y + gap)
	local h = if ctx.compact then 70.0 else 96.0
	local small = math.max(above, below) < h
	if small then
		h = 38.0
	end
	local top_y = if above >= below then cap_y - gap - h else cap_y + gap
	top_y = math.max(top_y, band.Min.Y - 12.0)
	local Banner = UICtx.mod("Banner")
	local banner =
		Banner.make(ctx, "THE WAR BEGINS", "Expand, build and outlast 88 nations", T().AMBER, 1.6, top_y, h, small)
	-- The camera is still pushing in, so where the player's own label ends up is only known as it
	-- goes: the band slides clear of it (up to just under the top panels, or below the capital), and
	-- every other map label steps around its text (review R2-5: on a 361 px phone the subtitle sat
	-- on the YOU pill).
	banner.avoid = function()
		local r = ctx:world_call("local_label_rect", {})
		return if typeof(r) == "Rect" then ctx:rect_to_logical(r) else nil
	end
	banner.min_top = band.Min.Y - 12.0
	banner.max_bottom = band.Max.Y
	ui.float_layer:add_child(banner)
	if banner.text_area ~= nil and ui.add_hud_control ~= nil then
		-- (it moves out of YOU's way itself: the YOU label does not step aside for it)
		banner.text_area.gui:SetAttribute("AF_YIELD_YOU", true)
		ui:add_hud_control(banner.text_area)
	end
end

return UIAdvisor
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="230">
            <Properties>
              <string name="Name">UICtx</string>
              <string name="Source"><![CDATA[-- Port of scripts/ui/ui_ctx.gd
-- Shared context for every UI component: duck-typed handles to Session / WorldView / AudioDirector
-- (so lightweight stand-ins work in tests), the bound GameState, layout metrics, the attack ratio,
-- persisted settings and throttled sound effects. Also a few static helpers the Godot builtins
-- provided (Rect2 maths on Roblox `Rect`, colour conversion, shared-module resolution).
--
-- Coordinates: the UI works in LOGICAL px (Godot px of the 1600x900 design; the kit's Widgets.Root
-- applies one UI scale, see build/notes/ui-kit.md). WorldView / UserInputService use VIEWPORT px.
-- Every conversion happens here: tile_screen_pos / mouse_pos return logical px, tile_at(pos) takes
-- logical px, to_view / to_logical convert explicitly.

local IS_ROBLOX = (game :: any) ~= nil

--- Shared Core module by name (ReplicatedStorage.Airfront.Core in Roblox, src/shared/Core in Lune),
--- required once and kept (see UICtx.prime: a require late in a session can fail).
local _core: { [string]: any } = {}
local function core(name: string): any
	local m = _core[name]
	if m ~= nil then
		return m
	end
	if IS_ROBLOX then
		local rs = game:GetService("ReplicatedStorage")
		m = require((rs:WaitForChild("Airfront") :: any):WaitForChild("Core"):WaitForChild(name))
	else
		m = (require :: any)("../../shared/Core/" .. name)
	end
	_core[name] = m
	return m
end

local Signal = core("Signal")
local Defs = core("Defs")

local UICtx = {}
UICtx.__index = UICtx

UICtx.core = core
UICtx.IS_ROBLOX = IS_ROBLOX

UICtx.MODE_TITLE = 0
UICtx.MODE_SOLO = 1
UICtx.MODE_MULTI = 2
--- Solo difficulty until the player picks one (0 Relaxed · 1 Standard · 2 Brutal): Relaxed, the
--- gentlest. Standard as the default lost most new players in their
--- first minutes (2026-09-28 funnel: 2.6% of Standard matches reached 10 minutes, 16% of Relaxed).
UICtx.DEFAULT_DIFFICULTY = 0
--- The Attack bar's stops: the shares of the army an order can send. Since 2026-10-08 the bar has
--- five set breakpoints, none below 10% or above 75%, which were never needed.
--- Until then the ratio was anything from 1% to 100% (a free slider), set by dragging a
--- knob along 96 px on a phone.
UICtx.RATIO_STOPS = { 0.10, 0.25, 0.35, 0.50, 0.75 }
--- Attack ratio before the player sets one: the stop beside 20 % (it was
--- 20% while the slider had no stops).
UICtx.DEFAULT_RATIO = 0.25

--- Logical SFX ids -> file names in assets/audio/sfx (one place to remap).
UICtx.SFX = {
	hover = "ui_hover",
	click = "ui_click",
	open = "ui_open",
	close = "ui_back",
	deny = "ui_error",
	toast = "ui_tab",
	-- the interface kit (Assets/AudioUI): a press that commits, a tab / toggle, a locked unit,
	-- Stars counting up and landing, paying, an unlock
	confirm = "ui_confirm",
	tab = "ui_tab",
	locked = "ui_locked",
	star_tick = "star_tick",
	star_get = "star_get",
	buy = "buy_spend",
	unlock = "unlock",
	expand = "expand",
	attack = "attack_launch",
	boat = "boat_launch",
	build = "build",
	warship = "warship",
	nuke_launch = "nuke_launch",
	explosion = "nuke_explosion",
	intercept = "sam_intercept",
	alliance = "alliance",
	betrayal = "betrayal",
	alarm = "nuke_alarm",
	-- (BedWars' kill sound, Assets/AudioUI; it was "conquer", the original's 3 s sting, until it was
	-- replaced by a satisfying, unobtrusive elimination sound, 2026-10-04)
	eliminate = "eliminate",
	victory = "victory",
	defeat = "defeat",
	tick = "countdown_tick",
	start = "game_start",
	spawn = "spawn_confirm",
	under_attack = "under_attack",
	ally_request = "ally_request",
	ship_lost = "ship_sunk",
	ship_kill = "ship_kill",
	trade_captured = "trade_capture",
	trade_lost = "trade_lost",
	warship_retreat = "warship_retreat",
	veterancy = "veterancy",
	sam_launch = "sam_launch",
}
--- Used when the AudioDirector does not (yet) ship a sound.
UICtx.SFX_FALLBACK = {
	close = "ui_click",
	toast = "ui_open",
	confirm = "ui_click",
	tab = "ui_click",
	locked = "ui_error",
	star_tick = "ui_hover",
	star_get = "ui_open",
	buy = "ui_click",
	unlock = "alliance",
	under_attack = "ui_error",
	ally_request = "ui_open",
	ship_lost = "sam_intercept",
	ship_kill = "sam_intercept",
	trade_captured = "build",
	trade_lost = "ui_error",
	warship_retreat = "ui_open",
	veterancy = "alliance",
	sam_launch = "attack_launch",
}
--- Minimum milliseconds between two plays of the same SFX id (AudioDirector throttles too).
UICtx.SFX_GAP = {
	hover = 60,
	click = 40,
	tab = 40,
	confirm = 80,
	locked = 200,
	star_tick = 28,
	unlock = 900,
	toast = 400,
	attack = 180,
	expand = 180,
	boat = 200,
	build = 150,
	explosion = 220,
	alarm = 1500,
	tick = 300,
	deny = 200,
	under_attack = 4000,
	ally_request = 1500,
	ship_lost = 1500,
	ship_kill = 1500,
	trade_captured = 2500,
	trade_lost = 3000,
	warship_retreat = 3000,
	veterancy = 2000,
	sam_launch = 100,
	intercept = 120,
	shell_fire = 50,
	shell_hit = 50,
	shell_splash = 50,
	ship_sink = 300,
}

--- A shared Data module (ReplicatedStorage.Airfront.Data: "Arsenal", "Stars", "Products"...),
--- required once and kept.
local _data: { [string]: any } = {}
function UICtx.data(name: string): any
	local m = _data[name]
	if m ~= nil then
		return m
	end
	if typeof(game) == "Instance" then
		local rs = (game :: any):GetService("ReplicatedStorage")
		m = require((rs:WaitForChild("Airfront") :: any).Data[name])
	else
		m = (require :: any)("../../shared/Data/" .. name)
	end
	_data[name] = m
	return m
end

--- A UI module beside this one ("UITheme", "Widgets", "UIRules"...), required once and kept: modules
--- that load one lazily (to keep the rules testable without the interface) ask here.
local _mods: { [string]: any } = {}
function UICtx.mod(name: string): any
	local m = _mods[name]
	if m ~= nil then
		return m
	end
	if typeof(game) == "Instance" then
		m = require((script :: any).Parent:WaitForChild(name))
	else
		m = (require :: any)("./" .. name)
	end
	_mods[name] = m
	return m
end

--- What the interface loads later in a session, loaded at its start. In some live sessions every
--- require after some moment fails ("Cannot require a RobloxScript module from a non RobloxScript
--- context": hover tooltips, sounds, toasts, the troop rate's colour; 2026-10-10 on, 34.6K errors a day
--- by 10-23, its trigger not found): with these kept, nothing on those paths requires any more.
UICtx.PRIME_CORE = { "Signal", "Defs", "Rules", "NumberFormat", "Ev" }
UICtx.PRIME_UI = { "UITheme", "Widgets", "UIRules", "FloatText", "Banner", "FillBar" }
UICtx.PRIME_DATA = { "Arsenal", "Cosmetics", "Staging", "Stars", "Starter", "Tutorial", "Products" }
function UICtx.prime()
	for _, n in UICtx.PRIME_CORE do
		pcall(core, n)
	end
	for _, n in UICtx.PRIME_UI do
		pcall(UICtx.mod, n)
	end
	for _, n in UICtx.PRIME_DATA do
		pcall(UICtx.data, n)
	end
	local T = _mods.UITheme
	if T ~= nil then
		for _, n in UICtx.PRIME_CORE do
			pcall(T.core, n)
		end
		pcall(T.crate_art)
		pcall(T.icon, "close")
	end
	pcall(UICtx.shapes)
end

--- 12345 -> "12,345" (Stars are shown whole, never as 12.3K).
function UICtx.commas(n: number): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return if n < 0 then "-" .. out else out
end

--- Milliseconds since an arbitrary start (GDScript Time.get_ticks_msec()).
function UICtx.msec(): number
	return os.clock() * 1000.0
end

-- =============================================================================================
-- Static helpers (Godot builtins)
-- =============================================================================================

--- RGBA8 int (Core colours) / Color3 -> Color3.
function UICtx.color3(c: any): Color3
	if typeof(c) == "Color3" then
		return c
	end
	if type(c) == "number" then
		local r, g, b = Defs.rgba_bytes(c)
		return Color3.fromRGB(r, g, b)
	end
	return Color3.new(0.6, 0.6, 0.6)
end

--- Godot Color.get_luminance() of a Color3.
function UICtx.luminance(c: Color3): number
	return 0.2126 * c.R + 0.7152 * c.G + 0.0722 * c.B
end

--- Rect2(x, y, w, h) as a Roblox Rect.
function UICtx.rect(x: number, y: number, w: number, h: number): Rect
	return Rect.new(x, y, x + w, y + h)
end

--- Rect2(position, size).
function UICtx.rect_ps(pos: Vector2, size: Vector2): Rect
	return Rect.new(pos.X, pos.Y, pos.X + size.X, pos.Y + size.Y)
end

--- Viewport-px rect of a GuiObject. AbsolutePosition is relative to the area below the top bar
--- (even inside IgnoreGuiInset ScreenGuis), so the GUI inset is added back.
function UICtx.rect_of(g: GuiObject): Rect
	local inset = if IS_ROBLOX then game:GetService("GuiService"):GetGuiInset() else Vector2.zero
	local p = g.AbsolutePosition + inset
	local s = g.AbsoluteSize
	return Rect.new(p.X, p.Y, p.X + s.X, p.Y + s.Y)
end

UICtx.EMPTY_RECT = Rect.new(0, 0, 0, 0)

function UICtx.rect_is_empty(r: Rect): boolean
	return r.Width <= 0 or r.Height <= 0
end

function UICtx.rect_has_point(r: Rect, p: Vector2): boolean
	return p.X >= r.Min.X and p.Y >= r.Min.Y and p.X < r.Max.X and p.Y < r.Max.Y
end

function UICtx.rect_grow(r: Rect, by: number): Rect
	return Rect.new(r.Min.X - by, r.Min.Y - by, r.Max.X + by, r.Max.Y + by)
end

--- Rect2.intersects (borders excluded).
function UICtx.rect_intersects(a: Rect, b: Rect): boolean
	return a.Min.X < b.Max.X and a.Max.X > b.Min.X and a.Min.Y < b.Max.Y and a.Max.Y > b.Min.Y
end

--- Rect2.encloses: b lies completely inside a.
function UICtx.rect_encloses(a: Rect, b: Rect): boolean
	return b.Min.X >= a.Min.X and b.Min.Y >= a.Min.Y and b.Max.X <= a.Max.X and b.Max.Y <= a.Max.Y
end

function UICtx.rect_intersection_area(a: Rect, b: Rect): number
	local w = math.min(a.Max.X, b.Max.X) - math.max(a.Min.X, b.Min.X)
	local h = math.min(a.Max.Y, b.Max.Y) - math.max(a.Min.Y, b.Min.Y)
	if w <= 0 or h <= 0 then
		return 0
	end
	return w * h
end

function UICtx.rect_merge(a: Rect, b: Rect): Rect
	return Rect.new(
		math.min(a.Min.X, b.Min.X),
		math.min(a.Min.Y, b.Min.Y),
		math.max(a.Max.X, b.Max.X),
		math.max(a.Max.Y, b.Max.Y)
	)
end

function UICtx.rect_center(r: Rect): Vector2
	return Vector2.new((r.Min.X + r.Max.X) * 0.5, (r.Min.Y + r.Max.Y) * 0.5)
end

function UICtx.rect_equal_approx(a: Rect, b: Rect): boolean
	local e = 0.01
	return math.abs(a.Min.X - b.Min.X) < e
		and math.abs(a.Min.Y - b.Min.Y) < e
		and math.abs(a.Max.X - b.Max.X) < e
		and math.abs(a.Max.Y - b.Max.Y) < e
end

--- Reads a per-tile byte / int grid that may be a buffer (Core convention) or a 0-based table.
function UICtx.u8(grid: any, i: number): number
	if typeof(grid) == "buffer" then
		return buffer.readu8(grid, i)
	end
	return grid[i] or 0
end

function UICtx.i32(grid: any, i: number): number
	if typeof(grid) == "buffer" then
		return buffer.readi32(grid, i * 4)
	end
	return grid[i] or 0
end

-- =============================================================================================
-- Construction
-- =============================================================================================

export type Insets = { x: number, y: number, z: number, w: number }

function UICtx.new()
	local self = setmetatable({}, UICtx)
	self.state_bound = Signal.new()
	self.layout_changed = Signal.new()
	self.ratio_changed = Signal.new()
	--- an order was held back by troop_floor: trimmed to what may go, or not sent (UIAdvisor says why)
	self.floor_held = Signal.new()
	self.local_changed = Signal.new()

	self.session = nil :: any
	self.world = nil :: any
	self.audio = nil :: any
	self.state = nil :: any
	--- Mode the bound state belongs to (a queued MP client still shows the title state).
	self.state_mode = UICtx.MODE_TITLE
	--- The UI root Frame (full screen) once UIRoot built it.
	self.root = nil :: any
	self.borders = (require("./BorderTracker") :: any).new()
	self.rules = nil :: any
	--- Persisted settings ([ui] section of the original's user://settings.cfg).
	self.settings = {} :: { [string]: any }

	-- Layout metrics (logical px = Roblox offsets)
	self.vp = Vector2.new(1600, 900)
	--- Safe area: left, top, right, bottom.
	self.insets = { x = 0, y = 0, z = 0, w = 0 } :: Insets
	--- Phone-sized viewport.
	self.compact = false
	--- Last pointer input was touch (or a touch device).
	self.touch = false
	--- Running on a phone / tablet (touch mode never switches off).
	self.touch_device = false
	--- The Rofront Staging experience, or Studio: staging-only tools show (Data/Products). See also
	--- admin().
	self.staging = false
	if IS_ROBLOX then
		pcall(function()
			self.staging = UICtx.data("Staging").here() or game:GetService("RunService"):IsStudio()
		end)
	end
	--- Room for the single-row command bar.
	self.wide = true
	--- Top-left rectangle owned by the Roblox top bar row (+ our top-bar buttons) and the chat window.
	self.reserved_top_left = Rect.new(0, 0, 420, 320)
	--- The Roblox top bar button row (its buttons draw above our layer), padded.
	self.airship_bar = Rect.new(0, 0, 350, 58)

	self.ratio = UICtx.DEFAULT_RATIO
	--- The Attack bar stops here (1 = no cap) and an order leaves this share of the army's cap at home
	--- (nil = no floor): UI/Tutorial sets both while it runs.
	self.ratio_max = 1.0
	self.troop_floor = nil :: number?
	--- Tick at which the local player's nation was first seen in play this match (alive_seconds)
	self.alive_from_tick = nil :: number?
	--- Tick at which the PLAYING phase began (match clock and durations come from game ticks).
	self.play_start_tick = -1.0
	--- Test hook: when X >= 0 this replaces the real pointer position.
	self.debug_mouse = Vector2.new(-1, -1)
	--- Viewport px of the UI root's origin (see update_origin).
	self.origin = Vector2.zero
	--- Last pointer position seen (logical px), kept by UIInteract (touches included).
	self.pointer = Vector2.new(-1, -1)
	--- Shared hover card (set by UIRoot).
	self.tooltip = nil :: any
	--- First-match coach marks (set by UIRoot).
	self.coach = nil :: any
	--- Last intents sent (tests use this to prove one tap = one order).
	self.sent_log = {} :: { any }
	self._sfx_last = {} :: { [string]: number }
	self._save_pending = false

	self.rules = (UICtx.mod("UIRules") :: any).new(self)
	self:_load_settings()
	-- (the Attack slider is not a saved setting any more: every match starts at DEFAULT_RATIO)
	self.ratio = UICtx.DEFAULT_RATIO
	UICtx.prime()
	return self
end

-- =============================================================================================
-- Raw drawing helpers (custom-drawn parts: radial ring, countdown arc, coach arrow, markers).
-- They build plain Roblox instances in LOGICAL px inside a "canvas" (a Frame with a UIScale =
-- UITheme.scale), so they line up with the kit's nodes.
-- =============================================================================================

--- Roblox TextSize for a Godot font size inside a logical canvas (the canvas' UIScale applies the
--- UI scale; Rubik line height = 1.185 em).
function UICtx.ts(size: number): number
	return math.max(1, math.floor(size * 1.185 + 0.5))
end

--- Top of a text line whose Godot baseline is at `baseline_y` (Rubik ascent 0.935 em).
function UICtx.top_for_baseline(baseline_y: number, size: number): number
	return baseline_y - 0.935 * size
end

local _shapes: any = nil
--- The static UI shapes manifest (Assets/UiShapes; {} when missing).
function UICtx.shapes(): any
	if _shapes == nil then
		local ok, m = pcall(function()
			if IS_ROBLOX then
				local rs = game:GetService("ReplicatedStorage")
				return require((rs:WaitForChild("Airfront") :: any):WaitForChild("Assets"):WaitForChild("UiShapes"))
			end
			return (require :: any)("../../shared/Assets/UiShapes")
		end)
		_shapes = if ok and type(m) == "table" then m else {}
	end
	return _shapes
end

--- New instance with properties.
function UICtx.make(class: string, props: { [string]: any }?, parent: Instance?): any
	local o = Instance.new(class)
	if props then
		for k, v in props do
			(o :: any)[k] = v
		end
	end
	if parent then
		o.Parent = parent
	end
	return o
end

--- Transparent frame (no border), positioned in offsets.
function UICtx.frame(parent: Instance?, pos: Vector2?, size: Vector2?): Frame
	local f = UICtx.make("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset((pos or Vector2.zero).X, (pos or Vector2.zero).Y),
		Size = UDim2.fromOffset((size or Vector2.zero).X, (size or Vector2.zero).Y),
	}, parent)
	return f
end

--- A full-screen logical canvas: Frame sized to the logical viewport with a UIScale.
function UICtx.canvas(parent: Instance?, name: string?): Frame
	local f = UICtx.frame(parent)
	f.Name = name or "Canvas"
	UICtx.make("UIScale", { Name = "Scale", Scale = 1 }, f)
	return f
end

--- Resize a canvas to the current logical viewport / UI scale.
function UICtx.fit_canvas(self: any, f: Frame)
	f.Size = UDim2.fromOffset(self.vp.X, self.vp.Y)
	local us = f:FindFirstChild("Scale") :: UIScale?
	if us then
		us.Scale = self:ui_scale()
	end
end

--- A kit node (Widgets Control) whose `canvas` Frame is a logical-px drawing surface of the
--- node's size (UIScale = UI scale). `draw(node)` is called whenever the node is resized / the
--- scale changes (Godot _draw on resize). Used for custom-drawn widgets (arcs, arrows).
function UICtx.draw_node(draw: ((any) -> ())?): any
	local W = UICtx.mod("Widgets")
	local node = W.Control.new()
	node:set_mouse_filter(W.MOUSE_IGNORE)
	local canvas = UICtx.canvas(node.gui, "Draw")
	canvas.ZIndex = 1
	node.canvas = canvas
	node._draw_fn = draw
	node._on_geometry = function(self)
		self.canvas.Size = UDim2.fromOffset(self.size.X, self.size.Y)
		local us = self.canvas:FindFirstChild("Scale") :: UIScale
		local T = UICtx.mod("UITheme")
		us.Scale = T.scale
		if self._draw_fn then
			self._draw_fn(self)
		end
	end
	return node
end

--- Panel entrance (the original's UIWidgets.pop_in: fade + settle from 0.94 scale). Roblox re-lays
--- text at every intermediate UIScale (glyph sizes snap to whole px), so panels holding text settle
--- with a short rise instead of a scale: same timing (alpha over 0.8 dur, settle over dur), rise =
--- (1 - from_scale) * 100 px. `fade_only` for panels re-positioned every frame (the shift would be
--- overwritten) — they just fade.
function UICtx.pop_in(node: any, delay: number?, from_scale: number?, dur: number?, fade_only: boolean?)
	local W = UICtx.mod("Widgets")
	local d = delay or 0.0
	local du = dur or 0.4
	local rise = (1.0 - (from_scale or 0.96)) * 100.0
	if fade_only or node.parent == nil or node.parent._is_container then
		node:set_modulate_a(0.0)
		local t = node:create_tween()
		if d > 0 then
			t:tween_interval(d)
		end
		t:tween_property(node, "modulate:a", 1.0, du * 0.8):set_trans(W.TRANS_CUBIC):set_ease(W.EASE_OUT)
		return t
	end
	return W.slide_in(node, Vector2.new(0, rise), d, du)
end

--- Move a free (top-left anchored) kit node to `p` (logical px) without dirtying the whole tree:
--- per-frame followers (tooltip, coach card, placement buttons) only rewrite their own geometry.
--- The node keeps its size; offsets are kept in sync so later layout passes agree.
function UICtx.move_node(n: any, p: Vector2)
	n.offset_left, n.offset_top = p.X, p.Y
	n.offset_right, n.offset_bottom = p.X, p.Y
	if n.parent == nil then
		return
	end
	local min = n:get_combined_minimum_size()
	if n.size ~= min then
		n:reset_size()
		return
	end
	if n.position ~= p then
		n.position = p
		n:_write_geometry()
	end
end

--- Filled circle (Frame + UICorner), centred at `c` with radius `r`.
function UICtx.circle(parent: Instance?, c: Vector2, r: number, color: Color3, transparency: number?): Frame
	local f = UICtx.make("Frame", {
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(c.X, c.Y),
		Size = UDim2.fromOffset(r * 2, r * 2),
		BackgroundColor3 = color,
		BackgroundTransparency = transparency or 0,
	}, parent)
	UICtx.make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
	return f
end

--- Circle outline (UIStroke) of radius `r` (centre of the stroke) and `width`.
function UICtx.ring(
	parent: Instance?,
	c: Vector2,
	r: number,
	width: number,
	color: Color3,
	transparency: number?
): Frame
	local f = UICtx.circle(parent, c, r, color, 1)
	UICtx.make("UIStroke", {
		Name = "Stroke",
		Thickness = width,
		Color = color,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		BorderStrokePosition = Enum.BorderStrokePosition.Center,
	}, f)
	return f
end

function UICtx.set_circle(f: Frame, c: Vector2, r: number)
	f.Position = UDim2.fromOffset(c.X, c.Y)
	f.Size = UDim2.fromOffset(r * 2, r * 2)
end

--- Clockwise arc from 12 o'clock over `frac` (0..1) of a circle: two half-width clip frames, each
--- holding a stroked circle whose UIGradient hides everything past the arc end.
--- Returns an object: arc.frame, arc:set(frac, color?, transparency?), arc:place(center, r, width).
function UICtx.arc(parent: Instance?): any
	local holder = UICtx.frame(parent)
	holder.Name = "Arc"
	local halves = {}
	for side = 0, 1 do
		local clip = UICtx.frame(holder)
		clip.ClipsDescendants = true
		local c = UICtx.frame(clip)
		UICtx.make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, c)
		local st = UICtx.make("UIStroke", {
			Thickness = 4,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			BorderStrokePosition = Enum.BorderStrokePosition.Center,
		}, c)
		local g = UICtx.make("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.4999, 0),
				NumberSequenceKeypoint.new(0.5001, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}, st)
		halves[side + 1] = { clip = clip, circle = c, stroke = st, grad = g }
	end
	local arc = { frame = holder, halves = halves, frac = -1 }
	--- Stroke centred on radius `r`, `width` wide.
	function arc.place(self: any, center: Vector2, r: number, width: number)
		local m = width -- margin so the AA edge is never clipped
		local size = (r + m) * 2
		holder.Position = UDim2.fromOffset(center.X - size / 2, center.Y - size / 2)
		holder.Size = UDim2.fromOffset(size, size)
		for i, h in self.halves do
			local right = i == 2
			h.clip.Position = UDim2.fromOffset(if right then size / 2 else 0, 0)
			h.clip.Size = UDim2.fromOffset(size / 2, size)
			h.circle.Position = UDim2.fromOffset(if right then -size / 2 + m else m, m)
			h.circle.Size = UDim2.fromOffset(r * 2, r * 2)
			h.stroke.Thickness = width
		end
	end
	function arc.set(self: any, frac: number, color: Color3?, transparency: number?)
		frac = math.clamp(frac, 0, 1)
		for i, h in self.halves do
			if color then
				h.stroke.Color = color
			end
			if transparency then
				h.stroke.Transparency = transparency
			end
			if frac ~= self.frac then
				if i == 2 then -- right half: 0 .. 0.5 of the circle
					local th = math.clamp(frac / 0.5, 0, 1) * 180
					h.grad.Rotation = th
					h.circle.Visible = th > 0.01
				else -- left half: 0.5 .. 1
					local th = math.clamp((frac - 0.5) / 0.5, 0, 1) * 180
					h.grad.Rotation = 180 + th
					h.circle.Visible = th > 0.01
				end
			end
		end
		self.frac = frac
	end
	return arc
end

-- =============================================================================================
-- Session / state
-- =============================================================================================

function UICtx.mode(self: any): number
	local s = self.session
	if s == nil then
		return UICtx.MODE_TITLE
	end
	return tonumber(s.mode) or UICtx.MODE_TITLE
end

function UICtx.in_match(self: any): boolean
	return self:mode() ~= UICtx.MODE_TITLE and self.state_mode == self:mode()
end

--- Waiting in the multiplayer queue (mode switched, match state not yet received).
function UICtx.mp_waiting(self: any): boolean
	return self:mode() == UICtx.MODE_MULTI and self.state_mode ~= UICtx.MODE_MULTI
end

function UICtx.me(self: any): number
	local s = self.state
	return if s ~= nil then (s.local_owner or 0) else 0
end

function UICtx.my(self: any): any
	local s = self.state
	if s == nil then
		return nil
	end
	return s:get_owner(s.local_owner)
end

--- GameState.ranking()'s first (most land among the living; ties: the lower id), or nil, and an
--- owner's place in it (1-based; 0: not in it), each from one pass over the owners. (2026-10-27: the
--- status pill sorted every owner four times a second for these, twice on a phone, and the command
--- bar's crown once more on every stats update.)
local function ranks_before(o: any, p: any): boolean
	return o.tiles > p.tiles or (o.tiles == p.tiles and o.id < p.id)
end

function UICtx.leader(self: any): any
	local s = self.state
	if s == nil then
		return nil
	end
	local best = nil
	for _, o in s.owners do
		if o.alive and o.tiles > 0 and (best == nil or ranks_before(o, best)) then
			best = o
		end
	end
	return best
end

function UICtx.rank_of(self: any, id: number): number
	local s = self.state
	local me = if s ~= nil then s:get_owner(id) else nil
	if me == nil or not (me.alive and me.tiles > 0) then
		return 0
	end
	local r = 1
	for _, o in s.owners do
		if o ~= me and o.alive and o.tiles > 0 and ranks_before(o, me) then
			r += 1
		end
	end
	return r
end

--- A commander that still has to place a capital (spawn phase, or dropping into a running match).
function UICtx.needs_spawn(self: any): boolean
	local o = self:my()
	if o == nil or not o.alive or not self:in_match() or self.state == nil then
		return false
	end
	local ph = self.state.phase
	return (not o.spawned) and (ph == Defs.PHASE_SPAWN or ph == Defs.PHASE_PLAYING)
end

function UICtx.alive_player(self: any): boolean
	local o = self:my()
	return o ~= nil and o.alive and self:in_match()
end

function UICtx.lobby(self: any): { [string]: any }
	local s = self.session
	if s == nil then
		return {}
	end
	local l = s.lobby
	return if type(l) == "table" then l else {}
end

function UICtx.send(self: any, intent: { [string]: any })
	-- under a troop floor every attack is held to what may go, whoever built the order; one with
	-- nothing to send is not sent at all
	if self.troop_floor ~= nil and (intent.type == "attack" or intent.type == "boat") then
		local share = math.min(tonumber(intent.ratio) or self.ratio, self:floor_share())
		if share < self.ratio - 1e-6 then
			self.floor_held:Fire()
		end
		if share <= 0.001 then
			return
		end
		intent.ratio = share
	end
	table.insert(self.sent_log, { msec = UICtx.msec(), intent = intent })
	if #self.sent_log > 64 then
		table.remove(self.sent_log, 1)
	end
	local s = self.session
	if s ~= nil and type(s.send_intent) == "function" then
		s:send_intent(intent)
	end
	if self.telemetry ~= nil then
		self.telemetry:on_intent(intent)
	end
end

function UICtx.session_call(self: any, method: string, args: { any }?): any
	local s = self.session
	if s == nil then
		return nil
	end
	local f = s[method]
	if type(f) ~= "function" then
		return nil
	end
	if args then
		return f(s, table.unpack(args))
	end
	return f(s)
end

function UICtx.tick_seconds(_self: any, ticks: number): number
	return ticks / Defs.TICK_RATE
end

--- Seconds of play so far (from game ticks, so pausing / time-lapse are exact).
function UICtx.match_seconds(self: any): number
	if self.state == nil or self.play_start_tick < 0.0 then
		return 0.0
	end
	return math.max(0.0, (self:render_tick() - self.play_start_tick) / Defs.TICK_RATE)
end

--- A game admin (server/ServerMain sets AF_Admin on their Player: the owner, or rank 254+ in the
--- owning group): "Replay as new player" shows on production too (2026-10-27).
function UICtx.admin(_self: any): boolean
	if not IS_ROBLOX then
		return false
	end
	local lp = game:GetService("Players").LocalPlayer
	return lp ~= nil and lp:GetAttribute("AF_Admin") == true
end

--- Seconds the local player's nation has been in play this match (0 before): from the first call
--- that saw it alive while the match plays, so one who joined a match under way starts at 0 too
--- (UIAdvisor.check_floor calls it every second; UIRoot clears the mark for every new match).
function UICtx.alive_seconds(self: any): number
	if self.state == nil or self.play_start_tick < 0.0 or not self:alive_player() then
		return 0.0
	end
	local now = self:render_tick()
	if self.alive_from_tick == nil then
		self.alive_from_tick = now
	end
	return math.max(0.0, (now - self.alive_from_tick) / Defs.TICK_RATE)
end

--- Multiplayer match length in seconds (Session.MP_TIME_LIMIT_S when available).
function UICtx.match_limit_s(self: any): number
	local s = self.session
	if s ~= nil then
		local v = s.MP_TIME_LIMIT_S
		if type(v) == "number" then
			return v
		end
	end
	return 2400.0
end

--- Solo only: freeze the local simulation while a modal (help, game menu) is open.
function UICtx.set_paused(self: any, on: boolean)
	if self:mode() == UICtx.MODE_SOLO then
		self:session_call("set_paused", { on })
	end
end

--- Static helper on Core/Rules when present (feature-detected; returns nil otherwise).
function UICtx.rules_call(_self: any, method: string, args: { any }?): any
	local ok, Rules = pcall(core, "Rules")
	if not ok or type(Rules) ~= "table" then
		return nil
	end
	local f = Rules[method]
	if type(f) ~= "function" then
		return nil
	end
	if args then
		return f(table.unpack(args))
	end
	return f()
end

function UICtx.render_tick(self: any): number
	local s = self.state
	if s == nil then
		return 0.0
	end
	return math.max(s.render_tick or 0, s.tick or 0)
end

-- =============================================================================================
-- World
-- =============================================================================================

function UICtx.world_call(self: any, method: string, args: { any }?): any
	local w = self.world
	if w == nil then
		return nil
	end
	local f = w[method]
	if type(f) ~= "function" then
		return nil
	end
	if args then
		return f(w, table.unpack(args))
	end
	return f(w)
end

function UICtx.set_world_input(self: any, on: boolean)
	local w = self.world
	if w == nil then
		return
	end
	if type(w.set_input_enabled) == "function" then
		w:set_input_enabled(on)
	else
		w.input_enabled = on
	end
end

--- WorldView.set_aim(kind, tile, radius_tiles, valid, detail, level): detail = what is aimed
--- ("sam", "defense", "city", "atom"...), level = the structure's level after this placement
--- (1 new, current + 1 for an upgrade).
function UICtx.set_aim(
	self: any,
	kind: string,
	tile: number,
	radius: number,
	valid: boolean?,
	detail: string?,
	level: number?
)
	self:world_call("set_aim", { kind, tile, radius, if valid == nil then true else valid, detail or "", level or 1 })
end

--- Pointer position in logical px.
function UICtx.mouse_pos(self: any): Vector2
	if self.debug_mouse.X >= 0.0 then
		return self.debug_mouse
	end
	if self.touch and self.pointer.X >= 0.0 then
		return self.pointer
	end
	if IS_ROBLOX then
		return self:to_logical(game:GetService("UserInputService"):GetMouseLocation())
	end
	return if self.pointer.X >= 0 then self.pointer else Vector2.zero
end

local _Widgets: any = nil
local function widgets(): any
	if _Widgets == nil and IS_ROBLOX then
		local ok, w = pcall(require, script.Parent:FindFirstChild("Widgets"))
		_Widgets = if ok then w else false
	end
	return _Widgets
end

--- Where the UI root's (0, 0) lies in viewport px. On notched phones the camera viewport is the
--- device safe area while our full-screen root starts left of it (Studio iPhone 13: root at
--- viewport x = -47), so every conversion goes through this origin. Refreshed by UIRoot._layout.
function UICtx.update_origin(self: any)
	local r = self.root
	if r == nil or not IS_ROBLOX then
		return
	end
	local g = r.gui
	if g ~= nil then
		self.origin = g.AbsolutePosition + game:GetService("GuiService"):GetGuiInset()
	end
end

--- Viewport px -> logical px (identity when no UI scale is active, e.g. in Lune).
function UICtx.to_logical(self: any, v: Vector2): Vector2
	local W = widgets()
	local o = self.origin or Vector2.zero
	if W and W.to_logical then
		return W.to_logical(v - o)
	end
	return v - o
end

--- Logical px -> viewport px.
function UICtx.to_view(self: any, v: Vector2): Vector2
	local W = widgets()
	local o = self.origin or Vector2.zero
	if W and W.to_view then
		return W.to_view(v) + o
	end
	return v + o
end

--- Logical Rect -> viewport Rect.
function UICtx.rect_to_view(self: any, r: Rect): Rect
	local a = self:to_view(r.Min)
	local b = self:to_view(r.Max)
	return Rect.new(a.X, a.Y, b.X, b.Y)
end

--- UI scale (viewport px per logical px).
function UICtx.ui_scale(self: any): number
	local one = self:to_view(Vector2.new(100, 0)) - self:to_view(Vector2.zero)
	return one.X / 100
end

--- A viewport-px rect in logical px.
function UICtx.rect_to_logical(self: any, r: Rect): Rect
	local a = self:to_logical(r.Min)
	local b = self:to_logical(r.Max)
	return Rect.new(a.X, a.Y, b.X, b.Y)
end

--- Tile under a LOGICAL screen point (-1 if none): WorldView.tile_at_screen in viewport px.
function UICtx.tile_at(self: any, pos: Vector2): number
	local v = self:world_call("tile_at_screen", { self:to_view(pos) })
	return if type(v) == "number" then v else -1
end

--- Screen area modals and transient pop-ups may use: inside the safe area and, on phones, below
--- the Roblox top bar row (its buttons draw above our layer).
function UICtx.clear_rect(self: any): Rect
	local ins = self.insets
	local top = math.max(ins.y, self.airship_bar.Max.Y)
	if self.compact then
		top = math.max(top, self.reserved_top_left.Max.Y)
	end
	return UICtx.rect(ins.x, top, self.vp.X - ins.x - ins.z, self.vp.Y - top - ins.w)
end

--- Where a top-centred panel of width `w` can sit at height `y` without touching the top-left
--- reserved HUD: returns dx from centre, top. Shifts right when there is room, otherwise drops the
--- panel below the top bar row.
function UICtx.place_top(self: any, w: number, y: number): (number, number)
	local margin = 8.0
	local left = (self.vp.X - w) * 0.5
	local res = self.reserved_top_left
	if y >= res.Max.Y or left >= res.Max.X + margin then
		return 0.0, y
	end
	local dx = res.Max.X + margin - left
	if left + dx + w <= self.vp.X - self.insets.z - margin then
		return dx, y
	end
	return 0.0, res.Max.Y + 4.0
end

--- Horizontal nudge for a top-centred panel of width `w` so it clears the reserved top-left area.
function UICtx.clear_of_reserved(self: any, w: number): number
	local min_left = self.reserved_top_left.Max.X + 12.0
	local left = (self.vp.X - w) * 0.5
	return math.max(0.0, min_left - left)
end

--- Screen position of a tile in LOGICAL px, (-1, -1) on the far side / without a world.
function UICtx.tile_screen_pos(self: any, tile: number): Vector2
	local v = self:world_call("screen_pos_of_tile", { tile })
	if typeof(v) ~= "Vector2" or v.X < 0 then
		return Vector2.new(-1, -1)
	end
	return self:to_logical(v)
end

-- =============================================================================================
-- Audio
-- =============================================================================================

--- `pitch`: an exact playback speed (instead of the small random jitter).
function UICtx.sfx(self: any, id: string, volume_db: number?, pitch_jitter: number?, pitch: number?)
	local a = self.audio
	if a == nil or type(a.play_sfx) ~= "function" then
		return
	end
	-- (a sound was asked for: Widgets' default button press / hover sounds stay out of its way)
	local Wm = UICtx.mod("Widgets")
	Wm.sound_serial = (Wm.sound_serial or 0) + 1
	local now = UICtx.msec()
	local gap = UICtx.SFX_GAP[id] or 60
	if now - (self._sfx_last[id] or -100000) < gap then
		return
	end
	self._sfx_last[id] = now
	local sfx_name = UICtx.SFX[id] or id
	local fb = UICtx.SFX_FALLBACK[id]
	if fb and type(a.has_sfx) == "function" and not a:has_sfx(sfx_name) then
		sfx_name = fb
	end
	a:play_sfx(sfx_name, volume_db or 0.0, if pitch_jitter == nil then 0.04 else pitch_jitter, pitch)
end

function UICtx.music_enabled(self: any): boolean
	local a = self.audio
	if a ~= nil and type(a.is_music_enabled) == "function" then
		return a:is_music_enabled() and true or false
	end
	return true
end

function UICtx.set_music(self: any, on: boolean)
	local a = self.audio
	if a ~= nil and type(a.set_music_enabled) == "function" then
		a:set_music_enabled(on)
	end
end

--- The player's music level, 0..1 (Settings slider; AudioDirector.set_music_volume).
function UICtx.music_volume(self: any): number
	local a = self.audio
	if a ~= nil and type(a.music_volume) == "function" then
		return a:music_volume()
	end
	return 1.0
end

--- `save`: write it to the saved settings (at the end of a drag).
function UICtx.set_music_volume(self: any, v: number, save: boolean?)
	local a = self.audio
	if a ~= nil and type(a.set_music_volume) == "function" then
		a:set_music_volume(v, save)
	end
end

--- The border pops (AudioDirector.pop) are on (Settings).
function UICtx.pops_enabled(self: any): boolean
	local a = self.audio
	if a ~= nil and type(a.is_pops_enabled) == "function" then
		return a:is_pops_enabled() and true or false
	end
	return true
end

function UICtx.set_pops(self: any, on: boolean)
	local a = self.audio
	if a ~= nil and type(a.set_pops_enabled) == "function" then
		a:set_pops_enabled(on)
	end
end

--- The soundtrack's mood (AudioDirector.set_music_mood).
function UICtx.set_music_mood(self: any, mood: string)
	local a = self.audio
	if a ~= nil and type(a.set_music_mood) == "function" then
		a:set_music_mood(mood)
	elseif a ~= nil and type(a.play_theme) == "function" then
		a:play_theme(if mood == "title" or mood == "wait" then "menu" else "war")
	end
end

function UICtx.play_theme(self: any, theme_name: string)
	local a = self.audio
	if a ~= nil and type(a.play_theme) == "function" then
		a:play_theme(theme_name)
	end
end

-- =============================================================================================
-- Attack ratio & settings
-- =============================================================================================

--- The most of the army any order may send now: what stands above `troop_floor` (a share of the
--- army's cap that stays at home; nil = no floor, 1). Under 2% counts as nothing (0).
function UICtx.floor_share(self: any): number
	local f = self.troop_floor
	local o = self:my()
	if f == nil or o == nil or (o.max_troops or 0) <= 0 or (o.troops or 0) <= 0 then
		return 1.0
	end
	local allowed = (o.troops - f * o.max_troops) / o.troops
	return if allowed < 0.02 then 0.0 else math.min(allowed, 1.0)
end

--- The share of the army an order sends now: the slider's, trimmed to floor_share(). 0: nothing may go.
function UICtx.order_ratio(self: any): number
	return math.min(self.ratio, self:floor_share())
end

--- The stop nearest `r` among those not above `max` (the lowest stop when none is), and its index
--- in RATIO_STOPS. Half way between two stops is the lower one.
function UICtx.ratio_stop(r: number, max: number?): (number, number)
	local stops = UICtx.RATIO_STOPS
	local top = (max or 1.0) + 1e-6
	local best = 1
	for i = 2, #stops do
		if stops[i] <= top and math.abs(stops[i] - r) < math.abs(stops[best] - r) - 1e-9 then
			best = i
		end
	end
	return stops[best], best
end

--- The Attack ratio: the stop nearest `r` that ratio_max allows.
function UICtx.set_ratio(self: any, r: number)
	local v = UICtx.ratio_stop(r, self.ratio_max)
	if math.abs(v - self.ratio) < 1e-5 then
		return
	end
	self.ratio = v
	self.ratio_changed:Fire(v)
end

--- The highest share the Attack bar gives (1: every stop). The tutorial lowers it while it runs: the
--- ratio comes down to it, and the bar is told either way (it draws the stops above the cap faint).
function UICtx.set_ratio_max(self: any, max: number)
	self.ratio_max = max
	self.ratio = UICtx.ratio_stop(self.ratio, max)
	self.ratio_changed:Fire(self.ratio)
end

--- One stop up (`dir` > 0) or down: the Q / E keys and the mouse wheel.
function UICtx.step_ratio(self: any, dir: number)
	local stops = UICtx.RATIO_STOPS
	local _, i = UICtx.ratio_stop(self.ratio, self.ratio_max)
	self:set_ratio(stops[math.clamp(i + (if dir > 0 then 1 else -1), 1, #stops)])
end

--- The Attack bar back at DEFAULT_RATIO: every match starts there (since 2026-10-08, at first at a
--- 20% troop share; the default has since become the 25% stop, see
--- RATIO_STOPS). Until then the slider's last position was saved with the settings and came back in
--- the next match, and the next session.
function UICtx.reset_ratio(self: any)
	self:set_ratio(UICtx.DEFAULT_RATIO)
end

--- Troops sent by an attack at the current ratio.
function UICtx.troops_for_ratio(self: any): number
	local o = self:my()
	return if o ~= nil then (o.troops or 0) * self:order_ratio() else 0.0
end

function UICtx.setting(self: any, key: string, default: any): any
	local v = self.settings[key]
	if v == nil then
		return default
	end
	return v
end

function UICtx.set_setting(self: any, key: string, value: any)
	self.settings[key] = value
	self:_save_later()
end

--- Loads the [ui] section through Session:load_settings("ui") when the session provides one
--- (Roblox has no client-side files: the session persists it, e.g. in a DataStore).
function UICtx._load_settings(self: any)
	local v = self:session_call("load_settings", { "ui" })
	if type(v) == "table" then
		for k, val in v do
			self.settings[k] = val
		end
	end
end

--- Re-read settings once a session is attached (UIRoot.setup).
function UICtx.reload_settings(self: any)
	self:_load_settings()
end

function UICtx._save_later(self: any)
	if self._save_pending then
		return
	end
	self._save_pending = true
	task.delay(0.6, function()
		self._save_pending = false
		self:_save_now()
	end)
end

function UICtx._save_now(self: any)
	self:session_call("save_settings", { "ui", table.clone(self.settings) })
end

-- =============================================================================================
-- Hints (hover cards anchored to controls; suppressed on touch)
-- =============================================================================================

function UICtx.show_hint(self: any, anchor: GuiObject, spec: { [string]: any }, force: boolean?)
	if self.tooltip ~= nil and (force or not self.touch) then
		self.tooltip:show_anchor(spec, anchor)
	end
end

function UICtx.hide_hint(self: any, anchor: GuiObject?)
	local tt = self.tooltip
	if tt == nil or tt.place ~= tt.Place.ANCHOR then
		return
	end
	if anchor == nil or tt:anchor_is(anchor) then
		tt:hide_tip()
	end
end

-- =============================================================================================
-- Platform
-- =============================================================================================

--- The Roblox escape menu is open (hotkeys must not act under it).
function UICtx.pause_menu_open(_self: any): boolean
	if not IS_ROBLOX then
		return false
	end
	return game:GetService("GuiService").MenuIsOpen
end

function UICtx.username(self: any): string
	if IS_ROBLOX then
		local lp = game:GetService("Players").LocalPlayer
		if lp ~= nil and lp.DisplayName ~= "" then
			return lp.DisplayName
		end
	end
	local d = self:session_call("local_display_name")
	return if type(d) == "string" and d ~= "" then d else "Commander"
end

-- =============================================================================================
-- Owners
-- =============================================================================================

--- Progress toward victory: share of the land that is not fallout (the Sim wins at
--- Rules.WIN_SHARE of contestable land minus fallout).
function UICtx.win_share(self: any, id: number): number
	local s = self.state
	if s == nil or s.map == nil then
		return 0.0
	end
	local o = s:get_owner(id)
	if o == nil then
		return 0.0
	end
	local fo = tonumber(s.fallout_count) or 0
	local denom = (s.map.contestable_count or 1) - fo
	return (o.tiles or 0) / math.max(denom, 1)
end

--- A team game: team `t`'s progress toward victory (its members' land together; Sim._check_victory).
function UICtx.team_share(self: any, t: number): number
	local s = self.state
	if s == nil or s.map == nil or t == 0 then
		return 0.0
	end
	local tiles = 0
	for _, o in s.owners do
		if o.team == t and o.alive then
			tiles += o.tiles or 0
		end
	end
	local fo = tonumber(s.fallout_count) or 0
	return tiles / math.max((s.map.contestable_count or 1) - fo, 1)
end

--- A team game: the team's name as players read it ("Red team", "Team 3", "Humans").
function UICtx.team_label(self: any, t: number): string
	local s = self.state
	local n = if s ~= nil and type(s.team_name) == "function" then s:team_name(t) else ""
	if n == "" then
		return ""
	end
	if string.sub(n, 1, 5) == "Team " or n == "Humans" or n == "Nations" then
		return n
	end
	return n .. " team"
end

--- "You", "Teammate", "Ally", "Traitor", "At war", "Neutral".
function UICtx.relation(self: any, id: number): string
	local s = self.state
	if s == nil or id == 0 then
		return ""
	end
	if id == self:me() then
		return "You"
	end
	if type(s.same_team) == "function" and s:same_team(self:me(), id) then
		return "Teammate"
	end
	if s:are_allies(self:me(), id) then
		return "Ally"
	end
	if s:is_traitor(id) then
		return "Traitor"
	end
	if self:at_war(id) then
		return "At war"
	end
	return "Neutral"
end

function UICtx.relation_color(_self: any, rel: string): Color3
	local T = UICtx.mod("UITheme")
	if rel == "You" then
		return T.AMBER
	elseif rel == "Ally" or rel == "Teammate" then
		return T.GREEN
	elseif rel == "Traitor" then
		return T.RED
	elseif rel == "At war" then
		return T.ORANGE
	end
	return T.TEXT_2
end

function UICtx.at_war(self: any, id: number): boolean
	local s = self.state
	local me = self:me()
	if s == nil or me == 0 then
		return false
	end
	for _, a in s.attacks do
		if (a.attacker == me and a.target == id) or (a.attacker == id and a.target == me) then
			return true
		end
	end
	return false
end

function UICtx.kind_title(_self: any, kind: number): string
	if kind == Defs.KIND_TRIBE then
		return "Tribe"
	elseif kind == Defs.KIND_HUMAN then
		return "Commander"
	end
	return "Nation"
end

function UICtx.terrain_at(self: any, tile: number): number
	local map = self.state.map
	if type(map.terrain_at) == "function" then
		return map:terrain_at(tile)
	end
	return UICtx.u8(map.terrain, tile)
end

function UICtx.terrain_title(self: any, tile: number): string
	local s = self.state
	if s == nil or tile < 0 then
		return ""
	end
	if s:has_fallout(tile) then
		return "Fallout"
	end
	local t = self:terrain_at(tile)
	if t == Defs.T_OCEAN then
		return "Ocean"
	elseif t == Defs.T_LAKE then
		return "Lake"
	elseif t == Defs.T_PLAINS then
		return "Plains"
	elseif t == Defs.T_HIGHLAND then
		return "Highland"
	elseif t == Defs.T_MOUNTAIN then
		return "Mountains"
	elseif t == Defs.T_TUNDRA then
		return "Tundra"
	elseif t == Defs.T_ICECAP then
		return "Ice cap"
	end
	return ""
end

--- Structure within `radius` tiles of `tile` (exact tile first), or nil. Ties go to the oldest
--- structure (the GDScript dictionary iterated in insertion order).
function UICtx.structure_at(self: any, tile: number, radius: number?): any
	local s = self.state
	if s == nil or tile < 0 then
		return nil
	end
	local r = radius or 1
	local W = if s.map then s.map.W else Defs.W
	local tx = tile % W
	local ty = tile // W
	local best = nil
	local best_d = 2 ^ 30
	for _, st in s.structures do
		local dx = math.abs(st.tile % W - tx)
		local dy = math.abs(st.tile // W - ty)
		local d = math.max(dx, dy)
		if d <= r and (d < best_d or (d == best_d and best ~= nil and st.sid < best.sid)) then
			best = st
			best_d = d
		end
	end
	return best
end

return UICtx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="231">
            <Properties>
              <string name="Name">UIInteract</string>
              <string name="Source"><![CDATA[-- Port of scripts/ui/ui_interact.gd
-- Globe interaction for the HUD: hover tooltips and previews, primary clicks (spawn / expand /
-- attack / boat / inspect), build & nuke placement mode, the radial context menu and its actions,
-- and the keyboard / wheel / touch detection (hotkeys: H, L, Esc, Space, Backspace, Q/E, 1-0;
-- M / Home live in Main).
--
-- Input: UserInputService events, respecting gameProcessedEvent (chat typing never triggers a
-- hotkey). Positions are viewport coordinates (see UICtx).

local UICtx = require("./UICtx") :: any
local UIRules = require("./UIRules") :: any
local Defs = UICtx.core("Defs")

local _T: any = nil
local function T(): any
	if _T == nil then
		_T = UICtx.mod("UITheme")
	end
	return _T
end
local _FT: any = nil
local function FloatText(): any
	if _FT == nil then
		_FT = UICtx.mod("FloatText")
	end
	return _FT
end

local UIInteract = {}
UIInteract.__index = UIInteract

-- One physical tap can reach us twice (a platform that reports both mouse and touch); identical
-- globe clicks inside this window are ignored.
UIInteract.DUP_MS = 180
--- Touch taps sample a ring this wide (logical px) around the finger; the mouse a small one.
UIInteract.PICK_TOUCH_PX = 22.0
UIInteract.PICK_MOUSE_PX = 6.0
--- Touch / mouse radius (px) for picking a warship.
UIInteract.UNIT_PICK_TOUCH = 26.0
UIInteract.UNIT_PICK_MOUSE = 12.0
--- Q / E held: key repeat like the OS (initial delay, then a steady rate).
UIInteract.REPEAT_DELAY = 0.45
UIInteract.REPEAT_RATE = 1.0 / 25.0

local TAU = 2 * math.pi

function UIInteract.new(c: any)
	local self = setmetatable({}, UIInteract)
	self.ctx = c
	self.bar = nil :: any
	self.tooltip = nil :: any
	self.radial = nil :: any
	self.float_layer = nil :: any
	self.ui = nil :: any
	self.target_card = nil :: any
	self.place_confirm = nil :: any
	self.unit_card = nil :: any
	--- Current placement kind ("" = none): a structure, "warship" or a nuke.
	self.aim_kind = ""
	self.hover_tile = -1
	self.enabled = false

	self._confirm_tile = -1
	--- The tile the last globe tap resolved to (tests / diagnostics).
	self.last_pick = -1
	-- Touch placement ghost: the resolved tile, the screen point it was picked at (a map drag
	-- under it moves the ghost) and the raw tile last seen there.
	self._ghost_tile = -1
	self._ghost_anchor = Vector2.new(-1, -1)
	self._ghost_raw = -1
	self._ghost_hit = -1
	self._ghost_res = {}
	--- Tile whose SAM / post rings the inspect card is showing (-1 = none).
	self._range_focus = -1
	self._last_click_msec = -100000
	self._last_click_tile = -2
	self._last_ctx_msec = -100000
	self._confirm_msec = 0
	self._tip_accum = 0.0
	self._tip_dirty = false
	self._tip_wait = 0.0
	self._conns = {} :: { any }
	-- Held Q / E: keycode -> {t = seconds held, next = next repeat time}
	self._held = {} :: { [any]: { t: number, next: number } }
	return self
end

-- ---------------------------------------------------------------------------------------------
-- Placement mode
-- ---------------------------------------------------------------------------------------------

function UIInteract.select_action(self: any, kind: string)
	local ctx = self.ctx
	if not self.enabled or not ctx:alive_player() then
		return
	end
	local b = self.bar:button(kind)
	local av = ctx.rules:availability(kind)
	if av.arsenal ~= nil then
		-- an Arsenal unit the player hasn't unlocked: the Arsenal opens on it
		ctx:sfx("locked")
		if self.ui ~= nil and type(self.ui.open_arsenal) == "function" then
			self.ui:open_arsenal(av.arsenal, "locked")
		end
		return
	end
	if not av.ok then
		if b ~= nil then
			b:deny()
		end
		ctx:sfx("deny")
		self:_float(tostring(av.reason), "info", T().RED, self:_anchor_pos(b))
		return
	end
	if kind == "reinforce" then
		-- the Arsenal's Reinforcements: an order, not a placement
		self:cancel_aim(false)
		ctx:send({ type = "reinforce" })
		ctx:sfx("confirm")
		return
	end
	if self.aim_kind == kind then
		self:cancel_aim()
		return
	end
	self.aim_kind = kind
	self._confirm_tile = -1
	self:_clear_ghost()
	if self.target_card ~= nil then
		self.target_card:hide_card()
	end
	-- Aiming a nuke shows every hostile SAM's coverage.
	ctx:world_call("set_range_mode", { if UIRules.is_nuke(kind) then "nuke_aim" else "auto" })
	self.bar:set_placing(kind)
	ctx:hide_hint()
	ctx:sfx("click")
	self:on_hover(self.hover_tile)
end

function UIInteract.cancel_aim(self: any, play_sound: boolean?)
	if self.aim_kind == "" then
		return
	end
	local ctx = self.ctx
	local was_mirv = self.aim_kind == "mirv"
	self.aim_kind = ""
	self._confirm_tile = -1
	self:_clear_ghost()
	self.bar:set_placing("")
	ctx:set_aim("", -1, 0)
	ctx:world_call("set_range_mode", { "auto" })
	if was_mirv then
		ctx:world_call("set_selected_owner", { 0 })
	end
	if play_sound ~= false then
		ctx:sfx("close", -6.0)
	end
	self:on_hover(self.hover_tile)
end

function UIInteract._anchor_pos(self: any, c: any): Vector2
	if c ~= nil and type(c) == "table" and c.get_global_rect ~= nil and not c._freed and c:is_visible_in_tree() then
		local r = c:get_global_rect()
		return Vector2.new(UICtx.rect_center(r).X, r.Min.Y)
	end
	return self.ctx:mouse_pos()
end

-- ---------------------------------------------------------------------------------------------
-- World signals
-- ---------------------------------------------------------------------------------------------

function UIInteract.on_hover(self: any, tile: number)
	local ctx = self.ctx
	local tooltip = self.tooltip
	self.hover_tile = tile
	if not self.enabled or ctx.state == nil then
		ctx:world_call("set_hover_owner", { 0 })
		if tooltip.place == tooltip.Place.FOLLOW then
			tooltip:hide_tip()
		end
		return
	end
	local s = ctx.state
	local own = if tile >= 0 then s:tile_owner(tile) else 0
	ctx:world_call("set_hover_owner", { own })
	-- Placement preview (the view draws blast radii, hostile SAM cover and SAM / post range rings
	-- from the detail; an invalid spot shows the preview greyed).
	if self.aim_kind ~= "" then
		if ctx.touch then
			if self._ghost_tile < 0 then
				ctx:set_aim("", -1, 0, false) -- touch: nothing to preview until the first tap
			end
			-- else the ghost only moves on a tap or a map drag (process_frame)
		else
			local locked = self._confirm_tile >= 0 and self:_locks_target(self.aim_kind)
			local t = if locked then self._confirm_tile else tile
			if t >= 0 then
				self:_show_aim(t, ctx.rules:placement(self.aim_kind, t), locked)
			else
				ctx:set_aim("", -1, 0, false)
			end
		end
	end
	-- The hover card is rebuilt at most ~16x per second (its hint may flood-fill the map).
	self._tip_dirty = true
	if self._tip_wait <= 0.0 then
		self._tip_wait = 0.06
		self._tip_dirty = false
		self:_update_tooltip()
	end
end

function UIInteract._update_tooltip(self: any)
	local tooltip = self.tooltip
	local P = tooltip.Place
	if tooltip.place == P.PINNED and tooltip:is_shown() then
		return
	end
	if tooltip.place == P.ANCHOR and tooltip:is_shown() then
		return
	end
	if self.ctx.touch or self.radial.is_open or not self.enabled then
		if tooltip.place == P.FOLLOW then
			tooltip:hide_tip()
		end
		return
	end
	local spec = self:hover_spec(self.hover_tile)
	if next(spec) == nil then
		tooltip:hide_tip()
	else
		tooltip:show_follow(spec)
	end
end

function UIInteract.on_click(self: any, tile: number)
	local ctx = self.ctx
	if not self.enabled or ctx.state == nil then
		return
	end
	local now = UICtx.msec()
	if tile == self._last_click_tile and now - self._last_click_msec < UIInteract.DUP_MS then
		return
	end
	self._last_click_tile = tile
	self._last_click_msec = now
	if self.radial.is_open then
		self.radial:close()
		return
	end
	local pos = self:tap_pos(tile)
	local unit_card = self.unit_card
	-- Warships: a tap on one selects it; with your own selected, a tap on the sea moves it there and
	-- any other tap just deselects (never also an order).
	if self.aim_kind == "" then
		-- On land a ship must be right under the finger (land taps near a coast stay land orders);
		-- with your own ship selected, sea taps are move orders unless another ship is right there.
		local on_land = tile >= 0 and ctx.state.map:is_land(tile)
		local steering = unit_card ~= nil and unit_card.is_open and unit_card.own and not on_land
		local uid = self:unit_at(pos, if on_land or steering then 12.0 else -1.0)
		if uid ~= 0 and not (steering and uid == unit_card.uid) then
			self:select_unit(uid)
			return
		end
		if unit_card ~= nil and unit_card.is_open then
			if unit_card.own and tile >= 0 and ctx.state.map:is_water(tile) then
				self:_move_selected(tile, pos)
			else
				self:deselect_unit(true)
			end
			return
		end
	end
	tile = self:pick(tile, pos)
	self.last_pick = tile
	if self.aim_kind ~= "" then
		self:_place(tile, pos)
		return
	end
	local act = ctx.rules:primary(tile)
	local kind = tostring(act.type)
	local selectable = (kind == "attack" or kind == "boat") and act.ok
	-- Touch: an ally's land opens their card (Donate / Break alliance) instead of a bare info card.
	local ally_own = if ctx.touch then self:_ally_at(tile) else 0
	local target_card = self.target_card
	local tooltip = self.tooltip
	-- A target card is up: tapping the same target again fires; anything else just changes or
	-- closes the selection (a "tap elsewhere to close" must never also give an order).
	if target_card ~= nil and target_card.is_open then
		if selectable and target_card:matches(tile, kind) then
			self:_fire_selected(pos)
			return
		end
		local same_ally = ally_own ~= 0 and target_card.kind == "ally" and target_card.owner_id == ally_own
		target_card:hide_card()
		if ally_own ~= 0 and not same_ally then
			self:_select(tile, "ally", act)
		elseif selectable and self:confirm_orders() then
			self:_select(tile, kind, act)
		end
		return
	end
	if ally_own ~= 0 then
		tooltip:hide_tip()
		self:_select(tile, "ally", act)
		return
	end
	if tooltip.place == tooltip.Place.PINNED and tooltip:is_shown() then
		tooltip:hide_tip()
		if ctx.touch then
			return
		end
	end
	if selectable and self:confirm_orders() then
		self:_select(tile, kind, act)
		return
	end
	if kind == "inspect" then
		local own = ctx.state:tile_owner(tile)
		ctx:world_call("set_selected_owner", { own })
		if ctx.touch and own ~= 0 then
			self:show_inspect(tile)
		end
		return
	end
	if kind == "none" or not act.ok then
		local reason = tostring(act.reason)
		if reason ~= "" then
			ctx:sfx("deny", -4.0)
			self:_float(reason, "info", T().TEXT_2, pos)
		end
		if act.floor == true then
			ctx.floor_held:Fire()
		end
		return
	end
	local intent = ctx.rules:primary_intent(tile, act)
	if next(intent) == nil then
		return
	end
	ctx:send(intent)
	local coach = ctx.coach
	if coach ~= nil then
		if kind == "expand" then
			coach:complete("expand")
		elseif kind == "attack" then
			coach:complete("expand")
			coach:complete("contact")
		elseif kind == "boat" then
			coach:complete("boat")
		end
	end
	if kind == "spawn" then
		ctx:sfx("spawn")
	elseif kind == "expand" then
		self:_float(ctx.rules:confirm_text(act), "attack", T().GREEN, pos)
	elseif kind == "attack" then
		self:_float(ctx.rules:confirm_text(act), "attack", T().AMBER, pos)
	elseif kind == "boat" then
		self:_float(ctx.rules:confirm_text(act), "boat", T().CYAN, pos)
	end
end

--- Touch plays "look before you act": attacks and boat invasions need a selection first.
--- Desktop keeps one-click orders unless the player turns "Confirm attacks" on.
function UIInteract.confirm_orders(self: any): boolean
	local ctx = self.ctx
	if ctx.touch then
		return ctx:setting("confirm_orders", ctx.touch_device or ctx.touch) and true or false
	end
	return ctx:setting("confirm_orders_desktop", false) and true or false
end

function UIInteract._select(self: any, tile: number, kind: string, act: { [string]: any })
	local ctx = self.ctx
	if self.target_card == nil then
		return
	end
	self.target_card:show_target(tile, kind, act)
	local own = ctx.state:tile_owner(tile)
	ctx:world_call("set_selected_owner", { own })
	-- Show the target's defense posts (their protection radius) while sizing them up.
	if own ~= 0 and kind ~= "ally" then
		ctx:world_call("set_range_owner", { own })
		ctx:world_call("set_range_mode", { "attack_aim" })
	end
	-- A tapped SAM / post shows its own ring (the view ignores tiles without one).
	self._range_focus = tile
	ctx:world_call("set_range_focus", { tile })
	if ctx.coach ~= nil then
		ctx.coach:offer("select")
	end
end

function UIInteract._fire_selected(self: any, pos: Vector2)
	local ctx = self.ctx
	local tc = self.target_card
	local t = tc.tile
	local k = tc.kind
	tc:hide_card()
	ctx:world_call("set_selected_owner", { 0 })
	local act = ctx.rules:primary(t)
	if tostring(act.type) == "none" or not act.ok then
		ctx:sfx("deny", -4.0)
		local r = tostring(act.reason)
		self:_float(if r ~= "" then r else "Target out of reach", "info", T().TEXT_2, pos)
		if act.floor == true then
			ctx.floor_held:Fire()
		end
		return
	end
	if tostring(act.type) ~= k and not (k == "attack" and tostring(act.type) == "expand") then
		act.type = k
	end
	local intent = ctx.rules:primary_intent(t, act)
	if next(intent) == nil then
		return
	end
	ctx:send(intent)
	if ctx.coach ~= nil then
		ctx.coach:complete("select")
		ctx.coach:complete("contact")
		if k == "boat" then
			ctx.coach:complete("boat")
		end
	end
	self:_float(
		ctx.rules:confirm_text(act),
		if k == "attack" then "attack" else "boat",
		if k == "attack" then T().AMBER else T().CYAN,
		pos
	)
end

function UIInteract.fire_from_card(self: any)
	local tc = self.target_card
	if tc == nil or not tc.is_open then
		return
	end
	local p = self.ctx:tile_screen_pos(tc.tile)
	self:_fire_selected(if p.X >= 0.0 then p else UICtx.rect_center(tc:panel_rect()))
end

--- The alliance partner owning `tile` while playing (0 = none).
function UIInteract._ally_at(self: any, tile: number): number
	local ctx = self.ctx
	local s = ctx.state
	if s == nil or tile < 0 or s.phase ~= Defs.PHASE_PLAYING or not ctx:alive_player() then
		return 0
	end
	local own = s:tile_owner(tile)
	return if own ~= 0 and own ~= ctx:me() and s:are_allies(ctx:me(), own) then own else 0
end

--- Break alliance from the ally card's confirmation; `attack` also sends an attack on them (the
--- Sim handles intents in order, so the attack lands on a former ally).
function UIInteract.betray_from_card(self: any, attack: boolean)
	local ctx = self.ctx
	local tc = self.target_card
	if tc == nil or not tc.is_open or tc.owner_id == 0 then
		return
	end
	local own = tc.owner_id
	local t = tc.tile
	local p = ctx:tile_screen_pos(t)
	tc:hide_card()
	ctx:world_call("set_selected_owner", { 0 })
	ctx:send({ type = "ally_break", target = own })
	ctx:sfx("deny", -2.0)
	local at = if p.X >= 0.0 then p else ctx:mouse_pos()
	if attack and ctx:troops_for_ratio() >= 1.0 then
		local land = ctx.borders:borders_owner(own)
		local landing = if land then -1 else ctx.rules:boat_landing(t)
		ctx:send({
			type = if land then "attack" else "boat",
			tile = if landing >= 0 then landing else t,
			ratio = ctx:order_ratio(),
		})
		self:_float(
			string.format(
				"You betrayed %s · attacking with %s",
				ctx.state:owner_name(own),
				T().fmt_troops(ctx:troops_for_ratio())
			),
			"betray",
			T().RED,
			at
		)
	else
		self:_float("You broke your alliance with " .. ctx.state:owner_name(own), "betray", T().RED, at)
	end
end

function UIInteract.donate_from_card(self: any)
	local ctx = self.ctx
	local tc = self.target_card
	if tc == nil or not tc.is_open or tc.owner_id == 0 then
		return
	end
	local own = tc.owner_id
	local p = ctx:tile_screen_pos(tc.tile)
	if self:donate_to(own, if p.X >= 0.0 then p else ctx:mouse_pos()) then
		tc:hide_card()
		ctx:world_call("set_selected_owner", { 0 })
	end
end

--- Send troops to ally `own` (ratio share, capped at their troop headroom; see UIRules.donate_plan)
--- with a float at `pos`. False (and a deny float) when nothing useful can be sent.
function UIInteract.donate_to(self: any, own: number, pos: Vector2): boolean
	local ctx = self.ctx
	local plan = ctx.rules:donate_plan(own)
	local name = ctx.state:owner_name(own)
	if plan.want < 1 or plan.full or plan.amount < 1 then
		ctx:sfx("deny", -4.0)
		self:_float(
			if plan.want < 1 then "No troops to spare" else name .. " is at its troop cap",
			"info",
			T().RED,
			pos
		)
		return false
	end
	ctx:send({ type = "donate", target = own, troops = plan.amount })
	self:_float(
		if plan.capped
			then string.format("Sent %s troops  ·  %s is now at its troop cap", T().fmt_troops(plan.amount), name)
			else string.format("Sent %s troops to %s", T().fmt_troops(plan.amount), name),
		"donate",
		T().GREEN,
		pos
	)
	return true
end

function UIInteract.ally_from_card(self: any)
	local ctx = self.ctx
	local tc = self.target_card
	if tc == nil or not tc.is_open or tc.owner_id == 0 then
		return
	end
	local own = tc.owner_id
	tc:hide_card()
	ctx:world_call("set_selected_owner", { 0 })
	ctx:send({ type = "ally_request", target = own })
	self:_float("Alliance proposed to " .. ctx.state:owner_name(own), "alliance", T().VIOLET, ctx:mouse_pos())
end

function UIInteract.on_context(self: any, tile: number, screen_pos: Vector2)
	local ctx = self.ctx
	if not self.enabled or ctx.state == nil then
		return
	end
	local now = UICtx.msec()
	if now - self._last_ctx_msec < 350 then
		return
	end
	self._last_ctx_msec = now
	if self.aim_kind ~= "" then
		self:cancel_aim()
		return
	end
	tile = self:pick(tile, screen_pos)
	if tile < 0 then
		return
	end
	if self.target_card ~= nil and self.target_card.is_open then
		self.target_card:hide_card()
	end
	local s = ctx.state
	if s.phase == Defs.PHASE_SPAWN then
		return
	end
	self.tooltip:hide_tip()
	local own = s:tile_owner(tile)
	local title = ctx:terrain_title(tile)
	local col = T().TEXT_2
	if own ~= 0 then
		title = s:owner_name(own)
		col = T().owner_ui_color(UICtx.color3(s:owner_color(own)))
	elseif s.map:is_contestable(tile) then
		title = "Unclaimed " .. string.lower(ctx:terrain_title(tile))
	end
	self.radial:open_at(tile, screen_pos, ctx.rules:radial_items(tile), title, col)
end

--- Space bar: primary action at the hovered tile.
function UIInteract.primary_at_hover(self: any)
	if self.hover_tile >= 0 then
		self:on_click(self.hover_tile)
	end
end

-- ---------------------------------------------------------------------------------------------
-- Actions
-- ---------------------------------------------------------------------------------------------

local function shift_down(): boolean
	if not UICtx.IS_ROBLOX then
		return false
	end
	local UIS = game:GetService("UserInputService")
	return UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
end

function UIInteract._place(self: any, tile: number, pos: Vector2)
	local ctx = self.ctx
	local kind = self.aim_kind
	local av = ctx.rules:availability(kind)
	if not av.ok then
		ctx:sfx("deny")
		self:_float(tostring(av.reason), "info", T().RED, pos)
		self:cancel_aim(false)
		return
	end
	if ctx.touch and self.place_confirm ~= nil then
		-- Touch: a tap only moves the ghost; the floating ✓ builds / launches.
		self:_move_ghost(tile, pos)
		return
	end
	local pl = ctx.rules:placement(kind, tile)
	if not pl.ok then
		ctx:sfx("deny", -4.0)
		self:_float(tostring(pl.reason), "info", T().RED, pos)
		return
	end
	if pl.tile ~= nil then
		tile = pl.tile -- the snapped site / the structure an upgrade applies to
	end
	if UIRules.is_nuke(kind) then
		local now = UICtx.msec()
		local confirmed = self._confirm_tile >= 0
			and now - self._confirm_msec < 6000
			and Defs.tile_distance(self._confirm_tile, tile) <= 6.0
		-- a strike (an Air Strike, a Railgun shot) is free and reloads: one click fires it
		if UIRules.is_strike(kind) then
			confirmed = true
			self._confirm_tile = tile
		end
		if not confirmed then
			self._confirm_tile = tile
			self._confirm_msec = now
			ctx:sfx("click")
			local what = UIRules.TITLES[kind]
			self:on_hover(tile)
			local n_sam = tonumber(ctx:world_call("aim_sams")) or 0
			local verb = if ctx.touch then "Tap" else "Click"
			if n_sam > 0 and kind ~= "mirv" then
				self:_float(
					string.format(
						"Target inside %d enemy SAM%s: the %s may be shot down. %s again to launch",
						n_sam,
						if n_sam == 1 then "" else "s",
						what,
						verb
					),
					"sam",
					T().RED,
					pos
				)
			else
				self:_float(
					string.format("Target locked. %s again to launch the %s", verb, what),
					"target",
					T().RED,
					pos
				)
			end
			return
		end
		ctx:send({ type = "nuke", kind = kind, tile = self._confirm_tile })
		self:_float(UIRules.TITLES[kind] .. " launched", kind, T().RED, pos)
		self:cancel_aim(false)
		return
	end
	self:_send_build(kind, tile, pl, pos)
	if not shift_down() then
		self:cancel_aim(false)
	end
end

function UIInteract._send_build(self: any, kind: string, tile: number, pl: { [string]: any }, pos: Vector2)
	local ctx = self.ctx
	local av = ctx.rules:availability(kind)
	ctx:send({ type = "build", kind = kind, tile = tile })
	if kind == "city" and ctx.coach ~= nil then
		ctx.coach:complete("city")
	end
	local title = UIRules.TITLES[kind]
	if pl.upgrade then
		self:_float(
			string.format("%s upgraded to Lv %d  ·  %s gold", title, tonumber(pl.level) or 2, T().fmt_cost(av.cost)),
			kind,
			T().GOLD,
			pos
		)
	else
		self:_float(string.format("%s  ·  %s gold", title, T().fmt_cost(av.cost)), kind, T().GOLD, pos)
	end
end

--- Preview on the globe for `kind` at `t` given its placement result (snapped site, upgrade level).
function UIInteract._show_aim(self: any, t: number, pl: { [string]: any }, locked: boolean?)
	local ctx = self.ctx
	local nuke = UIRules.is_nuke(self.aim_kind)
	local ok = locked or (pl.ok == true)
	local at = if ok then (tonumber(pl.tile) or t) else t
	local radius = if nuke then UIRules.nuke_radius(self.aim_kind) else 0
	if self.aim_kind == "mirv" then
		-- The MIRV rains over the whole target nation: highlight it instead of a huge circle.
		radius = 0
		ctx:world_call("set_selected_owner", { if ok then ctx.state:tile_owner(at) else 0 })
	end
	ctx:set_aim(if nuke then "nuke" else "build", at, radius, ok, self.aim_kind, tonumber(pl.level) or 1)
end

--- Touch: put the ghost where a tap at `tile` really builds / aims, with ✓ / ✕ beside it.
function UIInteract._move_ghost(self: any, tile: number, pos: Vector2, quiet: boolean?)
	local ctx = self.ctx
	local kind = self.aim_kind
	local pl = ctx.rules:placement(kind, tile)
	self._ghost_anchor = pos
	self._ghost_raw = tile
	self._ghost_hit = ctx:tile_at(pos)
	self._ghost_res = pl
	local ok = pl.ok == true
	local moved_to = if ok then (tonumber(pl.tile) or tile) else tile
	local changed = moved_to ~= self._ghost_tile
	self._ghost_tile = moved_to
	self:_show_aim(self._ghost_tile, pl)
	self.place_confirm:show_for(self._ghost_tile, self:_ghost_caption(kind, pl), UIRules.is_nuke(kind), ok)
	if not quiet or changed then
		ctx:sfx(if ok then "click" else "deny", -8.0)
	end
end

function UIInteract._ghost_caption(self: any, kind: string, pl: { [string]: any }): string
	local ctx = self.ctx
	local title = UIRules.TITLES[kind]
	if not pl.ok then
		local r = pl.reason
		return if r ~= nil and r ~= "" then tostring(r) else "Can't place here"
	end
	local cost = T().fmt_cost(ctx.rules:availability(kind).cost)
	if pl.upgrade then
		return string.format("Upgrade %s → Lv %d · %s", UIRules.SHORT[kind], tonumber(pl.level) or 2, cost)
	end
	if kind == "warship" then
		return "Warship patrols here · " .. cost
	end
	if UIRules.is_nuke(kind) then
		local n_sam = tonumber(ctx:world_call("aim_sams")) or 0
		if n_sam > 0 and kind ~= "mirv" then
			return string.format("%d SAM%s cover this target", n_sam, if n_sam == 1 then "" else "s")
		end
		return string.format("Launch %s · %s", UIRules.SHORT[kind], cost)
	end
	return string.format("%s · %s", title, cost)
end

--- ✓ on the touch confirm: build / launch at the ghost.
function UIInteract.confirm_ghost(self: any)
	local ctx = self.ctx
	if self.aim_kind == "" or self._ghost_tile < 0 then
		return
	end
	local kind = self.aim_kind
	local pos = ctx:tile_screen_pos(self._ghost_tile)
	local at = if pos.X >= 0.0 then pos else ctx:mouse_pos()
	local av = ctx.rules:availability(kind)
	if not av.ok then
		ctx:sfx("deny")
		self:_float(tostring(av.reason), "info", T().RED, at)
		return
	end
	-- Re-check at the moment of the tap (the world moved on since the ghost was placed).
	local pl = ctx.rules:placement(kind, if not UIRules.is_nuke(kind) then self._ghost_raw else self._ghost_tile)
	if not pl.ok then
		ctx:sfx("deny", -4.0)
		self:_float(tostring(pl.reason), "info", T().RED, at)
		self:_move_ghost(self._ghost_raw, self._ghost_anchor)
		return
	end
	if UIRules.is_nuke(kind) then
		ctx:send({ type = "nuke", kind = kind, tile = self._ghost_tile })
		self:_float(UIRules.TITLES[kind] .. " launched", kind, T().RED, at)
	else
		self:_send_build(kind, tonumber(pl.tile) or self._ghost_tile, pl, at)
	end
	self:cancel_aim(false)
end

function UIInteract._clear_ghost(self: any)
	self._ghost_tile = -1
	self._ghost_raw = -1
	self._ghost_anchor = Vector2.new(-1, -1)
	self._ghost_res = {}
	if self.place_confirm ~= nil then
		self.place_confirm:hide_confirm()
	end
end

--- A map drag under the ghost's screen point moves the ghost with it (fine positioning).
function UIInteract._follow_ghost(self: any)
	if self._ghost_tile < 0 or self.aim_kind == "" or self._ghost_anchor.X < 0.0 then
		return
	end
	local t = self.ctx:tile_at(self._ghost_anchor)
	if t < 0 or t == self._ghost_hit then
		return
	end
	self:_move_ghost(self:pick(t, self._ghost_anchor), self._ghost_anchor, true)
end

-- ---------------------------------------------------------------------------------------------
-- Warships
-- ---------------------------------------------------------------------------------------------

--- Warship under screen `pos` (0 = none): WorldView.unit_at_screen when the view has it, else the
--- nearest warship whose tile projects within the pick radius.
function UIInteract.unit_at(self: any, pos: Vector2, radius: number?): number
	local ctx = self.ctx
	local s = ctx.state
	if s == nil then
		return 0
	end
	local rad = radius or -1.0
	local w = ctx.world
	if w ~= nil and type(w.unit_at_screen) == "function" then
		local v = ctx:world_call("unit_at_screen", { ctx:to_view(pos), if rad > 0 then rad * ctx:ui_scale() else rad })
		local u0 = if type(v) == "number" then s.units[v] else nil
		if u0 ~= nil and u0.kind == Defs.U_WARSHIP then
			return u0.uid
		end
		-- The view only knows ships it has drawn: fall through to the mirror (e.g. just launched).
	end
	local r = if rad > 0.0 then rad else (if ctx.touch then UIInteract.UNIT_PICK_TOUCH else UIInteract.UNIT_PICK_MOUSE)
	local best = 0
	local bd = r * r
	for _, u in s.units do
		if u.kind ~= Defs.U_WARSHIP or u.path == nil or #u.path == 0 then
			continue
		end
		local p = ctx:tile_screen_pos(u.path[1])
		if p.X < 0.0 then
			continue
		end
		local d = (p - pos).Magnitude
		d *= d
		if d <= bd and (d < bd or best == 0 or u.uid < best) then
			bd = d
			best = u.uid
		end
	end
	return best
end

function UIInteract.select_unit(self: any, uid: number)
	if self.target_card ~= nil then
		self.target_card:hide_card()
	end
	self.tooltip:hide_tip()
	self.unit_card:show_unit(uid)
	self.ctx:world_call("set_selected_unit", { uid })
end

function UIInteract.deselect_unit(self: any, user: boolean?)
	if self.unit_card ~= nil and self.unit_card.is_open then
		self.unit_card:hide_card(user)
	end
	self.ctx:world_call("set_selected_unit", { -1 })
end

function UIInteract._move_selected(self: any, tile: number, pos: Vector2)
	local ctx = self.ctx
	local uid = self.unit_card.uid
	ctx:send({ type = "move_warship", uid = uid, tile = tile })
	self.unit_card:mark_destination(tile)
	ctx:sfx("click", -4.0)
	self:_float("Warship moving", "warship", T().CYAN, pos)
end

-- ---------------------------------------------------------------------------------------------
-- Forgiving picking
-- ---------------------------------------------------------------------------------------------

--- Screen point of the tap that hit `tile`: the pointer when it agrees with the hit, else the
--- tile's centre.
function UIInteract.tap_pos(self: any, tile: number): Vector2
	local ctx = self.ctx
	local pos = ctx:mouse_pos()
	if ctx:tile_at(pos) == tile then
		return pos
	end
	local c = ctx:tile_screen_pos(tile)
	return if c.X >= 0.0 then c else pos
end

--- The tile a tap at screen `pos` (which hit `tile`) means in the current context:
---   * placing a structure -> the nearest of the player's own land tiles;
---   * nukes / warships -> exactly what was hit;
---   * everything else (spawn, expand, attack, boat, inspect) -> the tile under the finger when it
---     is contestable land, else the nearest contestable land (small islands, crisp coastlines that
---     are water on the tile grid), preferring the owner of the land under the finger.
function UIInteract.pick(self: any, tile: number, pos: Vector2): number
	local ctx = self.ctx
	local s = ctx.state
	if s == nil or ctx.world == nil then
		return tile
	end
	local map = s.map
	if self.aim_kind ~= "" and (UIRules.is_nuke(self.aim_kind) or self.aim_kind == "warship") then
		return tile
	end
	-- The pointer position must belong to this tap (else fall back to the tile's centre).
	if ctx:tile_at(pos) ~= tile then
		local c = ctx:tile_screen_pos(tile)
		if c.X >= 0.0 then
			pos = c
		end
	end
	local own_build = self.aim_kind ~= ""
	local me = ctx:me()
	local function good(t: number): boolean
		if t < 0 then
			return false
		end
		if own_build then
			return s:tile_owner(t) == me and map:is_land(t)
		end
		return map:is_contestable(t)
	end
	if good(tile) then
		return tile
	end
	local r_max = if ctx.touch then UIInteract.PICK_TOUCH_PX else UIInteract.PICK_MOUSE_PX
	local prefer_owner = if tile >= 0 and map:is_land(tile) then s:tile_owner(tile) else -1
	local best = -1
	local best_score = math.huge
	local rings = { r_max }
	if ctx.touch then
		rings = { r_max * 0.35, r_max * 0.7, r_max }
	end
	for _, r in rings do
		local n = if r < 10.0 then 8 elseif r < 18.0 then 12 else 16
		for i = 0, n - 1 do
			local a = TAU * i / n
			local q = pos + Vector2.new(math.cos(a), math.sin(a)) * r
			local t = ctx:tile_at(q)
			if not good(t) then
				continue
			end
			local score = r
			if prefer_owner >= 0 and s:tile_owner(t) ~= prefer_owner then
				score += r_max * 0.5
			end
			if score < best_score then
				best_score = score
				best = t
			end
		end
	end
	if best >= 0 then
		return best
	end
	-- Sub-pixel islands: search the tile grid around the hit tile (≈ the ring's size in tiles).
	local span = self:_px_to_tiles(r_max, pos)
	if tile >= 0 and span > 0 then
		local map = ctx.state and ctx.state.map
		local W = if map then map.W else Defs.W
		local H = if map then map.H else Defs.H
		local cx = tile % W
		local cy = tile // W
		local bd = math.huge
		for dy = -span, span do
			local y = cy + dy
			if y < 0 or y >= H then
				continue
			end
			for dx = -span, span do
				local x = cx + dx
				if x < 0 or x >= W then
					continue
				end
				local t2 = y * W + x
				if good(t2) then
					local d = dx * dx + dy * dy
					if d < bd then
						bd = d
						best = t2
					end
				end
			end
		end
	end
	return if best >= 0 then best else tile
end

--- How many grid tiles `px` screen pixels span around `pos` (at least 1).
function UIInteract._px_to_tiles(self: any, px: number, pos: Vector2): number
	local ctx = self.ctx
	local a = ctx:tile_at(pos)
	local b = ctx:tile_at(pos + Vector2.new(px, 0))
	if a < 0 or b < 0 then
		return 1
	end
	local map = ctx.state and ctx.state.map
	local W = if map then map.W else Defs.W
	local dx = math.abs(a % W - b % W)
	local dy = math.abs(a // W - b // W)
	return math.clamp(math.max(dx, dy), 1, 6)
end

--- Aims that take two taps: nukes on desktop (touch confirms with the floating ✓ instead).
function UIInteract._locks_target(self: any, kind: string): boolean
	return UIRules.is_nuke(kind) and not self.ctx.touch
end

function UIInteract.on_radial(self: any, id: string, tile: number)
	local ctx = self.ctx
	local s = ctx.state
	if s == nil then
		return
	end
	local own = s:tile_owner(tile)
	local pos = self.radial.center
	-- "build:<kind>" or "build:<kind>:<amount>" (the bulk ring: several levels at once), likewise nukes
	if string.sub(id, 1, 6) == "build:" then
		local k, amt = string.match(id, "^build:([%w_]+):?(%d*)$")
		k = k or string.sub(id, 7)
		local n = math.max(1, tonumber(amt) or 1)
		local cost = if n > 1 then ctx.rules:bulk_cost(k, n) else ctx.rules:cost(k)
		ctx:send({ type = "build", kind = k, tile = tile, amount = if n > 1 then n else nil })
		self:_float(
			string.format(
				"%s%s  ·  %s gold",
				UIRules.TITLES[k],
				if n > 1 then string.format(" ×%d", n) else "",
				T().fmt_cost(cost)
			),
			k,
			T().GOLD,
			pos
		)
		return
	end
	if string.sub(id, 1, 5) == "nuke:" then
		local nk, amt = string.match(id, "^nuke:([%w_]+):?(%d*)$")
		nk = nk or string.sub(id, 6)
		local n = math.max(1, tonumber(amt) or 1)
		ctx:send({ type = "nuke", kind = nk, tile = tile, amount = if n > 1 then n else nil })
		self:_float(
			string.format(
				"%s%s launched at %s",
				UIRules.TITLES[nk],
				if n > 1 then string.format(" ×%d", n) else "",
				s:owner_name(own)
			),
			nk,
			T().RED,
			pos
		)
		return
	end
	if id == "attack" then
		local act = ctx.rules:primary(tile)
		ctx:send({ type = "attack", tile = tile, ratio = ctx:order_ratio() })
		self:_float(ctx.rules:confirm_text(act), "attack", if own ~= 0 then T().AMBER else T().GREEN, pos)
	elseif id == "boat" then
		local landing = ctx.rules:boat_landing(tile)
		ctx:send({ type = "boat", tile = if landing >= 0 then landing else tile, ratio = ctx:order_ratio() })
		local act2 = ctx.rules:primary(tile)
		act2.type = "boat"
		self:_float(ctx.rules:confirm_text(act2), "boat", T().CYAN, pos)
	elseif id == "ally_request" then
		ctx:send({ type = "ally_request", target = own })
		ctx:sfx("click")
		self:_float("Alliance proposed to " .. s:owner_name(own), "alliance", T().VIOLET, pos)
	elseif id == "ally_accept" then
		ctx:send({ type = "ally_reply", target = own, accept = true })
		self:_float("Alliance accepted", "alliance", T().VIOLET, pos)
	elseif id == "ally_extend" then
		ctx:send({ type = "ally_extend", target = own })
	elseif id == "ally_break" then
		-- Never in one tap: the ally card asks first and spells out the Traitor penalty.
		self:_select(tile, "ally", ctx.rules:primary(tile))
		self.target_card:confirm_betray()
	elseif id == "donate" then
		self:donate_to(own, pos)
	elseif id == "retreat" then
		local aid = self:my_attack_on(own)
		if aid >= 0 then
			self:retreat(aid)
		end
	elseif id == "focus" then
		ctx:world_call("focus_tile", { tile })
	elseif id == "info" then
		self:show_inspect(tile)
	end
end

--- Nations / tribes / commanders whose capital lies within ~88 full-size tiles of `tile` (spawn advice).
UIInteract.CROWD_FULL_TILES = 88.0
function UIInteract._crowding(self: any, tile: number): number
	local ctx = self.ctx
	local s = ctx.state
	if s == nil or tile < 0 then
		return 0
	end
	-- flat maps: within CROWD_FULL_TILES full-size tiles (the old Earth's 45 tiles), in this map's tiles
	local W = s.map.W
	local k = tonumber(s.map.k_lin) or 1.0
	local r = UIInteract.CROWD_FULL_TILES / k
	local r2 = r * r
	local hx, hy = tile % W, tile // W
	local n = 0
	local me = ctx:me()
	for _, o in s.owners do
		if not o.alive or o.id == me then
			continue
		end
		local t = if (o.spawn_tile or -1) >= 0 then o.spawn_tile else (o.label_tile or -1)
		if t >= 0 then
			local dx, dy = t % W - hx, t // W - hy
			if dx * dx + dy * dy <= r2 then
				n += 1
			end
		end
	end
	return n
end

--- Our newest outgoing attack against `target` (0 = expansion), or -1.
function UIInteract.my_attack_on(self: any, target: number): number
	local best = -1
	local ctx = self.ctx
	if ctx.state == nil then
		return best
	end
	local me = ctx:me()
	for _, a in ctx.state.attacks do
		if a.attacker == me and a.target == target and a.aid > best then
			best = a.aid
		end
	end
	return best
end

function UIInteract.retreat(self: any, aid: number)
	local ctx = self.ctx
	local s = ctx.state
	if s == nil or s.attacks[aid] == nil then
		return
	end
	local a = s.attacks[aid]
	ctx:send({ type = "retreat", attack_id = aid })
	ctx:sfx("click")
	local who = if a.target ~= 0 then s:owner_name(a.target) else "neutral land"
	self:_float("Retreating from " .. who, "retreat", T().CYAN, ctx:mouse_pos())
end

--- Backspace: pull back the most recent outgoing attack.
function UIInteract.retreat_latest(self: any): boolean
	local ctx = self.ctx
	local s = ctx.state
	if s == nil then
		return false
	end
	local best = -1
	local me = ctx:me()
	for _, a in s.attacks do
		if a.attacker == me and a.aid > best then
			best = a.aid
		end
	end
	if best < 0 then
		return false
	end
	self:retreat(best)
	return true
end

function UIInteract._float(self: any, text: string, icon_name: string, col: Color3, pos: Vector2)
	local FT = FloatText()
	if FT.bounds_provider == nil then
		FT.bounds_provider = function()
			return self:float_bounds()
		end
	end
	FT.spawn(self.float_layer, pos, text, icon_name, col, self:float_bounds())
end

--- Where floating confirmations may appear: below the top bar row, above the command bar / tray.
function UIInteract.float_bounds(self: any): Rect
	local area = self.ctx:clear_rect()
	local bottom = if self.bar ~= nil and self.bar:is_visible_in_tree() then self.bar:top_edge() else area.Max.Y
	return Rect.new(area.Min.X, area.Min.Y, area.Max.X, math.min(area.Max.Y, bottom))
end

-- ---------------------------------------------------------------------------------------------
-- Tooltip / inspect content
-- ---------------------------------------------------------------------------------------------

function UIInteract.show_inspect(self: any, tile: number)
	local ctx = self.ctx
	local tooltip = self.tooltip
	local spec = self:hover_spec(tile, true)
	if next(spec) == nil then
		return
	end
	-- Bottom-left above the command bar: the right column holds the Attacks panel on phones.
	local area = ctx:clear_rect()
	local bottom = if self.bar:is_visible_in_tree() then self.bar:top_edge() - 8.0 else area.Max.Y
	tooltip:show_pinned(spec, UICtx.rect(area.Min.X, area.Min.Y, 0.0, bottom - area.Min.Y))
	-- Never cover the tapped spot: move to the right when it lies under the card.
	local tp = ctx:tile_screen_pos(tile)
	if tp.X >= 0 and UICtx.rect_has_point(UICtx.rect_grow(tooltip:target_rect(), 24.0), tp) then
		tooltip:show_pinned(spec, UICtx.rect(area.Max.X, area.Min.Y, 0.0, bottom - area.Min.Y))
	end
	-- A tapped SAM / defense post shows its range ring while the card is open.
	self._range_focus = tile
	ctx:world_call("set_range_focus", { tile })
end

function UIInteract.hover_spec(self: any, tile: number, pinned: boolean?): { [string]: any }
	local ctx = self.ctx
	local Th = T()
	local s = ctx.state
	if s == nil or tile < 0 then
		return {}
	end
	local map = s.map
	local own = s:tile_owner(tile)
	local terrain = ctx:terrain_title(tile)
	local spec = {} :: { [string]: any }
	if self.aim_kind ~= "" and not pinned then
		return self:_aim_spec(tile)
	end
	if own ~= 0 then
		local o = s:get_owner(own)
		if o == nil then
			return {}
		end
		local rel = ctx:relation(own)
		spec.title = o.name
		spec.swatch = UICtx.color3(o.color)
		spec.badge = rel
		spec.badge_color = ctx:relation_color(rel)
		spec.sub = string.format("%s  ·  %s", ctx:kind_title(o.kind), terrain)
		local rows = {
			{ "Troops", Th.fmt_troops(o.troops), Th.TEXT },
			{ "Land", Th.fmt_pct(s:land_share(own)), Th.TEXT },
		}
		if own == ctx:me() or pinned then
			table.insert(rows, { "Gold", Th.fmt_num(o.gold), Th.GOLD })
		end
		local st = ctx:structure_at(tile, 1)
		if st ~= nil and st.owner == own then
			local lv = if st.level > 1 then string.format(" · Lv %d", st.level) else ""
			table.insert(rows, { "Structure", Defs.STRUCT_TITLES[st.kind] .. lv, Th.TEXT })
			if st.active_tick > s.tick then
				-- Under construction: it does nothing yet (no cap, trade, defense, interception, launch).
				table.insert(
					rows,
					{ "Building…", Th.fmt_time(math.ceil((st.active_tick - s.tick) / Defs.TICK_RATE)), Th.ORANGE }
				)
			end
		end
		if s:is_traitor(own) then
			table.insert(
				rows,
				{ "Traitor", string.format("%ds left", math.ceil((o.traitor_until - s.tick) / Defs.TICK_RATE)), Th.RED }
			)
		end
		-- game admins only: whether this "player" is a real person
		local bots = if ctx.session ~= nil then ctx.session.admin_bots else nil
		if bots ~= nil and o.kind == Defs.KIND_HUMAN and own ~= ctx:me() then
			table.insert(rows, if bots[own] then { "Player", "Bot", Th.TEXT_3 } else { "Player", "Human", Th.CYAN })
		end
		-- the player panel's "Alliance Expires In": red in the last 30 s, yellow in the last 60 s
		local ai = if own ~= ctx:me() then s:alliance_info(ctx:me(), own) else nil
		if ai ~= nil and ai.expires_at >= 0 then
			local secs = math.ceil(ai.ticks_left / Defs.TICK_RATE)
			local col = if secs <= 30 then Th.RED elseif secs <= 60 then Th.AMBER else Th.GREEN
			table.insert(rows, { "Alliance ends", Th.fmt_time(secs), col })
			if ai.me_asked or ai.other_asked then
				table.insert(
					rows,
					{ "Renewal", if ai.me_asked then "asked, waiting for them" else "they asked", Th.VIOLET }
				)
			end
		end
		spec.rows = rows
	elseif map:is_land(tile) then
		local fallout = s:has_fallout(tile)
		spec.title = if not fallout then ("Unclaimed  ·  " .. terrain) else "Fallout zone"
		spec.title_color = if not fallout then Th.TEXT_2 else Th.ORANGE
		local st2 = ctx:structure_at(tile, 0)
		if st2 ~= nil then
			spec.sub = Defs.STRUCT_TITLES[st2.kind]
		end
	else
		if not pinned then
			return {}
		end
		spec.title = terrain
		spec.title_color = Th.TEXT_2
	end
	if pinned then
		return spec
	end
	local act = ctx.rules:primary(tile)
	local verb = if ctx.touch then "Tap" else "Click"
	local ty = tostring(act.type)
	if ty == "spawn" then
		spec.hint = verb .. " to place your capital here"
		spec.hint_color = Th.AMBER
		spec.hint_icon = "target"
		local crowd = self:_crowding(tile)
		local rows2 = spec.rows or {}
		if crowd >= 6 then
			table.insert(rows2, { "Neighbours", string.format("%d nearby · crowded, tough start", crowd), Th.ORANGE })
		elseif crowd >= 3 then
			table.insert(rows2, { "Neighbours", string.format("%d nearby · contested", crowd), Th.AMBER })
		else
			table.insert(
				rows2,
				{ "Neighbours", string.format("%d nearby · ", crowd) .. "open land, safer start", Th.GREEN }
			)
		end
		spec.rows = rows2
	elseif ty == "expand" or ty == "attack" then
		if act.ok then
			spec.hint = string.format(
				"%s: %s with %s",
				verb,
				if ty == "expand" then "expand" else "attack",
				Th.fmt_troops(act.troops)
			)
			spec.hint_color = if ty == "expand" then Th.GREEN else Th.AMBER
			spec.hint_icon = "attack"
		end
	elseif ty == "boat" then
		if act.ok then
			spec.hint = string.format("%s: boat invasion with %s", verb, Th.fmt_troops(act.troops))
			spec.hint_color = Th.CYAN
			spec.hint_icon = "boat"
		else
			spec.hint = tostring(act.reason)
			spec.hint_color = Th.TEXT_3
			spec.hint_icon = "boat"
		end
	elseif ty == "none" then
		if tostring(act.reason) ~= "" then
			spec.hint = tostring(act.reason)
			spec.hint_color = Th.TEXT_3
			spec.hint_icon = "info"
		end
	end
	if s.phase == Defs.PHASE_PLAYING and ctx:alive_player() then
		spec.footer = "Right-click for more actions"
	end
	return spec
end

function UIInteract._aim_spec(self: any, tile: number): { [string]: any }
	local ctx = self.ctx
	local Th = T()
	local k = self.aim_kind
	local nuke = UIRules.is_nuke(k)
	local title = UIRules.TITLES[k]
	local spec = {
		title = (if nuke then "Launch " else "Build ") .. title,
		title_color = if nuke then Th.RED else Th.TEXT,
	} :: { [string]: any }
	local av = ctx.rules:availability(k)
	local pl = ctx.rules:placement(k, tile)
	-- Your own structure under the cursor: the click upgrades it (same wording as the touch caption).
	local upgrade = pl.ok and pl.upgrade == true and not nuke
	if upgrade then
		spec.title = string.format("Upgrade %s → Lv %d", title, tonumber(pl.level) or 2)
	end
	local rows = { { "Cost", Th.fmt_cost(av.cost) .. " gold", Th.GOLD } }
	if nuke then
		table.insert(rows, { "Blast radius", UIRules.blast_text(k), Th.TEXT })
		if tile >= 0 and ctx.state:tile_owner(tile) ~= 0 then
			table.insert(rows, { "Target", ctx.state:owner_name(ctx.state:tile_owner(tile)), Th.TEXT })
		end
		-- Hostile SAM cover of the aimed tile (the view counts it for the current aim).
		local n_sam = tonumber(ctx:world_call("aim_sams")) or 0
		if n_sam > 0 and k ~= "mirv" then
			table.insert(rows, {
				"SAM cover",
				string.format("%d SAM%s cover this target", n_sam, if n_sam == 1 then "" else "s"),
				Th.RED,
			})
		end
	end
	spec.rows = rows
	local verb = if ctx.touch then "Tap" else "Click"
	if not pl.ok then
		spec.hint = tostring(pl.reason)
		spec.hint_color = Th.RED
		spec.hint_icon = "info"
	elseif self._confirm_tile >= 0 and self:_locks_target(k) and not nuke then
		spec.hint = if upgrade then "Tap again to upgrade" else "Tap again to build here"
		spec.hint_color = Th.GREEN
		spec.hint_icon = "target"
	elseif nuke and self._confirm_tile >= 0 then
		spec.hint = verb .. " again to confirm the launch"
		spec.hint_color = Th.RED
		spec.hint_icon = "target"
	else
		spec.hint = if nuke
			then (verb .. " to target")
			elseif upgrade then (verb .. " to upgrade")
			else (verb .. " to build here")
		spec.hint_color = Th.GREEN
		spec.hint_icon = "target"
		if tostring(pl.warn or "") ~= "" then
			spec.body = tostring(pl.warn)
		end
	end
	-- (Esc belongs to Roblox's menu; X is the cancel key here.)
	spec.footer = if not ctx.touch then "Right-click or X to cancel" else "Long-press to cancel"
	return spec
end

function UIInteract.process_frame(self: any, delta: number)
	local ctx = self.ctx
	local tooltip = self.tooltip
	self:_follow_ghost()
	if
		self._range_focus >= 0
		and not (tooltip:is_shown() and tooltip.place == tooltip.Place.PINNED)
		and not (self.target_card ~= nil and self.target_card.is_open)
	then
		self._range_focus = -1
		ctx:world_call("set_range_focus", { -1 })
	end
	if self._tip_wait > 0.0 then
		self._tip_wait -= delta
		if self._tip_wait <= 0.0 and self._tip_dirty then
			self._tip_dirty = false
			self._tip_wait = 0.06
			self:_update_tooltip()
		end
	end
	-- Keep the hover card's numbers fresh while the pointer rests.
	self._tip_accum += delta
	if self._tip_accum >= 0.5 then
		self._tip_accum = 0.0
		if self.enabled and tooltip.place == tooltip.Place.FOLLOW and tooltip:is_shown() then
			self:_update_tooltip()
		end
	end
	self:_key_repeat(delta)
end

-- ---------------------------------------------------------------------------------------------
-- Keyboard, wheel and touch detection
-- ---------------------------------------------------------------------------------------------

--- Touch InputObject positions exclude the top GUI inset: viewport px = Position + inset.
local function io_view_pos(io: InputObject): Vector2
	local p = Vector2.new(io.Position.X, io.Position.Y)
	local inset = game:GetService("GuiService"):GetGuiInset()
	return p + inset
end
UIInteract.io_view_pos = io_view_pos

--- Hooks UserInputService (Godot _input + _unhandled_key_input).
function UIInteract.connect_input(self: any)
	if not UICtx.IS_ROBLOX then
		return
	end
	local UIS = game:GetService("UserInputService")
	table.insert(
		self._conns,
		UIS.InputBegan:Connect(function(io: InputObject, gp: boolean)
			self:_on_input_began(io, gp)
		end)
	)
	table.insert(
		self._conns,
		UIS.InputChanged:Connect(function(io: InputObject, gp: boolean)
			self:_on_input_changed(io, gp)
		end)
	)
	table.insert(
		self._conns,
		UIS.InputEnded:Connect(function(io: InputObject, _gp: boolean)
			if io.UserInputType == Enum.UserInputType.Keyboard then
				self._held[io.KeyCode] = nil
			elseif io.UserInputType == Enum.UserInputType.Touch then
				self.ctx.pointer = self.ctx:to_logical(io_view_pos(io))
			end
		end)
	)
	table.insert(
		self._conns,
		UIS.TextBoxFocused:Connect(function()
			table.clear(self._held)
		end)
	)
	-- Esc opens Roblox's own menu (games never receive it): the transient things Esc cancelled in
	-- the original (radial menu, placement, selection cards) are cancelled when that menu opens.
	table.insert(
		self._conns,
		game:GetService("GuiService").MenuOpened:Connect(function()
			table.clear(self._held)
			if self.radial.is_open then
				self.radial:close()
			end
			if self.unit_card ~= nil and self.unit_card.is_open then
				self:deselect_unit(false)
			end
			if self.target_card ~= nil and self.target_card.is_open then
				self.target_card:hide_card(false)
			end
			if self.aim_kind ~= "" then
				self:cancel_aim(false)
			end
		end)
	)
end

function UIInteract.destroy(self: any)
	for _, c in self._conns do
		c:Disconnect()
	end
	table.clear(self._conns)
end

function UIInteract._on_input_began(self: any, io: InputObject, gp: boolean)
	local ty = io.UserInputType
	if ty == Enum.UserInputType.Touch then
		self.ctx.pointer = self.ctx:to_logical(io_view_pos(io))
		self:_set_touch(true)
		-- A slot's long-press card stays up until the next tap anywhere.
		local tt = self.tooltip
		if tt.place == tt.Place.ANCHOR and tt:is_shown() then
			tt:hide_tip()
		end
		return
	end
	if ty == Enum.UserInputType.Keyboard then
		-- Esc belongs to Roblox's system menu: when it still reaches us, it cancels like the original
		-- (a bonus); X is the always-available cancel key.
		if io.KeyCode == Enum.KeyCode.Escape then
			if not game:GetService("GuiService").MenuIsOpen then
				self:escape()
			end
			return
		end
		if not gp then
			self:_on_key(io.KeyCode, false)
		end
	end
end

function UIInteract._on_input_changed(self: any, io: InputObject, gp: boolean)
	local ty = io.UserInputType
	if ty == Enum.UserInputType.MouseMovement then
		if not self.ctx.touch_device and io.Delta.Magnitude > 0.5 then
			self:_set_touch(false)
		end
		return
	end
	if ty == Enum.UserInputType.Touch then
		self.ctx.pointer = self.ctx:to_logical(io_view_pos(io))
		return
	end
	if ty == Enum.UserInputType.MouseWheel and shift_down() and self.ui:screen() == "play" and self.enabled then
		-- Shift + wheel: attack ratio (the globe ignores the wheel while Shift is held).
		local z = io.Position.Z
		if z ~= 0 then
			self.ctx:step_ratio(z)
		end
	end
	local _ = gp
end

function UIInteract._set_touch(self: any, on: boolean)
	local ctx = self.ctx
	-- Phones and tablets stay in touch mode.
	if self.ui.debug_touch >= 0 or on == ctx.touch or (not on and ctx.touch_device) then
		return
	end
	ctx.touch = on
	if on then
		self.tooltip:hide_tip()
	end
	if self.bar ~= nil then
		self.bar._flow = -1
	end
	self.ui:relayout()
end

local HOTKEY_INDEX: { [any]: number } = {}
if UICtx.IS_ROBLOX then
	local K = Enum.KeyCode
	HOTKEY_INDEX = {
		[K.One] = 1,
		[K.KeypadOne] = 1,
		[K.Two] = 2,
		[K.KeypadTwo] = 2,
		[K.Three] = 3,
		[K.KeypadThree] = 3,
		[K.Four] = 4,
		[K.KeypadFour] = 4,
		[K.Five] = 5,
		[K.KeypadFive] = 5,
		[K.Six] = 6,
		[K.KeypadSix] = 6,
		[K.Seven] = 7,
		[K.KeypadSeven] = 7,
		[K.Eight] = 8,
		[K.KeypadEight] = 8,
		[K.Nine] = 9,
		[K.KeypadNine] = 9,
		[K.Zero] = 10,
		[K.KeypadZero] = 10,
	}
end

--- Hotkeys. `echo` = a key-repeat (only Q / E repeat). Returns true when handled.
function UIInteract._on_key(self: any, key: Enum.KeyCode, echo: boolean): boolean
	local ctx = self.ctx
	local ui = self.ui
	local UIS = game:GetService("UserInputService")
	local K = Enum.KeyCode
	if
		UIS:IsKeyDown(K.LeftControl)
		or UIS:IsKeyDown(K.RightControl)
		or UIS:IsKeyDown(K.LeftMeta)
		or UIS:IsKeyDown(K.RightMeta)
		or UIS:IsKeyDown(K.LeftAlt)
		or UIS:IsKeyDown(K.RightAlt)
		or UIS:IsKeyDown(K.LeftSuper)
		or UIS:IsKeyDown(K.RightSuper)
		or ctx:pause_menu_open()
	then
		return false
	end
	if echo and key ~= K.Q and key ~= K.E then
		return false
	end
	local handled = true
	if key == K.Escape or key == K.X then
		handled = self:escape()
	elseif key == K.H then
		ui:toggle_help()
	elseif key == K.Tab then
		-- the leaderboard (Tab, as in most games; Roblox's own player list is off)
		if ui:screen() == "title" then
			handled = false
		else
			ui:toggle_leaderboard()
		end
	elseif key == K.Space then
		if ui:screen() == "play" or ui:screen() == "spawn" then
			self:primary_at_hover()
		else
			handled = false
		end
	elseif key == K.Backspace then
		handled = ui:screen() == "play" and self.enabled and self:retreat_latest()
	elseif key == K.Q or key == K.E then
		if ui:screen() == "play" and self.enabled then
			ctx:step_ratio(if key == K.E then 1 else -1)
			if not echo then
				self._held[key] = { t = 0.0, next = UIInteract.REPEAT_DELAY }
			end
		else
			handled = false
		end
	else
		local idx = HOTKEY_INDEX[key]
		if idx ~= nil and ui:screen() == "play" and self.enabled then
			self:select_action(UIRules.ACTIONS[idx])
		else
			handled = false
		end
	end
	return handled
end

--- Q / E held down repeat like an OS key repeat (Roblox sends no echo events).
function UIInteract._key_repeat(self: any, delta: number)
	if next(self._held) == nil or not UICtx.IS_ROBLOX then
		return
	end
	local UIS = game:GetService("UserInputService")
	for key, h in self._held do
		if not UIS:IsKeyDown(key) or UIS:GetFocusedTextBox() ~= nil then
			self._held[key] = nil
			continue
		end
		h.t += delta
		while h.t >= h.next do
			h.next += UIInteract.REPEAT_RATE
			self:_on_key(key, true)
		end
	end
end

--- Esc: close the top-most transient thing. Returns false when there was nothing to close.
function UIInteract.escape(self: any): boolean
	local ui = self.ui
	local radial = self.radial
	if radial.is_open then
		radial:close()
		return true
	end
	if self.unit_card ~= nil and self.unit_card.is_open then
		self:deselect_unit(true)
		return true
	end
	if self.target_card ~= nil and self.target_card.is_open then
		self.target_card:hide_card(true)
		return true
	end
	if self.aim_kind ~= "" then
		self:cancel_aim()
		return true
	end
	if ui.help.is_open then
		ui.help:close()
		return true
	end
	if ui.pause.is_open then
		ui.pause:close()
		return true
	end
	local tt = self.tooltip
	if tt:is_shown() and tt.place == tt.Place.PINNED then
		tt:hide_tip()
		return true
	end
	return false
end

return UIInteract
