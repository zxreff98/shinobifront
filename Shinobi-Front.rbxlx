        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Products</string>
            <string name="Source"><![CDATA[--!strict
-- Robux developer products (Creator Dashboard → Monetization → Developer Products). `id` is the
-- product's id; 0 = not created yet (its offer stays hidden). Each purchase is a saved credit of kind
-- `grants` (default: the key), `count` of them (default 1) (server/Purchases.luau): bought credits are
-- never lost if the moment passes. A `grants` of "unlock:<key>" is not a credit: it unlocks that
-- Arsenal item for good (Data/Arsenal).
--
-- Product ids belong to one experience. `staging` is the same product in Rofront Staging (2026-10-04:
-- a separate experience where a build is tested before it goes to prod); in that experience it
-- replaces `id`. Create or reprice them with
-- tools/assets/make_arsenal_products.py.
local PRODUCTS: { [string]: any } = {
	--- Solo / public: take over the AI nation that eliminated you (2026-09-28).
	takeover = { id = 3715363250, robux = 25, staging = 3716610101 },
	--- A cosmetic crate (Data/Cosmetics; 2026-09-29: 49 Robux, the first one 15).
	crate = { id = 3715469100, robux = 49, staging = 3716610114 },
	--- The first crate a player buys (offered only before their first crate).
	crate_first = { id = 3715469104, robux = 15, grants = "crate", first_only = true, staging = 3716610118 },
	--- Three crates at once (2026-10-19: 100 Robux instead of 120,
	--- three crates being 3 x 40 at their price): `count` crate credits for one receipt.
	crate3 = { id = 3720068382, robux = 100, grants = "crate", count = 3, staging = 3720061533 },
	--- Ten crates at once (2026-10-27: a buy to come back to above 100 Robux; a paying player spent 89
	--- Robux on average, top experiences about 600): 299, about 30 a crate.
	crate10 = { id = 3722748768, robux = 299, grants = "crate", count = 10, staging = 3722748745 },
	--- The Arsenal (Data/Arsenal; 2026-10-04), at Pixel Conquest's prices.
	unlock_mega = { id = 3716621701, robux = 39, grants = "unlock:mega", staging = 3716609998 },
	unlock_scatter = { id = 3716621706, robux = 67, grants = "unlock:scatter", staging = 3716610004 },
	unlock_reinforce = { id = 3716621710, robux = 149, grants = "unlock:reinforce", staging = 3716610015 },
	unlock_artillery = { id = 3716621715, robux = 99, grants = "unlock:artillery", staging = 3716610019 },
	unlock_airfield = { id = 3716621718, robux = 349, grants = "unlock:airfield", staging = 3716610030 },
	unlock_railgun = { id = 3716621726, robux = 999, grants = "unlock:railgun", staging = 3716610035 },
	unlock_stars2x = { id = 3716621730, robux = 59, grants = "unlock:stars2x", staging = 3716610048 },
	unlock_reload2x = { id = 3716621734, robux = 129, grants = "unlock:reload2x", staging = 3716610055 },
	--- The starter pack (Data/Starter; 2026-10-15: 39 Robux, limited time): Mega Nuke, Scattershot
	--- and 2x Stars, once, for a player who never paid. Its receipt is refused outside its offer.
	starter_pack = { id = 3718883874, robux = 39, grants = "starter", staging = 3718864635 },
}

--- The flag shop (Data/Shop; 2026-10-22): one product per flag, made by
--- tools/assets/make_shop_flags.py (the ids live in Assets/ShopFlags), each granting "shopflag:<key>".
--- `shop_flag` marks them: UI/Prices asks Roblox for these only when the shop shows them.
local Shop: any = if typeof(game) == "Instance"
	then require((script :: any).Parent.Shop)
	else (require :: any)("./Shop")
for _, f in Shop.flags() do
	PRODUCTS["shop_" .. f.key] = {
		id = f.product or 0,
		robux = Shop.price(f),
		grants = "shopflag:" .. f.key,
		staging = f.staging or 0,
		shop_flag = f.key,
	}
end

--- A set's bundle (Data/Shop.SETS `bundle`; 2026-10-24): all its flags in one product, granting
--- "shopset:<id>".
for sid, s in Shop.SETS do
	if s.bundle ~= nil then
		local prod, staging = Shop.bundle_ids(sid)
		PRODUCTS["shopset_" .. sid] = {
			id = prod,
			robux = s.bundle,
			grants = "shopset:" .. sid,
			staging = staging,
			shop_set = sid,
		}
	end
end

--- Rofront Staging (Data/Staging): there every product is its `staging` one.
local Staging: any = if typeof(game) == "Instance"
	then require((script :: any).Parent.Staging)
	else (require :: any)("./Staging")

if Staging.here() then
	for _, p in PRODUCTS do
		p.id = p.staging or 0
	end
end

-- Product IDs belong to the upstream experience.
for _, product in PRODUCTS do
	product.id = 0
end

return PRODUCTS
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[--!strict
-- The flag shop (2026-10-22: a daily rotating shop of flags for sale, with a
-- Halloween set first; docs/flag-shop.md). Flags you choose and buy for Robux, each its own developer
-- product (Assets/ShopFlags: the art, the product ids). They are cosmetics like the crates' flags
-- (Data/Cosmetics: item "shop_<key>", kind "flag"), but never in a crate and never on a bot player.
--
--   the daily shop   DAILY flags from the pool (the flags of no set), new every day at 00:00 UTC. Every
--                    server and client works the day's out from the date alone (Shop.daily): the pool
--                    is shuffled once per cycle of floor(#pool / DAILY) days, each day takes the next
--                    DAILY of it, so a flag doesn't come back within a cycle; a cycle's first day never
--                    repeats the day before.
--   sets             a limited set (SETS: Halloween) is on sale whole between its `from` and `to`; with
--                    a `bundle` price, all of it is one product too (2026-10-24, from the analytics
--                    suggestions: the set's 6 flags as one bundle at a discount).
--
-- A receipt grants its flag whenever it comes (the prompt may close after the shop turned over).
local IS_ROBLOX = typeof(game) == "Instance"
local ShopFlags: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Assets.ShopFlags)
	else require("../Assets/ShopFlags")

local Shop = {}

Shop.DAY_S = 86400
--- Flags in the daily shop.
Shop.DAILY = 4
--- Robux by rarity (each flag's product is created at its rarity's price: make_shop_flags.py).
Shop.PRICES = { rare = 49, epic = 99, legendary = 149 }
--- The item id prefix (Data/Cosmetics).
Shop.ITEM_PREFIX = "shop_"

--- Limited sets: on sale whole from `from` to `to` (Unix seconds, UTC); `bundle`: the Robux of all of
--- it at once (its product: Assets/ShopFlags `sets`).
Shop.SETS = {
	-- 2026-10-22 .. 2026-11-03; all 6 for 299 (544 one by one)
	halloween = { name = "Halloween", from = 1792627200, to = 1793664000, bundle = 299 },
}

type Flag = { key: string, name: string, rarity: string, theme: string, set: string?, [string]: any }

local flags: { Flag } = {}
local by_key: { [string]: Flag } = {}
local pool: { string } = {}
for _, f in (ShopFlags.flags or {}) :: { any } do
	table.insert(flags, f)
	by_key[f.key] = f
	if f.set == nil then
		table.insert(pool, f.key)
	end
end
table.sort(pool)

function Shop.flags(): { Flag }
	return flags
end

function Shop.flag(key: any): Flag?
	return if type(key) == "string" then by_key[key] else nil
end

--- The daily pool's keys (sorted).
function Shop.pool(): { string }
	return pool
end

function Shop.price(f: any): number
	return Shop.PRICES[f and f.rarity or ""] or Shop.PRICES.rare
end

function Shop.item_id(key: string): string
	return Shop.ITEM_PREFIX .. key
end

--- The shop flag key of item id `id` (nil: not a shop flag's id).
function Shop.key_of(id: any): string?
	if type(id) ~= "string" or string.sub(id, 1, #Shop.ITEM_PREFIX) ~= Shop.ITEM_PREFIX then
		return nil
	end
	local key = string.sub(id, #Shop.ITEM_PREFIX + 1)
	return if by_key[key] ~= nil then key else nil
end

--- The UTC day number of Unix time `t`.
function Shop.day(t: number): number
	return math.floor(t / Shop.DAY_S)
end

--- Seconds from `t` until the shop turns over.
function Shop.next_in(t: number): number
	return (Shop.day(t) + 1) * Shop.DAY_S - t
end

-- xorshift32 (bit32: the same numbers in every Luau, so every server and client agrees)
local function rng(seed: number): () -> number
	local s = bit32.band(seed, 0xFFFFFFFF)
	if s == 0 then
		s = 0x9E3779B9
	end
	return function(): number
		s = bit32.bxor(s, bit32.lshift(s, 13))
		s = bit32.bxor(s, bit32.rshift(s, 17))
		s = bit32.bxor(s, bit32.lshift(s, 5))
		return s
	end
end

--- The pool shuffled for cycle `c` (before the first-day rule).
local function deck(list: { string }, c: number): { string }
	local d = table.clone(list)
	local next = rng(bit32.bxor((c * 2654435761) % 4294967296, 0x5BD1E995))
	for _ = 1, 3 do
		next() -- (mix the seed)
	end
	for i = #d, 2, -1 do
		local j = next() % i + 1
		d[i], d[j] = d[j], d[i]
	end
	return d
end

local function slice(d: { string }, k: number, n: number): { string }
	local out = {}
	for i = k * n + 1, k * n + n do
		table.insert(out, d[i])
	end
	return out
end

--- The daily shop's keys on UTC day `day` (`list`: the pool, by default Shop.pool()).
function Shop.daily(day: number, list: { string }?): { string }
	local p = list or pool
	local n = Shop.DAILY
	if #p <= n then
		return table.clone(p)
	end
	local days = math.floor(#p / n)
	local c, k = math.floor(day / days), day % days
	local d = deck(p, c)
	-- a cycle's days are its deck's slices; the cycle's first day is a slice with nothing from the day
	-- before (the last slice of the previous cycle's deck, which this rule never moves)
	if days >= n + 2 then
		local prev = slice(deck(p, c - 1), days - 1, n)
		local seen = {}
		for _, key in prev do
			seen[key] = true
		end
		local first = 0
		for s = 0, days - 2 do
			local clear = true
			for _, key in slice(d, s, n) do
				if seen[key] then
					clear = false
					break
				end
			end
			if clear then
				first = s
				break
			end
		end
		if first > 0 then
			-- (that slice goes first; the others keep their order, the last one stays last)
			local moved = slice(d, first, n)
			for _ = 1, n do
				table.remove(d, first * n + 1)
			end
			for i = n, 1, -1 do
				table.insert(d, 1, moved[i])
			end
		end
	end
	return slice(d, k, n)
end

--- The limited sets on sale at `t`: { { id, name, ends, keys } } (by `to`).
function Shop.sets(t: number): { any }
	local out = {}
	for id, s in Shop.SETS do
		if t >= s.from and t < s.to then
			local keys = {}
			for _, f in flags do
				if f.set == id then
					table.insert(keys, f.key)
				end
			end
			if #keys > 0 then
				table.insert(out, { id = id, name = s.name, ends = s.to, keys = keys })
			end
		end
	end
	table.sort(out, function(a, b)
		return a.ends < b.ends
	end)
	return out
end

--- The keys of set `id` (rarest first, then by name).
function Shop.set_keys(id: string): { string }
	local keys = {}
	for _, f in flags do
		if f.set == id then
			table.insert(keys, f.key)
		end
	end
	local rank = { legendary = 1, epic = 2, rare = 3 }
	table.sort(keys, function(a, b)
		local fa, fb = by_key[a], by_key[b]
		local ra, rb = rank[fa.rarity] or 9, rank[fb.rarity] or 9
		if ra ~= rb then
			return ra < rb
		end
		return fa.name < fb.name
	end)
	return keys
end

--- Set `id`'s bundle product ids: (production, Rofront Staging); 0 = not made yet.
function Shop.bundle_ids(id: string): (number, number)
	local s = (ShopFlags.sets or {})[id]
	return if s then s.product or 0 else 0, if s then s.staging or 0 else 0
end

--- Set `id`'s flags bought one by one (Robux).
function Shop.set_total(id: string): number
	local n = 0
	for _, k in Shop.set_keys(id) do
		n += Shop.price(by_key[k])
	end
	return n
end

--- Is flag `key` on sale at `t` (today's daily shop or a running set)?
function Shop.on_sale(key: string, t: number): boolean
	for _, k in Shop.daily(Shop.day(t)) do
		if k == key then
			return true
		end
	end
	for _, s in Shop.sets(t) do
		if table.find(s.keys, key) then
			return true
		end
	end
	return false
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Staging</string>
            <string name="Source"><![CDATA[--!strict
-- The Rofront Staging experience (2026-10-04: a separate game to test changes in before they go to
-- prod): its universe id, for what differs there (Data/Products' ids, the game menu's
-- "Replay as new player").
local Staging = {}

--- Rofront Staging's universe id.
Staging.UNIVERSE = 10769439627

--- True in the Rofront Staging experience.
function Staging.here(): boolean
	return typeof(game) == "Instance" and (game :: any).GameId == Staging.UNIVERSE
end

return Staging
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Stars</string>
            <string name="Source"><![CDATA[--!strict
-- Stars: the currency a match pays, spent in the Arsenal (Data/Arsenal; 2026-10-04: an item is either
-- earned by playing or bought with Robux). The formula is Pixel Conquest's Money payout
-- (an average match pays an average seat about 1,000; about 3,300 an hour of play), line by line:
--
--   played     100                              not for a player who left early
--   survived   15 a minute alive
--   territory  30 x peak land in fair shares    (a share = the map's land / the nations and players)
--   conquests  54 a nation or player conquered  (tribes don't count: there are hundreds)
--   placed     14 a minute x place score        place score = (1 - (place - 1) / (field - 1))^2;
--                                               not for a player who left early
--   victory    18 a minute                      the winner
--
-- Every line is rounded to 5 (at least 5 when it pays at all). A player who never spawned gets
-- nothing. A solo match pays a share of this by difficulty (MODE_MULT: it runs on the player's own
-- device against the AI); 2x Stars (Data/Arsenal) doubles the total.
--
--   Stars.payout(result, mode, double) -> { lines = { { key, amount } }, total }
--   Stars.sanitize(report, real_minutes) -> result   a client's solo report, made safe
--   Stars.solo_cap(real_minutes)                     the most a solo match of that length may pay
--   Stars.Tracker.new(sim)                           follows a running Sim for its humans' results
local IS_ROBLOX = typeof(game) == "Instance"
local Core: any = if IS_ROBLOX then (game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Core else nil
local Defs: any = if IS_ROBLOX then require(Core.Defs) else require("../Core/Defs")
local Ev: any = if IS_ROBLOX then require(Core.Ev) else require("../Core/Ev")

local Stars = {}

Stars.NAME = "Stars"
Stars.FLOOR = 100
Stars.PER_MINUTE = 15
Stars.PER_SHARE = 30
Stars.PER_KILL = 54
Stars.PLACE_RATE = 14
Stars.WIN_RATE = 18
Stars.QUANTUM = 5
--- What a mode pays of the formula. Solo runs on the player's device against the AI: Relaxed,
--- Standard, Brutal.
Stars.MODE_MULT = { public = 1.0, solo0 = 0.4, solo1 = 0.7, solo2 = 1.0 }
--- A solo match's result is the client's word: its Stars never exceed this much per real minute
--- (the server's clock) plus the floor. Generous for an honest fast win, a ceiling for a made-up one.
Stars.SOLO_CAP_PER_MIN = 220
--- Sanity bounds for a result.
Stars.MAX_MINUTES = 240
Stars.MAX_KILLS = 200
Stars.MAX_FIELD = 1024

Stars.LINES = { "played", "survived", "territory", "conquests", "placed", "victory" }
Stars.LABELS = {
	played = "Match played",
	survived = "Time survived",
	territory = "Land held",
	conquests = "Nations conquered",
	placed = "Final place",
	victory = "Victory",
	double = "2x Stars",
	general = "General +50%",
}

export type Result = {
	spawned: boolean,
	left: boolean,
	won: boolean,
	minutes: number,
	shares: number,
	kills: number,
	place: number,
	field: number,
}

local function quantum(x: number): number
	if x <= 0 then
		return 0
	end
	return math.max(Stars.QUANTUM, math.floor(x / Stars.QUANTUM + 0.5) * Stars.QUANTUM)
end

function Stars.place_score(place: number, field: number): number
	if field <= 1 then
		return 1
	end
	local s = math.clamp(1 - (place - 1) / (field - 1), 0, 1)
	return s * s
end

--- The Stars `r` pays in `mode` ("public" / "solo0".."solo2"); `double` = the player owns 2x Stars.
function Stars.payout(r: Result, mode: string?, double: boolean?): { lines: { { any } }, total: number }
	local lines: { { any } } = {}
	local total = 0
	if not r.spawned then
		return { lines = lines, total = 0 }
	end
	local mult = Stars.MODE_MULT[mode or "public"] or 1.0
	local minutes = math.clamp(r.minutes, 0, Stars.MAX_MINUTES)
	local function add(key: string, amount: number)
		local a = quantum(amount * mult)
		if a > 0 then
			table.insert(lines, { key, a })
			total += a
		end
	end
	if not r.left then
		add("played", Stars.FLOOR)
	end
	add("survived", Stars.PER_MINUTE * minutes)
	add("territory", Stars.PER_SHARE * math.max(r.shares, 0))
	add("conquests", Stars.PER_KILL * math.max(r.kills, 0))
	if not r.left then
		add("placed", Stars.PLACE_RATE * Stars.place_score(r.place, r.field) * minutes)
		if r.won then
			add("victory", Stars.WIN_RATE * minutes)
		end
	end
	if double and total > 0 then
		table.insert(lines, { "double", total })
		total *= 2
	end
	return { lines = lines, total = total }
end

--- The most a solo match that really lasted `real_minutes` may pay (before 2x Stars).
function Stars.solo_cap(real_minutes: number): number
	return Stars.FLOOR + math.floor(Stars.SOLO_CAP_PER_MIN * math.max(real_minutes, 0))
end

local function num(v: any, lo: number, hi: number): number
	if type(v) ~= "number" or v ~= v then
		return lo
	end
	return math.clamp(v, lo, hi)
end

--- A client's solo result made safe: every field typed and bounded, and no longer than the match
--- really lasted on the server's clock.
function Stars.sanitize(report: any, real_minutes: number): Result
	local rep = if type(report) == "table" then report else {}
	local field = math.floor(num(rep.field, 1, Stars.MAX_FIELD))
	return {
		spawned = rep.spawned == true,
		left = rep.left == true,
		won = rep.won == true and rep.left ~= true,
		minutes = num(rep.minutes, 0, math.min(Stars.MAX_MINUTES, math.max(real_minutes, 0))),
		shares = num(rep.shares, 0, field),
		kills = math.floor(num(rep.kills, 0, math.min(field, Stars.MAX_KILLS))),
		place = math.floor(num(rep.place, 1, field)),
		field = field,
	}
end

-- =============================================================================================
-- Tracker: a running Sim's results
-- =============================================================================================
-- Fed after every Sim step (step(delta.ev)): the peak land of each watched human, the nations and
-- players each one conquered, the order the field fell in. `field` = the nations and players that
-- took part (tribes are scenery).

local Tracker = {}
Tracker.__index = Tracker
Stars.Tracker = Tracker

local KIND_TRIBE = Defs.KIND_TRIBE
local PHASE_PLAYING = Defs.PHASE_PLAYING
local PHASE_OVER = Defs.PHASE_OVER
local TICKS_PER_MINUTE = Defs.TICK_RATE * 60

function Tracker.new(sim: any)
	local self = setmetatable({}, Tracker)
	self.sim = sim
	--- owner id -> { start, peak, kills, out_tick, place }
	self.seats = {} :: { [number]: any }
	self.field = 0
	--- nations and players still standing
	self.live = 0
	self._counted = false
	return self
end

--- Counts the field once the match is being played (nations and players with land).
function Tracker._count(self: any)
	local sim = self.sim
	if self._counted or sim.phase < PHASE_PLAYING then
		return
	end
	self._counted = true
	local n = 0
	for id = 1, sim.owner_total do
		if sim.o_kind[id] ~= KIND_TRIBE and sim.o_alive[id] == 1 and sim.o_spawned[id] == 1 then
			n += 1
		end
	end
	self.field = math.max(n, 1)
	self.live = n
	for _, seat in self.seats do
		seat.start = math.max(seat.start, sim.tick)
	end
end

--- Follow human `id` from now on (a second call keeps what it has).
function Tracker.watch(self: any, id: number)
	if id <= 0 or self.seats[id] ~= nil then
		return
	end
	local sim = self.sim
	self.seats[id] = { start = sim.tick, peak = sim.o_tiles[id] or 0, kills = 0, out_tick = nil, place = nil }
	if self._counted and sim.o_spawned[id] ~= 1 then
		-- a late joiner makes the field one bigger once it lands (see step)
		self.seats[id].late = true
	end
end

function Tracker.unwatch(self: any, id: number)
	self.seats[id] = nil
end

--- A takeover: the player who was `old` commands `new` from now on — a new life, counted from here
--- (the land it starts with is not the player's doing: the peak starts at 0 above it).
function Tracker.adopt(self: any, old: number, new: number)
	self.seats[old] = nil
	local sim = self.sim
	self.seats[new] =
		{ start = sim.tick, peak = 0, base = sim.o_tiles[new] or 0, kills = 0, out_tick = nil, place = nil }
end

--- After every Sim step, with the step's events.
function Tracker.step(self: any, events: { { any } }?)
	local sim = self.sim
	self:_count()
	if not self._counted then
		return
	end
	local o_tiles = sim.o_tiles
	for id, seat in self.seats do
		if seat.late and sim.o_spawned[id] == 1 then
			seat.late = nil
			seat.start = sim.tick
			self.field += 1
			self.live += 1
		end
		local t = (o_tiles[id] or 0) - (seat.base or 0)
		if t > seat.peak then
			seat.peak = t
		end
	end
	if events == nil then
		return
	end
	for _, e in events do
		if e[1] == Ev.OWNER_OUT then
			local id, killer = e[2], e[3]
			if sim.o_kind[id] ~= KIND_TRIBE then
				local seat = self.seats[id]
				if seat ~= nil and seat.out_tick == nil then
					seat.out_tick = sim.tick
					seat.place = math.max(self.live, 1)
				end
				self.live = math.max(self.live - 1, 0)
				local ks = self.seats[killer]
				if ks ~= nil and killer ~= id then
					ks.kills += 1
				end
			end
		end
	end
end

--- True once `id`'s result is final (it fell, or the match is over).
function Tracker.final(self: any, id: number): boolean
	local seat = self.seats[id]
	return seat ~= nil and (seat.out_tick ~= nil or self.sim.phase == PHASE_OVER)
end

--- `id`'s result so far; `left` = the player is leaving a match that goes on.
function Tracker.result(self: any, id: number, left: boolean?): Result
	local sim = self.sim
	local seat = self.seats[id]
	if seat == nil or not self._counted or sim.o_spawned[id] ~= 1 then
		return {
			spawned = false,
			left = left == true,
			won = false,
			minutes = 0,
			shares = 0,
			kills = 0,
			place = 1,
			field = 1,
		}
	end
	local field = math.max(self.field, 1)
	local place = seat.place
	if place == nil then
		-- still standing: ranked by land among the nations and players still standing
		place = 1
		local mine = sim.o_tiles[id] or 0
		for o = 1, sim.owner_total do
			if o ~= id and sim.o_kind[o] ~= KIND_TRIBE and sim.o_alive[o] == 1 and (sim.o_tiles[o] or 0) > mine then
				place += 1
			end
		end
	end
	local land = if sim.map ~= nil then sim.map.land_count else 0
	local share = math.max(land, 1) / field
	local gone = left == true and seat.out_tick == nil and sim.phase ~= PHASE_OVER
	return {
		spawned = true,
		left = gone,
		-- (a team game: everyone on the winning team won)
		won = not gone
			and sim.phase == PHASE_OVER
			and (sim.winner == id or ((sim.winner_team or 0) ~= 0 and sim.o_team ~= nil and sim.o_team[id] == sim.winner_team)),
		minutes = math.max(0, (seat.out_tick or sim.tick) - seat.start) / TICKS_PER_MINUTE,
		shares = seat.peak / share,
		kills = seat.kills,
		place = math.min(place, field),
		field = field,
	}
end

return Stars
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Starter</string>
            <string name="Source"><![CDATA[--!strict
-- The starter pack (2026-10-15): Mega Nuke + Scattershot + 2x Stars for 39 Robux, a limited-time
-- offer (DURATION_S), once per account,
-- for a player who has never bought anything with Robux. Like Tribes' first Golden Drop offer
-- (~/roblox/tribes docs/economy.md), the deadline is real: the clock starts the first time the offer is
-- on the player's screen and runs DURATION_S; then it is gone for good, never restarted.
-- docs/arsenal.md "The starter pack"; the server's side is server/Purchases (starter_*).
local Starter = {}

--- Its developer product (Data/Products).
Starter.PRODUCT = "starter_pack"
--- What it unlocks (Data/Arsenal keys). One the player already has pays its Stars instead
--- (Purchases.DUPLICATE_STARS_PER_ROBUX for each Robux of that item's own price).
Starter.ITEMS = { "mega", "scatter", "stars2x" }
--- How long the offer runs once seen.
Starter.DURATION_S = 48 * 3600
--- A purchase still lands this long after the end (a prompt opened in time and paid late).
Starter.GRACE_S = 15 * 60
--- The offer opens by itself on the title at most this often per player (since 2026-10-17; before, it
--- opened on every server a player joined, and every public match ends on a new one, so 229,658 times
--- on 2026-10-16 for 91,572 players). The title's starter button always opens it.
Starter.AUTO_GAP_S = 6 * 3600

--- Whether the offer may open by itself now. `state`: the offer's ("ready" = never shown: always, its
--- clock starts then); `last`: os.time() of the last time it opened by itself (the player's saved
--- [ui] "starter_auto_at"; nil/0 = never); `now`: os.time(). A `last` in the future (the device's
--- clock went back) counts as never.
function Starter.auto_due(state: string?, last: number?, now: number): boolean
	if state == "ready" then
		return true
	end
	if state ~= "active" then
		return false
	end
	local l = tonumber(last) or 0
	if l <= 0 or l > now + 60 then
		return true
	end
	return now - l >= Starter.AUTO_GAP_S
end

return Starter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Subscription</string>
            <string name="Source"><![CDATA[--!strict
-- RoWorld General (2026-10-27): a monthly Roblox subscription, paid in Robux (Creator Dashboard ->
-- Monetization -> Subscriptions; Roblox renews and bills it, and players cancel it in Roblox's own
-- settings). A paying player spent 89 Robux on average against about 600 at the top 500
-- experiences (the week to 2026-10-26), and nothing they could buy came back every month. Every player
-- is greeted as Commander: a subscriber is a General. While subscribed (server/General):
--   * a crate every UTC day they play (Purchases.general_perks); where paid random items are
--     restricted (no crates there: PolicyService), DAILY_STARS Stars instead;
--   * +STARS_BONUS on every match's Stars, on top of 2x Stars (server/Rewards: the "general" line);
--   * the month's General skin (SKINS; Data/Cosmetics.general_skins), theirs to keep.
--
-- `ID` is the subscription's id ("EXP-..."; "" = not created yet: nothing offers it), `STAGING` the
-- same subscription in Rofront Staging. Prod's was created inactive (2026-10-27): activate it on the
-- dashboard when the build that offers it goes to prod.
local IS_ROBLOX = typeof(game) == "Instance"
local Staging: any = if IS_ROBLOX then require((script :: any).Parent.Staging) else (require :: any)("./Staging")

local Subscription = {}

Subscription.ID = ""
Subscription.STAGING = ""
Subscription.NAME = "RoWorld General"
--- The price set on the dashboard (Robux a month); the interface shows Roblox's own.
Subscription.ROBUX = 399
Subscription.DAILY_STARS = 2500
Subscription.STARS_BONUS = 0.5
--- The General skin of each month ("YYYY-MM", UTC, oldest first): a month without its own gives the
--- latest one before it.
Subscription.SKINS = {
	{ month = "2026-10", skin = "gen_chevrons" },
}

--- The subscription's id in this experience ("" where there is none).
function Subscription.id(): string
	return if Staging.here() then Subscription.STAGING else Subscription.ID
end

--- The UTC day number of unix time `t`.
function Subscription.day(t: number): number
	return math.floor(t / 86400)
end

--- The General skin of the month of unix time `t`.
function Subscription.skin_for(t: number): string?
	local month = os.date("!%Y-%m", math.floor(t)) :: string
	local skin = nil
	for _, s in Subscription.SKINS do
		if s.month <= month then
			skin = s.skin
		end
	end
	return skin or (if #Subscription.SKINS > 0 then Subscription.SKINS[1].skin else nil)
end

--- What a match's Stars gain (`total` before 2x Stars) for a General: whole QUANTUMs.
function Subscription.bonus(total: number, quantum: number): number
	local q = math.max(quantum, 1)
	return math.floor(math.max(total, 0) * Subscription.STARS_BONUS / q) * q
end

return Subscription
]]></string>
          </Properties>
        </Item>
