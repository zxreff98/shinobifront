    <Item class="StarterPlayerScripts" referent="107">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="108">
        <Properties>
          <string name="Name">AirfrontClient</string>
          <string name="Source"><![CDATA[-- Airfront client entry. Owned by the Session/Main agent (see PORT.md §Ownership).
-- Dev harness hook: if workspace attribute AF_DEV is set (in a developer's own Studio place),
-- run src/client/Dev/<AF_DEV>.luau instead of the game. Never set AF_DEV in the shipped place.
local dev = workspace:GetAttribute("AF_DEV")
if type(dev) == "string" and dev ~= "" then
	local mod = script:FindFirstChild("Dev") and script.Dev:FindFirstChild(dev)
	if mod then
		print("[RoWorld] client dev harness:", dev)
		require(mod)
		return
	end
	warn("[RoWorld] AF_DEV harness not found on client:", dev)
end
local Main = script:FindFirstChild("Main")
if Main then
	require(Main).start()
else
	print("[RoWorld] client boot (Main not yet written)")
end
]]></string>
        </Properties>
        <Item class="Folder" referent="109">
          <Properties>
            <string name="Name">Audio</string>
          </Properties>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">AudioDirector</string>
              <string name="Source"><![CDATA[--!strict
-- Port of scripts/audio/audio_director.gd: music + sound-effect director (client only).
--
-- - The soundtrack (Assets/Soundtrack.luau: Rodrigo Flores' Orchestral Ambients, 2026-09-27) plays by
--   mood (set_music_mood: title, wait, calm, war, victory, defeat — UIRoot picks it with MusicMood):
--   whole tracks, intro to ending, the next one (Playlist: shuffled, no recent repeats) fading in over
--   the last TRACK_OVERLAP_S; a new mood crossfades at once, except war -> calm, which lets the battle
--   track play out. Only the next track is preloaded (phones). Two music Sounds crossfade
--   (equal-power). Without the soundtrack the old looping "menu" / "war" themes play (play_theme).
-- - Music on/off is persisted per account through the Session's settings ([audio] music_enabled, as
--   the original's user://settings.cfg) and fades smoothly (0.6 s); switched-off music is paused so it
--   resumes where it was.
-- - play_sfx() plays from per-effect voice pools (MAX_SAME Sounds per effect, created once with their
--   SoundId so every play is already loaded — swapping SoundId per play made Sound.Played fire with
--   IsLoaded = false, review P2-7), at most VOICE_COUNT ringing at once, with per-sound throttling,
--   a cap on simultaneous copies and voice-steal priorities; long stings honour cooldowns (a repeat
--   plays a short accent instead).
-- - duck_music() dips the music under big moments (nuke explosions etc. duck automatically).
-- - "Music" and "SFX" SoundGroups under SoundService. Levels are the original's dB values converted
--   with Sound.Volume = 10^(dB/20) (Volume is linear gain, 1 = unity; the assets keep the WAVs' levels).
-- - Sound ids come from Assets/Audio.luau (assets agent); missing entries are skipped silently.
--   Assets/AudioExtra (the studio's other games) and then Assets/AudioUI (the interface kit, from
--   the same packs: tools/assets/upload_sfx_ui.py) replace same-named entries; a replaced sound stays as that
--   name's stand-in, played while the new one has not loaded (still in moderation, or refused).
-- - pop() is the sound of your border growing (added 2026-10-04, so taking land is heard as well as
--   seen): a run of one bubble pop whose rate follows how fast land is being taken, a little
--   higher the longer the run lasts.

local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Airfront")
local Signal = require(Shared.Core.Signal) :: any
local Playlist = require(script.Parent:WaitForChild("Playlist")) :: any

local AudioDirector = {}
AudioDirector.__index = AudioDirector

AudioDirector.SFX_NAMES = {
	"ui_click",
	"ui_hover",
	"ui_open",
	"ui_error",
	"countdown_tick",
	-- BedWars' countdown (Assets/AudioExtra): the last five seconds and the start
	"countdown_tick_5",
	"countdown_tick_4",
	"countdown_tick_3",
	"countdown_tick_2",
	"countdown_tick_1",
	"countdown_gamestart",
	-- Airship BedWars' (AudioExtra): the waiting room opens; a spectator switches player
	"queue_start",
	"spectate_switch",
	"order_ack",
	-- the cosmetic crate opening (UI/CrateOpening; AudioExtra: BedWars / Airship BedWars). They were
	-- missing here, so the show played silent live (until 2026-09-29)
	"crate_drop",
	"crate_land",
	"crate_rattle",
	"crate_preview_common",
	"crate_preview_rare",
	"crate_preview_epic",
	"crate_preview_legendary",
	"crate_open",
	"crate_shimmer",
	"card_whoosh",
	"card_flip",
	"reveal_common",
	"reveal_rare",
	"reveal_epic",
	"reveal_legendary",
	"expand",
	"spawn_confirm",
	"attack_launch",
	"boat_launch",
	"build",
	"warship",
	"nuke_launch",
	"nuke_alarm",
	"nuke_explosion",
	"sam_launch",
	"sam_intercept",
	"shell_fire",
	"shell_hit",
	"shell_splash",
	"ship_sink",
	"under_attack",
	"ally_request",
	"alliance",
	"betrayal",
	"conquer",
	"victory",
	"defeat",
	"game_start",
	-- the interface kit (Assets/AudioUI, 2026-10-04: the interface sounds come from the studio's
	-- own packs rather than being made from scratch): ui_click / ui_hover / ui_open / ui_error are
	-- replaced there too.
	"ui_confirm",
	"ui_back",
	"ui_tab",
	"ui_locked",
	"expand_pop",
	"eliminate",
	"star_tick",
	"star_get",
	"buy_spend",
	"unlock",
}
--- Long stings: a full play at most once per cooldown (ms). A repeat inside the cooldown plays the
--- fallback accent instead ("" = stay silent), so rapid clicks never restart or stack a 2-3 s sting.
AudioDirector.COOLDOWNS = {
	attack_launch = { 1200, "order_ack" },
	boat_launch = { 1500, "order_ack" },
	warship = { 2000, "order_ack" },
	spawn_confirm = { 700, "ui_click" },
	conquer = { 2500, "" },
	betrayal = { 3000, "" },
	alliance = { 2500, "" },
	ally_request = { 1500, "" },
	under_attack = { 4000, "" },
	nuke_alarm = { 2500, "" },
	game_start = { 3000, "" },
	victory = { 10000, "" },
	defeat = { 10000, "" },
}
--- Minimum time between two starts of the same sound (ms) for short / cooldown-free sounds.
AudioDirector.THROTTLE_MS = {
	expand = 150,
	ui_hover = 45,
	ui_click = 30,
	ui_open = 60,
	ui_error = 120,
	countdown_tick = 250,
	order_ack = 80,
	build = 90,
	sam_intercept = 90,
	nuke_launch = 150,
	nuke_explosion = 180,
	sam_launch = 100,
	shell_fire = 120,
	shell_hit = 90,
	shell_splash = 90,
	ship_sink = 400,
	spectate_switch = 150,
	crate_rattle = 90,
	ui_confirm = 60,
	ui_back = 60,
	ui_tab = 40,
	ui_locked = 150,
	expand_pop = 38,
	eliminate = 250,
	star_tick = 28,
	star_get = 120,
	buy_spend = 150,
	unlock = 800,
}
AudioDirector.DEFAULT_THROTTLE_MS = 50
--- At most this many copies of one sound may ring at once (the oldest copy is restarted beyond it).
AudioDirector.MAX_SAME = {
	expand = 2,
	ui_hover = 1,
	ui_click = 2,
	order_ack = 2,
	nuke_alarm = 1,
	attack_launch = 2,
	boat_launch = 2,
	warship = 2,
	sam_launch = 3,
	shell_fire = 3,
	shell_hit = 3,
	shell_splash = 2,
	ship_sink = 2,
	under_attack = 1,
	ally_request = 1,
	victory = 1,
	defeat = 1,
	game_start = 1,
	countdown_tick = 1,
	countdown_gamestart = 1,
	queue_start = 1,
	spectate_switch = 1,
	crate_drop = 1,
	crate_land = 1,
	crate_rattle = 2,
	crate_preview_common = 1,
	crate_preview_rare = 1,
	crate_preview_epic = 1,
	crate_preview_legendary = 1,
	crate_open = 1,
	crate_shimmer = 1,
	card_whoosh = 1,
	card_flip = 1,
	reveal_common = 1,
	reveal_rare = 1,
	reveal_epic = 1,
	reveal_legendary = 1,
	ui_confirm = 2,
	ui_back = 2,
	ui_tab = 2,
	ui_locked = 1,
	-- (a pop rings 0.05 s and up to 20 start a second: a few overlap)
	expand_pop = 6,
	eliminate = 2,
	star_tick = 4,
	star_get = 2,
	buy_spend = 1,
	unlock = 1,
}
AudioDirector.DEFAULT_MAX_SAME = 3
--- Voice-steal priority when every voice is busy (default 1).
AudioDirector.PRIORITY = {
	ui_hover = 0,
	ui_click = 0,
	order_ack = 0,
	expand = 0,
	expand_pop = 0,
	eliminate = 2,
	ui_tab = 0,
	star_tick = 0,
	unlock = 2,
	shell_fire = 0,
	shell_hit = 0,
	shell_splash = 0,
	victory = 2,
	defeat = 2,
	game_start = 2,
	nuke_alarm = 2,
	nuke_explosion = 2,
	under_attack = 2,
	betrayal = 2,
	conquer = 2,
	alliance = 2,
	crate_open = 2,
	reveal_common = 2,
	reveal_rare = 2,
	reveal_epic = 2,
	reveal_legendary = 2,
}
--- Sounds that automatically duck the music: name -> {amount_db, hold_seconds}.
AudioDirector.AUTO_DUCK = {
	nuke_explosion = { 8.0, 2.5 },
	nuke_alarm = { 4.0, 1.8 },
	game_start = { 5.0, 4.0 }, -- (Airship BedWars' 6.7 s start)
	countdown_gamestart = { 5.0, 2.5 },
	under_attack = { 3.0, 1.0 },
	victory = { 14.0, 9.0 },
	defeat = { 14.0, 6.0 },
	betrayal = { 3.0, 1.5 },
	conquer = { 3.0, 1.2 },
	crate_preview_epic = { 3.0, 1.8 },
	crate_preview_legendary = { 4.0, 2.0 },
	crate_open = { 4.0, 1.5 },
	reveal_epic = { 4.0, 2.5 },
	reveal_legendary = { 6.0, 4.0 },
	unlock = { 5.0, 3.0 },
}

--- The border pops (pop()). Speeds are full-size tiles of land gained per second: at POP_SLOW and
--- below a pop every POP_SLOW / POP_RATE_MIN tiles (so slow growth thins out), rising to POP_RATE_MAX
--- pops a second at POP_FAST (measured over ten minutes of a 71-nation match: the median gain is ~60
--- tiles a second, the 95th percentile ~590).
--- The rise is slow at first (POP_CURVE): the rate went up with the log of the speed, which is
--- steepest just above POP_SLOW, so an ordinary creeping border (60 to 100 tiles a second) already
--- popped 5 to 9 times a second, too fast for slow growth (changed 2026-10-07). Now 2 a second at
--- 40, 2.4 at 60, 4 at 100, 8 at 200, 20 at 600.
AudioDirector.POP_SLOW = 40.0
AudioDirector.POP_FAST = 600.0
AudioDirector.POP_RATE_MIN = 2.0
AudioDirector.POP_RATE_MAX = 20.0
AudioDirector.POP_CURVE = 2.0
--- How quickly the speed estimate follows the gains (seconds).
AudioDirector.POP_SMOOTH_S = 0.45
--- At most this many pops for one batch of gains (10 batches a second), the second a moment later.
AudioDirector.POP_PER_BATCH = 2
AudioDirector.POP_SECOND_S = 0.05
--- The pop is one sound (expand_pop). For a day it was one of six bubble pops picked at random, each a
--- different note, which sounded random and chaotic (2026-10-04).
--- Pitch (playback speed). A run of pops warms up slowly: POP_PITCH_MIN from cold, POP_PITCH_MAX after
--- POP_WARM_S of unbroken growth; pops closer together than POP_RUN_GAP_S are one run, and a longer
--- quiet cools it again over POP_COOL_S (it never jumps back). The first version climbed an octave in
--- a second (a pentatonic ladder, a step every 0.2 s) and sat up to 25% higher towards a win: far
--- too high, and it reached its top pitch far too fast (2026-10-04).
AudioDirector.POP_PITCH_MIN = 0.8
AudioDirector.POP_PITCH_MAX = 1.1
AudioDirector.POP_WARM_S = 15.0
AudioDirector.POP_COOL_S = 6.0
AudioDirector.POP_RUN_GAP_S = 0.7
--- Each pop is this much off the run's pitch, either way (just enough not to sound stamped out).
AudioDirector.POP_JITTER = 0.012
--- The whole run sits a touch higher the closer the player is to winning (x1 to x1.05).
AudioDirector.POP_PROGRESS_LIFT = 0.05
--- Level: a small bite POP_DB_MIN, a big one (POP_BIG tiles banked) POP_DB_MAX.
AudioDirector.POP_DB_MIN = -9.0
AudioDirector.POP_DB_MAX = -3.0
AudioDirector.POP_BIG = 60.0

AudioDirector.VOICE_COUNT = 18

--- While one of these rings, the border pops hold off (seconds). 2026-10-17: a first elimination
--- seemed to play no kill sound, because you usually eliminate someone by taking their
--- last land, a big bite that sets off the loudest pops (two at a time, -3 dB, the file levelled 2 dB
--- above the kill sound's) right as the kill sound plays, and the run carries on over it.
AudioDirector.HUSH_POPS = { eliminate = 0.65 }

--- Fetched first, before every other sound and the title's 4 MB music track (the sounds a match needs
--- the moment it happens; the kill sound sat near the end of ~120 fetches, behind the crate show's).
AudioDirector.PRELOAD_FIRST = {
	"eliminate",
	"expand_pop",
	"attack_launch",
	"under_attack",
	"nuke_alarm",
	"nuke_launch",
	"nuke_explosion",
	"conquer",
	"spawn_confirm",
	"order_ack",
	"game_start",
	"countdown_gamestart",
}
AudioDirector.CROSSFADE_S = 2.0
--- Soundtrack: the next track fades in over the last seconds of the one playing.
AudioDirector.TRACK_OVERLAP_S = 2.0
--- Soundtrack: crossfade into a new mood (into war a little faster).
AudioDirector.MOOD_FADE_S = 3.0
AudioDirector.WAR_FADE_S = 2.0
--- Soundtrack: a track that hasn't loaded after this long (an asset still in moderation, a network
--- failure) is skipped and not picked again this session.
AudioDirector.TRACK_LOAD_TIMEOUT_S = 12.0
AudioDirector.TOGGLE_FADE_S = 0.6
AudioDirector.DUCK_ATTACK_DB_PER_S = 60.0
AudioDirector.DUCK_RELEASE_DB_PER_S = 6.0
AudioDirector.SILENT_DB = -80.0
AudioDirector.SETTINGS_SECTION = "audio"
AudioDirector.SETTINGS_KEY = "music_enabled"
--- [audio] pops_enabled: the border pops can be switched off on their own (a Settings toggle, added
--- 2026-10-07). Missing = on.
AudioDirector.SETTINGS_POPS_KEY = "pops_enabled"
--- [audio] music_volume: the music volume slider in Settings (added 2026-10-21), 0..1, missing = 1
--- (the level it always had). The music's gain is its square, so the
--- slider's middle sounds about half as loud rather than barely quieter.
AudioDirector.SETTINGS_VOLUME_KEY = "music_volume"
--- bind_settings holds the music silent until the saved [audio] section arrives (so a player who
--- switched music off never hears the menu theme start), at most this long.
AudioDirector.SETTINGS_WAIT_S = 2.5

local function db_to_volume(db: number): number
	if db <= AudioDirector.SILENT_DB then
		return 0
	end
	return 10 ^ (db / 20)
end

local function move_toward(from: number, to: number, delta: number): number
	if math.abs(to - from) <= delta then
		return to
	end
	return from + math.sign(to - from) * delta
end

local function now_ms(): number
	return os.clock() * 1000
end

--- Once per asset: a sound that did not load is named in the output (the Creator Dashboard's error
--- report only says "Failed to load sound: <reason>", without the asset).
local _reported_fail: { [string]: boolean } = {}
local function report_fetch(content: string, status: Enum.AssetFetchStatus)
	if status ~= Enum.AssetFetchStatus.Success and not _reported_fail[content] then
		_reported_fail[content] = true
		warn(string.format("[Audio] could not load %s (%s)", content, status.Name))
	end
end

type Voice = { sound: Sound, name: string, started: number }

function AudioDirector.new(autoplay_theme: string?)
	local self: any = setmetatable({}, AudioDirector)
	self.music_enabled_changed = Signal.new() -- (on: boolean)
	--- Base level of the music relative to its group (the themes are mastered at -16/-18 LUFS).
	self.music_volume_db = -6.0
	--- The player's music level (Settings slider, 0..1; MUSIC_LEVEL_GAIN of it scales the music).
	self._music_level = 1.0
	self._volume_user_set = false
	--- Base level of all sound effects relative to their group.
	self.sfx_volume_db = 0.0
	self.pops_enabled_changed = Signal.new() -- (on: boolean)
	self._music_on = true
	self._user_set = false
	--- The border pops (pop / pop_once) are on, and whether the player chose that this session.
	self._pops_on = true
	self._pops_user_set = false
	--- Seconds left to wait for the saved music setting (0 = not waiting); see bind_settings.
	self._settings_hold_s = 0.0
	self._session = nil :: any
	self._music_streams = {} :: { [string]: { [string]: any } }
	self._sfx_streams = {} :: { [string]: { [string]: any } }
	self._current = nil :: Sound?
	self._outgoing = nil :: Sound?
	self._current_theme = ""
	self._fade_t = 1.0
	self._fade_len = AudioDirector.CROSSFADE_S
	self._master_gain = 1.0
	self._duck_db = 0.0
	self._duck_target_db = 0.0
	self._duck_hold_s = 0.0
	self._voices = {} :: { Voice }
	--- Music sounds paused because music was switched off (Sound.IsPaused is just "not playing").
	self._toggle_paused = {} :: { [Sound]: boolean }
	self._last_start_ms = {} :: { [string]: number }
	self._last_full_ms = {} :: { [string]: number }
	--- pop(): land banked for pops, the smoothed speed (tiles / s), the last batch's time, when the
	--- run began and when it last popped
	self._pop_debt = 0.0
	self._pop_speed = 0.0
	self._pop_last = -1e9
	self._pop_run_last = -1e9
	--- os.clock() until which the border pops hold off (HUSH_POPS)
	self._pop_hush_until = -1e9
	self._pop_heat = 0.0
	--- Soundtrack (nil when Assets/Soundtrack is missing): the mood asked for, the mood the next
	--- track comes from (victory / defeat give way after one track), the track playing, the next one.
	self._playlist = nil :: any
	self._requested = ""
	self._pool_mood = ""
	self._track = nil :: string?
	self._track_len = 0.0
	self._track_started = 0.0
	self._next = nil :: { mood: string, key: string }?

	local root = Instance.new("Folder")
	root.Name = "AirfrontAudio"
	self._root = root
	self._music_group = self:_group("Music")
	self._sfx_group = self:_group("SFX")
	self._player_a = self:_make_sound("MusicA", self._music_group)
	self._player_b = self:_make_sound("MusicB", self._music_group)
	self._player_a.Looped = true
	self._player_b.Looped = true
	for _, p in { self._player_a, self._player_b } do
		p.Ended:Connect(function()
			-- (a soundtrack track that ended before the overlap started it: the next one now)
			if p == self._current and self._track ~= nil then
				self:_advance()
			end
		end)
	end
	--- effect name -> its own voices (Sounds pre-bound to the effect's asset)
	self._pool = {} :: { [string]: { Voice } }
	root.Parent = SoundService
	self:_load_streams()
	self:_make_voices()
	self._conn = RunService.Heartbeat:Connect(function(dt: number)
		self:_process(dt)
	end)
	-- which sound: Roblox's "Failed to load sound: <reason>" names no asset (370K a day of "User is not
	-- authorized to access Asset" from 2026-10-22 while every id is the group's and our preload reports
	-- none failing): after one, name ours that are still not loaded (_name_failed)
	local okl, LogService = pcall(function()
		return game:GetService("LogService")
	end)
	if okl and LogService ~= nil then
		self._log_conn = LogService.MessageOut:Connect(function(msg: string, kind: Enum.MessageType)
			if kind == Enum.MessageType.MessageError and string.find(msg, "Failed to load sound", 1, true) then
				self:_on_load_failure(msg)
			end
		end)
	end
	local theme = if autoplay_theme == nil then "menu" else autoplay_theme
	if theme ~= "" then
		if self._playlist ~= nil and #self._playlist:pool("title") > 0 then
			self:set_music_mood("title")
		else
			self:play_theme(theme)
		end
	end
	return self
end

--- Persist music on/off through the Session's settings (the section arrives from the server shortly
--- after boot; an explicit toggle before that wins).
function AudioDirector.bind_settings(self: any, session: any)
	self._session = session
	local function apply()
		if not self._user_set then
			local ok, section = pcall(function()
				return session:load_settings(AudioDirector.SETTINGS_SECTION)
			end)
			if ok and type(section) == "table" and type(section[AudioDirector.SETTINGS_KEY]) == "boolean" then
				self:_set_music(section[AudioDirector.SETTINGS_KEY], false)
			end
		end
		if not self._pops_user_set then
			local ok, section = pcall(function()
				return session:load_settings(AudioDirector.SETTINGS_SECTION)
			end)
			if ok and type(section) == "table" and type(section[AudioDirector.SETTINGS_POPS_KEY]) == "boolean" then
				self:_set_pops(section[AudioDirector.SETTINGS_POPS_KEY], false)
			end
		end
		if not self._volume_user_set then
			local ok, section = pcall(function()
				return session:load_settings(AudioDirector.SETTINGS_SECTION)
			end)
			local v = if ok and type(section) == "table" then section[AudioDirector.SETTINGS_VOLUME_KEY] else nil
			if type(v) == "number" and v == v then
				self:_set_music_volume(v, false)
			end
		end
		-- the saved setting is known: the music starts now (or stays off)
		self:_release_hold()
	end
	if session.settings_ready == true then
		apply()
	else
		-- Saved settings arrive from the server a moment after boot. Hold the music silent until then
		-- (bounded): the theme then fades in, or stays off for a player who switched it off.
		self._settings_hold_s = AudioDirector.SETTINGS_WAIT_S
		self._master_gain = 0.0
		self:_apply_music_volume()
	end
	if session.settings_loaded then
		session.settings_loaded:Connect(apply)
	end
end

-- ---------------------------------------------------------------------------------------------
-- Music
-- ---------------------------------------------------------------------------------------------

--- The soundtrack's mood (see the header). Asking for the mood already asked for does nothing.
function AudioDirector.set_music_mood(self: any, mood: string)
	if mood == self._requested then
		return
	end
	local old = self._requested
	self._requested = mood
	local pl = self._playlist
	if pl == nil or #pl:pool(mood) == 0 then
		self:play_theme(if mood == "title" or mood == "wait" then "menu" else "war")
		return
	end
	self._pool_mood = mood
	self._next = nil
	if old == "war" and mood == "calm" and self._track ~= nil then
		return -- the battle track plays out; the next one is calm
	end
	local key = pl:next(mood)
	if key ~= nil then
		self:_start_track(key, if mood == "war" then AudioDirector.WAR_FADE_S else AudioDirector.MOOD_FADE_S)
	end
end

function AudioDirector.music_mood(self: any): string
	return self._requested
end

--- The soundtrack track playing (its key in Assets/Soundtrack), or nil.
function AudioDirector.current_track(self: any): string?
	return self._track
end

function AudioDirector._start_track(self: any, key: string, fade_s: number)
	local t = self._playlist.tracks[key]
	if t == nil then
		return
	end
	self._track = key
	self._track_len = tonumber(t.length) or 0.0
	self._track_started = os.clock()
	self._current_theme = "track:" .. key
	self:_crossfade_to(t.id, fade_s, false)
	-- the one after it, fetched in the background while this one plays
	local m = self._playlist:after(self._pool_mood)
	local nk = self._playlist:next(m)
	self._next = if nk ~= nil then { mood = m, key = nk } else nil
	if nk ~= nil then
		local id = self._playlist.tracks[nk].id
		task.spawn(function()
			local s = Instance.new("Sound")
			s.SoundId = id
			pcall(function()
				ContentProvider:PreloadAsync({ s }, report_fetch)
			end)
			s:Destroy()
		end)
	end
end

--- The track playing is ending: the next one (victory / defeat give way to their AFTER mood).
function AudioDirector._advance(self: any)
	local pl = self._playlist
	if pl == nil then
		return
	end
	self._pool_mood = pl:after(self._pool_mood)
	local nx = self._next
	local key = if nx ~= nil and nx.mood == self._pool_mood then nx.key else pl:next(self._pool_mood)
	self._next = nil
	if key ~= nil then
		self:_start_track(key, AudioDirector.TRACK_OVERLAP_S)
	else
		self._track = nil -- nothing left to play
	end
end

--- Crossfade the music players to asset `id` from its start.
function AudioDirector._crossfade_to(self: any, id: string, fade_s: number, looped: boolean)
	local current: Sound? = self._current
	self._fade_len = math.max(0.01, fade_s)
	local incoming: Sound = if current == self._player_a then self._player_b else self._player_a
	incoming:Stop()
	self._toggle_paused[incoming] = nil
	self._outgoing = if current ~= nil and self:_active(current) then current else nil
	self._current = incoming
	incoming.SoundId = id
	incoming.Looped = looped
	incoming.Volume = 0
	incoming.TimePosition = 0
	incoming:Play()
	if self._master_gain <= 0.0 and not self._music_on then
		incoming:Pause()
		self._toggle_paused[incoming] = true
	end
	self._fade_t = 0.0
	self:_apply_music_volume()
end

--- Crossfade to a looping theme ("menu" or "war"). Calling it with the playing theme does nothing.
function AudioDirector.play_theme(self: any, theme_name: string, crossfade_s: number?)
	local stream = self._music_streams[theme_name]
	if stream == nil then
		return
	end
	self._track = nil
	local current: Sound? = self._current
	if theme_name == self._current_theme and current ~= nil and self:_active(current) then
		return
	end
	self._current_theme = theme_name
	self._fade_len = math.max(0.01, crossfade_s or AudioDirector.CROSSFADE_S)
	local incoming: Sound = if current == self._player_a then self._player_b else self._player_a
	if incoming == self._outgoing and self:_active(incoming) and incoming.SoundId == stream.id then
		-- switching back to the theme that is still fading out: reverse the fade, no restart
		self._outgoing = current
		self._current = incoming
		self._fade_t = 1.0 - self._fade_t
		return
	end
	self:_crossfade_to(stream.id, self._fade_len, true)
end

--- Fade the music out completely (the theme is forgotten; play_theme starts it again).
function AudioDirector.stop_music(self: any, fade_s: number?)
	if self._current == nil then
		return
	end
	if self._outgoing ~= nil then
		self._outgoing:Stop()
		self._toggle_paused[self._outgoing] = nil
	end
	self._outgoing = self._current
	self._current = nil
	self._current_theme = ""
	self._track = nil
	self._requested = ""
	self._fade_len = math.max(0.01, fade_s or 1.0)
	self._fade_t = 0.0
end

function AudioDirector.current_theme(self: any): string
	return self._current_theme
end

function AudioDirector.set_music_enabled(self: any, on: boolean)
	self._user_set = true
	self:_set_music(on, true)
	self:_release_hold()
end

--- End the boot hold (see bind_settings). With music on, the current theme starts as it would have
--- without the hold: from the top, with the usual fade-in.
function AudioDirector._release_hold(self: any)
	if self._settings_hold_s <= 0.0 then
		return
	end
	self._settings_hold_s = 0.0
	local cur: Sound? = self._current
	if self._music_on and cur ~= nil and self._outgoing == nil and cur.IsPlaying then
		cur.TimePosition = 0
		self._fade_t = 0.0
		self._master_gain = 1.0
		self:_apply_music_volume()
	end
end

--- True while the music waits for the saved setting (tests / diagnostics).
function AudioDirector.is_holding(self: any): boolean
	return self._settings_hold_s > 0.0
end

function AudioDirector._set_music(self: any, on: boolean, save: boolean)
	if on == self._music_on then
		return
	end
	self._music_on = on
	if on then
		for p in self._toggle_paused do
			p:Resume()
		end
		table.clear(self._toggle_paused)
	end
	if save and self._session ~= nil then
		local session = self._session
		pcall(function()
			local section = session:load_settings(AudioDirector.SETTINGS_SECTION)
			section[AudioDirector.SETTINGS_KEY] = on
			session:save_settings(AudioDirector.SETTINGS_SECTION, section)
		end)
	end
	self.music_enabled_changed:Fire(on)
end

function AudioDirector.is_music_enabled(self: any): boolean
	return self._music_on
end

--- The gain of slider position `v` (0..1): its square (0.5 -> 0.25, about -12 dB).
function AudioDirector.level_gain(v: number): number
	local c = math.clamp(tonumber(v) or 1.0, 0.0, 1.0)
	return c * c
end

--- The player's music level (0..1). `save`: write it to the saved [audio] section (the slider does
--- when the finger lifts, not at every step of a drag).
function AudioDirector.set_music_volume(self: any, v: number, save: boolean?)
	self._volume_user_set = true
	self:_set_music_volume(v, save == true)
end

function AudioDirector._set_music_volume(self: any, v: number, save: boolean)
	local c = math.clamp(tonumber(v) or 1.0, 0.0, 1.0)
	self._music_level = c
	self:_apply_music_volume()
	if save and self._session ~= nil then
		local session = self._session
		pcall(function()
			local section = session:load_settings(AudioDirector.SETTINGS_SECTION)
			section[AudioDirector.SETTINGS_VOLUME_KEY] = math.floor(c * 100 + 0.5) / 100
			session:save_settings(AudioDirector.SETTINGS_SECTION, section)
		end)
	end
end

function AudioDirector.music_volume(self: any): number
	return self._music_level
end

--- The border pops on or off (saved like the music setting).
function AudioDirector.set_pops_enabled(self: any, on: boolean)
	self._pops_user_set = true
	self:_set_pops(on, true)
end

function AudioDirector._set_pops(self: any, on: boolean, save: boolean)
	if on == self._pops_on then
		return
	end
	self._pops_on = on
	if not on then
		-- nothing banked plays when they come back on
		self._pop_debt = 0.0
		self._pop_speed = 0.0
		self._pop_heat = 0.0
	end
	if save and self._session ~= nil then
		local session = self._session
		pcall(function()
			local section = session:load_settings(AudioDirector.SETTINGS_SECTION)
			section[AudioDirector.SETTINGS_POPS_KEY] = on
			session:save_settings(AudioDirector.SETTINGS_SECTION, section)
		end)
	end
	self.pops_enabled_changed:Fire(on)
end

function AudioDirector.is_pops_enabled(self: any): boolean
	return self._pops_on
end

--- Convenience for a music hotkey / HUD toggle. Returns the new state.
function AudioDirector.toggle_music(self: any): boolean
	self:set_music_enabled(not self._music_on)
	return self._music_on
end

--- Temporarily lower the music by amount_db for `seconds`, then let it recover smoothly.
--- Overlapping calls keep the deepest amount and the longest hold.
function AudioDirector.duck_music(self: any, amount_db: number, seconds: number)
	local target = -math.abs(amount_db)
	if self._duck_hold_s > 0.0 then
		self._duck_target_db = math.min(self._duck_target_db, target)
		self._duck_hold_s = math.max(self._duck_hold_s, seconds)
	else
		self._duck_target_db = target
		self._duck_hold_s = seconds
	end
end

-- ---------------------------------------------------------------------------------------------
-- Sound effects
-- ---------------------------------------------------------------------------------------------

--- Play a one-shot effect by name (see SFX_NAMES). pitch_jitter is a fraction (0.05 = +/-5 %).
--- Cues replaced by another sound. attack_launch (the original's taiko + brass sting) → the short
--- order tap: launching an attack gets a quiet acknowledgement instead of the sting
--- (2026-09-26).
AudioDirector.REPLACE = { attack_launch = "order_ack" }
--- Per-sound level trims in dB (the conquest sting was a little loud, 2026-09-26).
AudioDirector.TRIM_DB = { conquer = -6.0 }

function AudioDirector.play_sfx(
	self: any,
	sfx_name: string,
	volume_db: number?,
	pitch_jitter: number?,
	pitch: number?
)
	sfx_name = AudioDirector.REPLACE[sfx_name] or sfx_name
	local stream = self._sfx_streams[sfx_name]
	if stream == nil then
		return
	end
	local vol_db = volume_db or 0.0
	local jitter = pitch_jitter or 0.0
	local now = now_ms()
	local cd = AudioDirector.COOLDOWNS[sfx_name]
	if cd ~= nil then
		local last = self._last_full_ms[sfx_name]
		if last ~= nil and now - last < cd[1] then
			local fallback = cd[2]
			if fallback ~= "" and fallback ~= sfx_name then
				self:play_sfx(fallback, vol_db, jitter)
			end
			return
		end
		self._last_full_ms[sfx_name] = now
	else
		local gap = AudioDirector.THROTTLE_MS[sfx_name] or AudioDirector.DEFAULT_THROTTLE_MS
		local last = self._last_start_ms[sfx_name]
		if last ~= nil and now - last < gap then
			return
		end
	end
	self._last_start_ms[sfx_name] = now
	local v: Voice? = self:_pick_voice(sfx_name)
	if v == nil then
		return
	end
	if not v.sound.IsLoaded then
		-- not here yet (or it never will be: refused by moderation): the sound it replaced
		local stand_in = sfx_name .. "~"
		if self._pool[stand_in] ~= nil then
			local sv: Voice? = self:_pick_voice(stand_in)
			if sv ~= nil and sv.sound.IsLoaded then
				v = sv
				stream = self._sfx_streams[stand_in]
			end
		end
	end
	local s = (v :: Voice).sound
	s:Stop()
	s.Volume = db_to_volume(self.sfx_volume_db + vol_db + (AudioDirector.TRIM_DB[sfx_name] or 0.0))
	local j = math.abs(jitter)
	s.PlaybackSpeed = if pitch ~= nil
		then math.clamp(pitch, 0.25, 4.0)
		elseif j > 0.0 then math.clamp(1.0 + (math.random() * 2 - 1) * j, 0.25, 4.0)
		else 1.0
	s.TimePosition = if stream.region ~= nil then stream.region.Min else 0
	s:Play()
	local hush = AudioDirector.HUSH_POPS[sfx_name]
	if hush ~= nil then
		self._pop_hush_until = math.max(self._pop_hush_until, os.clock() + hush)
	end
	local played: Voice = v :: Voice
	played.started = now
	local d = AudioDirector.AUTO_DUCK[sfx_name]
	if d ~= nil then
		self:duck_music(d[1], d[2])
	end
end

function AudioDirector.has_sfx(self: any, sfx_name: string): boolean
	return self._sfx_streams[sfx_name] ~= nil
end

--- Pops a second at a land-gain speed of `speed` full-size tiles a second (see POP_*).
function AudioDirector.pop_rate(speed: number): number
	local A = AudioDirector
	if speed <= A.POP_SLOW then
		return A.POP_RATE_MIN * math.max(speed, 0) / A.POP_SLOW
	end
	local k = math.min(math.log(speed / A.POP_SLOW) / math.log(A.POP_FAST / A.POP_SLOW), 1)
	return A.POP_RATE_MIN + (A.POP_RATE_MAX - A.POP_RATE_MIN) * k ^ A.POP_CURVE
end

--- The local player's border grew by `tiles` (full-size tiles) in this batch of changes; `progress`
--- (0..1) is how close they are to winning. Banks the land and plays the pops it has earned.
function AudioDirector.pop(self: any, tiles: number, progress: number?)
	if tiles <= 0 or not self._pops_on or self._sfx_streams["expand_pop"] == nil then
		return
	end
	local A = AudioDirector
	local now = os.clock()
	local dt = math.clamp(now - self._pop_last, 0.1, 3.0)
	self._pop_last = now
	self._pop_speed += (tiles / dt - self._pop_speed) * (1 - math.exp(-dt / A.POP_SMOOTH_S))
	local speed = self._pop_speed
	-- land per pop: fixed at slow speeds, speed / rate above
	local per = if speed <= A.POP_SLOW then A.POP_SLOW / A.POP_RATE_MIN else speed / A.pop_rate(speed)
	self._pop_debt = math.min(self._pop_debt + tiles, math.max(A.POP_BIG, per * 2))
	if self._pop_debt < per then
		return
	end
	local n = math.min(math.floor(self._pop_debt / per), A.POP_PER_BATCH)
	local bite = self._pop_debt
	self._pop_debt = math.min(self._pop_debt - n * per, per)
	-- the run warms up while the pops keep coming, and cools in the quiet between runs
	local quiet = now - self._pop_run_last
	self._pop_run_last = now
	if quiet <= A.POP_RUN_GAP_S then
		self._pop_heat = math.min(1, self._pop_heat + quiet / A.POP_WARM_S)
	else
		self._pop_heat = math.max(0, self._pop_heat - (quiet - A.POP_RUN_GAP_S) / A.POP_COOL_S)
	end
	local lift = 1 + A.POP_PROGRESS_LIFT * math.clamp(progress or 0, 0, 1)
	local pitch = A.pop_pitch(self._pop_heat) * lift
	local db = A.POP_DB_MIN + (A.POP_DB_MAX - A.POP_DB_MIN) * math.sqrt(math.clamp(bite / A.POP_BIG, 0, 1))
	local function strike()
		if os.clock() < self._pop_hush_until then
			return -- (the kill sound rings: HUSH_POPS)
		end
		self:play_sfx("expand_pop", db, 0, pitch * (1 + (math.random() * 2 - 1) * A.POP_JITTER))
	end
	strike()
	if n >= 2 then
		task.delay(A.POP_SECOND_S, strike)
	end
end

--- One pop, outside any run (picking a start).
function AudioDirector.pop_once(self: any)
	if not self._pops_on then
		return
	end
	self:play_sfx("expand_pop", AudioDirector.POP_DB_MAX, 0, 1.0)
end

--- The playback speed of a pop in a run that is `heat` (0 cold .. 1 warm) along.
function AudioDirector.pop_pitch(heat: number): number
	local A = AudioDirector
	return A.POP_PITCH_MIN + (A.POP_PITCH_MAX - A.POP_PITCH_MIN) * math.clamp(heat, 0, 1)
end


--- A voice of `sfx_name`'s own pool: restart its oldest copy beyond MAX_SAME, else an idle one. When
--- VOICE_COUNT effects already ring, the least important, oldest other voice is stopped — never a
--- more important one (then nil: the new sound is dropped).
function AudioDirector._pick_voice(self: any, sfx_name: string): Voice?
	local pool = self._pool[sfx_name]
	if pool == nil then
		return nil
	end
	local limit = AudioDirector.MAX_SAME[sfx_name] or AudioDirector.DEFAULT_MAX_SAME
	local same = 0
	local oldest_same: Voice? = nil
	local idle: Voice? = nil
	for _, v in pool do
		if v.sound.IsPlaying then
			same += 1
			if oldest_same == nil or v.started < oldest_same.started then
				oldest_same = v
			end
		elseif idle == nil then
			idle = v
		end
	end
	if (same >= limit or idle == nil) and oldest_same ~= nil then
		return oldest_same
	end
	local total = 0
	local victim: Voice? = nil
	local victim_prio = 99
	for _, v in self._voices do
		if v.sound.IsPlaying then
			total += 1
			local prio = AudioDirector.PRIORITY[v.name] or 1
			if prio < victim_prio or (prio == victim_prio and victim ~= nil and v.started < victim.started) then
				victim = v
				victim_prio = prio
			end
		end
	end
	if total >= AudioDirector.VOICE_COUNT and victim ~= nil then
		if victim_prio > (AudioDirector.PRIORITY[sfx_name] or 1) then
			return nil
		end
		victim.sound:Stop()
	end
	return idle
end

--- One pool per effect, each Sound bound to its asset (and sprite region) once, up front.
function AudioDirector._make_voices(self: any)
	local names = table.clone(AudioDirector.SFX_NAMES)
	for _, name in AudioDirector.SFX_NAMES do
		-- (the sound a newer one replaced: its stand-in while that one isn't loaded)
		if self._sfx_streams[name .. "~"] ~= nil then
			table.insert(names, name .. "~")
		end
	end
	for _, name in names do
		local stream = self._sfx_streams[name]
		if stream == nil then
			continue
		end
		local pool = {}
		local copies = if string.sub(name, -1) == "~"
			then 1
			else AudioDirector.MAX_SAME[name] or AudioDirector.DEFAULT_MAX_SAME
		for i = 1, copies do
			local s = self:_make_sound(string.format("Sfx_%s_%d", name, i), self._sfx_group)
			s.SoundId = stream.id
			if stream.region ~= nil then
				s.PlaybackRegionsEnabled = true
				s.PlaybackRegion = stream.region
			end
			local v: Voice = { sound = s, name = name, started = 0 }
			table.insert(pool, v)
			table.insert(self._voices, v)
		end
		self._pool[name] = pool
	end
end

-- ---------------------------------------------------------------------------------------------
-- Internals
-- ---------------------------------------------------------------------------------------------

function AudioDirector._process(self: any, dt: number)
	-- soundtrack: the next track fades in over the end of this one
	local cur: Sound? = self._current
	if
		self._track ~= nil
		and cur ~= nil
		and self._music_on
		and not cur.IsLoaded
		and os.clock() - self._track_started > AudioDirector.TRACK_LOAD_TIMEOUT_S
	then
		-- never loaded: drop it from the playlist and go on
		self._playlist.tracks[self._track :: string] = nil
		self:_advance()
		cur = self._current
	end
	if self._track ~= nil and cur ~= nil and cur.IsPlaying then
		local len = if cur.TimeLength > 0 then cur.TimeLength else self._track_len
		if len > AudioDirector.TRACK_OVERLAP_S and cur.TimePosition >= len - AudioDirector.TRACK_OVERLAP_S then
			self:_advance()
		end
	end
	if self._fade_t < 1.0 then
		self._fade_t = math.min(1.0, self._fade_t + dt / self._fade_len)
		if self._fade_t >= 1.0 and self._outgoing ~= nil then
			self._outgoing:Stop()
			self._toggle_paused[self._outgoing] = nil
			self._outgoing = nil
		end
	end
	if self._duck_hold_s > 0.0 then
		self._duck_hold_s -= dt
		self._duck_db = move_toward(self._duck_db, self._duck_target_db, AudioDirector.DUCK_ATTACK_DB_PER_S * dt)
	else
		self._duck_target_db = 0.0
		self._duck_db = move_toward(self._duck_db, 0.0, AudioDirector.DUCK_RELEASE_DB_PER_S * dt)
	end
	local target = if self._music_on then 1.0 else 0.0
	if self._settings_hold_s > 0.0 then
		if self._settings_hold_s > dt then
			self._settings_hold_s -= dt
			target = 0.0
		else
			self:_release_hold() -- no settings in time (offline / slow server): start anyway
		end
	end
	self._master_gain = move_toward(self._master_gain, target, dt / AudioDirector.TOGGLE_FADE_S)
	self:_apply_music_volume()
end

function AudioDirector._apply_music_volume(self: any)
	local g_in = math.sin(self._fade_t * math.pi * 0.5) * self._master_gain
	local g_out = math.cos(self._fade_t * math.pi * 0.5) * self._master_gain
	if self._current ~= nil then
		self._current.Volume = self:_gain_volume(g_in)
	end
	if self._outgoing ~= nil then
		self._outgoing.Volume = self:_gain_volume(g_out)
	end
	-- pause silent music while it is switched off (keeps its position for when it comes back)
	if not self._music_on and self._master_gain <= 0.0 then
		self:_pause_silent(self._player_a)
		self:_pause_silent(self._player_b)
	end
end

function AudioDirector._pause_silent(self: any, p: Sound)
	if p.IsPlaying then
		p:Pause()
		self._toggle_paused[p] = true
	end
end

--- Playing, or paused only because music is switched off.
function AudioDirector._active(self: any, s: Sound): boolean
	return s.IsPlaying or self._toggle_paused[s] == true
end

function AudioDirector._gain_volume(self: any, g: number): number
	if g <= 0.0005 then
		return 0
	end
	-- linear_to_db(g) + music_volume_db + duck_db, as a linear Sound.Volume, times the player's level
	return g * db_to_volume(self.music_volume_db + self._duck_db) * AudioDirector.level_gain(self._music_level)
end

function AudioDirector._group(self: any, name: string): SoundGroup
	local g = Instance.new("SoundGroup")
	g.Name = name
	g.Volume = 1
	g.Parent = self._root
	return g
end

function AudioDirector._make_sound(self: any, name: string, group: SoundGroup): Sound
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundGroup = group
	s.Volume = 0
	s.Parent = self._root
	return s
end

function AudioDirector._load_streams(self: any)
	local ok, manifest = pcall(function()
		local m = Shared:FindFirstChild("Assets") and Shared.Assets:FindFirstChild("Audio")
		return if m then (require :: any)(m) else nil
	end)
	if not ok or type(manifest) ~= "table" then
		return
	end
	local preload = {}
	-- the soundtrack: only the title's opener up front (each track is ~4 MB; the next one is fetched
	-- while one plays)
	local ok_st, st = pcall(function()
		local m = Shared:FindFirstChild("Assets") and Shared.Assets:FindFirstChild("Soundtrack")
		return if m then (require :: any)(m) else nil
	end)
	if ok_st and type(st) == "table" and type(st.tracks) == "table" and next(st.tracks) ~= nil then
		self._playlist = Playlist.new(st)
		local opener = (st.moods and st.moods.title or {})[1]
		local t = opener and st.tracks[opener]
		if t ~= nil then
			table.insert(preload, t.id)
		end
	end
	for theme_name, e in manifest.music or {} do
		if type(e) == "table" and type(e.id) == "string" then
			self._music_streams[theme_name] = { id = e.id, length = e.length }
			if self._playlist == nil then
				table.insert(preload, e.id)
			end
		end
	end
	-- Assets/AudioExtra (sounds from the studio's other games) replaces same-named entries
	local ok_x, extra = pcall(function()
		local m = Shared:FindFirstChild("Assets") and Shared.Assets:FindFirstChild("AudioExtra")
		return if m then (require :: any)(m) else nil
	end)
	local extra_sfx = if ok_x and type(extra) == "table" and type(extra.sfx) == "table" then extra.sfx else {}
	-- Assets/AudioUI (the interface kit) replaces both
	local ok_u, ui = pcall(function()
		local m = Shared:FindFirstChild("Assets") and Shared.Assets:FindFirstChild("AudioUI")
		return if m then (require :: any)(m) else nil
	end)
	local ui_sfx = if ok_u and type(ui) == "table" and type(ui.sfx) == "table" then ui.sfx else {}
	local function stream_of(e: any): any
		if type(e) ~= "table" then
			return nil
		end
		if type(e.id) == "string" then
			return { id = e.id, length = e.length }
		elseif type(e.sprite) == "string" and type(e.start) == "number" and type(e.stop) == "number" then
			return { id = e.sprite, region = NumberRange.new(e.start, e.stop), length = e.length }
		end
		return nil
	end
	for _, name in AudioDirector.SFX_NAMES do
		local older = stream_of(extra_sfx[name] or (manifest.sfx and manifest.sfx[name]))
		local newer = stream_of(ui_sfx[name])
		local chosen = newer or older
		if chosen ~= nil then
			self._sfx_streams[name] = chosen
			table.insert(preload, chosen.id)
		end
		if newer ~= nil and older ~= nil then
			self._sfx_streams[name .. "~"] = older
			table.insert(preload, older.id)
		end
	end
	-- Fetch every sound in the background so the first play of each is instant: the ones a match needs
	-- the moment they happen first (PRELOAD_FIRST), then the rest (each id once). Always through
	-- throwaway copies: v89 (2026-10-17) preloaded the first ones' own voices instead, and in some
	-- sessions that preload failed ("Failed to load sound: User is not authorized to access Asset",
	-- from a few hundred a day to ~48,000; our "[Audio] could not load" named exactly those 12 sounds,
	-- ~53,000 a day), so the kill sound it meant to make sure of was among the ones failing.
	local first, seen = {}, {}
	for _, name in AudioDirector.PRELOAD_FIRST do
		local st = self._sfx_streams[name]
		if st ~= nil and not seen[st.id] then
			seen[st.id] = true
			table.insert(first, st.id)
		end
	end
	local rest = {}
	for _, id in preload do
		if not seen[id] then
			seen[id] = true
			table.insert(rest, id)
		end
	end
	task.spawn(function()
		for _, batch in { first, rest } do
			local list = {}
			for _, id in batch do
				local s = Instance.new("Sound")
				s.SoundId = id
				table.insert(list, s)
			end
			pcall(function()
				ContentProvider:PreloadAsync(list, report_fetch)
			end)
			for _, s in list do
				s:Destroy()
			end
		end
	end)
end

--- Seconds after a "Failed to load sound" before looking at which of ours never loaded (one that is
--- merely slow has loaded by then).
AudioDirector.FAILURE_CHECK_S = 4.0
local _named_fail: { [string]: boolean } = {}
local _foreign_reported = false

--- The engine said a sound failed to load: once the moment has passed, warn the asset of each of ours
--- that still isn't loaded (once per asset a session), or, when all of ours are loaded, that the
--- failing one isn't the game's (once a session). Several failures in a moment make one check.
function AudioDirector._on_load_failure(self: any, msg: string)
	-- ("Failed to load sound rbxassetid://123: User is not authorized to access Asset.": the dashboard
	-- shows it without the id)
	self._fail_reason = string.sub(string.match(msg, "Failed to load sound.-: (.*)$") or msg, 1, 80)
	self._fail_ids = self._fail_ids or {}
	local id = string.match(msg, "rbxassetid://%d+")
	if id ~= nil then
		self._fail_ids[id] = true
	end
	if self._fail_check then
		return
	end
	self._fail_check = true
	task.delay(AudioDirector.FAILURE_CHECK_S, function()
		self._fail_check = false
		local root = self._root
		if root == nil or root.Parent == nil then
			return
		end
		local ours = 0
		for _, s in root:GetDescendants() do
			if s:IsA("Sound") and s.SoundId ~= "" and not s.IsLoaded then
				ours += 1
				local id = s.SoundId
				if not _named_fail[id] then
					_named_fail[id] = true
					-- (no quote or comma in the text: the error report keeps it whole)
					warn(string.format("[Audio] did not load %s %s after %s", id, s.Name, tostring(self._fail_reason)))
				end
			end
		end
		if ours == 0 and not _foreign_reported then
			_foreign_reported = true
			local ids = {}
			for id in self._fail_ids or {} do
				table.insert(ids, id)
			end
			table.sort(ids)
			warn(
				"[Audio] a sound outside the game's failed to load: "
					.. table.concat(ids, " ", 1, math.min(#ids, 3))
					.. " "
					.. tostring(self._fail_reason)
			)
		end
		self._fail_ids = {}
	end)
end

function AudioDirector.destroy(self: any)
	if self._conn then
		self._conn:Disconnect()
	end
	if self._log_conn then
		self._log_conn:Disconnect()
		self._log_conn = nil
	end
	self._root:Destroy()
end

return AudioDirector
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">MusicMood</string>
              <string name="Source"><![CDATA[--!strict
-- Which soundtrack mood fits the moment (AudioDirector.set_music_mood). Pure logic, polled by UIRoot:
--   title    the title screen                     wait     a public match's waiting room
--   calm     a match, no fighting                 war      fighting a nation or a player
--   victory  the match is over and we won          defeat   the match is over for us (lost, or out)
-- War: an attack between us and a nation or a player (tribes don't count — early expansion isn't a
-- war) or a nuke of ours or at our land; it lasts WAR_HOLD_S after the last sign of fighting, so the
-- music doesn't flip back and forth.

local MusicMood = {}
MusicMood.__index = MusicMood

MusicMood.WAR_HOLD_S = 40.0
local KIND_TRIBE = 1 -- Defs.KIND_TRIBE

export type Input = {
	screen: string, -- UIRoot screen: "title", "spawn", "play", "over"
	waiting: boolean, -- queued for / in a public match's waiting room
	me: number, -- our nation (0: spectating)
	alive: boolean,
	winner: number,
	fighting: boolean, -- MusicMood.fighting(state, me) this poll
}

function MusicMood.new()
	local self = setmetatable({}, MusicMood) :: any
	self._war_until = -math.huge
	return self
end

--- Any sign of war for `me` in `st` (GameState): attacks with a nation / player, nukes.
function MusicMood.fighting(st: any, me: number): boolean
	if st == nil or me == 0 then
		return false
	end
	local owners = st.owners or {}
	local function rival(id: number): boolean
		local o = owners[id]
		return id ~= 0 and id ~= me and o ~= nil and o.kind ~= KIND_TRIBE
	end
	for _, a in st.attacks or {} do
		if (a.attacker == me and rival(a.target)) or (a.target == me and rival(a.attacker)) then
			return true
		end
	end
	local tile_owner = st.tile_owner
	for _, n in st.nukes or {} do
		if n.owner == me then
			return true
		end
		if tile_owner ~= nil and tile_owner(st, n.to_tile) == me then
			return true
		end
	end
	return false
end

function MusicMood.mood(self: any, input: Input, now_s: number): string
	if input.screen == "title" then
		self._war_until = -math.huge
		return if input.waiting then "wait" else "title"
	end
	if input.me == 0 then
		return "calm" -- watching a match
	end
	if input.screen == "over" or not input.alive then
		return if input.winner ~= 0 and input.winner == input.me then "victory" else "defeat"
	end
	if input.fighting then
		self._war_until = now_s + MusicMood.WAR_HOLD_S
	end
	return if now_s < self._war_until then "war" else "calm"
end

return MusicMood
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">Playlist</string>
              <string name="Source"><![CDATA[--!strict
-- The soundtrack's playlists (Assets/Soundtrack.luau): which track plays next in a mood. Pure logic
-- (no Roblox services), used by AudioDirector.
--
--   Playlist.new(manifest, rand?)       manifest = {tracks = {key = {id, length, ...}}, moods = {mood = {keys}}}
--   :pool(mood)                         the mood's playable track keys (FALLBACK moods when empty)
--   :next(mood)                         the next key: the title's opener first, then shuffled — never one
--                                       of the last few played (HISTORY, at most half the pool)
--   :after(mood)                        the mood that follows once a track of `mood` ended (victory and
--                                       defeat play once)

local Playlist = {}
Playlist.__index = Playlist

Playlist.HISTORY = 6
--- A mood without tracks borrows another's.
Playlist.FALLBACK = { wait = "calm", calm = "title", war = "calm", victory = "title", defeat = "calm" }
--- A mood that plays one track, then gives way to another.
Playlist.AFTER = { victory = "title", defeat = "calm" }
--- Plays first, once per session, the first time the mood plays.
Playlist.OPENERS = { title = true }

function Playlist.new(manifest: any, rand: (() -> number)?)
	local self = setmetatable({}, Playlist) :: any
	self.tracks = if type(manifest) == "table" and type(manifest.tracks) == "table" then manifest.tracks else {}
	self.moods = if type(manifest) == "table" and type(manifest.moods) == "table" then manifest.moods else {}
	self._rand = rand or math.random
	self._history = {} :: { string }
	self._opened = {} :: { [string]: boolean }
	return self
end

function Playlist.pool(self: any, mood: string): { string }
	local seen = {}
	local m: string? = mood
	while m ~= nil and not seen[m] do
		seen[m] = true
		local out = {}
		for _, k in self.moods[m] or {} do
			local t = self.tracks[k]
			if type(t) == "table" and type(t.id) == "string" then
				table.insert(out, k)
			end
		end
		if #out > 0 then
			return out
		end
		m = Playlist.FALLBACK[m]
	end
	return {}
end

function Playlist.next(self: any, mood: string): string?
	local pool = self:pool(mood)
	if #pool == 0 then
		return nil
	end
	local pick: string? = nil
	if Playlist.OPENERS[mood] and not self._opened[mood] then
		self._opened[mood] = true
		pick = pool[1]
	else
		local recent = {}
		local keep = math.min(Playlist.HISTORY, #pool // 2)
		for i = #self._history, math.max(1, #self._history - keep + 1), -1 do
			recent[self._history[i]] = true
		end
		local fresh = {}
		for _, k in pool do
			if not recent[k] then
				table.insert(fresh, k)
			end
		end
		if #fresh == 0 then
			fresh = pool
		end
		pick = fresh[math.clamp(math.floor(self._rand() * #fresh) + 1, 1, #fresh)]
	end
	table.insert(self._history, pick :: string)
	if #self._history > 32 then
		table.remove(self._history, 1)
	end
	return pick
end

function Playlist.after(_self: any, mood: string): string
	return Playlist.AFTER[mood] or mood
end

return Playlist
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/main.gd: the client root. Creates the AudioDirector, the globe (WorldView) and the
-- interface (UIRoot), wires them to the Session, and owns the top-bar buttons that the original put in
-- Airship's HUD bar: Music toggle (also key M), Help, Leaderboard, Home → focus your nation (also key
-- Home) and the Game menu. The buttons sit in Roblox's own top-bar row, right of Roblox's menu / chat
-- buttons (GuiService.TopbarInset), styled like them. Match-only buttons hide on the title screen.
--
-- UIRoot must NOT bind M / Home or call world:bind_state itself (DESIGN.md §10).
-- Missing modules (during development) are skipped so boot never errors.

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Session = require(script.Parent.Session) :: any
local AudioDirector = require(script.Parent.Audio.AudioDirector) :: any

local Main = {}
Main.session = nil :: any
Main.world = nil :: any
Main.ui = nil :: any
Main.audio = nil :: any
--- Boot timeline (os.clock seconds; diagnostics): start, session (title world requested), ui (UIRoot
--- built), first_state (first world live).
Main.boot = {} :: { [string]: number }

-- Top-bar geometry and look, measured from Roblox's own TopBarApp (menu button / unibar): 44 px
-- circles filled RGB(18,18,21) at 0.08 transparency, 36 px icon frames, 8 px apart, top edge 12 px
-- below the screen top (TopbarInset height 58), white state overlay on hover / press.
local BUTTON = 44
local GAP = 8
local ICON = 36 -- the hud_* masks keep Airship's 0.7 inset framing (glyph ≈ 25 px)
local FILL = Color3.fromRGB(18, 18, 21)
local FILL_T = 0.08
local OVERLAY_T = 1.0
local OVERLAY_HOVER_T = 0.92
local OVERLAY_PRESS_T = 0.84

local function optional(parent: Instance?, path: { string }): any
	local node: Instance? = parent
	for _, name in path do
		if node == nil then
			return nil
		end
		node = (node :: Instance):FindFirstChild(name)
	end
	if node == nil or not node:IsA("ModuleScript") then
		return nil
	end
	local ok, mod = pcall(require, node)
	if not ok then
		warn("[RoWorld] could not load " .. node:GetFullName() .. ": " .. tostring(mod))
		return nil
	end
	return mod
end

local call_warned: { [string]: boolean } = {}

--- Calls obj:method(...) if it exists. A failing view / UI call is reported once per method and never
--- breaks the wiring (Godot logs a script error in a signal handler and carries on).
local function call(obj: any, method: string, ...: any): any
	if obj == nil then
		return nil
	end
	local f = obj[method]
	if type(f) ~= "function" then
		return nil
	end
	local ok, res = xpcall(f, debug.traceback, obj, ...)
	if not ok then
		if not call_warned[method] then
			call_warned[method] = true
			warn("[RoWorld] " .. method .. " failed: " .. tostring(res))
		end
		return nil
	end
	return res
end

--- Roblox's CoreGui toggles can fail until the CoreScripts are ready: retry briefly.
local function hide_core_guis()
	task.spawn(function()
		for _ = 1, 50 do
			local ok = pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, false)
			end)
			if ok then
				pcall(function()
					StarterGui:SetCore("ResetButtonCallback", false)
				end)
				return
			end
			task.wait(0.2)
		end
	end)
end

-- =============================================================================================
-- Top bar
-- =============================================================================================

type Hud = { gui: ScreenGui, bar: Frame, buttons: { [string]: any }, tip: TextLabel }

local hud: Hud? = nil

local function icon_id(name: string): string?
	local icons = optional(ReplicatedStorage:FindFirstChild("Airfront"), { "Assets", "UiIcons" })
	if type(icons) ~= "table" then
		return nil
	end
	local id = icons["hud_" .. name]
	return if type(id) == "string" then id else nil
end

local FALLBACK_GLYPH =
	{ music_on = "♪", music_off = "♪", help = "?", leaderboard = "≡", globe = "⌂", exit = "⏻", settings = "⚙" }

local function show_tip(h: Hud, button: GuiObject?, text: string?)
	local tip = h.tip
	if button == nil or text == nil or UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		tip.Visible = false
		return
	end
	tip.Text = text
	-- AbsolutePosition is relative to the area below the top-bar inset even in this IgnoreGuiInset
	-- ScreenGui (a button at screen y = 12 reports -46); the tip is positioned in screen space.
	local pos = button.AbsolutePosition + GuiService:GetGuiInset()
	local size = button.AbsoluteSize
	tip.Position = UDim2.fromOffset(pos.X + size.X / 2, pos.Y + size.Y + 8)
	tip.Visible = true
end

local function make_button(h: Hud, key: string, icon: string, tooltip: string, order: number, on_press: () -> ()): any
	local b = Instance.new("ImageButton")
	b.Name = key
	b.LayoutOrder = order
	b.Size = UDim2.fromOffset(BUTTON, BUTTON)
	b.AutoButtonColor = false
	b.BackgroundColor3 = FILL
	b.BackgroundTransparency = FILL_T
	b.BorderSizePixel = 0
	b.Image = ""
	b.Selectable = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = b
	local overlay = Instance.new("Frame")
	overlay.Name = "StateOverlay"
	overlay.BackgroundColor3 = Color3.new(1, 1, 1)
	overlay.BackgroundTransparency = OVERLAY_T
	overlay.BorderSizePixel = 0
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.ZIndex = 2
	local oc = Instance.new("UICorner")
	oc.CornerRadius = UDim.new(1, 0)
	oc.Parent = overlay
	overlay.Parent = b
	local img = Instance.new("ImageLabel")
	img.Name = "Icon"
	img.BackgroundTransparency = 1
	img.AnchorPoint = Vector2.new(0.5, 0.5)
	img.Position = UDim2.fromScale(0.5, 0.5)
	img.Size = UDim2.fromOffset(ICON, ICON)
	img.ScaleType = Enum.ScaleType.Fit
	img.ImageColor3 = Color3.new(1, 1, 1)
	img.ZIndex = 3
	img.Parent = b
	local glyph = Instance.new("TextLabel")
	glyph.Name = "Glyph"
	glyph.BackgroundTransparency = 1
	glyph.Size = UDim2.fromScale(1, 1)
	glyph.FontFace = Font.fromId(12187365977, Enum.FontWeight.Bold)
	glyph.TextSize = 20
	glyph.TextColor3 = Color3.new(1, 1, 1)
	glyph.Visible = false
	glyph.ZIndex = 3
	glyph.Parent = b
	local entry = { button = b, icon = img, glyph = glyph, tooltip = tooltip }
	local function set_icon(name: string)
		local id = icon_id(name)
		if id then
			img.Image = id
			img.Visible = true
			glyph.Visible = false
		else
			img.Visible = false
			glyph.Text = FALLBACK_GLYPH[name] or "•"
			glyph.Visible = true
		end
		-- music off: the fallback glyph is dimmed (the real icon has its own slash)
		glyph.TextTransparency = if name == "music_off" then 0.55 else 0
	end
	entry.set_icon = set_icon
	set_icon(icon)
	local function tween(t: number)
		TweenService:Create(
			overlay,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ BackgroundTransparency = t }
		):Play()
	end
	b.MouseEnter:Connect(function()
		tween(OVERLAY_HOVER_T)
		show_tip(h, b, entry.tooltip)
	end)
	b.MouseLeave:Connect(function()
		tween(OVERLAY_T)
		show_tip(h, nil, nil)
	end)
	b.MouseButton1Down:Connect(function()
		tween(OVERLAY_PRESS_T)
	end)
	b.MouseButton1Up:Connect(function()
		tween(OVERLAY_HOVER_T)
	end)
	b.Activated:Connect(function()
		show_tip(h, nil, nil)
		on_press()
	end)
	b.Parent = h.bar
	h.buttons[key] = entry
	return entry
end

local function layout_hud()
	local h = hud
	if h == nil then
		return
	end
	local inset = GuiService.TopbarInset
	local height = inset.Height
	if height <= 0 then
		height = 58
	end
	-- The inset rect starts right of Roblox's menu / chat buttons; our row continues their spacing.
	local left = (if inset.Width > 0 then inset.Min.X else 164) + GAP
	h.bar.Position = UDim2.fromOffset(left, inset.Min.Y + math.max(0, height - BUTTON - 2))
	h.bar.Size = UDim2.fromOffset(math.max(inset.Width - GAP, BUTTON), BUTTON)
end

--- Viewport-px rect of the visible top-bar buttons (UIRoot keeps HUD panels clear of the row).
local function topbar_rect(): Rect?
	local h = hud
	if h == nil then
		return nil
	end
	local inset = GuiService:GetGuiInset()
	local min_x, min_y, max_x, max_y = math.huge, math.huge, -math.huge, -math.huge
	for _, e in h.buttons do
		local b = e.button
		if b.Visible then
			local p = b.AbsolutePosition + inset -- AbsolutePosition is relative to the inset area
			local sz = b.AbsoluteSize
			min_x = math.min(min_x, p.X)
			min_y = math.min(min_y, p.Y)
			max_x = math.max(max_x, p.X + sz.X)
			max_y = math.max(max_y, p.Y + sz.Y)
		end
	end
	if min_x == math.huge then
		return nil
	end
	return Rect.new(min_x, min_y, max_x, max_y)
end

local function focus_home()
	local session = Main.session
	local state = session and session.state
	if state ~= nil and state.local_owner ~= 0 then
		call(Main.world, "focus_owner", state.local_owner)
	end
end

local function toggle_music()
	local audio = Main.audio
	if audio == nil then
		return
	end
	audio:set_music_enabled(not audio:is_music_enabled())
end

local function current_screen(): string
	local s = call(Main.ui, "screen")
	return if type(s) == "string" then s else "title"
end

local function refresh_hud()
	local h = hud
	if h == nil then
		return
	end
	-- Match-only controls: the title screen has no leaderboard, nation or game menu yet.
	local in_match = Main.ui ~= nil and current_screen() ~= "title"
	-- Phones: no music button in the row (Settings has the switch). With the gear the row is six
	-- buttons, and beside Roblox's own (three with voice chat) that leaves an 852 px phone no room
	-- for the status pill, which then drops under the row.
	local music = h.buttons["music"]
	local ctx = Main.ui and Main.ui.ctx
	if music then
		-- (the phone layout, as the status pill knows it: UIRoot's ctx.compact)
		music.button.Visible = not (type(ctx) == "table" and ctx.compact == true)
	end
	for _, key in { "leaderboard", "home", "menu" } do
		local e = h.buttons[key]
		if e then
			e.button.Visible = in_match
		end
	end
	-- a crate opening fills the screen: the row steps aside meanwhile
	local co = Main.ui and Main.ui.crate_opening
	h.bar.Visible = not (co ~= nil and co.is_open)
end

local function build_hud(player: Player)
	local gui = Instance.new("ScreenGui")
	gui.Name = "AirfrontTopbar"
	gui.IgnoreGuiInset = true
	-- The safe area's coordinates, which are GuiService.TopbarInset's. This was ScreenInsets.None
	-- (full-screen coordinates) in the belief that TopbarInset is full-screen too. It is not: on an
	-- iPhone 17 Pro (Studio's emulation: a 62 px inset beside the notch) it reads min (164, 0), max
	-- (749, 58) on a 749 px wide safe area, 873 px of screen. So on a notched phone the row sat the
	-- inset's width too far left, its first button under Roblox's own (2026-10-07, a phone's
	-- screenshot: Roblox's top bar covered our music toggle).
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 50
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.BackgroundTransparency = 1
	bar.Parent = gui
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Horizontal
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, GAP)
	list.VerticalAlignment = Enum.VerticalAlignment.Center
	list.Parent = bar
	local tip = Instance.new("TextLabel")
	tip.Name = "Tooltip"
	tip.AnchorPoint = Vector2.new(0.5, 0)
	tip.AutomaticSize = Enum.AutomaticSize.XY
	tip.BackgroundColor3 = FILL
	tip.BackgroundTransparency = 0.1
	tip.TextColor3 = Color3.new(1, 1, 1)
	tip.FontFace = Font.fromId(12187365977, Enum.FontWeight.Medium)
	tip.TextSize = 14
	tip.Visible = false
	tip.ZIndex = 5
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = tip
	local tc = Instance.new("UICorner")
	tc.CornerRadius = UDim.new(0, 8)
	tc.Parent = tip
	tip.Parent = gui
	local h: Hud = { gui = gui, bar = bar, buttons = {}, tip = tip }
	hud = h

	local audio = Main.audio
	local music = make_button(
		h,
		"music",
		if audio:is_music_enabled() then "music_on" else "music_off",
		"Music (M)",
		1,
		toggle_music
	)
	-- The game menu can also toggle music; keep the icon in sync.
	audio.music_enabled_changed:Connect(function(on: boolean)
		music.set_icon(if on then "music_on" else "music_off")
	end)
	-- (2026-10-25: "Help & Credits", the window ends with the credits, licence and source)
	make_button(h, "help", "help", "Help & Credits (H)", 2, function()
		call(Main.ui, "toggle_help")
	end)
	make_button(h, "leaderboard", "leaderboard", "Leaderboard (Tab)", 3, function()
		call(Main.ui, "toggle_leaderboard")
	end)
	make_button(h, "home", "globe", "Center on your nation (Home)", 4, focus_home)
	-- settings (2026-10-07): music, the border pops, labels; on the title too
	make_button(h, "settings", "settings", "Settings", 5, function()
		call(Main.ui, "open_settings")
	end)
	make_button(h, "menu", "exit", "Game menu", 6, function()
		call(Main.ui, "open_pause_menu")
	end)
	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(layout_hud)
	-- (a resized window may change layouts: the row follows once the UI has laid itself out)
	local cam = workspace.CurrentCamera
	if cam ~= nil then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			task.delay(0.25, refresh_hud)
		end)
	end
	task.delay(1.5, refresh_hud)
	layout_hud()
	refresh_hud()
	gui.Parent = player:WaitForChild("PlayerGui")
end

-- =============================================================================================
-- Boot
-- =============================================================================================

local function on_screen_changed(screen: string)
	call(Main.world, "set_attract_mode", screen == "title")
	refresh_hud()
end

local function on_state_ready(state: any)
	call(Main.world, "bind_state", state)
	-- UIRoot picks its new screen a frame later (screen_changed then updates the globe / top bar);
	-- before the UI exists this keeps the title look.
	on_screen_changed(current_screen())
end

local function bind_keys()
	local function handler(
		_name: string,
		input_state: Enum.UserInputState,
		input: InputObject
	): Enum.ContextActionResult
		if input_state ~= Enum.UserInputState.Begin or GuiService.MenuIsOpen then
			return Enum.ContextActionResult.Pass
		end
		if UserInputService:GetFocusedTextBox() ~= nil then
			return Enum.ContextActionResult.Pass
		end
		if input.KeyCode == Enum.KeyCode.M then
			toggle_music()
		elseif input.KeyCode == Enum.KeyCode.Home then
			focus_home()
		end
		return Enum.ContextActionResult.Sink
	end
	ContextActionService:BindAction("AirfrontMainKeys", handler, false, Enum.KeyCode.M, Enum.KeyCode.Home)
end

--- In multiplayer the server drops participants who look idle between matches; any real input
--- (clicks, keys, touches, camera drags) counts as presence. Session throttles the reports.
local function watch_activity()
	local function note(input: InputObject)
		local t = input.UserInputType
		if
			t == Enum.UserInputType.MouseButton1
			or t == Enum.UserInputType.MouseButton2
			or t == Enum.UserInputType.MouseMovement
			or t == Enum.UserInputType.MouseWheel
			or t == Enum.UserInputType.Touch
			or t == Enum.UserInputType.Keyboard
			or t == Enum.UserInputType.Gamepad1
		then
			local session = Main.session
			if session ~= nil then
				session:note_activity()
			end
		end
	end
	UserInputService.InputBegan:Connect(note)
	UserInputService.InputChanged:Connect(note)
end

function Main.start()
	Main.boot.start = os.clock()
	local player = Players.LocalPlayer
	hide_core_guis()
	-- The globe is always played in landscape (either way up); main.gd reasserted this on mobile too.
	task.spawn(function()
		local pg = player:WaitForChild("PlayerGui") :: PlayerGui
		pcall(function()
			pg.ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor
		end)
	end)
	local session = Session.new()
	Main.session = session
	Main.boot.session_new = os.clock()
	local audio = AudioDirector.new("menu")
	audio:bind_settings(session)
	Main.audio = audio
	Main.boot.audio = os.clock()

	local client = script.Parent
	-- the 2D map (Map/MapView); View/WorldView was the 3D globe (tag globe-v7)
	local WorldView = optional(client, { "Map", "MapView" })
	if WorldView ~= nil and type(WorldView.new) == "function" then
		local ok, w = pcall(WorldView.new)
		if ok then
			Main.world = w
		else
			warn("[RoWorld] WorldView.new failed: " .. tostring(w))
		end
	end
	Main.boot.world = os.clock()
	-- The title world, the globe and the top bar come up first: UIRoot.new may wait (bounded) for the
	-- Rubik weights on a cold client, and the attract globe must already be alive behind it.
	session.state_ready:Connect(on_state_ready)
	session.state_ready:Once(function()
		Main.boot.first_state = os.clock()
	end)
	build_hud(player)
	bind_keys()
	watch_activity()
	Main.boot.hud = os.clock()
	session:bind()
	session:start_title()
	Main.boot.session = os.clock()
	local UIRoot = optional(client, { "UI", "UIRoot" })
	if UIRoot ~= nil and type(UIRoot.new) == "function" then
		local ok, u = pcall(UIRoot.new)
		if ok then
			Main.ui = u
			local ok2, err = pcall(function()
				u:setup(session, Main.world, audio)
			end)
			if not ok2 then
				warn("[RoWorld] UIRoot:setup failed: " .. tostring(err))
			end
		else
			warn("[RoWorld] UIRoot.new failed: " .. tostring(u))
		end
	end
	local ui = Main.ui
	if ui ~= nil and ui.screen_changed ~= nil then
		ui.screen_changed:Connect(on_screen_changed)
	end
	-- sent here from an outdated server while starting a solo match (server/FreshServers): it starts here
	pcall(function()
		local data = game:GetService("TeleportService"):GetLocalPlayerTeleportData()
		if
			type(data) == "table"
			and type(data.solo) == "table"
			and ui ~= nil
			and type(ui.autostart_solo) == "function"
		then
			ui:autostart_solo(tonumber(data.solo.d) or 0, if type(data.solo.m) == "string" then data.solo.m else nil)
		end
	end)
	if ui ~= nil and ui.crate_opening ~= nil and ui.crate_opening.shown ~= nil then
		ui.crate_opening.shown:Connect(refresh_hud)
	end
	if ui ~= nil then
		ui.topbar_provider = topbar_rect
	end
	on_screen_changed(current_screen())
	Main.boot.ui = os.clock()
	Main.launch_hooks(player)
	-- Dev diagnostics (workspace attribute AF_DIAG; never set in the shipped place).
	if workspace:GetAttribute("AF_DIAG") == true then
		local diag = optional(client, { "Dev", "SessionDiag" })
		if diag then
			diag.start(Main)
		end
	end
end

-- Owner-only real-client test hook: joining with launchData "autosolo[:lat,lon]" (e.g.
-- roblox://experiences/start?placeId=137151641329864&launchData=autosolo:48,10) starts a Standard solo
-- match and picks the unclaimed land nearest to lat/lon, so the published game can be verified on a
-- real Roblox client without clicking through the title. Ignored for everyone else.
Main.OWNER_USER_ID = 22641473
function Main.launch_hooks(player: Player)
	task.spawn(function()
		local ld = player:GetAttribute("AF_LaunchData")
		local t0 = os.clock()
		while ld == nil and os.clock() - t0 < 6 do
			task.wait(0.25)
			ld = player:GetAttribute("AF_LaunchData")
		end
		if type(ld) ~= "string" or string.sub(ld, 1, 8) ~= "autosolo" then
			return
		end
		if player.UserId ~= Main.OWNER_USER_ID and not game:GetService("RunService"):IsStudio() then
			return
		end
		local lat, lon = 30.0, 100.0
		local a, b = string.match(ld, "^autosolo:(%-?[%d%.]+),(%-?[%d%.]+)$")
		if a and b then
			lat, lon = tonumber(a) or lat, tonumber(b) or lon
		end
		local session = Main.session
		-- wait for the title world, then start solo through the UI's own path
		while session.state == nil or session:is_building() do
			task.wait(0.2)
		end
		task.wait(1.0)
		if Main.ui ~= nil and type(Main.ui._on_play_solo) == "function" then
			pcall(Main.ui._on_play_solo, Main.ui, 1)
		else
			session:start_solo(1)
		end
		-- spawn phase of the new solo world: pick the nearest unclaimed contestable land
		local deadline = os.clock() + 30
		while os.clock() < deadline do
			task.wait(0.2)
			local st = session.state
			if st ~= nil and st.map ~= nil and st.local_owner ~= 0 and not session:is_building() then
				local map = st.map
				local c = map:latlon_to_tile(lat, lon)
				local cx, cy = c % 1024, c // 1024
				local best = nil
				for r = 0, 60 do
					for dy = -r, r do
						for dx = -r, r do
							if math.max(math.abs(dx), math.abs(dy)) == r then
								local y = cy + dy
								if y >= 0 and y < 512 then
									local t = y * 1024 + (cx + dx) % 1024
									if map:is_contestable(t) and st:owner_of(t) == 0 then
										best = t
										break
									end
								end
							end
						end
						if best then
							break
						end
					end
					if best then
						break
					end
				end
				if best ~= nil then
					session:send_intent({ type = "spawn", tile = best })
					call(Main.world, "focus_tile", best, -1.0, 1.0)
					print("[RoWorld] autosolo: spawn requested at tile", best)
				end
				return
			end
		end
	end)
end

return Main
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="114">
          <Properties>
            <string name="Name">Map</string>
          </Properties>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">AtlasReady</string>
              <string name="Source"><![CDATA[--!strict
-- Tells a map layer when an image it would like to switch to can be drawn.
--
-- A layer that swaps two stacked images for one combined atlas (Sprites.units_one, Sprites.shapes_one) must not
-- do so before that atlas loads for this player: an image Roblox has not approved yet, or refuses,
-- draws nothing, and every unit or plate on the map would be gone. So the layer starts on the atlases
-- it has always used and asks here.
--
-- ContentProvider:PreloadAsync answers truthfully only for an instance: given the content id as a
-- string it reported Failure for atlases that were on screen (Studio, 2026-10-08), and Success /
-- Failure correctly for an ImageLabel holding it.
local ContentProvider = game:GetService("ContentProvider")

local AtlasReady = {}

--- Seconds between tries while the image does not load (it may still be in moderation), and how many.
AtlasReady.RETRY_S = 45
AtlasReady.TRIES = 8

--- Calls `on_ready` once, when `id` has loaded. Never, if it does not load in TRIES tries.
function AtlasReady.watch(id: string, on_ready: () -> ())
	task.spawn(function()
		for try = 1, AtlasReady.TRIES do
			local probe = Instance.new("ImageLabel")
			probe.Image = id
			local loaded = false
			pcall(function()
				ContentProvider:PreloadAsync({ probe }, function(_content: string, status: Enum.AssetFetchStatus)
					if status == Enum.AssetFetchStatus.Success then
						loaded = true
					end
				end)
			end)
			probe:Destroy()
			if loaded then
				on_ready()
				return
			end
			if try < AtlasReady.TRIES then
				task.wait(AtlasReady.RETRY_S)
			end
		end
	end)
end

return AtlasReady
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">ChakraEffects</string>
              <string name="Source"><![CDATA[-- Client-only 3D jutsu drawn into the map GUI. Simulation coordinates remain authoritative.
local ChakraEffects = {}
ChakraEffects.__index = ChakraEffects

function ChakraEffects.profiles(defs)
	return {
		[defs.N_ATOM] = { name = "Rasengan", color = Color3.fromRGB(65, 205, 255), core = Color3.fromRGB(220, 251, 255), speed = 16, duration = 0.85, mode = "spiral" },
		[defs.N_HYDROGEN] = { name = "ChibakuTensei", color = Color3.fromRGB(183, 135, 255), core = Color3.fromRGB(39, 29, 56), speed = 4, duration = 2.1, mode = "gravity" },
		[defs.N_MEGA] = { name = "Bijudama", color = Color3.fromRGB(231, 91, 255), core = Color3.fromRGB(66, 13, 88), speed = 9, duration = 1.4, mode = "pulse" },
		[defs.N_SCATTER] = { name = "TengaiShinsei", color = Color3.fromRGB(255, 123, 40), core = Color3.fromRGB(94, 54, 46), speed = 3, duration = 1.8, mode = "meteor" },
	}
end

local function part(parent, shape)
	local p = Instance.new("Part")
	p.Shape = shape
	p.Anchored = true
	p.CanCollide = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

local function newModel(parent, z, impact)
	local viewport = Instance.new("ViewportFrame")
	viewport.Name = "ChakraEffect"
	viewport.BackgroundTransparency = 1
	viewport.AnchorPoint = Vector2.new(0.5, 0.5)
	viewport.ZIndex = z
	viewport.Ambient = Color3.fromRGB(125, 112, 146)
	viewport.LightColor = Color3.fromRGB(255, 238, 225)
	viewport.LightDirection = Vector3.new(-0.45, -0.65, -1)
	viewport.Visible = false
	local camera = Instance.new("Camera")
	camera.FieldOfView = 37
	camera.CFrame = CFrame.lookAt(Vector3.new(0, 3.4, 10.5), Vector3.zero)
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local core = part(viewport, Enum.PartType.Ball)
	local pieces = {}
	for i = 1, (if impact then 28 else 16) do
		pieces[i] = part(viewport, Enum.PartType.Block)
	end
	local clouds = {}
	if impact then
		for i = 1, 7 do clouds[i] = part(viewport, Enum.PartType.Ball) end
	end
	viewport.Parent = parent
	return { viewport = viewport, core = core, pieces = pieces, clouds = clouds }
end

function ChakraEffects.new(parent, z, cap)
	return setmetatable({ parent = parent, z = z, cap = cap, models = {}, used = 0, impacts = {} }, ChakraEffects)
end

function ChakraEffects.beginFrame(self)
	self.used = 0
end

function ChakraEffects.endFrame(self)
	for i = self.used + 1, #self.models do
		self.models[i].viewport.Visible = false
	end
end

function ChakraEffects.clear(self)
	self:beginFrame()
	self:endFrame()
	table.clear(self.impacts)
end

local function draw(self, profile, x, y, pixels, clock, progress, isImpact, heading, descent)
	if self.used >= self.cap then return false end
	self.used += 1
	local model = self.models[self.used]
	if model == nil then
		model = newModel(self.parent, self.z, isImpact)
		self.models[self.used] = model
	end
	local viewport = model.viewport
	viewport.Name = profile.name
	viewport.Visible = true
	viewport.Position = UDim2.fromOffset(x, y)
	viewport.Size = UDim2.fromOffset(pixels, pixels)
	local p = progress
	local mode = profile.mode
	local pulse = 1 + 0.19 * math.sin(clock * 14)
	local meteor = mode == "meteor"
	local rubble = mode == "rubble"
	local gravity = mode == "gravity"
	local coreSize = if not isImpact then (if meteor then 2.4 else 1.6) * pulse
		elseif gravity then 1 + p * 1.8 else (0.75 + 2.7 * (1 - (1 - p)^4)) * pulse
	model.core.Size = Vector3.one * coreSize
	model.core.CFrame = CFrame.Angles(clock, clock * 0.6, clock * 0.2)
	model.core.Color = profile.core
	model.core.Shape = if meteor then Enum.PartType.Block else Enum.PartType.Ball
	model.core.Material = if meteor or gravity then Enum.Material.Slate else Enum.Material.Neon
	model.core.Transparency = if isImpact then math.clamp((p - 0.35) / 0.65, 0, 1) else 0

	local orbit = if isImpact or descent ~= nil then CFrame.identity
		else CFrame.Angles(0.35 + math.sin(clock * 2) * 0.25, 0, (heading or 0) - math.pi / 2)
	for i, shard in model.pieces do
		local phase = (i - 1) / #model.pieces
		local a = phase * math.pi * 2 + clock * profile.speed
		local ring = i % 2
		local radius, height, length, width
		local solid = gravity and i % 3 ~= 0 or isImpact and i % 3 == 0 or rubble and i % 4 ~= 0
		if descent ~= nil then
			-- Each fragment starts at ground level, then accelerates upward on its own spiral.
			local cycle = (p * 2.1 + phase) % 1
			local lift = cycle * cycle
			local ground = 2.9 + (1 - descent) * 1.7
			radius = (1.0 + ring * 1.2 + phase) * (1 - lift)
			height = -ground * (1 - lift)
			length = 0.12 + (i % 5) * 0.085
			width = length * 0.68
		elseif isImpact then
			local eased = 1 - (1 - p)^2
			local spread = 1.65 + (i * 37 % 19) / 9
			if gravity then
				radius = 3.3 - 2.8 * eased
				height = (ring - 0.25) * 1.55 * (1 - p)
			else
				a = phase * math.pi * 2 + math.sin(i * 19.2) * 0.22
				radius = 0.35 + spread * eased
				local hop = math.clamp(p / (0.46 + (i % 7) * 0.05), 0, 1)
				local bounce = math.clamp((p - 0.62) / 0.31, 0, 1)
				height = (0.65 + (i % 7) * 0.27) * 4 * hop * (1 - hop) + 1.25 * bounce * (1 - bounce)
			end
			length = if solid then 0.17 + (i % 5) * 0.093 else 0.20 + (1 - p) * 0.74
			width = if solid then length * 0.65 else 0.07
		elseif meteor then
			a = phase * math.pi * 2
			radius = 0.75 + ring * 0.55
			height = -(phase * 3.1)
			length = 0.25 + phase * 1.15
			width = 0.15 + 0.13 * (1 - phase)
		else
			radius = (if gravity then 2.0 else 1.25) + 0.23 * ring
			height = math.sin(a * 2 + clock * 2) * (if gravity then 0.7 else 0.44)
			length = if gravity then 0.32 else 0.59
			width = if gravity then 0.26 else 0.13
		end
		local at = Vector3.new(math.cos(a) * radius, height, math.sin(a) * radius)
		local tangent = Vector3.new(-math.sin(a), 0, math.cos(a))
		local alignment = if meteor and not isImpact then CFrame.Angles(math.pi / 2, 0, 0)
			else CFrame.lookAt(Vector3.zero, tangent)
		shard.CFrame = orbit * CFrame.new(at) * alignment * CFrame.Angles(0, 0, clock + phase * 4)
		shard.Size = Vector3.new(width, width, length)
		shard.Material = if solid then Enum.Material.Slate else Enum.Material.Neon
		shard.Color = if shard.Material == Enum.Material.Slate then profile.core:Lerp(profile.color, 0.28)
			else profile.color:Lerp(Color3.new(1, 1, 1), if ring == 0 then 0.42 else 0.05)
		shard.Transparency = if descent ~= nil then 1 - descent else if isImpact then p ^ (if solid then 5 else 1.6) else phase * (if meteor then 0.55 else 0.19)
	end
	for i, cloud in model.clouds do
		local a = i * 2.39996
		local drift = p * (0.7 + i * 0.14)
		local hot = p < 0.32 and not gravity and i % 2 == 0
		local size = 0.28 + (1.1 + (i % 3) * 0.29) * p
		cloud.Size = Vector3.new(size, size * 0.77, size)
		cloud.Position = Vector3.new(math.cos(a) * drift, 0.17 + p * (0.8 + i * 0.17), math.sin(a) * drift)
		cloud.Color = if hot then profile.color:Lerp(Color3.fromRGB(255, 224, 154), 0.42)
			else Color3.fromRGB(63, 52, 55):Lerp(profile.color, if gravity then 0.23 else 0.07)
		cloud.Material = if hot then Enum.Material.Neon else Enum.Material.SmoothPlastic
		cloud.Transparency = math.clamp(0.36 + p^2 * 0.64, 0, 1)
	end
	return true
end

function ChakraEffects.flight(self, profile, x, y, pixels, clock, progress, heading)
	return draw(self, profile, x, y, math.clamp(pixels, 28, 165), clock, progress, false, heading)
end

function ChakraEffects.gravity(self, profile, x, groundY, height, descent, pull, clock)
	local y = groundY - height * (1 + (1 - descent)^2 * 1.2)
	return draw(self, profile, x, y, math.clamp(height * 2.75, 100, 270), clock, pull, false, 0, descent)
end

function ChakraEffects.impact(self, profile, tile, radius, clock)
	if #self.impacts >= self.cap then table.remove(self.impacts, 1) end
	table.insert(self.impacts, { profile = profile, tile = tile, radius = radius, start = clock })
end

function ChakraEffects.tick(self, cam, clock)
	self:beginFrame()
	for i = #self.impacts, 1, -1 do
		local item = self.impacts[i]
		local age = clock - item.start
		local p = age / item.profile.duration
		if p >= 1 then
			table.remove(self.impacts, i)
		else
			local x, y = cam:tile_to_screen(item.tile)
			local pixels = math.clamp(item.radius * cam.scale * 3.2, if item.profile.mode == "rubble" then 44 else 82, 440)
			if item.profile.mode == "gravity" then
				y -= math.clamp(20 * cam.scale, 38, 100)
				pixels = math.min(pixels, 270)
			end
			if cam:on_screen(x, y, pixels / 2) then
				draw(self, item.profile, x, y, pixels, age, p, true)
			end
		end
	end
	self:endFrame()
end

return ChakraEffects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">FalloutGlow</string>
              <string name="Source"><![CDATA[--!native
-- The glow of fresh fallout on the 2D map (2026-10-12, so irradiated land looks better and
-- glows: the fallout used to be a flat green, with no glow).
-- How it is made:
--   * heat: a tile that turns to fallout is at heat 1, which drains by HEAT_DECAY_PER_TICK / 255 a game
--     tick (gone in 25.5 s); a tile no longer fallout is at 0. Fallout already
--     on the map when the state is bound has none.
--   * the glow is worked out for one tile in every SCALE x SCALE block (its centre tile):
--     a "broil" of two value noises, contrast and intensity mixed from
--     cold to hot by the heat, a slower meta noise over it, all faded in by the heat; and, on some
--     blocks (a hash over the threshold), a dot of light flickering at a rate of its own
--     (the extract function). Kept in 0..1 (RGBA8).
--   * a 5-tap Gaussian blur across and down (BLUR), then laid over the map, linearly
--     filtered, times COVERAGE: one EditableImage
--     of the blocks (straight alpha) stretched over the map in one ImageLabel, under the overlays.
-- Worked out on the CPU, so redrawn UPDATE_S apart, not every frame, its noise (the costly part)
-- for as many blocks as NOISE_BUDGET_S allows each time, round robin (the noise moves over seconds);
-- not written on a frame the map surface wrote one of its images (MapSurface: Roblox shows one
-- EditableImage update a frame), unless it has waited SKIP_MAX frames. (2026-10-26, phones' slow
-- frames: its lists, noise and buffers are kept from one draw to the next, and the label is placed
-- again only when the camera moved.)
-- (2026-10-27, "Script - Fallout Glow" led phones' slow frames: a MIRV's or a few far-apart nukes'
-- box is most of the image, and it was blurred whole every draw (a MIRV: ~32 ms a draw on a Mac,
-- interpreted). Now only what the view can reach is drawn (`_win`: the view's blocks and a quarter
-- view more each way, drawn again at once when the view leaves it for glow not drawn), the blur goes
-- over the rows with glow and the columns it reaches, sliding along them (one read a cell, not five),
-- a block's hashes are worked out once, phones redraw at UPDATE_S_MOBILE and a long draw waits DUTY
-- times as long. The pixels drawn are the same.)
local AssetService = game:GetService("AssetService")
local UserInputService = game:GetService("UserInputService")
local RS = game:GetService("ReplicatedStorage")
local Airfront = RS:WaitForChild("Airfront")
local Defs = require(Airfront:WaitForChild("Core"):WaitForChild("Defs")) :: any
local FrameClock = require(script.Parent:WaitForChild("FrameClock")) :: any

local FalloutGlow = {}
FalloutGlow.__index = FalloutGlow

FalloutGlow.SCALE = 8 -- tiles a side of a glow block
-- the glow's look
FalloutGlow.BROIL_SPEED_COLD = 0.0018
FalloutGlow.BROIL_SPEED_HOT = 0.0
FalloutGlow.NOISE_FREQ1 = 0.059
FalloutGlow.NOISE_FREQ2 = 0.171
FalloutGlow.CONTRAST_LO_COLD = 0.52
FalloutGlow.CONTRAST_LO_HOT = 0.0
FalloutGlow.CONTRAST_HI_COLD = 1.0
FalloutGlow.CONTRAST_HI_HOT = 0.0
FalloutGlow.META_FREQ = 0.02
FalloutGlow.INTENSITY_COLD = 0.15
FalloutGlow.INTENSITY_HOT = 1.8
FalloutGlow.META_INFLUENCE_COLD = 1.0
FalloutGlow.META_INFLUENCE_HOT = 0.0
FalloutGlow.OPACITY_FADE_END = 1.0
FalloutGlow.BLOOM = { 0.054901960784313725, 0.8196078431372549, 0.0 }
FalloutGlow.COVERAGE = 1.1
FalloutGlow.HEAT_DECAY_PER_TICK = 1.0
FalloutGlow.PARTICLE_DARK = { 0.05, 0.4, 0.05 }
FalloutGlow.PARTICLE_BRIGHT = { 0.2, 1.0, 0.2 }
FalloutGlow.PARTICLE_THRESHOLD_UNOWNED = 0.85
FalloutGlow.PARTICLE_THRESHOLD_OWNED = 0.875
FalloutGlow.PARTICLE_FLICKER_SPEED = 0.2
FalloutGlow.PARTICLE_STRENGTH = 1.0
FalloutGlow.PARTICLE_FRESH_SCALE = 0.2
--- The blur's weights: the pixel, then 1 and 2 away
FalloutGlow.BLUR = { 0.375, 0.25, 0.0625 }
-- pacing
FalloutGlow.UPDATE_S = 1 / 20
--- Phones (touch, no keyboard): the glow changes over seconds, only its dots flicker faster
FalloutGlow.UPDATE_S_MOBILE = 1 / 12
--- The next draw waits at least DUTY times as long as this one took (a slow phone's glow takes at
--- most 1 / DUTY of its time, not every frame)
FalloutGlow.DUTY = 8
FalloutGlow.NOISE_BUDGET_S = 0.0015
FalloutGlow.SKIP_MAX = 2
--- The window drawn: the view's blocks and CUSHION more each way (the linear filter and a frame of
--- panning), then a quarter of the view (at least WIN_MIN blocks) more each way
FalloutGlow.CUSHION = 2
FalloutGlow.WIN_MIN = 4
FalloutGlow.Z = 1 -- in the overlay, under the rails

local F_FALLOUT: number = Defs.F_FALLOUT
local band = bit32.band
local readu8 = buffer.readu8
local readi32 = buffer.readi32
local floor = math.floor
local sin = math.sin

local function fract(x: number): number
	return x - floor(x)
end

local function mix(a: number, b: number, t: number): number
	return a + (b - a) * t
end

--- smoothstep (0..1 between e0 and e1); with e0 >= e1 a step at e0 ((x - e0) / 0 is +inf above it).
local function smoothstep(e0: number, e1: number, x: number): number
	if e1 <= e0 then
		return if x > e0 then 1 else 0
	end
	local t = math.clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end

local function hash3(x: number, y: number, z: number): number
	return fract(sin(x * 127.1 + y * 311.7 + z * 74.7) * 43758.5453)
end

--- Trilinear value noise, smoothstep-faded.
function FalloutGlow.vnoise3(px: number, py: number, pz: number): number
	local ix, iy, iz = floor(px), floor(py), floor(pz)
	local fx, fy, fz = px - ix, py - iy, pz - iz
	fx, fy, fz = fx * fx * (3 - 2 * fx), fy * fy * (3 - 2 * fy), fz * fz * (3 - 2 * fz)
	local n000 = hash3(ix, iy, iz)
	local n100 = hash3(ix + 1, iy, iz)
	local n010 = hash3(ix, iy + 1, iz)
	local n110 = hash3(ix + 1, iy + 1, iz)
	local n001 = hash3(ix, iy, iz + 1)
	local n101 = hash3(ix + 1, iy, iz + 1)
	local n011 = hash3(ix, iy + 1, iz + 1)
	local n111 = hash3(ix + 1, iy + 1, iz + 1)
	return mix(mix(mix(n000, n100, fx), mix(n010, n110, fx), fy), mix(mix(n001, n101, fx), mix(n011, n111, fx), fy), fz)
end

function FalloutGlow.new(parent: Instance, view: any)
	local self = setmetatable({}, FalloutGlow) :: any
	local label = Instance.new("ImageLabel")
	label.Name = "FalloutGlow"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.ScaleType = Enum.ScaleType.Stretch
	label.ResampleMode = Enum.ResamplerMode.Default
	label.Active = false
	label.Visible = false
	label.ZIndex = FalloutGlow.Z
	label.Parent = parent
	self.label = label
	self.view = view
	self._state = nil :: any
	self._img = nil :: EditableImage?
	self._bw, self._bh = 0, 0
	--- block -> the tick its heat was 1 (blocks with heat); block -> fallout last seen (sample tiles)
	self._hot = {} :: { [number]: number }
	self._was = {} :: { [number]: boolean }
	--- block -> its noise (broil before contrast, meta) and when it was worked out
	self._noise = {} :: { [number]: { number } }
	self._order = {} :: { number }
	--- the hot blocks' next order (swapped with _order each draw)
	self._live = {} :: { number }
	self._rr = 1
	self._next = 0.0
	self._skipped = 0
	--- the pixel box written last time (cleared next time if it shrinks; the table is kept)
	self._box = nil :: { number }?
	self._box_buf = { 0, 0, 0, 0 }
	--- the label's last position and size (px)
	self._lx, self._ly, self._lw, self._lh = math.huge, math.huge, -1, -1
	--- the last box's pixels, and zeros of that size (WritePixelsBuffer takes a buffer of the box's
	--- size exactly; made again only when the box's size changes)
	self._out = nil :: buffer?
	self._out_cells = -1
	self._zero = nil :: buffer?
	self._zero_cells = -1
	--- block -> its dot's hashes (from where it is: worked out once)
	self._h1 = {} :: { [number]: number }
	self._h2 = {} :: { [number]: number }
	--- the last draw's box: the hot blocks and the blur's 2 blocks either side (i1 < i0: none)
	self._fb = { 0, 0, -1, -1 }
	--- the blocks the view can reach (i0, j0, i1, j1; none until the first tick), and per row of a
	--- draw's work box its first and last column with glow
	self._win = { 0, 0, -1, -1 }
	self._rlo = {} :: { number }
	self._rhi = {} :: { number }
	--- and per column the first and last row blurred across
	self._cf = {} :: { number }
	self._cl = {} :: { number }
	--- label.Visible as last written
	self._vis = false
	return self
end

function FalloutGlow._show(self: any, on: boolean)
	if self._vis ~= on then
		self._vis = on
		self.label.Visible = on
	end
end

function FalloutGlow.bind(self: any, state: any)
	self._state = state
	self:_reset()
end

function FalloutGlow.unbind(self: any)
	self._state = nil
	table.clear(self._hot)
	table.clear(self._was)
	table.clear(self._noise)
	self:_show(false)
end

function FalloutGlow.destroy(self: any)
	self:unbind()
	if self._img ~= nil then
		self._img:Destroy()
		self._img = nil
	end
	self.label:Destroy()
end

--- A state (re)loaded: what is fallout now has no heat.
function FalloutGlow.on_snapshot(self: any)
	self:_reset()
end

function FalloutGlow._reset(self: any)
	table.clear(self._hot)
	table.clear(self._was)
	table.clear(self._noise)
	table.clear(self._h1)
	table.clear(self._h2)
	-- (cleared, not forgotten: a match that ended glowing left its pixels for the next one's first
	-- glow to show where that one's box did not reach)
	self:_clear_box()
	self._win[3], self._win[4] = -1, -1
	self._fb[3] = -1
	self:_show(false)
	local st = self._state
	if st == nil or st.map == nil or st.flags == nil then
		return
	end
	local W, H = st.map.W or Defs.W, st.map.H or Defs.H
	local S = FalloutGlow.SCALE
	local bw, bh = math.max(1, W // S), math.max(1, H // S)
	if bw ~= self._bw or bh ~= self._bh or self._img == nil then
		if self._img ~= nil then
			self._img:Destroy()
			self._img = nil
		end
		self._bw, self._bh = bw, bh
		local ok, img = pcall(function()
			return AssetService:CreateEditableImage({ Size = Vector2.new(bw, bh) })
		end)
		if ok and img ~= nil then
			self._img = img
			self.label.ImageContent = Content.fromObject(img)
		end
	end
	if (tonumber(st.fallout_count) or 1) <= 0 then
		return
	end
	local flags = st.flags
	local half = S // 2
	for j = 0, bh - 1 do
		local y = j * S + half
		if y >= H then
			break
		end
		for i = 0, bw - 1 do
			local x = i * S + half
			if x >= W then
				break
			end
			if band(readu8(flags, y * W + x), F_FALLOUT) ~= 0 then
				self._was[j * bw + i] = true
			end
		end
	end
end

--- GameState.flags_changed (tile * 256 + flags): a block's centre tile turned to fallout is hot.
function FalloutGlow.on_flags_changed(self: any, changed: { number })
	local st = self._state
	if st == nil or st.map == nil or self._bw == 0 then
		return
	end
	local W = st.map.W or Defs.W
	local S = FalloutGlow.SCALE
	local half = S // 2
	local bw, bh = self._bw, self._bh
	local tick = st.render_tick or st.tick or 0
	for _, v in changed do
		local tile = v // 256
		local x, y = tile % W, tile // W
		if x % S ~= half or y % S ~= half then
			continue
		end
		local i, j = x // S, y // S
		if i >= bw or j >= bh then
			continue
		end
		local b = j * bw + i
		local now = band(v % 256, F_FALLOUT) ~= 0
		local was = self._was[b] == true
		if now and not was then
			self._was[b] = true
			if self._hot[b] == nil then
				table.insert(self._order, b)
			end
			self._hot[b] = tick
			self._noise[b] = nil
		elseif was and not now then
			self._was[b] = nil
			self._hot[b] = nil
			self._noise[b] = nil
		end
	end
	self._next = 0
end

--- A block's dot hashes from its centre (cx, cy): h1 its colour and rate, h2 whether it has one.
local function hashes(cx: number, cy: number): (number, number)
	-- (tile coordinates of the centre tile)
	local tx, ty = cx - 0.5, cy - 0.5
	return fract(sin(tx * 12.9898 + ty * 78.233) * 43758.5453), fract(sin(tx * 63.7 + ty * 157.3) * 23421.631)
end

--- The glow of a block at heat `heat`, tick `rt`: premultiplied rgba,
--- each in 0..1. `nz` = { broil noise, meta noise } (worked out when nil or stale), h1 / h2 its hashes.
local function extract(heat: number, rt: number, nz: { number }, owned: boolean, h1: number, h2: number)
	local G = FalloutGlow
	local lo = mix(G.CONTRAST_LO_COLD, G.CONTRAST_LO_HOT, heat)
	local hi = mix(G.CONTRAST_HI_COLD, G.CONTRAST_HI_HOT, heat)
	local broil = smoothstep(lo, hi, nz[1])
	local intensity = mix(G.INTENSITY_COLD, G.INTENSITY_HOT, heat)
		* mix(1.0, nz[2], mix(G.META_INFLUENCE_COLD, G.META_INFLUENCE_HOT, heat))
	local opacity = smoothstep(0.0, G.OPACITY_FADE_END, heat)
	local s = broil * intensity * opacity
	local col = G.BLOOM
	local r, g, bb, a = col[1] * s, col[2] * s, col[3] * s, s
	-- the particle dots
	if h2 >(if owned then G.PARTICLE_THRESHOLD_OWNED else G.PARTICLE_THRESHOLD_UNOWNED) then
		local rate = G.PARTICLE_FLICKER_SPEED * (0.4 + h1 * 1.2)
		local flick = math.max(0.0, sin(rt * rate + h1 * 12.0) * 0.8 + 0.2)
		flick *= flick
		flick *= mix(G.PARTICLE_FRESH_SCALE, 1.0, 1.0 - heat)
		flick *= opacity
		local k = flick * G.PARTICLE_STRENGTH
		local d, br = G.PARTICLE_DARK, G.PARTICLE_BRIGHT
		local pr, pg, pb = mix(d[1], br[1], h1) * k, mix(d[2], br[2], h1) * k, mix(d[3], br[3], h1) * k
		r, g, bb, a = r + pr, g + pg, bb + pb, a + math.max(pr, pg, pb)
	end
	return math.min(r, 1), math.min(g, 1), math.min(bb, 1), math.min(a, 1)
end

--- (written into the block's own table, `into`, when it has one)
local function noise_of(cx: number, cy: number, heat: number, rt: number, into: { number }?): { number }
	local G = FalloutGlow
	local t = rt * mix(G.BROIL_SPEED_COLD, G.BROIL_SPEED_HOT, heat)
	local n1 = FalloutGlow.vnoise3(cx * G.NOISE_FREQ1, cy * G.NOISE_FREQ1, t)
	local n2 = FalloutGlow.vnoise3(cx * G.NOISE_FREQ2, cy * G.NOISE_FREQ2, t * 1.3)
	local meta = FalloutGlow.vnoise3(cx * G.META_FREQ, cy * G.META_FREQ, t * 0.5)
	if into ~= nil then
		into[1], into[2] = n1 * 0.6 + n2 * 0.4, meta
		return into
	end
	return { n1 * 0.6 + n2 * 0.4, meta }
end

--- The window follows the view: when the view's blocks (and CUSHION) leave it, or it is far bigger
--- than they are (zoomed in), it is made again around them, a quarter of the view more each way.
--- True when that shows glow the last draw did not (a draw is due now).
function FalloutGlow._follow_view(self: any, cam: any): boolean
	local S, c = FalloutGlow.SCALE, FalloutGlow.CUSHION
	local u0, v0, u1, v1 = cam:visible_rect()
	local vi0, vj0, vi1, vj1 = floor(u0 / S) - c, floor(v0 / S) - c, floor(u1 / S) + c, floor(v1 / S) + c
	local win = self._win
	local left = vi0 < win[1] or vj0 < win[2] or vi1 > win[3] or vj1 > win[4]
	local vw, vh = vi1 - vi0 + 1, vj1 - vj0 + 1
	if left or win[3] - win[1] + 1 > 3 * vw or win[4] - win[2] + 1 > 3 * vh then
		local mi, mj = math.max(FalloutGlow.WIN_MIN, vw // 4), math.max(FalloutGlow.WIN_MIN, vh // 4)
		win[1], win[2], win[3], win[4] = vi0 - mi, vj0 - mj, vi1 + mi, vj1 + mj
	end
	if not left then
		return false
	end
	-- the glow's box (as of the last draw) where the view now is, and whether that was drawn
	local fb = self._fb
	if fb[3] < fb[1] then
		return false
	end
	local i0, j0 = math.max(vi0, fb[1]), math.max(vj0, fb[2])
	local i1, j1 = math.min(vi1, fb[3]), math.min(vj1, fb[4])
	if i1 < i0 or j1 < j0 then
		return false
	end
	local box = self._box
	return box == nil or i0 < box[1] or j0 < box[2] or i1 > box[3] or j1 > box[4]
end

function FalloutGlow.tick(self: any, _dt: number)
	local st = self._state
	local label = self.label
	if st == nil or self._img == nil then
		return
	end
	local cam = self.view.rig
	local W, H = st.map.W or Defs.W, st.map.H or Defs.H
	if next(self._hot) == nil then
		if self._vis then
			self:_show(false)
			self:_clear_box()
		end
		return
	end
	-- (laid over the map, moved when the camera did; drawn again UPDATE_S apart)
	local x0, y0 = cam:map_to_screen(0, 0)
	local x1, y1 = cam:map_to_screen(W, H)
	if x0 ~= self._lx or y0 ~= self._ly then
		self._lx, self._ly = x0, y0
		label.Position = UDim2.fromOffset(x0, y0)
	end
	if x1 - x0 ~= self._lw or y1 - y0 ~= self._lh then
		self._lw, self._lh = x1 - x0, y1 - y0
		label.Size = UDim2.fromOffset(x1 - x0, y1 - y0)
	end
	local now = FrameClock.now()
	-- (the view about to show what was not drawn: drawn now)
	if self:_follow_view(cam) then
		self._next = 0
	end
	if now < self._next then
		return
	end
	local surface = self.view.surface
	if surface ~= nil and surface.uploaded and self._skipped < FalloutGlow.SKIP_MAX then
		self._skipped += 1
		return
	end
	self._skipped = 0
	local t0 = os.clock()
	self:_draw(st, W)
	local wait = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		then FalloutGlow.UPDATE_S_MOBILE
		else FalloutGlow.UPDATE_S
	-- (not while a Studio film steps the clock: its frames take real time the film does not)
	if FrameClock.film == nil then
		wait = math.max(wait, (os.clock() - t0) * FalloutGlow.DUTY)
	end
	self._next = now + wait
end

function FalloutGlow._clear_box(self: any)
	local box = self._box
	local img = self._img
	if box == nil or img == nil then
		return
	end
	local w, h = box[3] - box[1] + 1, box[4] - box[2] + 1
	-- (zeros, never written to: kept while boxes of this size come and go)
	if self._zero_cells ~= w * h then
		self._zero_cells = w * h
		self._zero = buffer.create(w * h * 4)
	end
	img:WritePixelsBuffer(Vector2.new(box[1], box[2]), Vector2.new(w, h), self._zero :: buffer)
	self._box = nil
end

function FalloutGlow._draw(self: any, st: any, W: number)
	local G = FalloutGlow
	local S = G.SCALE
	local half = S / 2
	local bw, bh = self._bw, self._bh
	local rt = st.render_tick or st.tick or 0
	local own = st.owner
	local decay = G.HEAT_DECAY_PER_TICK / 255
	local hot, noise = self._hot, self._noise
	-- the hot blocks (the cold ones go) and their box (into the other list, swapped with this one)
	local order = self._order
	local live = self._live
	table.clear(live)
	local n, missing = 0, 0
	local i0, j0, i1, j1 = math.huge, math.huge, -1, -1
	for _, b in order do
		local t0 = hot[b]
		if t0 == nil then
			continue
		end
		local heat = 1 - (rt - t0) * decay
		if heat <= 0 then
			hot[b] = nil
			noise[b] = nil
			continue
		end
		n += 1
		live[n] = b
		if noise[b] == nil then
			missing += 1
		end
		local i, j = b % bw, b // bw
		if i < i0 then
			i0 = i
		end
		if i > i1 then
			i1 = i
		end
		if j < j0 then
			j0 = j
		end
		if j > j1 then
			j1 = j
		end
	end
	self._order, self._live = live, order
	local fb = self._fb
	if n == 0 then
		fb[3] = -1
		self:_clear_box()
		self:_show(false)
		return
	end
	fb[1], fb[2], fb[3], fb[4] = math.max(0, i0 - 2), math.max(0, j0 - 2), math.min(bw - 1, i1 + 2), math.min(bh - 1, j1 + 2)
	-- the noise: as many blocks as the budget allows, round robin; a block without any first (past
	-- the budget only those: the clock is not asked again, and the loop stops when none is left)
	local deadline = os.clock() + G.NOISE_BUDGET_S
	local spent = false
	local rr = ((self._rr - 1) % n) + 1
	for k = 0, n - 1 do
		local b = live[(rr + k - 1) % n + 1]
		local nz = noise[b]
		if nz ~= nil then
			if spent then
				continue
			elseif os.clock() > deadline then
				spent = true
				if missing == 0 then
					break
				end
				continue
			end
		else
			missing -= 1
		end
		local heat = 1 - (rt - hot[b]) * decay
		local cx, cy = (b % bw) * S + half + 0.5, (b // bw) * S + half + 0.5
		noise[b] = noise_of(cx, cy, heat, rt, nz)
		self._rr = (rr + k) % n + 1
		if spent and missing == 0 then
			break
		end
	end
	-- what is drawn (R): the box, 2 blocks of blur either side, inside the image and the window;
	-- worked out over K, R and the blur's reach (2 blocks) inside the image. (Clamped at K's edges
	-- as the box was at its own: at the image's edge the same, elsewhere R's blur stays inside K.)
	local win = self._win
	local ri0, rj0 = math.max(0, i0 - 2, win[1]), math.max(0, j0 - 2, win[2])
	local ri1, rj1 = math.min(bw - 1, i1 + 2, win[3]), math.min(bh - 1, j1 + 2, win[4])
	if ri1 < ri0 or rj1 < rj0 then
		-- (none of it where the view is or can go before the next draw)
		self:_clear_box()
		self:_show(false)
		return
	end
	local ki0, kj0 = math.max(0, ri0 - 2), math.max(0, rj0 - 2)
	local kw, kh = math.min(bw - 1, ri1 + 2) - ki0 + 1, math.min(bh - 1, rj1 + 2) - kj0 + 1
	local w, h = ri1 - ri0 + 1, rj1 - rj0 + 1
	-- extract (premultiplied) into a float grid of K (scratch buffers kept, grown as needed)
	local kcells, cells = kw * kh, w * h
	if self._cap == nil or self._cap < kcells then
		self._cap = kcells
		self._grid = buffer.create(kcells * 16)
		self._tmp = buffer.create(kcells * 16)
	end
	if self._out_cells ~= cells then
		self._out_cells = cells
		self._out = buffer.create(cells * 4)
	end
	local grid, tmp = self._grid, self._tmp
	local out = self._out :: buffer
	buffer.fill(grid, 0, 0, kcells * 16)
	buffer.fill(tmp, 0, 0, kcells * 16)
	buffer.fill(out, 0, 0, cells * 4)
	-- each row's first and last column with glow (1-based by row)
	local rlo, rhi = self._rlo, self._rhi
	for y = 1, kh do
		rlo[y], rhi[y] = kw, -1
	end
	local h1s, h2s = self._h1, self._h2
	local ki1, kj1 = ki0 + kw - 1, kj0 + kh - 1
	local writef32, readf32, writeu8 = buffer.writef32, buffer.readf32, buffer.writeu8
	for _, b in live do
		local i, j = b % bw, b // bw
		if i < ki0 or i > ki1 or j < kj0 or j > kj1 then
			continue
		end
		local heat = 1 - (rt - hot[b]) * decay
		local tile = (j * S + S // 2) * W + i * S + S // 2
		local owned = own ~= nil and readi32(own, tile * 4) > 0
		local h1, h2 = h1s[b], h2s[b]
		if h1 == nil then
			h1, h2 = hashes(i * S + half + 0.5, j * S + half + 0.5)
			h1s[b], h2s[b] = h1, h2
		end
		local r, g, bb, a = extract(heat, rt, noise[b], owned, h1, h2)
		local x, y = i - ki0, j - kj0 + 1
		local o = ((y - 1) * kw + x) * 16
		writef32(grid, o, r)
		writef32(grid, o + 4, g)
		writef32(grid, o + 8, bb)
		writef32(grid, o + 12, a)
		if x < rlo[y] then
			rlo[y] = x
		end
		if x > rhi[y] then
			rhi[y] = x
		end
	end
	-- blur across, then down, over R's columns that a glowing block reaches (the rest stays zero).
	-- Each pass slides a window of the 5 cells it weighs along its row / column: one read per cell
	-- and channel, not five (the same sums in the same order).
	local wt = G.BLUR
	local w0, w1, w2 = wt[1], wt[2], wt[3]
	local cov = G.COVERAGE
	local xr0, xr1, yr0 = ri0 - ki0, ri1 - ki0, rj0 - kj0
	-- per column of K: the first and last row blurred across (1-based by column; -1: none)
	local cf, cl = self._cf, self._cl
	for x = xr0 + 1, xr1 + 1 do
		cf[x], cl[x] = -1, -1
	end
	for y = 0, kh - 1 do
		local lo, hi = rlo[y + 1], rhi[y + 1]
		if hi < 0 then
			continue
		end
		local xa, xb = math.max(xr0, lo - 2), math.min(xr1, hi + 2)
		if xb < xa then
			continue
		end
		local row = y * kw
		local q = (row + math.max(0, xa - 2)) * 16
		local rm2, gm2, bm2, am2 = readf32(grid, q), readf32(grid, q + 4), readf32(grid, q + 8), readf32(grid, q + 12)
		q = (row + math.max(0, xa - 1)) * 16
		local rm1, gm1, bm1, am1 = readf32(grid, q), readf32(grid, q + 4), readf32(grid, q + 8), readf32(grid, q + 12)
		q = (row + xa) * 16
		local r0, g0, b0, a0 = readf32(grid, q), readf32(grid, q + 4), readf32(grid, q + 8), readf32(grid, q + 12)
		q = (row + math.min(kw - 1, xa + 1)) * 16
		local rp1, gp1, bp1, ap1 = readf32(grid, q), readf32(grid, q + 4), readf32(grid, q + 8), readf32(grid, q + 12)
		q = (row + math.min(kw - 1, xa + 2)) * 16
		local rp2, gp2, bp2, ap2 = readf32(grid, q), readf32(grid, q + 4), readf32(grid, q + 8), readf32(grid, q + 12)
		for x = xa, xb do
			local p = (row + x) * 16
			writef32(tmp, p, r0 * w0 + (rp1 + rm1) * w1 + (rp2 + rm2) * w2)
			writef32(tmp, p + 4, g0 * w0 + (gp1 + gm1) * w1 + (gp2 + gm2) * w2)
			writef32(tmp, p + 8, b0 * w0 + (bp1 + bm1) * w1 + (bp2 + bm2) * w2)
			writef32(tmp, p + 12, a0 * w0 + (ap1 + am1) * w1 + (ap2 + am2) * w2)
			if cl[x + 1] < 0 then
				cf[x + 1] = y
			end
			cl[x + 1] = y
			q = (row + math.min(kw - 1, x + 3)) * 16
			rm2, rm1, r0, rp1, rp2 = rm1, r0, rp1, rp2, readf32(grid, q)
			gm2, gm1, g0, gp1, gp2 = gm1, g0, gp1, gp2, readf32(grid, q + 4)
			bm2, bm1, b0, bp1, bp2 = bm1, b0, bp1, bp2, readf32(grid, q + 8)
			am2, am1, a0, ap1, ap2 = am1, a0, ap1, ap2, readf32(grid, q + 12)
		end
	end
	local yr1 = yr0 + h - 1
	for x = xr0, xr1 do
		local last = cl[x + 1]
		if last < 0 then
			continue
		end
		-- R's rows the blur down reaches in this column
		local ya, yb = math.max(yr0, cf[x + 1] - 2), math.min(yr1, last + 2)
		if yb < ya then
			continue
		end
		local q = (math.max(0, ya - 2) * kw + x) * 16
		local rm2, gm2, bm2, am2 = readf32(tmp, q), readf32(tmp, q + 4), readf32(tmp, q + 8), readf32(tmp, q + 12)
		q = (math.max(0, ya - 1) * kw + x) * 16
		local rm1, gm1, bm1, am1 = readf32(tmp, q), readf32(tmp, q + 4), readf32(tmp, q + 8), readf32(tmp, q + 12)
		q = (ya * kw + x) * 16
		local r0, g0, b0, a0 = readf32(tmp, q), readf32(tmp, q + 4), readf32(tmp, q + 8), readf32(tmp, q + 12)
		q = (math.min(kh - 1, ya + 1) * kw + x) * 16
		local rp1, gp1, bp1, ap1 = readf32(tmp, q), readf32(tmp, q + 4), readf32(tmp, q + 8), readf32(tmp, q + 12)
		q = (math.min(kh - 1, ya + 2) * kw + x) * 16
		local rp2, gp2, bp2, ap2 = readf32(tmp, q), readf32(tmp, q + 4), readf32(tmp, q + 8), readf32(tmp, q + 12)
		for yk = ya, yb do
			-- (alpha first: a pixel with none is left clear; each channel times COVERAGE, at most 1)
			local a = math.min(1, (a0 * w0 + (ap1 + am1) * w1 + (ap2 + am2) * w2) * cov)
			if a > 0.002 then
				-- premultiplied to straight alpha for the GUI
				local o = ((yk - yr0) * w + x - xr0) * 4
				local r = math.min(1, (r0 * w0 + (rp1 + rm1) * w1 + (rp2 + rm2) * w2) * cov)
				local g = math.min(1, (g0 * w0 + (gp1 + gm1) * w1 + (gp2 + gm2) * w2) * cov)
				local bb = math.min(1, (b0 * w0 + (bp1 + bm1) * w1 + (bp2 + bm2) * w2) * cov)
				writeu8(out, o, math.min(255, floor(r / a * 255 + 0.5)))
				writeu8(out, o + 1, math.min(255, floor(g / a * 255 + 0.5)))
				writeu8(out, o + 2, math.min(255, floor(bb / a * 255 + 0.5)))
				writeu8(out, o + 3, floor(a * 255 + 0.5))
			end
			q = (math.min(kh - 1, yk + 3) * kw + x) * 16
			rm2, rm1, r0, rp1, rp2 = rm1, r0, rp1, rp2, readf32(tmp, q)
			gm2, gm1, g0, gp1, gp2 = gm1, g0, gp1, gp2, readf32(tmp, q + 4)
			bm2, bm1, b0, bp1, bp2 = bm1, b0, bp1, bp2, readf32(tmp, q + 8)
			am2, am1, a0, ap1, ap2 = am1, a0, ap1, ap2, readf32(tmp, q + 12)
		end
	end
	-- the last box where this one does not reach is cleared first
	local box = self._box
	if box ~= nil and (box[1] < ri0 or box[2] < rj0 or box[3] > ri1 or box[4] > rj1) then
		self:_clear_box()
	end
	local img = self._img :: EditableImage
	img:WritePixelsBuffer(Vector2.new(ri0, rj0), Vector2.new(w, h), out)
	local nb = self._box_buf
	nb[1], nb[2], nb[3], nb[4] = ri0, rj0, ri1, rj1
	self._box = nb
	self:_show(true)
end

return FalloutGlow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">FrameClock</string>
              <string name="Source"><![CDATA[--!strict
-- The client's frame time: the real one (os.clock, RenderStepped's dt), except while a Studio film
-- (Dev/Film: the trailer, 2026-10-12) steps time itself,
-- a frame at a time, so a capture of each frame plays back smoothly. The session, the map and the HUD
-- take their dt from here and the map's animations their clock.
local FrameClock = {}

--- Dev/Film while filming: { t = seconds, dt = this frame's seconds }.
FrameClock.film = nil :: { t: number, dt: number }?

function FrameClock.now(): number
	local f = FrameClock.film
	return if f ~= nil then f.t else os.clock()
end

function FrameClock.dt(real: number): number
	local f = FrameClock.film
	return if f ~= nil then f.dt else real
end

return FrameClock
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">FrontLayer</string>
              <string name="Source"><![CDATA[--!native
-- Troop counts on the local player's fronts (a label per attack front, floating over the map):
-- every 200 ms, for each attack by the local player on another owner (blue
-- #3fa9f5) and each attack on the local player by a player or nation, not a tribe (red #f87171),
-- the front is split into connected clusters (8-neighbours); the two largest (clusters under 30
-- full-size tiles dropped, the largest always kept) get a label with the attack's troops
-- (render_troops) at the front tile nearest the cluster's centroid. Labels glide to new positions
-- over 250 ms (snap beyond 200 full-size tiles) and keep a constant on-screen size.
--
-- The front: the label belongs on the attack's frontier, the whole shared border; the
-- client has no frontier, so it uses the local player's border tiles (UI BorderTracker, handed
-- over with set_borders) that touch the other owner.
-- (2026-10-26, phones' slow frames: a poll works in tables kept from one poll to the next, and a label
-- is written only what changed.)
local RS = game:GetService("ReplicatedStorage")
local Airfront = RS:WaitForChild("Airfront")
local Core = Airfront:WaitForChild("Core")
local Defs = require(Core:WaitForChild("Defs")) :: any
local Rules = require(Core:WaitForChild("Rules")) :: any
local NumberFormat = require(Core:WaitForChild("NumberFormat")) :: any
local FrameClock = require(script.Parent:WaitForChild("FrameClock")) :: any

local FrontLayer = {}
FrontLayer.__index = FrontLayer

FrontLayer.POLL_S = 0.2
FrontLayer.ANIM_S = 0.25
FrontLayer.SNAP_FULL = 200 -- full-size tiles
FrontLayer.MIN_CLUSTER_FULL = 30 -- full-size tiles
FrontLayer.MAX_CLUSTERS = 2
FrontLayer.OUTGOING = Color3.fromRGB(0x3f, 0xa9, 0xf5)
FrontLayer.INCOMING = Color3.fromRGB(0xf8, 0x71, 0x71)
FrontLayer.TEXT_PX = 17
FrontLayer.FONT = Font.fromId(12187365977, Enum.FontWeight.Bold)
FrontLayer.Z = 24

type Slot = { cx: number, cy: number, sx: number, sy: number, dx: number, dy: number, t0: number }
type Entry = { text: string, incoming: boolean, slots: { Slot }, seen: boolean }
--- A label and what it was last given (Roblox's own values, kept here).
type Label = { label: TextLabel, vis: boolean, text: string?, incoming: boolean?, x: number, y: number }
--- An attack worth a label, this poll.
type Todo = { aid: number, other: number, incoming: boolean, troops: number }

function FrontLayer.new(parent: Instance, view: any)
	local self = setmetatable({}, FrontLayer) :: any
	local root = Instance.new("Frame")
	root.Name = "Fronts"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = FrontLayer.Z
	root.Parent = parent
	self.root = root
	self.view = view
	self._state = nil :: any
	self._borders = nil :: any
	--- aid -> label entry
	self._entries = {} :: { [number]: Entry }
	self._labels = {} :: { Label }
	self._poll = 0.0
	--- (a poll's working tables: the owners wanted, the attacks (records reused), owner -> front
	--- tiles (an empty list: none))
	self._wanted = {} :: { [number]: boolean }
	self._todo = {} :: { Todo }
	self._fronts = {} :: { [number]: { number } }
	return self
end

function FrontLayer.bind(self: any, state: any)
	self._state = state
	table.clear(self._entries)
	self._poll = 0.0
end

function FrontLayer.unbind(self: any)
	self._state = nil
	table.clear(self._entries)
	for _, l in self._labels do
		l.vis = false
		l.label.Visible = false
	end
end

function FrontLayer.destroy(self: any)
	self:unbind()
	self.root:Destroy()
end

--- The UI's BorderTracker (its `border` set holds the local player's border tiles).
function FrontLayer.set_borders(self: any, tracker: any)
	self._borders = tracker
end

--- Border tiles of the local player touching each owner in `wanted`, into `out`: owner -> { tile }
--- (its lists emptied first and kept; an owner with none has an empty list or none).
local function fronts_by_owner(
	st: any,
	border: { [number]: boolean },
	wanted: { [number]: boolean },
	out: { [number]: { number } }
)
	for _, list in out do
		table.clear(list)
	end
	local W = st.map.W or Defs.W
	local N = st.map.N or (W * (st.map.H or Defs.H))
	for t in border do
		local x = t % W
		local hit = 0
		local o = 0
		if x > 0 then
			o = st:tile_owner(t - 1)
			if wanted[o] then
				hit = o
			end
		end
		if hit == 0 and x < W - 1 then
			o = st:tile_owner(t + 1)
			if wanted[o] then
				hit = o
			end
		end
		if hit == 0 and t >= W then
			o = st:tile_owner(t - W)
			if wanted[o] then
				hit = o
			end
		end
		if hit == 0 and t + W < N then
			o = st:tile_owner(t + W)
			if wanted[o] then
				hit = o
			end
		end
		if hit ~= 0 then
			local list = out[hit]
			if list == nil then
				list = {}
				out[hit] = list
			end
			table.insert(list, t)
		end
	end
end

-- clusters()'s working tables, kept (it runs for each front every POLL_S): the tiles, those reached,
-- one cluster's queue, the clusters found (records reused from c_pool) and the result
local c_set: { [number]: boolean } = {}
local c_seen: { [number]: boolean } = {}
local c_queue: { number } = {}
local c_found: { { tile: number, size: number } } = {}
local c_pool: { { tile: number, size: number } } = {}
local c_out: { number } = {}

local function by_size(a: { tile: number, size: number }, b: { tile: number, size: number }): boolean
	return a.size > b.size
end

--- Representative tiles of the largest connected clusters of `tiles` (the list is reused by the
--- next call).
local function clusters(tiles: { number }, W: number, min_size: number, max_n: number): { number }
	local set, seen, queue, found = c_set, c_seen, c_queue, c_found
	table.clear(set)
	table.clear(seen)
	table.clear(found)
	for _, t in tiles do
		set[t] = true
	end
	for _, start in tiles do
		if seen[start] then
			continue
		end
		seen[start] = true
		table.clear(queue)
		queue[1] = start
		local qi = 1
		local sx, sy = 0, 0
		while qi <= #queue do
			local t = queue[qi]
			qi += 1
			local x = t % W
			sx += x
			sy += t // W
			for dy = -1, 1 do
				for dx = -1, 1 do
					if dx == 0 and dy == 0 then
						continue
					end
					local nx = x + dx
					if nx < 0 or nx >= W then
						continue
					end
					local n = t + dy * W + dx
					if set[n] and not seen[n] then
						seen[n] = true
						table.insert(queue, n)
					end
				end
			end
		end
		local count = #queue
		local cx, cy = sx / count, sy / count
		local best, bd = queue[1], math.huge
		for _, t in queue do
			local ddx, ddy = t % W - cx, t // W - cy
			local d = ddx * ddx + ddy * ddy
			if d < bd then
				bd = d
				best = t
			end
		end
		local nf = #found + 1
		local rec = c_pool[nf]
		if rec == nil then
			rec = { tile = 0, size = 0 }
			c_pool[nf] = rec
		end
		rec.tile, rec.size = best, count
		found[nf] = rec
	end
	table.sort(found, by_size)
	local out = c_out
	table.clear(out)
	for i, c in found do
		if #out >= max_n then
			break
		end
		if i == 1 or c.size >= min_size then
			table.insert(out, c.tile)
		end
	end
	return out
end

--- A slot's distance to tile `t`'s centre (map units, Manhattan).
local function slot_dist(s: Slot, t: number, W: number): number
	return math.abs(s.dx - (t % W + 0.5)) + math.abs(s.dy - (t // W + 0.5))
end

function FrontLayer._poll_fronts(self: any, now: number)
	local st = self._state
	local me = if st ~= nil then st.local_owner else 0
	local tracker = self._borders
	for _, e in self._entries do
		e.seen = false
	end
	if st == nil or me == 0 or tracker == nil or tracker.me ~= me then
		table.clear(self._entries)
		return
	end
	-- attacks worth a label (outgoing on players, incoming from non-tribe players)
	local wanted = self._wanted
	table.clear(wanted)
	local todo = self._todo
	local todo_n = 0
	for aid, a in st.attacks do
		local other = 0
		local incoming = false
		if a.attacker == me and a.target ~= 0 then
			other = a.target
		elseif a.target == me and a.attacker ~= 0 then
			local o = st:get_owner(a.attacker)
			if o ~= nil and o.kind ~= Defs.KIND_TRIBE then
				other = a.attacker
				incoming = true
			end
		end
		if other ~= 0 then
			wanted[other] = true
			todo_n += 1
			local rec = todo[todo_n]
			if rec == nil then
				rec = {} :: any
				todo[todo_n] = rec
			end
			rec.aid, rec.other, rec.incoming, rec.troops = aid, other, incoming, a.troops
		end
	end
	if todo_n > 0 then
		local k = tonumber(st.map.k_lin) or Rules.K_LIN
		local W = st.map.W or Defs.W
		local fronts = self._fronts
		fronts_by_owner(st, tracker.border, wanted, fronts)
		local snap = FrontLayer.SNAP_FULL / k
		for ti = 1, todo_n do
			local a = todo[ti]
			local tiles = fronts[a.other]
			if tiles == nil or #tiles == 0 then
				continue
			end
			local reps = clusters(tiles, W, FrontLayer.MIN_CLUSTER_FULL / k, FrontLayer.MAX_CLUSTERS)
			local e = self._entries[a.aid]
			if e == nil then
				e = { text = "", incoming = a.incoming, slots = {}, seen = true }
				self._entries[a.aid] = e
			end
			e.seen = true
			e.incoming = a.incoming
			e.text = NumberFormat.render_troops(a.troops)
			local slots = e.slots
			-- keep two labels on their own clusters (swapped when that is shorter)
			if #reps == 2 and #slots == 2 then
				local s1, s2 = slots[1], slots[2]
				if
					slot_dist(s1, reps[2], W) + slot_dist(s2, reps[1], W)
					< slot_dist(s1, reps[1], W) + slot_dist(s2, reps[2], W)
				then
					reps[1], reps[2] = reps[2], reps[1]
				end
			end
			while #slots > #reps do
				table.remove(slots)
			end
			for i, t in reps do
				local nx, ny = t % W + 0.5, t // W + 0.5
				local s = slots[i]
				if s == nil then
					slots[i] = { cx = nx, cy = ny, sx = nx, sy = ny, dx = nx, dy = ny, t0 = now }
					continue
				end
				local f = math.min(1, (now - s.t0) / FrontLayer.ANIM_S)
				local cx, cy = s.sx + (s.dx - s.sx) * f, s.sy + (s.dy - s.sy) * f
				if math.sqrt((nx - cx) ^ 2 + (ny - cy) ^ 2) > snap then
					cx, cy = nx, ny
				end
				s.sx, s.sy, s.cx, s.cy = cx, cy, cx, cy
				s.dx, s.dy, s.t0 = nx, ny, now
			end
		end
	end
	for aid, e in self._entries do
		if not e.seen then
			self._entries[aid] = nil
		end
	end
end

local function label(self: any, n: number): Label
	local rec = self._labels[n]
	if rec ~= nil then
		return rec
	end
	local l = Instance.new("TextLabel")
	l.Name = "FrontTroops"
	l.BackgroundTransparency = 1
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.AutomaticSize = Enum.AutomaticSize.XY
	l.Size = UDim2.fromOffset(0, 0)
	l.FontFace = FrontLayer.FONT
	l.TextSize = FrontLayer.TEXT_PX
	l.ZIndex = FrontLayer.Z
	l.Parent = self.root
	local s = Instance.new("UIStroke")
	s.Color = Color3.new(0, 0, 0)
	s.Thickness = 1.5
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = l
	rec = { label = l, vis = true, text = nil, incoming = nil, x = math.huge, y = math.huge }
	self._labels[n] = rec
	return rec :: Label
end

function FrontLayer.tick(self: any, dt: number)
	local now = FrameClock.now()
	self._poll -= dt
	if self._poll <= 0 then
		self._poll = FrontLayer.POLL_S
		self:_poll_fronts(now)
	end
	local cam = self.view.rig
	local n = 0
	for _, e in self._entries do
		for _, s in e.slots do
			local f = math.min(1, (now - s.t0) / FrontLayer.ANIM_S)
			s.cx = s.sx + (s.dx - s.sx) * f
			s.cy = s.sy + (s.dy - s.sy) * f
			local x, y = cam:map_to_screen(s.cx, s.cy)
			if not cam:on_screen(x, y, 40) then
				continue
			end
			n += 1
			local rec = label(self, n)
			local l = rec.label
			-- (each written only when it changed: the text is measured again on every write)
			if not rec.vis then
				rec.vis = true
				l.Visible = true
			end
			if rec.text ~= e.text then
				rec.text = e.text
				l.Text = e.text
			end
			if rec.incoming ~= e.incoming then
				rec.incoming = e.incoming
				l.TextColor3 = if e.incoming then FrontLayer.INCOMING else FrontLayer.OUTGOING
			end
			if rec.x ~= x or rec.y ~= y then
				rec.x, rec.y = x, y
				l.Position = UDim2.fromOffset(x, y)
			end
		end
	end
	for j = n + 1, #self._labels do
		local rec = self._labels[j]
		if rec.vis then
			rec.vis = false
			rec.label.Visible = false
		end
	end
end

return FrontLayer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">FxLayer</string>
              <string name="Source"><![CDATA[--!native
-- Effects on the 2D map: a nuke's shockwave ring grows to 1.5 x its
-- blast radius over 1.5 s behind a white flash, a destroyed ship / shot-down nuke pops a small
-- ring (0.8 s), and the camera shakes a little for nukes near the view. Pooled GUI circles.
-- Conquests by the local player (a flag and a gold popup): a victory
-- flag planted at the conquered name's location, its banner the conqueror's colour (Assets/MapFx:
-- 10 frames of 24 x 24 at 90 ms, drawn 22 full-size tiles wide, 2.5 s, fade in over the first 10 % and
-- out after 60 %; 2026-10-25: it replaced a sword clash for the elimination), and a
-- white "+ 12.3K" gold line below it (font 6 tiles, fading
-- linearly).
-- Both keep a minimum on-screen size, so a zoomed-out map still shows them.
-- Income (2026-10-07:
-- trains show the little money-increase popup as they pass through cities too): gold the local
-- player earned at a tile, a train's stop at a station, is a white "+ 25.0K" that starts 3 full-size tiles
-- above the tile, rises 3 tiles a second and fades out over 1.5 s (font 6 tiles). It keeps a minimum
-- size on screen and is not drawn on a map zoomed far out (and is never bigger than
-- 40 px).
-- Explosions (Assets/MapFx; added 2026-10-04 for a destroyed defense post and for a
-- nuke shot down by a SAM): a
-- destroyed defense post or Arsenal structure plays `building` over a small ring, a nuke shot
-- down plays `sam` where it was. They are seen, not heard (shots and hits were made silent
-- on 2026-09-27: together they were a constant racket).
-- Nukes (since
-- 2026-10-12; the trailer's hydrogen bombs fell flat when a ring and a green stain were all
-- a nuke left): a nuke that lands plays the explosion (Assets/MapFx: 12 frames of
-- 60 x 60 at 70 ms, drawn 60 full-size tiles wide) and leaves debris burning: mini fires, smoke, big
-- smoke and smoke with fire (DEBRIS_PLAN, looping) scattered within half its radius, 6 s, fading in
-- over the first 10 % and out after 80 %; its ring grows to 1.5 x that radius. The radius is the
-- look's (NUKE_FX_RADIUS), not the blast's.
-- Every pooled object remembers what it was last given and is written only what changed (2026-10-26,
-- phones' slow frames: a nuke's 240 debris sprites were written six properties each a frame, with the
-- view still and between their frames), and spent effects leave their lists in one pass, in order.
local ContentProvider = game:GetService("ContentProvider")
local RS = game:GetService("ReplicatedStorage")
local Airfront = RS:WaitForChild("Airfront")
local Defs = require(Airfront:WaitForChild("Core"):WaitForChild("Defs")) :: any
local Rules = require(Airfront:WaitForChild("Core"):WaitForChild("Rules")) :: any
-- Every sprite here is drawn for Rofront, rows of one atlas (tools/assets/make_map_fx.py; 2026-10-25:
-- all new art): the explosions, the debris a nuke leaves and the conquest's flag.
local MapFx = require(Airfront:WaitForChild("Assets"):WaitForChild("MapFx")) :: any
local FrameClock = require(script.Parent:WaitForChild("FrameClock")) :: any
local ChakraEffects = require(script.Parent:WaitForChild("ChakraEffects"))

local FxLayer = {}
FxLayer.__index = FxLayer

FxLayer.NUKE_SHOCK_S = 1.5
FxLayer.NUKE_SHOCK_K = 1.5
FxLayer.POP_S = 0.8
FxLayer.POP_RADIUS = 40 -- full-size tiles (the ring of a ship or nuke shot down)
FxLayer.Z = 16
FxLayer.CONQUEST_S = 2.5
FxLayer.CONQUEST_FADE_IN = 0.1
FxLayer.CONQUEST_FADE_OUT = 0.6
--- the flag's frames in Assets/MapFx (px: `flag` in its colours, `banner` the cloth under it, tinted),
--- how wide it is drawn (full-size tiles) and at least (px) (2026-10-26: 12 and 24, from 22 and 30:
--- the flag was too big)
FxLayer.FLAG = MapFx.flag
FxLayer.BANNER = MapFx.banner
FxLayer.FLAG_FRAME_S = 0.09
FxLayer.FLAG_WORLD = 12
FxLayer.FLAG_MIN_PX = 24
--- a banner colour darker than this (luminance) is lightened toward white by BANNER_LIFT, so the cloth
--- stands out from the flag's dark outline
FxLayer.BANNER_MIN_LUMA = 0.32
FxLayer.BANNER_LIFT = 0.3
FxLayer.GOLD_Y_OFFSET = 8 -- full-size tiles below the name
FxLayer.GOLD_SIZE = 6 -- full-size tiles
FxLayer.GOLD_MIN_PX = 15
FxLayer.GOLD_FONT = Font.fromId(12187365977, Enum.FontWeight.Bold)
--- Income popups: lifetime, rise (full-size tiles a second), where it starts
--- (tiles above the tile), the font (tiles; at least BONUS_MIN_PX on screen), the zoom (px per full-size
--- tile) under which none are drawn, and how many may be up at once.
FxLayer.BONUS_S = 1.5
FxLayer.BONUS_RISE = 3.0
FxLayer.BONUS_Y_OFFSET = -3.0
FxLayer.BONUS_SIZE = 6.0
FxLayer.BONUS_MIN_PX = 13
--- (on a map zoomed far in, 6 tiles of text would fill the screen)
FxLayer.BONUS_MAX_PX = 40
FxLayer.BONUS_CULL_ZOOM = 0.3
FxLayer.BONUS_MAX = 48
--- The explosion sprites, rows of Assets/MapFx: where the row starts in the atlas (x, y), a frame's
--- size, how many frames and how long each shows, how wide it is drawn (full-size tiles) and the least
--- it is drawn on screen (px). (`loop`: the debris, which cycle until their lifetime ends)
local function fx_row(name: string, frame_s: number, world: number, min_px: number, loop: boolean?)
	local r = MapFx[name]
	return {
		x = r.x,
		y = r.y,
		w = r.w,
		h = r.h,
		frames = r.frames,
		frame_s = frame_s,
		world = world,
		min_px = min_px,
		loop = loop,
	}
end
FxLayer.BURSTS = {
	building = fx_row("building", 0.07, 18, 32),
	sam = fx_row("sam", 0.08, 40, 60),
	nuke = fx_row("nuke", 0.07, 60, 36),
	fire = fx_row("fire", 0.1, 7, 4, true),
	smoke = fx_row("smoke", 0.12, 11, 6, true),
	big_smoke = fx_row("big_smoke", 0.12, 24, 12, true),
	smoke_fire = fx_row("smoke_fire", 0.12, 24, 12, true),
}
--- A nuke's look by Defs.N_* (full-size tiles): 70 for an atom bomb, 160 for a hydrogen bomb, 70 a
--- MIRV warhead; the Arsenal's Mega Nuke (a blast between the two) 120, a Scatter
--- bomb an atom's.
FxLayer.NUKE_FX_RADIUS = { [0] = 70, [1] = 160, [3] = 70, [4] = 120, [5] = 200 }

local CHAKRA = ChakraEffects.profiles(Defs)
local STRUCTURE_BLAST = { name = "FlyingRubble", color = Color3.fromRGB(255, 143, 65), core = Color3.fromRGB(99, 74, 65), speed = 3, duration = 1.35, mode = "rubble" }
--- The debris a nuke leaves: the sprite, how far out (of the radius) and how many (radius x density)
FxLayer.DEBRIS_PLAN = {
	{ kind = "fire", factor = 1.0, density = 1 / 25 },
	{ kind = "smoke", factor = 1.0, density = 1 / 28 },
	{ kind = "big_smoke", factor = 0.9, density = 1 / 70 },
	{ kind = "smoke_fire", factor = 0.9, density = 1 / 70 },
}
FxLayer.DEBRIS_S = 6.0 -- s each debris sprite lasts
FxLayer.DEBRIS_FADE_IN = 0.1
FxLayer.DEBRIS_FADE_OUT = 0.8
--- Every sprite is a GUI object, and a MIRV's 350 warheads would be some 2,500
--- GUI objects. So at most BURST_MAX explosions and DEBRIS_MAX debris are up at once (the newest
--- wait their turn: none is drawn), and of a strike's warheads about WARHEAD_DEBRIS leave debris,
--- picked at random over all of them (so it is spread over the whole strike).
FxLayer.BURST_MAX = 96
FxLayer.DEBRIS_MAX = 240
FxLayer.WARHEAD_DEBRIS = 28
--- how long a strike's warheads are counted together (s)
FxLayer.WARHEAD_WINDOW_S = 10.0

type Fx = { u: number, v: number, r0: number, r1: number, t0: number, dur: number, col: Color3, flash: boolean }
type Pop = { u: number, v: number, t0: number, text: string, col: Color3 }
--- The pools' GUI objects, each with what it was last given (Roblox's own values, kept here: an object
--- shown for another effect still shows them, so nothing needs resetting; `vis` its Visible).
type FxGui = {
	frame: Frame,
	stroke: UIStroke,
	vis: boolean,
	x: number,
	y: number,
	d: number,
	col: Color3?,
	fill_t: number,
	stroke_col: Color3?,
	width: number,
	stroke_t: number,
}
--- (`vis` for all three: they show and hide together)
type PopGui = {
	flag: ImageLabel,
	banner: ImageLabel,
	gold: TextLabel,
	stroke: UIStroke,
	vis: boolean,
	x: number,
	y: number,
	w: number,
	h: number,
	img_t: number,
	flag_ox: number,
	flag_oy: number,
	banner_ox: number,
	banner_oy: number,
	col: Color3?,
	text: string?,
	text_size: number,
	gold_x: number,
	gold_y: number,
	text_t: number,
	width: number,
	stroke_t: number,
}
--- (`life`, `fade_in`, `fade_out`: debris only; a burst ends with its last frame)
type Burst = { u: number, v: number, t0: number, row: any, life: number?, fade_in: number?, fade_out: number? }
type BurstGui = {
	img: ImageLabel,
	vis: boolean,
	x: number,
	y: number,
	w: number,
	h: number,
	rw: number,
	rh: number,
	ox: number,
	oy: number,
	img_t: number,
}
type Bonus = { u: number, v: number, t0: number, text: string }
type BonusGui = {
	label: TextLabel,
	stroke: UIStroke,
	vis: boolean,
	text: string?,
	size: number,
	x: number,
	y: number,
	text_t: number,
	width: number,
	stroke_t: number,
}

function FxLayer.new(parent: Instance, view: any)
	local self = setmetatable({}, FxLayer) :: any
	local root = Instance.new("Frame")
	root.Name = "Fx"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = FxLayer.Z
	root.Parent = parent
	self.root = root
	self._chakra = ChakraEffects.new(root, FxLayer.Z + 3, 5)
	self._rubble = ChakraEffects.new(root, FxLayer.Z + 2, 4)
	self.view = view
	self._state = nil :: any
	self._fx = {} :: { Fx }
	self._frames = {} :: { FxGui }
	self._pops = {} :: { Pop }
	self._pop_gui = {} :: { PopGui }
	self._bursts = {} :: { Burst }
	self._burst_gui = {} :: { BurstGui }
	self._debris = {} :: { Burst }
	self._debris_gui = {} :: { BurstGui }
	--- a strike's warheads: those landed lately (times) and in flight (counted once a frame)
	self._warheads_landed = {} :: { number }
	self._warheads_flying = 0
	self._warheads_counted = -1.0
	self._bonus = {} :: { Bonus }
	self._bonus_gui = {} :: { BonusGui }
	-- Fetch the atlas now: a cold download outlasts the 2.5 s conquest popup.
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ MapFx.id })
		end)
	end)
	return self
end

function FxLayer.bind(self: any, state: any)
	self._state = state
	self._chakra:clear()
	self._rubble:clear()
	table.clear(self._fx)
	table.clear(self._pops)
	table.clear(self._bursts)
	table.clear(self._debris)
	table.clear(self._warheads_landed)
	table.clear(self._bonus)
end

function FxLayer.unbind(self: any)
	self._state = nil
	self._chakra:clear()
	self._rubble:clear()
	table.clear(self._fx)
	table.clear(self._pops)
	table.clear(self._bursts)
	table.clear(self._debris)
	table.clear(self._warheads_landed)
	table.clear(self._bonus)
	for _, g in self._frames do
		g.vis = false
		g.frame.Visible = false
	end
	for _, g in self._bonus_gui do
		g.vis = false
		g.label.Visible = false
	end
	for _, g in self._burst_gui do
		g.vis = false
		g.img.Visible = false
	end
	for _, g in self._debris_gui do
		g.vis = false
		g.img.Visible = false
	end
	for _, g in self._pop_gui do
		g.vis = false
		g.flag.Visible = false
		g.banner.Visible = false
		g.gold.Visible = false
	end
end

function FxLayer.destroy(self: any)
	self:unbind()
	self.root:Destroy()
end

local function add(self: any, tile: number, r0: number, r1: number, dur: number, col: Color3, flash: boolean, delay: number?)
	local st = self._state
	if st == nil or tile < 0 then
		return
	end
	local W = st.map.W or Defs.W
	table.insert(self._fx, {
		u = tile % W + 0.5,
		v = tile // W + 0.5,
		r0 = r0,
		r1 = r1,
		t0 = FrameClock.now() + (delay or 0),
		dur = dur,
		col = col,
		flash = flash,
	})
end

--- 32-bit multiply, low 32 bits (Math.imul, unsigned)
local function imul(a: number, b: number): number
	local ah, al = a // 65536, a % 65536
	return ((ah * b) % 65536 * 65536 + al * b) % 4294967296
end

--- mulberry32: a float in [0, 1) from an integer seed.
function FxLayer.seeded_random(seed: number): number
	local s = (seed + 0x6d2b79f5) % 4294967296
	local t = imul(bit32.bxor(s, bit32.rshift(s, 15)), bit32.bor(1, s))
	t = bit32.bxor((t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(61, t))) % 4294967296, t)
	return bit32.bxor(t, bit32.rshift(t, 14)) / 4294967296
end

--- The debris a nuke leaves: map positions (offsets from the tile in full-size tiles, divided
--- by k) and sprites, for a nuke of look radius `radius` (full-size tiles) at `tile`.
function FxLayer.debris_plan(tile: number, radius: number, k: number): { { kind: string, du: number, dv: number } }
	local out = {}
	local idx = 0
	for _, d in FxLayer.DEBRIS_PLAN do
		local count = math.max(0, math.floor(radius * d.density))
		local r = radius * d.factor
		for _ = 1, count do
			local seed = tile * 997 + idx
			idx += 1
			local angle = FxLayer.seeded_random(seed) * math.pi * 2
			local dist = FxLayer.seeded_random(seed + 0x10000) * (r / 2)
			-- (Math.floor of the offsets in full-size tiles)
			table.insert(out, {
				kind = d.kind,
				du = math.floor(math.cos(angle) * dist) / k,
				dv = math.floor(math.sin(angle) * dist) / k,
			})
		end
	end
	return out
end

--- Whether this warhead leaves debris: about WARHEAD_DEBRIS of a strike's do, picked by its tile.
function FxLayer._warhead_debris(self: any, tile: number): boolean
	local st = self._state
	local now = FrameClock.now()
	local landed = self._warheads_landed
	while #landed > 0 and now - landed[1] > FxLayer.WARHEAD_WINDOW_S do
		table.remove(landed, 1)
	end
	table.insert(landed, now)
	if self._warheads_counted ~= now then
		self._warheads_counted = now
		local n = 0
		for _, m in st.nukes do
			if m.kind == Defs.N_WARHEAD then
				n += 1
			end
		end
		self._warheads_flying = n
	end
	local p = FxLayer.WARHEAD_DEBRIS / math.max(1, #landed + self._warheads_flying)
	return FxLayer.seeded_random(tile * 31 + 7) < p
end

--- GameState.nuke_detonated(uid, kind, tile, radius, owner).
function FxLayer.nuke(self: any, kind: number, tile: number, radius: number)
	-- a MIRV splitting into its warheads: nothing (no look radius of its own; a
	-- flash its spread wide whitened the screen)
	if kind == Defs.N_MIRV then
		return
	end
	local r = radius
	local VR = self.view.view_rules
	if VR then
		local _, outer = VR.nuke_radii(kind)
		if outer > 0 then
			r = outer
		end
	end
	-- a strike (a shell, an air strike, a slug; Data/Arsenal) is a small burst: no flash, no shake
	-- for a shell, a nudge for the others
	if Rules.NUKE_FLAT ~= nil and Rules.NUKE_FLAT[kind] then
		local col = if kind == Defs.N_SLUG then Color3.new(0.75, 0.6, 1) else Color3.new(1, 0.72, 0.35)
		add(self, tile, 0, math.max(r, 2.5) * 1.15, if kind == Defs.N_SHELL then 0.45 else 0.8, col, false)
		if kind ~= Defs.N_SHELL then
			local cam = self.view.rig
			local x, y = cam:tile_to_screen(tile)
			if cam:on_screen(x, y, 200) then
				cam:add_shake(0.25)
			end
		end
		return
	end
	local st = self._state
	local k = tonumber(st and st.map and st.map.k_lin) or Rules.K_LIN
	local look = FxLayer.NUKE_FX_RADIUS[kind]
	local chakra = CHAKRA[kind]
	-- (a warhead's ring without the flash: 350 flashes a look radius
	-- wide whiten the screen)
	add(
		self,
		tile,
		0,
		(if look then look / k else r) * FxLayer.NUKE_SHOCK_K,
		FxLayer.NUKE_SHOCK_S,
		if chakra then chakra.color else Color3.new(1, 0.92, 0.75),
		chakra == nil and kind ~= Defs.N_WARHEAD
	)
	if st ~= nil and look ~= nil and tile >= 0 then
		local W = st.map.W or Defs.W
		local u, v = tile % W + 0.5, tile // W + 0.5
		if chakra ~= nil then
			self._chakra:impact(chakra, tile, r, FrameClock.now())
			if kind == Defs.N_HYDROGEN then
				add(self, tile, r * 1.15, r * 0.12, 0.85, chakra.color, false)
				add(self, tile, r * 0.72, 0, 0.72, chakra.color:Lerp(Color3.new(1, 1, 1), 0.35), false, 0.18)
			else
				add(self, tile, 0, r * 0.72, 0.23, chakra.color:Lerp(Color3.new(1, 1, 1), 0.77), true)
				add(self, tile, r * 0.20, r * 1.28, 1.05, chakra.color, false, 0.17)
				add(self, tile, r * 0.25, r * 1.55, 1.32, chakra.color:Lerp(Color3.fromRGB(255, 192, 124), 0.55), false, 0.33)
			end
		else
			self:burst("nuke", u, v)
		end
		if kind ~= Defs.N_WARHEAD or self:_warhead_debris(tile) then
			local now = FrameClock.now()
			for _, d in FxLayer.debris_plan(tile, look, k) do
				if #self._debris >= FxLayer.DEBRIS_MAX then
					break
				end
				table.insert(self._debris, {
					u = u + d.du,
					v = v + d.dv,
					t0 = now,
					row = FxLayer.BURSTS[d.kind],
					life = FxLayer.DEBRIS_S,
					fade_in = FxLayer.DEBRIS_FADE_IN,
					fade_out = FxLayer.DEBRIS_FADE_OUT,
				})
			end
		end
	end
	local cam = self.view.rig
	local x, y = cam:tile_to_screen(tile)
	if cam:on_screen(x, y, 200) then
		cam:add_shake(if kind == Defs.N_SCATTER then 1.25 elseif kind == Defs.N_HYDROGEN or kind == Defs.N_MEGA then 0.9 else 0.5)
	end
end

--- A ship destroyed / a nuke shot down at `tile`.
function FxLayer.pop(self: any, tile: number, col: Color3?)
	local st = self._state
	local k = tonumber(st and st.map and st.map.k_lin) or Rules.K_LIN
	add(self, tile, 0, FxLayer.POP_RADIUS / k * 0.25, FxLayer.POP_S, col or Color3.new(1, 0.6, 0.25), false)
end

--- An explosion sprite (BURSTS) at map position (u, v) (tile + 0.5 is the tile's centre).
function FxLayer.burst(self: any, kind: string, u: number, v: number)
	local row = FxLayer.BURSTS[kind]
	if self._state == nil or row == nil or #self._bursts >= FxLayer.BURST_MAX then
		return
	end
	table.insert(self._bursts, { u = u, v = v, t0 = FrameClock.now(), row = row })
end

--- GameState.structure_removed (the structure is still in the state): the ones a capture destroys go
--- up in a small explosion (Sim._struct_tile_changed: a defense post, the Arsenal's structures).
function FxLayer.on_structure_removed(self: any, sid: number)
	local st = self._state
	local s = if st ~= nil then st.structures[sid] else nil
	if s == nil then
		return
	end
	local W = st.map.W or Defs.W
	local k = tonumber(st.map.k_lin) or Rules.K_LIN
	self._rubble:impact(STRUCTURE_BLAST, s.tile, 19 / k, FrameClock.now())
	self:burst("building", s.tile % W + 0.5, s.tile // W + 0.5)
	add(self, s.tile, 0, 14 / k, 0.5, Color3.new(1, 0.7, 0.3), false)
end

--- Gold as a popup shows it: one decimal K / M (halves round up), whole numbers
--- below 1,000.
function FxLayer.format_gold(gold: number): string
	local function fixed1(v: number): string
		return string.format("%.1f", math.floor(v * 10 + 0.5) / 10)
	end
	if gold >= 1_000_000 then
		return fixed1(gold / 1_000_000) .. "M"
	elseif gold >= 1_000 then
		return fixed1(gold / 1_000) .. "K"
	end
	return tostring(math.floor(gold))
end

--- The local player conquered someone whose name sat at map tile (u, v) and took `gold`.
--- The banner's tint for an owner's colour: the colour, lightened when it is too dark to show.
function FxLayer.banner_color(c: any): Color3
	if typeof(c) ~= "Color3" then
		return Color3.new(1, 1, 1)
	end
	local luma = c.R * 0.299 + c.G * 0.587 + c.B * 0.114
	return if luma < FxLayer.BANNER_MIN_LUMA then c:Lerp(Color3.new(1, 1, 1), FxLayer.BANNER_LIFT) else c
end

function FxLayer.conquest(self: any, u: number, v: number, gold: number)
	if self._state == nil then
		return
	end
	table.insert(self._pops, {
		u = u,
		v = v,
		t0 = FrameClock.now(),
		text = "+ " .. FxLayer.format_gold(gold),
		col = FxLayer.banner_color(self._state:owner_color(self._state.local_owner)),
	})
end

--- The local player earned `gold` at `tile` (GameState.bonus: a train of theirs stopped at a station,
--- or someone's train at a station of theirs).
function FxLayer.bonus(self: any, tile: number, gold: number)
	local st = self._state
	if st == nil or tile < 0 or gold <= 0 then
		return
	end
	local W = st.map.W or Defs.W
	local list = self._bonus
	if #list >= FxLayer.BONUS_MAX then
		table.remove(list, 1)
	end
	table.insert(list, {
		u = tile % W + 0.5,
		v = tile // W + 0.5,
		t0 = FrameClock.now(),
		text = "+ " .. FxLayer.format_gold(gold),
	})
end

--- Drop a list's entries from n + 1 on (the spent ones were left behind as the live ones moved up).
local function truncate(list: { any }, n: number)
	for i = #list, n + 1, -1 do
		list[i] = nil
	end
end

local function bonus_step(self: any, cam: any, now: number)
	local st = self._state
	local k = tonumber(st and st.map and st.map.k_lin) or Rules.K_LIN
	local zoom = cam.scale / k -- px per full-size tile
	local n = 0
	local list = self._bonus
	local keep = 0
	for i = 1, #list do
		local b = list[i]
		local el = now - b.t0
		if el >= FxLayer.BONUS_S then
			continue
		end
		keep += 1
		list[keep] = b
		if zoom < FxLayer.BONUS_CULL_ZOOM then
			continue
		end
		local fs = math.clamp(FxLayer.BONUS_SIZE * zoom, FxLayer.BONUS_MIN_PX, FxLayer.BONUS_MAX_PX)
		-- (offset and rise are in tiles; under the minimum size they keep pace with the text)
		local unit = fs / FxLayer.BONUS_SIZE
		local x, y = cam:map_to_screen(b.u, b.v)
		y += (FxLayer.BONUS_Y_OFFSET - FxLayer.BONUS_RISE * el) * unit
		if not cam:on_screen(x, y, fs * 4) then
			continue
		end
		n += 1
		local g = self._bonus_gui[n]
		if g == nil then
			local label = Instance.new("TextLabel")
			label.Name = "Income"
			label.BackgroundTransparency = 1
			label.AnchorPoint = Vector2.new(0.5, 0.5)
			label.AutomaticSize = Enum.AutomaticSize.XY
			label.Size = UDim2.fromOffset(0, 0)
			label.FontFace = FxLayer.GOLD_FONT
			label.TextColor3 = Color3.new(1, 1, 1)
			label.ZIndex = FxLayer.Z + 1
			label.Parent = self.root
			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.new(0, 0, 0)
			stroke.LineJoinMode = Enum.LineJoinMode.Round
			stroke.Parent = label
			g = {
				label = label,
				stroke = stroke,
				vis = true,
				text = nil,
				size = -1,
				x = math.huge,
				y = math.huge,
				text_t = -1,
				width = -1,
				stroke_t = -1,
			}
			self._bonus_gui[n] = g
		end
		local t = el / FxLayer.BONUS_S
		local label = g.label
		if not g.vis then
			g.vis = true
			label.Visible = true
		end
		-- (the text and its size seldom change: each write of them makes Roblox measure the text again)
		if g.text ~= b.text then
			g.text = b.text
			label.Text = b.text
		end
		if g.size ~= fs then
			g.size = fs
			label.TextSize = fs
		end
		if g.x ~= x or g.y ~= y then
			g.x, g.y = x, y
			label.Position = UDim2.fromOffset(x, y)
		end
		if g.text_t ~= t then
			g.text_t = t
			label.TextTransparency = t
		end
		local width = math.max(1.5, fs * 0.12)
		if g.width ~= width then
			g.width = width
			g.stroke.Thickness = width
		end
		if g.stroke_t ~= t then
			g.stroke_t = t
			g.stroke.Transparency = t
		end
	end
	truncate(list, keep)
	for j = n + 1, #self._bonus_gui do
		local g = self._bonus_gui[j]
		if g.vis then
			g.vis = false
			g.label.Visible = false
		end
	end
end

local function pop_gui(self: any, n: number): PopGui
	local g = self._pop_gui[n]
	if g ~= nil then
		return g
	end
	-- (the cloth and the flag never share a pixel: their order doesn't matter)
	local function layer(name: string, row: any): ImageLabel
		local l = Instance.new("ImageLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Image = MapFx.id
		l.ImageRectSize = Vector2.new(row.w, row.h)
		l.ResampleMode = Enum.ResamplerMode.Pixelated
		l.ZIndex = FxLayer.Z
		l.Parent = self.root
		return l
	end
	local banner = layer("ConquestBanner", FxLayer.BANNER)
	local flag = layer("Conquest", FxLayer.FLAG)
	local gold = Instance.new("TextLabel")
	gold.Name = "ConquestGold"
	gold.BackgroundTransparency = 1
	gold.AnchorPoint = Vector2.new(0.5, 0.5)
	gold.AutomaticSize = Enum.AutomaticSize.XY
	gold.Size = UDim2.fromOffset(0, 0)
	gold.FontFace = FxLayer.GOLD_FONT
	gold.TextColor3 = Color3.new(1, 1, 1)
	gold.ZIndex = FxLayer.Z + 1
	gold.Parent = self.root
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = gold
	g = {
		flag = flag,
		banner = banner,
		gold = gold,
		stroke = stroke,
		vis = true,
		x = math.huge,
		y = math.huge,
		w = -1,
		h = -1,
		img_t = -1,
		flag_ox = -1,
		flag_oy = -1,
		banner_ox = -1,
		banner_oy = -1,
		col = nil,
		text = nil,
		text_size = -1,
		gold_x = math.huge,
		gold_y = math.huge,
		text_t = -1,
		width = -1,
		stroke_t = -1,
	}
	self._pop_gui[n] = g
	return g :: PopGui
end

local function pops_step(self: any, cam: any, now: number)
	local st = self._state
	local k = tonumber(st and st.map and st.map.k_lin) or Rules.K_LIN
	local n = 0
	local list = self._pops
	local keep = 0
	for i = 1, #list do
		local p = list[i]
		local el = now - p.t0
		if el >= FxLayer.CONQUEST_S then
			continue
		end
		keep += 1
		list[keep] = p
		local x, y = cam:map_to_screen(p.u, p.v)
		local sw = math.max(FxLayer.FLAG_MIN_PX, FxLayer.FLAG_WORLD / k * cam.scale)
		if not cam:on_screen(x, y, sw * 2) then
			continue
		end
		n += 1
		local g = pop_gui(self, n)
		local t = el / FxLayer.CONQUEST_S
		local a = 1.0
		if t < FxLayer.CONQUEST_FADE_IN then
			a = t / FxLayer.CONQUEST_FADE_IN
		elseif t > FxLayer.CONQUEST_FADE_OUT then
			a = (1 - t) / (1 - FxLayer.CONQUEST_FADE_OUT)
		end
		local F, B = FxLayer.FLAG, FxLayer.BANNER
		local frame = math.min(math.floor(el / FxLayer.FLAG_FRAME_S), F.frames - 1)
		local flag, banner = g.flag, g.banner
		-- the flag and its cloth: one place, size and fade
		if not g.vis then
			g.vis = true
			flag.Visible = true
			banner.Visible = true
			g.gold.Visible = true
		end
		if g.x ~= x or g.y ~= y then
			g.x, g.y = x, y
			local pos = UDim2.fromOffset(x, y)
			flag.Position = pos
			banner.Position = pos
		end
		local sh = sw * F.h / F.w
		if g.w ~= sw or g.h ~= sh then
			g.w, g.h = sw, sh
			local size = UDim2.fromOffset(sw, sh)
			flag.Size = size
			banner.Size = size
		end
		local img_t = 1 - a
		if g.img_t ~= img_t then
			g.img_t = img_t
			flag.ImageTransparency = img_t
			banner.ImageTransparency = img_t
		end
		local fox, foy = F.x + frame * F.w, F.y
		if g.flag_ox ~= fox or g.flag_oy ~= foy then
			g.flag_ox, g.flag_oy = fox, foy
			flag.ImageRectOffset = Vector2.new(fox, foy)
		end
		local box, boy = B.x + frame * B.w, B.y
		if g.banner_ox ~= box or g.banner_oy ~= boy then
			g.banner_ox, g.banner_oy = box, boy
			banner.ImageRectOffset = Vector2.new(box, boy)
		end
		if g.col ~= p.col then
			g.col = p.col
			banner.ImageColor3 = p.col
		end
		local fs = math.max(FxLayer.GOLD_MIN_PX, FxLayer.GOLD_SIZE / k * cam.scale)
		-- GOLD_Y_OFFSET's 8 tiles scaled with the flag; its mound ends 0.42 of the sprite below its
		-- centre, so the line never overlaps it when the minimum sizes apply
		local gy = math.max(sw * FxLayer.GOLD_Y_OFFSET / FxLayer.FLAG_WORLD, sw * 0.42 + fs * 0.5)
		local gold = g.gold
		if g.text ~= p.text then
			g.text = p.text
			gold.Text = p.text
		end
		local ts = math.min(fs, 100)
		if g.text_size ~= ts then
			g.text_size = ts
			gold.TextSize = ts
		end
		if g.gold_x ~= x or g.gold_y ~= y + gy then
			g.gold_x, g.gold_y = x, y + gy
			gold.Position = UDim2.fromOffset(x, y + gy)
		end
		if g.text_t ~= t then
			g.text_t = t
			gold.TextTransparency = t
		end
		local width = math.max(1.5, fs * 0.12)
		if g.width ~= width then
			g.width = width
			g.stroke.Thickness = width
		end
		if g.stroke_t ~= t then
			g.stroke_t = t
			g.stroke.Transparency = t
		end
	end
	truncate(list, keep)
	for j = n + 1, #self._pop_gui do
		local g = self._pop_gui[j]
		if g.vis then
			g.vis = false
			g.flag.Visible = false
			g.banner.Visible = false
			g.gold.Visible = false
		end
	end
end

--- Draw a list of bursts (or debris) with its pool; a looping one runs until its `life`, fading.
local function bursts_step(self: any, cam: any, now: number, list: { Burst }, pool: { BurstGui }, z: number)
	local st = self._state
	local k = tonumber(st and st.map and st.map.k_lin) or Rules.K_LIN
	local n = 0
	local keep = 0
	-- (MapCamera.map_to_screen and on_screen worked out here, the same sums: a nuke's debris are
	-- hundreds of sprites, each projected every frame, and a phone runs Luau without native code)
	local ax, ay = cam:anchor()
	local sc, cu, cv = cam.scale, cam.cu, cam.cv
	local vp = cam:viewport_size()
	local vw, vh = vp.X, vp.Y
	for i = 1, #list do
		local b = list[i]
		local row = b.row
		local el = now - b.t0
		local frame = math.floor(el / row.frame_s)
		local a = 1.0
		if b.life ~= nil then
			if el >= b.life then
				continue
			end
			if row.loop then
				frame %= row.frames
			end
			local t = el / b.life
			if t < (b.fade_in or 0) then
				a = t / b.fade_in
			elseif t > (b.fade_out or 1) then
				a = (1 - t) / (1 - b.fade_out)
			end
		elseif frame >= row.frames then
			continue
		end
		keep += 1
		list[keep] = b
		local x, y = ax + (b.u - cu) * sc, ay + (b.v - cv) * sc
		local w = math.max(row.min_px, row.world / k * sc)
		if not (x >= -w and y >= -w and x <= vw + w and y <= vh + w) then
			continue
		end
		n += 1
		local g = pool[n]
		if g == nil then
			local img = Instance.new("ImageLabel")
			img.Name = "Explosion"
			img.BackgroundTransparency = 1
			img.AnchorPoint = Vector2.new(0.5, 0.5)
			img.Image = MapFx.id
			img.ResampleMode = Enum.ResamplerMode.Pixelated
			img.ZIndex = z
			img.Parent = self.root
			g = {
				img = img,
				vis = true,
				x = math.huge,
				y = math.huge,
				w = -1,
				h = -1,
				rw = -1,
				rh = -1,
				ox = -1,
				oy = -1,
				img_t = -1,
			}
			pool[n] = g
		end
		-- (debris sit still between their frames, full strength mid-life: mostly nothing to write)
		local img = g.img
		if not g.vis then
			g.vis = true
			img.Visible = true
		end
		if g.x ~= x or g.y ~= y then
			g.x, g.y = x, y
			img.Position = UDim2.fromOffset(x, y)
		end
		local h = w * row.h / row.w
		if g.w ~= w or g.h ~= h then
			g.w, g.h = w, h
			img.Size = UDim2.fromOffset(w, h)
		end
		if g.rw ~= row.w or g.rh ~= row.h then
			g.rw, g.rh = row.w, row.h
			img.ImageRectSize = Vector2.new(row.w, row.h)
		end
		local ox, oy = (row.x or 0) + frame * row.w, row.y
		if g.ox ~= ox or g.oy ~= oy then
			g.ox, g.oy = ox, oy
			img.ImageRectOffset = Vector2.new(ox, oy)
		end
		local img_t = 1 - a
		if g.img_t ~= img_t then
			g.img_t = img_t
			img.ImageTransparency = img_t
		end
	end
	truncate(list, keep)
	for j = n + 1, #pool do
		local g = pool[j]
		if g.vis then
			g.vis = false
			g.img.Visible = false
		end
	end
end

function FxLayer.tick(self: any, _dt: number)
	local cam = self.view.rig
	local now = FrameClock.now()
	local n = 0
	self._rubble:tick(cam, now)
	self._chakra:tick(cam, now)
	local list = self._fx
	local keep = 0
	for i = 1, #list do
		local fx = list[i]
		local t = (now - fx.t0) / fx.dur
		if t >= 1 then
			continue
		end
		keep += 1
		list[keep] = fx
		if t < 0 then continue end
		local x, y = cam:map_to_screen(fx.u, fx.v)
		local e = 1 - (1 - t) ^ 3
		local r = (fx.r0 + (fx.r1 - fx.r0) * e) * cam.scale
		if not cam:on_screen(x, y, r) then
			continue
		end
		n += 1
		local g = self._frames[n]
		if g == nil then
			local f = Instance.new("Frame")
			f.Name = "Fx"
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.BorderSizePixel = 0
			f.ZIndex = FxLayer.Z
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0.5, 0)
			c.Parent = f
			-- (kept with the frame: it was looked up among the frame's children every frame)
			local s = Instance.new("UIStroke")
			s.Parent = f
			f.Parent = self.root
			g = {
				frame = f,
				stroke = s,
				vis = true,
				x = math.huge,
				y = math.huge,
				d = -1,
				col = nil,
				fill_t = -1,
				stroke_col = nil,
				width = -1,
				stroke_t = -1,
			}
			self._frames[n] = g
		end
		local f, s = g.frame, g.stroke
		if not g.vis then
			g.vis = true
			f.Visible = true
		end
		if g.x ~= x or g.y ~= y then
			g.x, g.y = x, y
			f.Position = UDim2.fromOffset(x, y)
		end
		if g.d ~= r * 2 then
			g.d = r * 2
			f.Size = UDim2.fromOffset(r * 2, r * 2)
		end
		if g.col ~= fx.col then
			g.col = fx.col
			f.BackgroundColor3 = fx.col
		end
		-- the flash fills the disc early on; the ring stays
		local fill_t = if fx.flash then math.clamp(0.25 + t * 3, 0, 1) else 0.8 + 0.2 * t
		if g.fill_t ~= fill_t then
			g.fill_t = fill_t
			f.BackgroundTransparency = fill_t
		end
		if g.stroke_col ~= fx.col then
			g.stroke_col = fx.col
			s.Color = fx.col
		end
		local width = math.max(1.5, r * 0.04)
		if g.width ~= width then
			g.width = width
			s.Thickness = width
		end
		if g.stroke_t ~= t then
			g.stroke_t = t
			s.Transparency = t
		end
	end
	truncate(list, keep)
	for j = n + 1, #self._frames do
		local g = self._frames[j]
		if g.vis then
			g.vis = false
			g.frame.Visible = false
		end
	end
	pops_step(self, cam, now)
	bursts_step(self, cam, now, self._bursts, self._burst_gui, FxLayer.Z + 1)
	-- (the debris over the fireball, pushed after it)
	bursts_step(self, cam, now, self._debris, self._debris_gui, FxLayer.Z + 2)
	bonus_step(self, cam, now)
end

return FxLayer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">MapCamera</string>
              <string name="Source"><![CDATA[--!strict
-- 2D map camera for a flat tile map drawn in the GUI.
--
-- Map space: u = tile column + fraction (0..W), v = tile row + fraction (0 = top edge .. H); a
-- tile's centre is (x + 0.5, y + 0.5). Maps are flat rectangles (nothing wraps).
-- Screen space: viewport px (Camera.ViewportSize / InputObject.Position + GuiInset).
--
-- The view is (cu, cv, scale): the map point (cu, cv) sits at the view anchor — the viewport centre
-- moved by screen_offset (the middle of the HUD-free area, MapView.set_safe_area) — and one tile is
-- `scale` px wide. Once the map is bigger than the view it pans until an edge reaches the view
-- anchor; smaller, it stays centred (clamp_axis).
--
-- It also provides the camera-rig API the input controller uses (halt, viewport_size, pan,
-- zoom_by, globe_hit, is_moving, begin_drag, drag_by, end_drag), so the input keeps GlobeInput's
-- touch / mouse model.
-- (Lune tests load this file with the shared modules from the repo.)
local IS_ROBLOX = (game :: any) ~= nil
local Defs = if IS_ROBLOX
	then require(
		game:GetService("ReplicatedStorage"):WaitForChild("Airfront"):WaitForChild("Core"):WaitForChild("Defs")
	) :: any
	else (require :: any)("../../shared/Core/Defs")

local FrameClock = if IS_ROBLOX
	then require((script :: any).Parent:WaitForChild("FrameClock"))
	else (require :: any)("./FrameClock")
local MapCamera = {}
MapCamera.__index = MapCamera

--- Closest zoom: px per tile at a 900 px tall view (scaled with the view height), for a map with
--- k_lin = 2 (a tile is 2 x 2 full-size tiles, so 22 px
--- per full-size tile).
MapCamera.MAX_SCALE_900 = 44.0
--- Farthest zoom of a flat map: the whole map fits with this margin (fraction of the view).
MapCamera.FIT_MARGIN = 0.9
--- Wheel / pinch zoom smoothing time constant (s).
MapCamera.ZOOM_TAU = 0.07
--- Drag inertia decay per second (velocity multiplier).
MapCamera.INERTIA_DECAY = 0.004
--- A release this long after the last drag step keeps no inertia (ms).
MapCamera.INERTIA_HOLD_MS = 90

export type MapCamera = typeof(setmetatable(
	{} :: {
		camera: Camera?,
		W: number,
		H: number,
		cu: number,
		cv: number,
		scale: number,
		target_scale: number,
		screen_offset: Vector2,
		dragging: boolean,
		attract: boolean,
		_vel: Vector2,
		_last_drag_ms: number,
		_anchor_map: Vector2?,
		_anchor_screen: Vector2?,
		_focus_active: boolean,
		_focus_t: number,
		_focus_dur: number,
		_focus_from: Vector3,
		_focus_to: Vector3,
		_shake: number,
		_shake_px: Vector2,
		_vp: Vector2,
		version: number,
		lat: number,
		lon: number,
		_drift: number,
	},
	MapCamera
))

local function now_ms(): number
	return FrameClock.now() * 1000
end

function MapCamera.new(camera: Camera?, map: any?): MapCamera
	local self = setmetatable({
		camera = camera,
		W = Defs.W,
		H = Defs.H,
		cu = Defs.W * 0.5,
		cv = Defs.H * 0.5,
		scale = 2.0,
		target_scale = 2.0,
		screen_offset = Vector2.zero,
		dragging = false,
		attract = false,
		_vel = Vector2.zero,
		_last_drag_ms = 0.0,
		_anchor_map = nil :: Vector2?,
		_anchor_screen = nil :: Vector2?,
		_focus_active = false,
		_focus_t = 0.0,
		_focus_dur = 1.0,
		_focus_from = Vector3.zero,
		_focus_to = Vector3.zero,
		_shake = 0.0,
		_shake_px = Vector2.zero,
		_vp = Vector2.new(1600, 900),
		--- the anchor (anchor()): its screen position, the vectors it was made from, and as a Vector2
		_ax = 0.0,
		_ay = 0.0,
		_a_vp = nil :: Vector2?,
		_a_so = nil :: Vector2?,
		_a_sh = nil :: Vector2?,
		_a_v = nil :: Vector2?,
		--- bumps whenever the view changes (layers skip re-projection while it is unchanged)
		version = 0,
		--- lat / lon (degrees) of the view anchor read as an equirectangular world map (the spawn
		--- advisor reads them like the globe rig's)
		lat = 0.0,
		lon = 0.0,
		_drift = 1.0,
	}, MapCamera)
	self:_read_viewport()
	if map ~= nil then
		self:set_map(map)
	end
	self.scale = self:min_scale()
	self.target_scale = self.scale
	return self
end

--- Adopt a map's size (map.W / map.H or width / height).
function MapCamera.set_map(self: MapCamera, map: any)
	local w = tonumber(map.W or map.width) or Defs.W
	local h = tonumber(map.H or map.height) or Defs.H
	if w == self.W and h == self.H then
		return
	end
	self.W, self.H = w, h
	self.cu, self.cv = w * 0.5, h * 0.5
	self:halt()
	self.scale = self:min_scale()
	self.target_scale = self.scale
	self:_clamp()
	self:_bump()
end

function MapCamera._read_viewport(self: MapCamera)
	if not IS_ROBLOX then
		return
	end
	local cam = self.camera or workspace.CurrentCamera
	if cam then
		local v = cam.ViewportSize
		if v.X > 1 and v.Y > 1 then
			self._vp = v
		end
	end
end

function MapCamera.viewport_size(self: MapCamera): Vector2
	return self._vp
end

function MapCamera.viewport_height(self: MapCamera): number
	return self._vp.Y
end

--- Farthest zoom: the whole map fits with a margin.
function MapCamera.min_scale(self: MapCamera): number
	return math.min(self._vp.X / self.W, self._vp.Y / self.H) * MapCamera.FIT_MARGIN
end

function MapCamera.max_scale(self: MapCamera): number
	return math.max(MapCamera.MAX_SCALE_900 * math.max(self._vp.Y, 300.0) / 900.0, self:min_scale() * 2)
end

function MapCamera.clamp_scale(self: MapCamera, s: number): number
	return math.clamp(s, self:min_scale(), self:max_scale())
end

--- The view anchor (viewport px): where (cu, cv) is drawn.
--- The anchor's screen position, kept until the viewport, the offset or the shake is replaced (each
--- is a new Vector2 when it changes: compared by identity). Every map point drawn is projected through
--- it, and building it anew cost three Vector2s a call: two a rail, one a structure, unit and label,
--- every frame the camera moved (2026-10-12, phones).
local function anchor(self: any): (number, number)
	local vp, so, sh = self._vp, self.screen_offset, self._shake_px
	if not (rawequal(vp, self._a_vp) and rawequal(so, self._a_so) and rawequal(sh, self._a_sh)) then
		self._a_vp, self._a_so, self._a_sh = vp, so, sh
		self._ax = vp.X * 0.5 + so.X + sh.X
		self._ay = vp.Y * 0.5 + so.Y + sh.Y
		self._a_v = nil
	end
	return self._ax, self._ay
end
MapCamera.anchor = anchor

function MapCamera.anchor_px(self: MapCamera): Vector2
	local ax, ay = anchor(self)
	local v = self._a_v
	if v == nil then
		v = Vector2.new(ax, ay)
		self._a_v = v
	end
	return v
end

-- ---------------------------------------------------------------------------------------------
-- Projection
-- ---------------------------------------------------------------------------------------------

--- Screen position (viewport px) of map point (u, v).
function MapCamera.map_to_screen(self: MapCamera, u: number, v: number): (number, number)
	local ax, ay = anchor(self)
	local s = self.scale
	return ax + (u - self.cu) * s, ay + (v - self.cv) * s
end

--- Map point under a screen position (may lie off the map).
function MapCamera.screen_to_map(self: MapCamera, x: number, y: number): (number, number)
	local ax, ay = anchor(self)
	local s = self.scale
	return self.cu + (x - ax) / s, self.cv + (y - ay) / s
end

--- Tile index under a screen position, or -1 off the map.
function MapCamera.tile_at_screen(self: MapCamera, pos: Vector2): number
	local u, v = self:screen_to_map(pos.X, pos.Y)
	if v < 0 or v >= self.H or u < 0 or u >= self.W then
		return -1
	end
	return math.floor(v) * self.W + math.floor(u)
end

--- Screen position of a tile's centre.
function MapCamera.tile_to_screen(self: MapCamera, tile: number): (number, number)
	local w = self.W
	return self:map_to_screen(tile % w + 0.5, tile // w + 0.5)
end

--- Map point of a lat / lon (degrees) read as an equirectangular world map (legacy Earth data).
function MapCamera.latlon_to_map(self: MapCamera, lat: number, lon: number): (number, number)
	return (lon + 180.0) / 360.0 * self.W, (90.0 - lat) / 180.0 * self.H
end

--- Map point of a globe direction (x, y, z) — legacy Earth unit poses (until the flat sim lands).
function MapCamera.xyz_to_map(self: MapCamera, x: number, y: number, z: number): (number, number)
	local lat, lon = Defs.xyz_latlon(x, y, z)
	return self:latlon_to_map(lat, lon)
end

--- Screen position of a globe direction.
function MapCamera.xyz_to_screen(self: MapCamera, x: number, y: number, z: number): (number, number)
	local u, v = self:xyz_to_map(x, y, z)
	return self:map_to_screen(u, v)
end

--- True when a screen point is inside the viewport grown by `margin` px.
function MapCamera.on_screen(self: MapCamera, x: number, y: number, margin: number?): boolean
	local m = margin or 0.0
	return x >= -m and y >= -m and x <= self._vp.X + m and y <= self._vp.Y + m
end

--- Visible map rect (u0, v0, u1, v1); may extend past the map.
function MapCamera.visible_rect(self: MapCamera): (number, number, number, number)
	local a = self:anchor_px()
	local s = self.scale
	return self.cu - a.X / s, self.cv - a.Y / s, self.cu + (self._vp.X - a.X) / s, self.cv + (self._vp.Y - a.Y) / s
end

--- Map tiles per screen px.
function MapCamera.tiles_per_px(self: MapCamera): number
	return 1.0 / self.scale
end

--- Degrees of latitude per screen px on the Earth map (the globe rig's unit).
function MapCamera.deg_per_px(self: MapCamera): number
	return 180.0 / self.H / self.scale
end

-- ---------------------------------------------------------------------------------------------
-- Motion
-- ---------------------------------------------------------------------------------------------

-- One axis of the pan limits: a map bigger than the view may be panned until its edge
-- reaches the view anchor (the middle of the HUD-free area), so the top / bottom / side rows can be
-- brought out from under the HUD. A map smaller than the view stays centred, and as the view grows
-- from CENTRE_FROM of the map's size to all of it the range narrows to the centre smoothly. It was a
-- step from one rule to the other: a camera zooming out, away from the middle, snapped across the
-- screen as each axis crossed it (2026-10-12, seen in the trailer's last shot: the camera snapped around
-- while zooming out).
MapCamera.CENTRE_FROM = 0.75
local function clamp_axis(c: number, size: number, before: number, after: number): number
	local span = before + after
	-- (no view to keep the map in: a zero scale, or a viewport not known yet)
	if not (span < math.huge) then
		return size * 0.5
	end
	local centre = (size - after + before) * 0.5
	local t = math.clamp((span / size - MapCamera.CENTRE_FROM) / (1 - MapCamera.CENTRE_FROM), 0, 1)
	local lo = centre * t
	-- (the two ends meet at the centre once t is 1, but in floating point the upper one can land a
	-- hair below the lower, and math.clamp throws when max < min: in 9% of zoomed-out views on v82, the
	-- game's top error that day, half a million a day, and the map's update stopped on those frames)
	local hi = math.max(lo, size + (centre - size) * t)
	return math.clamp(c, lo, hi)
end
MapCamera._clamp_axis = clamp_axis

function MapCamera._clamp(self: MapCamera)
	local a = self:anchor_px()
	local s = self.scale
	self.cv = clamp_axis(self.cv, self.H, a.Y / s, (self._vp.Y - a.Y) / s)
	self.cu = clamp_axis(self.cu, self.W, a.X / s, (self._vp.X - a.X) / s)
end

function MapCamera._bump(self: MapCamera)
	self.version += 1
	self.lat = 90.0 - self.cv / self.H * 180.0
	self.lon = self.cu / self.W * 360.0 - 180.0
end

-- Globe-camera distance (globe radii, 1 + altitude) <-> map zoom, so callers written for the globe
-- (focus_tile(tile, distance), camera_distance) frame about the same area: px per tile =
-- DIST_K * view height / altitude (the globe's closest zoom, altitude 0.22, is ~18 px per tile on a
-- 900 px view; its default 1.6 is ~2.5, the whole Earth).
local DIST_K = 0.0044

function MapCamera.distance_to_scale(self: MapCamera, d: number): number
	local alt = math.max(d - 1.0, 0.02)
	return self:clamp_scale(DIST_K * self._vp.Y / alt)
end

function MapCamera.scale_to_distance(self: MapCamera, s: number): number
	return 1.0 + DIST_K * self._vp.Y / math.max(s, 1e-3)
end

function MapCamera.begin_drag(self: MapCamera)
	self.dragging = true
	self._focus_active = false
	self._anchor_map = nil
	self._anchor_screen = nil
	self._vel = Vector2.zero
end

--- Move the map with the pointer by `rel` screen px.
function MapCamera.drag_by(self: MapCamera, rel: Vector2)
	local s = self.scale
	self.cu -= rel.X / s
	self.cv -= rel.Y / s
	local now = now_ms()
	local dt = math.max((now - self._last_drag_ms) / 1000.0, 1.0 / 240.0)
	if now - self._last_drag_ms < 100 then
		-- map columns / rows per second, smoothed
		local v = Vector2.new(-rel.X / s, -rel.Y / s) / dt
		self._vel = self._vel:Lerp(v, 0.5)
	else
		self._vel = Vector2.zero
	end
	self._last_drag_ms = now
	self:_clamp()
	self:_bump()
end

function MapCamera.end_drag(self: MapCamera)
	self.dragging = false
	if now_ms() - self._last_drag_ms > MapCamera.INERTIA_HOLD_MS then
		self._vel = Vector2.zero
	end
	-- cap the fling at ~2.5 view widths per second
	local cap = 2.5 * self._vp.X / self.scale
	if self._vel.Magnitude > cap then
		self._vel = self._vel.Unit * cap
	end
end

--- True while a focus animation runs or inertia moves the map faster than `px_per_s`.
function MapCamera.is_moving(self: MapCamera, px_per_s: number): boolean
	if self._focus_active then
		return true
	end
	if self.dragging then
		return false
	end
	return self._vel.Magnitude * self.scale > px_per_s
end

--- Stop any drag, inertia, zoom glide or focus animation.
function MapCamera.halt(self: MapCamera)
	self.dragging = false
	self._vel = Vector2.zero
	self._focus_active = false
	self.target_scale = self.scale
	self._anchor_map = nil
	self._anchor_screen = nil
end

--- Keyboard / programmatic pan in screen directions (x right, y down), `amount` in view heights.
function MapCamera.pan(self: MapCamera, dir: Vector2, amount: number)
	self._focus_active = false
	local px = dir * amount * self._vp.Y
	self.cu += px.X / self.scale
	self.cv += px.Y / self.scale
	self:_clamp()
	self:_bump()
end

--- The map point under a screen position (the anchor zoom_by keeps still), clamped to the map.
function MapCamera.globe_hit(self: MapCamera, screen_pos: Vector2): Vector2
	local u, v = self:screen_to_map(screen_pos.X, screen_pos.Y)
	return Vector2.new(math.clamp(u, 0, self.W), math.clamp(v, 0, self.H))
end

--- factor > 1 zooms in, gliding toward the target (ZOOM_TAU). `anchor` (a map point from
--- globe_hit) stays under the same screen position; nil = the view anchor.
function MapCamera.zoom_by(self: MapCamera, factor: number, anchor: any?)
	if factor <= 0.0 then
		return
	end
	self._focus_active = false
	self.target_scale = self:clamp_scale(self.target_scale * factor)
	if typeof(anchor) == "Vector2" then
		local a = anchor :: Vector2
		local sx, sy = self:map_to_screen(a.X, a.Y)
		self._anchor_map = a
		self._anchor_screen = Vector2.new(sx, sy)
	else
		self._anchor_map = nil
		self._anchor_screen = nil
	end
end

--- Jump to a zoom (px per tile) at once, about the view anchor.
function MapCamera.set_scale_immediate(self: MapCamera, s: number)
	self.scale = self:clamp_scale(s)
	self.target_scale = self.scale
	self._anchor_map = nil
	self:_clamp()
	self:_bump()
end

--- Centre the view anchor on map point (u, v) at once.
function MapCamera.look_at(self: MapCamera, u: number, v: number)
	self.cu = u
	self.cv = v
	self:_clamp()
	self:_bump()
end

--- Animate to map point (u, v) at zoom `scale` (<= 0 keeps the current zoom) over `duration` s.
function MapCamera.focus(self: MapCamera, u: number, v: number, scale: number, duration: number)
	local s1 = if scale > 0 then self:clamp_scale(scale) else self.scale
	self._focus_from = Vector3.new(self.cu, self.cv, self.scale)
	self._focus_to = Vector3.new(u, v, s1)
	self._focus_dur = math.max(duration, 0.01)
	self._focus_t = 0.0
	self._focus_active = true
	self._vel = Vector2.zero
	self._anchor_map = nil
	self.target_scale = s1
end

function MapCamera.focus_tile(self: MapCamera, tile: number, scale: number, duration: number)
	local w = self.W
	self:focus(tile % w + 0.5, tile // w + 0.5, scale, duration)
end

function MapCamera.add_shake(self: MapCamera, strength: number)
	self._shake = math.max(self._shake, strength)
end

local function ease_in_out(t: number): number
	return if t < 0.5 then 4 * t * t * t else 1 - (-2 * t + 2) ^ 3 * 0.5
end

--- Per-frame: viewport, focus animation, zoom glide, inertia, attract drift, shake.
function MapCamera.tick(self: MapCamera, dt: number)
	local vp0 = self._vp
	self:_read_viewport()
	local changed = self._vp ~= vp0
	if changed then
		self.scale = self:clamp_scale(self.scale)
		self.target_scale = self:clamp_scale(self.target_scale)
	end
	if self._focus_active then
		self._focus_t += dt / self._focus_dur
		local t = ease_in_out(math.min(self._focus_t, 1.0))
		local a, b = self._focus_from, self._focus_to
		self.cu = a.X + (b.X - a.X) * t
		self.cv = a.Y + (b.Y - a.Y) * t
		-- zoom in log space, with a slight pull-back on long trips
		local ls = math.log(a.Z) + (math.log(b.Z) - math.log(a.Z)) * t
		local dist_px = (math.abs(b.X - a.X) + math.abs(b.Y - a.Y)) * a.Z
		local bump = math.clamp(dist_px / (self._vp.X * 3.0), 0.0, 0.6)
		ls -= bump * math.sin(t * math.pi)
		self.scale = self:clamp_scale(math.exp(ls))
		self.target_scale = self.scale
		if self._focus_t >= 1.0 then
			self._focus_active = false
			self.scale = self:clamp_scale(b.Z)
			self.target_scale = self.scale
		end
		changed = true
	elseif math.abs(self.target_scale - self.scale) > 1e-4 * self.scale then
		local k = 1.0 - math.exp(-dt / MapCamera.ZOOM_TAU)
		self.scale = math.exp(math.log(self.scale) + (math.log(self.target_scale) - math.log(self.scale)) * k)
		if math.abs(self.target_scale - self.scale) <= 1e-4 * self.scale then
			self.scale = self.target_scale
		end
		local am, asp = self._anchor_map, self._anchor_screen
		if am and asp then
			-- keep the anchor map point under its screen position
			local ap = self:anchor_px()
			self.cu = am.X - (asp.X - ap.X) / self.scale
			self.cv = am.Y - (asp.Y - ap.Y) / self.scale
		end
		changed = true
	else
		self._anchor_map = nil
		self._anchor_screen = nil
	end
	if not self.dragging and not self._focus_active and self._vel.Magnitude > 1e-3 then
		self.cu += self._vel.X * dt
		self.cv += self._vel.Y * dt
		self._vel *= MapCamera.INERTIA_DECAY ^ dt
		if self._vel.Magnitude * self.scale < 4.0 then
			self._vel = Vector2.zero
		end
		changed = true
	end
	if self.attract and not self.dragging and not self._focus_active then
		-- title screen: a slow drift over the map, turning back at its edges
		local dir = self._drift or 1.0
		local before = self.cu
		self.cu += dir * dt * 6.0 * (self:min_scale() / self.scale)
		self:_clamp()
		if math.abs(self.cu - before) < 1e-6 then
			self._drift = -dir
		end
		changed = true
	end
	if self._shake > 0.01 then
		local r = self._shake * 10.0
		self._shake_px = Vector2.new((math.random() * 2 - 1) * r, (math.random() * 2 - 1) * r)
		self._shake *= 0.02 ^ dt
		changed = true
	elseif self._shake_px ~= Vector2.zero then
		self._shake = 0.0
		self._shake_px = Vector2.zero
		changed = true
	end
	if changed then
		self:_clamp()
		self:_bump()
	end
end

return MapCamera
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">MapInput</string>
              <string name="Source"><![CDATA[--!strict
-- Map input (from scripts/view/globe_input.gd): mouse, trackpad and multi-touch for MapView,
-- driving the MapCamera through its camera-rig API (drag pans the map, wheel / pinch zoom about
-- the pointer). "Globe" below means the map.
--
-- Touch model (Roblox): every touch is tracked by its InputObject from UserInputService. A touch
-- whose press was not processed by the GUI (gameProcessedEvent false: no Active GuiObject took it)
-- landed on free globe (GLOBE); one the GUI processed landed on a HUD control (UI). The GUI keeps
-- UI touches (taps, slider drags) unless they become part of a pinch.
--  * One GLOBE finger: orbit with inertia once it moves past the slop; a drag that crosses a HUD
--    panel keeps orbiting. Tap = tile_clicked, still 500 ms press = tile_context.
--  * A second finger stops any orbit / inertia at once and cancels the first finger's tap. If both
--    fingers are GLOBE the pinch starts immediately; if one started on the HUD it becomes a pinch
--    only when BOTH fingers move (a resting thumb on the globe + a tap / slider drag on the HUD
--    stays a HUD action). While pinching the globe only zooms (around the point under the
--    fingers' start midpoint); no rotation.
--  * Lifting fingers after a two-finger gesture never taps; a remaining GLOBE finger may orbit.
--  * touch_owned_by_world(io) tells the UI whether the view owns a touch (GLOBE gesture or pinch
--    participant); valid through the frame in which the finger lifts, so a HUD control can ignore
--    the release of a finger that took part in a pinch.
--  * Stale touches (review_code.md R2-6): a finger whose InputEnded never arrives (app backgrounded,
--    a system gesture stole it) must not lock the globe. A tracked touch is dropped when its
--    InputObject reports End / Cancel, when it has not moved for STALE_TOUCH_S and a new finger
--    would otherwise be refused (two tracked already: Roblox sends nothing for a finger held still,
--    so age alone never evicts a resting first finger — "rest a thumb, then pinch" stays a pinch),
--    when the window loses focus or the Roblox menu opens, and on input on / off.
-- Stop gesture: pressing (touch or mouse) while the globe is still moving (inertia above
-- STOP_PX_PER_S or a focus animation) halts it and that press never taps (it may still turn into a
-- drag, or be held for the menu: holding after a fling used to do nothing, which made the hold
-- menu seem inconsistent, 2026-09-29). Every press kills inertia.
-- hold_state() reports a touch hold in progress (UIRoot draws the hold ring from it).
-- Mouse: left-drag orbit, right-click context, wheel / trackpad pinch / two-finger pan zoom toward
-- the pointer. WASD / arrows pan and + / - zoom while input_enabled and no TextBox has focus.
-- All positions are VIEWPORT px (InputObject.Position + GuiService:GetGuiInset()).
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")

local MapInput = {}
MapInput.__index = MapInput

MapInput.TAP_SLOP_MOUSE = 6.0 -- px a press may move and still count as a click
MapInput.TAP_SLOP_TOUCH = 16.0 -- fingers wobble more (a hold for the menu must survive it: was 12)
MapInput.LONG_PRESS_MS = 500
MapInput.WHEEL_STEP = 1.16
MapInput.KEY_PAN_SPEED = 0.55 -- view heights per second
MapInput.KEY_ZOOM_SPEED = 1.6 -- doublings per second
MapInput.STOP_PX_PER_S = 30.0 -- globe moving faster than this under the pointer: a press only stops it
MapInput.PINCH_MOVE_PX = 8.0 -- both fingers must move this far to pinch when one started on the HUD
MapInput.GUI_PROBE_S = 0.1 -- re-test a resting pointer against the HUD this often (panels come and go)
--- A tracked touch without any update for this long is presumed lost (its end never arrived) once a
--- new finger comes down.
MapInput.STALE_TOUCH_S = 3.0

local GLOBE, UI = 1, 2
local TAP_SLOP_MOUSE, TAP_SLOP_TOUCH = MapInput.TAP_SLOP_MOUSE, MapInput.TAP_SLOP_TOUCH
local MOUSE = "mouse" -- press index of the mouse (touches use their InputObject)
local IS_END = { [Enum.UserInputState.End] = true, [Enum.UserInputState.Cancel] = true }

type Touch = { io: InputObject, pos: Vector2, pair_pos: Vector2, owner: number, order: number, t: number }

local function now_ms(): number
	return os.clock() * 1000
end

local function view_pos(io: InputObject): Vector2
	local inset = GuiService:GetGuiInset()
	return Vector2.new(io.Position.X, io.Position.Y) + inset
end

function MapInput.new(view: any, rig: any)
	local self = setmetatable({}, MapInput)
	self.view = view
	self.rig = rig
	--- Counters for tests / diagnostics.
	self.stats = { touch_presses = 0, mouse_presses = 0, stop_presses = 0, pinches = 0, stale_touches = 0, ticks = 0 }
	self._press_active = false
	self._press_index = nil :: any -- MOUSE or the touch's InputObject
	self._press_pos = Vector2.zero
	self._press_ms = 0
	self._press_dragging = false
	self._press_consumed = false
	self._press_stop = false
	self._press_slop = TAP_SLOP_MOUSE
	self._touches = {} :: { [InputObject]: Touch }
	self._touch_count = 0
	self._touch_order = 0
	self._pinching = false
	self._pinch_a = nil :: InputObject?
	self._pinch_b = nil :: InputObject?
	self._pinch_dist = 0.0
	self._pinch_anchor = Vector3.zero
	self._released_owned = {} :: { [any]: boolean }
	self._mouse_pos = Vector2.new(-1, -1)
	self._mouse_inside = true
	self._hover_tile = -1
	-- Pointer-over-HUD test (Godot: Controls with MOUSE_FILTER_STOP swallow mouse motion, so the
	-- globe never hovers under a panel). Cached per pointer position, re-tested every GUI_PROBE_S.
	self._player_gui = nil :: PlayerGui?
	self._gui_probe_pos = Vector2.new(-1e9, -1e9)
	self._gui_probe_t = -1e9
	self._gui_probe_hit = false
	self._conns = {} :: { RBXScriptConnection }
	self:_connect()
	return self
end

function MapInput.destroy(self: any)
	for _, c in self._conns do
		c:Disconnect()
	end
	table.clear(self._conns)
end

function MapInput.reset(self: any)
	self:_cancel_press()
	self:_forget_touches()
	table.clear(self._released_owned)
	self:set_hover_tile(-1)
end

-- drop every tracked touch and any two-finger gesture (the fingers still down are not ours anymore:
-- their moves and lifts are ignored)
function MapInput._forget_touches(self: any)
	table.clear(self._touches)
	self._touch_count = 0
	self._pinching = false
	self._pinch_a = nil
	self._pinch_b = nil
end

--- The window lost focus / the Roblox menu opened: touch ends may never arrive, a held mouse button
--- may be released elsewhere — cancel the gesture and forget every touch (R2-6).
function MapInput._on_focus_lost(self: any)
	if self._press_active or self._pinching then
		self:_cancel_press()
		self.rig:halt()
	end
	self._press_active = false
	self:_forget_touches()
	self:mouse_left_window()
end

--- Drop tracked touches that ended without an InputEnded (their InputObject says End / Cancel and
--- nothing arrived for `end_grace_s`: the InputEnded of a normal lift is being delivered), and with
--- `stale_s`, those without any update for that long. Returns how many were dropped.
function MapInput._prune_touches(self: any, stale_s: number?, end_grace_s: number?): number
	if self._touch_count == 0 then
		return 0
	end
	local now = os.clock()
	local grace = end_grace_s or 0
	local drop = nil
	for io, t in self._touches do
		local st = (io :: any).UserInputState
		local age = now - t.t
		if (IS_END[st] and age >= grace) or (stale_s ~= nil and age > stale_s) then
			drop = drop or {}
			table.insert(drop, io)
		end
	end
	if drop == nil then
		return 0
	end
	for _, io in drop do
		self.stats.stale_touches += 1
		self:_drop_touch(io)
	end
	return #drop
end

-- forget one touch as if it had been cancelled: no tap / click, a pinch it was part of ends
function MapInput._drop_touch(self: any, io: any)
	if self._touches[io] == nil then
		return
	end
	self._touches[io] = nil
	self._touch_count -= 1
	if self._pinching and (io == self._pinch_a or io == self._pinch_b) then
		self._pinching = false
	end
	if self._press_active and self._press_index == io then
		self:_cancel_press()
	end
	if self._touch_count == 0 then
		self._press_active = false
	end
end

--- True while the view owns touch `io` (a globe gesture or a pinch participant), and during the
--- frame in which such a finger lifts. `io` may be the touch's InputObject.
function MapInput.touch_owned_by_world(self: any, io: any): boolean
	local r = self._released_owned[io]
	if r ~= nil then
		return r
	end
	local t = self._touches[io]
	if t == nil then
		return false
	end
	return t.owner == GLOBE or (self._pinching and (io == self._pinch_a or io == self._pinch_b))
end

function MapInput._active(self: any): boolean
	return self.view.input_enabled and not self.view:is_attract()
end

-- ---------------------------------------------------------------------------------------------
-- Per-frame work (called by WorldView.update)
-- ---------------------------------------------------------------------------------------------

--- Input switched off (modal UI / attract): cancel the gesture cleanly, stop hover once. Tracked
--- touches are forgotten (the fingers still down belong to the UI now; their lifts are ignored).
function MapInput.disable(self: any)
	if self._press_active or self._pinching then
		self:_cancel_press()
		self.rig:halt()
		self._press_consumed = true
	end
	self:_forget_touches()
	self:set_hover_tile(-1)
end

--- Input switched back on: start from a clean gesture state (no touch tracked from before).
function MapInput.enable(self: any)
	self:_cancel_press()
	self:_forget_touches()
end

function MapInput.tick(self: any, delta: number)
	self.stats.ticks += 1
	table.clear(self._released_owned)
	if self._touch_count > 0 then
		self:_prune_touches(nil, 0.3)
	end
	if not self:_active() then
		-- the input_enabled field may also be flipped directly: same clean cancel
		if self._press_active or self._hover_tile ~= -1 then
			self:disable()
		end
		return
	end
	if
		self._press_active
		and not self._press_dragging
		and not self._press_consumed
		and now_ms() - self._press_ms >= MapInput.LONG_PRESS_MS
	then
		self._press_consumed = true
		self.view.tile_context:Fire(self.view:tile_at_screen(self._press_pos), self._press_pos)
	end
	self:_keyboard(delta)
	if self._touch_count == 0 and not self._press_dragging then
		local mp = UserInputService:GetMouseLocation()
		local vp = self.rig:viewport_size()
		local inside = UserInputService.MouseEnabled and mp.X >= 0 and mp.Y >= 0 and mp.X < vp.X and mp.Y < vp.Y
		if inside and self._mouse_inside and not self:pointer_over_gui(mp) then
			self._mouse_pos = mp
			self:set_hover_tile(self.view:tile_at_screen(mp))
		else
			self:set_hover_tile(-1)
		end
	end
end

--- True while the pointer (viewport px) rests on a visible input-blocking GUI element (an Active
--- GuiObject: HUD panels, buttons, cards, top-bar buttons) — the globe does not hover under it.
--- Map labels and other passive overlays are not Active and never block.
function MapInput.pointer_over_gui(self: any, mp: Vector2): boolean
	local now = os.clock()
	if mp == self._gui_probe_pos and now - self._gui_probe_t < MapInput.GUI_PROBE_S then
		return self._gui_probe_hit
	end
	self._gui_probe_pos = mp
	self._gui_probe_t = now
	local pg = self._player_gui
	if pg == nil or pg.Parent == nil then
		local lp = Players.LocalPlayer
		pg = if lp ~= nil then lp:FindFirstChildOfClass("PlayerGui") else nil
		self._player_gui = pg
	end
	local hit = false
	if pg ~= nil then
		-- GetGuiObjectsAtPosition works in GuiObject.AbsolutePosition space (below the top-bar inset).
		local inset = GuiService:GetGuiInset()
		for _, g in pg:GetGuiObjectsAtPosition(mp.X - inset.X, mp.Y - inset.Y) do
			if g.Active then
				hit = true
				break
			end
		end
	end
	self._gui_probe_hit = hit
	return hit
end

function MapInput.set_hover_tile(self: any, tile: number)
	if tile ~= self._hover_tile then
		self._hover_tile = tile
		self.view.tile_hovered:Fire(tile)
	end
end

function MapInput.mouse_left_window(self: any)
	self._mouse_inside = false
	self:set_hover_tile(-1)
end

function MapInput.mouse_entered_window(self: any)
	self._mouse_inside = true
end

local KC = Enum.KeyCode
function MapInput._keyboard(self: any, delta: number)
	if UserInputService:GetFocusedTextBox() ~= nil or not UserInputService.KeyboardEnabled then
		return
	end
	local function down(a: Enum.KeyCode, b: Enum.KeyCode?): boolean
		return UserInputService:IsKeyDown(a) or (b ~= nil and UserInputService:IsKeyDown(b))
	end
	local dx, dy = 0, 0
	if down(KC.A, KC.Left) then
		dx -= 1
	end
	if down(KC.D, KC.Right) then
		dx += 1
	end
	if down(KC.W, KC.Up) then
		dy -= 1
	end
	if down(KC.S, KC.Down) then
		dy += 1
	end
	if dx ~= 0 or dy ~= 0 then
		self.rig:pan(Vector2.new(dx, dy).Unit, MapInput.KEY_PAN_SPEED * delta)
	end
	local z = 0
	if down(KC.Equals, KC.KeypadPlus) then
		z += 1
	end
	if down(KC.Minus, KC.KeypadMinus) then
		z -= 1
	end
	if z ~= 0 then
		self.rig:zoom_by(2 ^ (z * MapInput.KEY_ZOOM_SPEED * delta))
	end
end

-- ---------------------------------------------------------------------------------------------
-- Event plumbing
-- ---------------------------------------------------------------------------------------------

function MapInput._connect(self: any)
	local UT = Enum.UserInputType
	table.insert(
		self._conns,
		UserInputService.InputBegan:Connect(function(io: InputObject, gp: boolean)
			if io.UserInputType == UT.Touch then
				if self:_active() then
					self:_touch_down(io, gp)
				end
				return
			end
			if not self:_active() then
				return
			end
			if io.UserInputType == UT.MouseButton1 then
				if gp or UserInputService.TouchEnabled and self._touch_count > 0 then
					return
				end
				local pos = view_pos(io)
				self._mouse_pos = pos
				self.stats.mouse_presses += 1
				self:_pointer_down(MOUSE, pos, TAP_SLOP_MOUSE)
			elseif io.UserInputType == UT.MouseButton2 then
				if gp then
					return
				end
				local pos = view_pos(io)
				self:_cancel_press()
				self.view.tile_context:Fire(self.view:tile_at_screen(pos), pos)
			end
		end)
	)
	table.insert(
		self._conns,
		UserInputService.InputChanged:Connect(function(io: InputObject, gp: boolean)
			if io.UserInputType == UT.Touch then
				if self:_active() then
					self:_touch_drag(io)
				end
				return
			end
			if not self:_active() then
				return
			end
			if io.UserInputType == UT.MouseMovement then
				local pos = view_pos(io)
				local rel = pos - self._mouse_pos
				self._mouse_pos = pos
				self._mouse_inside = true
				if self._press_active and self._press_index == MOUSE then
					self:_pointer_move(pos, rel)
				end
			elseif io.UserInputType == UT.MouseWheel then
				-- Shift + wheel belongs to the UI (attack ratio)
				if
					gp
					or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
					or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
				then
					return
				end
				local pos = view_pos(io)
				local k = MapInput.WHEEL_STEP ^ math.abs(io.Position.Z)
				self.rig:zoom_by(if io.Position.Z > 0 then k else 1 / k, self.rig:globe_hit(pos))
			end
		end)
	)
	table.insert(
		self._conns,
		UserInputService.InputEnded:Connect(function(io: InputObject, _gp: boolean)
			if io.UserInputType == UT.Touch then
				self:_touch_up(io)
				return
			end
			if io.UserInputType == UT.MouseButton1 then
				if self._press_active and self._press_index == MOUSE then
					self:_pointer_up(view_pos(io))
				end
			end
		end)
	)
	-- trackpad pinch / two-finger pan (InputEventMagnifyGesture / InputEventPanGesture)
	table.insert(
		self._conns,
		UserInputService.PointerAction:Connect(function(_wheel: number, pan: Vector2, pinch: number, gp: boolean)
			if gp or not self:_active() then
				return
			end
			local anchor = self.rig:globe_hit(UserInputService:GetMouseLocation())
			if pinch ~= 0 then
				self.rig:zoom_by(1 + pinch, anchor)
			elseif pan.Y ~= 0 then
				self.rig:zoom_by(1.035 ^ -pan.Y, anchor)
			end
		end)
	)
	table.insert(
		self._conns,
		UserInputService.WindowFocusReleased:Connect(function()
			self:_on_focus_lost()
		end)
	)
	-- the Roblox menu takes every finger / the mouse: a gesture in flight never ends on the globe
	table.insert(
		self._conns,
		GuiService.MenuOpened:Connect(function()
			self:_on_focus_lost()
		end)
	)
	table.insert(
		self._conns,
		UserInputService.WindowFocused:Connect(function()
			self:mouse_entered_window()
		end)
	)
end

-- ---------------------------------------------------------------------------------------------
-- Touch tracking
-- ---------------------------------------------------------------------------------------------

function MapInput._touch_down(self: any, io: InputObject, gp: boolean)
	if self._touches[io] ~= nil then
		return -- repeated press
	end
	-- a new finger: touches whose End / Cancel was missed never count. Age alone (no InputChanged
	-- for STALE_TOUCH_S) only evicts when the new finger would otherwise be refused: Roblox reports
	-- nothing for a finger held still, so a resting thumb must survive a second finger landing
	-- (review_code R3-1), while two lost touches still cannot lock every later touch out.
	self:_prune_touches(nil)
	if self._touch_count >= 2 then
		self:_prune_touches(MapInput.STALE_TOUCH_S)
	end
	if self._touch_count >= 2 then
		return -- a third finger: ignore
	end
	self._touch_order += 1
	local pos = view_pos(io)
	local t: Touch = {
		io = io,
		pos = pos,
		pair_pos = pos,
		owner = if gp then UI else GLOBE,
		order = self._touch_order,
		t = os.clock(),
	}
	self._touches[io] = t
	self._touch_count += 1
	self.stats.touch_presses += 1
	if self._touch_count == 2 then
		-- a second finger: no orbit, no inertia, no tap from here on
		self:_cancel_press()
		self._press_consumed = true
		self.rig:halt()
		for _, o in self._touches do
			o.pair_pos = o.pos
		end
	end
	if t.owner == GLOBE then
		self:_touch_on_globe(t)
	end
end

function MapInput._other(self: any, io: InputObject): Touch?
	for k, o in self._touches do
		if k ~= io then
			return o
		end
	end
	return nil
end

--- A touch press that the GUI did not process: the finger is on free globe.
function MapInput._touch_on_globe(self: any, t: Touch)
	if self._touch_count == 1 then
		self:_pointer_down(t.io, t.pos, TAP_SLOP_TOUCH)
		return
	end
	local other = self:_other(t.io)
	if other ~= nil and other.owner == GLOBE then
		self:_start_pinch() -- both fingers on the globe: pinch at once
	elseif other ~= nil and not self._press_active then
		-- the other finger rests on the HUD: this one runs a one-finger gesture (no tap until the
		-- pairing ends, so a HUD thumb can't turn into a pinch-tap)
		self:_pointer_down(t.io, t.pos, TAP_SLOP_TOUCH)
	end
end

function MapInput._touch_up(self: any, io: InputObject)
	local t = self._touches[io]
	if t == nil then
		return
	end
	local owned = self:touch_owned_by_world(io)
	self._released_owned[io] = owned
	self._touches[io] = nil
	self._touch_count -= 1
	if self._pinching and (io == self._pinch_a or io == self._pinch_b) then
		self._pinching = false
	end
	if not self:_active() then
		self:_cancel_press()
		return
	end
	if self._touch_count == 0 then
		if self._press_active and self._press_index == io then
			self:_pointer_up(view_pos(io))
		end
		self._press_active = false
		return
	end
	-- one finger remains: if it is on the globe it may orbit after moving, but never taps
	local rest = self:_other(io)
	self:_cancel_press()
	if rest ~= nil and rest.owner == GLOBE then
		self:_pointer_down(rest.io, rest.pos, TAP_SLOP_TOUCH)
		self._press_consumed = true
	end
end

function MapInput._touch_drag(self: any, io: InputObject)
	local t = self._touches[io]
	if t == nil then
		return
	end
	local pos = view_pos(io)
	local rel = pos - t.pos
	t.pos = pos
	t.t = os.clock()
	if self._pinching then
		self:_pinch_update()
		return
	end
	if self._touch_count == 2 then
		local other = self:_other(io) :: Touch
		local mixed = t.owner ~= GLOBE or other.owner ~= GLOBE
		if
			mixed
			and (t.pos - t.pair_pos).Magnitude >= MapInput.PINCH_MOVE_PX
			and (other.pos - other.pair_pos).Magnitude >= MapInput.PINCH_MOVE_PX
		then
			self:_start_pinch()
		end
		return -- a globe finger during a two-finger touch never orbits
	end
	if t.owner == GLOBE and self._press_active and self._press_index == io then
		self:_pointer_move(pos, rel)
	end
end

function MapInput._start_pinch(self: any)
	local a, b = nil :: Touch?, nil :: Touch?
	for _, o in self._touches do
		if a == nil or o.order < a.order then
			b = a
			a = o
		else
			b = o
		end
	end
	if a == nil or b == nil then
		return
	end
	self._pinching = true
	self._pinch_a = a.io
	self._pinch_b = b.io
	self._pinch_dist = (a.pos - b.pos).Magnitude
	self._pinch_anchor = self.rig:globe_hit((a.pos + b.pos) * 0.5)
	self:_cancel_press()
	self._press_consumed = true
	self.rig:halt()
	self.stats.pinches += 1
end

function MapInput._pinch_update(self: any)
	local a = self._touches[self._pinch_a]
	local b = self._touches[self._pinch_b]
	if a == nil or b == nil then
		return
	end
	local d = (a.pos - b.pos).Magnitude
	if self._pinch_dist > 1.0 and d > 1.0 then
		self.rig:zoom_by(d / self._pinch_dist, self._pinch_anchor)
	end
	self._pinch_dist = d
end

-- ---------------------------------------------------------------------------------------------
-- One-pointer gesture (mouse or a single globe finger)
-- ---------------------------------------------------------------------------------------------

function MapInput._pointer_down(self: any, index: any, pos: Vector2, slop: number)
	local moving = self.rig:is_moving(MapInput.STOP_PX_PER_S)
	self.rig:halt()
	self._press_active = true
	self._press_index = index
	self._press_pos = pos
	self._press_ms = now_ms()
	self._press_dragging = false
	self._press_consumed = false
	self._press_stop = moving -- a "stop" press: halts the globe, never taps (it may still be held)
	self._press_slop = slop
	if moving then
		self.stats.stop_presses += 1
	end
end

function MapInput._pointer_move(self: any, pos: Vector2, rel: Vector2)
	if not self._press_dragging then
		if (pos - self._press_pos).Magnitude <= self._press_slop then
			return
		end
		self._press_dragging = true
		self.rig:begin_drag()
		self:set_hover_tile(-1)
		rel = pos - self._press_pos
	end
	self.rig:drag_by(rel)
end

function MapInput._pointer_up(self: any, pos: Vector2)
	if not self._press_active then
		return
	end
	self._press_active = false
	if self._press_dragging then
		self._press_dragging = false
		self.rig:end_drag()
		return
	end
	if self._press_consumed or self._press_stop then
		return
	end
	local tile = self.view:tile_at_screen(pos)
	if tile >= 0 then
		self.view.tile_clicked:Fire(tile)
	end
end

--- A finger held still on the map (viewport px) and how far along the long-press it is (0..1); nil
--- when no touch hold runs.
function MapInput.hold_state(self: any): (Vector2?, number)
	if
		not self._press_active
		or self._press_dragging
		or self._press_consumed
		or self._press_index == MOUSE
		or not self:_active()
	then
		return nil, 0
	end
	return self._press_pos, math.clamp((now_ms() - self._press_ms) / MapInput.LONG_PRESS_MS, 0, 1)
end

function MapInput._cancel_press(self: any)
	if self._press_dragging then
		self.rig:end_drag()
		self.rig:halt()
	end
	self._press_active = false
	self._press_dragging = false
end

--- Test hooks: synthesise pointer events (viewport px) through the same paths.
function MapInput.debug_pointer(self: any, what: string, pos: Vector2)
	if what == "down" then
		self:_pointer_down(MOUSE, pos, TAP_SLOP_MOUSE)
	elseif what == "move" then
		local rel = pos - self._mouse_pos
		self._mouse_pos = pos
		if self._press_active then
			self:_pointer_move(pos, rel)
		end
	elseif what == "up" then
		self:_pointer_up(pos)
	end
end

return MapInput
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">MapSurface</string>
              <string name="Source"><![CDATA[--!native
-- The 2D map surface (terrain, territory and borders): one pixel per
-- tile, nearest-neighbour upscaled (ResampleMode Pixelated) so tiles stay crisp squares at any zoom.
--
-- Terrain and territory are composited on the CPU into one RGBA image of the map, split into
-- image tiles of at most 1024 x 1024 (the client EditableImage limit), each shown by one ImageLabel
-- that MapView moves every frame. Only one displayed EditableImage updates per frame (Roblox), so
-- dirty rows are uploaded round-robin: one image tile per frame, all of its dirty 32-row bands.
--   terrain    terrain_pixel of the map's terrain bytes
--              (map.tile_bytes: bit7 land, bit6 shoreline, bits0-4 magnitude), colours from
--              OCEAN .. MOUNTAIN (e.g. highland #DCCB9E);
--   territory  owned tiles blend the owner's colour at 150/255 (saturation 0.85) over the terrain,
--              border tiles are opaque in the border colour (HSL lightness - 0.125), fallout ground is
--              opaque green noise.
-- The rules:
--   * border tile = a 4-neighbour has another owner (off the map counts as another owner);
--   * hovered owner: fill contrast x1.25 about mid-grey, border mixed 25% to white, border thickened
--     by one tile (Chebyshev 1). The fill only for an owner of HOVER_FILL_MAX tiles or fewer: it
--     means repainting every tile (see HOVER_FILL_MAX);
--   * a border next to an ally is mixed 35% toward green;
--   * defended tiles (near a same-owner defense post): border checkerboard x0.7, fill x0.85.
-- (Lune tests load this file with the shared modules from the repo.)
local IS_ROBLOX = (game :: any) ~= nil
local AssetService = if IS_ROBLOX then game:GetService("AssetService") else nil :: any
local function core(name: string): any
	if IS_ROBLOX then
		return require(
			game:GetService("ReplicatedStorage"):WaitForChild("Airfront"):WaitForChild("Core"):WaitForChild(name)
		) :: any
	end
	return (require :: any)("../../shared/Core/" .. name)
end
local Defs = core("Defs")
local Rules = core("Rules")
local Cosmetics: any = if IS_ROBLOX
	then require(game:GetService("ReplicatedStorage"):WaitForChild("Airfront"):WaitForChild("Data").Cosmetics) :: any
	else (require :: any)("../../shared/Data/Cosmetics")

local F_FALLOUT: number = Defs.F_FALLOUT

local band = bit32.band
local readu8, writeu8 = buffer.readu8, buffer.writeu8
local readi32 = buffer.readi32
local readu32, writeu32 = buffer.readu32, buffer.writeu32

local MapSurface = {}
MapSurface.__index = MapSurface

-- Territory look
MapSurface.TERRITORY_ALPHA = 150 -- 0.588
MapSurface.SATURATION = 0.85
MapSurface.BORDER_DARKEN = 0.125
MapSurface.HIGHLIGHT_BRIGHTEN = 0.25
MapSurface.FRIENDLY_TINT = 0.35
MapSurface.DEFENSE_CHECKER_DARKEN = 0.7
MapSurface.DEFENSE_FILL_DARKEN = 0.85
--- Client EditableImage limit (px per side).
MapSurface.IMAGE_MAX = 1024
MapSurface.BAND_ROWS = 32
--- Full rebuild work per frame (tiles).
MapSurface.REBUILD_TILES_PER_STEP = 90000
--- Repaint work per frame (tiles). The tiles a change may have altered wait in a queue, each of them
--- once (on_tiles_changed), and step() paints this many a frame (paint_queue).
---   * Until 2026-10-09 every changed tile repainted its 3 x 3 at once: nine tiles for each, the same
---     ones over and over along a front that moved, most of them tiles whose look could not have
---     changed. 6.5 ms a tick in a World match's first minute on a Mac (1,350 tiles change a tick),
---     71 ms in the one tick a big nation fell (26,000). A client of a public match pays that for
---     every tick it is sent, and a phone or an old PC several times it: the "Slow Frames" of v71
---     were early in matches and in no script that report counted.
---   * Now 2.8 ms that first minute (2.6 tiles repainted for each one changed, where there were 9),
---     and the big tick's repaint goes over a few frames.
MapSurface.REPAINT_TILES_PER_STEP = 6000
--- Recorded tile changes looked at a step at least (more while the budget lasts, and a DRAIN_FRAMES share
--- of what waits whatever the clock says): 2,000 change a tick in a solo match's first minute, ten
--- ticks a second, about 330 a frame (_expand_changes).
MapSurface.EXPAND_MIN_CHANGES = 256
--- A hovered owner's fill is brightened while it holds this many tiles or fewer. Its border is
--- brightened and thickened whatever its size.
---   * Until 2026-10-09 the pointer coming onto a nation repainted every tile it owned, at once, and
---     every tile of the one it left. On a Mac: 15 ms for the biggest nation of a World match at minute
---     2, 123 ms at minute 10, 380 ms at minute 26 (395,000 tiles), and as much again on leaving. A
---     desktop player moving the mouse over a late match had frames of seconds; the "Slow Frames" of
---     v71 and v72 named this ("Script - Map Other") for 6 in 10 of the slow matches on computers,
---     and a player's report was "I went down to like 3fps nearing the end".
---   * Now the call repaints nothing: the tiles a hover changes are found a slice a frame
---     (SWEEP_SCAN_PER_STEP) and repainted through the queue (REPAINT_TILES_PER_STEP). No frame of
---     it is over 5 ms on that Mac whatever the nation; a small one is done in 3 to 6 frames, the
---     395,000-tile one in about 70 (its border comes in from the top).
MapSurface.HOVER_FILL_MAX = 30000
--- Tiles a step() looks at to find the ones an owner's repaint needs (repaint_owner, set_hover,
--- repaint_between).
MapSurface.SWEEP_SCAN_PER_STEP = 20000
--- Time a step() spends repainting (s; `budget_s`, MapView gives phones the MOBILE one). It paints
--- DRAIN_FRAMES' share of what waits whatever that takes (REPAINT_MIN_TILES at least), more while the
--- budget lasts, never more than REPAINT_TILES_PER_STEP; the sweeps look for tiles in what is left
--- (a row at least).
---   * Until 2026-10-10 a step was bounded in tiles only: 6,000 repainted and 20,000 looked at, about
---     4.5 ms on a Mac and many times that on a phone, which runs this without native code. A solo
---     World match has 5 to 10 alliance changes a minute from minute 2, and each was a sweep of both
---     nations at that bound for a few dozen frames. "Slow Frames" after v74: "Script - Territory"
---     was 6% of the slow matches, nearly all phones in Solo Easy, minutes 5 to 19.
---   * A burst (a nation falling, a sweep) now goes over more frames on a slow device; what the game
---     changed waits DRAIN_FRAMES frames at most when the device cannot keep up at all.
MapSurface.STEP_BUDGET_S = 0.003
MapSurface.STEP_BUDGET_MOBILE_S = 0.002
MapSurface.DRAIN_FRAMES = 10
MapSurface.REPAINT_MIN_TILES = 256
--- Tiles painted between two looks at the clock.
MapSurface.REPAINT_CHUNK = 256
--- Map background (also impassable terrain).
MapSurface.BACKGROUND = Color3.fromRGB(0x3c, 0x3c, 0x3c)

local BAND_ROWS = MapSurface.BAND_ROWS
local MAX_OWNERS = 4096

-- ---------------------------------------------------------------------------------------------
-- Colour helpers
-- ---------------------------------------------------------------------------------------------

local function pack(r: number, g: number, b: number, a: number): number
	r = math.clamp(math.floor(r + 0.5), 0, 255)
	g = math.clamp(math.floor(g + 0.5), 0, 255)
	b = math.clamp(math.floor(b + 0.5), 0, 255)
	a = math.clamp(math.floor(a + 0.5), 0, 255)
	return r + g * 256 + b * 65536 + a * 16777216
end
MapSurface.pack = pack

local function rgb_to_hsl(r: number, g: number, b: number): (number, number, number)
	local mx, mn = math.max(r, g, b), math.min(r, g, b)
	local l = (mx + mn) / 2
	if mx == mn then
		return 0.0, 0.0, l
	end
	local d = mx - mn
	local s = if l > 0.5 then d / (2 - mx - mn) else d / (mx + mn)
	local h
	if mx == r then
		h = (g - b) / d + (if g < b then 6 else 0)
	elseif mx == g then
		h = (b - r) / d + 2
	else
		h = (r - g) / d + 4
	end
	return h / 6, s, l
end

local function hue(p: number, q: number, t: number): number
	if t < 0 then
		t += 1
	elseif t > 1 then
		t -= 1
	end
	if t < 1 / 6 then
		return p + (q - p) * 6 * t
	elseif t < 1 / 2 then
		return q
	elseif t < 2 / 3 then
		return p + (q - p) * (2 / 3 - t) * 6
	end
	return p
end

local function hsl_to_rgb(h: number, s: number, l: number): (number, number, number)
	if s == 0 then
		return l, l, l
	end
	local q = if l < 0.5 then l * (1 + s) else l + s - l * s
	local p = 2 * l - q
	return hue(p, q, h + 1 / 3), hue(p, q, h), hue(p, q, h - 1 / 3)
end

--- Darkened by `amount`: HSL lightness - amount.
local function darken(r: number, g: number, b: number, amount: number): (number, number, number)
	local h, s, l = rgb_to_hsl(r, g, b)
	return hsl_to_rgb(h, s, math.max(0, l - amount))
end
MapSurface.darken = darken

local function saturate(r: number, g: number, b: number, k: number): (number, number, number)
	local luma = r * 0.299 + g * 0.587 + b * 0.114
	return luma + (r - luma) * k, luma + (g - luma) * k, luma + (b - luma) * k
end

local function contrast(v: number, k: number): number
	return math.clamp((v - 0.5) * k + 0.5, 0, 1)
end

-- ---------------------------------------------------------------------------------------------
-- Terrain (colour by terrain class and magnitude)
-- ---------------------------------------------------------------------------------------------

local OCEAN = { 0x47, 0x85, 0xB5 } -- #4785b5
local SAND = { 0xCC, 0xCB, 0x9E } -- #CCCB9E
local PLAINS = { 0xBE, 0xDC, 0x8A } -- #BEDC8A
local HIGHLAND = { 0xDC, 0xCB, 0x9E } -- #DCCB9E
local MOUNTAIN = { 0xE6, 0xE6, 0xE6 } -- #e6e6e6
local BACKGROUND = { 0x3C, 0x3C, 0x3C } -- #3c3c3c

--- RGBA8 terrain pixel of a terrain byte (see tile_bytes).
function MapSurface.terrain_pixel(tb: number): number
	local land = tb >= 128
	local shore = band(tb, 64) ~= 0
	local mag = band(tb, 31)
	if land and mag == 31 then
		return pack(BACKGROUND[1], BACKGROUND[2], BACKGROUND[3], 255)
	elseif land and shore then
		return pack(SAND[1], SAND[2], SAND[3], 255)
	elseif land then
		if mag < 10 then
			return pack(PLAINS[1], PLAINS[2] - 2 * mag, PLAINS[3], 255)
		elseif mag < 20 then
			local m = mag - 10
			return pack(HIGHLAND[1] + 2 * m, HIGHLAND[2] + 2 * m, HIGHLAND[3] + 2 * m, 255)
		end
		local m = mag // 2
		return pack(MOUNTAIN[1] + m, MOUNTAIN[2] + m, MOUNTAIN[3] + m, 255)
	elseif shore then
		return pack(0.7 * OCEAN[1] + 76.5, 0.7 * OCEAN[2] + 76.5, 0.7 * OCEAN[3] + 76.5, 255)
	end
	local m = math.min(mag, 10)
	return pack(OCEAN[1] - m, OCEAN[2] - m, OCEAN[3] - m, 255)
end

--- Terrain bytes in the map files' format for the legacy 1024 x 512 Earth (terrain classes only, no
--- elevation): each land class ramps with the distance from its edge (plains 0..9 from the coast,
--- highland 10..19 and mountain 20..30 toward the middle of a range), water magnitude is the
--- ceil(Manhattan distance to land in full-size tiles / 2). Retired with the Earth (flat
--- maps carry map.tile_bytes).
function MapSurface.legacy_of_bytes(map: any, yield: (() -> ())?): buffer
	local W, H = map.W or Defs.W, map.H or Defs.H
	local N = W * H
	local terrain: buffer = map.terrain
	local T_LAKE, T_PLAINS, T_HIGHLAND, T_MOUNTAIN, T_TUNDRA =
		Defs.T_LAKE, Defs.T_PLAINS, Defs.T_HIGHLAND, Defs.T_MOUNTAIN, Defs.T_TUNDRA
	local function tclass(i: number): number
		return readu8(terrain, i)
	end
	local dist = buffer.create(N * 2)
	local queue = buffer.create(N * 4)
	local function nb(i: number): (number, number, number, number)
		local x = i % W
		return if x > 0 then i - 1 else -1,
			if x < W - 1 then i + 1 else -1,
			if i >= W then i - W else -1,
			if i < N - W then i + W else -1
	end
	local function bfs(seed: (number) -> boolean, member: (number) -> boolean)
		local qh, qt = 0, 0
		for i = 0, N - 1 do
			if seed(i) then
				buffer.writeu16(dist, i * 2, 0)
				buffer.writeu32(queue, qt * 4, i)
				qt += 1
			else
				buffer.writeu16(dist, i * 2, 65535)
			end
		end
		while qh < qt do
			local i = buffer.readu32(queue, qh * 4)
			qh += 1
			local d = buffer.readu16(dist, i * 2) + 1
			local a, b, c, e = nb(i)
			for _, n in { a, b, c, e } do
				if n >= 0 and buffer.readu16(dist, n * 2) == 65535 and member(n) then
					buffer.writeu16(dist, n * 2, d)
					buffer.writeu32(queue, qt * 4, n)
					qt += 1
				end
			end
			if yield and qh % 65536 == 0 then
				yield()
			end
		end
	end
	local function is_water(tt: number): boolean
		return tt <= T_LAKE
	end
	local out = buffer.create(N)
	local k_lin: number = Rules.K_LIN
	bfs(function(i)
		return not is_water(tclass(i))
	end, function(i)
		return is_water(tclass(i))
	end)
	for i = 0, N - 1 do
		if is_water(tclass(i)) then
			writeu8(out, i, math.min(31, math.ceil(buffer.readu16(dist, i * 2) * k_lin / 2)))
		end
	end
	bfs(function(i)
		return is_water(tclass(i))
	end, function(i)
		return not is_water(tclass(i))
	end)
	for i = 0, N - 1 do
		local tt = tclass(i)
		if tt == T_PLAINS or tt == T_TUNDRA then
			writeu8(out, i, 128 + math.min(9, buffer.readu16(dist, i * 2) // 3))
		elseif tt > T_TUNDRA then
			writeu8(out, i, 128 + 30)
		end
	end
	for _, cls in { T_HIGHLAND, T_MOUNTAIN } do
		bfs(function(i)
			return tclass(i) ~= cls
		end, function(i)
			return tclass(i) == cls
		end)
		for i = 0, N - 1 do
			if tclass(i) == cls then
				local d = buffer.readu16(dist, i * 2)
				writeu8(
					out,
					i,
					128 + (if cls == T_HIGHLAND then 10 + math.min(9, (d - 1) * 2) else 20 + math.min(10, (d - 1) * 3))
				)
			end
		end
	end
	-- shoreline bits: land next to water, water next to land
	for i = 0, N - 1 do
		local w = is_water(tclass(i))
		local a, b, c, e = nb(i)
		for _, n in { a, b, c, e } do
			if n >= 0 and is_water(tclass(n)) ~= w then
				writeu8(out, i, bit32.bor(readu8(out, i), 64))
				break
			end
		end
	end
	return out
end

-- ---------------------------------------------------------------------------------------------
-- Instance
-- ---------------------------------------------------------------------------------------------

type ImgTile = {
	x0: number,
	y0: number,
	w: number,
	h: number,
	img: EditableImage?,
	label: ImageLabel,
	bands: { boolean },
	dirty: boolean,
	scratch: buffer,
}

export type MapSurface = typeof(setmetatable(
	{} :: {
		root: Frame,
		W: number,
		H: number,
		N: number,
		map: any,
		ok: boolean,
		ready: boolean,
		terrain: buffer,
		tile_bytes: buffer?,
		comp: buffer,
		tiles: { ImgTile },
		cols: number,
		rows: number,
		tile_w: number,
		tile_h: number,
		_rr: number,
		_state: any,
		_own: buffer?,
		_flags: buffer?,
		pal_fill: buffer,
		pal_fill_hi: buffer,
		pal_border: buffer,
		pal_border_hi: buffer,
		pal_border_ally: buffer,
		pal_border_ally_hi: buffer,
		defended: buffer,
		hover: number,
		_rebuild_i: number,
		_rebuild_active: boolean,
		_bbox: { [number]: { number } },
		_skins: { [number]: any },
		budget_s: number,
		uploaded: boolean?,
	},
	MapSurface
))

local function create_image(w: number, h: number): EditableImage?
	local ok, img = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
	end)
	if ok and img ~= nil then
		return img
	end
	return nil
end

function MapSurface.new(parent: Instance): MapSurface
	local root = Instance.new("Frame")
	root.Name = "Surface"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = 1
	root.Parent = parent
	local self = setmetatable({
		root = root,
		W = 0,
		H = 0,
		N = 0,
		map = nil,
		ok = false,
		--- terrain composited (set_map finished)
		ready = false,
		terrain = buffer.create(0),
		tile_bytes = nil :: buffer?,
		comp = buffer.create(0),
		tiles = {},
		cols = 0,
		rows = 0,
		tile_w = 0,
		tile_h = 0,
		_rr = 0,
		_state = nil,
		_own = nil :: buffer?,
		_flags = nil :: buffer?,
		pal_fill = buffer.create(MAX_OWNERS * 4),
		pal_fill_hi = buffer.create(MAX_OWNERS * 4),
		pal_border = buffer.create(MAX_OWNERS * 4),
		pal_border_hi = buffer.create(MAX_OWNERS * 4),
		pal_border_ally = buffer.create(MAX_OWNERS * 4),
		pal_border_ally_hi = buffer.create(MAX_OWNERS * 4),
		--- (per tile: near a same-owner defense post. Nothing writes it today; paint_queue's fast path
		--- does not read it, so whoever starts to must send those tiles through composite())
		defended = buffer.create(0),
		hover = 0,
		_rebuild_i = 0,
		_rebuild_active = false,
		--- per owner: { x0, y0, x1, y1 } of the tiles it has owned since the last rebuild
		_bbox = {},
		--- owner → territory skin runtime (_load_skins)
		_skins = {},
		--- tiles waiting for a repaint (REPAINT_TILES_PER_STEP): the list, its length, the next one to
		--- paint, and a byte a tile that is 1 while it waits
		_queue = {} :: { number },
		_queue_n = 0,
		_queue_head = 1,
		_queued = buffer.create(0),
		--- tile changes not yet looked at (on_tiles_changed records them, step expands them):
		--- packed tile * 1024 + owner, then the old owner (-1: unknown), pairs from _pend_i
		_pend = {} :: { number },
		_pend_n = 0,
		_pend_i = 1,
		--- the records up to here were made before an alliance or a palette changed: each of their
		--- owned neighbours is repainted, whoever owns it (the alliances they were made under are gone)
		_pend_wide_to = 0,
		--- the hovered owner's fill is brightened too (it is small enough: HOVER_FILL_MAX)
		_hover_fill = false,
		--- owners whose tiles are being found for a repaint: { owner, fill (every tile; else the
		--- border and the tiles next to it), y (the next row to look at; -1: from the top), other
		--- (repaint_between: only the owner's and other's tiles that touch each other) }
		_sweeps = {} :: { { owner: number, fill: boolean, y: number, other: number? } },
		--- a step's time (STEP_BUDGET_S)
		budget_s = MapSurface.STEP_BUDGET_S,
	}, MapSurface)
	return self
end

function MapSurface._free_tiles(self: MapSurface)
	for _, t in self.tiles do
		t.label:Destroy()
		if t.img then
			t.img:Destroy()
		end
	end
	table.clear(self.tiles)
end

--- Show map `map` (W / H + tile_bytes, or the legacy Earth): builds the terrain (yields between
--- slices when it may) and the image tiles. Territory is drawn once a state is bound.
function MapSurface.set_map(self: MapSurface, map: any)
	if self.map == map and self.ready then
		return
	end
	self.ready = false
	self:_free_tiles()
	self.map = map
	local W = map.W or map.width or Defs.W
	local H = map.H or map.height or Defs.H
	self.W, self.H, self.N = W, H, W * H
	self._queued = buffer.create(W * H)
	table.clear(self._queue)
	self._queue_n, self._queue_head = 0, 1
	self:_drop_changes()
	local function yield()
		if coroutine.isyieldable() then
			task.wait()
		end
	end
	local of: buffer = map.tile_bytes or MapSurface.legacy_of_bytes(map, yield)
	--- terrain byte per tile (bit7 land, bit6 shoreline, bit5 ocean, bits0-4 magnitude)
	self.tile_bytes = of
	local N = W * H
	local terrain = buffer.create(N * 4)
	for i = 0, N - 1 do
		writeu32(terrain, i * 4, MapSurface.terrain_pixel(readu8(of, i)))
		if i % 262144 == 262143 then
			yield()
		end
	end
	self.terrain = terrain
	local comp = buffer.create(N * 4)
	buffer.copy(comp, 0, terrain, 0, N * 4)
	self.comp = comp
	self.defended = buffer.create(N)
	-- image tiles: an even split into pieces of at most IMAGE_MAX per side
	local cols = math.ceil(W / MapSurface.IMAGE_MAX)
	local rows = math.ceil(H / MapSurface.IMAGE_MAX)
	local tw, th = math.ceil(W / cols), math.ceil(H / rows)
	self.cols, self.rows, self.tile_w, self.tile_h = cols, rows, tw, th
	local all_ok = true
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			local x0, y0 = c * tw, r * th
			local w, h = math.min(tw, W - x0), math.min(th, H - y0)
			local img = create_image(w, h)
			all_ok = all_ok and img ~= nil
			local l = Instance.new("ImageLabel")
			l.Name = string.format("Map_%d_%d", c, r)
			l.BackgroundColor3 = MapSurface.BACKGROUND
			l.BackgroundTransparency = if img then 1 else 0
			l.BorderSizePixel = 0
			l.ResampleMode = Enum.ResamplerMode.Pixelated
			l.ScaleType = Enum.ScaleType.Stretch
			l.Active = false
			l.ZIndex = 1
			if img then
				l.ImageContent = Content.fromObject(img)
			end
			l.Parent = self.root
			local nb = math.ceil(h / BAND_ROWS)
			local t: ImgTile = {
				x0 = x0,
				y0 = y0,
				w = w,
				h = h,
				img = img,
				label = l,
				bands = table.create(nb, true),
				dirty = true,
				scratch = buffer.create(w * BAND_ROWS * 4),
			}
			table.insert(self.tiles, t)
		end
	end
	self.ok = all_ok
	if not all_ok then
		warn("[RoWorld] map: EditableImage unavailable (memory budget) — parts of the map cannot be drawn")
	end
	self.ready = true
	if self._state ~= nil then
		self:rebuild_all()
	end
end

--- Place the image tiles for camera `cam` (MapCamera), edges snapped to whole px so neighbouring
--- tiles meet without seams.
function MapSurface.layout(self: MapSurface, cam: any)
	local vp = cam._vp
	for _, t in self.tiles do
		local sx0, sy0 = cam:map_to_screen(t.x0, t.y0)
		local sx1, sy1 = cam:map_to_screen(t.x0 + t.w, t.y0 + t.h)
		sx0, sy0, sx1, sy1 = math.round(sx0), math.round(sy0), math.round(sx1), math.round(sy1)
		local l = t.label
		local vis = sx1 > 0 and sy1 > 0 and sx0 < vp.X and sy0 < vp.Y
		if l.Visible ~= vis then
			l.Visible = vis
		end
		if vis then
			local pos = UDim2.fromOffset(sx0, sy0)
			local size = UDim2.fromOffset(sx1 - sx0, sy1 - sy0)
			if l.Position ~= pos then
				l.Position = pos
			end
			if l.Size ~= size then
				l.Size = size
			end
		end
	end
end

-- ---------------------------------------------------------------------------------------------
-- Territory
-- ---------------------------------------------------------------------------------------------

function MapSurface.bind(self: MapSurface, state: any)
	self._state = state
	self._own = if state then state.owner else nil
	self._flags = if state then state.flags else nil
	self._skins = {}
	self:_load_skins(nil)
	table.clear(self._bbox)
	if buffer.len(self.defended) > 0 then
		buffer.fill(self.defended, 0, 0)
	end
	self.hover = 0
	(self :: any)._hover_fill = false
	self:refresh_palette()
	self:rebuild_all()
end

function MapSurface.unbind(self: MapSurface)
	self._state = nil
	self._own = nil
	self._flags = nil
end

--- Territory skins (Data/Cosmetics): owner → { mask, w, h, scale, skin, fill2, fill2_hi }. `ids`: the
--- owners to (re)load (nil: every owner with cosmetics). Colours follow in refresh_palette.
function MapSurface._load_skins(self: any, ids: { number }?)
	local st = self._state
	if st == nil then
		return
	end
	local list = ids
	if list == nil then
		list = {}
		for id in st.cosmetics or {} do
			table.insert(list, id)
		end
	end
	for _, id in list do
		local c = (st.cosmetics or {})[id]
		local skin = if c ~= nil then Cosmetics.item(c.skin) else nil
		if skin == nil or skin.kind ~= "skin" then
			self._skins[id] = nil
		else
			local cur = self._skins[id]
			if cur == nil or cur.skin ~= skin then
				local mask, w, h = Cosmetics.mask(skin)
				self._skins[id] = {
					mask = mask,
					w = w,
					h = h,
					scale = skin.scale or 0,
					skin = skin,
					fill2 = 0,
					fill2_hi = 0,
					-- (a skin with several colours: mask byte k -> fills[k]; refresh_palette packs them)
					fills = if skin.colors ~= nil then {} else nil,
					fills_hi = if skin.colors ~= nil then {} else nil,
				}
			end
		end
	end
end

--- Owners' skins changed (GameState.cosmetics_changed): their land repaints.
function MapSurface.on_cosmetics_changed(self: any, ids: { number })
	self:_load_skins(ids)
	self:refresh_palette()
	for _, id in ids do
		self:repaint_owner(id)
	end
end

--- Recompute every owner's fill / border colours (owner added, alliance change).
function MapSurface.refresh_palette(self: MapSurface)
	local st = self._state
	if st == nil then
		return
	end
	local sat = MapSurface.SATURATION
	local alpha = MapSurface.TERRITORY_ALPHA
	local hi_k = 1.0 + MapSurface.HIGHLIGHT_BRIGHTEN
	for id, o in st.owners do
		if id <= 0 or id >= MAX_OWNERS then
			continue
		end
		local r, g, b
		local c = o.color
		if typeof(c) == "Color3" then
			r, g, b = c.R, c.G, c.B
		else
			r, g, b = Defs.rgba_floats(o.rgba or 0x999999FF)
		end
		local fr, fg, fb = saturate(r, g, b, sat)
		writeu32(self.pal_fill, id * 4, pack(fr * 255, fg * 255, fb * 255, alpha))
		writeu32(
			self.pal_fill_hi,
			id * 4,
			pack(contrast(fr, hi_k) * 255, contrast(fg, hi_k) * 255, contrast(fb, hi_k) * 255, alpha)
		)
		local sk = (self :: any)._skins and (self :: any)._skins[id]
		if sk ~= nil and sk.fills ~= nil then
			local a2 = Cosmetics.skin_alpha(sk.skin)
			for k = 1, #sk.skin.colors do
				local sr, sg, sb = Cosmetics.color(sk.skin, k)
				sk.fills[k] = pack((sr :: number) * 255, (sg :: number) * 255, (sb :: number) * 255, a2)
				sk.fills_hi[k] = pack(
					contrast(sr :: number, hi_k) * 255,
					contrast(sg :: number, hi_k) * 255,
					contrast(sb :: number, hi_k) * 255,
					a2
				)
			end
		elseif sk ~= nil then
			local a2 = Cosmetics.SECONDARY_ALPHA
			local sr, sg, sb = Cosmetics.secondary(sk.skin, fr, fg, fb)
			sk.fill2 = pack(sr * 255, sg * 255, sb * 255, a2)
			sk.fill2_hi = pack(contrast(sr, hi_k) * 255, contrast(sg, hi_k) * 255, contrast(sb, hi_k) * 255, a2)
		end
		local br, bg, bb = darken(r, g, b, MapSurface.BORDER_DARKEN)
		local function border(hl: boolean, ally: boolean): number
			local x, y, z = br, bg, bb
			if hl then
				local t = MapSurface.HIGHLIGHT_BRIGHTEN
				x, y, z = x + (1 - x) * t, y + (1 - y) * t, z + (1 - z) * t
			end
			if ally then
				local t = MapSurface.FRIENDLY_TINT
				x, y, z = x * (1 - t), y + (1 - y) * t, z * (1 - t)
			end
			return pack(x * 255, y * 255, z * 255, 255)
		end
		writeu32(self.pal_border, id * 4, border(false, false))
		writeu32(self.pal_border_hi, id * 4, border(true, false))
		writeu32(self.pal_border_ally, id * 4, border(false, true))
		writeu32(self.pal_border_ally_hi, id * 4, border(true, true))
	end
end

local function dim(c: number, k: number): number
	local r = c % 256
	local g = (c // 256) % 256
	local b = (c // 65536) % 256
	local a = c // 16777216
	return math.floor(r * k) + math.floor(g * k) * 256 + math.floor(b * k) * 65536 + a * 16777216
end

--- Territory overlay RGBA of tile i (alpha 0 = terrain only).
function MapSurface.tile_pixel(self: MapSurface, i: number): number
	local own = self._own :: buffer
	local flags = self._flags :: buffer
	local W, N = self.W, self.N
	local x = i % W
	if band(readu8(flags, i), F_FALLOUT) ~= 0 then
		-- stale-nuke ground: (0.05, 0.55, 0.07) + hash noise * 0.05, opaque
		local y = i // W
		local h = math.sin(x * 12.9898 + y * 78.233) * 43758.5453
		h -= math.floor(h)
		local nz = h * 0.05
		return pack((0.05 + nz) * 255, (0.55 + nz) * 255, (0.07 + nz) * 255, 255)
	end
	local o = readi32(own, i * 4)
	if o <= 0 or o >= MAX_OWNERS then
		return 0
	end
	local nw = if x > 0 then readi32(own, (i - 1) * 4) else -1
	local ne = if x < W - 1 then readi32(own, (i + 1) * 4) else -1
	local nn = if i >= W then readi32(own, (i - W) * 4) else -1
	local ns = if i < N - W then readi32(own, (i + W) * 4) else -1
	local hl = o == self.hover
	local border = nw ~= o or ne ~= o or nn ~= o or ns ~= o
	if not border and hl then
		-- highlight thicken: Chebyshev distance 1 (the diagonals; never off the map here)
		border = readi32(own, (i - W - 1) * 4) ~= o
			or readi32(own, (i - W + 1) * 4) ~= o
			or readi32(own, (i + W - 1) * 4) ~= o
			or readi32(own, (i + W + 1) * 4) ~= o
	end
	local def = readu8(self.defended, i) ~= 0
	if border then
		local st = self._state
		-- (four tests, not a loop over a table of the four: a table a border tile was garbage)
		local ally = st ~= nil
			and (
				(nw > 0 and nw ~= o and st:are_allies(o, nw))
				or (ne > 0 and ne ~= o and st:are_allies(o, ne))
				or (nn > 0 and nn ~= o and st:are_allies(o, nn))
				or (ns > 0 and ns ~= o and st:are_allies(o, ns))
			)
		local c
		if ally then
			c = readu32(if hl then self.pal_border_ally_hi else self.pal_border_ally, o * 4)
		else
			c = readu32(if hl then self.pal_border_hi else self.pal_border, o * 4)
		end
		if def and (x + i // W) % 2 == 1 then
			c = dim(c, MapSurface.DEFENSE_CHECKER_DARKEN)
		end
		return c
	end
	local c
	local hl_fill = hl and (self :: any)._hover_fill == true
	local sk = (self :: any)._skins[o]
	if sk ~= nil then
		-- a territory skin: the mask's secondary tiles (a non-zero mask byte)
		local mx = bit32.rshift(x, sk.scale) % sk.w
		local my = bit32.rshift(i // W, sk.scale) % sk.h
		local k = readu8(sk.mask, my * sk.w + mx)
		if k ~= 0 then
			local fills = sk.fills
			if fills ~= nil then
				-- (several colours: a key past the list falls back to the owner's fill below)
				c = if hl_fill then sk.fills_hi[k] else fills[k]
			else
				c = if hl_fill then sk.fill2_hi else sk.fill2
			end
		end
	end
	if c == nil then
		c = readu32(if hl_fill then self.pal_fill_hi else self.pal_fill, o * 4)
	end
	if def then
		c = dim(c, MapSurface.DEFENSE_FILL_DARKEN)
	end
	return c
end

--- Composite tile i (terrain under its overlay) into the image buffer.
local function composite(self: MapSurface, i: number)
	local over = self:tile_pixel(i)
	local a = over // 16777216
	local k = i * 4
	if a == 0 then
		writeu32(self.comp, k, readu32(self.terrain, k))
	elseif a == 255 then
		writeu32(self.comp, k, over)
	else
		local t = readu32(self.terrain, k)
		local f = a / 255
		local g = 1 - f
		local r = (t % 256) * g + (over % 256) * f
		local gg = ((t // 256) % 256) * g + ((over // 256) % 256) * f
		local b = ((t // 65536) % 256) * g + ((over // 65536) % 256) * f
		writeu32(
			self.comp,
			k,
			math.floor(r + 0.5) + math.floor(gg + 0.5) * 256 + math.floor(b + 0.5) * 65536 + 4278190080
		)
	end
end

local function mark(self: MapSurface, x: number, y: number)
	local tw, th = self.tile_w, self.tile_h
	local t = self.tiles[(y // th) * self.cols + (x // tw) + 1]
	if t then
		t.bands[(y - t.y0) // BAND_ROWS + 1] = true
		t.dirty = true
	end
end

--- Repaints queue[head .. last] (step()). The same picture as composite() for every tile, and for
--- most of them without its calls: a tile with no fallout, no skin, no defense post near and not the
--- skin is nobody's (the terrain), a border (its colour) or a fill (blended over the terrain), from
--- buffers held in locals. The others go through composite().
local function paint_queue(self: MapSurface, head: number, last: number)
	local queue, queued = self._queue, self._queued
	local own = self._own :: buffer
	local flags = self._flags :: buffer
	local comp, terrain = self.comp, self.terrain
	local pal_fill, pal_border, pal_border_ally = self.pal_fill, self.pal_border, self.pal_border_ally
	local pal_fill_hi, pal_border_hi, pal_border_ally_hi = self.pal_fill_hi, self.pal_border_hi, self.pal_border_ally_hi
	local hover_fill = (self :: any)._hover_fill == true
	local W, N = self.W, self.N
	local W4 = W * 4
	-- (each buffer read below is a cache miss on a map this size, which is most of a tile's cost:
	-- the fallout flags are not read while the state has no fallout anywhere)
	local st0 = self._state
	local fallout = st0 == nil or (tonumber(st0.fallout_count) or 1) > 0
	local hover = self.hover
	local skins = (self :: any)._skins
	local st = self._state
	local alliances = if st ~= nil then st.alliances else nil
	if alliances ~= nil and next(alliances) == nil then
		alliances = nil
	end
	local tiles, tw, th, cols = self.tiles, self.tile_w, self.tile_h, self.cols
	for q = head, last do
		local i = queue[q]
		writeu8(queued, i, 0)
		local k = i * 4
		local o = readi32(own, k)
		local x = i % W
		local y = i // W
		if (fallout and band(readu8(flags, i), F_FALLOUT) ~= 0) or o >= MAX_OWNERS or (o > 0 and skins[o] ~= nil) then
			composite(self, i)
		elseif o <= 0 then
			writeu32(comp, k, readu32(terrain, k))
		else
			local nw = if x > 0 then readi32(own, k - 4) else -1
			local ne = if x < W - 1 then readi32(own, k + 4) else -1
			local nn = if i >= W then readi32(own, k - W4) else -1
			local ns = if i < N - W then readi32(own, k + W4) else -1
			local hl = o == hover
			local border = nw ~= o or ne ~= o or nn ~= o or ns ~= o
			if not border and hl then
				-- the hovered owner's border is a tile thicker (the diagonals; never off the map here)
				border = readi32(own, k - W4 - 4) ~= o
					or readi32(own, k - W4 + 4) ~= o
					or readi32(own, k + W4 - 4) ~= o
					or readi32(own, k + W4 + 4) ~= o
			end
			if border then
				local pal = if hl then pal_border_hi else pal_border
				if
					alliances ~= nil
					and (
						(nw > 0 and nw ~= o and alliances[math.min(o, nw) * 1024 + math.max(o, nw)] == true)
						or (ne > 0 and ne ~= o and alliances[math.min(o, ne) * 1024 + math.max(o, ne)] == true)
						or (nn > 0 and nn ~= o and alliances[math.min(o, nn) * 1024 + math.max(o, nn)] == true)
						or (ns > 0 and ns ~= o and alliances[math.min(o, ns) * 1024 + math.max(o, ns)] == true)
					)
				then
					pal = if hl then pal_border_ally_hi else pal_border_ally
				end
				-- (a border is opaque)
				writeu32(comp, k, readu32(pal, o * 4))
			else
				local over = readu32(if hl and hover_fill then pal_fill_hi else pal_fill, o * 4)
				local a = over // 16777216
				if a == 0 then
					writeu32(comp, k, readu32(terrain, k))
				elseif a == 255 then
					writeu32(comp, k, over)
				else
					local t = readu32(terrain, k)
					local f = a / 255
					local g = 1 - f
					local r = (t % 256) * g + (over % 256) * f
					local gg = ((t // 256) % 256) * g + ((over // 256) % 256) * f
					local b = ((t // 65536) % 256) * g + ((over // 65536) % 256) * f
					writeu32(
						comp,
						k,
						math.floor(r + 0.5) + math.floor(gg + 0.5) * 256 + math.floor(b + 0.5) * 65536 + 4278190080
					)
				end
			end
		end
		local t = tiles[(y // th) * cols + (x // tw) + 1]
		if t then
			t.bands[(y - t.y0) // BAND_ROWS + 1] = true
			t.dirty = true
		end
	end
end

local function grow_bbox(self: MapSurface, o: number, x: number, y: number)
	if o <= 0 then
		return
	end
	local b = self._bbox[o]
	if b == nil then
		self._bbox[o] = { x, y, x, y }
		return
	end
	if x < b[1] then
		b[1] = x
	end
	if x > b[3] then
		b[3] = x
	end
	if y < b[2] then
		b[2] = y
	end
	if y > b[4] then
		b[4] = y
	end
end

--- Repaint tile i and its 8 neighbours (border state and highlight thickening depend on them).
function MapSurface.paint_around(self: MapSurface, i: number)
	if self._own == nil or not self.ready then
		return
	end
	local W, H = self.W, self.H
	local x = i % W
	local y = i // W
	for dy = -1, 1 do
		local yy = y + dy
		if yy < 0 or yy >= H then
			continue
		end
		for dx = -1, 1 do
			local xx = x + dx
			if xx >= 0 and xx < W then
				composite(self, yy * W + xx)
				mark(self, xx, yy)
			end
		end
	end
end

--- GameState.tiles_changed: { tile * 1024 + owner } (new owners), and the owners those tiles had.
--- The tiles whose look may have changed are queued for step() to repaint, each once:
---   * the tile itself;
---   * a 4-neighbour of the old or the new owner (it gains or loses a border), or of an ally of
---     either (its border changes colour). A neighbour of anybody else was a border and still is,
---     and nobody's land has no overlay;
---   * a diagonal neighbour of the hovered owner (its border is thickened by one tile).
--- Without `olds`: the tile and its 8 neighbours.
function MapSurface.on_tiles_changed(self: MapSurface, changed: { number }, olds: { number }?)
	if self._own == nil or not self.ready then
		return
	end
	-- recorded here, looked at in step() within its time budget (_expand_changes; GameState reuses
	-- these lists, so they are copied)
	local pend = self._pend
	local n = self._pend_n
	for k, packed in changed do
		n += 1
		pend[n] = packed
		n += 1
		pend[n] = if olds ~= nil then olds[k] else -1
	end
	self._pend_n = n
end

--- GameState.flags_changed: { tile * 256 + flags }.
function MapSurface.on_flags_changed(self: MapSurface, changed: { number })
	if self._own == nil or not self.ready then
		return
	end
	local queue, queued = self._queue, self._queued
	local n = self._queue_n
	for _, packed in changed do
		local t = packed // 256
		if readu8(queued, t) == 0 then
			writeu8(queued, t, 1)
			n += 1
			queue[n] = t
		end
	end
	self._queue_n = n
end

--- Tiles waiting for a repaint (and one for every owner whose tiles are still being found).
function MapSurface.repaint_pending(self: MapSurface): number
	if self._pend_n > 0 then
		self:_expand_changes(math.huge) -- (what was recorded and not yet looked at)
	end
	return self._queue_n - self._queue_head + 1 + #self._sweeps
end

--- Redraw every tile (bind, palette-wide changes); sliced over frames by step().
function MapSurface.rebuild_all(self: MapSurface)
	self._rebuild_i = 0
	self._rebuild_active = self._own ~= nil and self.ready
	table.clear(self._bbox)
	self:_drop_changes() -- (every tile is about to be painted, and the boxes found again)
	-- (every tile is about to be painted: nothing needs to wait for it)
	if self._queue_n > 0 then
		buffer.fill(self._queued, 0, 0)
		table.clear(self._queue)
		self._queue_n, self._queue_head = 0, 1
	end
	table.clear(self._sweeps)
end

--- Repaint every tile of `owner` (a palette change for one owner): found a slice a frame and
--- repainted through the queue (step).
function MapSurface.repaint_owner(self: MapSurface, owner: number)
	self._pend_wide_to = self._pend_n
	self:_sweep(owner, true)
end

--- `owner`'s tiles are to be repainted: all of them (`fill`), or its border and the tiles next to it
--- (what a hover changes of an owner too big for a brightened fill).
function MapSurface._sweep(self: MapSurface, owner: number, fill: boolean)
	if owner <= 0 or self._own == nil or not self.ready or self._bbox[owner] == nil then
		return
	end
	for _, job in self._sweeps do
		if job.owner == owner and job.other == nil then
			-- (already being looked for: from the top again, with the wider of the two asks)
			job.fill = job.fill or fill
			job.y = -1
			return
		end
	end
	table.insert(self._sweeps, { owner = owner, fill = fill, y = -1 })
end

--- An alliance between `a` and `b` formed or ended: the border tiles of each where the two owners' boxes
--- overlap (those next to the other's have the alliance's green, paint_queue; the rest may have had it
--- when the alliance changed, run_sweeps). Two allies with no border between them repaint nothing.
---   * Until 2026-10-10 an alliance repainted every tile of both owners (repaint_owner).
function MapSurface.repaint_between(self: MapSurface, a: number, b: number)
	if a <= 0 or b <= 0 or a == b or self._own == nil or not self.ready then
		return
	end
	-- (the tile changes not yet looked at were made under the alliances before this one)
	self._pend_wide_to = self._pend_n
	if self._bbox[a] == nil or self._bbox[b] == nil then
		return
	end
	local lo, hi = math.min(a, b), math.max(a, b)
	for _, job in self._sweeps do
		if job.owner == lo and job.other == hi then
			job.y = -1
			return
		end
	end
	table.insert(self._sweeps, { owner = lo, fill = false, y = -1, other = hi })
end

local clock = os.clock

--- Looks at the changes on_tiles_changed recorded: each changed tile, and those of its neighbours whose
--- look the change may have altered, wait for a repaint (paint_queue). At least `min_pairs` changes,
--- then more until `deadline`. (Done in the call until 2026-10-12: a solo match's tick changes about
--- 2,000 tiles in its first minute, and this was 70% of applying the tick, 1.3 ms on a Mac and about
--- ten times that on a phone, in the frame the tick landed.)
--- Records already looked at (or tiles already repainted) are dropped once there are more than
--- COMPACT_MIN of them and they outnumber the ones still waiting. The lists were only emptied when a
--- step got through all of them, and a device that never quite caught up in a busy match kept every
--- change of the match until it ran out of memory ("not enough memory" in on_tiles_changed, 1,149 in a
--- day on v84, 2026-10-14). The waiting ones move to a new list, so the old one's memory is freed.
MapSurface.COMPACT_MIN = 32768

local function compact_pend(self: MapSurface)
	local p, n = self._pend_i, self._pend_n
	if p <= MapSurface.COMPACT_MIN or p - 1 < n - p + 1 then
		return
	end
	self._pend = table.move(self._pend, p, n, 1, table.create(n - p + 1))
	self._pend_n = n - p + 1
	self._pend_i = 1
	self._pend_wide_to = math.max(0, self._pend_wide_to - (p - 1))
end

local function compact_queue(self: MapSurface)
	local h, n = self._queue_head, self._queue_n
	if h <= MapSurface.COMPACT_MIN or h - 1 < n - h + 1 then
		return
	end
	self._queue = table.move(self._queue, h, n, 1, table.create(n - h + 1))
	self._queue_n = n - h + 1
	self._queue_head = 1
end

function MapSurface._expand_changes(self: MapSurface, deadline: number, min_pairs: number?)
	local own = self._own
	if own == nil or not self.ready then
		self:_drop_changes()
		return
	end
	local pend = self._pend
	local pend_n = self._pend_n
	local p = self._pend_i
	local must = p + 2 * (min_pairs or 0)
	local wide_to = self._pend_wide_to
	local W, H = self.W, self.H
	local queue, queued = self._queue, self._queued
	local n = self._queue_n
	local hover = self.hover
	local st = self._state
	local alliances = if st ~= nil then st.alliances else nil
	if alliances ~= nil and next(alliances) == nil then
		alliances = nil
	end
	while p < pend_n do
		if p >= must and (p // 2) % 256 == 0 and clock() >= deadline then
			break
		end
		local packed = pend[p]
		local a = pend[p + 1]
		local wide = p <= wide_to
		p += 2
		local t = packed // 1024
		local b = packed % 1024
		local x = t % W
		local y = t // W
		grow_bbox(self, b, x, y)
		if a < 0 then
			local x0, x1 = if x > 0 then x - 1 else x, if x < W - 1 then x + 1 else x
			for yy = if y > 0 then y - 1 else y, if y < H - 1 then y + 1 else y do
				local row = yy * W
				for i = row + x0, row + x1 do
					if readu8(queued, i) == 0 then
						writeu8(queued, i, 1)
						n += 1
						queue[n] = i
					end
				end
			end
			continue
		end
		if readu8(queued, t) == 0 then
			writeu8(queued, t, 1)
			n += 1
			queue[n] = t
		end
		if a == b then
			continue
		end
		for d = 1, 4 do
			local i
			if d == 1 then
				if x == 0 then
					continue
				end
				i = t - 1
			elseif d == 2 then
				if x == W - 1 then
					continue
				end
				i = t + 1
			elseif d == 3 then
				if y == 0 then
					continue
				end
				i = t - W
			else
				if y == H - 1 then
					continue
				end
				i = t + W
			end
			if readu8(queued, i) ~= 0 then
				continue
			end
			local c = readi32(own, i * 4)
			if c <= 0 then
				continue
			end
			local touched = c == a or c == b or wide
			if not touched and alliances ~= nil then
				touched = (a > 0 and alliances[math.min(a, c) * 1024 + math.max(a, c)] == true)
					or (b > 0 and alliances[math.min(b, c) * 1024 + math.max(b, c)] == true)
			end
			if touched then
				writeu8(queued, i, 1)
				n += 1
				queue[n] = i
			end
		end
		if hover > 0 then
			for dy = -1, 1, 2 do
				local yy = y + dy
				if yy >= 0 and yy < H then
					for dx = -1, 1, 2 do
						local xx = x + dx
						if xx >= 0 and xx < W then
							local i = yy * W + xx
							if readu8(queued, i) == 0 and readi32(own, i * 4) == hover then
								writeu8(queued, i, 1)
								n += 1
								queue[n] = i
							end
						end
					end
				end
			end
		end
	end
	self._queue_n = n
	if p >= pend_n then
		self:_drop_changes()
	else
		self._pend_i = p
		compact_pend(self)
	end
end

function MapSurface._drop_changes(self: MapSurface)
	table.clear(self._pend)
	self._pend_n, self._pend_i, self._pend_wide_to = 0, 1, 0
end

--- step(): looks at SWEEP_SCAN_PER_STEP tiles of the sweeps' boxes and queues the ones to repaint,
--- while the queue holds fewer than `room` tiles and until `deadline` (a row at least).
local function run_sweeps(self: MapSurface, room: number, deadline: number)
	local sweeps = self._sweeps
	local own = self._own :: buffer
	local W, H = self.W, self.H
	local queue, queued = self._queue, self._queued
	local n = self._queue_n
	local pending = n - self._queue_head + 1
	local scan = MapSurface.SWEEP_SCAN_PER_STEP
	local rows = 0
	while #sweeps > 0 and scan > 0 and pending < room and (rows == 0 or clock() < deadline) do
		local job = sweeps[1]
		local owner = job.owner
		local b = self._bbox[owner]
		local other = job.other
		local ob = if other ~= nil then self._bbox[other] else nil
		if b == nil or (other ~= nil and ob == nil) then
			table.remove(sweeps, 1)
			continue
		end
		local y0, y1 = math.max(b[2] - 1, 0), math.min(b[4] + 1, H - 1)
		local x0, x1 = math.max(b[1] - 1, 0), math.min(b[3] + 1, W - 1)
		if ob ~= nil then
			-- (a pair: where the two boxes, a tile wider each, overlap)
			y0, y1 = math.max(y0, ob[2] - 1), math.min(y1, ob[4] + 1)
			x0, x1 = math.max(x0, ob[1] - 1), math.min(x1, ob[3] + 1)
		end
		local y = math.max(job.y, y0)
		local fill = job.fill
		while y <= y1 and x0 <= x1 and scan > 0 and pending < room and (rows == 0 or clock() < deadline) do
			local row = y * W
			rows += 1
			if other ~= nil then
				-- a border tile of either (a 4-neighbour not its own). Until 2026-10-26 only the tiles
				-- next to the other's when the sweep got there: a neighbour that changed owner while
				-- the sweep waited (the other's when the alliance changed, somebody else's now) is
				-- looked at with the alliance already changed (_expand_changes: "was a border and still
				-- is"), so neither repainted the tile, and it kept the old alliance's border colour.
				for xx = x0, x1 do
					local t = row + xx
					local o = readi32(own, t * 4)
					if (o == owner or o == other) and readu8(queued, t) == 0 then
						if
							(xx > 0 and readi32(own, (t - 1) * 4) ~= o)
							or (xx < W - 1 and readi32(own, (t + 1) * 4) ~= o)
							or (y > 0 and readi32(own, (t - W) * 4) ~= o)
							or (y < H - 1 and readi32(own, (t + W) * 4) ~= o)
						then
							writeu8(queued, t, 1)
							n += 1
							queue[n] = t
							pending += 1
						end
					end
				end
			elseif fill then
				for xx = x0, x1 do
					local t = row + xx
					if readu8(queued, t) == 0 and readi32(own, t * 4) == owner then
						writeu8(queued, t, 1)
						n += 1
						queue[n] = t
						pending += 1
					end
				end
			else
				-- A border, or next to one (the hovered border is a tile thicker): a tile of the
				-- owner with a neighbour of the 8 that is somebody else's or off the map. Three reads
				-- a column: each row's last three tiles are three bits (1: the owner's), and the
				-- tile behind the column being read is inside when all nine are set.
				local up = if y > 0 then row - W else -1
				local dn = if y < H - 1 then row + W else -1
				local bu, bm, bd = 0, 0, 0
				for xx = math.max(x0 - 1, 0), math.min(x1 + 1, W - 1) + 1 do
					-- (one column past the last, as nobody's: the last tile is decided too)
					local inside = xx < W
					local mu = if inside and up >= 0 and readi32(own, (up + xx) * 4) == owner then 1 else 0
					local mm = if inside and readi32(own, (row + xx) * 4) == owner then 1 else 0
					local md = if inside and dn >= 0 and readi32(own, (dn + xx) * 4) == owner then 1 else 0
					bu = (bu * 2 + mu) % 8
					bm = (bm * 2 + mm) % 8
					bd = (bd * 2 + md) % 8
					-- the tile at column xx - 1: the owner's (bit 2 of its row), and not inside
					if bm % 4 >= 2 and not (bu == 7 and bm == 7 and bd == 7) then
						local t = row + xx - 1
						if xx - 1 >= x0 and xx - 1 <= x1 and readu8(queued, t) == 0 then
							writeu8(queued, t, 1)
							n += 1
							queue[n] = t
							pending += 1
						end
					end
				end
			end
			scan -= x1 - x0 + 1
			y += 1
		end
		job.y = y
		if y > y1 or x0 > x1 then
			table.remove(sweeps, 1)
		end
	end
	self._queue_n = n
end

--- Hovered owner (0 = none): the highlight (the border; the fill too for an owner of
--- HOVER_FILL_MAX tiles or fewer). Costs nothing here: the tiles are repainted by step().
function MapSurface.set_hover(self: MapSurface, owner: number)
	if owner == self.hover then
		return
	end
	local old, old_fill = self.hover, (self :: any)._hover_fill == true
	self.hover = owner
	local st = self._state
	local o = if st ~= nil and owner > 0 and st.owners ~= nil then st.owners[owner] else nil
	local fill = o ~= nil and (tonumber(o.tiles) or 0) <= MapSurface.HOVER_FILL_MAX;
	(self :: any)._hover_fill = fill
	if old > 0 then
		self:_sweep(old, old_fill)
	end
	if owner > 0 then
		self:_sweep(owner, fill)
	end
end

--- Mark every band of every image tile for upload.
function MapSurface.mark_all(self: MapSurface)
	for _, t in self.tiles do
		for k = 1, #t.bands do
			t.bands[k] = true
		end
		t.dirty = true
	end
end

--- Per-frame work: continue a full rebuild, repaint the tiles that wait for it (`budget_s`; at most
--- `repaint_tiles`, default REPAINT_TILES_PER_STEP), look for the sweeps' tiles in the time left, then
--- upload the dirty bands of ONE image tile (round-robin: Roblox shows one EditableImage update per
--- frame).
function MapSurface.step(self: MapSurface, budget_tiles: number?, repaint_tiles: number?)
	-- (whether this frame wrote an image: Map/FalloutGlow's waits for a frame that did not)
	self.uploaded = false
	if not self.ready then
		return
	end
	local own = self._own
	local W, N = self.W, self.N
	local repaint = repaint_tiles or MapSurface.REPAINT_TILES_PER_STEP
	local deadline = clock() + self.budget_s
	if self._pend_n > 0 then
		-- (a share whatever the clock says, so what waits never falls far behind)
		local waiting = (self._pend_n - self._pend_i + 1) // 2
		self:_expand_changes(
			deadline,
			math.max(math.ceil(waiting / MapSurface.DRAIN_FRAMES), MapSurface.EXPAND_MIN_CHANGES)
		)
	end
	local qn = self._queue_n
	if qn > 0 and own ~= nil then
		local head = self._queue_head
		local cap = math.min(qn, head + repaint - 1)
		-- (what waits gets its share whatever the clock says, so the picture never falls far behind)
		local share = math.max(math.ceil((qn - head + 1) / MapSurface.DRAIN_FRAMES), MapSurface.REPAINT_MIN_TILES)
		local last = math.min(cap, head + share - 1)
		paint_queue(self, head, last)
		while last < cap and clock() < deadline do
			local from = last + 1
			last = math.min(cap, last + MapSurface.REPAINT_CHUNK)
			paint_queue(self, from, last)
		end
		if last >= qn then
			table.clear(self._queue)
			self._queue_n, self._queue_head = 0, 1
		else
			self._queue_head = last + 1
			compact_queue(self)
		end
	end
	-- (what they find is painted from the next step on)
	if #self._sweeps > 0 and own ~= nil then
		run_sweeps(self, repaint, deadline)
	end
	if self._rebuild_active and own ~= nil then
		local i0 = self._rebuild_i
		local i1 = math.min(N, i0 + (budget_tiles or MapSurface.REBUILD_TILES_PER_STEP))
		for i = i0, i1 - 1 do
			local o = readi32(own, i * 4)
			if o > 0 then
				grow_bbox(self, o, i % W, i // W)
			end
			composite(self, i)
		end
		self._rebuild_i = i1
		if i1 >= N then
			self._rebuild_active = false
			self:mark_all()
		end
	end
	local n = #self.tiles
	for k = 1, n do
		local idx = (self._rr + k - 1) % n + 1
		local t = self.tiles[idx]
		if t.dirty and t.img ~= nil then
			self._rr = idx % n
			t.dirty = false
			local img = t.img :: EditableImage
			local row_bytes = t.w * 4
			for b = 1, #t.bands do
				if t.bands[b] then
					t.bands[b] = false
					local ly0 = (b - 1) * BAND_ROWS
					local rows = math.min(BAND_ROWS, t.h - ly0)
					local scratch = t.scratch
					if rows < BAND_ROWS then
						scratch = buffer.create(t.w * rows * 4)
					end
					for r = 0, rows - 1 do
						buffer.copy(scratch, r * row_bytes, self.comp, ((t.y0 + ly0 + r) * W + t.x0) * 4, row_bytes)
					end
					img:WritePixelsBuffer(Vector2.new(0, ly0), Vector2.new(t.w, rows), scratch)
				end
			end
			self.uploaded = true
			return
		end
	end
end

--- Show the bare terrain (title screen between worlds).
function MapSurface.clear(self: MapSurface)
	if not self.ready then
		return
	end
	buffer.copy(self.comp, 0, self.terrain, 0, self.N * 4)
	self:mark_all()
end

function MapSurface.destroy(self: MapSurface)
	self:_free_tiles()
	self.root:Destroy()
end

return MapSurface
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">MapView</string>
              <string name="Source"><![CDATA[--!strict
-- The 2D world view (a flat tile map), replacing the 3D globe WorldView with the same
-- public API (DESIGN.md §10), so UIRoot / Main / Session drive it unchanged:
--   signals tile_hovered(tile), tile_clicked(tile), tile_context(tile, screen_pos),
--   territory_status_changed(status); bind_state, set_attract_mode, focus_tile, focus_owner,
--   set_hover_owner, set_selected_owner, set_selected_unit, unit_at_screen, set_aim,
--   aim_sams, set_range_*, set_safe_area, set_hud_rects / controls, local_label_rect,
--   set_labels_visible, tile_at_screen, screen_pos_of_tile, camera_distance, project, update.
--
-- Rendering: three ScreenGuis under the HUD (DisplayOrder MAP_DISPLAY_ORDER and the two above it):
--   RofrontMap        Surface (MapSurface: terrain + territory images, pixel-crisp, wrapped
--                     east-west) and the Overlay with what seldom changes: spawn / aim markers,
--                     rails, ranges, structure plates;
--   RofrontMapUnits   what moves every frame: ships, trains, wakes, munitions, effects, and the
--                     structures' progress bars;
--   RofrontMapLabels  names and front numbers (they change with the troop counts).
-- Why three (2026-10-08; players on Windows had stutter bad enough to quit, ten minutes into a
-- match): Roblox lays out and draws a ScreenGui again as a whole
-- when anything in it changed, and nothing at all when nothing did. As one ScreenGui the map was
-- about 13,000 objects twenty minutes into a World match, all of them gone over every frame
-- because some ship had moved a pixel: 9 ms a frame on the Mac that measured it (with the match
-- paused: 0.2 ms). The moving layers are a small tree of their own now (docs/performance.md).
-- Input: MapInput (mouse / touch / keys) driving the MapCamera through the camera-rig API.
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RS = game:GetService("ReplicatedStorage")
local Core = RS:WaitForChild("Airfront"):WaitForChild("Core")
local Defs = require(Core:WaitForChild("Defs")) :: any
local Signal = require(Core:WaitForChild("Signal")) :: any
local Rules = require(Core:WaitForChild("Rules")) :: any

local MapCamera = require(script.Parent:WaitForChild("MapCamera"))
local MapSurface = require(script.Parent:WaitForChild("MapSurface"))

local N: number = Defs.TILE_COUNT

local MapView = {}
MapView.__index = MapView

MapView.RENDER_PRIORITY = Enum.RenderPriority.Camera.Value + 1
--- Seconds the pointer rests on a nation before the surface highlights it (its name and its range
--- rings follow at once). A highlight repaints the nation's border, and its land when it is small:
--- a pointer on its way across the map should start none (Map/MapSurface.HOVER_FILL_MAX).
MapView.HOVER_DELAY_S = 0.08
MapView.MAP_DISPLAY_ORDER = -10
--- focus_owner zooms in at most this far along the zoom range (0 = farthest, 1 = closest).
MapView.FOCUS_MAX_ZOOM = 0.3
--- Spawn-phase ring around the local player's placed spawn (breathing between SPAWN_MIN_RAD and
--- SPAWN_MAX_RAD full-size tiles). Nothing follows the cursor before the player picks a spot.
MapView.SPAWN_MIN_RAD = 10
MapView.SPAWN_MAX_RAD = 30

local function report(site: string, err: any)
	warn(string.format("[RoWorld] map view %s: %s", site, tostring(err)))
end

local _reported: { [string]: boolean } = {}
local function guard(site: string, fn: (...any) -> any, ...: any): (boolean, any)
	local ok, res = pcall(fn, ...)
	if not ok and not _reported[site] then
		_reported[site] = true
		report(site, res)
	end
	return ok, res
end

local function call(layer: any, method: string, ...: any): any
	if layer == nil then
		return nil
	end
	local f = layer[method]
	if type(f) ~= "function" then
		return nil
	end
	local ok, res = guard(method, f, layer, ...)
	return if ok then res else nil
end

local function optional(folder: Instance, name: string): any
	local m = folder:FindFirstChild(name)
	if m == nil or not m:IsA("ModuleScript") then
		return nil
	end
	local ok, mod = pcall(require, m)
	if not ok then
		report("require " .. name, mod)
		return nil
	end
	return mod
end

-- ---------------------------------------------------------------------------------------------
-- Map-space markers: spawn preview disk, aim disk / reticle
-- ---------------------------------------------------------------------------------------------

local function ring(parent: Instance, name: string, z: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.BackgroundTransparency = 0.75
	f.BorderSizePixel = 0
	f.ZIndex = z
	f.Visible = false
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
	local s = Instance.new("UIStroke")
	s.Color = Color3.new(1, 1, 1)
	s.Thickness = 2
	s.Transparency = 0.1
	s.Parent = f
	f.Parent = parent
	return f
end

export type MapView = typeof(setmetatable({} :: { [string]: any }, MapView))

function MapView.new(): MapView
	local self = setmetatable({}, MapView) :: any
	self.tile_hovered = Signal.new()
	self.tile_clicked = Signal.new()
	self.tile_context = Signal.new()
	self.territory_status_changed = Signal.new()
	self.input_enabled = true

	local gui = Instance.new("ScreenGui")
	gui.Name = "RofrontMap"
	gui.IgnoreGuiInset = true
	-- the whole screen, notch / home-bar areas included: the camera and input work in full-viewport
	-- px (Camera.ViewportSize), and the map is the backdrop (the default CoreUISafeInsets left dark
	-- bands on phones and shifted the map by the safe-area inset)
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.ResetOnSpawn = false
	gui.DisplayOrder = MapView.MAP_DISPLAY_ORDER
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	self.gui = gui
	-- the backdrop covers the whole screen (notch / home-bar areas too); the map draws in `canvas`,
	-- a frame whose origin is the camera viewport's (Camera.ViewportSize, the viewport px input
	-- and the UI use). On a notched phone the full screen starts ~47 px left of the viewport:
	-- drawing from the backdrop's origin put every tap ~47 px off (2026-09-28).
	local backdrop = Instance.new("Frame")
	backdrop.Name = "Backdrop"
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = Color3.fromRGB(0x3c, 0x3c, 0x3c)
	backdrop.BorderSizePixel = 0
	backdrop.ClipsDescendants = true
	backdrop.Parent = gui
	self.backdrop = backdrop
	local canvas = Instance.new("Frame")
	canvas.Name = "Canvas"
	canvas.BackgroundTransparency = 1
	canvas.Size = UDim2.fromScale(1, 1)
	canvas.Parent = backdrop
	self.canvas = canvas
	backdrop:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		self:_place_canvas()
	end)
	backdrop:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_place_canvas()
	end)

	self.rig = MapCamera.new(workspace.CurrentCamera)
	self.camera = self.rig
	self.surface = MapSurface.new(canvas)
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		-- (a phone or tablet: the same as Session's test for one)
		self.surface.budget_s = MapSurface.STEP_BUDGET_MOBILE_S
	end
	local overlay = Instance.new("Frame")
	overlay.Name = "Overlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundTransparency = 1
	overlay.ZIndex = 5
	overlay.Parent = canvas
	self.overlay = overlay
	-- the moving layers and the labels, each a ScreenGui of its own above the map's (see the header)
	self._canvases = { canvas }
	self._guis = { gui }
	local function layer_gui(name: string, order: number): Frame
		local g = Instance.new("ScreenGui")
		g.Name = name
		g.IgnoreGuiInset = true
		g.ScreenInsets = Enum.ScreenInsets.None
		g.ResetOnSpawn = false
		g.DisplayOrder = order
		g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		local hold = Instance.new("Frame")
		hold.Name = "Backdrop"
		hold.Size = UDim2.fromScale(1, 1)
		hold.BackgroundTransparency = 1
		hold.BorderSizePixel = 0
		hold.ClipsDescendants = true
		hold.Parent = g
		local c = Instance.new("Frame")
		c.Name = "Canvas"
		c.BackgroundTransparency = 1
		c.Size = UDim2.fromScale(1, 1)
		c.Parent = hold
		table.insert(self._canvases, c)
		table.insert(self._guis, g)
		return c
	end
	local moving = layer_gui("RofrontMapUnits", MapView.MAP_DISPLAY_ORDER + 1)
	local labels = layer_gui("RofrontMapLabels", MapView.MAP_DISPLAY_ORDER + 2)
	--- where a layer of the seldom-changing ScreenGui puts what it animates (StructureLayer's bars)
	self.moving_overlay = moving
	self._spawn_ring = ring(overlay, "SpawnPreview", 6)
	self._aim_ring = ring(overlay, "AimOuter", 7)
	self._aim_inner = ring(overlay, "AimInner", 8)
	--- marker frame -> whether it shows, and its UIStroke (kept here: markers_step runs every frame)
	self._marker_on = {} :: { [Frame]: boolean }
	self._marker_stroke = {} :: { [Frame]: UIStroke? }

	local MapInput = optional(script.Parent, "MapInput")
	self.input = if MapInput then MapInput.new(self, self.rig) else nil

	-- overlay layers drawn on the map (Map/<Name>Layer), each optional, in draw / update order
	self.layers = {} :: { [string]: any }
	self._layer_order = {} :: { string }
	self.view_rules = optional(script.Parent, "ViewRules")
	for _, spec in
		{
			{ "glow", "FalloutGlow", overlay },
			{ "roads", "RoadLayer", overlay },
			{ "ranges", "RangeLayer", overlay },
			{ "structures", "StructureLayer", overlay },
			{ "units", "UnitLayer", moving },
			{ "fx", "FxLayer", moving },
			{ "labels", "NameLayer", labels },
			{ "fronts", "FrontLayer", labels },
		}
	do
		local mod = optional(script.Parent, spec[2] :: string)
		if mod then
			local ok, layer = pcall(mod.new, spec[3], self)
			if ok then
				self:add_layer(spec[1] :: string, layer)
			else
				report((spec[2] :: string) .. ".new", layer)
			end
		end
	end

	self._state = nil :: any
	self._conns = {} :: { any }
	self._attract = false
	self._last_local = -1
	self._aim = nil :: any
	self._selected_unit = -1
	self._selected_owner = 0
	self._hover_owner = 0
	self._safe_area = Rect.new(0, 0, 0, 0)
	self._hud_rects = {} :: { Rect }
	self._hud_controls = {} :: { GuiObject }
	self._labels_visible = true
	self._perf = {} :: { [string]: number }
	self._status = { state = "loading", tier = "map", reason = "" }

	-- the 3D camera only has to show nothing behind the GUI
	local cam = workspace.CurrentCamera
	if cam then
		cam.CameraType = Enum.CameraType.Scriptable
		cam.CFrame = CFrame.new(0, 10000, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
	end

	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	for _, g in self._guis do
		g.Parent = pg
	end
	self:_place_canvas()

	self.tile_hovered:Connect(function(t: number)
		self:_on_tile_hovered(t)
	end)
	self._render_name = "RofrontMapView"
	local FrameClock = require(script.Parent:WaitForChild("FrameClock")) :: any
	RunService:BindToRenderStep(self._render_name, MapView.RENDER_PRIORITY, function(dt: number)
		guard("update", self.update, self, FrameClock.dt(dt))
	end)
	-- the map: terrain composited off the boot path (the default map until a state names another)
	self._map = nil :: any
	task.spawn(function()
		self:_show_map(require(Core:WaitForChild("WorldMap")).shared())
	end)
	return self
end

--- Show `map` (a WorldMap): camera bounds + surface terrain (slow: yields while it builds).
function MapView._show_map(self: any, map: any)
	if map == nil or map == self._map then
		return
	end
	self._map = map
	self.rig:set_map(map)
	local ok, err = pcall(function()
		self.surface:set_map(map)
	end)
	if not ok then
		report("map", err)
	end
	self:_set_status(if self.surface.ok then "ok" else "unavailable", if self.surface.ok then "" else "memory")
	if self._attract then
		self.rig:set_scale_immediate(self.rig:min_scale() * 2.2)
	end
end

function MapView._set_status(self: any, state: string, reason: string)
	if self._status.state == state and self._status.reason == reason then
		return
	end
	self._status = { state = state, tier = "map", reason = reason }
	self.territory_status_changed:Fire(self._status)
end

--- Add an overlay layer (module with new(parent, view)); kept in update / bind order.
function MapView.add_layer(self: any, name: string, layer: any)
	if layer == nil then
		return
	end
	self.layers[name] = layer
	self[name] = layer
	table.insert(self._layer_order, name)
end

-- ---------------------------------------------------------------------------------------------
-- State binding
-- ---------------------------------------------------------------------------------------------

function MapView._connect(self: any, sig: any, fn: (...any) -> ())
	if sig ~= nil and sig.Connect then
		table.insert(self._conns, sig:Connect(fn))
	end
end

function MapView.bind_state(self: any, state: any)
	self:unbind(state ~= nil)
	if state == nil then
		return
	end
	self._state = state
	if self.view_rules then
		self.view_rules.use(state.rules)
	end
	local surface = self.surface
	self:_connect(state.snapshot_loaded, function()
		surface:bind(state)
		call(self.layers.glow, "on_snapshot")
		if self.view_rules then
			self.view_rules.use(state.rules)
		end
	end)
	self:_connect(state.tiles_changed, function(ch, olds)
		surface:on_tiles_changed(ch, olds)
	end)
	self:_connect(state.flags_changed, function(ch)
		surface:on_flags_changed(ch)
		call(self.layers.glow, "on_flags_changed", ch)
	end)
	self:_connect(state.owner_added, function(id)
		surface:refresh_palette()
		-- (an owner that is sent again with land already on the map, in another colour: a slot that
		-- changed hands. Its tiles kept the old colour until each was next repainted. A new owner
		-- has no land yet and this does nothing.)
		surface:repaint_owner(id)
	end)
	self:_connect(state.cosmetics_changed, function(ids)
		surface:on_cosmetics_changed(ids)
		-- (the NameLayer is `labels`, not `names`; it reads the cosmetics as it draws and has no
		-- handler of its own yet, 2026-10-26)
		call(self.layers.labels, "on_cosmetics_changed", ids)
	end)
	self:_connect(state.alliance_changed, function(a, b, _formed, _traitor)
		surface:refresh_palette()
		surface:repaint_between(a, b)
	end)
	for _, pair in
		{
			{ "structure_added", "on_structure_added" },
			{ "structure_changed", "on_structure_changed" },
			{ "structure_removed", "on_structure_removed" },
			{ "structure_leveled", "on_structure_leveled" },
		}
	do
		self:_connect(state[pair[1]], function(...)
			for _, name in self._layer_order do
				call(self.layers[name], pair[2], ...)
			end
		end)
	end
	self:_connect(state.alliance_changed, function()
		call(self.layers.ranges, "mark_dirty")
	end)
	self:_connect(state.road_added, function(rid)
		call(self.layers.roads, "mark_road_dirty", rid)
	end)
	self:_connect(state.road_removed, function(rid)
		call(self.layers.roads, "mark_road_dirty", rid)
	end)
	self:_connect(state.nuke_detonated, function(uid, kind, tile, radius, _owner)
		self:_on_nuke_detonated(uid, kind, tile, radius)
	end)
	self:_connect(state.unit_removed, function(uid, reason)
		self:_on_unit_removed(uid, reason)
	end)
	self:_connect(state.conquest, function(by, victim, gold)
		self:_on_conquest(by, victim, gold)
	end)
	-- only the local player's income shows
	self:_connect(state.bonus, function(owner, tile, gold)
		if owner ~= 0 and owner == state.local_owner then
			call(self.layers.fx, "bonus", tile, gold)
		end
	end)
	surface:bind(state)
	if state.map ~= nil and state.map ~= self._map then
		task.spawn(function()
			self:_show_map(state.map)
		end)
	end
	for _, name in self._layer_order do
		call(self.layers[name], "bind", state)
	end
	self._last_local = state.local_owner or 0
end

function MapView.unbind(self: any, _rebinding: boolean?)
	for _, c in self._conns do
		c:Disconnect()
	end
	table.clear(self._conns)
	if self._state == nil then
		return
	end
	self._state = nil
	self.surface:unbind()
	for _, name in self._layer_order do
		call(self.layers[name], "unbind")
	end
	self:set_aim("", -1, 0)
	call(self.input, "set_hover_tile", -1)
end

function MapView.set_attract_mode(self: any, on: boolean)
	self._attract = on
	self.rig.attract = on
	if on then
		call(self.input, "reset")
		self.rig:halt()
		self.rig:set_scale_immediate(self.rig:min_scale() * 2.2)
	end
end

function MapView.is_attract(self: any): boolean
	return self._attract
end

function MapView.territory_status(self: any): { [string]: any }
	return self._status
end

function MapView.set_input_enabled(self: any, on: boolean)
	if self.input_enabled == on then
		return
	end
	self.input_enabled = on
	call(self.input, if on then "enable" else "disable")
end

function MapView.touch_owned_by_world(self: any, io: any): boolean
	if self.input == nil then
		return false
	end
	return self.input:touch_owned_by_world(io)
end

-- ---------------------------------------------------------------------------------------------
-- Camera
-- ---------------------------------------------------------------------------------------------

--- Fly to `tile`; `distance` is the globe camera's (1 + altitude, < 0 keeps the zoom).
function MapView.focus_tile(self: any, tile: number, distance: number?, duration: number?)
	if tile < 0 or tile >= N then
		return
	end
	local d = distance or -1.0
	local s = if d > 0 then self.rig:distance_to_scale(d) else -1.0
	self.rig:focus_tile(tile, s, duration or 1.0)
end

function MapView.focus_owner(self: any, owner_id: number)
	local st = self._state
	if st == nil then
		return
	end
	local tile = st:label_tile(owner_id)
	if tile < 0 then
		return
	end
	local o = st:get_owner(owner_id)
	local tiles = if o ~= nil then o.tiles else 50.0
	-- frame the nation: its rough diameter takes about a sixth of the view height, never closer
	-- than FOCUS_MAX_ZOOM of the zoom range (a new nation is only a few tiles across)
	local diam = 2.0 * math.sqrt(math.max(tiles, 1.0) / math.pi)
	local rig = self.rig
	local s = rig:viewport_height() / math.max(diam * 6.0, 8.0)
	local lo, hi = rig:min_scale(), rig:max_scale()
	s = math.min(s, lo + (hi - lo) * MapView.FOCUS_MAX_ZOOM)
	rig:focus_tile(tile, rig:clamp_scale(s), 1.0)
end

--- Globe camera distance equivalent of the current zoom (1 + altitude).
function MapView.camera_distance(self: any): number
	return self.rig:scale_to_distance(self.rig.scale)
end

function MapView.tile_at_screen(self: any, pos: Vector2): number
	return self.rig:tile_at_screen(pos)
end

function MapView.screen_pos_of_tile(self: any, tile: number): Vector2
	if tile < 0 or tile >= N then
		return Vector2.new(-1, -1)
	end
	local x, y = self.rig:tile_to_screen(tile)
	return Vector2.new(x, y)
end

--- Legacy world position (unit direction, or studs on the R = 100 globe) -> viewport px, and
--- whether it is on screen.
function MapView.project(self: any, p: Vector3): (Vector2, boolean)
	local x, y = self.rig:xyz_to_screen(p.X, p.Y, p.Z)
	return Vector2.new(x, y), self.rig:on_screen(x, y, 0)
end

--- The part of the viewport (px) not covered by HUD panels: the view anchor sits in its middle.
function MapView.set_safe_area(self: any, rect: Rect)
	self._safe_area = rect
	local labels = self.layers.labels
	if labels then
		labels.safe_rect = rect
		labels.layout_dirty = true
	end
	self:_update_screen_offset()
end

--- Lines the drawing frame up with the camera viewport inside the full-screen backdrop.
function MapView._place_canvas(self: any)
	local GuiService = game:GetService("GuiService")
	local origin = self.backdrop.AbsolutePosition + GuiService:GetGuiInset() -- viewport px
	local vp = self.rig:viewport_size()
	-- (every ScreenGui of the map is the same full screen: one origin serves them all)
	for _, c in self._canvases do
		c.Position = UDim2.fromOffset(-origin.X, -origin.Y)
		c.Size = UDim2.fromOffset(vp.X, vp.Y)
	end
end

function MapView._update_screen_offset(self: any)
	local sa = self._safe_area
	local sz = self.rig:viewport_size()
	if sa == nil or sa.Width <= 1.0 or sa.Height <= 1.0 then
		self.rig.screen_offset = Vector2.zero
		return
	end
	local c = (sa.Min + sa.Max) * 0.5
	self.rig.screen_offset = c - sz * 0.5
end

function MapView.set_hud_rects(self: any, rects: { Rect })
	self._hud_rects = table.clone(rects or {})
	self:_update_obstacles()
end

function MapView.set_hud_controls(self: any, controls: { any })
	local list = {}
	for _, c in controls or {} do
		if typeof(c) == "Instance" and c:IsA("GuiObject") then
			table.insert(list, c)
		elseif type(c) == "table" and typeof(c.gui) == "Instance" then
			table.insert(list, c.gui)
		end
	end
	self._hud_controls = list
	self:_update_obstacles()
end

function MapView._update_obstacles(self: any)
	local labels = self.layers.labels
	if labels == nil then
		return
	end
	labels.obstacles = table.clone(self._hud_rects)
	labels.obstacle_controls = self._hud_controls
	labels.layout_dirty = true
end

function MapView.local_label_rect(self: any): Rect?
	return call(self.layers.labels, "local_label_rect")
end

function MapView.set_labels_visible(self: any, on: boolean)
	self._labels_visible = on
	call(self.layers.labels, "set_visible", on)
end

-- ---------------------------------------------------------------------------------------------
-- Highlights, selection, previews
-- ---------------------------------------------------------------------------------------------

function MapView.set_hover_owner(self: any, id: number)
	self._hover_owner = id
	-- (the surface's highlight waits HOVER_DELAY_S for the pointer to rest: update())
	self:_want_surface_hover(if id > 0 then id else self._selected_owner, MapView.HOVER_DELAY_S)
	local labels = self.layers.labels
	if labels then
		labels.hover_owner = id
	end
	call(self.layers.ranges, "set_hover_owner", id)
end

function MapView.set_selected_owner(self: any, id: number)
	self._selected_owner = id
	if self._hover_owner <= 0 then
		self:_want_surface_hover(id, 0)
	end
end

--- The owner the surface is to highlight, once `delay_s` have passed without another being asked
--- for: a pointer crossing nations on its way somewhere highlights none of them.
function MapView._want_surface_hover(self: any, id: number, delay_s: number)
	if self._surface_hover_want == id then
		return
	end
	self._surface_hover_want = id
	self._surface_hover_at = os.clock() + delay_s
end

function MapView.set_selected_unit(self: any, uid: number)
	if uid <= 0 then
		uid = -1
	end
	self._selected_unit = uid
	call(self.layers.units, "set_selected", uid)
	if uid < 0 then
		call(self.layers.ranges, "clear_unit_rings")
	end
end

function MapView.unit_at_screen(self: any, screen_pos: Vector2, radius_px: number?): number
	local r = radius_px or -1.0
	if r < 0.0 then
		r = if UserInputService.TouchEnabled then 28.0 else 16.0
	end
	local v = call(self.layers.units, "unit_at_screen", screen_pos, r)
	return if type(v) == "number" then v else -1
end

--- Aim preview: kind "nuke" / "boat" / "build" / "" (clear); see WorldView.set_aim.
function MapView.set_aim(
	self: any,
	kind: string,
	tile: number,
	radius_tiles: number,
	valid: boolean?,
	detail: string?,
	level: number?
)
	if kind == "" or tile < 0 or tile >= N then
		self._aim = nil
		call(self.layers.ranges, "set_aim", "", -1, "")
		return
	end
	local inner = -1.0
	local outer = radius_tiles
	local d = detail or ""
	local ViewRules = optional(script.Parent, "ViewRules")
	if kind == "nuke" and ViewRules then
		local nk = Defs.nuke_kind_from_name(d)
		if nk < 0 then
			nk = ViewRules.nuke_kind_for_radius(radius_tiles)
		end
		if nk >= 0 then
			local ri, ro = ViewRules.nuke_radii(nk)
			if ro > 0 then
				inner, outer = ri, ro
			end
			d = Defs.NUKE_NAMES[nk] or d
		end
	end
	self._aim = { kind = kind, tile = tile, inner = inner, outer = math.max(outer, 0.5), valid = valid ~= false }
	call(self.layers.ranges, "set_aim", kind, tile, d, level or 1)
end

function MapView.aim_sams(self: any): number
	local v = call(self.layers.ranges, "aim_sams")
	return if type(v) == "number" then v else 0
end

function MapView.set_range_mode(self: any, mode: string)
	call(self.layers.ranges, "set_mode", mode)
end

function MapView.set_range_owner(self: any, owner_id: number)
	call(self.layers.ranges, "set_range_owner", owner_id)
end

function MapView.set_range_focus(self: any, tile: number)
	call(self.layers.ranges, "set_focus_tile", tile, 14.0 * 1.4 / self.rig.scale)
end

function MapView._on_tile_hovered(self: any, tile: number)
	call(self.layers.ranges, "set_hover_tile", tile, 14.0 / self.rig.scale)
end

function MapView._on_nuke_detonated(self: any, uid: number, kind: number, tile: number, radius: number)
	local fx = self.layers.fx
	if fx == nil then
		return
	end
	if radius == 0 then
		-- intercepted: an airburst where the nuke was
		local st = self._state
		local n = st and st.nukes[uid]
		local units = self.layers.units
		if n and units then
			local t = math.clamp(((st.render_tick or st.tick) - n.launch_tick) / math.max(n.flight_ticks, 1), 0, 1)
			local u, v = units.nuke_uv(st, n, t)
			local W = st.map.W or Defs.W
			call(fx, "pop", math.floor(v) * W + math.floor(u), Color3.new(1, 0.85, 0.5))
			call(fx, "burst", "sam", u, v)
			return
		end
		call(fx, "pop", tile)
		local W = if st ~= nil then st.map.W or Defs.W else Defs.W
		call(fx, "burst", "sam", tile % W + 0.5, tile // W + 0.5)
		return
	end
	call(fx, "nuke", kind, tile, radius)
end

--- Game admins: which "players" are bot players (owner id → true); nil hides the HUMAN badges.
function MapView.set_admin_bots(self: any, bots: { [number]: boolean }?)
	local labels = self.layers.labels
	if labels ~= nil then
		labels.admin_bots = bots
	end
end

--- The UI's BorderTracker (the local player's border tiles) for the front troop labels.
function MapView.set_borders(self: any, tracker: any)
	call(self.layers.fronts, "set_borders", tracker)
end

--- Only the local player's conquests show, at the conquered name's location.
function MapView._on_conquest(self: any, by: number, victim: number, gold: number)
	local st = self._state
	if st == nil or by ~= st.local_owner or by == 0 then
		return
	end
	local loc = call(self.layers.labels, "name_location", victim)
	if loc == nil then
		local o = st:get_owner(victim)
		local t = if o ~= nil then o.spawn_tile else -1
		if t < 0 then
			return
		end
		local W = st.map.W or Defs.W
		loc = { t % W + 0.5, t // W + 0.5 }
	end
	call(self.layers.fx, "conquest", loc[1], loc[2], gold)
end

function MapView._on_unit_removed(self: any, uid: number, reason: number)
	local st = self._state
	if reason == Defs.DEL_DESTROYED and st ~= nil then
		local u = st.units[uid]
		local units = self.layers.units
		if u ~= nil and units ~= nil and u.path and #u.path > 0 then
			local x, y = units.unit_uv(st, u, st.render_tick or st.tick)
			local W = st.map.W or Defs.W
			call(self.layers.fx, "pop", math.floor(y) * W + math.floor(x))
		end
	end
	if uid == self._selected_unit then
		self:set_selected_unit(-1)
	end
end

--- The selected warship's patrol / targeting rings follow it (plain numbers: every frame a warship
--- is selected, 2026-10-26).
function MapView._update_selected_rings(self: any)
	local st = self._state
	local VR = self.view_rules
	local units = self.layers.units
	if self._selected_unit < 0 or st == nil or VR == nil or units == nil then
		return
	end
	local u = st.units[self._selected_unit]
	if u == nil then
		self:set_selected_unit(-1)
		return
	end
	local W = st.map.W or Defs.W
	local patrol = if u.patrol_tile ~= nil and u.patrol_tile >= 0
		then u.patrol_tile
		elseif u.path and #u.path > 0 then u.path[1]
		else -1
	local x, y = units.unit_uv(st, u, st.render_tick or st.tick)
	call(
		self.layers.ranges,
		"set_unit_rings",
		if patrol >= 0 then patrol % W + 0.5 else 0.0,
		if patrol >= 0 then patrol // W + 0.5 else 0.0,
		if patrol >= 0 then VR.warship_patrol_range() else 0.0,
		x,
		y,
		VR.warship_target_range(),
		st:owner_color(u.owner)
	)
end

-- ---------------------------------------------------------------------------------------------
-- Frame
-- ---------------------------------------------------------------------------------------------

local WHITE = Color3.new(1, 1, 1)
local AIM_COVERED = Color3.new(1.0, 0.16, 0.12)
local AIM_NUKE = Color3.new(1.0, 0.84, 0.46)
local AIM_BOAT = Color3.new(0.55, 0.85, 1.0)
local AIM_INVALID = Color3.new(0.6, 0.6, 0.6)

--- A marker shown or hidden, its Visible written only when that changes (all three were written
--- hidden every frame of every match, 2026-10-26).
local function show_marker(self: any, f: Frame, on: boolean)
	if self._marker_on[f] ~= on then
		self._marker_on[f] = on
		f.Visible = on
	end
end

local function place_disk(self: any, f: Frame, tile: number, radius_tiles: number, col: Color3, fill_t: number)
	local x, y = self.rig:tile_to_screen(tile)
	local d = math.max(radius_tiles * 2.0 * self.rig.scale, 6.0)
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(d, d)
	f.BackgroundColor3 = col
	f.BackgroundTransparency = fill_t
	local s = self._marker_stroke[f]
	if s == nil then
		s = f:FindFirstChildOfClass("UIStroke")
		self._marker_stroke[f] = s
	end
	if s then
		s.Color = col
	end
	show_marker(self, f, true)
end

local function markers_step(self: any, now: number)
	local st = self._state
	local spawn = -1
	if st ~= nil and st.phase == Defs.PHASE_SPAWN and st.local_owner ~= 0 then
		local me = st:get_owner(st.local_owner)
		spawn = if me ~= nil then me.spawn_tile else -1
	end
	if spawn >= 0 then
		-- a ring breathing between SPAWN_MIN_RAD and SPAWN_MAX_RAD
		-- (full-size tiles) around the local spawn, at a phase speed of 0.008 per ms
		local col = WHITE
		if st.local_owner ~= 0 then
			col = st:owner_color(st.local_owner):Lerp(WHITE, 0.35)
		end
		local k = tonumber(st.map and st.map.k_lin) or Rules.K_LIN
		local b = 0.5 + 0.5 * math.sin(now * 8.0)
		local r = (MapView.SPAWN_MIN_RAD + (MapView.SPAWN_MAX_RAD - MapView.SPAWN_MIN_RAD) * b) / k
		place_disk(self, self._spawn_ring, spawn, r, col, 0.9)
	else
		show_marker(self, self._spawn_ring, false)
	end
	local aim = self._aim
	if aim ~= nil then
		local col = WHITE
		if aim.kind == "nuke" then
			col = if self:aim_sams() > 0 then AIM_COVERED else AIM_NUKE
		elseif aim.kind == "boat" then
			col = AIM_BOAT
		end
		if not aim.valid then
			col = AIM_INVALID
		end
		place_disk(self, self._aim_ring, aim.tile, aim.outer, col, 0.8)
		if aim.inner > 0 then
			place_disk(self, self._aim_inner, aim.tile, aim.inner, col, 0.7)
		else
			show_marker(self, self._aim_inner, false)
		end
	else
		show_marker(self, self._aim_ring, false)
		show_marker(self, self._aim_inner, false)
	end
end

local function local_owner_step(self: any, st: any)
	if st.local_owner ~= self._last_local then
		self._last_local = st.local_owner
		self.surface:refresh_palette()
	end
end

local clock = os.clock

function MapView.update(self: any, dt: number)
	local t0 = clock()
	local vp0 = self.rig:viewport_size()
	self.rig:tick(dt)
	if self.rig:viewport_size() ~= vp0 then
		self:_update_screen_offset()
		self:_place_canvas()
	end
	local st = self._state
	if st ~= nil then
		guard("local_owner", local_owner_step, self, st)
	end
	local t1 = clock()
	local want = self._surface_hover_want
	if want ~= nil and t1 >= (self._surface_hover_at or 0) then
		self._surface_hover_want = nil
		guard("surface.set_hover", self.surface.set_hover, self.surface, want)
	end
	guard("surface.step", self.surface.step, self.surface)
	guard("surface.layout", self.surface.layout, self.surface, self.rig)
	local t2 = clock()
	guard("markers", markers_step, self, t0)
	guard("selected_rings", self._update_selected_rings, self)
	self:_perf_add("markers", clock() - t2)
	for _, name in self._layer_order do
		local lt = clock()
		call(self.layers[name], "tick", dt)
		self:_perf_add(name, clock() - lt)
	end
	local t3 = clock()
	call(self.input, "tick", dt)
	local t4 = clock()
	-- (with the layers', markers and input, every part of the frame's map time has a key)
	self:_perf_add("input", t4 - t3)
	self:_perf_add("camera", t1 - t0)
	self:_perf_add("territory", t2 - t1)
	self:_perf_add("total", t4 - t0)
end

function MapView._perf_add(self: any, key: string, sec: number)
	local prev = self._perf[key]
	self._perf[key] = if prev == nil then sec else prev + (sec - prev) * 0.05
end

function MapView.perf_stats(self: any): { [string]: any }
	local out = {}
	for k, v in self._perf do
		out[k] = v * 1000.0
	end
	return out
end

function MapView.request_trim(_self: any, _hard: boolean, _delay_s: number?) end

function MapView.pool_stats(_self: any): { [string]: any }
	return {}
end

function MapView.destroy(self: any)
	self:unbind()
	RunService:UnbindFromRenderStep(self._render_name)
	for _, name in self._layer_order do
		call(self.layers[name], "destroy")
	end
	call(self.input, "destroy")
	self.surface:destroy()
	for _, g in self._guis do
		g:Destroy()
	end
end

return MapView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">NameLayer</string>
              <string name="Source"><![CDATA[--!native
-- Owner names + troop counts on the 2D map:
--   * placement (_place): the bounding box of the owner's main
--     cluster, a grid at a coarse scaling factor (1..32 by the box size) where a cell is usable if
--     it is the owner's tile, a shoreline tile, ocean with magnitude < 10 or fallout; the largest
--     inscribed rectangle of that grid; the name sits at its centre, raised by fontSize / 3, with
--     fontSize = min(rect.width / name length * 2, rect.height / 3). Recomputed every 30 ticks
--     (REPLACE_TICKS) and at once for new owners; spawn-phase names use an 8-tile box on the spawn;
--   * sizing: baseSize = max(1, floor(size)), nameSize = max(4, floor(baseSize *
--     0.4)), nameScale = min(baseSize * 0.25, 3); the name line is nameSize * nameScale full-size
--     tiles tall, the troop line 0.6 of it; names shorter on screen than the cull threshold hide
--     (hovered ones never do). Positions / sizes glide to new targets (LERP_SPEED 10);
--   * style: fill black for humans, 0.3 grey nations, 0.4 grey tribes
--     (SHADE_*); outline in the owner's colour, width 1.4.
-- Sizes are in full-size tiles; our tiles are map.k_lin full-size tiles wide.
-- Roblox: one pooled Frame per owner (name + troops TextLabels with UIStroke); TextSize caps at
-- 100 px, beyond that a UIScale enlarges the whole plate.
local RS = game:GetService("ReplicatedStorage")
local Core = RS:WaitForChild("Airfront"):WaitForChild("Core")
local Defs = require(Core:WaitForChild("Defs")) :: any
local Rules = require(Core:WaitForChild("Rules")) :: any
local NumberFormat = require(Core:WaitForChild("NumberFormat")) :: any
local Sprites = require(RS:WaitForChild("Airfront"):WaitForChild("Assets"):WaitForChild("MapSprites")) :: any
local Cosmetics = require(RS:WaitForChild("Airfront"):WaitForChild("Data"):WaitForChild("Cosmetics")) :: any
local Coop = require(RS:WaitForChild("Airfront"):WaitForChild("Net"):WaitForChild("Coop")) :: any
local FrameClock = require(script.Parent:WaitForChild("FrameClock")) :: any

local readi32 = buffer.readi32
local readu8 = buffer.readu8

local NameLayer = {}
NameLayer.__index = NameLayer

NameLayer.FONT = Font.fromId(12187365977, Enum.FontWeight.Bold)
NameLayer.NAME_SCALE_FACTOR = 0.4
NameLayer.NAME_SCALE_CAP = 3.0
NameLayer.TROOP_SIZE_MULT = 0.6
NameLayer.LERP_SPEED = 10.0
--- A name whose line is shorter than this share of the view width hides (CULL_MIN_PX px at least).
NameLayer.CULL_VW = 0.004
NameLayer.CULL_MIN_PX = 6.0
NameLayer.SHADE_NATION = 0.3
NameLayer.SHADE_BOT = 0.4
NameLayer.OUTLINE_K = 0.085 -- outline px per text px
NameLayer.REPLACE_TICKS = 30
NameLayer.SPAWN_DIAMETER = 8 -- full-size tiles
--- Placement work per frame (s). The placements run in a Coop job, so one owner's can go over several
--- frames too (its flood fill and its grid stop at Coop.check()).
---   * Until 2026-10-10 the budget was looked at between owners only. A nation's placement flood-fills
---     its whole cluster: 5 ms on a Mac for one holding a third of World, many times that on a phone,
---     which runs this without native code, every REPLACE_TICKS. "Slow Frames" after v74: "Script -
---     Labels" was 13% of the slow matches, most of them phones, minutes 5 to 9.
NameLayer.BUDGET_S = 0.0015
--- Tiles a flood fill takes between two looks at the clock (Coop.check).
NameLayer.FILL_CHECK = 2048
--- Text line height / TextSize for Rubik.
NameLayer.LINE_K = 1.0
--- The local player's name line is at most this share of the view's height (OWN_MAX_MIN_PX at least);
--- its head, flag, troops and crown follow it. Every other name is sized by its land, and a
--- player holding a big share of the map had a name, a head and a flag across their own front (far
--- too big for their own nametag, and annoying to play behind, 2026-10-10).
NameLayer.OWN_MAX_VH = 0.04
NameLayer.OWN_MAX_MIN_PX = 18.0
NameLayer.CROWN_MIN_PX = 16

type Plate = {
	frame: Frame,
	scaler: UIScale,
	name: TextLabel,
	troops: TextLabel,
	flag: ImageLabel,
	flag_id: string,
	name_stroke: UIStroke,
	troop_stroke: UIStroke,
	-- glide state (map tiles for x / y, the font size for s)
	sx: number,
	sy: number,
	ss: number,
	tx: number,
	ty: number,
	ts: number,
	t0: number,
	-- last written
	text: string,
	troop_text: string,
	px: number,
	shown: boolean,
	rect: { number },
}

function NameLayer.new(parent: Instance, view: any)
	local self = setmetatable({}, NameLayer) :: any
	local root = Instance.new("Frame")
	root.Name = "Names"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = 20
	root.Parent = parent
	self.root = root
	self.view = view
	self.visible = true
	self.hover_owner = 0
	self.safe_rect = nil
	self.obstacles = {}
	self.layout_dirty = true
	self._state = nil :: any
	self._plates = {} :: { [number]: Plate }
	self._villages = {}
	--- owner -> { x, y (map tiles, name centre), size (the name's font size) }
	self._targets = {} :: { [number]: { number } }
	self._queue = {} :: { number }
	--- the Coop job placing _queue's owners (nil: none running)
	self._job = nil :: any
	self._last_place_tick = -1000
	--- game admins only (Session.admin_bots): owner id → true for bot players; nil for everyone else
	self.admin_bots = nil :: { [number]: boolean }?
	--- The crown: over the name of the alive owner with the most land
	self.crown_owner = 0
	self._crown_t = 0.0
	local crown = Instance.new("ImageLabel")
	crown.Name = "Crown"
	crown.BackgroundTransparency = 1
	crown.AnchorPoint = Vector2.new(0.5, 0)
	crown.Image = Sprites.status.id
	local st = Sprites.status
	crown.ImageRectOffset = Vector2.new(st.pad, st.pad) -- cell 0 = crown
	crown.ImageRectSize = Vector2.new(st.cell - 2 * st.pad, st.cell - 2 * st.pad)
	crown.ScaleType = Enum.ScaleType.Fit
	crown.ZIndex = 21
	crown.Visible = false
	crown.Parent = root
	self._crown = crown
	self._visit = buffer.create(0)
	self._visit_gen = 0
	return self
end

function NameLayer.bind(self: any, state: any)
	self:unbind()
	self._state = state
	self._last_place_tick = -1000
	for i, village in state.map.nations do
		if village.region == nil then
			continue
		end
		local label = Instance.new("TextLabel")
		label.Name = village.name
		label.AnchorPoint = Vector2.new(0.5, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamMedium
		label.Text = village.name .. "\n" .. village.region
		label.TextColor3 = Color3.fromRGB(255, 234, 185)
		label.TextStrokeColor3 = Color3.fromRGB(20, 22, 28)
		label.TextStrokeTransparency = 0.15
		label.TextSize = 11
		label.Size = UDim2.fromOffset(160, 30)
		label.ZIndex = 19
		label.Visible = false
		label.Parent = self.root
		table.insert(self._villages, { label = label, tile = village.tile, major = i <= 5 })
	end
end

function NameLayer.unbind(self: any)
	self._state = nil
	for _, marker in self._villages do
		marker.label:Destroy()
	end
	table.clear(self._villages)
	for _, p in self._plates do
		p.frame:Destroy()
	end
	table.clear(self._plates)
	table.clear(self._targets)
	table.clear(self._queue)
	self._job = nil
	self.crown_owner = 0
	self._crown.Visible = false
end

function NameLayer.set_visible(self: any, on: boolean)
	self.visible = on
	self.root.Visible = on
end

function NameLayer.destroy(self: any)
	self:unbind()
	self.root:Destroy()
end

-- ---------------------------------------------------------------------------------------------
-- Placement
-- ---------------------------------------------------------------------------------------------

local function k_lin(map: any): number
	return tonumber(map and map.k_lin) or Rules.K_LIN
end

--- Largest rectangle in a histogram (heights[1..n]): x (0-based), width, height.
local function largest_in_histogram(h: { number }, n: number): (number, number, number)
	local stack = {}
	local top = 0
	local best, bx, bw, bh = 0, 0, 0, 0
	for i = 0, n do
		local cur = if i == n then 0 else h[i + 1]
		while top > 0 and cur < h[stack[top] + 1] do
			local height = h[stack[top] + 1]
			top -= 1
			local width = if top == 0 then i else i - stack[top] - 1
			if height * width > best then
				best = height * width
				bx = if top == 0 then 0 else stack[top] + 1
				bw, bh = width, height
			end
		end
		top += 1
		stack[top] = i
	end
	return bx, bw, bh
end

--- Bounding box of the owner's cluster containing `seed` (4-connected flood fill). Inside the placement
--- job it may pause (Coop.check) while the map changes: the box is then of the tiles it went through.
--- (Another fill in between, a new owner's at once, takes the next generation: this one may go through
--- some of its tiles again, once each.)
function NameLayer._cluster_box(self: any, st: any, id: number, seed: number): (number, number, number, number)
	local map = st.map
	local W, H = map.W or Defs.W, map.H or Defs.H
	local N = W * H
	if buffer.len(self._visit) ~= N * 4 then
		self._visit = buffer.create(N * 4)
		self._visit_gen = 0
	end
	self._visit_gen += 1
	local gen = self._visit_gen
	local visit = self._visit
	local own = st.owner
	local stack = { seed }
	buffer.writeu32(visit, seed * 4, gen)
	local x0, y0, x1, y1 = seed % W, seed // W, seed % W, seed // W
	local n = 1
	local check = NameLayer.FILL_CHECK
	local left = check
	while n > 0 do
		left -= 1
		if left <= 0 then
			left = check
			Coop.check()
		end
		local i = stack[n]
		stack[n] = nil
		n -= 1
		local x = i % W
		local y = i // W
		if x < x0 then
			x0 = x
		elseif x > x1 then
			x1 = x
		end
		if y < y0 then
			y0 = y
		elseif y > y1 then
			y1 = y
		end
		if x > 0 and buffer.readu32(visit, (i - 1) * 4) ~= gen and readi32(own, (i - 1) * 4) == id then
			buffer.writeu32(visit, (i - 1) * 4, gen)
			n += 1
			stack[n] = i - 1
		end
		if x < W - 1 and buffer.readu32(visit, (i + 1) * 4) ~= gen and readi32(own, (i + 1) * 4) == id then
			buffer.writeu32(visit, (i + 1) * 4, gen)
			n += 1
			stack[n] = i + 1
		end
		if y > 0 and buffer.readu32(visit, (i - W) * 4) ~= gen and readi32(own, (i - W) * 4) == id then
			buffer.writeu32(visit, (i - W) * 4, gen)
			n += 1
			stack[n] = i - W
		end
		if y < H - 1 and buffer.readu32(visit, (i + W) * 4) ~= gen and readi32(own, (i + W) * 4) == id then
			buffer.writeu32(visit, (i + W) * 4, gen)
			n += 1
			stack[n] = i + W
		end
	end
	return x0, y0, x1, y1
end

local function font_size(width: number, height: number, name: string): number
	return math.min(width / math.max(#name, 1) * 2, height / 3)
end

--- Placement: target { x, y, size } in map tiles / font size, or nil.
function NameLayer._place(self: any, st: any, id: number): { number }?
	local o = st:get_owner(id)
	if o == nil or (o.tiles or 0) <= 0 then
		return nil
	end
	local seed = st:label_tile(id)
	if seed < 0 then
		return nil
	end
	local map = st.map
	local W = map.W or Defs.W
	local k = k_lin(map)
	local tile_bytes: buffer? = self.view.surface and self.view.surface.tile_bytes or nil
	local own = st.owner
	local flags = st.flags
	local x0, y0, x1, y1 = self:_cluster_box(st, id, seed)
	-- box size in full-size tiles picks the grid scaling factor (in full-size tiles, then ours)
	local size_of = math.min(x1 - x0, y1 - y0) * k
	local sf_of = if size_of < 25
		then 1
		elseif size_of < 50 then 2
		elseif size_of < 100 then 4
		elseif size_of < 250 then 8
		elseif size_of < 500 then 16
		else 32
	local sf = math.max(1, math.floor(sf_of / k + 0.5))
	local gx0, gy0 = x0 // sf, y0 // sf
	local gw, gh = x1 // sf - gx0 + 1, y1 // sf - gy0 + 1
	local heights = table.create(gw, 0)
	local best, bx, by, bw, bh = 0, 0, 0, 0, 0
	for gy = 0, gh - 1 do
		local ty = (gy0 + gy) * sf
		for gx = 0, gw - 1 do
			local tx = (gx0 + gx) * sf
			local t = ty * W + tx
			local usable = readi32(own, t * 4) == id
			if not usable then
				if tile_bytes then
					local b = readu8(tile_bytes, t)
					usable = bit32.band(b, 64) ~= 0 or (b < 128 and bit32.band(b, 32) ~= 0 and bit32.band(b, 31) < 10)
				end
				usable = usable or bit32.band(readu8(flags, t), Defs.F_FALLOUT) ~= 0
			end
			heights[gx + 1] = if usable then heights[gx + 1] + 1 else 0
		end
		local rx, rw, rh = largest_in_histogram(heights, gw)
		if rw * rh > best then
			best = rw * rh
			bx, by, bw, bh = rx, gy - rh + 1, rw, rh
		end
		Coop.check()
	end
	local rx = bx * sf
	local ry = by * sf
	local rw = bw * sf
	local rh = bh * sf
	local cx = math.floor(rx + rw / 2 + gx0 * sf)
	local cy = math.floor(ry + rh / 2 + gy0 * sf)
	local fs = font_size(rw * k, rh * k, o.name or "")
	return { cx + 0.5, cy + 0.5 - fs / 3 / k, fs }
end

--- Spawn-phase placement: an 8-tile box on the spawn tile.
function NameLayer._place_spawn(_self: any, st: any, id: number): { number }?
	local o = st:get_owner(id)
	if o == nil or (o.spawn_tile or -1) < 0 then
		return nil
	end
	local W = st.map.W or Defs.W
	local k = k_lin(st.map)
	local d = NameLayer.SPAWN_DIAMETER
	local fs = font_size(d, d, o.name or "")
	local t = o.spawn_tile
	return { t % W + 0.5, t // W + 0.5 - fs / 3 / k, fs }
end

function NameLayer._refresh_queue(self: any, st: any)
	table.clear(self._queue)
	for id, o in st.owners do
		if (o.tiles or 0) > 0 then
			table.insert(self._queue, id)
		end
	end
end

function NameLayer._placement_step(self: any, st: any)
	local tick = st.tick or 0
	local spawn = st.phase == Defs.PHASE_SPAWN
	if tick - self._last_place_tick >= NameLayer.REPLACE_TICKS or tick < self._last_place_tick then
		self._last_place_tick = tick
		self:_refresh_queue(st)
	end
	-- new owners get a target at once
	for id, o in st.owners do
		if (o.tiles or 0) > 0 and self._targets[id] == nil then
			local t = if spawn then self:_place_spawn(st, id) else self:_place(st, id)
			if t then
				self._targets[id] = t
			end
		end
	end
	local q = self._queue
	if self._job == nil then
		if #q == 0 then
			return
		end
		self._job = Coop.job(function()
			while #q > 0 and self._state == st do
				local id = table.remove(q)
				local t = if st.phase == Defs.PHASE_SPAWN then self:_place_spawn(st, id) else self:_place(st, id)
				if self._state == st then
					self._targets[id] = t
				end
			end
		end)
	end
	local job = self._job
	if job:step(NameLayer.BUDGET_S) then
		self._job = nil
		if not job.ok then
			error(job.err, 0)
		end
	end
end

-- ---------------------------------------------------------------------------------------------
-- Drawing
-- ---------------------------------------------------------------------------------------------

local function new_text(parent: Instance, name: string, z: number): (TextLabel, UIStroke)
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.FontFace = NameLayer.FONT
	l.TextXAlignment = Enum.TextXAlignment.Center
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.AnchorPoint = Vector2.new(0.5, 0)
	l.AutomaticSize = Enum.AutomaticSize.XY
	l.Size = UDim2.fromOffset(0, 0)
	l.ZIndex = z
	l.Parent = parent
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = l
	return l, s
end

function NameLayer._plate(self: any, id: number): Plate
	local p = self._plates[id]
	if p then
		return p
	end
	local f = Instance.new("Frame")
	f.Name = "Owner" .. id
	f.BackgroundTransparency = 1
	f.AnchorPoint = Vector2.new(0.5, 0)
	f.Size = UDim2.fromOffset(0, 0)
	f.AutomaticSize = Enum.AutomaticSize.XY
	f.ZIndex = 20
	f.Visible = false
	local scaler = Instance.new("UIScale")
	scaler.Parent = f
	local lay = Instance.new("UIListLayout")
	lay.FillDirection = Enum.FillDirection.Vertical
	lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Padding = UDim.new(0, 0)
	lay.Parent = f
	-- admins: a small HUMAN badge over real players' names
	local badge, bs = new_text(f, "Human", 21)
	badge.LayoutOrder = 0
	badge.Text = "HUMAN"
	badge.TextColor3 = Color3.fromRGB(94, 214, 255)
	bs.Color = Color3.new(0, 0, 0)
	badge.Visible = false
	-- the name line: [flag] [head] name (the flag only when the owner has one equipped, Data/Cosmetics;
	-- a person's Roblox head shot; the flag sits left of it, 2026-10-22)
	local line = Instance.new("Frame")
	line.Name = "Line"
	line.BackgroundTransparency = 1
	line.Size = UDim2.fromOffset(0, 0)
	line.AutomaticSize = Enum.AutomaticSize.XY
	line.LayoutOrder = 1
	line.ZIndex = 21
	line.Parent = f
	local ll = Instance.new("UIListLayout")
	ll.FillDirection = Enum.FillDirection.Horizontal
	ll.VerticalAlignment = Enum.VerticalAlignment.Center
	ll.SortOrder = Enum.SortOrder.LayoutOrder
	ll.Padding = UDim.new(0, 3)
	ll.Parent = line
	local face = Instance.new("ImageLabel")
	face.Name = "Face"
	face.BackgroundColor3 = Color3.fromRGB(40, 52, 82)
	face.BorderSizePixel = 0
	face.LayoutOrder = 0
	face.ZIndex = 21
	face.Visible = false
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(0.5, 0)
	fc.Parent = face
	local fs = Instance.new("UIStroke")
	fs.Color = Color3.new(0, 0, 0)
	fs.Transparency = 0.4
	fs.Thickness = 1
	fs.Parent = face
	face.Parent = line
	local flag = Instance.new("ImageLabel")
	flag.Name = "Flag"
	flag.BackgroundTransparency = 1
	flag.ScaleType = Enum.ScaleType.Fit
	flag.LayoutOrder = -1
	flag.ZIndex = 21
	flag.Visible = false
	flag.Parent = line
	local name, ns = new_text(line, "Name", 21)
	name.LayoutOrder = 1
	local troops, ts = new_text(f, "Troops", 21)
	troops.LayoutOrder = 2
	f.Parent = self.root
	p = {
		frame = f,
		scaler = scaler,
		name = name,
		troops = troops,
		flag = flag,
		flag_id = "",
		face = face,
		face_id = 0,
		badge = badge,
		badge_stroke = bs,
		human = false,
		name_stroke = ns,
		troop_stroke = ts,
		sx = 0,
		sy = 0,
		ss = 0,
		tx = 0,
		ty = 0,
		ts = 0,
		t0 = -1,
		text = "",
		troop_text = "",
		px = -1,
		shown = false,
		rect = { 0, 0, 0, 0 },
	}
	self._plates[id] = p
	return p
end

local function shade_of(kind: number): number
	if kind == Defs.KIND_NATION then
		return NameLayer.SHADE_NATION
	elseif kind == Defs.KIND_TRIBE then
		return NameLayer.SHADE_BOT
	end
	return 0.0
end

--- The crown goes to the alive owner (any kind) with the most tiles; ties to the lower id.
function NameLayer.crown_of(st: any): number
	local best, bt = 0, 0
	for id, o in st.owners do
		local t = o.tiles or 0
		if o.alive and t > 0 and (t > bt or (t == bt and id < best)) then
			best, bt = id, t
		end
	end
	return best
end

function NameLayer.tick(self: any, dt: number)
	local st = self._state
	if st == nil or not self.visible then
		self._crown.Visible = false
		return
	end
	self._crown_t -= dt
	if self._crown_t <= 0 then
		self._crown_t = 0.25
		self.crown_owner = NameLayer.crown_of(st)
	end
	local crown_shown = false
	self:_placement_step(st)
	local cam = self.view.rig
	for _, marker in self._villages do
		local x, y = cam:tile_to_screen(marker.tile)
		marker.label.Visible = cam:on_screen(x, y, 0) and (marker.major or cam.scale >= 0.9)
		if marker.label.Visible then
			marker.label.Position = UDim2.fromOffset(math.round(x), math.round(y + 12))
		end
	end
	local k = k_lin(st.map)
	local now = FrameClock.now()
	local cull_px = math.max(NameLayer.CULL_MIN_PX, NameLayer.CULL_VW * cam._vp.X)
	-- (reused every frame: late games draw dozens of plates 60 times a second)
	local seen = self._seen
	if seen == nil then
		seen = {}
		self._seen = seen
	else
		table.clear(seen)
	end
	for id, t in self._targets do
		local o = st:get_owner(id)
		if o == nil or (o.tiles or 0) <= 0 then
			continue
		end
		seen[id] = true
		local p = self:_plate(id)
		if p.t0 < 0 then
			p.sx, p.sy, p.ss = t[1], t[2], t[3]
			p.tx, p.ty, p.ts = t[1], t[2], t[3]
			p.t0 = now
		elseif t[1] ~= p.tx or t[2] ~= p.ty or t[3] ~= p.ts then
			-- restart the glide from where the plate is now
			local a = math.min(1 - math.exp(-NameLayer.LERP_SPEED * (now - p.t0)), 1)
			p.sx, p.sy, p.ss = p.sx + (p.tx - p.sx) * a, p.sy + (p.ty - p.sy) * a, p.ss + (p.ts - p.ss) * a
			p.tx, p.ty, p.ts = t[1], t[2], t[3]
			p.t0 = now
		end
		local a = math.min(1 - math.exp(-NameLayer.LERP_SPEED * (now - p.t0)), 1)
		local wx = p.sx + (p.tx - p.sx) * a
		local wy = p.sy + (p.ty - p.sy) * a
		local ws = p.ss + (p.ts - p.ss) * a
		local base = math.max(1, math.floor(ws))
		local name_size = math.max(4, math.floor(base * NameLayer.NAME_SCALE_FACTOR))
		local name_scale = math.min(base * 0.25, NameLayer.NAME_SCALE_CAP)
		local line_px = name_size * name_scale / k * cam.scale * NameLayer.LINE_K
		if id == st.local_owner then
			line_px = math.min(line_px, math.max(NameLayer.OWN_MAX_MIN_PX, cam._vp.Y * NameLayer.OWN_MAX_VH))
		end
		local hovered = id == self.hover_owner
		local sx, sy = cam:map_to_screen(wx, wy)
		local vis = (line_px >= cull_px or hovered) and cam:on_screen(sx, sy, line_px * 4)
		if not vis then
			if p.shown then
				p.frame.Visible = false
				p.shown = false
			end
			continue
		end
		if not p.shown then
			p.frame.Visible = true
			p.shown = true
		end
		-- text + style
		local text = o.name or ""
		if p.text ~= text then
			p.text = text
			p.name.Text = text
			p.size_dirty = 3
			local shade = shade_of(o.kind)
			local c = Color3.new(shade, shade, shade)
			p.name.TextColor3 = c
			p.troops.TextColor3 = c
			local col = st:owner_color(id)
			p.name_stroke.Color = col
			p.troop_stroke.Color = col
		end
		-- a person's head shot and the owner's flag (Data/Cosmetics), left of the name
		local cz = st.cosmetics and st.cosmetics[id]
		local face_id = if cz ~= nil and cz.face ~= nil then cz.face else 0
		if face_id ~= p.face_id then
			p.face_id = face_id
			p.face.Image = if face_id > 0 then Cosmetics.face_image(face_id) else ""
			p.face.Visible = face_id > 0
			p.px = -1 -- size the head with the name
			p.size_dirty = 3
		end
		local fid = if cz ~= nil and cz.flag ~= nil then cz.flag else ""
		if fid ~= p.flag_id then
			p.flag_id = fid
			local it = if fid ~= "" then Cosmetics.item(fid) else nil
			if it ~= nil and it.kind == "flag" then
				p.flag.Image = Cosmetics.flag_image(it)
				p.flag.ImageRectOffset = Vector2.new(it.x, it.y)
				p.flag.ImageRectSize = Vector2.new(it.w, it.h)
				p.flag.Visible = true
			else
				p.flag.Visible = false
			end
			p.px = -1 -- size the flag with the name
			p.size_dirty = 3
		end
		local bots = self.admin_bots
		local human = bots ~= nil and o.kind == Defs.KIND_HUMAN and not bots[id] and id ~= st.local_owner
		if human ~= p.human then
			p.human = human
			p.badge.Visible = human
			p.px = -1 -- resize the badge with the plate
		end
		local troops = o.troops or 0
		if p.troop_n ~= troops then
			p.troop_n = troops
			local tt = NumberFormat.render_troops(troops)
			if p.troop_text ~= tt then
				p.troop_text = tt
				p.troops.Text = tt
				p.size_dirty = 3
			end
		end
		-- size: TextSize caps at 100, a UIScale takes the rest
		local px = math.floor(line_px * 2 + 0.5) / 2
		if px ~= p.px then
			p.px = px
			p.size_dirty = 3
			local ts = math.min(px, 100)
			local sc = px / ts
			p.name.TextSize = ts
			p.troops.TextSize = math.max(1, ts * NameLayer.TROOP_SIZE_MULT)
			if p.flag.Visible then
				-- a flag about as tall as the capitals, its own aspect kept (Fit)
				local fh = math.max(4, math.round(ts * 0.78))
				p.flag.Size = UDim2.fromOffset(math.round(fh * 1.5), fh)
			end
			if p.face.Visible then
				-- a head about as tall as the name's line
				local hh = math.max(6, math.round(ts * 1.05))
				p.face.Size = UDim2.fromOffset(hh, hh)
			end
			p.scaler.Scale = sc
			local stroke = math.max(1, ts * NameLayer.OUTLINE_K)
			p.name_stroke.Thickness = stroke
			p.troop_stroke.Thickness = math.max(1, stroke * NameLayer.TROOP_SIZE_MULT)
			if p.human then
				-- readable even on a tiny nation: at least 9 px on screen
				local bsz = math.max(ts * 0.42, 9 / sc)
				p.badge.TextSize = bsz
				p.badge_stroke.Thickness = math.max(1, bsz * 0.12)
			end
		end
		-- (wx, wy) is the name line's centre: the plate hangs from the top of the name line
		local top = math.round(sy - px * 0.5)
		local pos = UDim2.fromOffset(math.round(sx), top)
		if p.frame.Position ~= pos then
			p.frame.Position = pos
		end
		-- (AbsoluteSize can force a GUI layout pass: read it only for a few frames after the text or
		-- size changed — the layout may settle a frame late)
		if p.abs == nil or (p.size_dirty or 0) > 0 then
			p.size_dirty = math.max(0, (p.size_dirty or 1) - 1)
			p.abs = p.frame.AbsoluteSize
		end
		local sz = p.abs
		local r = p.rect
		r[1], r[2], r[3], r[4] = sx - sz.X * 0.5, top, sx + sz.X * 0.5, top + sz.Y
		local z = if hovered then 22 else 20
		if p.z ~= z then
			p.z = z
			p.frame.ZIndex = z
		end
		if id == self.crown_owner then
			-- status row: an icon 1.1 name lines tall whose top sits 1.4 lines above the name's
			-- centre (the admin HUMAN badge, when shown, sits between)
			-- (at least CROWN_MIN_PX so the leader stays easy to spot on a phone)
			local icon = math.max(line_px * 1.1, NameLayer.CROWN_MIN_PX)
			local lift = if p.human then p.badge.TextSize * p.scaler.Scale else 0.0
			self._crown.Size = UDim2.fromOffset(icon, icon)
			self._crown.Position = UDim2.fromOffset(math.round(sx), math.round(sy - line_px * 1.4 - lift))
			crown_shown = true
		end
	end
	if self._crown.Visible ~= crown_shown then
		self._crown.Visible = crown_shown
	end
	for id, p in self._plates do
		if not seen[id] then
			p.frame:Destroy()
			self._plates[id] = nil
			self._targets[id] = nil
		end
	end
end

--- Map-tile centre { u, v } of `id`'s name, or nil before it has one.
function NameLayer.name_location(self: any, id: number): { number }?
	local t = self._targets[id]
	if t == nil then
		return nil
	end
	return { t[1], t[2] }
end

--- Viewport rect of the local player's plate (coach tips keep clear of it), or nil.
function NameLayer.local_label_rect(self: any): Rect?
	local st = self._state
	if st == nil then
		return nil
	end
	local p = self._plates[st.local_owner or 0]
	if p == nil or not p.shown then
		return nil
	end
	local r = p.rect
	return Rect.new(r[1], r[2], r[3], r[4])
end

return NameLayer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">RangeLayer</string>
              <string name="Source"><![CDATA[--!native
-- Range rings on the 2D map: SAM interception coverage and defense-post protection radius, the
-- prospective ring while placing one, and the selected warship's patrol / targeting rings. The
-- choice of rings is the globe RangeLayer's (View/RangeLayer.luau _rebuild), drawn as flat GUI
-- circles (UIStroke keeps widths pixel-constant) with a faint fill:
--   mode "auto" (default): own SAMs / posts faint, fading out as the view pulls back; while aiming
--   a nuke the hostile SAMs within NEAR_AIM x their range of the aim tile (red-tinted) and those
--   covering it (hot: thicker, pulsing; aim_sams() counts them); boat aim / "attack_aim": the
--   target owner's posts; hovered / focused sites; the build preview ring (+ own rings of that
--   kind at full strength). "nuke_aim", "all", "none" as in the globe layer.
-- (2026-10-26, phones' slow frames: a ring remembers what it was last given and is written only what
-- changed, where every ring on screen was written eight properties a frame; the rings are chosen
-- again only when what they show changes: not for a missile fired, and while a SAM's range grows
-- after an upgrade only that ring's radius follows it, a game tick at a time.)
local RS = game:GetService("ReplicatedStorage")
local Airfront = RS:WaitForChild("Airfront")
local Defs = require(Airfront:WaitForChild("Core"):WaitForChild("Defs")) :: any

local RangeLayer = {}
RangeLayer.__index = RangeLayer

RangeLayer.NEAR_AIM = 2.0
RangeLayer.MAX_RINGS = 300
RangeLayer.Z = 8

local C_OWN_SAM, C_OWN_DEF, C_OWN_HI, C_HOSTILE, C_HOT, C_FOCUS, C_BUILD, C_ALL, C_PENDING = 0, 1, 2, 3, 4, 5, 6, 7, 8
-- per class (index cls + 1): stroke alpha, stroke width (px), fill alpha, pulses
local RING_A = { 0.62, 0.55, 0.92, 0.62, 1.0, 0.95, 1.0, 0.6, 0.7 }
local WIDTH = { 1.5, 1.5, 2.0, 2.0, 3.0, 2.2, 2.6, 1.5, 1.6 }
local FILL_A = { 0.045, 0.04, 0.075, 0.03, 0.055, 0.085, 0.2, 0.03, 0.0 }
local PULSE = { false, false, false, false, true, false, true, false, false }
-- own idle rings fade out between these globe-equivalent camera distances
local OWN_SAM_FADE = { 1.9, 2.5 }
local OWN_DEF_FADE = { 1.42, 1.72 }

--- Structure kinds with a ring: SAMs, defense posts, and the Arsenal's Artillery (its range) and
--- Airfields (their reach, shown while an air strike is aimed or an airfield is placed).
local RINGED = {
	[Defs.S_SAM] = true,
	[Defs.S_DEFENSE] = true,
	[Defs.S_ARTILLERY] = true,
	[Defs.S_AIRFIELD] = true,
}

local HOSTILE_TINT = Color3.new(1.0, 0.2, 0.16)
local WHITE = Color3.new(1, 1, 1)
local HOT_COLOR = HOSTILE_TINT:Lerp(Color3.new(1.0, 0.45, 0.35), 0.25)
--- a site without levels yet (read only)
local NO_LVL = { 1, 0, -100000 }

--- A ring and what its frame and stroke were last given (Roblox's own values, kept here: a ring
--- shown for another site still shows them, so nothing needs resetting).
type Ring = {
	frame: Frame,
	stroke: UIStroke,
	vis: boolean,
	x: number,
	y: number,
	d: number,
	col: Color3?,
	fill_t: number,
	stroke_col: Color3?,
	width: number,
	stroke_t: number,
}
--- A ring to draw: map tile, radius (tiles), class, colour; `sid` a SAM's, `grows` while its range
--- grows after an upgrade (kept from one choice to the next: rewritten, not made again).
type Want = { tile: number, r: number, cls: number, col: Color3, sid: number, grows: boolean }

function RangeLayer.new(parent: Instance, view: any)
	local self = setmetatable({}, RangeLayer) :: any
	local root = Instance.new("Frame")
	root.Name = "Ranges"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = RangeLayer.Z
	root.Parent = parent
	self.root = root
	self.view = view
	self.VR = view.view_rules
	self.mode = "auto"
	self._state = nil :: any
	self._sites = {} :: { [number]: { number } } -- sid -> { kind, owner, tile }
	self._lvl = {} :: { [number]: { number } } -- sid -> { level, active_tick, upgrade_tick }
	self._hot = {} :: { [number]: boolean }
	self._hot_n = 0
	self._aim_kind = ""
	self._aim_tile = -1
	self._aim_detail = ""
	self._aim_level = 1
	self._range_owner = 0
	self._hover_owner = 0
	self._hover_focus = -1
	self._ui_focus = -1
	--- the rings to draw: the first _want_n of _want
	self._want = {} :: { Want }
	self._want_n = 0
	self._dirty = true
	self._next_change = math.huge
	--- the game tick the growing SAM rings' radii are for (nil: none grows)
	self._grow_tick = nil :: number?
	self._last_local = -1
	self._rings = {} :: { Ring }
	self._unit = nil :: any
	--- (the selected warship's rings, rewritten every frame it is selected)
	self._unit_rings = {} :: { [string]: any }
	self._now = 0.0
	return self
end

function RangeLayer.bind(self: any, state: any)
	self._state = state
	self:reload()
end

function RangeLayer.unbind(self: any)
	self._state = nil
	table.clear(self._sites)
	table.clear(self._lvl)
	table.clear(self._hot)
	self._hot_n = 0
	self._hover_focus = -1
	self._ui_focus = -1
	table.clear(self._want)
	self._want_n = 0
	self._grow_tick = nil
	self._unit = nil
	for _, r in self._rings do
		if r.vis then
			r.vis = false
			r.frame.Visible = false
		end
	end
end

function RangeLayer.destroy(self: any)
	self:unbind()
	self.root:Destroy()
end

function RangeLayer.reload(self: any)
	table.clear(self._sites)
	table.clear(self._lvl)
	if self._state ~= nil then
		for _, s in self._state.structures do
			if RINGED[s.kind] then
				self._sites[s.sid] = { s.kind, s.owner, s.tile }
				self._lvl[s.sid] = { s.level, s.active_tick, -100000 }
			end
		end
	end
	self._dirty = true
end

function RangeLayer.on_structure_added(self: any, sid: number)
	local s = if self._state ~= nil then self._state.structures[sid] else nil
	if s ~= nil and RINGED[s.kind] then
		self._sites[sid] = { s.kind, s.owner, s.tile }
		if self._lvl[sid] == nil then
			self._lvl[sid] = { s.level, s.active_tick, -100000 }
		end
		self._dirty = true
	end
end

function RangeLayer.on_structure_leveled(self: any, sid: number)
	local s = if self._state ~= nil then self._state.structures[sid] else nil
	if s == nil or self._sites[sid] == nil then
		return
	end
	local was = self._lvl[sid]
	if was ~= nil and was[1] == s.level and was[2] == s.active_tick then
		-- a missile fired or reloaded (Ev.STRUCT_SHOTS comes as structure_leveled too): the range is
		-- as it was, and choosing every ring again for each shot of a late game's SAM wall cost the most
		return
	end
	local old = was or { s.level, s.active_tick, -100000 }
	local up = old[3]
	if s.level > old[1] then
		up = self._state.tick
	end
	self._lvl[sid] = { s.level, s.active_tick, up }
	self._dirty = true
end

function RangeLayer.on_structure_changed(self: any, sid: number)
	self:on_structure_added(sid)
end

function RangeLayer.on_structure_removed(self: any, sid: number)
	self._lvl[sid] = nil
	if self._sites[sid] ~= nil then
		self._sites[sid] = nil
		self._dirty = true
	end
end

function RangeLayer.mark_dirty(self: any)
	self._dirty = true
end

function RangeLayer.set_mode(self: any, m: string)
	if m ~= self.mode then
		self.mode = m
		self._dirty = true
	end
end

function RangeLayer.set_aim(self: any, kind: string, tile: number, detail: string, level: number?): number
	local lv = math.max(level or 1, 1)
	if kind ~= self._aim_kind or tile ~= self._aim_tile or detail ~= self._aim_detail or lv ~= self._aim_level then
		self._aim_kind, self._aim_tile, self._aim_detail, self._aim_level = kind, tile, detail or "", lv
		self._dirty = true
		self:_update_hot()
	end
	return self._hot_n
end

function RangeLayer.aim_sams(self: any): number
	return self._hot_n
end

function RangeLayer.set_range_owner(self: any, id: number)
	if id ~= self._range_owner then
		self._range_owner = id
		self._dirty = true
	end
end

function RangeLayer.set_hover_owner(self: any, id: number)
	if id ~= self._hover_owner then
		self._hover_owner = id
		if self.mode == "attack_aim" and self._range_owner == 0 then
			self._dirty = true
		end
	end
end

function RangeLayer.set_hover_tile(self: any, tile: number, px_tiles: number)
	local f = self:_sites_near(tile, px_tiles)
	if f ~= self._hover_focus then
		self._hover_focus = f
		self._dirty = true
	end
end

function RangeLayer.set_focus_tile(self: any, tile: number, px_tiles: number)
	local f = self:_sites_near(tile, px_tiles)
	if f ~= self._ui_focus then
		self._ui_focus = f
		self._dirty = true
	end
end

--- Selected warship: patrol ring around map point (pu, pv) and targeting ring around (au, av), radii
--- in tiles, `col` its owner's colour. (Called every frame a warship is selected: plain numbers and
--- one table kept, the tints worked out when the colour changes.)
function RangeLayer.set_unit_rings(
	self: any,
	pu: number,
	pv: number,
	patrol_r: number,
	au: number,
	av: number,
	target_r: number,
	col: Color3
)
	local ur = self._unit_rings
	ur.pu, ur.pv, ur.patrol_r = pu, pv, patrol_r
	ur.au, ur.av, ur.target_r = au, av, target_r
	if ur.col ~= col then
		ur.col = col
		ur.patrol_col = col:Lerp(WHITE, 0.4)
		ur.target_col = col:Lerp(WHITE, 0.3)
	end
	self._unit = ur
end

function RangeLayer.clear_unit_rings(self: any)
	self._unit = nil
end

-- ---------------------------------------------------------------------------------------------
-- Rules
-- ---------------------------------------------------------------------------------------------

function RangeLayer._build_kind(self: any): number
	local ak, det = self._aim_kind, self._aim_detail
	if ak == "build" or string.sub(ak, 1, 6) == "build:" then
		local k = if det ~= "" then det else string.sub(ak, 7)
		if k == "sam" then
			return Defs.S_SAM
		elseif k == "defense" then
			return Defs.S_DEFENSE
		elseif k == "factory" then
			return Defs.S_FACTORY
		elseif k == "artillery" then
			return Defs.S_ARTILLERY
		elseif k == "airfield" then
			return Defs.S_AIRFIELD
		end
	elseif ak == "sam" then
		return Defs.S_SAM
	elseif ak == "defense" then
		return Defs.S_DEFENSE
	end
	return -1
end

function RangeLayer._nuke_kind(self: any): number
	for k = 0, Defs.NUKE_KIND_COUNT - 1 do
		if Defs.NUKE_NAMES[k] == self._aim_detail then
			return k
		end
	end
	return -1
end

function RangeLayer._hostile(self: any, owner_id: number, local_id: number): boolean
	return owner_id ~= local_id and not self._state:are_allies(owner_id, local_id)
end

function RangeLayer._range_of(self: any, sid: number, kind: number, cur: number): number
	local VR = self.VR
	if kind == Defs.S_ARTILLERY then
		return VR.artillery_range()
	elseif kind == Defs.S_AIRFIELD then
		return VR.airfield_range()
	elseif kind ~= Defs.S_SAM then
		return VR.defense_range()
	end
	local l = self._lvl[sid] or NO_LVL
	return VR.sam_range_at(l[1], cur - l[3])
end

function RangeLayer._update_hot(self: any)
	table.clear(self._hot)
	self._hot_n = 0
	local state = self._state
	local VR = self.VR
	if state == nil or VR == nil or self._aim_kind ~= "nuke" or self._aim_tile < 0 then
		return
	end
	local nk = self:_nuke_kind()
	local mirv = nk == Defs.N_MIRV
	if nk >= 0 and VR.intercept_p(if mirv then Defs.N_WARHEAD else nk) <= 0.0 then
		return
	end
	local local_id = state.local_owner
	local cur = math.floor(state.render_tick)
	local tg = if mirv then state:tile_owner(self._aim_tile) else 0
	local _, spread = VR.nuke_radii(Defs.N_MIRV)
	for sid, s in self._sites do
		local l = self._lvl[sid]
		if s[1] ~= Defs.S_SAM or not self:_hostile(s[2], local_id) or (l ~= nil and l[2] > cur) then
			continue
		end
		local r = self:_range_of(sid, s[1], cur)
		local d2 = VR.range_d2(s[3], self._aim_tile)
		if d2 <= r * r or (mirv and tg ~= 0 and s[2] == tg and d2 <= (spread + r) * (spread + r)) then
			self._hot[sid] = true
			self._hot_n += 1
		end
	end
end

function RangeLayer._sites_near(self: any, tile: number, px_tiles: number): number
	local st = self._state
	if tile < 0 or st == nil then
		return -1
	end
	local W = st.map.W or Defs.W
	local rr = math.max(px_tiles, 1.5)
	local best = rr * rr
	local best_sid = -1
	local tx, ty = tile % W, tile // W
	for sid, s in self._sites do
		local dx = s[3] % W - tx
		local dy = s[3] // W - ty
		local d = dx * dx + dy * dy
		if d <= best then
			best = d
			best_sid = sid
		end
	end
	return best_sid
end

--- The next ring to draw (the list's records are kept from one choice to the next).
local function push(self: any, tile: number, r: number, cls: number, col: Color3, sid: number, grows: boolean)
	local n = self._want_n + 1
	self._want_n = n
	local w = self._want[n]
	if w == nil then
		w = {} :: any
		self._want[n] = w
	end
	w.tile, w.r, w.cls, w.col, w.sid, w.grows = tile, r, cls, col, sid, grows
end

function RangeLayer._rebuild(self: any)
	local state = self._state
	local VR = self.VR
	self._want_n = 0
	self._grow_tick = nil
	if state == nil or VR == nil then
		return
	end
	local local_id = state.local_owner
	local cur = math.floor(state.render_tick)
	self._next_change = math.huge
	local grow_ticks = VR.sam_upgrade_ticks()
	local mode = self.mode
	local auto = mode ~= "none"
	local aiming_nuke = self._aim_kind == "nuke" and self._aim_tile >= 0
	local nuke_aim = (aiming_nuke and mode ~= "none") or mode == "nuke_aim"
	local atk = 0
	if self._aim_kind == "boat" and self._aim_tile >= 0 then
		atk = state:tile_owner(self._aim_tile)
	elseif mode == "attack_aim" then
		atk = if self._range_owner ~= 0 then self._range_owner else self._hover_owner
	end
	if atk == local_id then
		atk = 0
	end
	local bk = self:_build_kind()
	local upgrading = bk >= 0 and self._aim_tile >= 0 and self._aim_level > 1
	local NEAR2 = RangeLayer.NEAR_AIM * RangeLayer.NEAR_AIM
	for sid, s in self._sites do
		if self._want_n >= RangeLayer.MAX_RINGS - 1 then
			break
		end
		if upgrading and s[3] == self._aim_tile and s[1] == bk then
			continue
		end
		local l = self._lvl[sid] or NO_LVL
		local pending = l[2] > cur
		local grows = false
		if pending then
			self._next_change = math.min(self._next_change, l[2])
		elseif s[1] == Defs.S_SAM and cur - l[3] < grow_ticks then
			if aiming_nuke then
				-- (the hot SAMs and those near the aim follow the radius: all chosen again each tick)
				self._next_change = cur + 1
			else
				-- (only its radius changes: tick() follows it, _regrow)
				grows = true
			end
		end
		local r = self:_range_of(sid, s[1], cur)
		local own = local_id ~= 0 and s[2] == local_id
		local hostile = not own and self:_hostile(s[2], local_id)
		local cls = -1
		if s[1] == Defs.S_SAM then
			if nuke_aim and hostile then
				if self._hot[sid] then
					cls = C_HOT
				elseif not aiming_nuke or VR.range_d2(s[3], self._aim_tile) <= NEAR2 * r * r then
					cls = C_HOSTILE
				end
			elseif own and bk == Defs.S_SAM then
				cls = C_OWN_HI
			elseif own and auto then
				cls = C_OWN_SAM
			end
		elseif s[1] == Defs.S_ARTILLERY then
			-- a battery's range: yours faint (like a post's), bright while you place another
			if own and bk == Defs.S_ARTILLERY then
				cls = C_OWN_HI
			elseif own and auto then
				cls = C_OWN_DEF
			end
		elseif s[1] == Defs.S_AIRFIELD then
			-- an airfield's reach: only while you aim an air strike or place another airfield
			if own and (bk == Defs.S_AIRFIELD or (aiming_nuke and self._aim_detail == "airstrike")) then
				cls = C_OWN_HI
			end
		else
			if atk ~= 0 and s[2] == atk then
				cls = C_HOSTILE
			elseif own and bk == Defs.S_DEFENSE then
				cls = C_OWN_HI
			elseif own and auto then
				cls = C_OWN_DEF
			end
		end
		if (cls < C_HOSTILE or cls == C_ALL) and ((auto and self._hover_focus == sid) or self._ui_focus == sid) then
			cls = C_FOCUS
		end
		if cls < 0 and mode == "all" then
			cls = C_ALL
		end
		if cls < 0 then
			continue
		end
		if pending then
			cls = C_PENDING
		end
		local col = state:owner_color(s[2])
		if cls == C_OWN_SAM or cls == C_OWN_DEF or cls == C_OWN_HI then
			col = col:Lerp(WHITE, 0.4)
		elseif cls == C_HOSTILE then
			col = col:Lerp(HOSTILE_TINT, 0.62)
		elseif cls == C_HOT then
			col = HOT_COLOR
		elseif cls == C_FOCUS then
			col = if hostile then col:Lerp(HOSTILE_TINT, 0.55) else col:Lerp(WHITE, 0.3)
		else
			col = if hostile then col:Lerp(HOSTILE_TINT, 0.35) else col:Lerp(WHITE, 0.3)
		end
		push(self, s[3], r, cls, col, sid, grows)
		if grows then
			self._grow_tick = cur
		end
	end
	if bk >= 0 and self._aim_tile >= 0 then
		-- the ghost's range is a white disc (20 % fill) with a bright edge
		local bc = WHITE
		push(
			self,
			self._aim_tile,
			if bk == Defs.S_SAM
				then VR.sam_range(self._aim_level)
				elseif bk == Defs.S_FACTORY then VR.factory_range()
				elseif bk == Defs.S_ARTILLERY then VR.artillery_range()
				elseif bk == Defs.S_AIRFIELD then VR.airfield_range()
				else VR.defense_range(),
			C_BUILD,
			bc,
			-1,
			false
		)
	end
end

--- A game tick on while SAM rings grow after an upgrade (nothing else changed): their radii follow
--- it, as a full _rebuild would have made them.
function RangeLayer._regrow(self: any, cur: number)
	local grow_ticks = self.VR.sam_upgrade_ticks()
	local any = false
	local want = self._want
	for i = 1, self._want_n do
		local w = want[i]
		if not w.grows then
			continue
		end
		w.r = self:_range_of(w.sid, Defs.S_SAM, cur)
		local l = self._lvl[w.sid] or NO_LVL
		if cur - l[3] < grow_ticks then
			any = true
		else
			w.grows = false
		end
	end
	self._grow_tick = if any then cur else nil
end

-- ---------------------------------------------------------------------------------------------
-- Drawing
-- ---------------------------------------------------------------------------------------------

function RangeLayer._ring(self: any, i: number): Ring
	local r = self._rings[i]
	if r then
		return r
	end
	local f = Instance.new("Frame")
	f.Name = "Ring"
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BorderSizePixel = 0
	f.ZIndex = RangeLayer.Z
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
	local s = Instance.new("UIStroke")
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = f
	f.Parent = self.root
	-- (what a new Frame and UIStroke show: every value is written on the first draw)
	r = {
		frame = f,
		stroke = s,
		vis = true,
		x = math.huge,
		y = math.huge,
		d = -1,
		col = nil,
		fill_t = -1,
		stroke_col = nil,
		width = -1,
		stroke_t = -1,
	}
	self._rings[i] = r
	return r
end

local function smoothstep(a: number, b: number, x: number): number
	local t = math.clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end

function RangeLayer._draw(
	self: any,
	i: number,
	u: number,
	v: number,
	radius: number,
	cls: number,
	col: Color3,
	k: number
)
	local cam = self.view.rig
	local x, y = cam:map_to_screen(u, v)
	local d = radius * 2 * cam.scale
	if d < 4 or k <= 0.01 or not cam:on_screen(x, y, d * 0.5) then
		return i
	end
	i += 1
	local r = self:_ring(i)
	local pulse = if PULSE[cls + 1] then 0.5 + 0.5 * math.sin(self._now * 5.0) else 0.0
	-- (each written only when it changed: a still view of idle rings writes nothing, a pan only the
	-- positions, the pulsing ones their fill and stroke)
	local f, s = r.frame, r.stroke
	if not r.vis then
		r.vis = true
		f.Visible = true
	end
	if r.x ~= x or r.y ~= y then
		r.x, r.y = x, y
		f.Position = UDim2.fromOffset(x, y)
	end
	if r.d ~= d then
		r.d = d
		f.Size = UDim2.fromOffset(d, d)
	end
	if r.col ~= col then
		r.col = col
		f.BackgroundColor3 = col
	end
	local fill_t = 1 - FILL_A[cls + 1] * k * (1 + 0.3 * pulse)
	if r.fill_t ~= fill_t then
		r.fill_t = fill_t
		f.BackgroundTransparency = fill_t
	end
	if r.stroke_col ~= col then
		r.stroke_col = col
		s.Color = col
	end
	local width = WIDTH[cls + 1] * (1 + 0.25 * pulse)
	if r.width ~= width then
		r.width = width
		s.Thickness = width
	end
	local stroke_t = 1 - RING_A[cls + 1] * k
	if r.stroke_t ~= stroke_t then
		r.stroke_t = stroke_t
		s.Transparency = stroke_t
	end
	return i
end

function RangeLayer.tick(self: any, dt: number?)
	local state = self._state
	if state == nil or self.VR == nil then
		return
	end
	self._now += dt or (1 / 60)
	local cur = math.floor(state.render_tick)
	if cur >= self._next_change then
		self._dirty = true
	end
	if state.local_owner ~= self._last_local then
		self._last_local = state.local_owner
		self._dirty = true
	end
	if self._dirty then
		self._dirty = false
		self:_update_hot()
		self:_rebuild()
	elseif self._grow_tick ~= nil and cur > self._grow_tick then
		self:_regrow(cur)
	end
	local cam = self.view.rig
	local W = state.map.W or Defs.W
	local cam_d = cam:scale_to_distance(cam.scale)
	-- own idle rings fade with the zoom (the same for all of a class)
	local k_sam = 1 - smoothstep(OWN_SAM_FADE[1], OWN_SAM_FADE[2], cam_d)
	local k_def = 1 - smoothstep(OWN_DEF_FADE[1], OWN_DEF_FADE[2], cam_d)
	local i = 0
	local want = self._want
	for n = 1, self._want_n do
		local w = want[n]
		local k = 1.0
		if w.cls == C_OWN_SAM then
			k = k_sam
		elseif w.cls == C_OWN_DEF then
			k = k_def
		end
		i = self:_draw(i, w.tile % W + 0.5, w.tile // W + 0.5, w.r, w.cls, w.col, k)
	end
	local ur = self._unit
	if ur ~= nil then
		if ur.patrol_r > 0 then
			i = self:_draw(i, ur.pu, ur.pv, ur.patrol_r, C_OWN_HI, ur.patrol_col, 1)
		end
		i = self:_draw(i, ur.au, ur.av, ur.target_r, C_FOCUS, ur.target_col, 1)
	end
	for j = i + 1, #self._rings do
		local r = self._rings[j]
		if r.vis then
			r.vis = false
			r.frame.Visible = false
		end
	end
end

return RangeLayer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">RoadLayer</string>
              <string name="Source"><![CDATA[--!native
-- Railroads on the 2D map: every railroad follows its tile path
-- (GameState.roads: rid -> {a, b, tiles}) and fades in over FADE_RANGE up to zoom MIN_ZOOM.
-- Zoomed out it is a line a full-size tile wide along the path's centre (THICKNESS 1: the path's straight
-- runs, pooled GUI bars); zoomed in, a detailed track (from DETAIL_ZOOM): each tile a
-- 3 x 3 grid, two rails along its sides and a tie between them, a turn's tile its own piece (the two
-- sides it joins, rail_kinds). The track is a tiled image (assets/rails, RailArt)
-- along each straight stretch and one per turn.
-- Coloured by the land under them: grey on unclaimed land, a light rail on the
-- local player's land (dark over light territory) and the owner's border colour elsewhere; runs are
-- cut every RUN_MAX tiles so the colour follows the borders they cross. Redrawn when the camera or
-- the network changes, and now and then for the colours.
--
-- (2026-10-12: in the trailer's rail shot the train tracks looked poor; they
-- were bars 0.4 of a tile wide, 2 px at a continent's zoom, and never the track.)
-- (2026-10-27, "Script - Roads" was phones' second slow-frame cause: a pan moved every rail on the
-- screen, one Position each, and a rail coming on or going off the screen handed every rail after it
-- in the pool another run: six writes each. Now the rails sit in a frame placed at the map's origin
-- (`_pan`), each where it is at this zoom, so a pan writes the frame alone; until the view has moved
-- PAN_SLACK px no rail is even looked at (the rails that far off the screen are kept). A run or piece
-- keeps its GUI object while it is drawn.)
local RS = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Airfront = RS:WaitForChild("Airfront")
local Rules = require(Airfront:WaitForChild("Core"):WaitForChild("Rules")) :: any
local RailArt = require(Airfront:WaitForChild("Assets"):WaitForChild("RailArt")) :: any
local MapSurface = require(script.Parent:WaitForChild("MapSurface")) :: any

local RoadLayer = {}
RoadLayer.__index = RoadLayer

--- Rail zoom levels: device px per full-size tile (the GUI scale x
--- the device ratio, capped at 2). Rails are drawn from MIN_ZOOM - FADE_RANGE (invisible)
--- to MIN_ZOOM (opaque), a line THICKNESS full-size tiles wide, and the detailed track from
--- DETAIL_ZOOM on.
RoadLayer.MIN_ZOOM = 3.0
RoadLayer.FADE_RANGE = 2.0
RoadLayer.DETAIL_ZOOM = 6.0
RoadLayer.THICKNESS = 1.0
--- Device px per GUI px: Roblox's GUI px are points on a
--- phone or tablet, pixels on a desktop at 100%, and nothing tells the real ratio, so 2 on a touch
--- screen (every phone's is 2 or more, capped at 2) and 1 on a desktop. (It used to be 2
--- everywhere, and faded the rails in from MIN_ZOOM to MIN_ZOOM + FADE_RANGE, not up to MIN_ZOOM;
--- 2026-10-13: always seeing these railroads when zoomed out may have made the game worse, so
--- zoomed out they now fade away.)
--- (read when drawn: at the client's start the keyboard may not be known yet; nil = by the device)
RoadLayer.DEVICE_RATIO = nil :: number?
function RoadLayer.device_ratio(): number
	return RoadLayer.DEVICE_RATIO
		or if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then 2.0 else 1.0
end
RoadLayer.RUN_MAX = 12 -- tiles per bar at most
--- A line thinner than a device pixel is drawn one device pixel wide and as transparent as it is
--- thinner (the coverage of an anti-aliased line).
RoadLayer.RECOLOR_S = 0.5
RoadLayer.UNOWNED = Color3.new(0.75, 0.75, 0.75)
--- The local player's rails: LIGHT, or DARK when the
--- player's territory colour is brighter than LIGHT_ABOVE (perceived brightness). Others' are their
--- border colour (the palette's border row: HSL lightness - BORDER_DARKEN, as MapSurface's borders).
RoadLayer.LIGHT = Color3.fromRGB(0xE6, 0xE6, 0xE6)
RoadLayer.DARK = Color3.new(0, 0, 0)
RoadLayer.LIGHT_ABOVE = 0.8
RoadLayer.BORDER_DARKEN = 0.125
RoadLayer.Z = 6
--- Hidden bars kept for reuse.
RoadLayer.POOL_SPARE = 64
--- A pan this far (px) from where the rails were last laid out moves their frame and nothing else:
--- the rails within PAN_SLACK of the screen's edges are drawn (not while zooming).
RoadLayer.PAN_SLACK = 64

--- A tile's rail kind, an index into KIND_ART
local H, V, TL, TR, BL, BR = 1, 2, 3, 4, 5, 6
local KIND_ART = { "h", "v", "tl", "tr", "bl", "br" }

type Run = {
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	mid: number,
	mu: number?,
	mv: number?,
	lm: number?,
	rot: number?,
	col: Color3?,
	slot: number?,
}

--- A piece of the detailed track: the tiles x0..x1 x y0..y1 (one tile, or a straight stretch of one
--- kind), their kind (H .. BR), a tile for the colour (mid) and the centre in map units (mu, mv).
type Piece = {
	x0: number,
	y0: number,
	x1: number,
	y1: number,
	kind: number,
	mid: number,
	mu: number,
	mv: number,
	col: Color3?,
	slot: number?,
}

--- A pool of GUI objects: what each was last given (written again only when it changes: a pan moves
--- them and nothing else, a zoom sizes them; on a phone a late game's camera move rewrote six
--- properties of every rail on screen each frame, 2026-10-12): its run or piece (and so its rotation
--- or image), colour, transparency, size, and position (2026-10-26: the recolouring every RECOLOR_S
--- moved every rail on screen to where it already was). A slot keeps its run or piece while that is
--- drawn (item.slot; 2026-10-27): `seen` the pass that last drew it, `free` the hidden slots, `holes`
--- the slots whose object went, `top` the highest slot.
local function new_pool()
	return {
		items = {},
		run = {},
		col = {},
		a = {},
		w = {},
		h = {},
		x = {},
		y = {},
		seen = {},
		free = {},
		holes = {},
		top = 0,
	}
end

function RoadLayer.new(parent: Instance, view: any)
	local self = setmetatable({}, RoadLayer) :: any
	local root = Instance.new("Frame")
	root.Name = "Roads"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = RoadLayer.Z
	root.Parent = parent
	self.root = root
	--- the rails' frame: at the map's origin on the screen (whole px), the rails in it where they are
	--- at this zoom
	local pan = Instance.new("Frame")
	pan.Name = "Pan"
	pan.BackgroundTransparency = 1
	pan.BorderSizePixel = 0
	pan.Size = UDim2.fromOffset(0, 0)
	pan.ZIndex = RoadLayer.Z
	pan.Parent = root
	self._pan = pan
	self._px, self._py = 0, 0
	self.view = view
	self._state = nil :: any
	--- the lines (Frames) and the detailed track (ImageLabels)
	self._bars = new_pool()
	self._track = new_pool()
	--- rid -> the railroad's runs / track pieces (built once per railroad, when first drawn)
	self._runs = {} :: { [number]: { Run } }
	self._pieces = {} :: { [number]: { Piece } }
	self._dirty = true
	self._cam_version = -1
	self._recolor = 0.0
	--- the rails' last layout: its pass, zoom, viewport, the map's origin on the screen and how far
	--- past the screen's edges it drew (PAN_SLACK, or 0 while zooming)
	self._pass = 0
	self._lay_s, self._lay_vp = -1.0, nil :: Vector2?
	self._lay_x, self._lay_y, self._lay_slack = 0.0, 0.0, 0.0
	--- runs and pieces the last layout drew
	self._drawn = 0
	--- owner -> rail colour, for one pass (see colour())
	self._border = {} :: { [number]: Color3 }
	return self
end

function RoadLayer.bind(self: any, state: any)
	self._state = state
	table.clear(self._runs)
	table.clear(self._pieces)
	self._dirty = true
end

--- After a pass: the slots it did not draw (seen ~= pass) are hidden and free; the spares past
--- POOL_SPARE go (a map zoomed out shows no rails, yet a late game's 1,300 bars were laid out again
--- with the plates on every camera move).
local function sweep(pool: any, pass: number)
	local run, seen, free = pool.run, pool.seen, pool.free
	for j = 1, pool.top do
		-- (an object is shown exactly while it has a run: no need to ask Roblox)
		if run[j] ~= nil and seen[j] ~= pass then
			run[j] = nil
			pool.items[j].Visible = false
			table.insert(free, j)
		end
	end
	while #free > RoadLayer.POOL_SPARE do
		local j = table.remove(free) :: number
		pool.items[j]:Destroy()
		pool.items[j] = nil
		pool.col[j], pool.a[j], pool.w[j], pool.h[j] = nil, nil, nil, nil
		pool.x[j], pool.y[j], pool.seen[j] = nil, nil, nil
		table.insert(pool.holes, j)
	end
end

--- The slot of `pool` drawing `item` (a run or piece) this pass: its own while it stays drawn, else
--- a free one, else a new slot (`items[j]` nil: the caller makes its object). `fresh`: the slot's
--- object shows something else (or nothing) until this item is written into it.
local function acquire(pool: any, item: any, pass: number): (number, boolean)
	local j = item.slot
	local fresh = j == nil or pool.run[j] ~= item
	if fresh then
		j = table.remove(pool.free)
		if j == nil then
			j = table.remove(pool.holes)
			if j == nil then
				pool.top += 1
				j = pool.top
			end
		end
		item.slot = j
		pool.run[j] = item
		pool.col[j] = nil
		pool.a[j] = -1
		pool.w[j] = -1
		pool.x[j] = nil
	end
	pool.seen[j] = pass
	return j :: number, fresh
end

function RoadLayer.unbind(self: any)
	self._state = nil
	table.clear(self._runs)
	table.clear(self._pieces)
	for _, pool in { self._bars, self._track } do
		sweep(pool, -1)
	end
end

--- The rails' frame at the map's origin on the screen, in whole px (written when that moved).
function RoadLayer._place(self: any, ox: number, oy: number)
	local x, y = math.round(ox), math.round(oy)
	if x ~= self._px or y ~= self._py then
		self._px, self._py = x, y
		self._pan.Position = UDim2.fromOffset(x, y)
	end
end

function RoadLayer.destroy(self: any)
	self:unbind()
	self.root:Destroy()
end

function RoadLayer.mark_road_dirty(self: any, rid: number?)
	if rid ~= nil then
		self._runs[rid] = nil
		self._pieces[rid] = nil
	end
	self._dirty = true
end

--- A run's drawing in map space, from its end tiles: its midpoint (mu, mv: tile centres), its length
--- (lm) and its rotation (degrees: the camera scales both axes alike, so it is the screen's too).
local function with_geometry(run: any): any
	local u0, v0, u1, v1 = run.x0 + 0.5, run.y0 + 0.5, run.x1 + 0.5, run.y1 + 0.5
	local du, dv = u1 - u0, v1 - v0
	run.mu, run.mv = (u0 + u1) * 0.5, (v0 + v1) * 0.5
	run.lm = math.sqrt(du * du + dv * dv)
	run.rot = if run.lm > 0 then math.deg(math.atan2(dv, du)) else 0
	return run
end

--- The straight runs of a tile path (at most RUN_MAX tiles each), in tile coordinates, with their
--- geometry; `.bbox` = { u0, v0, u1, v1 } of the whole railroad (map units).
function RoadLayer.build_runs(tiles: { number }, W: number, run_max: number): { Run }
	local runs = RoadLayer._build_runs(tiles, W, run_max)
	local u0, v0, u1, v1 = math.huge, math.huge, -math.huge, -math.huge
	for _, run in runs do
		with_geometry(run)
		u0 = math.min(u0, run.x0, run.x1)
		v0 = math.min(v0, run.y0, run.y1)
		u1 = math.max(u1, run.x0 + 1, run.x1 + 1)
		v1 = math.max(v1, run.y0 + 1, run.y1 + 1)
	end
	if #runs > 0 then
		(runs :: any).bbox = { u0, v0, u1, v1 }
	end
	return runs
end

function RoadLayer._build_runs(tiles: { number }, W: number, run_max: number): { Run }
	local runs = {}
	local n = #tiles
	if n == 0 then
		return runs
	end
	if n == 1 then
		local t = tiles[1]
		table.insert(runs, { x0 = t % W, y0 = t // W, x1 = t % W, y1 = t // W, mid = t })
		return runs
	end
	local i0 = 1
	while i0 < n do
		local a, b = tiles[i0], tiles[i0 + 1]
		local dx, dy = b % W - a % W, b // W - a // W
		local j = i0 + 1
		while j < n and j - i0 < run_max do
			local c, d = tiles[j], tiles[j + 1]
			if d % W - c % W ~= dx or d // W - c // W ~= dy then
				break
			end
			j += 1
		end
		local s, e = tiles[i0], tiles[j]
		table.insert(runs, { x0 = s % W, y0 = s // W, x1 = e % W, y1 = e // W, mid = tiles[(i0 + j) // 2] })
		i0 = j
	end
	return runs
end

--- An end tile's kind, from the tile next to it.
local function extremity(t: number, n: number, W: number): number
	local dx, dy = n % W - t % W, n // W - t // W
	if dx == 0 then
		return V
	elseif dy == 0 then
		return H
	end
	return V
end

--- A tile's kind, from the tiles before and after it.
local function direction(p: number, c: number, n: number, W: number): number
	local dx1, dy1 = c % W - p % W, c // W - p // W
	local dx2, dy2 = n % W - c % W, n // W - c // W
	if dx1 == dx2 and dy1 == dy2 then
		return if dx1 ~= 0 then H else V
	end
	if (dx1 == 0 and dx2 ~= 0) or (dx1 ~= 0 and dx2 == 0) then
		if dx1 == 0 and dx2 == 1 and dy1 == -1 then
			return BR
		elseif dx1 == 0 and dx2 == -1 and dy1 == -1 then
			return BL
		elseif dx1 == 0 and dx2 == 1 and dy1 == 1 then
			return TR
		elseif dx1 == 0 and dx2 == -1 and dy1 == 1 then
			return TL
		elseif dx1 == 1 and dx2 == 0 and dy2 == -1 then
			return TL
		elseif dx1 == -1 and dx2 == 0 and dy2 == -1 then
			return TR
		elseif dx1 == 1 and dx2 == 0 and dy2 == 1 then
			return BL
		elseif dx1 == -1 and dx2 == 0 and dy2 == 1 then
			return BR
		end
	end
	return V
end

--- The kind of every tile of a path.
function RoadLayer.rail_kinds(tiles: { number }, W: number): { number }
	local n = #tiles
	local kinds = table.create(n, V)
	if n >= 2 then
		kinds[1] = extremity(tiles[1], tiles[2], W)
		for i = 2, n - 1 do
			kinds[i] = direction(tiles[i - 1], tiles[i], tiles[i + 1], W)
		end
		kinds[n] = extremity(tiles[n], tiles[n - 1], W)
	end
	return kinds
end

--- The detailed track of a path: its tiles' kinds (rail_kinds), a straight stretch of tiles of one
--- kind side by side one piece (at most run_max tiles), each turn a piece of its own; `.bbox` as
--- build_runs'.
function RoadLayer.build_pieces(tiles: { number }, W: number, run_max: number): { Piece }
	local kinds = RoadLayer.rail_kinds(tiles, W)
	local pieces = {}
	local cur: any = nil
	local lx, ly = 0, 0
	for i, t in tiles do
		local x, y, k = t % W, t // W, kinds[i]
		if
			cur ~= nil
			and cur.kind == k
			and cur.n < run_max
			and ((k == H and y == ly and math.abs(x - lx) == 1) or (k == V and x == lx and math.abs(y - ly) == 1))
		then
			cur.x0, cur.x1 = math.min(cur.x0, x), math.max(cur.x1, x)
			cur.y0, cur.y1 = math.min(cur.y0, y), math.max(cur.y1, y)
			cur.n += 1
		else
			cur = { x0 = x, y0 = y, x1 = x, y1 = y, kind = k, n = 1 }
			table.insert(pieces, cur)
		end
		lx, ly = x, y
	end
	local u0, v0, u1, v1 = math.huge, math.huge, -math.huge, -math.huge
	for _, pc in pieces do
		-- the colour's tile: the middle one (a stretch is a row or a column)
		pc.mid = ((pc.y0 + pc.y1) // 2) * W + (pc.x0 + pc.x1) // 2
		pc.n = nil
		pc.mu, pc.mv = (pc.x0 + pc.x1 + 1) * 0.5, (pc.y0 + pc.y1 + 1) * 0.5
		u0, v0 = math.min(u0, pc.x0), math.min(v0, pc.y0)
		u1, v1 = math.max(u1, pc.x1 + 1), math.max(v1, pc.y1 + 1)
	end
	if #pieces > 0 then
		(pieces :: any).bbox = { u0, v0, u1, v1 }
	end
	return pieces
end

local function luminance(c: Color3): number
	return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

--- A railroad's bbox off the screen (with margin m)?
local function off_screen(
	bb: any,
	ax: number,
	ay: number,
	s: number,
	cu: number,
	cv: number,
	vw: number,
	vh: number,
	m: number
): boolean
	return bb ~= nil
		and (
			ax + (bb[3] - cu) * s < -m
			or ay + (bb[4] - cv) * s < -m
			or ax + (bb[1] - cu) * s > vw + m
			or ay + (bb[2] - cv) * s > vh + m
		)
end

--- A run's or piece's colour: the land under its middle tile, looked up again when `recolor` (else
--- kept), the border colours of the pass in `border` (owner -> colour).
local function colour(
	st: any,
	item: any,
	recolor: boolean,
	me: number,
	mine: Color3,
	border: { [number]: Color3 }
): Color3
	local col = item.col
	if col == nil or recolor then
		local own = st:tile_owner(item.mid)
		if own == 0 then
			col = RoadLayer.UNOWNED
		elseif own == me then
			col = mine
		else
			col = border[own]
			if col == nil then
				local c = st:owner_color(own)
				col = Color3.new(MapSurface.darken(c.R, c.G, c.B, RoadLayer.BORDER_DARKEN))
				border[own] = col
			end
		end
		item.col = col
	end
	return col
end

function RoadLayer.tick(self: any, dt: number)
	local st = self._state
	if st == nil then
		return
	end
	local cam = self.view.rig
	self._recolor -= dt
	if not self._dirty and cam.version == self._cam_version and self._recolor > 0 then
		return
	end
	self._cam_version = cam.version
	local ax, ay = cam:anchor()
	local s, cu, cv = cam.scale, cam.cu, cam.cv
	local vp = cam._vp
	-- the map's origin on the screen: the rails' frame goes there; a pan that keeps within the last
	-- layout's slack (same zoom, same viewport) moves it and nothing else
	local ox, oy = ax - cu * s, ay - cv * s
	local lay_slack = self._lay_slack
	if
		not self._dirty
		and self._recolor > 0
		and s == self._lay_s
		and vp == self._lay_vp
		and math.abs(ox - self._lay_x) <= lay_slack
		and math.abs(oy - self._lay_y) <= lay_slack
	then
		-- (no rail shown, zoomed out: not even the frame)
		if self._drawn > 0 then
			self:_place(ox, oy)
		end
		return
	end
	self:_place(ox, oy)
	-- (while the zoom changes every rail is written again each frame: none past the screen then)
	local slack = if s == self._lay_s then RoadLayer.PAN_SLACK else 0
	local recolor_due = self._recolor <= 0 or self._dirty
	if recolor_due then
		self._recolor = RoadLayer.RECOLOR_S
	end
	self._dirty = false
	self._lay_s, self._lay_vp, self._lay_x, self._lay_y, self._lay_slack = s, vp, ox, oy, slack
	self._pass += 1
	local pass = self._pass
	local drawn = 0
	local k = tonumber(st.map and st.map.k_lin) or Rules.K_LIN
	local dpr = RoadLayer.device_ratio()
	local zoom = cam.scale / k * dpr
	local a = math.clamp((zoom - (RoadLayer.MIN_ZOOM - RoadLayer.FADE_RANGE)) / RoadLayer.FADE_RANGE, 0, 1)
	local bars, track = self._bars, self._track
	if a > 0.01 then
		local W = st.map.W
		local detail = zoom >= RoadLayer.DETAIL_ZOOM
		-- the line: THICKNESS full-size tiles, at least a device pixel (thinner: fainter instead)
		local thick = RoadLayer.THICKNESS * cam.scale / k
		local line_a = a
		if thick < 1 / dpr then
			line_a = a * thick * dpr
			thick = 1 / dpr
		end
		local me = st.local_owner or 0
		local mine = RoadLayer.LIGHT
		if me ~= 0 then
			mine = if luminance(st:owner_color(me)) > RoadLayer.LIGHT_ABOVE then RoadLayer.DARK else RoadLayer.LIGHT
		end
		-- (colours follow the land under the rails: looked up again every RECOLOR_S, not on every
		-- camera move; the projection is done here, once per run, from the camera's anchor; the
		-- border colours are worked out again each pass, in a table kept for it)
		local recolor = recolor_due
		local border = self._border
		table.clear(border)
		local vw, vh = vp.X, vp.Y
		local pan = self._pan
		for rid, r in st.roads do
			if detail then
				local pieces = self._pieces[rid]
				if pieces == nil then
					pieces = RoadLayer.build_pieces(r.tiles or {}, W, RoadLayer.RUN_MAX)
					self._pieces[rid] = pieces
				end
				-- a railroad off the screen as a whole: none of its pieces is looked at
				if off_screen((pieces :: any).bbox, ax, ay, s, cu, cv, vw, vh, slack) then
					continue
				end
				-- (by index: `pieces.bbox` is a field of the same table)
				for i = 1, #pieces do
					local pc = pieces[i]
					local tw, th = pc.x1 - pc.x0 + 1, pc.y1 - pc.y0 + 1
					local w, h = tw * s, th * s
					local mx, my = ax + (pc.mu - cu) * s, ay + (pc.mv - cv) * s
					local mw, mh = w * 0.5 + slack, h * 0.5 + slack
					if mx < -mw or my < -mh or mx > vw + mw or my > vh + mh then
						continue
					end
					local col = colour(st, pc, recolor, me, mine, border)
					drawn += 1
					local j, fresh = acquire(track, pc, pass)
					local b = track.items[j]
					if b == nil then
						b = Instance.new("ImageLabel")
						b.Name = "Track"
						b.AnchorPoint = Vector2.new(0.5, 0.5)
						b.BackgroundTransparency = 1
						b.BorderSizePixel = 0
						b.ResampleMode = Enum.ResamplerMode.Pixelated
						b.ZIndex = RoadLayer.Z
						b.Parent = pan
						track.items[j] = b
					end
					if fresh then
						b.Visible = true
						b.Image = RailArt[KIND_ART[pc.kind]]
						-- a stretch repeats the tile once per tile (TileSize in scale: exact whatever the
						-- px), a turn is one tile
						if tw > 1 or th > 1 then
							b.ScaleType = Enum.ScaleType.Tile
							b.TileSize = UDim2.fromScale(1 / tw, 1 / th)
						else
							b.ScaleType = Enum.ScaleType.Stretch
						end
					end
					if track.col[j] ~= col then
						track.col[j] = col
						b.ImageColor3 = col
					end
					if track.a[j] ~= a then
						track.a[j] = a
						b.ImageTransparency = 1 - a
					end
					-- (in the rails' frame: where it is at this zoom)
					local x, y = pc.mu * s, pc.mv * s
					if track.x[j] ~= x or track.y[j] ~= y then
						track.x[j], track.y[j] = x, y
						b.Position = UDim2.fromOffset(x, y)
					end
					if track.w[j] ~= w or track.h[j] ~= h then
						track.w[j], track.h[j] = w, h
						b.Size = UDim2.fromOffset(w, h)
					end
				end
				continue
			end
			local runs = self._runs[rid]
			if runs == nil then
				runs = RoadLayer.build_runs(r.tiles or {}, W, RoadLayer.RUN_MAX)
				self._runs[rid] = runs
			end
			-- a railroad off the screen as a whole: none of its runs is looked at
			if off_screen((runs :: any).bbox, ax, ay, s, cu, cv, vw, vh, thick + slack) then
				continue
			end
			-- (by index: `runs.bbox` is a field of the same table, and `for _, run in runs` met it
			-- after the runs, failed, and left every later railroad undrawn and stale bars on the
			-- screen: 238K sessions' warnings a day on v79-v81, 2026-10-12)
			for i = 1, #runs do
				local run = runs[i]
				local len = run.lm * s
				local mx, my = ax + (run.mu - cu) * s, ay + (run.mv - cv) * s
				local m = len * 0.5 + thick + slack
				if mx < -m or my < -m or mx > vw + m or my > vh + m then
					continue
				end
				local col = colour(st, run, recolor, me, mine, border)
				drawn += 1
				local j, fresh = acquire(bars, run, pass)
				local b = bars.items[j]
				if b == nil then
					b = Instance.new("Frame")
					b.Name = "Rail"
					b.AnchorPoint = Vector2.new(0.5, 0.5)
					b.BorderSizePixel = 0
					b.ZIndex = RoadLayer.Z
					b.Parent = pan
					bars.items[j] = b
				end
				if fresh then
					b.Visible = true
					b.Rotation = run.rot
				end
				if bars.col[j] ~= col then
					bars.col[j] = col
					b.BackgroundColor3 = col
				end
				if bars.a[j] ~= line_a then
					bars.a[j] = line_a
					b.BackgroundTransparency = 1 - line_a
				end
				local x, y = run.mu * s, run.mv * s
				if bars.x[j] ~= x or bars.y[j] ~= y then
					bars.x[j], bars.y[j] = x, y
					b.Position = UDim2.fromOffset(x, y)
				end
				-- a run spans its end tiles' centres; half a thickness more each way closes the corners
				-- (corner tiles: two half-segments meeting at the centre)
				local w = len + thick
				if bars.w[j] ~= w or bars.h[j] ~= thick then
					bars.w[j], bars.h[j] = w, thick
					b.Size = UDim2.fromOffset(w, thick)
				end
			end
		end
	end
	sweep(bars, pass)
	sweep(track, pass)
	self._drawn = drawn
end

return RoadLayer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">StructureLayer</string>
              <string name="Source"><![CDATA[--!native
-- Structure icons on the 2D map:
--   * a plate per structure in its kind's shape (Assets/MapSprites: City squircle, Port disc, Factory
--     cog, Defense Post shield, SAM Launcher dome, Missile Silo bullet, Artillery diamond, Airfield
--     runway, Railgun hexagon), fill = the owner's territory colour at HSV value x0.65, rim = the
--     border colour (the territory colour for the local player) at value x0.1, a white glyph inside;
--     under construction: grey fill 198 / rim 127;
--   * size: ICON_SIZE * iconScale px, iconScale = DOT_SCALE (0.3, no glyph)
--     when zoom <= DOTS_ZOOM, zoom / GROW_ZOOM above GROW_ZOOM, else
--     min(1, zoom / SCALE_FACTOR_OUT); per-kind shape scale; zoom = the camera zoom
--     (device px per full-size tile; a tile is k_lin full-size tiles, a GUI px DEVICE_RATIO
--     device px);
--   * level >= 2: the level number above the plate (0.4 plate sizes up);
--   * a progress bar, 14 x 3 full-size tiles centred 6 tiles below the structure
--     (1-tile black border; fill red < 25 % < orange < 50 % < yellow < 75 % < green): construction
--     progress, and a SAM's / silo's missile readiness while missiles reload (Ev.STRUCT_SHOTS).
-- Roblox: pooled plates, positions rewritten only when the camera or the structure set changed. A
-- plate is one ImageLabel with the glyph inside it: the shape's rim and fill in one image
-- (Sprites.shapes_one, tinted with the fill colour: its rim pixels are the grey that makes the rim's
-- tenth of the value). It was a Frame holding a rim image, a fill image, the glyph and a level
-- label, five objects for each of a late game's 500 structures, all laid out again on every camera
-- move (2026-10-08, docs/performance.md). The level label is made when a structure has a level to
-- show. While shapes_one has not loaded, every plate keeps a second image for the fill.
-- (2026-10-26, phones' slow frames: a plate and its bar remember what they were last given and are
-- written only what changed, read nothing back from Roblox; a structure's own event redraws that
-- structure alone, where every SAM shot on the map used to redraw every plate.)
local RS = game:GetService("ReplicatedStorage")
local Airfront = RS:WaitForChild("Airfront")
local Rules = require(Airfront:WaitForChild("Core"):WaitForChild("Rules")) :: any
local Defs = require(Airfront:WaitForChild("Core"):WaitForChild("Defs")) :: any
local JutsuGlyph = require(script.Parent.Parent.UI.JutsuGlyph)
local Sprites = require(Airfront:WaitForChild("Assets"):WaitForChild("MapSprites")) :: any
--- Sprites.shapes_one is used once it is known to have loaded (an image still in moderation would leave
--- every plate invisible).
local ONE: any = Sprites.shapes_one
local one_ready = false
if ONE ~= nil then
	(require(script.Parent:WaitForChild("AtlasReady")) :: any).watch(ONE.id, function()
		one_ready = true
	end)
end

local StructureLayer = {}
StructureLayer.__index = StructureLayer

-- icon sizes and zooms
StructureLayer.ICON_SIZE = 30 -- 60 device px at device pixel ratio 2
StructureLayer.DEVICE_RATIO = 2.0
StructureLayer.DOTS_ZOOM = 1.2
StructureLayer.DOT_SCALE = 0.3
StructureLayer.SCALE_FACTOR_OUT = 3.0
StructureLayer.GROW_ZOOM = 7.0
--- per structure kind (Defs.S_*, 0-based) — index with kind + 1: the plate's size (x ICON_SIZE) and
--- the share of it the glyph spans (ICON_FILL / SHAPE_SCALE of the plate), set with the art
StructureLayer.SHAPE_SCALE = table.clone(Sprites.shape_scale)
StructureLayer.ICON_FILL = table.clone(Sprites.icon_fill)
StructureLayer.FILL_V = 0.65
StructureLayer.BORDER_V = 0.1
StructureLayer.BORDER_DARKEN = 0.125
StructureLayer.CONSTRUCT_FILL = Color3.fromRGB(198, 198, 198)
StructureLayer.CONSTRUCT_BORDER = Color3.fromRGB(127, 127, 127)
StructureLayer.Z = 10
-- progress bar (full-size tiles)
StructureLayer.BAR_W = 14
StructureLayer.BAR_H = 3
StructureLayer.BAR_OFFSET_Y = 6
StructureLayer.BAR_BORDER = 1
StructureLayer.BAR_THRESHOLDS = { 0.25, 0.5, 0.75 }
StructureLayer.BAR_COLORS = {
	Color3.new(0.91, 0.098, 0.098),
	Color3.new(0.941, 0.478, 0.098),
	Color3.new(0.792, 0.906, 0.059),
	Color3.new(0.173, 0.937, 0.071),
}
--- Bars narrower than this (px) are not drawn (far zoomed out).
StructureLayer.BAR_MIN_PX = 10
local SHAPE_SCALE = StructureLayer.SHAPE_SCALE
local ICON_FILL = StructureLayer.ICON_FILL

type Plate = {
	--- the plate: the whole shape (rim and fill in one image, or the rim alone under `fill`)
	frame: ImageLabel,
	--- the inset shape over a two-image plate (made when one is needed)
	fill: ImageLabel?,
	glyph: ImageLabel,
	--- the level number (made when a structure has one)
	level: TextLabel?,
	x: number,
	y: number,
	bar: Frame?,
	bar_fill: Frame?,
	kind: number,
	owner: number,
	state_key: number,
	size: number,
	--- what the glyph and the bar were last given (Roblox's own values, kept here: a plate taken
	--- from the pool still shows them, so nothing needs resetting)
	glyph_on: boolean,
	bar_on: boolean,
	bar_w: number,
	bar_h: number,
	bar_x: number,
	bar_y: number,
	bar_edge: number,
	fill_w: number,
	fill_h: number,
	fill_c: number,
	--- the full pass that last saw it on screen
	pass: number,
}

local function value_scale(c: Color3, k: number): Color3
	local h, s, v = c:ToHSV()
	return Color3.fromHSV(h, s, v * k)
end

--- The owner's border colour (HSL lightness - 0.125, like MapSurface).
local function border_color(c: Color3): Color3
	local r, g, b = c.R, c.G, c.B
	local mx, mn = math.max(r, g, b), math.min(r, g, b)
	local l = (mx + mn) / 2
	local s, h = 0.0, 0.0
	if mx ~= mn then
		local d = mx - mn
		s = if l > 0.5 then d / (2 - mx - mn) else d / (mx + mn)
		if mx == r then
			h = (g - b) / d + (if g < b then 6 else 0)
		elseif mx == g then
			h = (b - r) / d + 2
		else
			h = (r - g) / d + 4
		end
		h /= 6
	end
	l = math.max(0, l - StructureLayer.BORDER_DARKEN)
	if s == 0 then
		return Color3.new(l, l, l)
	end
	local q = if l < 0.5 then l * (1 + s) else l + s - l * s
	local p = 2 * l - q
	local function hue(t: number): number
		if t < 0 then
			t += 1
		elseif t > 1 then
			t -= 1
		end
		if t < 1 / 6 then
			return p + (q - p) * 6 * t
		elseif t < 1 / 2 then
			return q
		elseif t < 2 / 3 then
			return p + (q - p) * (2 / 3 - t) * 6
		end
		return p
	end
	return Color3.new(hue(h + 1 / 3), hue(h), hue(h - 1 / 3))
end

function StructureLayer.new(parent: Instance, view: any)
	local self = setmetatable({}, StructureLayer) :: any
	local root = Instance.new("Frame")
	root.Name = "Structures"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = StructureLayer.Z
	root.Parent = parent
	self.root = root
	self.view = view
	self._state = nil :: any
	self._plates = {} :: { [number]: Plate }
	self._pool = {} :: { Plate }
	self._one_seen = false
	-- The progress bars change every frame while something is built or reloads, and late games
	-- always have some: they live in the map's moving ScreenGui (MapView.moving_overlay), so the
	-- plates' own, some 2,500 objects by then, is left alone between camera moves.
	local bars = Instance.new("Frame")
	bars.Name = "StructureBars"
	bars.BackgroundTransparency = 1
	bars.Size = UDim2.fromScale(1, 1)
	bars.ZIndex = StructureLayer.Z
	bars.Parent = if view ~= nil and view.moving_overlay ~= nil then view.moving_overlay else root
	self._bar_root = bars
	self._dirty = true
	self._cam_version = -1
	self._pass = 0
	--- sids of on-screen plates being built or reloading (updated every frame between full passes)
	self._anim = {} :: { [number]: boolean }
	--- sids a structure event named since the last frame (drawn again on their own)
	self._touched = {} :: { [number]: boolean }
	return self
end

function StructureLayer.bind(self: any, state: any)
	self:unbind()
	self._state = state
	self._dirty = true
end

function StructureLayer.unbind(self: any)
	self._state = nil
	for sid, p in self._plates do
		self:_release(p)
		self._plates[sid] = nil
	end
	table.clear(self._anim)
	table.clear(self._touched)
end

function StructureLayer.destroy(self: any)
	self:unbind()
	self._bar_root:Destroy()
	self.root:Destroy()
end

-- WorldView forwards GameState structure signals by these names (sid first). Only that structure is
-- drawn again: structure_leveled also comes with every SAM / silo shot (Ev.STRUCT_SHOTS, for its
-- reload bar), and in a late game's missile exchange that redrew all 500 plates a frame.
function StructureLayer.on_structure_added(self: any, sid: number?)
	if type(sid) == "number" then
		self._touched[sid] = true
	else
		self._dirty = true
	end
end
StructureLayer.on_structure_changed = StructureLayer.on_structure_added
StructureLayer.on_structure_removed = StructureLayer.on_structure_added
StructureLayer.on_structure_leveled = StructureLayer.on_structure_added

function StructureLayer.mark_structures_dirty(self: any)
	self._dirty = true
end

local function image(parent: Instance, name: string, id: string, z: number): ImageLabel
	local l = Instance.new("ImageLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Image = id
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.Position = UDim2.fromScale(0.5, 0.5)
	l.ZIndex = z
	l.Parent = parent
	return l
end

function StructureLayer._acquire(self: any): Plate
	local p = table.remove(self._pool)
	if p then
		p.frame.Visible = true
		return p
	end
	local f = Instance.new("ImageLabel")
	f.Name = "Structure"
	f.BackgroundTransparency = 1
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.ZIndex = StructureLayer.Z
	local glyph = image(f, "Glyph", Sprites.icons.id, StructureLayer.Z + 2)
	f.Parent = self.root
	return {
		frame = f,
		fill = nil,
		glyph = glyph,
		level = nil,
		kind = -1,
		owner = -1,
		state_key = -1,
		size = -1,
		x = -1e9,
		y = -1e9,
		glyph_on = true,
		bar_on = false,
		bar_w = -1,
		bar_h = -1,
		bar_x = -1e9,
		bar_y = -1e9,
		bar_edge = -1,
		fill_w = -1,
		fill_h = -1,
		fill_c = -1,
		pass = -1,
	}
end

--- The level label of a plate, made on first use.
local function level_label(p: Plate): TextLabel
	local level = p.level
	if level == nil then
		local l = Instance.new("TextLabel")
		l.Name = "Level"
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 1)
		l.Position = UDim2.fromScale(0.5, 0.1)
		l.Size = UDim2.fromScale(1, 0.6)
		l.FontFace = Font.fromId(12187365977, Enum.FontWeight.Bold)
		l.TextScaled = true
		l.TextColor3 = Color3.new(1, 1, 1)
		l.ZIndex = StructureLayer.Z + 3
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.new(0, 0, 0)
		stroke.Thickness = 1.5
		stroke.Parent = l
		l.Parent = p.frame
		p.level = l
		level = l
	end
	return level :: TextLabel
end

function StructureLayer._release(self: any, p: Plate)
	p.frame.Visible = false
	if p.bar ~= nil and p.bar_on then
		p.bar.Visible = false
		p.bar_on = false
	end
	p.kind = -1
	p.owner = -1
	p.x, p.y = -1e9, -1e9
	p.state_key = -1
	table.insert(self._pool, p)
end

function StructureLayer._style(self: any, p: Plate, s: any, building: boolean)
	local st = self._state
	local k = s.kind
	-- one image for the plate once it has loaded (see the header)
	local one = one_ready
	-- (a number, not a string: built for every plate on screen at every camera move, and a phone pays
	-- for the strings it made; 2026-10-12)
	local key = (((k * 1024 + s.owner) * 2 + (if building then 1 else 0)) * 4096 + math.min(s.level or 1, 4095)) * 2
		+ (if one then 1 else 0)
	if key == p.state_key then
		return
	end
	p.state_key = key
	local shapes, icons, col = Sprites.shapes, Sprites.icons, k
	local fill_col, rim_col
	if building then
		fill_col, rim_col = StructureLayer.CONSTRUCT_FILL, StructureLayer.CONSTRUCT_BORDER
	else
		local c = st:owner_color(s.owner)
		fill_col = value_scale(c, StructureLayer.FILL_V)
		local b = if s.owner == st.local_owner then c else border_color(c)
		rim_col = value_scale(b, StructureLayer.BORDER_V)
	end
	local plate = p.frame
	local cell = shapes.cell
	plate.ImageRectSize = Vector2.new(cell, cell)
	plate.ImageRectOffset = Vector2.new(col * cell, 0)
	if one then
		plate.Image = ONE.id
		plate.ImageColor3 = fill_col
		if p.fill ~= nil then
			p.fill.Visible = false
		end
	else
		plate.Image = shapes.id
		plate.ImageColor3 = rim_col
		local fill = p.fill
		if fill == nil then
			local f = image(plate, "Fill", shapes.id, StructureLayer.Z + 1)
			f.Size = UDim2.fromScale(1, 1)
			p.fill = f
			fill = f
		end
		local f = fill :: ImageLabel
		f.Visible = true
		f.Image = shapes.id
		f.ImageRectOffset = Vector2.new(col * cell, cell)
		f.ImageRectSize = Vector2.new(cell, cell)
		f.ImageColor3 = fill_col
	end
	p.glyph.Image = icons.id
	local ic = icons.cell
	p.glyph.ImageRectOffset = Vector2.new(col * ic, 0)
	p.glyph.ImageRectSize = Vector2.new(ic, ic)
	-- the glyph spans ICON_FILL / SHAPE_SCALE of the plate
	local g = ICON_FILL[k + 1] / SHAPE_SCALE[k + 1]
	p.glyph.Size = UDim2.fromScale(g, g)
	JutsuGlyph.apply(p.glyph, Defs.STRUCT_NAMES[k] or "", if building then 0.24 else 0)
	local lv = s.level or 1
	if lv >= 2 then
		local l = level_label(p)
		l.Visible = true
		l.Text = tostring(lv)
	elseif p.level ~= nil then
		p.level.Visible = false
	end
end

--- Construction progress, else (SAM / silo) missile
--- readiness while any missile reloads; nil = no bar.
function StructureLayer.progress(s: any, rt: number): number?
	local at = s.active_tick or 0
	if at > rt then
		local dur = Rules.BUILD_TICKS[s.kind] or 50
		return math.clamp(1 - (at - rt) / math.max(1, dur), 0, 1)
	end
	local shots = s.shots
	-- (a SAM's and a silo's missiles; an airfield rearming, a railgun reloading: Rules.RELOAD_TICKS)
	local reload = Rules.RELOAD_TICKS[s.kind] or 0
	if reload > 0 and shots ~= nil and #shots > 0 then
		local cd = reload
		local slots = math.max(1, s.level or 1)
		local reloading, done = 0, 0.0
		for _, t in shots do
			local e = rt - t
			if e < cd then
				reloading += 1
				done += math.max(0, e) / cd
			end
		end
		if reloading > 0 then
			local r = math.clamp((slots - reloading) / slots + done / slots, 0, 1)
			if r < 1 then
				return r
			end
		end
	end
	return nil
end

function StructureLayer._bar(self: any, p: Plate, progress: number?, x: number, y: number, ppt: number)
	local w = StructureLayer.BAR_W * ppt
	if progress == nil or w < StructureLayer.BAR_MIN_PX then
		if p.bar ~= nil and p.bar_on then
			p.bar.Visible = false
			p.bar_on = false
		end
		return
	end
	local bar, fill = p.bar, p.bar_fill
	if bar == nil or fill == nil then
		local b = Instance.new("Frame")
		b.Name = "Bar"
		b.BorderSizePixel = 0
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.ZIndex = StructureLayer.Z + 4
		local f = Instance.new("Frame")
		f.Name = "Fill"
		f.BorderSizePixel = 0
		f.ZIndex = StructureLayer.Z + 5
		f.Parent = b
		b.Parent = self._bar_root
		p.bar, p.bar_fill = b, f
		bar, fill = b, f
	end
	local b = bar :: Frame
	local f = fill :: Frame
	local h = math.max(3, math.round(StructureLayer.BAR_H * ppt))
	local bw = math.max(1, math.round(StructureLayer.BAR_BORDER * ppt))
	local wr = math.round(w)
	-- (each written only when it changed: a pan moves the bar, a reload grows its fill now and then)
	if not p.bar_on then
		p.bar_on = true
		b.Visible = true
	end
	if p.bar_w ~= wr or p.bar_h ~= h then
		p.bar_w, p.bar_h = wr, h
		b.Size = UDim2.fromOffset(wr, h)
	end
	local bx, by = math.round(x - wr / 2), math.round(y + StructureLayer.BAR_OFFSET_Y * ppt)
	if p.bar_x ~= bx or p.bar_y ~= by then
		p.bar_x, p.bar_y = bx, by
		b.Position = UDim2.fromOffset(bx, by)
	end
	local inner = math.max(0, wr - 2 * bw)
	if p.bar_edge ~= bw then
		p.bar_edge = bw
		f.Position = UDim2.fromOffset(bw, bw)
	end
	local fw, fh = math.round(progress * inner), math.max(1, h - 2 * bw)
	if p.fill_w ~= fw or p.fill_h ~= fh then
		p.fill_w, p.fill_h = fw, fh
		f.Size = UDim2.fromOffset(fw, fh)
	end
	local th = StructureLayer.BAR_THRESHOLDS
	local ci = if progress < th[1] then 1 elseif progress < th[2] then 2 elseif progress < th[3] then 3 else 4
	if p.fill_c ~= ci then
		p.fill_c = ci
		f.BackgroundColor3 = StructureLayer.BAR_COLORS[ci]
	end
end

--- One structure's plate at (x, y) (screen px), `size` px: style, size, position (written only when
--- they changed), its progress bar. Returns the progress (nil = no bar).
function StructureLayer._place(
	self: any,
	p: Plate,
	s: any,
	rt: number,
	x: number,
	y: number,
	size: number,
	dots: boolean,
	ppt: number
): number?
	self:_style(p, s, (s.active_tick or 0) > rt)
	local px = math.round(size)
	if p.size ~= px then
		p.size = px
		p.frame.Size = UDim2.fromOffset(px, px)
	end
	if p.glyph_on == dots then
		p.glyph_on = not dots
		p.glyph.Visible = not dots
	end
	local rx, ry = math.round(x), math.round(y)
	if rx ~= p.x or ry ~= p.y then
		p.x, p.y = rx, ry
		p.frame.Position = UDim2.fromOffset(rx, ry)
	end
	local progress = StructureLayer.progress(s, rt)
	self:_bar(p, progress, x, y, ppt)
	return progress
end

--- One structure drawn on its own (between full passes, the camera still): placed when on screen,
--- its plate let go when not or when it is gone. True while it is built or reloads.
function StructureLayer._visit(
	self: any,
	st: any,
	sid: number,
	rt: number,
	base: number,
	dots: boolean,
	ppt: number
): boolean
	local cam = self.view.rig
	local s = st.structures[sid]
	local p = self._plates[sid]
	if s ~= nil then
		local x, y = cam:tile_to_screen(s.tile)
		local size = base * (SHAPE_SCALE[s.kind + 1] or 1.0)
		if cam:on_screen(x, y, size) then
			if p == nil then
				p = self:_acquire()
				self._plates[sid] = p
			end
			local progress = self:_place(p :: Plate, s, rt, x, y, size, dots, ppt)
			return progress ~= nil or (s.active_tick or 0) > rt
		end
	end
	if p ~= nil then
		self:_release(p)
		self._plates[sid] = nil
	end
	return false
end

function StructureLayer.tick(self: any, _dt: number)
	local st = self._state
	if st == nil then
		return
	end
	-- (a structure added, captured, removed, upgraded or starting to reload is drawn again on its own
	-- next frame: on_structure_* above, forwarded from GameState's signals)
	local cam = self.view.rig
	local rt = st.render_tick or st.tick or 0
	local k = tonumber(st.map and st.map.k_lin) or Rules.K_LIN
	-- the zoom: device px per full-size tile
	local zoom = cam.scale / k * StructureLayer.DEVICE_RATIO
	local icon_scale
	if zoom <= StructureLayer.DOTS_ZOOM then
		icon_scale = StructureLayer.DOT_SCALE
	elseif zoom >= StructureLayer.GROW_ZOOM then
		icon_scale = zoom / StructureLayer.GROW_ZOOM
	else
		icon_scale = math.min(1.0, zoom / StructureLayer.SCALE_FACTOR_OUT)
	end
	local dots = zoom <= StructureLayer.DOTS_ZOOM
	local base = StructureLayer.ICON_SIZE * icon_scale
	local ppt = cam.scale / k
	-- (the one-image atlas arrived: every plate is styled again)
	if one_ready ~= self._one_seen then
		self._one_seen = one_ready
		self._dirty = true
	end
	local anim = self._anim
	local touched = self._touched
	if not self._dirty and cam.version == self._cam_version then
		-- nothing moved: only the plates being built or reloading change (their bar, and their
		-- style once finished) — late games always have some, and redrawing every plate each frame
		-- cost the most there — and those a structure event named (added, captured, removed,
		-- upgraded, a missile fired)
		for sid in touched do
			anim[sid] = true
		end
		table.clear(touched)
		for sid in anim do
			if not self:_visit(st, sid, rt, base, dots, ppt) then
				anim[sid] = nil
			end
		end
		return
	end
	self._dirty = false
	self._cam_version = cam.version
	table.clear(touched)
	table.clear(anim)
	local pass = self._pass + 1
	self._pass = pass
	-- (MapCamera.tile_to_screen and on_screen worked out here, the same sums: every structure on the
	-- map goes through them on every frame of a pan or a pinch, and off the screen that is all it
	-- costs; two method calls each were most of it on a phone, which runs Luau without native code)
	local ax, ay = cam:anchor()
	local sc, cu, cv, W = cam.scale, cam.cu, cam.cv, cam.W
	local vp = cam:viewport_size()
	local vw, vh = vp.X, vp.Y
	local plates = self._plates
	for sid, s in st.structures do
		local tile = s.tile
		local x = ax + (tile % W + 0.5 - cu) * sc
		local y = ay + (tile // W + 0.5 - cv) * sc
		local size = base * (SHAPE_SCALE[s.kind + 1] or 1.0)
		if not (x >= -size and y >= -size and x <= vw + size and y <= vh + size) then
			continue
		end
		local p = plates[sid]
		if p == nil then
			p = self:_acquire()
			plates[sid] = p
		end
		p.pass = pass
		local progress = self:_place(p, s, rt, x, y, size, dots, ppt)
		if progress ~= nil or (s.active_tick or 0) > rt then
			anim[sid] = true
		end
	end
	for sid, p in plates do
		if p.pass ~= pass then
			self:_release(p)
			plates[sid] = nil
		end
	end
end

return StructureLayer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">TrailBudget</string>
              <string name="Source"><![CDATA[--!strict
-- How much of the munitions in flight UnitLayer draws: every trail dot and every target ring is a
-- GUI object, so their number has a ceiling whatever the Sim has in the air.
--
-- A munition's trail is a dot every UnitLayer.TRAIL_STEP along the arc it has flown, MAX at most. All
-- the munitions in flight share BUDGET dots a redraw: with more of them than the budget feeds whole
-- trails, each keeps only its newest dots (the tail behind it), down to none.
--   * A MIRV is 350 warheads (Rules.MIRV_WARHEADS), and the AI fires them at a leader who nears the
--     win. Each warhead had its whole trail and a pulsing target ring. One MIRV on a World map,
--     measured 2026-10-09 on the Mac that measures docs/performance.md: 208 warheads, 16,784 objects
--     in the unit layer where 1,000 had been, 27 ms of its script a frame where 2 had been, frames of
--     183 ms. A player's report the same day: "I went down to like 3fps nearing the end of a rofront
--     game".
--   * so the trails share a budget, and MIRV warheads lose their target rings while many fly.
--
-- Pure Luau (no Roblox types): tests/trail_budget.luau.
local TrailBudget = {}

--- The most dots one trail has.
TrailBudget.MAX = 160
--- Dots a redraw draws for all the trails together.
TrailBudget.BUDGET = 800
--- A MIRV warhead's target ring is drawn while no more than this many munitions are in flight (a
--- scattershot's handful keep theirs; 350 rings said nothing a player could read). Every other
--- munition always has its ring.
TrailBudget.RING_MAX = 24

--- With `flying` trailed munitions in the air: the dots each one keeps (MAX: its whole trail; 0:
--- none), and whether MIRV warheads get their target rings.
function TrailBudget.allowance(flying: number): (number, boolean)
	return math.min(TrailBudget.MAX, TrailBudget.BUDGET // math.max(flying, 1)), flying <= TrailBudget.RING_MAX
end

return TrailBudget
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">UnitLayer</string>
              <string name="Source"><![CDATA[--!native
-- Units on the 2D map:
--   * sprites from the unit atlas (13 x 13 px, drawn 13 full-size tiles wide, so they
--     scale with the map), recoloured: light pixels in the owner's territory
--     colour, dark pixels in its border colour (two tinted mask layers, Pixelated);
--   * ships / trains follow their path tile to tile (the sim's timing: start_tick +
--     ticks_per_tile); warships interpolate prev_tile -> current over a second;
--   * a train is drawn as the engine, TRAIN_CARRIAGES carriages and a
--     tail engine, TRAIN_SPACING full-size tiles apart along the rails behind it (the sim moves one
--     unit; the cars are cosmetic);
--   * nukes fly a cubic Bezier (Rules.nuke_arc: control points a quarter / three quarters
--     along, raised by max(dist / 3, 50 full-size tiles) toward the top, clamped to the map; the
--     Sim flies the same arc), leave a trail in the owner's colour (alpha 0.588) and mark their
--     target with a pulsing blast ring;
--   * shells and SAM missiles are small sprites flying straight to their target;
--   * transport ships leave a wake: the way sailed so far,
--     one full-size tile wide in the owner's territory colour at alpha 0.588, gone with the ship.
--     The ship and its wake follow the route with its corners rounded (Map/WakeRoute: the Sim's
--     paths are straight legs meeting at sharp corners, and the wake was a few straight bars until
--     2026-10-07, when it was made to curve smoothly), drawn as short straight bars.
--
-- What it costs (2026-10-08; players on Windows had stutter bad enough to quit, ten minutes into a
-- match). Twenty minutes into a World match there are 700 units, and with the
-- whole map in view this layer was the frame's biggest cost: 2.9 of the map's 3.5 ms of script a frame,
-- about 3,000 GUI objects and some 9,000 Position writes a second for Roblox to lay out again
-- (docs/performance.md has the trace). So:
--   * a train's cars are drawn only where they can be told apart (CARS_MIN_ZOOM, where the rails fade
--     in too): 2 full-size tiles apart, seven 13-tile sprites are one blob on a map zoomed out, yet
--     they were six of every seven sprites that moved;
--   * a sprite is one image (Sprites.units_one: both of the sprite's colours in one tint) once that atlas
--     has loaded, and until then two, the second inside the first; it was two inside a frame;
--   * while the camera stands still and many sprites are on screen, the whole layer is redrawn 20 to
--     30 times a second, not every frame (THROTTLE_*): at that zoom a ship moves a fraction of a
--     pixel a frame, and a frame in which nothing here changes costs Roblox nothing (MapView's
--     header);
--   * the pools keep a few spares and destroy the rest (POOL_SPARE): every object in this ScreenGui
--     is gone over on each frame something moved, shown or not, and the pools had grown to 7,700.
local RS = game:GetService("ReplicatedStorage")
local Airfront = RS:WaitForChild("Airfront")
local Defs = require(Airfront:WaitForChild("Core"):WaitForChild("Defs")) :: any
local Rules = require(Airfront:WaitForChild("Core"):WaitForChild("Rules")) :: any
local Sprites = require(Airfront:WaitForChild("Assets"):WaitForChild("MapSprites")) :: any
local WakeRoute = require(script.Parent:WaitForChild("WakeRoute")) :: any
local TrailBudget = require(script.Parent:WaitForChild("TrailBudget")) :: any
local FrameClock = require(script.Parent:WaitForChild("FrameClock")) :: any
local ChakraEffects = require(script.Parent:WaitForChild("ChakraEffects"))

--- The one-image sprites (Sprites.units_one) are used once the atlas is known to have loaded: an image
--- still in moderation would leave every unit invisible.
local ONE: any = Sprites.units_one
local one_ready = false
if ONE ~= nil then
	(require(script.Parent:WaitForChild("AtlasReady")) :: any).watch(ONE.id, function()
		one_ready = true
	end)
end

local UnitLayer = {}
UnitLayer.__index = UnitLayer

UnitLayer.UNIT_SIZE = 13 -- full-size tiles
UnitLayer.MIN_PX = 5
UnitLayer.TRAIL_ALPHA = 0.588
UnitLayer.TRAIL_STEP = 2.0 -- full-size tiles between a trail's points
UnitLayer.TRAIL_WIDTH = 0.9 -- a nuke trail's width, map tiles
--- ship wakes: the least a wake is wide on screen (the route's shape: Map/WakeRoute)
UnitLayer.TRAIL_MIN_PX = 1.5
--- Trains: 5 cars, 2 tiles between cars, the nearest car 2 tiles
--- behind the engine and the tail engine last.
UnitLayer.TRAIN_CARRIAGES = 5
UnitLayer.TRAIN_SPACING = 2.0
--- A train's cars are drawn from this zoom on (device px per full-size tile, with
--- RoadLayer's device ratio, where the rails start to fade in): below it the engine stands for the train.
UnitLayer.CARS_MIN_ZOOM = 3.0
UnitLayer.DEVICE_RATIO = 2.0
--- With the camera still and this many unit sprites on screen, the layer is redrawn no sooner than
--- THROTTLE_S after the last time (every second frame at 60 a second); from THROTTLE_3 on,
--- THROTTLE_3_S (every third). While a munition flies or a unit is selected, THROTTLE_S at most.
UnitLayer.THROTTLE_FROM = 160
UnitLayer.THROTTLE_3 = 480
UnitLayer.THROTTLE_S = 0.030
UnitLayer.THROTTLE_3_S = 0.045
--- Sprites, wake bars and trail dots kept hidden for reuse; the rest are destroyed.
UnitLayer.POOL_SPARE = 48
UnitLayer.Z = 14

-- unit atlas columns
local COL_TRANSPORT, COL_TRADE, COL_WARSHIP = 0, 1, 2
local COL_ATOM, COL_HYDROGEN, COL_MIRV, COL_SAM, COL_SHELL, COL_WARHEAD, COL_TRAIN = 3, 4, 5, 6, 7, 8, 9
local COL_CARRIAGE = 10
local UNIT_COL = {
	[Defs.U_TRANSPORT] = COL_TRANSPORT,
	[Defs.U_TRADE] = COL_TRADE,
	[Defs.U_WARSHIP] = COL_WARSHIP,
	[Defs.U_TRUCK] = COL_TRAIN,
}
local CHAKRA = ChakraEffects.profiles(Defs)

local NUKE_COL = {
	[Defs.N_ATOM] = COL_ATOM,
	[Defs.N_HYDROGEN] = COL_HYDROGEN,
	[Defs.N_MIRV] = COL_MIRV,
	[Defs.N_WARHEAD] = COL_WARHEAD,
	-- the Arsenal's munitions (Data/Arsenal) wear existing sprites: a mega nuke the hydrogen bomb,
	-- a scattershot the MIRV, an air strike the missile, a railgun slug the shell
	[Defs.N_MEGA] = COL_HYDROGEN,
	[Defs.N_SCATTER] = COL_MIRV,
	[Defs.N_SHELL] = COL_SHELL,
	[Defs.N_AIRSTRIKE] = COL_SAM,
	[Defs.N_SLUG] = COL_SHELL,
}
--- Munitions drawn without a trail and a target ring (a battery's shells: there are many).
local NUKE_PLAIN = { [Defs.N_SHELL] = true }
--- Munitions drawn bigger than the others.
local NUKE_SCALE = { [Defs.N_MEGA] = 1.5, [Defs.N_SHELL] = 0.75, [Defs.N_SLUG] = 1.2 }

type Sprite = {
	frame: ImageLabel,
	fill: ImageLabel,
	--- nil: a one-image sprite
	rim: ImageLabel?,
	col: number,
	owner: number,
	px: number,
	x: number,
	y: number,
}

-- Sprite keys are numbers (a string per sprite per frame churned the GC in late games): id * 16 +
-- the kind of sprite (a unit 0, its train cars 1..6, a nuke 8, a shell 9, a SAM missile 10).
local KEY_NUKE, KEY_SHELL, KEY_SAM = 8, 9, 10

local function border_of(c: Color3): Color3
	local h, s, v = c:ToHSV()
	-- HSL lightness - 0.125 approximated in HSV (value drop keeps hue / saturation)
	return Color3.fromHSV(h, s, math.max(0, v - 0.16))
end

function UnitLayer.new(parent: Instance, view: any)
	local self = setmetatable({}, UnitLayer) :: any
	local root = Instance.new("Frame")
	root.Name = "Units"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.ZIndex = UnitLayer.Z
	root.Parent = parent
	self.root = root
	self._chakra = ChakraEffects.new(root, UnitLayer.Z + 1, 8)
	self.view = view
	self._state = nil :: any
	self._sprites = {} :: { [number]: Sprite }
	self._seen = {} :: { [number]: boolean }
	self._pool = {} :: { Sprite }
	self._dots = {} :: { Frame }
	self._dots_used = 0
	--- wake bars: the Frame and what it was last given (a still camera writes nothing)
	self._bars = {} :: { { [string]: any } }
	self._bars_used = 0
	--- uid -> the ship's path (to notice a new one), its smooth route (WakeRoute) and where the
	--- ship is on it this frame (map tiles)
	self._wakes = {} :: { [number]: { path: { number }, route: any, x: number, y: number } }
	self._rings = {} :: { [number]: Frame }
	self._selected = -1
	self._sel_ring = self:_ring(root, "Selected", UnitLayer.Z + 3)
	--- uid -> screen pos this frame, of the units a press can pick (warships, transports)
	self._screen = {} :: { [number]: Vector2 }
	--- the throttle: the camera's version and the sprite size last frame, the unit sprites drawn then,
	--- and when
	self._cam_seen = -1
	self._px_seen = -1
	self._drawn = 0
	self._drawn_at = 0.0
	return self
end

function UnitLayer.bind(self: any, state: any)
	self:unbind()
	self._state = state
end

function UnitLayer.unbind(self: any)
	self._state = nil
	self._chakra:clear()
	for key, s in self._sprites do
		self:_release(s)
		self._sprites[key] = nil
	end
	for uid, r in self._rings do
		r:Destroy()
		self._rings[uid] = nil
	end
	for _, d in self._dots do
		d.Visible = false
	end
	for _, b in self._bars do
		b.shown = false
		b.f.Visible = false
	end
	table.clear(self._wakes)
	self._sel_ring.Visible = false
	table.clear(self._screen)
end

function UnitLayer.destroy(self: any)
	self:unbind()
	self.root:Destroy()
end

function UnitLayer.set_selected(self: any, uid: number)
	self._selected = uid
end

-- ---------------------------------------------------------------------------------------------
-- Pools
-- ---------------------------------------------------------------------------------------------

function UnitLayer._ring(_self: any, parent: Instance, name: string, z: number): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundTransparency = 1
	f.ZIndex = z
	f.Visible = false
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
	local s = Instance.new("UIStroke")
	s.Thickness = 2
	s.Color = Color3.new(1, 1, 1)
	s.Parent = f
	f.Parent = parent
	return f
end

local function mask(parent: Instance, name: string, row: number, z: number): ImageLabel
	local l = Instance.new("ImageLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Image = Sprites.units.id
	l.ImageRectSize = Vector2.new(Sprites.units.cell, Sprites.units.cell)
	l.ImageRectOffset = Vector2.new(0, row * Sprites.units.cell)
	l.ResampleMode = Enum.ResamplerMode.Pixelated
	l.Size = UDim2.fromScale(1, 1)
	l.ZIndex = z
	l.Parent = parent
	return l
end

function UnitLayer._acquire(self: any): Sprite
	local s = table.remove(self._pool)
	if s then
		s.frame.Visible = true
		return s
	end
	-- (one object a sprite; two, the rim inside the fill, while the one-image atlas isn't here)
	local fill = mask(nil :: any, "Unit", 0, UnitLayer.Z)
	fill.AnchorPoint = Vector2.new(0.5, 0.5)
	local rim: ImageLabel? = nil
	if one_ready then
		fill.Image = ONE.id
	else
		rim = mask(fill, "Rim", 1, UnitLayer.Z + 1)
	end
	fill.Parent = self.root
	return { frame = fill, fill = fill, rim = rim, col = -1, owner = -1, px = -1, x = -1e9, y = -1e9 }
end

function UnitLayer._release(self: any, s: Sprite)
	if #self._pool >= UnitLayer.POOL_SPARE then
		s.frame:Destroy()
		return
	end
	s.frame.Visible = false
	s.col = -1
	s.owner = -1
	s.x, s.y = -1e9, -1e9
	table.insert(self._pool, s)
end

function UnitLayer._sprite(
	self: any,
	key: number,
	col: number,
	owner: number,
	x: number,
	y: number,
	px: number,
	seen: { [number]: boolean }
)
	seen[key] = true
	local s = self._sprites[key]
	if s == nil then
		s = self:_acquire()
		self._sprites[key] = s
	end
	if s.col ~= col then
		s.col = col
		local cell = Sprites.units.cell
		s.fill.ImageRectOffset = Vector2.new(col * cell, 0)
		if s.rim ~= nil then
			s.rim.ImageRectOffset = Vector2.new(col * cell, cell)
		end
	end
	if s.owner ~= owner then
		s.owner = owner
		local c = self._state:owner_color(owner)
		s.fill.ImageColor3 = c
		if s.rim ~= nil then
			s.rim.ImageColor3 = border_of(c)
		end
	end
	if s.px ~= px then
		s.px = px
		s.frame.Size = UDim2.fromOffset(px, px)
	end
	-- (a GUI property write per sprite per frame adds up: only when it moved a pixel)
	local rx, ry = math.round(x), math.round(y)
	if rx ~= s.x or ry ~= s.y then
		s.x, s.y = rx, ry
		s.frame.Position = UDim2.fromOffset(rx, ry)
	end
end

function UnitLayer._dot(self: any, x: number, y: number, px: number, col: Color3)
	self._dots_used += 1
	local d = self._dots[self._dots_used]
	if d == nil then
		d = Instance.new("Frame")
		d.Name = "ChakraOrb"
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = d
		d.AnchorPoint = Vector2.new(0.5, 0.5)
		d.BorderSizePixel = 0
		d.BackgroundTransparency = 1 - UnitLayer.TRAIL_ALPHA
		d.ZIndex = UnitLayer.Z - 1
		d.Parent = self.root
		self._dots[self._dots_used] = d
	end
	d.Visible = true
	d.BackgroundColor3 = col
	d.Size = UDim2.fromOffset(px, px)
	d.Position = UDim2.fromOffset(math.round(x), math.round(y))
end

--- A straight wake bar between two screen points, `w` px thick.
function UnitLayer._bar(self: any, x0: number, y0: number, x1: number, y1: number, w: number, col: Color3)
	self._bars_used += 1
	local b = self._bars[self._bars_used]
	if b == nil then
		local f = Instance.new("Frame")
		f.Name = "Wake"
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BorderSizePixel = 0
		f.BackgroundTransparency = 1 - UnitLayer.TRAIL_ALPHA
		f.ZIndex = UnitLayer.Z - 1
		f.Parent = self.root
		b = { f = f, shown = true }
		self._bars[self._bars_used] = b
	end
	local f: Frame = b.f
	if not b.shown then
		b.shown = true
		f.Visible = true
	end
	if b.col ~= col then
		b.col = col
		f.BackgroundColor3 = col
	end
	if b.x0 ~= x0 or b.y0 ~= y0 or b.x1 ~= x1 or b.y1 ~= y1 or b.w ~= w then
		b.x0, b.y0, b.x1, b.y1, b.w = x0, y0, x1, y1, w
		local dx, dy = x1 - x0, y1 - y0
		local len = math.sqrt(dx * dx + dy * dy)
		f.Position = UDim2.fromOffset((x0 + x1) * 0.5, (y0 + y1) * 0.5)
		f.Size = UDim2.fromOffset(math.max(len, w), w)
		f.Rotation = if len > 0 then math.deg(math.atan2(dy, dx)) else 0
	end
end

--- A route's straight runs (Map/WakeRoute.runs).
UnitLayer.wake_runs = WakeRoute.runs

-- ---------------------------------------------------------------------------------------------
-- Poses (map tiles)
-- ---------------------------------------------------------------------------------------------

local function centre(t: number, W: number): (number, number)
	return t % W + 0.5, t // W + 0.5
end

--- Tiles of its path a unit has moved through at `rt` (fractional).
function UnitLayer.path_done(u: any, rt: number): number
	return math.max(0.0, (rt - u.start_tick) * 100.0 / math.max(u.ticks_per_tile_x100, 1))
end

--- Map position of a moving unit at `rt` (fractional ticks).
function UnitLayer.unit_uv(st: any, u: any, rt: number): (number, number)
	local path = u.path
	local n = #path
	if u.kind == Defs.U_WARSHIP and (u.prev_tile or -1) >= 0 then
		local W = st.map.W or Defs.W
		local cx, cy = centre(if n > 0 then path[1] else 0, W)
		local ax, ay = centre(u.prev_tile, W)
		local f = math.clamp((rt - (u.move_tick or 0)) / Defs.TICK_RATE, 0, 1)
		return ax + (cx - ax) * f, ay + (cy - ay) * f
	end
	return UnitLayer.path_uv(st, u, UnitLayer.path_done(u, rt))
end

--- Map position `done` tiles along a unit's path (clamped to its ends).
function UnitLayer.path_uv(st: any, u: any, done: number): (number, number)
	local W = st.map.W or Defs.W
	local path = u.path
	local n = #path
	if n < 2 then
		return centre(if n > 0 then path[1] else 0, W)
	end
	done = math.max(0.0, done)
	local seg = math.min(math.floor(done), n - 2)
	local f = math.clamp(done - seg, 0, 1)
	local ax, ay = centre(path[seg + 1], W)
	local bx, by = centre(path[seg + 2], W)
	return ax + (bx - ax) * f, ay + (by - ay) * f
end

--- What a redraw draws for the munitions in `nukes` (GameState.nukes): the trail dots each one keeps
--- and whether MIRV warheads get their target rings (Map/TrailBudget: hundreds fly at once).
function UnitLayer.trail_allowance(nukes: { [number]: any }): (number, boolean)
	local flying = 0
	for _, n in nukes do
		if not NUKE_PLAIN[n.kind] then
			flying += 1
		end
	end
	return TrailBudget.allowance(flying)
end

--- A nuke's position at flight fraction t: its arc (Rules.nuke_arc, a Bezier toward the top,
--- constant speed along it), the same path the Sim flies and SAMs intercept. Built once per nuke.
function UnitLayer.nuke_uv(st: any, n: any, t: number): (number, number)
	local R = st.rules or Rules
	local arc = n._arc
	if arc == nil then
		-- (a shell, an air strike and a slug fly straight: Rules.munition_arc)
		arc = R.munition_arc(st.map.W or Defs.W, st.map.H or Defs.H, n.from_tile, n.to_tile, n.kind)
		n._arc = arc
	end
	return R.nuke_arc_at(arc, t)
end

-- ---------------------------------------------------------------------------------------------
-- Frame
-- ---------------------------------------------------------------------------------------------

function UnitLayer.tick(self: any, _dt: number)
	local st = self._state
	if st == nil then
		return
	end
	local cam = self.view.rig
	local rt = st.render_tick or st.tick or 0
	local k = tonumber(st.map and st.map.k_lin) or Rules.K_LIN
	local px = math.max(UnitLayer.MIN_PX, math.round(UnitLayer.UNIT_SIZE / k * cam.scale))
	-- a still camera over a crowded map: not every frame (see the header)
	local still = cam.version == self._cam_seen and px == self._px_seen and (cam._shake or 0) <= 0.01
	self._cam_seen, self._px_seen = cam.version, px
	local clock = FrameClock.now()
	if still and self._drawn >= UnitLayer.THROTTLE_FROM then
		local lively = self._selected >= 0
			or next(st.nukes) ~= nil
			or next(st.shells) ~= nil
			or next(st.sam_missiles) ~= nil
		local wait_s = if self._drawn >= UnitLayer.THROTTLE_3 and not lively
			then UnitLayer.THROTTLE_3_S
			else UnitLayer.THROTTLE_S
		if clock - self._drawn_at < wait_s then
			return
		end
	end
	self._drawn_at = clock
	local seen = self._seen
	table.clear(seen)
	self._dots_used = 0
	self._bars_used = 0
	table.clear(self._screen)
	local cars_shown = cam.scale / k * UnitLayer.DEVICE_RATIO >= UnitLayer.CARS_MIN_ZOOM
	local drawn = 0
	-- transport ships' wakes (under the sprites)
	local map = st.map
	local W0 = map.W or Defs.W
	local wake_w = math.max(UnitLayer.TRAIL_MIN_PX, cam.scale / k)
	for uid, w in self._wakes do
		local u = st.units[uid]
		if u == nil or u.path ~= w.path then
			self._wakes[uid] = nil
		end
	end
	for uid, u in st.units do
		if u.kind ~= Defs.U_TRANSPORT or #u.path < 2 then
			continue
		end
		local w = self._wakes[uid]
		if w == nil then
			-- (a curve may not pass over land: the map's water bodies, 0 on land)
			local wb, N0 = map.water_body, map.N or 0
			local is_water = if wb ~= nil
				then function(t: number): boolean
					return t >= 0 and t < N0 and buffer.readu16(wb, t * 2) ~= 0
				end
				else nil
			w = { path = u.path, route = WakeRoute.build(u.path, W0, k, is_water), x = 0, y = 0 }
			self._wakes[uid] = w
		end
		local route = w.route
		local ux, uy, seg = WakeRoute.at(route, UnitLayer.path_done(u, rt))
		w.x, w.y = ux, uy
		local c = st:owner_color(u.owner)
		local xs, ys = route.xs, route.ys
		local sx0, sy0 = cam:map_to_screen(xs[1], ys[1])
		for j = 1, seg do
			local sx1, sy1
			if j < seg then
				sx1, sy1 = cam:map_to_screen(xs[j + 1], ys[j + 1])
			else
				sx1, sy1 = cam:map_to_screen(ux, uy)
			end
			local half = math.abs(sx1 - sx0) + math.abs(sy1 - sy0)
			if half > 0 and cam:on_screen((sx0 + sx1) * 0.5, (sy0 + sy1) * 0.5, half * 0.5 + wake_w) then
				self:_bar(sx0, sy0, sx1, sy1, wake_w, c)
			end
			sx0, sy0 = sx1, sy1
		end
	end
	-- ships / trains
	local U_TRUCK, U_TRANSPORT, U_WARSHIP = Defs.U_TRUCK, Defs.U_TRANSPORT, Defs.U_WARSHIP
	local cars = UnitLayer.TRAIN_CARRIAGES
	for uid, u in st.units do
		local kind = u.kind
		local col = UNIT_COL[kind]
		if col == nil then
			continue
		end
		local pick = kind == U_TRANSPORT or kind == U_WARSHIP
		if kind == U_TRUCK and cars_shown then
			-- the cars behind the engine, back to front (the engine is drawn last, on top)
			local done = UnitLayer.path_done(u, rt)
			local step = UnitLayer.TRAIN_SPACING / k
			for j = cars + 1, 1, -1 do
				local cx, cy = cam:map_to_screen(UnitLayer.path_uv(st, u, done - j * step))
				if cam:on_screen(cx, cy, px) then
					self:_sprite(uid * 16 + j, if j > cars then COL_TRAIN else COL_CARRIAGE, u.owner, cx, cy, px, seen)
					drawn += 1
				end
			end
		end
		-- (a transport rides its smoothed route, at the head of its wake)
		local wake = if kind == U_TRANSPORT then self._wakes[uid] else nil
		local x, y
		if wake ~= nil then
			x, y = cam:map_to_screen(wake.x, wake.y)
		else
			x, y = cam:map_to_screen(UnitLayer.unit_uv(st, u, rt))
		end
		if not cam:on_screen(x, y, px) then
			continue
		end
		if pick then
			self._screen[uid] = Vector2.new(x, y)
		end
		self:_sprite(uid * 16, col, u.owner, x, y, px, seen)
		drawn += 1
	end
	self._drawn = drawn
	-- nukes: trail, sprite, target ring
	local now = FrameClock.now()
	self._chakra:beginFrame()
	local rings_seen = {}
	local trail_dots, rings_for_warheads = UnitLayer.trail_allowance(st.nukes)
	local heavyTrails = 0
	for uid, n in st.nukes do
		local t = math.clamp((rt - n.launch_tick) / math.max(n.flight_ticks, 1), 0, 1)
		local col = NUKE_COL[n.kind] or COL_ATOM
		local npx = px * (NUKE_SCALE[n.kind] or 1)
		if NUKE_PLAIN[n.kind] then
			local sx0, sy0 = cam:map_to_screen(UnitLayer.nuke_uv(st, n, t))
			if cam:on_screen(sx0, sy0, npx) then
				self:_sprite(uid * 16 + KEY_NUKE, col, n.owner, sx0, sy0, npx, seen)
			end
			continue
		end
		local chakra = CHAKRA[n.kind]
		local c = if chakra then chakra.color else st:owner_color(n.owner)
		local heavyTrail = chakra ~= nil and heavyTrails < 8
		if heavyTrail then heavyTrails += 1 end
		-- trail: the curve flown so far, a line through points every TRAIL_STEP full-size tiles, up to
		-- the munition (it was a dot at each point, spaced wider than a dot: a broken line that looked
		-- glitchy; solid since 2026-10-12)
		local W = st.map.W or Defs.W
		local sx, sy = centre(n.from_tile, W)
		local dx, dy = centre(n.to_tile, W)
		local len = math.sqrt((dx - sx) ^ 2 + (dy - sy) ^ 2) * 1.4 + 1
		local steps = math.clamp(math.floor(len * k / UnitLayer.TRAIL_STEP), 2, TrailBudget.MAX)
		local thick = math.max(2, math.round(cam.scale * UnitLayer.TRAIL_WIDTH))
		local x, y = cam:map_to_screen(UnitLayer.nuke_uv(st, n, t))
		-- (the newest `trail_dots` points: the whole trail unless many munitions fly at once)
		local newest = math.floor(steps * t)
		local px0, py0 = nil, nil
		local hovering = n.kind == Defs.N_HYDROGEN
		local massColor = if chakra then c:Lerp(Color3.new(1, 1, 1), 0.57) else c
		for i = math.max(0, newest - trail_dots + 1), (if hovering then -1 else newest + 1) do
			local tx, ty
			if i > newest then
				tx, ty = x, y
			else
				tx, ty = cam:map_to_screen(UnitLayer.nuke_uv(st, n, i / steps))
			end
			if px0 ~= nil and (cam:on_screen(tx, ty, thick) or cam:on_screen(px0, py0, thick)) then
				if heavyTrail and i >= newest - 19 then
					local fade = math.clamp(1 - (newest - i) / 20, 0.05, 1)
					local width = thick * (1 + fade * (if chakra.mode == "meteor" then 7 else 5))
					self:_bar(px0, py0, tx, ty, width, c:Lerp(Color3.new(0.15, 0.04, 0.17), 0.37))
					self:_bar(px0, py0, tx, ty, width * 0.48, c)
					self:_bar(px0, py0, tx, ty, width * 0.16, massColor)
					if i % 3 == 0 then
						local wobble = math.sin(i * 2.24 + now * 22) * width * 0.72
						self:_dot(tx + wobble, ty - wobble, width * 0.27, massColor)
					end
				else
					self:_bar(px0, py0, tx, ty, thick, c)
				end
			end
			px0, py0 = tx, ty
		end
		if hovering and chakra and cam:on_screen(x, y, 230) then
			local age = t * n.flight_ticks
			local descent = math.clamp(age / Rules.GRAVITY_DESCENT_TICKS, 0, 1)
			local pull = math.clamp((age - Rules.GRAVITY_DESCENT_TICKS) / Rules.GRAVITY_HOLD_TICKS, 0, 1)
			local height = math.clamp(npx * 3.6, 38, 100)
			self._chakra:gravity(chakra, x, y, height, descent, pull, now % 1000)
		elseif not hovering and cam:on_screen(x, y, npx) then
			if chakra ~= nil then
				local size = math.max(5, npx * (if n.kind == Defs.N_SCATTER then 1.45 else 0.9))
				local fx, fy = cam:map_to_screen(UnitLayer.nuke_uv(st, n, math.min(1, t + 0.015)))
				local heading = math.atan2(fy - y, fx - x)
				if not self._chakra:flight(chakra, x, y, size * 3.1, now % 1000, t, heading) then
					self:_dot(x, y, size, chakra.color)
					self:_dot(x, y, size * 0.62, chakra.core)
				end
			else
				self:_sprite(uid * 16 + KEY_NUKE, col, n.owner, x, y, npx, seen)
			end
		end
		if n.kind == Defs.N_WARHEAD and not rings_for_warheads then
			continue
		end
		-- (none for a MIRV itself, rings only for the atom, the
		-- hydrogen bomb and the warhead; a ring as wide as its spread, 1,500 full-size tiles, tinted
		-- the whole screen for the seconds it flew, 2026-10-12)
		if n.kind == Defs.N_MIRV then
			continue
		end
		-- target: the blast ring, pulsing (red when it hits the local player)
		local ViewRules = self.view.view_rules
		local _, outer = 0, 12
		if ViewRules then
			_, outer = ViewRules.nuke_radii(n.kind)
		end
		local ring = self._rings[uid]
		if ring == nil then
			ring = self:_ring(self.root, "NukeTarget", UnitLayer.Z - 2)
			self._rings[uid] = ring
		end
		rings_seen[uid] = true
		local rx, ry = cam:tile_to_screen(n.to_tile)
		local d = math.max(8, outer * 2 * cam.scale)
		ring.Size = UDim2.fromOffset(d, d)
		ring.Position = UDim2.fromOffset(math.round(rx), math.round(ry))
		local mine = st:tile_owner(n.to_tile) == st.local_owner and st.local_owner ~= 0
		local rc = if mine then Color3.new(1, 0.16, 0.12) else c
		local stroke = ring:FindFirstChildOfClass("UIStroke") :: UIStroke
		stroke.Color = rc
		stroke.Transparency = 0.2 + 0.3 * (0.5 + 0.5 * math.sin(now * 6))
		ring.BackgroundColor3 = rc
		ring.BackgroundTransparency = 0.85
		ring.Visible = true
	end
	for uid, r in self._rings do
		if not rings_seen[uid] then
			r:Destroy()
			self._rings[uid] = nil
		end
	end
	-- shells: from the shooter's tile to the target unit, arriving at impact_tick
	local W = st.map.W or Defs.W
	for id, sh in st.shells do
		local target = st.units[sh.target_uid]
		if target == nil then
			continue
		end
		local t = math.clamp((rt - sh.fire_tick) / math.max(sh.impact_tick - sh.fire_tick, 1), 0, 1)
		local ax, ay = centre(sh.from_tile, W)
		local bx, by = UnitLayer.unit_uv(st, target, sh.impact_tick)
		local x, y = cam:map_to_screen(ax + (bx - ax) * t, ay + (by - ay) * t)
		if cam:on_screen(x, y, px) then
			local owner = if sh.shooter_kind == 0 and st.units[sh.shooter_id]
				then st.units[sh.shooter_id].owner
				else st:tile_owner(sh.from_tile)
			self:_sprite(id * 16 + KEY_SHELL, COL_SHELL, owner, x, y, px, seen)
		end
	end
	-- SAM missiles: from the SAM to the nuke's position at the intercept
	for nuke_uid, m in st.sam_missiles do
		local n = st.nukes[nuke_uid]
		local sam = st.structures[m.sam_sid]
		if n == nil or sam == nil then
			continue
		end
		local t = math.clamp((rt - m.fire_tick) / math.max(m.intercept_tick - m.fire_tick, 1), 0, 1)
		local ax, ay = centre(sam.tile, W)
		local ti = math.clamp((m.intercept_tick - n.launch_tick) / math.max(n.flight_ticks, 1), 0, 1)
		local bx, by = UnitLayer.nuke_uv(st, n, ti)
		local x, y = cam:map_to_screen(ax + (bx - ax) * t, ay + (by - ay) * t)
		if cam:on_screen(x, y, px) then
			self:_sprite(nuke_uid * 16 + KEY_SAM, COL_SAM, sam.owner, x, y, px, seen)
		end
	end
	for key, s in self._sprites do
		if not seen[key] then
			self:_release(s)
			self._sprites[key] = nil
		end
	end
	-- (the pools: a few spares stay hidden, the rest go)
	local spare = UnitLayer.POOL_SPARE
	self._chakra:endFrame()
	for i = #self._dots, self._dots_used + 1, -1 do
		local d = self._dots[i]
		if i > self._dots_used + spare then
			d:Destroy()
			self._dots[i] = nil
		elseif d.Visible then
			d.Visible = false
		end
	end
	for i = #self._bars, self._bars_used + 1, -1 do
		local b = self._bars[i]
		if i > self._bars_used + spare then
			b.f:Destroy()
			self._bars[i] = nil
		elseif b.shown then
			b.shown = false
			b.f.Visible = false
		end
	end
	-- selection ring
	local sp = self._screen[self._selected]
	if sp then
		local ring = self._sel_ring
		ring.Size = UDim2.fromOffset(px * 2, px * 2)
		ring.Position = UDim2.fromOffset(math.round(sp.X), math.round(sp.Y))
		ring.Visible = true
	else
		self._sel_ring.Visible = false
	end
end

--- The warship or transport drawn nearest `pos` within `radius_px`, or -1.
function UnitLayer.unit_at_screen(self: any, pos: Vector2, radius_px: number): number
	local st = self._state
	if st == nil then
		return -1
	end
	local best, best_d = -1, radius_px
	for uid, p in self._screen do
		local u = st.units[uid]
		if u and (u.kind == Defs.U_WARSHIP or u.kind == Defs.U_TRANSPORT) then
			local d = (p - pos).Magnitude
			if d <= best_d then
				best, best_d = uid, d
			end
		end
	end
	return best
end

return UnitLayer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">ViewRules</string>
              <string name="Source"><![CDATA[--!strict
-- Port of scripts/view/view_rules.gd — gameplay numbers the view draws (SAM / defense ranges, nuke
-- radii, interception odds), read from Rules at runtime so range rings and aim previews follow the
-- Sim when it is retuned. Prefers Rules' functions and falls back to the older constants.
--
-- Range metric (must match the Sim): covered <=> (dx * xs)^2 + dy^2 <= r^2 in grid tiles, dx wrapping
-- at W, xs = max(cos(lat of the target tile's row), 0.08) — Defs.range_d2 == SimState.range_d2.
local RS = game:GetService("ReplicatedStorage")
local Core = RS:WaitForChild("Airfront"):WaitForChild("Core")
local Defs = require(Core:WaitForChild("Defs")) :: any
local BaseRules = require(Core:WaitForChild("Rules")) :: any
--- The bound map's scaled rules (GameState.rules = Rules.for_map): ranges are in its tiles.
local Rules = BaseRules

local ViewRules = {}

--- Draw with `rules` (the bound state's Rules.for_map table); nil = the K_LIN 1 defaults.
function ViewRules.use(rules: any?)
	Rules = if rules ~= nil then rules else BaseRules
end

local function num(v: any, default: number): number
	return if type(v) == "number" then v else default
end

--- SAM interception range (tiles) for a SAM of `level`.
function ViewRules.sam_range(level: number?): number
	if type(Rules.sam_range) == "function" then
		return Rules.sam_range(level or 1)
	end
	return num(Rules.SAM_RADIUS, 0)
end

--- SAM range `ticks_since_upgrade` ticks after it reached `level` (grows over SAM_UPGRADE_TICKS).
function ViewRules.sam_range_at(level: number, ticks_since_upgrade: number): number
	if type(Rules.sam_range_at) == "function" then
		return Rules.sam_range_at(level, ticks_since_upgrade)
	end
	return ViewRules.sam_range(level)
end

function ViewRules.sam_upgrade_ticks(): number
	return num(Rules.SAM_UPGRADE_TICKS, 0)
end

--- Construction time (ticks) of structure kind `kind` (Defs.S_*).
function ViewRules.build_ticks(kind: number): number
	local bt = Rules.BUILD_TICKS
	if type(bt) == "table" then
		return num(bt[kind], 0)
	end
	return 0
end

--- Warship patrol radius around its patrol point (tiles).
function ViewRules.warship_patrol_range(): number
	if type(Rules.warship_patrol_range) == "function" then
		return Rules.warship_patrol_range()
	end
	if Rules.WARSHIP_PATROL_FULL ~= nil and Rules.K_LIN ~= nil then
		return Rules.WARSHIP_PATROL_FULL / Rules.K_LIN
	end
	return num(Rules.WARSHIP_PATROL_RADIUS, 0)
end

--- Warship targeting range (tiles).
function ViewRules.warship_target_range(): number
	if type(Rules.warship_target_range) == "function" then
		return Rules.warship_target_range()
	end
	if type(Rules.warship_range) == "function" then
		return Rules.warship_range()
	end
	return num(Rules.WARSHIP_RANGE, 0)
end

--- Train-station reach of a factory (tiles), shown by its ghost.
function ViewRules.factory_range(): number
	return num(Rules.ROAD_MAX_TILES, 0)
end

--- The Arsenal (Data/Arsenal): an Artillery battery's range and an Airfield's reach (tiles).
function ViewRules.artillery_range(): number
	return if type(Rules.artillery_range) == "function" then Rules.artillery_range() else 45
end

function ViewRules.airfield_range(): number
	return if type(Rules.launch_range) == "function" then Rules.launch_range(Defs.N_AIRSTRIKE) else 156
end

--- Defense-post protection radius (tiles).
function ViewRules.defense_range(): number
	if type(Rules.defense_range) == "function" then
		return Rules.defense_range()
	end
	return num(Rules.DEFENSE_RADIUS, 0)
end

--- inner, outer blast radii in tiles of nuke kind `kind` (Defs.N_*). MIRV: 0, spread.
function ViewRules.nuke_radii(kind: number): (number, number)
	if type(Rules.nuke_radii) == "function" then
		local a, b = Rules.nuke_radii(kind)
		if type(a) == "number" and type(b) == "number" then
			return a, b
		end
	end
	if kind == Defs.N_MIRV then
		return 0, num(Rules.MIRV_SPREAD, 0)
	end
	local radii = Rules.NUKE_RADIUS
	local outer = if type(radii) == "table" then num(radii[kind], 0) else 0
	return outer * num(Rules.NUKE_INNER, 1.0), outer
end

--- Nuke kind (Defs.N_*) whose outer radius rounds to `radius_tiles`, or -1.
function ViewRules.nuke_kind_for_radius(radius_tiles: number): number
	for _, k in { Defs.N_ATOM, Defs.N_HYDROGEN, Defs.N_MIRV } do
		local _, o = ViewRules.nuke_radii(k)
		if o > 0 and (math.floor(o) == radius_tiles or Defs.round(o) == radius_tiles) then
			return k
		end
	end
	return -1
end

--- Radius of a human player's spawn disk (Sim._claim_disk claims sqrt(R^2 + R)).
function ViewRules.spawn_radius(): number
	return num(Rules.SPAWN_RADIUS_HUMAN, 4)
end

--- Chance that one ready hostile SAM shoots down nuke kind `kind` (0 = can't be intercepted).
function ViewRules.intercept_p(kind: number): number
	local p = Rules.NUKE_INTERCEPT_P
	if type(p) == "table" and p[kind] ~= nil then
		return p[kind]
	end
	return 1.0
end

--- Squared range distance (tiles) from structure tile `centre` to tile `t` in the Sim's metric.
function ViewRules.range_d2(centre: number, t: number): number
	return Defs.range_d2(centre, t)
end

return ViewRules
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">WakeRoute</string>
              <string name="Source"><![CDATA[--!native
-- A transport ship's route as a smooth line (UnitLayer draws the ship and its wake along it).
--
-- The Sim's water paths are string-pulled (SimNav._smooth): long straight legs that meet at sharp
-- corners in open water, and near a coast, where no straight line is free, a staircase of two-tile
-- steps. Drawn as they are, a wake was a few straight bars and some jitter (2026-10-07: boat
-- trails looked like straight lines; they should curve smoothly). Here:
--   1. the path is cut into straight legs that stay within TOL tiles of its tiles (a staircase is
--      one leg; measured on 200 World routes, 8 of 10 legs were under 8 tiles before);
--   2. every corner is rounded: the route leaves a leg up to CORNER full-size tiles before the corner
--      (never more than half the leg) and joins the next one as far after it, along a quadratic
--      Bezier whose control point is the corner, cut into short straight pieces (one per ARC_STEP
--      of turn).
--   * The curve passes inside the corner. Where that would put it on land (a corner at a cape; a
--     tile's width of shore is let pass, as a leg may) it is tried at half and at a quarter the
--     size, and the corner stays sharp if none fits.
--   * Each point carries how many path tiles along the route it is (`ss`), so the ship is placed by
--     the Sim's own timing (tiles sailed) and reaches both ends of every curve when it would have
--     reached them on the legs.
--
-- Pure Luau (no Roblox types): tests/wake_route.luau.

local WakeRoute = {}

--- A straight leg may stray this far (tiles) from the path's tiles.
WakeRoute.TOL = 1.5
--- Full-size tiles of each leg a corner's curve may take (a ship is drawn 13 wide).
WakeRoute.CORNER = 16.0
--- Legs that turn less than this meet as they are.
WakeRoute.MIN_TURN = math.rad(2.0)
--- One straight piece per this much turn, at least ARC_MIN and at most ARC_MAX a corner.
WakeRoute.ARC_STEP = math.rad(9.0)
WakeRoute.ARC_MIN = 3
WakeRoute.ARC_MAX = 12
--- The smallest curve worth drawing (tiles of leg).
WakeRoute.MIN_CUT = 1.0

export type Route = { xs: { number }, ys: { number }, ss: { number }, n: number }

--- A path as straight runs: path index pairs {a, b} (consecutive, a < b), each staying within TOL
--- tiles of every tile it passes. A run ends where the path is farthest from the straight line
--- (Ramer-Douglas-Peucker), so a corner of the path is a corner of the runs.
function WakeRoute.runs(path: { number }, W: number): { { number } }
	local n = #path
	if n < 2 then
		return {}
	end
	local tol2 = WakeRoute.TOL * WakeRoute.TOL
	-- keep[i]: path index i ends a run. Spans still to split wait on a stack (a, b pairs).
	local keep = table.create(n, false)
	keep[1], keep[n] = true, true
	local stack = { 1, n }
	local top = 2
	while top > 0 do
		local b, a = stack[top], stack[top - 1]
		top -= 2
		if b - a < 2 then
			continue
		end
		local ax, ay = path[a] % W, path[a] // W
		local dx, dy = path[b] % W - ax, path[b] // W - ay
		local len2 = dx * dx + dy * dy
		local worst, at = tol2, -1
		for m = a + 1, b - 1 do
			local px, py = path[m] % W - ax, path[m] // W - ay
			-- squared distance to the segment a-b
			local t = if len2 > 0 then math.clamp((px * dx + py * dy) / len2, 0, 1) else 0
			local ex, ey = px - dx * t, py - dy * t
			local d2 = ex * ex + ey * ey
			if d2 > worst then
				worst, at = d2, m
			end
		end
		if at > 0 then
			keep[at] = true
			stack[top + 1], stack[top + 2], stack[top + 3], stack[top + 4] = a, at, at, b
			top += 4
		end
	end
	local runs = {}
	local from = 1
	for i = 2, n do
		if keep[i] then
			table.insert(runs, { from, i })
			from = i
		end
	end
	return runs
end

--- The route of `path` (1-based tiles on a grid `W` wide; `k` = the map's k_lin, full-size tiles per
--- tile). `is_water(tile)`: nil skips the land check. Points are tile centres (x + 0.5, y + 0.5).
function WakeRoute.build(path: { number }, W: number, k: number, is_water: ((number) -> boolean)?): Route
	local np = #path
	if np == 0 then
		return { xs = {}, ys = {}, ss = {}, n = 0 }
	end
	if np == 1 then
		return { xs = { path[1] % W + 0.5 }, ys = { path[1] // W + 0.5 }, ss = { 0 }, n = 1 }
	end
	local runs = WakeRoute.runs(path, W)
	local m = #runs
	-- the legs' ends
	local vx, vy, vs = table.create(m + 1), table.create(m + 1), table.create(m + 1)
	for i, run in runs do
		local t = path[run[1]]
		vx[i], vy[i], vs[i] = t % W + 0.5, t // W + 0.5, run[1] - 1
	end
	local last = path[runs[m][2]]
	vx[m + 1], vy[m + 1], vs[m + 1] = last % W + 0.5, last // W + 0.5, runs[m][2] - 1

	local xs, ys, ss = { vx[1] }, { vy[1] }, { vs[1] }
	local n = 1
	local corner = WakeRoute.CORNER / math.max(k, 1e-6)
	for i = 2, m do
		local cx, cy = vx[i], vy[i]
		local ax, ay = cx - vx[i - 1], cy - vy[i - 1]
		local bx, by = vx[i + 1] - cx, vy[i + 1] - cy
		local la, lb = math.sqrt(ax * ax + ay * ay), math.sqrt(bx * bx + by * by)
		local rounded = false
		if la > 0 and lb > 0 then
			local turn = math.acos(math.clamp((ax * bx + ay * by) / (la * lb), -1, 1))
			if turn >= WakeRoute.MIN_TURN then
				local steps = math.clamp(math.ceil(turn / WakeRoute.ARC_STEP), WakeRoute.ARC_MIN, WakeRoute.ARC_MAX)
				local d = math.min(corner, la * 0.5, lb * 0.5)
				for _ = 1, 3 do
					if d < WakeRoute.MIN_CUT then
						break
					end
					local x0, y0 = cx - ax / la * d, cy - ay / la * d
					local x1, y1 = cx + bx / lb * d, cy + by / lb * d
					local ok = true
					if is_water ~= nil then
						for j = 1, steps - 1 do
							local t = j / steps
							local u = 1 - t
							local px = math.floor(u * u * x0 + 2 * u * t * cx + t * t * x1)
							local py = math.floor(u * u * y0 + 2 * u * t * cy + t * t * y1)
							-- on water, or on the shore beside it
							if
								not (
									is_water(py * W + px)
									or (px > 0 and is_water(py * W + px - 1))
									or (px < W - 1 and is_water(py * W + px + 1))
									or is_water((py - 1) * W + px)
									or is_water((py + 1) * W + px)
								)
							then
								ok = false
								break
							end
						end
					end
					if ok then
						local s0 = vs[i] - d * (vs[i] - vs[i - 1]) / la
						local s1 = vs[i] + d * (vs[i + 1] - vs[i]) / lb
						for j = 0, steps do
							local t = j / steps
							local u = 1 - t
							n += 1
							xs[n] = u * u * x0 + 2 * u * t * cx + t * t * x1
							ys[n] = u * u * y0 + 2 * u * t * cy + t * t * y1
							ss[n] = s0 + (s1 - s0) * t
						end
						rounded = true
						break
					end
					d *= 0.5
				end
			end
		end
		if not rounded then
			n += 1
			xs[n], ys[n], ss[n] = cx, cy, vs[i]
		end
	end
	n += 1
	xs[n], ys[n], ss[n] = vx[m + 1], vy[m + 1], vs[m + 1]
	return { xs = xs, ys = ys, ss = ss, n = n }
end

--- Where a ship `done` path tiles along the route is: its position and the index of the last
--- route point at or before it (1 .. n - 1; the wake is the points up to it, then the ship).
function WakeRoute.at(route: Route, done: number): (number, number, number)
	local n = route.n
	local xs, ys, ss = route.xs, route.ys, route.ss
	if n == 0 then
		return 0.5, 0.5, 0
	end
	if n == 1 or done <= ss[1] then
		return xs[1], ys[1], 1
	end
	if done >= ss[n] then
		return xs[n], ys[n], n - 1
	end
	-- the last point with ss <= done
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if ss[mid] <= done then
			lo = mid
		else
			hi = mid
		end
	end
	local span = ss[lo + 1] - ss[lo]
	local f = if span > 0 then (done - ss[lo]) / span else 0
	return xs[lo] + (xs[lo + 1] - xs[lo]) * f, ys[lo] + (ys[lo + 1] - ys[lo]) * f, lo
end

return WakeRoute
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">Session</string>
            <string name="Source"><![CDATA[--!strict
-- Port of scripts/net/session.gd (client half): match orchestration for the title attract mode, solo
-- campaigns and the shared multiplayer match. Same public API and signals as session.gd.
--
--   MODE_TITLE  local AI-only Sim (88 nations + tribes): a fast warm-up time-lapse, then TITLE_SPEED
--   MODE_SOLO   local Sim with one human, paused while help / game menu are open
--   MODE_MULTI  the server's Sim (src/server/MatchServer.luau): snapshot then per-tick deltas
--
-- session.gd built and stepped local sims on a worker thread. Roblox gives game scripts no worker
-- threads, so here:
--   * match construction (Sim.new, add_human, snapshot, GameState load) and multiplayer snapshot
--     decoding run in a Coop job (Net/Coop.luau) resumed every frame with BUILD_BUDGET_S — the previous
--     world keeps animating meanwhile, and nothing blocks a frame as long as the Core loops call
--     Coop.check();
--   * local stepping is budgeted: a tick's step is itself a Coop job (the Sim's loops call
--     Coop.check()), resumed every frame with STEP_BUDGET_S until it completes, then further ticks
--     while the budget lasts. A time-lapse that can't keep up slows down instead of stalling frames
--     (the accumulator is capped exactly like session.gd's MAX_STEPS_PER_TASK).
--
-- The environment is injectable (`Session.new(env)`) so tests drive the multiplayer path headless
-- against MatchServer (tests/net_session.luau). On Roblox `Session.new()` builds the real environment.
--
-- Maps: local matches run on config.map_id (start_solo's optional map id; the title uses the default
-- map); a multiplayer mirror uses the snapshot's map_id. A map that is not available locally (only
-- the default map is replicated) is downloaded first (env.fetch_map_async → Net/MapFetch) while the
-- build / join job waits; the lobby info's map_id is prefetched.

-- Roblox: ReplicatedStorage.Airfront; Lune: the source tree.
local Shared: any = if (game :: any) ~= nil
	then (game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront")
	else nil
local Coop = if Shared then require(Shared.Net.Coop) else require("../shared/Net/Coop")
local Protocol = if Shared then require(Shared.Net.Protocol) else require("../shared/Net/Protocol")
local Settings = if Shared then require(Shared.Net.Settings) else require("../shared/Net/Settings")
local Signal = if Shared then require(Shared.Core.Signal) else require("../shared/Core/Signal")
local MapFetch: any = if Shared then require(Shared.Net.MapFetch) else nil
local Stars: any = if Shared then require(Shared.Data.Stars) else require("../shared/Data/Stars")
local Arsenal: any = if Shared then require(Shared.Data.Arsenal) else require("../shared/Data/Arsenal")

local Session = {}
Session.__index = Session

Session.MODE_TITLE = 0
Session.MODE_SOLO = 1
Session.MODE_MULTI = 2

Session.STAGE_IDLE = "idle"
Session.STAGE_LOBBY = "lobby"
Session.STAGE_SPAWN = "spawn"
Session.STAGE_PLAYING = "playing"
Session.STAGE_OVER = "over"

Session.TICK_RATE = 10
Session.TICK_SEC = 1.0 / 10
Session.LOBBY_COUNTDOWN_SEC = 15.0
Session.REMATCH_COUNTDOWN_SEC = 12.0
Session.RESULTS_SEC = 18.0
Session.MP_TRIBES = 90
Session.MP_MAX_HUMANS = 32
Session.MP_SPAWN_TICKS = 200
Session.MP_TIME_LIMIT_S = 40 * 60
--- Tribes in a solo match (nil: Sim.default_tribes, 400)
--- and on the title backdrop (fewer: it runs on idle phones too).
Session.SOLO_TRIBES = nil :: number?
Session.TITLE_TRIBES = 150
--- Map of the title backdrop (nil: MapList.DEFAULT, replicated so it starts without a download).
Session.TITLE_MAP_ID = nil :: string?
--- The title globe opens with a fast time-lapse of the first 90 s so it is never an empty world.
Session.TITLE_WARMUP_TICKS = 900
--- A public match's waiting room shows its map behind the panel: the same AI backdrop on that map,
--- warmed up only this far so the map itself stays easy to read.
Session.WAIT_WARMUP_TICKS = 150
Session.TITLE_WARMUP_SPEED = 22.0
Session.TITLE_SPEED = 1.35
--- Phones idle on the title screen: keep the backdrop alive but spend less battery.
Session.TITLE_SPEED_MOBILE = 0.6
Session.MAX_STEPS_PER_TASK = 12

Session.NOTICE_INFO = 0
Session.NOTICE_WARNING = 1
Session.NOTICE_ERROR = 2

--- Frame budgets (seconds). The local Sim gets STEP_BUDGET_S of a frame; a tick that needs more goes on
--- in the next frame (2026-10-12, so solo matches run smoother on phones: one step
--- of a solo match's first minute was 2.4-7 ms on a Mac and several times that on a phone, which runs
--- our code without native code, all in one frame ten times a second; 59% of the Slow Frames reports
--- blamed the Sim, 70% of them on phones). While the Sim is behind (a tick already due when one is in
--- flight) it gets STEP_BUDGET_BEHIND_S, so a slow device keeps the match near real time.
Session.STEP_BUDGET_S = 0.006
Session.STEP_BUDGET_MOBILE_S = 0.004
Session.STEP_BUDGET_BEHIND_S = 0.010
Session.STEP_BUDGET_BEHIND_MOBILE_S = 0.008
Session.BUILD_BUDGET_S = 0.005
Session.BUILD_BUDGET_MOBILE_S = 0.004

--- A settings section is sent at most this often (leading edge immediately, the latest value trails).
Session.SETTINGS_SEND_GAP_S = 0.5
--- Queued for multiplayer but the server's lobby info still says we are not in: re-send JOIN after
--- this long (the server ignores a JOIN inside its cooldown, or it can be lost to the message budget).
Session.JOIN_RETRY_S = 3.0
--- A mirror that failed to decode / apply a delta asks for a fresh snapshot at most this often.
Session.RESYNC_GAP_S = 10.0
--- In multiplayer, user input is reported to the server at most this often (idle detection).
Session.ACTIVE_GAP_S = 30.0

local MODE_TITLE, MODE_SOLO, MODE_MULTI = 0, 1, 2
local PHASE_OVER = 2
local OP = Protocol.OP

-- =============================================================================================
-- Environment
-- =============================================================================================

local function roblox_env(): { [string]: any }
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local UserInputService = game:GetService("UserInputService")
	local GuiService = game:GetService("GuiService")
	local Core = ReplicatedStorage:WaitForChild("Airfront"):WaitForChild("Core")

	local env: { [string]: any } = {}
	env.now = os.clock
	env.defer = function(fn: () -> ())
		task.defer(fn)
	end
	env.warn = warn
	env.mobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		or GuiService:IsTenFootInterface()
	env.display_name = function(): string
		local p = Players.LocalPlayer
		if p ~= nil then
			if p.DisplayName ~= "" then
				return p.DisplayName
			end
			if p.Name ~= "" then
				return p.Name
			end
		end
		return "Commander"
	end
	env.user_id = function(): number
		local p = Players.LocalPlayer
		return if p ~= nil then p.UserId else 0
	end
	-- Map downloads (maps other than the default live on the server): cb(ok, err) when done.
	env.fetch_map_async = function(id: string, cb: (boolean, string?) -> ())
		task.spawn(function()
			local ok, err = MapFetch.fetch(id)
			cb(ok, err)
		end)
	end
	-- Core modules are required lazily: a missing module must never break boot.
	env.require_core = function(name: string): any
		local m = Core:FindFirstChild(name)
		if m == nil then
			return nil
		end
		return (require :: any)(m)
	end
	-- Network: the server creates ReplicatedStorage.AirfrontNet; connect once it replicates.
	-- The server answers HELLO with the player's saved settings (SETTINGS): saves wait for them.
	local net: { [string]: any } = { connected = false, sends_settings = true, busy_s = 0.0 }
	local handler: ((number, ...any) -> ())? = nil
	local to_server: RemoteEvent? = nil
	net.send = function(op: number, ...: any)
		if to_server ~= nil then
			to_server:FireServer(op, ...)
		end
	end
	net.listen = function(fn: (number, ...any) -> ())
		handler = fn
	end
	task.spawn(function()
		local folder = ReplicatedStorage:WaitForChild("AirfrontNet", math.huge)
		local ts = folder:WaitForChild("ToServer") :: RemoteEvent
		local tc = folder:WaitForChild("ToClient") :: RemoteEvent
		tc.OnClientEvent:Connect(function(op: any, ...: any)
			if type(op) == "number" and handler ~= nil then
				-- (timed: applying the server's updates is most of a public match's script, and it runs
				-- here, outside every per-frame step; UI/Telemetry "slow" reads net.busy_s)
				local t0 = os.clock()
				handler(op, ...)
				net.busy_s += os.clock() - t0
			end
		end)
		to_server = ts
		net.connected = true
		ts:FireServer(OP.HELLO)
	end)
	env.net = net
	return env
end

-- =============================================================================================
-- Construction
-- =============================================================================================

Session.IS_STUDIO = (game :: any) ~= nil and game:GetService("RunService"):IsStudio()
local STUDIO_TEST_GOLD = 250000000
local STUDIO_TEST_UNLOCKS = { mega = true, scatter = true, artillery = true, airfield = true, railgun = true, reinforce = true }

function Session.new(env: { [string]: any }?)
	local self: any = setmetatable({}, Session)
	self.env = env or roblox_env()
	self.state_ready = Signal.new() -- (state)
	self.mode_changed = Signal.new() -- (mode)
	self.lobby_updated = Signal.new() -- (info)
	--- (list) the game-wide public lobbies (hub servers; LobbyRules.public_view rows)
	self.lobbies_updated = Signal.new()
	--- (reason) a join_lobby that did not teleport
	self.join_failed = Signal.new()
	self.lobbies = nil :: { any }?
	--- the kinds of public match Quick Play offers on this hub ("ffa", "world", "team"; nil: not a hub)
	self.lobby_kinds = nil :: { string }?
	--- (state) Quick Play: { state = "joining" | "line" | "going" | "idle", mode, info } (PUBLIC_STATE)
	self.public_changed = Signal.new()
	self.public = { state = "idle" } :: { [string]: any }
	--- Game admins only (the server sends it to nobody else): owner id → true for bot players.
	self.admin_bots = nil :: { [number]: boolean }?
	self.admin_changed = Signal.new()
	--- the mode `state` belongs to (MODE_TITLE for the title backdrop even while queued)
	self.state_mode = MODE_TITLE
	self._auto_joined = false
	self.joined_owner = Signal.new() -- (owner_id)
	--- Short player-facing notices from the session (connection lost, match closed...).
	self.notice = Signal.new() -- (text, severity)
	--- A local match (title/solo) is being prepared; state_ready follows.
	self.building_started = Signal.new() -- (mode)
	--- Saved per-player settings arrived from the server (load_settings has data from now on).
	self.settings_loaded = Signal.new()
	--- Bought, unspent credits (Data/Products kind -> count) from the server (server/Purchases).
	self.credits = {} :: { [string]: number }
	self.credits_changed = Signal.new() -- (credits)
	self.credit_result = Signal.new() -- (kind, ok, reason?) the answer to use_credit
	--- (owner_id) solo: the player took over the nation that eliminated them
	self.took_over = Signal.new()
	--- Cosmetics (Data/Cosmetics) from the server: owned (set), equipped { skin?, flag? },
	--- crates_bought, crates_allowed (false where paid random items are restricted, or not checked yet).
	--- The Arsenal (Data/Arsenal): `stars` = the Stars balance (Data/Stars), `unlocks` = the items
	--- unlocked (set), `loaded` once the server's inventory arrived. `starter`: the starter pack's offer
	--- (Session._starter_of; false = none).
	self.inventory = {
		owned = {},
		equipped = {},
		crates_bought = 0,
		crates_allowed = false,
		stars = 0,
		unlocks = {},
		loaded = false,
		starter = false,
	}
	self.inventory_changed = Signal.new() -- (inventory)
	--- ({ lines = { { key, amount } }, total, balance, mode }) Stars paid for a match (server/Rewards)
	self.stars_awarded = Signal.new()
	--- the last payout of the match on screen (nil until one arrives; cleared when a match starts)
	self.last_award = nil :: any
	--- (key, ok, reason?) the answer to buy_unlock
	self.unlock_result = Signal.new()
	--- (going: boolean) the answer to hop_solo: true = a teleport to a fresh server is on its way
	self.hop_result = Signal.new()
	--- (key) an Arsenal item was just unlocked (Stars or Robux)
	self.unlocked = Signal.new()
	--- solo: the match's results for its Stars (Stars.Tracker), and whether this life was reported
	self._tracker = nil :: any
	self._solo_reported = false
	self.crate_result = Signal.new() -- (ok, item_id | reason) an open_crate's answer
	--- RoWorld General (Data/Subscription; server/General): subscribed, as the server last said
	self.general = false
	--- (on: boolean, given: { crate?, stars?, skin? }?) the server's word: subscribed or not, and what
	--- the day's perks just gave
	self.general_changed = Signal.new()
	--- (state) the player's party (server/Party.state; team games on: staging only for now)
	self.party_changed = Signal.new()
	--- the last party state (nil: parties are off on this server)
	self.party = nil :: any
	--- the last COSMETICS map of the public match (who wears what), applied to every rebuilt mirror
	self._cosmetics_map = {} :: { [any]: any }

	self.mode = MODE_TITLE
	self.state = nil :: any
	self.difficulty = 1
	--- Last lobby info received from the server.
	self.lobby = {
		available = false,
		stage = Session.STAGE_IDLE,
		countdown_s = 0.0,
		elapsed_s = 0.0,
		players = {},
		in_match = false,
	}
	--- When false, local matches are built and stepped synchronously (tests).
	self.threaded = true
	--- Local sim speed multiplier (title attract mode runs a little faster).
	self.local_speed = 1.0
	--- Solo only: freezes the local simulation (help / game menu open).
	self.paused = false
	self.mobile = self.env.mobile == true
	self.step_budget_s = if self.mobile then Session.STEP_BUDGET_MOBILE_S else Session.STEP_BUDGET_S
	self.step_budget_behind_s = if self.mobile then Session.STEP_BUDGET_BEHIND_MOBILE_S else Session.STEP_BUDGET_BEHIND_S
	self.build_budget_s = if self.mobile then Session.BUILD_BUDGET_MOBILE_S else Session.BUILD_BUDGET_S

	self._warming = false
	--- the waiting room's backdrop map (public match) and its shorter warm-up
	self._wait_map = nil :: string?
	self._wait_warmup = false
	self._warm_target = Session.TITLE_WARMUP_TICKS
	--- Map ids being downloaded (see _fetch_map).
	self._map_fetching = {} :: { [string]: boolean }
	--- Map id of the last solo match started (nil = default).
	self.map_id = nil :: string?
	self._build_job = nil :: any
	self._build_serial = 0
	self._build_mode = MODE_TITLE
	self._title_restart_pending = false

	-- Local (title / solo) simulation
	self._sim = nil :: any
	--- the tick in progress: the Sim's step as a Coop job (see _local_process), and the time it took
	self._step_job = nil :: any
	self._step_spent = 0.0
	self._acc = 0.0
	self._queued = {} :: { any }
	self._last_delta = self.env.now()

	-- Multiplayer (client side)
	self._mp_waiting = false
	--- Left a multiplayer match; the title world being built must switch the mode back to TITLE.
	--- (session.gd kept MODE_MULTI after leaving a match, so its UI showed the HUD over the title
	--- globe; fixed here.)
	self._mp_leaving = false
	self._join_job = nil :: any
	self._join_owner = 0
	self._join_deltas = {} :: { any }
	self._net_warned = false
	--- When the last JOIN was sent (JOIN_RETRY_S).
	self._join_sent_at = -math.huge
	--- When the last RESYNC was requested (RESYNC_GAP_S); a mirror refresh is awaited while set.
	self._resync_at = -math.huge
	self._resync_pending = false
	--- True when the state last announced (state_ready) replaced the same match's after a resync.
	self.state_is_resync = false
	self._active_sent_at = -math.huge

	-- Settings (persisted by the server per account; see ServerMain)
	self._settings = {} :: { [string]: { [string]: any } }
	self.settings_ready = false
	--- section -> time of the last SETTING sent; sections whose latest value still has to go out.
	self._settings_sent_at = {} :: { [string]: number }
	self._settings_dirty = {} :: { [string]: boolean }

	-- Instrumentation (dev harness / tests)
	--- (process_s: all of process(), the local Sim's steps among it)
	self.perf = {
		steps = 0,
		step_s = 0.0,
		step_s_max = 0.0, -- a whole tick's step (over the frames it took)
		step_slice_max = 0.0, -- the most one frame spent on the Sim
		build_s = 0.0,
		build_frames = 0,
		build_slice_max = 0.0,
		process_s = 0.0,
	}

	local net = self.env.net
	if net ~= nil then
		net.listen(function(op: number, ...: any)
			self:_on_net(op, ...)
		end)
	end
	return self
end

--- Roblox: drive the session from the render loop (priority First, so views read a fresh render_tick).
function Session.bind(self: any)
	local RunService = game:GetService("RunService")
	-- (the frame's dt: a Studio film steps it, Map/FrameClock)
	local FrameClock = require((script :: any).Parent:WaitForChild("Map"):WaitForChild("FrameClock")) :: any
	RunService:BindToRenderStep("AirfrontSession", Enum.RenderPriority.First.Value, function(dt: number)
		local t0 = os.clock()
		self:process(FrameClock.dt(dt))
		self.perf.process_s += os.clock() - t0
	end)
end

-- =============================================================================================
-- Public API
-- =============================================================================================

--- Starts (asynchronously) the title attract simulation; state_ready fires when it is live.
function Session.start_title(self: any)
	self:_leave_multiplayer_if_needed()
	self._wait_map = nil
	self:_start_local(MODE_TITLE, {
		seed = self:_rand_seed(),
		difficulty = 1,
		tribes = Session.TITLE_TRIBES,
		max_humans = 0,
		time_limit_s = 0,
		map_id = Session.TITLE_MAP_ID,
	}, "")
end

--- Public-match waiting room: rebuild the backdrop on the lobby's map `map_id` (the AI backdrop,
--- shortly warmed up) so players see what they are about to play. Stays in the multiplayer flow.
function Session._show_wait_map(self: any, map_id: string)
	if self._wait_map == map_id then
		return
	end
	self._wait_map = map_id
	self._wait_warmup = true
	self:_start_local(MODE_TITLE, {
		seed = self:_rand_seed(),
		difficulty = 1,
		tribes = Session.TITLE_TRIBES,
		max_humans = 0,
		time_limit_s = 0,
		map_id = map_id,
	}, "")
end

--- Starts (asynchronously) a solo campaign on map `map_id` (MapList id; nil = the default map);
--- state_ready then joined_owner fire when it is live (after downloading the map if needed).
--- `opts.tribes`: how many tribes the map gets; `opts.countdown_ticks`: ticks from placing the capital
--- to the start (the tutorial's match has fewer tribes and starts at once: Data/Tutorial).
function Session.start_solo(self: any, p_difficulty: number, map_id: string?, opts: any?)
	self:_leave_multiplayer_if_needed()
	self.difficulty = math.clamp(math.floor(tonumber(p_difficulty) or 1), 0, 2)
	self.map_id = if type(map_id) == "string" and map_id ~= "" then map_id else nil
	local tribes = if type(opts) == "table" and type(opts.tribes) == "number" then opts.tribes else Session.SOLO_TRIBES
	local countdown = if type(opts) == "table" and type(opts.countdown_ticks) == "number"
		then opts.countdown_ticks
		else nil
	self:_start_local(MODE_SOLO, {
		seed = self:_rand_seed(),
		difficulty = self.difficulty,
		tribes = tribes,
		solo_countdown_ticks = countdown,
		studio_jutsu_test = Session.IS_STUDIO,
		max_humans = 1,
		time_limit_s = 0,
		map_id = self.map_id,
	}, self:local_display_name())
end

--- Starts downloading map `id` unless it is available locally or already on its way. Build / join
--- jobs wait while self._map_fetching[id] is set.
function Session._fetch_map(self: any, id: string?)
	if type(id) ~= "string" or self._map_fetching[id] then
		return
	end
	local fetch = self.env.fetch_map_async
	local WorldMap = self:_core("WorldMap")
	if fetch == nil or WorldMap == nil or WorldMap.available(id) then
		return
	end
	self._map_fetching[id] = true
	fetch(id, function(ok: boolean, err: string?)
		self._map_fetching[id] = nil
		if not ok then
			self:_warn_once("[Session] could not download map " .. id .. ": " .. tostring(err))
		end
	end)
end

--- Loads map `id`'s data module (nil = the default map) outside the Coop jobs — requiring can
--- yield under Lune, which a job coroutine must not. Server-only maps load later (downloads).
function Session._preload_map(self: any, id: string?)
	local WorldMap = self:_core("WorldMap")
	if WorldMap ~= nil then
		pcall(WorldMap.load_data, if type(id) == "string" then id else WorldMap.DEFAULT)
	end
end

--- Inside a Coop job: waits (yielding frames) until map `id` is available; the map, or an error.
function Session._await_map(self: any, WorldMap: any, id: string?): any
	if type(id) == "string" and not WorldMap.available(id) then
		self:_fetch_map(id)
		while self._map_fetching[id] do
			coroutine.yield()
		end
	end
	return WorldMap.get(id)
end

--- True while a local match is being prepared (UI can show a "Deploying…" state).
function Session.is_building(self: any): boolean
	return self._build_job ~= nil
end

function Session.set_paused(self: any, on: boolean)
	self.paused = on
end

--- The player's equipped cosmetics on owner `id` of the local match (solo).
function Session._apply_own_cosmetics(self: any, id: number)
	local st = self.state
	if st == nil or type(st.set_cosmetics) ~= "function" then
		return
	end
	local eq = self.inventory.equipped or {}
	-- (and their own head shot beside their name, as in a public match)
	local uid = if type(self.env.user_id) == "function" then self.env.user_id() else 0
	st:set_cosmetics({ [id] = { skin = eq.skin, flag = eq.flag, face = uid } }, true)
end

--- Does the player have Arsenal item `key`?
function Session.has_unlock(self: any, key: string): boolean
	return self.inventory.unlocks[key] == true
		or (Session.IS_STUDIO and self.mode == MODE_SOLO and self._sim ~= nil
			and self._sim.studio_jutsu_unlocked == true and STUDIO_TEST_UNLOCKS[key] == true)
end

--- The training button only controls the player's active local Studio simulation.
function Session.can_use_studio_test_gold(self: any): boolean
	local sim, state = self._sim, self.state
	if not Session.IS_STUDIO or self.mode ~= MODE_SOLO or sim == nil or state == nil
		or sim.studio_jutsu_test ~= true or self:is_building()
	then
		return false
	end
	local id = state.local_owner or 0
	return id > 0 and sim.o_alive[id] == 1
end

function Session.grant_studio_test_gold(self: any): boolean
	if not self:can_use_studio_test_gold() then
		return false
	end
	self:_settle_step()
	if not self:can_use_studio_test_gold() then
		return false
	end
	local sim, id = self._sim, self.state.local_owner
	sim.o_gold[id] = math.max(sim.o_gold[id], STUDIO_TEST_GOLD)
	sim.studio_jutsu_unlocked = true
	self._tracker = nil
	sim._force_stats = true
	self:_apply_own_unlocks()
	return true
end

--- Unlock Arsenal item `key` with Stars (the answer comes as unlock_result; the inventory follows).
function Session.buy_unlock(self: any, key: string): boolean
	local net = self.env.net
	if net == nil or not net.connected or type(net.send) ~= "function" then
		return false
	end
	net.send(OP.BUY_UNLOCK, key)
	return true
end

--- The starter pack's offer from an INVENTORY payload (server/Purchases.starter_state): false, or
--- { state = "ready" } (not shown yet), or { state = "active", ends_at = os.clock() when it ends }.
function Session._starter_of(v: any): any
	if type(v) ~= "table" then
		return false
	end
	if v.state == "ready" then
		return { state = "ready" }
	end
	local left = tonumber(v.left)
	if v.state == "active" and left ~= nil and left == left and left > 0 then
		return { state = "active", ends_at = os.clock() + left }
	end
	return false
end

--- The starter pack's offer is on the player's screen: the server starts its clock (once). The
--- inventory that follows carries it as active.
function Session.starter_seen(self: any): boolean
	local net = self.env.net
	if net == nil or not net.connected or type(net.send) ~= "function" then
		return false
	end
	net.send(OP.STARTER_SEEN)
	return true
end

--- Rofront Staging, and game admins on production (the server refuses it from anyone else): be a
--- new player again — no match counted, the tutorial's Stars and the first crate's price on offer
--- again (2026-10-04, the menu's "Replay as new player").
function Session.new_player(self: any): boolean
	local net = self.env.net
	if net == nil or not net.connected or type(net.send) ~= "function" then
		return false
	end
	net.send(OP.NEW_PLAYER)
	return true
end

--- Hub: this server is outdated and a solo match is about to start: ask to be sent to a fresh
--- server to play it there (server/FreshServers; answered with hop_result). False when the server
--- can't be asked.
function Session.hop_solo(self: any, difficulty: number, map_id: string?): boolean
	local net = self.env.net
	if net == nil or not net.connected or type(net.send) ~= "function" then
		return false
	end
	net.send(OP.SOLO_HOP, difficulty, map_id)
	return true
end

--- Solo: the local player's nation plays with the Arsenal they have unlocked.
function Session._apply_own_unlocks(self: any)
	local sim = self._sim
	local st = self.state
	if self.mode ~= MODE_SOLO or sim == nil or st == nil or (st.local_owner or 0) == 0 then
		return
	end
	if type(sim.set_unlocks) == "function" then
		self:_settle_step()
		if self._sim ~= sim then
			return
		end
		local mask = Arsenal.mask(self.inventory.unlocks)
		if Session.IS_STUDIO and sim.studio_jutsu_unlocked == true then
			mask = bit32.bor(mask, Arsenal.mask(STUDIO_TEST_UNLOCKS))
		end
		sim:set_unlocks(st.local_owner, mask)
	end
end

--- Solo: report this life's result for its Stars, once (server/Rewards answers with STARS). `left` =
--- the player is walking away from a match that goes on.
function Session._solo_report(self: any, left: boolean)
	local tracker = self._tracker
	local st = self.state
	if tracker == nil or self._solo_reported or st == nil or (st.local_owner or 0) == 0 then
		return
	end
	local result = tracker:result(st.local_owner, left)
	if not result.spawned then
		return
	end
	self._solo_reported = true
	local net = self.env.net
	if net ~= nil and net.connected and type(net.send) == "function" then
		net.send(OP.SOLO_RESULT, result)
	end
end

--- Open one bought crate (the answer comes as crate_result; the inventory follows).
function Session.open_crate(self: any): boolean
	local net = self.env.net
	if net == nil or not net.connected or type(net.send) ~= "function" then
		return false
	end
	net.send(OP.OPEN_CRATE)
	return true
end

--- Wear an owned cosmetic in `slot` ("skin" / "flag"), or none (id false).
function Session.equip(self: any, slot: string, id: string | false): boolean
	local net = self.env.net
	if net == nil or not net.connected or type(net.send) ~= "function" then
		return false
	end
	net.send(OP.EQUIP, slot, id)
	return true
end

--- Ask the server to spend one bought `kind` credit (the answer comes as credit_result). `target`:
--- a public match's takeover, which the server makes itself.
function Session.use_credit(self: any, kind: string, target: number?): boolean
	local net = self.env.net
	if net == nil or not net.connected or type(net.send) ~= "function" then
		return false
	end
	net.send(OP.USE_CREDIT, kind, target)
	return true
end

--- Could the fallen player take over nation `target` now? Solo: the local Sim decides
--- (Sim.can_take_over). A public match: this client's mirror says so (the server checks again).
function Session.can_take_over(self: any, target: number): boolean
	local st = self.state
	if st == nil then
		return false
	end
	if self.mode == MODE_SOLO then
		local sim = self._sim
		return sim ~= nil and type(sim.can_take_over) == "function" and sim:can_take_over(st.local_owner or 0, target)
	end
	if self.mode ~= MODE_MULTI or self.state_mode ~= MODE_MULTI then
		return false
	end
	local me = st.owners[st.local_owner or 0]
	local o = st.owners[target]
	return me ~= nil
		and not me.alive
		and o ~= nil
		and o.alive
		and o.kind == 0 -- Defs.KIND_NATION: never a tribe or a (bot) player
		and (o.tiles or 0) > 0
		and st.phase == 1 -- Defs.PHASE_PLAYING
end

--- Solo: the fallen player takes command of `target` (after its credit was spent). True when done.
function Session.take_over(self: any, target: number): boolean
	if not self:can_take_over(target) then
		return false
	end
	local st = self.state
	self:_settle_step()
	if self._sim == nil or not self._sim:take_over(st.local_owner, target) then
		return false
	end
	-- a new life: its Stars are counted from here (the first was reported when it fell)
	if self._tracker ~= nil then
		self._tracker:adopt(st.local_owner, target)
		self._solo_reported = false
	end
	self.last_award = nil
	st.local_owner = target
	table.clear(self._queued)
	self:_apply_own_cosmetics(target)
	self:_emit("took_over", target)
	return true
end

function Session.join_multiplayer(self: any)
	if not self:multiplayer_available() then
		self:_emit("notice", "Multiplayer is unavailable right now. Try again in a moment.", Session.NOTICE_WARNING)
		return
	end
	self._mp_waiting = true
	self._mp_leaving = false
	self:_set_mode(MODE_MULTI)
	self:_send_join()
end

--- Public lobby: ask the hub to teleport us to that lobby's match server.
function Session.join_lobby(self: any, id: string)
	if not self:multiplayer_available() then
		self:_emit("notice", "Multiplayer is unavailable right now. Try again in a moment.", Session.NOTICE_WARNING)
		self:_emit("join_failed", "offline")
		return
	end
	self.env.net.send(OP.JOIN_LOBBY, id)
end

--- Quick Play: a seat in the soonest public match of `mode` ("ffa" | "team" | "world"; a party leader: for the
--- party). The hub answers with PUBLIC_STATE (in line while every match of the kind is full).
function Session.join_public(self: any, mode: string)
	if not self:multiplayer_available() then
		self:_emit("notice", "Multiplayer is unavailable right now. Try again in a moment.", Session.NOTICE_WARNING)
		self:_emit("join_failed", "offline")
		return
	end
	self.env.net.send(OP.JOIN_PUBLIC, mode)
end

--- Quick Play: leave the line.
function Session.leave_line(self: any)
	if self:multiplayer_available() then
		self.env.net.send(OP.JOIN_PUBLIC, false)
	end
end

--- Public-match waiting room: toggle our vote to start early (more than half of the players).
function Session.vote_start(self: any)
	if self:multiplayer_available() then
		self.env.net.send(OP.VOTE_START)
	end
end

--- Parties (server/Party; team games on): `action` "invite" | "accept" | "decline" | "kick" (with a
--- user id) or "leave".
function Session.party_action(self: any, action: string, user_id: number?)
	if self.party ~= nil and self:multiplayer_available() then
		self.env.net.send(OP.PARTY, action, user_id)
	end
end

--- In a party (with others), and whether this player leads it (it picks the match).
function Session.in_party(self: any): (boolean, boolean)
	local p = self.party
	if p == nil or type(p.members) ~= "table" or #p.members < 2 then
		return false, true
	end
	return true, p.leader == true
end

--- A Creator Dashboard milestone (UI/Telemetry → server/Analytics). False when it could not be sent
--- (not connected yet).
function Session.report(self: any, kind: string, a: any?, b: any?, c: any?): boolean
	local net = self.env.net
	if net == nil or not net.connected or type(net.send) ~= "function" then
		return false
	end
	net.send(OP.ANALYTICS, kind, a, b, c)
	return true
end

--- Hub: watch a running public match (the server teleports us there as a spectator).
function Session.spectate_lobby(self: any, id: string)
	if not self:multiplayer_available() then
		self:_emit("notice", "Multiplayer is unavailable right now. Try again in a moment.", Session.NOTICE_WARNING)
		self:_emit("join_failed", "offline")
		return
	end
	self.env.net.send(OP.SPECTATE_LOBBY, id)
end

function Session._send_join(self: any)
	self._join_sent_at = self.env.now()
	self.env.net.send(OP.JOIN, self:local_display_name())
end

--- The player touched the controls (Main calls this on user input). In multiplayer the server hears
--- about it at most every ACTIVE_GAP_S, so a player who is watching is not dropped as idle at the
--- rematch (session.gd only counted intents).
function Session.note_activity(self: any)
	if self.mode ~= MODE_MULTI then
		return
	end
	local now = self.env.now()
	if now - self._active_sent_at < Session.ACTIVE_GAP_S or not self:multiplayer_available() then
		return
	end
	self._active_sent_at = now
	self.env.net.send(OP.ACTIVE)
end

function Session.leave_match(self: any)
	-- never auto-join this server's public match again after leaving it (Studio plays lobbies on the
	-- hub server itself, which would otherwise queue us straight back in)
	self._auto_joined = true
	-- Leaving the multiplayer queue while the title globe is still simulating: keep that world.
	if self.mode == MODE_MULTI and self._sim ~= nil and self.state ~= nil and self.state.local_owner == 0 then
		self:_leave_multiplayer_if_needed()
		self:_set_mode(MODE_TITLE)
		return
	end
	self:start_title()
end

function Session.send_intent(self: any, intent: { [string]: any })
	if self.mode == MODE_MULTI then
		if self:multiplayer_available() and self.state ~= nil and self.state.local_owner ~= 0 and self._sim == nil then
			local b = Protocol.encode_intent(intent)
			if b ~= nil then
				self.env.net.send(OP.INTENT, b)
			end
		end
		return
	end
	if self.mode == MODE_SOLO and self._sim ~= nil then
		table.insert(self._queued, intent)
	end
end

function Session.multiplayer_available(self: any): boolean
	local net = self.env.net
	return net ~= nil and net.connected == true and self.lobby.available == true
end

--- "connected", "connecting" or "offline" — for the title screen's multiplayer card.
function Session.multiplayer_status(self: any): string
	local net = self.env.net
	if net == nil then
		return "offline"
	end
	if self:multiplayer_available() then
		return "connected"
	end
	if net.connected and self.lobby.closed then
		return "offline"
	end
	return "connecting"
end

function Session.local_display_name(self: any): string
	local f = self.env.display_name
	local n = if f then f() else nil
	if type(n) == "string" and n ~= "" then
		return n
	end
	return "Commander"
end

--- Current local sim (title/solo only; nil in multiplayer). Tests, tools and the tutorial; a tick in
--- progress is finished first, so a caller may change the Sim.
function Session.local_sim(self: any): any
	self:_settle_step()
	return self._sim
end

-- ---------------------------------------------------------------------------------------------
-- Settings (session.gd's user://settings.cfg sections; Roblox has no client files, so the server
-- keeps them per account in a DataStore)
-- ---------------------------------------------------------------------------------------------

--- A copy of a saved settings section ({} until the server's copy arrives; see settings_loaded).
--- Nested tables (e.g. [ui] tips_seen) are copied too, so callers may modify what they get.
function Session.load_settings(self: any, section: string): { [string]: any }
	return Settings.copy_section(self._settings[section])
end

--- Saves a settings section: booleans, numbers, short strings and one nested level of those (e.g.
--- [ui] tips_seen = {expand = true, ...}); see Net/Settings for the limits. The server keeps exactly
--- what is kept here. Sends are throttled per section (the first at once, the latest value trails).
function Session.save_settings(self: any, section: string, values: { [string]: any })
	if not Settings.valid_name(section, Settings.MAX_SECTION_NAME) or type(values) ~= "table" then
		return
	end
	local clean = Settings.clean_section(values) :: { [string]: any }
	if self._settings[section] == nil then
		local n = 0
		for _ in self._settings do
			n += 1
		end
		if n >= Settings.MAX_SECTIONS then
			return
		end
	end
	self._settings[section] = clean
	self._settings_dirty[section] = true
	self:_flush_settings(false)
end

--- Sends every changed section whose throttle gap has passed (`force`: all of them now). With a
--- transport that delivers the saved settings (net.sends_settings), nothing is sent before they have
--- arrived: a section saved that early holds only this session's defaults + changes and would replace
--- the stored one; _on_settings merges it over the stored section first.
function Session._flush_settings(self: any, force: boolean)
	local net = self.env.net
	if net == nil or not net.connected or next(self._settings_dirty) == nil then
		return
	end
	if net.sends_settings == true and not self.settings_ready then
		return
	end
	local now = self.env.now()
	for section in self._settings_dirty do
		local last = self._settings_sent_at[section]
		if force or last == nil or now - last >= Session.SETTINGS_SEND_GAP_S then
			self._settings_dirty[section] = nil
			self._settings_sent_at[section] = now
			net.send(OP.SETTING, section, Settings.copy_section(self._settings[section]))
		end
	end
end

-- =============================================================================================
-- Frame processing
-- =============================================================================================

function Session.process(self: any, dt: number)
	if self._build_job ~= nil then
		self:_run_build()
	end
	if self._join_job ~= nil then
		self:_run_join()
	end
	if self._sim ~= nil then
		self:_local_process(dt)
	end
	self:_update_render_tick(dt)
	if next(self._settings_dirty) ~= nil then
		self:_flush_settings(false)
	end
	if self._mp_waiting then
		self:_check_join()
	end
end

--- Queued, yet the server's lobby info says we are not in (our JOIN landed inside its cooldown after
--- a quick leave + re-queue, or was lost): ask again. JOIN is idempotent on the server.
function Session._check_join(self: any)
	if self.lobby.in_match == true or self._join_job ~= nil or not self:multiplayer_available() then
		return
	end
	if self.env.now() - self._join_sent_at >= Session.JOIN_RETRY_S then
		self:_send_join()
	end
end

function Session._rand_seed(_self: any): number
	return math.random(0, 2 ^ 31 - 2)
end

-- =============================================================================================
-- Local simulation
-- =============================================================================================

--- Prepares a local sim in a Coop job (see _build_local / _finish_build). The previous local world
--- keeps animating until the new one is ready. A newer request supersedes the one in flight.
function Session._start_local(self: any, new_mode: number, config: { [string]: any }, human_name: string)
	-- a solo match being left: its Stars so far
	if self.mode == MODE_SOLO and self.state_mode == MODE_SOLO then
		self:_solo_report(true)
	end
	self._tracker = nil
	if new_mode ~= MODE_TITLE or self.mobile then
		-- the old world stops while the new one is built (its last frame stays on screen): two
		-- worlds at once ran phones out of memory ("could not build the match: not enough memory")
		self:_stop_local()
	end
	self:_preload_map(config.map_id)
	self._build_serial += 1
	self._build_mode = new_mode
	self:_emit("building_started", new_mode)
	local serial = self._build_serial
	local job = Coop.job(function()
		return self:_build_local(config, human_name, serial)
	end)
	self._build_job = job
	if not self.threaded then
		job:finish()
		self:_run_build()
	end
end

--- Core modules in dependency order: the first build requires them one per Coop slice (each is a
--- few ms to load) instead of all at once inside `require(Sim)`.
Session.WARM_MODULES = {
	"Signal",
	"Defs",
	"Ev",
	"Rng",
	"Rules",
	"WorldMap",
	"SimColors",
	"SimNav",
	"SimState",
	"SimAttacks",
	"SimStructures",
	"SimNaval",
	"SimWarships",
	"SimNukes",
	"SimAIEconomy",
	"SimAI",
	"GameState",
	"Sim",
}

--- Builds the Sim, the optional human and the client mirror. Runs inside a Coop job.
function Session._build_local(self: any, config: { [string]: any }, human_name: string, serial: number)
	if not self._warm then
		for _, name in Session.WARM_MODULES do
			self:_core(name)
			Coop.check()
		end
	end
	local Sim = self:_core("Sim")
	local GameState = self:_core("GameState")
	local WorldMap = self:_core("WorldMap")
	if Sim == nil or GameState == nil or WorldMap == nil then
		return { missing = true, serial = serial }
	end
	local map = self:_await_map(WorldMap, config.map_id)
	Coop.check()
	if not self._warm then
		-- The water-navigation regions (~30 ms) are a shared cache Sim.new would build in one go.
		local SimNav = self:_core("SimNav")
		if SimNav ~= nil and type(SimNav.shared) == "function" then
			SimNav.shared(map)
		end
		self._warm = true
		Coop.check()
	end
	local sim = Sim.new(map, config)
	Coop.check()
	local id = 0
	if human_name ~= "" then
		id = sim:add_human("local", human_name)
		if id ~= 0 and Session.IS_STUDIO and config.studio_jutsu_test == true then
			sim.studio_jutsu_test = true
		end
	end
	local snap = sim:snapshot()
	Coop.check()
	local gs = GameState.new(map)
	gs:load_snapshot(snap)
	gs.local_owner = id
	return { sim = sim, state = gs, id = id, serial = serial }
end

function Session._core(self: any, name: string): any
	local f = self.env.require_core
	if f == nil then
		return nil
	end
	local ok, m = pcall(f, name)
	if ok then
		return m
	end
	return nil
end

function Session._run_build(self: any)
	local job = self._build_job
	local t0 = self.env.now()
	if not job.done then
		job:step(self.build_budget_s)
	end
	local slice = self.env.now() - t0
	local perf = self.perf
	perf.build_s += slice
	perf.build_frames += 1
	perf.build_slice_max = math.max(perf.build_slice_max, slice)
	job.time_s = (job.time_s or 0) + slice
	job.slice_max = math.max(job.slice_max or 0, slice)
	if not job.done then
		return
	end
	self._build_job = nil
	perf.last_build = { ms = job.time_s * 1000, frames = job.slices, slice_max_ms = job.slice_max * 1000 }
	if not job.ok then
		self:_warn_once("[Session] could not build the match: " .. tostring(job.err))
		self:_emit("notice", "Something went wrong starting the match. Please try again.", Session.NOTICE_ERROR)
		if self._build_mode ~= MODE_TITLE and self._sim == nil then
			self:start_title() -- (the old world was stopped for the build: bring the title back)
		end
		return
	end
	local r = job.result
	if r.missing then
		-- Sim / GameState not present yet (development builds): stay on the title with no world.
		self:_warn_once("[Session] Core Sim modules are not available; no local world")
		return
	end
	self:_finish_build(r)
end

--- Swaps in the freshly built local match.
function Session._finish_build(self: any, r: { [string]: any })
	self._title_restart_pending = false
	if r.serial ~= self._build_serial then
		return
	end
	table.clear(self._queued)
	self._acc = 0.0
	self.paused = false
	self._step_job = nil
	self._sim = r.sim
	self.state = r.state
	self._last_delta = self.env.now()
	if self._build_mode == MODE_TITLE then
		self.local_speed = Session.TITLE_WARMUP_SPEED
		self._warming = true
		self._warm_target = if self._wait_warmup then Session.WAIT_WARMUP_TICKS else Session.TITLE_WARMUP_TICKS
		self._wait_warmup = false
	else
		self.local_speed = 1.0
		self._warming = false
	end
	-- A title world that finishes building while the player is already queued for multiplayer
	-- only replaces the backdrop; it must not pull them out of the multiplayer flow.
	local queued_mp = self._mp_waiting or (self.mode == MODE_MULTI and not self._mp_leaving)
	if not (self._build_mode == MODE_TITLE and queued_mp) then
		self._mp_leaving = false
		self:_set_mode(self._build_mode)
	end
	-- the mode this state belongs to: a title world that lands while we wait for a multiplayer
	-- match stays a title backdrop (the UI must not take it for the match)
	self.state_mode = self._build_mode
	self.state_is_resync = false
	-- a solo match: the player wears their own cosmetics, plays with their own Arsenal, and the
	-- match is followed for its Stars
	self._tracker = nil
	self._solo_reported = false
	self.last_award = nil
	if self._build_mode == MODE_SOLO and r.id ~= 0 then
		self:_apply_own_cosmetics(r.id)
		self:_apply_own_unlocks()
		self._tracker = Stars.Tracker.new(r.sim)
		self._tracker:watch(r.id)
	end
	self:_emit("state_ready", self.state)
	local id = r.id
	if id ~= 0 then
		self:_emit("joined_owner", id)
	end
end

function Session._local_process(self: any, dt: number)
	local env = self.env
	if self.paused and self.mode == MODE_SOLO then
		self._last_delta = env.now()
		return
	end
	local state = self.state
	-- (a title backdrop behind the multiplayer waiting room warms up too, then slows down like the
	-- title's: it used to keep the 22x warm-up speed while the player waited)
	if self._warming and state ~= nil and state.tick >= (self._warm_target or Session.TITLE_WARMUP_TICKS) then
		self._warming = false
		self.local_speed = if self.mobile then Session.TITLE_SPEED_MOBILE else Session.TITLE_SPEED
	end
	local tick_sec = Session.TICK_SEC
	local cap = tick_sec * Session.MAX_STEPS_PER_TASK
	-- Studio only: workspace attribute AF_DEV_SPEED fast-forwards local matches (screenshots, tests)
	local dev_speed = 1.0
	if Session.IS_STUDIO then
		dev_speed = math.clamp(tonumber(workspace:GetAttribute("AF_DEV_SPEED")) or 1.0, 0.1, 20.0)
	end
	self._acc = math.min(self._acc + dt * self.local_speed * dev_speed, cap * dev_speed)
	if self._step_job == nil and self._acc < tick_sec then
		return
	end
	-- behind: a tick is in flight and the next is due already (or a time-lapse is owed two)
	local behind = self._acc >= tick_sec * (if self._step_job ~= nil then 1 else 2)
	local budget = if not self.threaded
		then math.huge
		elseif behind then self.step_budget_behind_s
		else self.step_budget_s
	local sim = self._sim
	local perf = self.perf
	local t0 = env.now()
	local done_ticks = 0
	while self._sim == sim do
		local job = self._step_job
		if job == nil then
			-- the next tick, while time is owed and the budget lasts
			if self._acc < tick_sec or done_ticks >= Session.MAX_STEPS_PER_TASK then
				break
			end
			if done_ticks > 0 and env.now() - t0 >= budget then
				break -- (the owed time stays in _acc, capped: a time-lapse slows down)
			end
			self._acc -= tick_sec
			if state ~= nil and state.local_owner ~= 0 then
				for _, intent in self._queued do
					sim:submit(state.local_owner, intent)
				end
			end
			table.clear(self._queued)
			job = Coop.job(sim.step, sim)
			self._step_job = job
			self._step_spent = 0.0
		end
		local left = budget - (env.now() - t0)
		if left <= 0 then
			break -- (it goes on next frame)
		end
		local s0 = env.now()
		local finished = job:step(left)
		local spent = env.now() - s0
		self._step_spent += spent
		perf.step_s += spent
		perf.step_slice_max = math.max(perf.step_slice_max or 0.0, spent)
		if not finished then
			break -- (next frame)
		end
		self._step_job = nil
		done_ticks += 1
		if not self:_step_done(job, sim) then
			break
		end
	end
end

--- A tick's step finished (job): its delta goes to the state. False when stepping must stop for this
--- frame (the title world ended, or the Sim was replaced).
function Session._step_done(self: any, job: any, sim: any): boolean
	if not job.ok then
		error(job.err, 0)
	end
	local perf = self.perf
	perf.steps += 1
	perf.step_s_max = math.max(perf.step_s_max, self._step_spent)
	local d = job.result
	local state = self.state
	local tracker = self._tracker
	if tracker ~= nil and state ~= nil then
		tracker:step(d.ev)
		if not self._solo_reported and tracker:final(state.local_owner) then
			self:_solo_report(false)
		end
	end
	if self:_apply_local_delta(d) then
		return false
	end
	return self._sim == sim
end

--- Finishes the tick in progress now (one long frame), so the caller may change the Sim: a take-over,
--- the player's Arsenal, the tutorial's gold. Nothing else may touch the Sim while its step is
--- suspended between frames.
function Session._settle_step(self: any)
	local job = self._step_job
	local sim = self._sim
	if job == nil or sim == nil then
		return
	end
	local s0 = self.env.now()
	job:finish()
	self._step_spent += self.env.now() - s0
	self.perf.step_s += self.env.now() - s0
	self._step_job = nil
	self:_step_done(job, sim)
end

--- Applies one local delta; true when the title world ended and a fresh one is being prepared.
function Session._apply_local_delta(self: any, d: { [string]: any }?): boolean
	local state = self.state
	if state == nil or d == nil then
		return false
	end
	self:_apply(state, d)
	self._last_delta = self.env.now()
	-- The title globe is an endless showcase: begin a fresh world when one is conquered.
	if self.mode == MODE_TITLE and state.phase == PHASE_OVER and not self._title_restart_pending then
		self._title_restart_pending = true
		local defer = self.env.defer
		if defer then
			defer(function()
				self:start_title()
			end)
		else
			self:start_title()
		end
		return true
	end
	return false
end

function Session._stop_local(self: any)
	self._sim = nil
	self._step_job = nil
	table.clear(self._queued)
end

function Session._update_render_tick(self: any, dt: number)
	local state = self.state
	if state == nil then
		return
	end
	local since = self.env.now() - self._last_delta
	local speed = if self.mode ~= MODE_MULTI then self.local_speed else 1.0
	local tick = state.tick
	local target = tick + math.clamp(since * Session.TICK_RATE * speed, 0.0, 1.25)
	local rt = state.render_tick
	if rt < tick - 5.0 or rt > target + 2.0 then
		state.render_tick = tick
	else
		local a = math.clamp(dt * 12.0, 0.0, 1.0)
		state.render_tick = math.max(rt, rt + (target - rt) * a)
	end
end

function Session._set_mode(self: any, new_mode: number)
	if self.mode == new_mode then
		return
	end
	self.mode = new_mode
	self:_emit("mode_changed", new_mode)
end

function Session._on_server_lost(self: any)
	-- Not in multiplayer, or already on the way back to the title (e.g. MATCH_CLOSED came first).
	if (self.mode ~= MODE_MULTI or self._mp_leaving) and not self._mp_waiting then
		return
	end
	self._mp_waiting = false
	self:_cancel_join()
	self:_emit("notice", "Lost connection to the game server. You're back at the title screen.", Session.NOTICE_ERROR)
	self:start_title()
end

function Session._leave_multiplayer_if_needed(self: any)
	if self.mode == MODE_MULTI or self._mp_waiting then
		self._mp_waiting = false
		self._mp_leaving = self.mode == MODE_MULTI
		self:_cancel_join()
		if self:multiplayer_available() then
			self.env.net.send(OP.LEAVE)
		end
	end
end

--- Fires one of our signals. A handler error (a view or UI bug) is reported once per signal and never
--- aborts the Session's own state change (Godot logs a handler error and carries on). Note: Core/Signal
--- stops at the first failing handler, so later handlers of that emission are skipped.
function Session._emit(self: any, name: string, ...: any)
	local sig = self[name]
	local ok, err = xpcall(sig.Fire, debug.traceback, sig, ...)
	if not ok then
		self._emit_warned = self._emit_warned or {}
		if not self._emit_warned[name] then
			self._emit_warned[name] = true
			local w = self.env.warn
			if w then
				w("[Session] a " .. name .. " handler failed: " .. tostring(err))
			end
		end
	end
end

--- Applies a delta to the mirror; a failing GameState signal handler is reported once and does not
--- stop the Session. Returns false when apply_delta raised (the mirror may be partly updated).
function Session._apply(self: any, state: any, d: { [string]: any }): boolean
	local ok, err = xpcall(state.apply_delta, debug.traceback, state, d)
	if not ok and not self._apply_warned then
		self._apply_warned = true
		local w = self.env.warn
		if w then
			w("[Session] applying a delta failed: " .. tostring(err))
		end
	end
	return ok
end

--- The multiplayer mirror missed or half-applied a delta: from here on it may diverge from the
--- server (wrong owners, phantom units) for the rest of the match, so ask for a fresh snapshot. The
--- server answers with its normal snapshot path (_on_snapshot handles one mid-match). Rate-limited
--- here and on the server.
function Session._request_resync(self: any)
	if self.mode ~= MODE_MULTI or self.state == nil or self._join_job ~= nil then
		return
	end
	local now = self.env.now()
	if now - self._resync_at < Session.RESYNC_GAP_S or not self:multiplayer_available() then
		return
	end
	self._resync_at = now
	self._resync_pending = true
	self.env.net.send(OP.RESYNC)
end

function Session._warn_once(self: any, text: string)
	if self._net_warned then
		return
	end
	self._net_warned = true
	local w = self.env.warn
	if w then
		w(text)
	end
end

-- =============================================================================================
-- Multiplayer — server messages
-- =============================================================================================

function Session._on_net(self: any, op: number, ...: any)
	if op == OP.DELTA then
		self:_on_delta(...)
	elseif op == OP.LOBBY then
		self:_on_lobby(...)
	elseif op == OP.SNAPSHOT then
		self:_on_snapshot(...)
	elseif op == OP.NOTICE then
		local text, severity = ...
		if type(text) == "string" then
			self:_emit("notice", text, tonumber(severity) or Session.NOTICE_INFO)
		end
	elseif op == OP.MATCH_CLOSED then
		self:_on_match_closed(...)
	elseif op == OP.SETTINGS then
		self:_on_settings(...)
	elseif op == OP.LOBBIES then
		local list, kinds = ...
		if type(list) == "table" then
			self.lobbies = list
			if type(kinds) == "table" then
				local k = {}
				for _, m in kinds do
					if m == "ffa" or m == "team" or m == "world" then
						table.insert(k, m)
					end
				end
				self.lobby_kinds = k
			end
			self:_emit("lobbies_updated", list)
		end
	elseif op == OP.PUBLIC_STATE then
		local st, mode, info = ...
		if st == "joining" or st == "line" or st == "going" or st == "idle" then
			self.public = {
				state = st,
				mode = if mode == "ffa" or mode == "team" or mode == "world" then mode else nil,
				info = if type(info) == "table" then info else nil,
			}
			self:_emit("public_changed", self.public)
		end
	elseif op == OP.JOIN_RESULT then
		local ok, reason = ...
		if ok ~= true then
			self:_emit("join_failed", if type(reason) == "string" then reason else "")
		end
	elseif op == OP.CREDITS then
		local c = ...
		local clean = {}
		if type(c) == "table" then
			for k, v in c do
				if type(k) == "string" and type(v) == "number" then
					clean[k] = v
				end
			end
		end
		self.credits = clean
		self:_emit("credits_changed", clean)
	elseif op == OP.INVENTORY then
		local inv = ...
		if type(inv) == "table" then
			local owned = {}
			for _, id in (if type(inv.owned) == "table" then inv.owned else {}) do
				if type(id) == "string" then
					owned[id] = true
				end
			end
			local eq = if type(inv.equipped) == "table" then inv.equipped else {}
			self.inventory = {
				owned = owned,
				equipped = {
					skin = if type(eq.skin) == "string" then eq.skin else nil,
					flag = if type(eq.flag) == "string" then eq.flag else nil,
				},
				crates_bought = tonumber(inv.crates_bought) or 0,
				crates_allowed = inv.crates_allowed == true,
				stars = math.max(0, math.floor(tonumber(inv.stars) or 0)),
				unlocks = {},
				loaded = true,
				starter = Session._starter_of(inv.starter),
			}
			local was = self._unlocks_seen
			local fresh = {}
			for _, key in (if type(inv.unlocks) == "table" then inv.unlocks else {}) do
				if type(key) == "string" and Arsenal.item(key) ~= nil then
					self.inventory.unlocks[key] = true
					if was ~= nil and not was[key] then
						table.insert(fresh, key)
					end
				end
			end
			self._unlocks_seen = self.inventory.unlocks
			-- a solo match in progress shows a change of skin / flag at once, and a new unlock works
			if self.mode == MODE_SOLO and self.state ~= nil and (self.state.local_owner or 0) ~= 0 then
				self:_apply_own_cosmetics(self.state.local_owner)
				self:_apply_own_unlocks()
			end
			self:_emit("inventory_changed", self.inventory)
			for _, key in fresh do
				self:_emit("unlocked", key)
			end
		end
	elseif op == OP.GENERAL then
		local st = ...
		if type(st) == "table" then
			self.general = st.on == true
			local g = if type(st.given) == "table" then st.given else nil
			local given = if g ~= nil
				then {
					crate = g.crate == true,
					stars = if type(g.stars) == "number" then g.stars else nil,
					skin = if type(g.skin) == "string" then g.skin else nil,
				}
				else nil
			self:_emit("general_changed", self.general, given)
		end
	elseif op == OP.CRATE_RESULT then
		local ok, res = ...
		self:_emit("crate_result", ok == true, if type(res) == "string" then res else "")
	elseif op == OP.STARS then
		local p = ...
		if type(p) == "table" and type(p.total) == "number" then
			local lines = {}
			for _, l in (if type(p.lines) == "table" then p.lines else {}) do
				if type(l) == "table" and type(l[1]) == "string" and type(l[2]) == "number" then
					table.insert(lines, { l[1], l[2] })
				end
			end
			local award = {
				lines = lines,
				total = p.total,
				balance = tonumber(p.balance) or 0,
				mode = if type(p.mode) == "string" then p.mode else "public",
			}
			self.last_award = award
			self:_emit("stars_awarded", award)
		end
	elseif op == OP.UNLOCK_RESULT then
		local key, ok, reason = ...
		if type(key) == "string" then
			self:_emit("unlock_result", key, ok == true, if type(reason) == "string" then reason else nil)
		end
	elseif op == OP.HOP_RESULT then
		local going = ...
		self:_emit("hop_result", going == true)
	elseif op == OP.PARTY_STATE then
		local st = ...
		if type(st) == "table" then
			self.party = st
			self:_emit("party_changed", st)
		end
	elseif op == OP.COSMETICS then
		local map = ...
		if type(map) == "table" then
			self._cosmetics_map = map
			if self.mode == MODE_MULTI and self.state_mode == MODE_MULTI and self.state ~= nil then
				self.state:set_cosmetics(map, true)
			end
		end
	elseif op == OP.OWNER_CHANGED then
		-- a public match: the takeover happened on the server; this player commands `id` now
		local id = ...
		if type(id) == "number" and self.mode == MODE_MULTI and self.state ~= nil then
			self.state.local_owner = id
			table.clear(self._queued)
			self:_emit("took_over", id)
		end
	elseif op == OP.CREDIT_RESULT then
		local kind, ok, reason = ...
		if type(kind) == "string" then
			self:_emit("credit_result", kind, ok == true, if type(reason) == "string" then reason else nil)
		end
	elseif op == OP.ADMIN_BOTS then
		local ids = ...
		if type(ids) == "table" then
			local set = {}
			for _, id in ids do
				if type(id) == "number" then
					set[id] = true
				end
			end
			self.admin_bots = set
			self:_emit("admin_changed")
		end
	end
end

function Session._on_lobby(self: any, info: any)
	if type(info) ~= "table" then
		return
	end
	local was_available = self.lobby.available
	self.lobby = info
	if info.available == nil then
		info.available = true
	end
	-- Download the (next) match's map ahead of the snapshot.
	if type(info.map_id) == "string" then
		self:_fetch_map(info.map_id)
	end
	if info.available == false then
		info.closed = true
	end
	-- A public lobby's own server: the waiting room shows the match's map behind it.
	if
		info.kind == "match"
		and type(info.map_id) == "string"
		and (info.stage == "lobby" or info.stage == "idle")
		and (self._mp_waiting or self.mode ~= MODE_MULTI)
	then
		self:_show_wait_map(info.map_id)
	end
	-- A public lobby's match server: everyone here came to play it — join at once (and the
	-- Studio stand-in, where the hub server joined us itself, puts us in the waiting room).
	if info.kind == "match" and info.available ~= false and self.mode ~= MODE_MULTI then
		if info.in_match == true then
			self._mp_waiting = true
			self._mp_leaving = false
			self:_set_mode(MODE_MULTI)
		elseif not self._auto_joined then
			self._auto_joined = true
			self:join_multiplayer()
		end
	end
	self:_emit("lobby_updated", info)
	if was_available and info.available == false then
		self:_on_server_lost()
	end
end

function Session._on_snapshot(self: any, owner_id: any, msg: any)
	if self.mode ~= MODE_MULTI or type(owner_id) ~= "number" or type(msg) ~= "buffer" then
		return
	end
	-- Sent before the server processed our LEAVE (e.g. a rematch starting): we are on our way out.
	if self._mp_leaving and not self._mp_waiting then
		return
	end
	-- Discard any local (title) world still being prepared; the match takes over — and stop the one
	-- on screen now, so its memory is free before the match's state is built.
	self._build_serial += 1
	self._build_job = nil
	self:_stop_local()
	self._join_owner = owner_id
	table.clear(self._join_deltas)
	local GameState = self:_core("GameState")
	local WorldMap = self:_core("WorldMap")
	self:_preload_map(nil)
	self:_preload_map(self.lobby.map_id)
	local job = Coop.job(function()
		local snap = Protocol.decode_snapshot(msg)
		Coop.check()
		local gs = GameState.new(self:_await_map(WorldMap, snap.map_id))
		gs:load_snapshot(snap)
		gs.local_owner = owner_id
		return gs
	end)
	self._join_job = job
	if not self.threaded then
		job:finish()
		self:_run_join()
	end
end

function Session._run_join(self: any)
	local job = self._join_job
	if not job.done then
		job:step(self.build_budget_s)
		if not job.done then
			return
		end
	end
	self._join_job = nil
	if not job.ok then
		self:_warn_once("[Session] bad snapshot: " .. tostring(job.err))
		self._mp_waiting = false
		self:_emit("notice", "Couldn't load the match. You're back at the title screen.", Session.NOTICE_ERROR)
		self.env.net.send(OP.LEAVE)
		self:start_title()
		return
	end
	if self.mode ~= MODE_MULTI then
		return
	end
	self:_stop_local()
	self._mp_waiting = false
	--- (for the UI: this state replaces the same match's after a failed delta, it starts nothing)
	self.state_is_resync = self._resync_pending == true
	self._resync_pending = false
	local state = job.result
	self.state = state
	self.state_mode = MODE_MULTI
	self._last_delta = self.env.now()
	-- Deltas that arrived while the snapshot was loading, in order.
	local queued = self._join_deltas
	self._join_deltas = {}
	state:set_cosmetics(self._cosmetics_map, true)
	self:_emit("state_ready", state)
	self:_emit("joined_owner", self._join_owner)
	for _, q in queued do
		self:_apply_remote(q[1], q[2])
	end
end

function Session._cancel_join(self: any)
	self._join_job = nil
	table.clear(self._join_deltas)
end

function Session._on_delta(self: any, msg: any, tail: any)
	if type(msg) ~= "buffer" or (tail ~= nil and type(tail) ~= "buffer") then
		return
	end
	if self._join_job ~= nil then
		table.insert(self._join_deltas, { msg, tail })
		return
	end
	self:_apply_remote(msg, tail)
end

function Session._apply_remote(self: any, msg: buffer, tail: buffer?)
	local state = self.state
	if self.mode ~= MODE_MULTI or self._sim ~= nil or state == nil then
		return
	end
	local ok, d = pcall(Protocol.decode_delta, msg, tail)
	if not ok then
		self:_warn_once("[Session] bad delta: " .. tostring(d))
		self:_request_resync()
		return
	end
	-- Deltas already contained in the snapshot we loaded are skipped.
	if d.t ~= nil and d.t <= state.tick then
		return
	end
	if not self:_apply(state, d) then
		self:_request_resync()
	end
	self._last_delta = self.env.now()
end

function Session._on_match_closed(self: any, reason: any)
	-- The server removed us from the match (idle between matches, or the match ended for good).
	if self.mode == MODE_MULTI then
		self._mp_waiting = false
		self:_cancel_join()
		if type(reason) == "string" and reason ~= "" then
			self:_emit("notice", reason, Session.NOTICE_INFO)
		end
		self:start_title()
	end
end

function Session._on_settings(self: any, all: any)
	if type(all) ~= "table" then
		return
	end
	-- Sections saved locally before the server's copy arrived are newer, but hold only what this
	-- session touched: merge them key by key over the stored section (then send the merged section).
	for section, values in Settings.clean_all(all) do
		local mine = self._settings[section]
		if mine == nil then
			self._settings[section] = values
		elseif self._settings_dirty[section] then
			local merged = Settings.copy_section(values)
			for k, v in mine do
				merged[k] = v
			end
			self._settings[section] = Settings.clean_section(merged)
		end
	end
	local first = not self.settings_ready
	self.settings_ready = true
	self:_emit("settings_loaded")
	if first then
		self:_flush_settings(true)
	end
end

return Session
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="134">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">AlertBanner</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/alert_banner.gd (UIAlertBanner)
-- Red pulsing "INCOMING NUKE" banner shown while nukes aimed at your land are in flight; turns
-- green ("INTERCEPTED!") for a moment when a SAM shoots the last one down.
--
-- Members: panel. Methods: apply_layout(y, right_x = -1), clear(), is_green(), track(uid) -> bool,
-- resolve(uid, intercepted); per frame update(dt).

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")

local AlertBanner = W.class(W.Control)

local RED_TITLE = Color3.new(1.0, 0.55, 0.58)
local RED_TINT = UITheme.rgba(0.26, 0.03, 0.07, 0.9)

function AlertBanner.new(c: any)
	local self = setmetatable({}, AlertBanner.__mt)
	W.Control._init(self)
	local T = UITheme
	self.ctx = c
	self._incoming = {} -- uid -> true
	self._t = 0.0
	--- Seconds left of the green "intercepted" state (0 = normal).
	self._green = 0.0
	--- The incoming set changed since the text was written (update() writes it).
	self._stale = false
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self.panel = GlassPanel.new(18.0, 10.0, 999, true, 24)
	self.panel:set_mouse_filter(W.MOUSE_IGNORE)
	self.panel:set_tint(RED_TINT)
	self.panel:set_border(T.c(T.RED, 0.8))
	self:add_child(self.panel)
	local row = T.hbox(12)
	self.panel:add_child(row)
	self._disc = W.Panel.new()
	self._disc:set_mouse_filter(W.MOUSE_IGNORE)
	self._disc:set_min_size(Vector2.new(34, 34))
	self._disc:add_theme_stylebox_override("panel", T.flat(T.c(T.RED, 0.25), 17, T.RED, 1))
	local ic = T.icon_rect("atom", 18.0, Color3.new(1.0, 0.85, 0.85))
	self._disc_icon = ic
	ic.size_flags_horizontal = W.SHRINK_CENTER
	ic.size_flags_vertical = W.SHRINK_CENTER
	self._disc:add_child(ic)
	row:add_child(self._disc)
	local v = T.vbox(0)
	v.size_flags_vertical = W.SHRINK_CENTER
	self._title = T.label("INCOMING NUKE", 15, 800, RED_TITLE, 3)
	v:add_child(self._title)
	self._detail = T.label("", 12, 500, Color3.new(1.0, 0.88, 0.88))
	v:add_child(self._detail)
	row:add_child(v)
	self:set_visible(false)
	return self
end

--- Centred under the status pill on larger screens; right-aligned under the leaderboard pill on phones.
function AlertBanner.apply_layout(self, y: number, right_x: number?)
	local ctx = self.ctx
	local T = UITheme
	local rx = right_x or -1.0
	local p = self.panel
	p:set_mouse_filter(if ctx.touch then W.MOUSE_STOP else W.MOUSE_IGNORE)
	-- Fixed width: long nation names ellipsize instead of stretching the banner.
	local w = if ctx.compact then 330.0 else 380.0
	T.fix_width(self._detail, w, W.ALIGN_LEFT, false)
	T.fix_width(self._title, w, W.ALIGN_LEFT, false)
	p.anchor_top = 0.0
	p.anchor_bottom = 0.0
	p.grow_vertical = W.GROW_END
	if rx >= 0 then
		p.anchor_left = 1.0
		p.anchor_right = 1.0
		p.grow_horizontal = W.GROW_BEGIN
		p.offset_left = -rx
		p.offset_right = -rx
	else
		p.anchor_left = 0.5
		p.anchor_right = 0.5
		p.grow_horizontal = W.GROW_BOTH
		local dx, yy = ctx:place_top(p:get_combined_minimum_size().X, y)
		p.offset_left = dx
		p.offset_right = dx
		y = yy
	end
	p.offset_top = y
	p.offset_bottom = y
	p:reset_size()
end

function AlertBanner.clear(self)
	table.clear(self._incoming)
	self._green = 0.0
	self:set_visible(false)
	self:_set_red()
end

function AlertBanner.is_green(self): boolean
	return self._green > 0
end

function AlertBanner._show_green(self, last: boolean)
	local T = UITheme
	self._green = 1.6
	self:set_visible(true)
	self:set_modulate_a(1.0)
	self._title:set_text("INTERCEPTED!")
	self._title:set_color(Color3.new(0.6, 1.0, 0.72))
	self._detail:set_text("Shot down by a SAM" .. (if last then "" else " · more incoming"))
	self.panel:set_tint(T.rgba(0.03, 0.2, 0.09, 0.9))
	self.panel:set_border(T.c(T.GREEN, 0.9))
	self._disc:add_theme_stylebox_override("panel", T.flat(T.c(T.GREEN, 0.25), 17, T.GREEN, 1))
	self._disc_icon:set_icon("sam")
	self._disc_icon:set_color(Color3.new(0.85, 1.0, 0.9))
	self.panel:reset_size()
end

function AlertBanner._set_red(self)
	local T = UITheme
	self._title:set_color(RED_TITLE)
	self.panel:set_tint(RED_TINT)
	self.panel:set_border(T.c(T.RED, 0.8))
	self._disc:add_theme_stylebox_override("panel", T.flat(T.c(T.RED, 0.25), 17, T.RED, 1))
	self._disc_icon:set_icon("atom")
	self._disc_icon:set_color(Color3.new(1.0, 0.85, 0.85))
end

--- Returns true when this nuke is newly aimed at the local player, and true again when it is the
--- one that brings the banner up.
--- (The text is written once a frame, in update(): a MIRV's 350 warheads are tracked in one tick and
--- land within seconds, and each used to rewrite both lines and size the panel again.)
function AlertBanner.track(self, uid: number): (boolean, boolean)
	local ctx = self.ctx
	local s = ctx.state
	if s == nil or s.nukes[uid] == nil or ctx:me() == 0 then
		return false, false
	end
	local n = s.nukes[uid]
	if n.owner == ctx:me() or s:tile_owner(n.to_tile) ~= ctx:me() then
		return false, false
	end
	local first = next(self._incoming) == nil
	self._incoming[uid] = true
	if first then
		self:set_visible(true)
		W.pop_in(self.panel, 0.0, 1.15, 0.35)
		self:_refresh()
	else
		self._stale = true
	end
	return true, first
end

--- `intercepted`: a SAM shot it down (the banner flashes green before it goes).
function AlertBanner.resolve(self, uid: number, intercepted: boolean?)
	if not self._incoming[uid] then
		return
	end
	self._incoming[uid] = nil
	if intercepted then
		self:_show_green(next(self._incoming) == nil)
		return
	end
	if next(self._incoming) == nil then
		local t = self:create_tween()
		t:tween_property(self, "modulate:a", 0.0, 0.4)
		t:tween_callback(function()
			if next(self._incoming) == nil then
				self:set_visible(false)
			end
			self:set_modulate_a(1.0)
		end)
	else
		self._stale = true
	end
end

function AlertBanner._refresh(self)
	self._stale = false
	local ctx = self.ctx
	local s = ctx.state
	if s == nil then
		return
	end
	local Defs = UITheme.core("Defs")
	local soonest = 1e9
	local kind = -1
	local from = 0
	local count = 0
	local gone = {}
	for uid in pairs(self._incoming) do
		local n = s.nukes[uid]
		if n == nil then
			table.insert(gone, uid)
		else
			count += 1
			local left = (n.launch_tick + n.flight_ticks) - ctx:render_tick()
			if left < soonest then
				soonest = left
				kind = n.kind
				from = n.owner
			end
		end
	end
	for _, uid in ipairs(gone) do
		self._incoming[uid] = nil
	end
	if count == 0 then
		return
	end
	local secs = math.max(0, math.ceil(soonest / Defs.TICK_RATE))
	local what = (if kind >= 0 then Defs.NUKE_TITLES[kind] else nil) or "Nuke"
	if count > 1 then
		self._title:set_text(string.format("INCOMING NUKES ×%d", count))
		self._detail:set_text(string.format("First impact in %ds · from %s", secs, s:owner_name(from)))
	else
		self._title:set_text("INCOMING NUKE")
		self._detail:set_text(string.format("%s from %s · impact in %ds", what, s:owner_name(from), secs))
	end
	self.panel:reset_size()
end

--- Per frame (GDScript _process).
function AlertBanner.update(self, delta: number)
	if not self.visible then
		return
	end
	local T = UITheme
	if self._green > 0 then
		self._green -= delta
		if self._green <= 0 then
			self:_set_red()
			if next(self._incoming) == nil then
				local t = self:create_tween()
				t:tween_property(self, "modulate:a", 0.0, 0.35)
				t:tween_callback(function()
					if next(self._incoming) == nil and self._green <= 0 then
						self:set_visible(false)
					end
					self:set_modulate_a(1.0)
				end)
			else
				self:_refresh()
			end
		end
		return
	end
	local prev = self._t
	self._t += delta
	local p = 0.5 + 0.5 * math.sin(self._t * 7.0)
	self.panel:set_border(T.c(T.RED, 0.45 + 0.5 * p))
	self._disc:set_modulate_a(0.75 + 0.25 * p)
	if self._stale or math.floor(self._t * 4.0) ~= math.floor(prev * 4.0) then
		self:_refresh()
	end
end

return AlertBanner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">Arsenal</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The Arsenal (2026-10-04: units like Artillery and special nukes, unlocked by grinding Stars or
-- with Robux): a modal for the items of Data/Arsenal. It opens from the
-- title (ArsenalButton), from the command bar's SHOP button, and on its item when a locked unit is
-- pressed in a match.
--
-- One item at a time (2026-10-24: the old menu was so confusing that players opened it and bought
-- nothing; of 4.63M opens in a week,
-- 164K pressed a price). It was a grid of eight cards, each with an unlabeled Stars pill and an
-- unlabeled Robux pill under a small busy scene.
--   list     on the left, the items grouped NUKES / ARMY / BOOSTS: each a row with its render, its name
--            and what it takes: OWNED, its Stars when the player has enough, else its Robux price. A
--            press shows it on the right.
--   item     on the right: what it does in a match, playing big (UI/ArsenalDemo); its name, what kind
--            of thing it is and FOREVER; one plain sentence (Data/Arsenal `plain`) and two facts. Then
--            one big BUY NOW button with the Robux price, and under it the other way: OR UNLOCK WITH
--            ★ 20,000 when the player has the Stars (a press asks once more, the second spends them),
--            else how far along they are with a bar. An item the player has reads OWNED.
--   header   the title, one line of what this is, the Stars balance, close.
-- It opens on the item it was asked for, else the first one the player's Stars can unlock, else the
-- first one they don't have. An unlock (Session.unlocked, however it was bought) flashes its item.
-- It closes from its close button or a press outside the window, never from a press on the window.
-- Signals: closed.
local UITheme = require("./UITheme")
local JutsuGlyph = require("./JutsuGlyph")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local Signal = UITheme.core("Signal")

local IS_ROBLOX = typeof(game) == "Instance"
local function shared(name: string): any
	if IS_ROBLOX then
		return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data[name]) :: any
	end
	return (require :: any)("../../shared/Data/" .. name)
end
local Catalog = shared("Arsenal")
local Products = shared("Products")
local Prices = require("./Prices")
local ArsenalDemo = require("./ArsenalDemo")
local FrameClock = require("../Map/FrameClock")
local TweenService = if IS_ROBLOX then game:GetService("TweenService") else nil

local Art: any = (function()
	local ok, m = pcall(function()
		if IS_ROBLOX then
			return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Assets.ArsenalArt)
		end
		return (require :: any)("../../shared/Assets/ArsenalArt")
	end)
	return if ok and type(m) == "table" then m else {}
end)()

local Arsenal = W.class(W.Control)

--- The list's groups, in order: a heading and the kinds in it.
Arsenal.GROUPS = {
	{ "JUTSU", { nuke = true } },
	{ "SHINOBI SUPPORT", { call = true, structure = true } },
	{ "BOOSTS", { boost = true } },
}
Arsenal.KIND_TAGS = { structure = "BUILDING", nuke = "JUTSU", call = "ORDER", boost = "BOOST" }
--- Under the title.
Arsenal.SUBTITLE = "Unlock once, keep it forever. Earn Stars by playing matches."
--- Logical px: the list's width, a row's height, the item's width and its preview's height (desktop);
--- phones put the preview beside the words.
Arsenal.LIST_W = 236
Arsenal.LIST_W_PHONE = 190
Arsenal.ROW_H = 46
Arsenal.ROW_H_PHONE = 38
Arsenal.DETAIL_W = 470
Arsenal.PREVIEW_H = 228
--- "PRESS AGAIN" stands this long before the Stars button goes back to its price.
Arsenal.CONFIRM_S = 3.0
--- A purchase whose answer never comes gives up after this long (it is still saved on the server).
Arsenal.WAIT_S = 30.0
--- A note under the buttons stays this long.
Arsenal.NOTE_S = 4.0

local FONT_H = Font.fromId(12187365977, Enum.FontWeight.Heavy)
local FONT_B = Font.fromId(12187365977, Enum.FontWeight.Bold)
local FONT_M = Font.fromId(12187365977, Enum.FontWeight.Medium)
local GOLD = Color3.fromRGB(255, 200, 61)
local GOLD_DARK = Color3.fromRGB(64, 40, 4)
-- BUY NOW: its face's gradient (top, bottom; brighter under the pointer), its lip, the ink of its price
local GREEN_TOP = Color3.fromRGB(86, 216, 130)
local GREEN_BOTTOM = Color3.fromRGB(34, 166, 90)
local GREEN_TOP_HI = Color3.fromRGB(108, 234, 150)
local GREEN_BOTTOM_HI = Color3.fromRGB(46, 186, 106)
local GREEN_LIP = Color3.fromRGB(18, 108, 56)
local GREEN_INK = Color3.fromRGB(12, 82, 42)
local OWNED_GREEN = Color3.fromRGB(110, 230, 155)
local WHITE = Color3.new(1, 1, 1)
local MUTED = Color3.fromRGB(170, 182, 211)
local ROW = Color3.fromRGB(24, 33, 58)
local ROW_ON = Color3.fromRGB(38, 53, 90)
local CHIP = Color3.fromRGB(38, 53, 90)
local BAR_OFF = Color3.fromRGB(44, 58, 94)
local BAR_LIP = Color3.fromRGB(28, 38, 64)
--- the dark a preview's ground fades into
local NIGHT = Color3.fromRGB(8, 12, 26)
local ROBUX = "rbxasset://textures/ui/common/robux@3x.png"

local function c3(hex: number): Color3
	return Color3.fromRGB((hex // 65536) % 256, (hex // 256) % 256, hex % 256)
end

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	if TweenService ~= nil then
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
			:Play()
	end
end

--- 12345 -> "12,345".
function Arsenal.commas(n: number): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return if n < 0 then "-" .. out else out
end

--- 20000 -> "20K", 1500 -> "1,500" (a list row's room).
function Arsenal.short(n: number): string
	if n >= 10000 and n % 1000 == 0 then
		return Arsenal.commas(n / 1000) .. "K"
	end
	return Arsenal.commas(n)
end

--- The item the window opens on: `focus`, else the first the player's Stars can unlock, else the first
--- they don't have, else the first.
function Arsenal.pick(inv: any, focus: string?): string
	if focus ~= nil and Catalog.item(focus) ~= nil then
		return focus
	end
	local unlocks = inv.unlocks or {}
	local stars = inv.stars or 0
	for _, it in Catalog.ITEMS do
		if not unlocks[it.key] and it.stars ~= nil and stars >= it.stars then
			return it.key
		end
	end
	for _, it in Catalog.ITEMS do
		if not unlocks[it.key] then
			return it.key
		end
	end
	return Catalog.ITEMS[1].key
end

function Arsenal.new(c: any)
	local self = setmetatable({}, Arsenal.__mt)
	W.Control._init(self)
	self.ctx = c
	self.closed = Signal.new()
	self.is_open = false
	--- the list's rows: key -> parts
	self._rows = {} :: { [string]: any }
	--- the item shown on the right, and its parts
	self._sel = nil :: string?
	self._detail = nil :: any
	--- { key, how = "stars" | "robux", product?, since }: a purchase on its way
	self._pending = nil :: any
	--- key whose Stars button reads "PRESS AGAIN", and until when
	self._confirm = nil :: string?
	self._confirm_until = 0.0
	self._note = nil :: string?
	self._note_until = 0.0
	-- (Roblox's prices arrive a moment after the first look, and move with its price tests)
	self:_connect(Prices.changed:Connect(function()
		if self.is_open then
			self:_refresh()
		end
	end))
	self._focus = nil :: string?
	self._from = "title"
	--- items whose row was pressed this visit (each reported once)
	self._viewed = {} :: { [string]: boolean }
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	self:set_visible(false)
	self._dim = W.ColorRect.new(UITheme.rgba(0.01, 0.015, 0.05, 0.8))
	self._dim:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._dim.gui_input:Connect(function(e)
		-- (a press on the window's own ground reaches the dim too: only one outside it closes)
		if e.pressed and not self._panel:has_global_point(e.global_position) then
			self:close()
		end
	end)
	self:add_child(self._dim)
	self._panel = GlassPanel.new(20.0, 16.0, 18, true, 34)
	self._panel:set_tint(UITheme.rgba(0.045, 0.065, 0.13, 0.97))
	self:add_child(self._panel)
	local v = UITheme.vbox(12)
	self._v = v
	self._panel:add_child(v)
	-- head: the title, what this is, the Stars balance, close
	local head = UITheme.hbox(12)
	local icon = UITheme.icon_rect("arsenal", 26.0, UITheme.GOLD)
	icon.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(icon)
	local tv = UITheme.vbox(0)
	tv.size_flags_horizontal = W.EXPAND_FILL
	tv.size_flags_vertical = W.SHRINK_CENTER
	local title = UITheme.label("ARSENAL", 20, 800, UITheme.TEXT, 3)
	tv:add_child(title)
	self._sub = UITheme.label(Arsenal.SUBTITLE, 12, 500, UITheme.TEXT_2)
	tv:add_child(self._sub)
	head:add_child(tv)
	local bal = GlassPanel.new(12.0, 6.0, 999, false, 0)
	bal:set_tint(UITheme.rgba(1.0, 0.78, 0.24, 0.12))
	bal.size_flags_vertical = W.SHRINK_CENTER
	local bh = UITheme.hbox(6)
	local star = UITheme.icon_rect("star", 16.0, UITheme.GOLD)
	star.size_flags_vertical = W.SHRINK_CENTER
	bh:add_child(star)
	self._balance = UITheme.label("0", 16, 800, UITheme.GOLD)
	self._balance.size_flags_vertical = W.SHRINK_CENTER
	bh:add_child(self._balance)
	bal:add_child(bh)
	self._balance_pill = bal
	head:add_child(bal)
	local close = W.Button.new("", "GhostButton")
	close:set_icon("close")
	close.expand_icon = true
	close:set_min_size(Vector2.new(34, 34))
	close:add_theme_constant_override("icon_max_width", 13)
	close:add_theme_stylebox_override("normal", UITheme.empty_box(8, 8))
	close:add_theme_stylebox_override("hover", UITheme.flat(UITheme.FILL, 8, UITheme.CLEAR, 0, 8, 8))
	close.size_flags_vertical = W.SHRINK_CENTER
	close.pressed:Connect(function()
		self:close()
	end)
	head:add_child(close)
	v:add_child(head)
	-- body: the list | the item
	local body = UITheme.hbox(14)
	v:add_child(body)
	local list_host = W.Control.new()
	list_host:set_mouse_filter(W.MOUSE_PASS)
	self._list_host = list_host
	body:add_child(list_host)
	self._list = new("ScrollingFrame", {
		Name = "ArsenalList",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = WHITE,
		ScrollBarImageTransparency = 0.6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 40,
	}, list_host.gui)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, self._list)
	new(
		"UIPadding",
		{ PaddingRight = UDim.new(0, 6), PaddingLeft = UDim.new(0, 2), PaddingTop = UDim.new(0, 2) },
		self._list
	)
	local detail_host = W.Control.new()
	detail_host:set_mouse_filter(W.MOUSE_PASS)
	self._detail_host = detail_host
	body:add_child(detail_host)
	if IS_ROBLOX then
		game:GetService("MarketplaceService").PromptProductPurchaseFinished:Connect(function(_u, product_id, purchased)
			self:_on_prompt_done(product_id, purchased)
		end)
	end
	return self
end

--- The session's inventory, unlock answers and unlocks (UIRoot.setup, when the session exists).
function Arsenal.bind(self, s: any)
	if s == nil or self._bound == s then
		return
	end
	self._bound = s
	s.inventory_changed:Connect(function()
		if self.is_open then
			self:_refresh()
		end
	end)
	s.unlock_result:Connect(function(key: string, ok: boolean, reason: string?)
		self:_on_unlock_result(key, ok, reason)
	end)
	s.unlocked:Connect(function(key: string)
		self:_on_unlocked(key)
	end)
end

function Arsenal._inv(self): any
	local s = self.ctx.session
	return if s ~= nil and s.inventory ~= nil then s.inventory else { stars = 0, unlocks = {}, loaded = false }
end

function Arsenal._report(self, kind: string, a: any?, b: any?)
	local s = self.ctx.session
	if s ~= nil and type(s.report) == "function" then
		s:report(kind, a, b)
	end
end

--- The Robux price of `it` (Roblox's own once it answered), or nil while its product doesn't exist.
function Arsenal._robux(_self, it: any): number?
	local p = Products[it.product]
	if p == nil or p.id == 0 then
		return nil
	end
	return Prices.robux(it.product)
end

-- ---------------------------------------------------------------------------------------------
-- The list
-- ---------------------------------------------------------------------------------------------

function Arsenal._build_list(self)
	for _, ch in self._list:GetChildren() do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	table.clear(self._rows)
	local u = UITheme.scale
	local compact = self.ctx.compact
	local rh = (if compact then Arsenal.ROW_H_PHONE else Arsenal.ROW_H) * u
	local order = 0
	for _, g in Arsenal.GROUPS do
		order += 1
		new("TextLabel", {
			Name = "Group",
			BackgroundTransparency = 1,
			Text = g[1],
			FontFace = FONT_B,
			TextSize = math.floor(10 * u),
			TextColor3 = MUTED,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, math.floor(18 * u)),
			ZIndex = 41,
		}, self._list)
		for _, it in Catalog.ITEMS do
			if g[2][it.kind] and (it.stars ~= nil or self:_robux(it) ~= nil) then
				order += 1
				self._rows[it.key] = self:_row(it, order, rh, u)
			end
		end
	end
end

function Arsenal._row(self, it: any, order: number, rh: number, u: number): any
	local compact = self.ctx.compact
	local b = new("TextButton", {
		Name = "Row_" .. it.key,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = ROW,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, rh),
		ZIndex = 41,
	}, self._list)
	new("UICorner", { CornerRadius = UDim.new(0, 10 * u) }, b)
	local stroke = new("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = GOLD,
		Thickness = 1.5,
		Transparency = 1,
	}, b)
	-- the render, small, on its own colour
	local th = rh - 10 * u
	local tile = new("Frame", {
		Name = "Tile",
		BackgroundColor3 = c3(it.color[2]):Lerp(NIGHT, 0.35),
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 5 * u, 0.5, 0),
		Size = UDim2.fromOffset(th, th),
		ZIndex = 42,
	}, b)
	new("UICorner", { CornerRadius = UDim.new(0, 8 * u) }, tile)
	local shot = if type(Art.renders) == "table" then Art.renders[it.key] else nil
	local render = new("ImageLabel", {
		Name = "Render",
		BackgroundTransparency = 1,
		Image = if shot ~= nil then shot.id else (UITheme.icon(it.icon) or ""),
		ScaleType = Enum.ScaleType.Fit,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.86, 0.86),
		ZIndex = 43,
	}, tile)
	JutsuGlyph.apply(render, it.icon)
	-- (a long name shrinks to fit rather than being cut: "Reinforcements" on a phone)
	local name_fs = math.floor((if compact then 12 else 14) * u)
	local price_w = (if compact then 52 else 60) * u
	local name = new("TextLabel", {
		Name = "Name",
		BackgroundTransparency = 1,
		Text = it.title,
		FontFace = FONT_B,
		TextScaled = true,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, th + 13 * u, 0.5, 0),
		Size = UDim2.new(1, -(th + 13 * u) - price_w - 10 * u, 0, name_fs + 2),
		ZIndex = 42,
	}, b)
	new("UITextSizeConstraint", { MaxTextSize = name_fs, MinTextSize = math.floor(name_fs * 0.7) }, name)
	-- what it takes: OWNED, ★ 20K, or the Robux price (right)
	local right = new("Frame", {
		Name = "Price",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8 * u, 0.5, 0),
		Size = UDim2.fromOffset(price_w, rh),
		ZIndex = 42,
	}, b)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 3 * u),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, right)
	local pic = new("ImageLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(13 * u, 13 * u),
		LayoutOrder = 1,
		ZIndex = 43,
	}, right)
	local tx = new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = FONT_H,
		TextSize = math.floor((if compact then 11 else 12) * u),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, rh),
		LayoutOrder = 2,
		ZIndex = 43,
	}, right)
	b.MouseEnter:Connect(function()
		if self._sel ~= it.key then
			b.BackgroundColor3 = ROW:Lerp(ROW_ON, 0.5)
		end
	end)
	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = if self._sel == it.key then ROW_ON else ROW
	end)
	b.Activated:Connect(function()
		self:_select(it.key, true)
	end)
	return { button = b, stroke = stroke, name = name, icon = pic, text = tx }
end

function Arsenal._refresh_list(self)
	local inv = self:_inv()
	local stars = inv.stars or 0
	for key, r in self._rows do
		local it = Catalog.item(key)
		local on = self._sel == key
		r.button.BackgroundColor3 = if on then ROW_ON else ROW
		r.stroke.Transparency = if on then 0 else 1
		if inv.unlocks[key] then
			r.icon.Visible = false
			r.text.Text = "OWNED"
			r.text.TextColor3 = OWNED_GREEN
		elseif it.stars ~= nil and stars >= it.stars then
			r.icon.Visible = true
			r.icon.Image = UITheme.icon("star") or ""
			r.icon.ImageColor3 = GOLD
			r.text.Text = Arsenal.short(it.stars)
			r.text.TextColor3 = GOLD
		else
			local price = self:_robux(it)
			r.icon.Visible = price ~= nil
			r.icon.Image = ROBUX
			r.icon.ImageColor3 = WHITE
			r.text.Text = if price ~= nil then Arsenal.commas(price) else "SOON"
			r.text.TextColor3 = WHITE
		end
	end
end

-- ---------------------------------------------------------------------------------------------
-- The item
-- ---------------------------------------------------------------------------------------------

--- The item's area in logical px for this layout: its width, its height, whether the preview sits
--- beside the words (phones) and the preview's size.
function Arsenal._detail_geometry(self): (number, number, boolean, Vector2)
	local size = self._detail_size or Vector2.new(Arsenal.DETAIL_W, Arsenal.PREVIEW_H + 250)
	local side = self.ctx.compact
	local pv = if side
		then Vector2.new(math.floor(math.min(size.X * 0.42, size.Y * 1.25)), size.Y)
		else Vector2.new(size.X, Arsenal.PREVIEW_H)
	return size.X, size.Y, side, pv
end

function Arsenal._build_detail(self)
	if self._detail ~= nil then
		if self._detail.demo ~= nil then
			self._detail.demo:destroy()
		end
		self._detail.root:Destroy()
		self._detail = nil
	end
	local it = Catalog.item(self._sel or "")
	if it == nil then
		return
	end
	local u = UITheme.scale
	local compact = self.ctx.compact
	local dw, dh, side, pv = self:_detail_geometry()
	local root = new("Frame", {
		Name = "ArsenalItem",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(dw * u, dh * u),
		ZIndex = 40,
	}, self._detail_host.gui)
	-- the preview: what it does in a match (ArsenalDemo), its render a sticker in the corner
	local pw, ph = pv.X * u, pv.Y * u
	local ground = new("CanvasGroup", {
		Name = "Preview",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(pw, ph),
		ZIndex = 41,
	}, root)
	new("UICorner", { CornerRadius = UDim.new(0, 12 * u) }, ground)
	local top, bottom = c3(it.color[1]), c3(it.color[2])
	local grad = new("UIGradient", {
		Color = ColorSequence.new(top:Lerp(NIGHT, 0.42), bottom:Lerp(NIGHT, 0.8)),
		Rotation = 90,
	}, ground)
	local demo = if ArsenalDemo["_build_" .. it.key] ~= nil
		then ArsenalDemo.new(ground, it, Vector2.new(pw, ph), u, 0, root, 12 * u)
		else nil
	if demo ~= nil then
		grad.Enabled = false -- (a gradient on a CanvasGroup tints everything in it)
		if demo:has_map() then
			-- (the map lies under the group: ArsenalDemo._map)
			ground.BackgroundTransparency = 1
		end
	end
	local shot = if type(Art.renders) == "table" then Art.renders[it.key] else nil
	local image = if shot ~= nil then shot.id else (UITheme.icon(it.icon) or "")
	local sh = (if demo ~= nil then 0.36 else 0.8) * ph
	local sw = if shot ~= nil then sh * shot.w / shot.h else sh * 0.6
	local max_w = pw * (if demo ~= nil then 0.28 else 0.8)
	if sw > max_w then
		sh *= max_w / sw
		sw = max_w
	end
	local sticker = new("ImageLabel", {
		Name = "Render",
		BackgroundTransparency = 1,
		Image = image,
		AnchorPoint = if demo ~= nil then Vector2.new(0, 0) else Vector2.new(0.5, 0.5),
		Position = if demo ~= nil then UDim2.fromOffset(8 * u, 6 * u) else UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(sw, sh),
		ZIndex = 45,
	}, root)
	JutsuGlyph.apply(sticker, it.icon)
	local flash = new("Frame", {
		Name = "Flash",
		BackgroundColor3 = top,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(pw, ph),
		ZIndex = 49,
	}, root)
	new("UICorner", { CornerRadius = UDim.new(0, 12 * u) }, flash)
	-- the words: beside the preview on phones, under it otherwise
	local x0 = if side then pv.X + 14 else 0
	local y0 = if side then 0 else pv.Y + 12
	local tw = if side then dw - x0 else dw
	local col = new("Frame", {
		Name = "Words",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(x0 * u, y0 * u),
		Size = UDim2.fromOffset(tw * u, (dh - y0) * u),
		ZIndex = 41,
	}, root)
	local y = 0
	local name_fs = if compact then 18 else 24
	new("TextLabel", {
		Name = "Title",
		BackgroundTransparency = 1,
		Text = string.upper(it.title),
		FontFace = FONT_H,
		TextSize = math.floor(name_fs * u),
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(0, y * u),
		Size = UDim2.new(1, 0, 0, (name_fs + 4) * u),
		ZIndex = 42,
	}, col)
	y += name_fs + 6
	-- what kind of thing it is, and that it's forever
	local chips = new("Frame", {
		Name = "Chips",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, y * u),
		Size = UDim2.new(1, 0, 0, 20 * u),
		ZIndex = 42,
	}, col)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6 * u),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, chips)
	local function chip(text: string, color: Color3, order: number)
		local l = new("TextLabel", {
			BackgroundColor3 = CHIP,
			Text = text,
			FontFace = FONT_B,
			TextSize = math.floor(10 * u),
			TextColor3 = color,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 20 * u),
			LayoutOrder = order,
			ZIndex = 43,
		}, chips)
		new("UICorner", { CornerRadius = UDim.new(0, 6 * u) }, l)
		new("UIPadding", { PaddingLeft = UDim.new(0, 8 * u), PaddingRight = UDim.new(0, 8 * u) }, l)
	end
	-- (phones: the facts only; the list's headings say what kind it is, the subtitle that it's forever)
	if not compact then
		chip(Arsenal.KIND_TAGS[it.kind] or "", WHITE, 1)
		chip("FOREVER", OWNED_GREEN, 2)
	end
	for i, f in it.facts or {} do
		chip(string.upper(f), GOLD, 2 + i)
	end
	y += 28
	-- the one sentence
	local plain_fs = if compact then 12 else 14
	local plain_h = (plain_fs + 4) * 2
	new("TextLabel", {
		Name = "Plain",
		BackgroundTransparency = 1,
		Text = it.plain or it.tagline,
		FontFace = FONT_M,
		TextSize = math.floor(plain_fs * u),
		TextColor3 = Color3.fromRGB(214, 222, 240),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Position = UDim2.fromOffset(0, y * u),
		Size = UDim2.new(1, 0, 0, plain_h * u),
		ZIndex = 42,
	}, col)
	y += plain_h + (if compact then 6 else 12)
	-- how to get it (rebuilt on every refresh: _build_cta)
	local cta = new("Frame", {
		Name = "Get",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, y * u),
		Size = UDim2.new(1, 0, 1, -y * u),
		ZIndex = 42,
	}, col)
	self._detail = {
		key = it.key,
		root = root,
		demo = demo,
		sticker = sticker,
		flash = flash,
		cta = cta,
		width = tw,
	}
	self:_build_cta()
end

--- A full-width button at `y` (logical px), `h` tall; its row lays out the words and icons. Returns its parts.
local function button(
	parent: Instance,
	name: string,
	y: number,
	h: number,
	u: number,
	fill: Color3,
	stroke: Color3?
): any
	local b = new("TextButton", {
		Name = name,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = fill,
		-- (outlined: a faint wash of its colour, so it doesn't read as a hole)
		BackgroundTransparency = if stroke ~= nil then 0.9 else 0,
		BorderSizePixel = 0,
		-- (anchored at its centre: the hover and press scale grow from there)
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, y * u),
		Size = UDim2.new(1, 0, 0, h * u),
		ZIndex = 43,
	}, parent)
	new("UICorner", { CornerRadius = UDim.new(0, 12 * u) }, b)
	if stroke ~= nil then
		new("UIStroke", { Color = stroke, Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
	end
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 44 }, b)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6 * u),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, row)
	local s = new("UIScale", {}, b)
	b.MouseEnter:Connect(function()
		tween(s, 0.1, { Scale = 1.02 })
	end)
	b.MouseLeave:Connect(function()
		tween(s, 0.1, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		tween(s, 0.06, { Scale = 0.97 })
	end)
	b.MouseButton1Up:Connect(function()
		tween(s, 0.1, { Scale = 1 })
	end)
	return { button = b, row = row, scale = s }
end

--- BUY NOW (2026-10-24: the Robux buy buttons looked poor and needed a polish; it
--- was a flat green bar, BUY NOW, the Robux glyph and the price run together in the middle): a raised
--- face, a green gradient with a sheen, over a darker lip it sinks onto when pressed; BUY NOW on the
--- left and the price in a pill of its own on the right. `price` nil: SOON, grey; `busy`: "..." alone.
local function buy_button(
	parent: Instance,
	y: number,
	h: number,
	u: number,
	price: number?,
	busy: boolean,
	fs: number
): any
	local on = price ~= nil
	local lip = math.max(3, math.floor(4 * u + 0.5))
	local hh = math.floor(h * u + 0.5)
	local r = UDim.new(0, 12 * u)
	local b = new("TextButton", {
		Name = "Buy",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, y * u),
		Size = UDim2.new(1, 0, 0, hh + lip),
		ZIndex = 43,
	}, parent)
	local under = new("Frame", {
		Name = "Lip",
		BackgroundColor3 = if on then GREEN_LIP else BAR_LIP,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, lip),
		Size = UDim2.new(1, 0, 0, hh),
		ZIndex = 43,
	}, b)
	new("UICorner", { CornerRadius = r }, under)
	local face = new("Frame", {
		Name = "Face",
		BackgroundColor3 = if on then WHITE else BAR_OFF,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, hh),
		ZIndex = 44,
	}, b)
	new("UICorner", { CornerRadius = r }, face)
	local grad = new("UIGradient", {
		Color = ColorSequence.new(GREEN_TOP, GREEN_BOTTOM),
		Rotation = 90,
		Enabled = on,
	}, face)
	new("UIStroke", {
		Color = if on then GREEN_LIP else BAR_LIP,
		Thickness = 1,
		Transparency = 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, face)
	if on then
		-- a sheen over its top
		local sheen = new("Frame", {
			Name = "Sheen",
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.85,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(4 * u, 3 * u),
			Size = UDim2.new(1, -8 * u, 0.4, 0),
			ZIndex = 45,
		}, face)
		new("UICorner", { CornerRadius = UDim.new(0, 9 * u) }, sheen)
	end
	local label = new("TextLabel", {
		Name = "Label",
		BackgroundTransparency = 1,
		Text = if busy then "..." elseif on then "BUY NOW" else "SOON",
		FontFace = FONT_H,
		TextSize = math.floor(fs * u),
		TextColor3 = if on then WHITE else MUTED,
		TextXAlignment = if busy or not on then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(18 * u, 0),
		Size = UDim2.new(1, -36 * u, 1, 0),
		ZIndex = 46,
	}, face)
	if on then
		new("UIStroke", { Color = GREEN_INK, Thickness = 1.5, Transparency = 0.55 }, label)
	end
	if on and not busy then
		local pill = new("Frame", {
			Name = "Price",
			BackgroundColor3 = GREEN_INK,
			BackgroundTransparency = 0.3,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -7 * u, 0.5, 0),
			Size = UDim2.fromOffset(0, hh - 14 * u),
			AutomaticSize = Enum.AutomaticSize.X,
			ZIndex = 46,
		}, face)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, pill)
		new("UIPadding", { PaddingLeft = UDim.new(0, 10 * u), PaddingRight = UDim.new(0, 12 * u) }, pill)
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 5 * u),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, pill)
		new("ImageLabel", {
			Name = "Robux",
			BackgroundTransparency = 1,
			Image = ROBUX,
			Size = UDim2.fromOffset(math.floor((fs + 1) * u), math.floor((fs + 1) * u)),
			LayoutOrder = 1,
			ZIndex = 47,
		}, pill)
		new("TextLabel", {
			Name = "Amount",
			BackgroundTransparency = 1,
			Text = Arsenal.commas(price :: number),
			FontFace = FONT_H,
			TextSize = math.floor(fs * u),
			TextColor3 = WHITE,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, hh - 14 * u),
			LayoutOrder = 2,
			ZIndex = 47,
		}, pill)
	end
	-- under the pointer it brightens; pressed, it sinks onto its lip
	local function lift(down: boolean)
		tween(face, if down then 0.05 else 0.1, { Position = UDim2.fromOffset(0, if down then lip - 1 else 0) })
	end
	b.MouseEnter:Connect(function()
		if on then
			grad.Color = ColorSequence.new(GREEN_TOP_HI, GREEN_BOTTOM_HI)
		end
	end)
	b.MouseLeave:Connect(function()
		grad.Color = ColorSequence.new(GREEN_TOP, GREEN_BOTTOM)
		lift(false)
	end)
	b.MouseButton1Down:Connect(function()
		if on then
			lift(true)
		end
	end)
	b.MouseButton1Up:Connect(function()
		lift(false)
	end)
	return { button = b, face = face, lip = lip }
end

local function words(row: Instance, text: string, size: number, color: Color3, u: number, order: number, h: number)
	return new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		FontFace = FONT_H,
		TextSize = math.floor(size * u),
		TextColor3 = color,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, h * u),
		LayoutOrder = order,
		ZIndex = 45,
	}, row)
end

local function pic(row: Instance, image: string, size: number, color: Color3, u: number, order: number)
	return new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = image,
		ImageColor3 = color,
		Size = UDim2.fromOffset(size * u, size * u),
		LayoutOrder = order,
		ZIndex = 45,
	}, row)
end

--- How to get the item shown: OWNED, or BUY NOW with Robux and under it the Stars way.
function Arsenal._build_cta(self)
	local d = self._detail
	if d == nil then
		return
	end
	for _, ch in d.cta:GetChildren() do
		ch:Destroy()
	end
	local it = Catalog.item(d.key)
	local u = UITheme.scale
	local compact = self.ctx.compact
	local inv = self:_inv()
	local stars = inv.stars or 0
	local pending = self._pending
	local busy = pending ~= nil and pending.key == it.key
	local bh = if compact then 38 else 48
	local sh = if compact then 30 else 36
	local y = 0
	if inv.unlocks[it.key] then
		local own = button(d.cta, "Owned", y, bh, u, OWNED_GREEN, OWNED_GREEN)
		pic(own.row, UITheme.icon("check") or "", 18, OWNED_GREEN, u, 1)
		words(own.row, "OWNED", if compact then 15 else 17, OWNED_GREEN, u, 2, bh)
		own.button.Active = false
		y += bh + 8
		self:_line(
			d.cta,
			y,
			if it.kind == "boost" then "It's always on, in every match." else "It's in your build bar in every match.",
			MUTED
		)
		return
	end
	-- BUY NOW with Robux
	local price = self:_robux(it)
	local buy = buy_button(d.cta, y, bh, u, price, busy and pending.how == "robux", if compact then 15 else 18)
	buy.button.Activated:Connect(function()
		self:_robux_pressed(it)
	end)
	d.buy = buy
	y += bh + buy.lip / u + 8
	-- the other way: Stars
	if it.stars == nil then
		self:_line(d.cta, y, "Robux only.", MUTED)
		y += 18
	elseif stars >= it.stars then
		local confirm = self._confirm == it.key
		local alt = button(d.cta, "Stars", y, sh, u, GOLD, if confirm then nil else GOLD)
		local col = if confirm then GOLD_DARK else GOLD
		if busy and pending.how == "stars" then
			words(alt.row, "...", if compact then 12 else 14, col, u, 1, sh)
		elseif confirm then
			words(alt.row, "PRESS AGAIN TO SPEND", if compact then 12 else 14, col, u, 1, sh)
			pic(alt.row, UITheme.icon("star") or "", 15, col, u, 2)
			words(alt.row, Arsenal.commas(it.stars), if compact then 12 else 14, col, u, 3, sh)
		else
			words(alt.row, "OR UNLOCK WITH", if compact then 12 else 14, col, u, 1, sh)
			pic(alt.row, UITheme.icon("star") or "", 15, col, u, 2)
			words(alt.row, Arsenal.commas(it.stars), if compact then 12 else 14, col, u, 3, sh)
		end
		alt.button.Activated:Connect(function()
			self:_stars_pressed(it)
		end)
		y += sh + 8
	else
		-- how far along: "Or earn it by playing: ★ 12,400 of 20,000", and a bar
		local row = new("Frame", {
			Name = "Earn",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, y * u),
			Size = UDim2.new(1, 0, 0, 16 * u),
			ZIndex = 43,
		}, d.cta)
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 4 * u),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, row)
		local fs = if compact then 11 else 12
		new("TextLabel", {
			BackgroundTransparency = 1,
			Text = "Or earn it by playing:",
			FontFace = FONT_M,
			TextSize = math.floor(fs * u),
			TextColor3 = MUTED,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 16 * u),
			LayoutOrder = 1,
			ZIndex = 44,
		}, row)
		pic(row, UITheme.icon("star") or "", 12, GOLD, u, 2)
		new("TextLabel", {
			BackgroundTransparency = 1,
			Text = string.format("%s of %s", Arsenal.commas(stars), Arsenal.commas(it.stars)),
			FontFace = FONT_B,
			TextSize = math.floor(fs * u),
			TextColor3 = GOLD,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 16 * u),
			LayoutOrder = 3,
			ZIndex = 44,
		}, row)
		y += 20
		local bar = new("Frame", {
			Name = "Bar",
			BackgroundColor3 = BAR_OFF,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, y * u),
			Size = UDim2.new(1, 0, 0, 8 * u),
			ZIndex = 43,
		}, d.cta)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, bar)
		local fill = new("Frame", {
			BackgroundColor3 = GOLD,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(math.clamp(stars / it.stars, 0.02, 1), 1),
			ZIndex = 44,
		}, bar)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, fill)
		y += 16
	end
	-- a note about the last press
	if self._note ~= nil and os.clock() < self._note_until then
		self:_line(d.cta, y, self._note, self._note_color or GOLD)
	end
end

--- A line of small text in the "how to get it" area, at `y` (logical px).
function Arsenal._line(self, parent: Instance, y: number, text: string, color: Color3)
	local u = UITheme.scale
	new("TextLabel", {
		Name = "Line",
		BackgroundTransparency = 1,
		Text = text,
		FontFace = FONT_M,
		TextSize = math.floor((if self.ctx.compact then 11 else 12) * u),
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Position = UDim2.fromOffset(0, y * u),
		Size = UDim2.new(1, 0, 0, 30 * u),
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 44,
	}, parent)
end

--- Show item `key` on the right. `by_player`: a press on its row (reported).
function Arsenal._select(self, key: string, by_player: boolean?)
	if Catalog.item(key) == nil then
		return
	end
	if key ~= self._sel then
		self._sel = key
		self._confirm = nil
		self._note = nil
		self:_build_detail()
		if by_player then
			self.ctx:sfx("tab", -4.0)
			if not self._viewed[key] then
				self._viewed[key] = true
				self:_report("arsenal_view", key)
			end
		end
	end
	self:_refresh_list()
end

--- The list's prices, the balance, and the item's buttons, from the inventory and what's pending.
function Arsenal._refresh(self)
	local inv = self:_inv()
	self._balance:set_text(Arsenal.commas(inv.stars or 0))
	self:_refresh_list()
	self:_build_cta()
end

--- A note under the item's buttons for a moment (the last press: not enough Stars, PRESS AGAIN...).
function Arsenal._say(self, text: string, color: any?)
	self._note = text
	self._note_color = if typeof(color) == "Color3"
		then color
		elseif color ~= nil then UITheme.color3(UITheme.to_rgba(color))
		else nil
	self._note_until = os.clock() + Arsenal.NOTE_S
	self:_build_cta()
end

function Arsenal._rebuild(self)
	self:_build_list()
	self:_build_detail()
	self:_refresh()
end

-- ---------------------------------------------------------------------------------------------
-- Buying
-- ---------------------------------------------------------------------------------------------

function Arsenal._stars_pressed(self, it: any)
	local inv = self:_inv()
	if self._pending ~= nil or inv.unlocks[it.key] or it.stars == nil then
		return
	end
	if (inv.stars or 0) < it.stars then
		self.ctx:sfx("deny", -4.0)
		local short = Arsenal.commas(it.stars - (inv.stars or 0))
		self:_say(string.format("%s more Stars to go. Play matches to earn them.", short), GOLD)
		return
	end
	if self._confirm ~= it.key or os.clock() > self._confirm_until then
		-- the first press asks once more
		self._confirm = it.key
		self._confirm_until = os.clock() + Arsenal.CONFIRM_S
		self.ctx:sfx("tab")
		self:_build_cta()
		return
	end
	self._confirm = nil
	local s = self.ctx.session
	if s == nil or not s:buy_unlock(it.key) then
		self.ctx:sfx("deny")
		self:_say("Couldn't reach the server. Try again in a moment.", UITheme.RED)
		return
	end
	self:_report("arsenal_click", it.key, "stars")
	self.ctx:sfx("buy")
	self._pending = { key = it.key, how = "stars", since = os.clock() }
	self:_refresh()
end

function Arsenal._robux_pressed(self, it: any)
	local inv = self:_inv()
	local p = Products[it.product]
	if self._pending ~= nil or inv.unlocks[it.key] then
		return
	end
	if p == nil or p.id == 0 or not IS_ROBLOX then
		self.ctx:sfx("deny", -4.0)
		self:_say(it.title .. " isn't on sale for Robux yet.", MUTED)
		return
	end
	self._confirm = nil
	self:_report("arsenal_click", it.key, "robux")
	self.ctx:sfx("confirm")
	self._pending = { key = it.key, how = "robux", product = p.id, phase = "prompt", since = os.clock() }
	self:_refresh()
	local ok = pcall(function()
		game:GetService("MarketplaceService"):PromptProductPurchase(game:GetService("Players").LocalPlayer, p.id)
	end)
	if not ok then
		self._pending = nil
		self:_say("Purchases aren't available right now.", UITheme.RED)
		self:_refresh()
	end
end

function Arsenal._on_prompt_done(self, product_id: number, purchased: boolean)
	local p = self._pending
	if p == nil or p.how ~= "robux" or p.phase ~= "prompt" or p.product ~= product_id then
		return
	end
	if not purchased then
		self._pending = nil
		if self.is_open then
			self:_refresh()
		end
		return
	end
	-- bought: the server's receipt unlocks it and the inventory says so (Session.unlocked)
	p.phase = "granting"
	p.since = os.clock()
	if self:_inv().unlocks[p.key] then
		self:_on_unlocked(p.key)
	end
end

function Arsenal._on_unlock_result(self, key: string, ok: boolean, reason: string?)
	local p = self._pending
	if p == nil or p.key ~= key or p.how ~= "stars" then
		return
	end
	if ok then
		return -- (the inventory follows: Session.unlocked flashes the item)
	end
	self._pending = nil
	self.ctx:sfx("deny")
	self:_say(
		if reason == "not enough"
			then "Not enough Stars."
			elseif reason == "owned" then "You already have it."
			else "Couldn't unlock it. Nothing was spent. Try again in a moment.",
		UITheme.RED
	)
	self:_refresh()
end

--- An item was unlocked (however it was bought): it shows, flashing.
function Arsenal._on_unlocked(self, key: string)
	local p = self._pending
	if p ~= nil and p.key == key then
		self._pending = nil
	end
	if not self.is_open then
		return
	end
	local it = Catalog.item(key)
	self.ctx:sfx("unlock")
	self:_select(key, false)
	self:_say(string.upper(it.title) .. " UNLOCKED!", GOLD)
	self:_refresh()
	local d = self._detail
	if d ~= nil and d.key == key then
		d.flash.BackgroundTransparency = 0.15
		tween(d.flash, 0.7, { BackgroundTransparency = 1 })
		d.kick_t = os.clock()
	end
end

--- Every frame while open (UIRoot._process): the item's scene plays; a just-unlocked render rocks.
function Arsenal.frame(self, _delta: number?)
	local d = self._detail
	if d == nil then
		return
	end
	local now = FrameClock.now()
	if d.demo ~= nil then
		d.demo:step(now)
	end
	local rot = 0
	if d.kick_t ~= nil then
		local k = (os.clock() - d.kick_t) / 0.6
		if k >= 1 then
			d.kick_t = nil
		else
			rot = -14 * (1 - k) ^ 2 * math.cos(k * math.pi * 2.5)
		end
	end
	d.sticker.Rotation = rot
end

--- Once a second while open: "PRESS AGAIN" runs out, a purchase that never answers gives up, a note goes.
function Arsenal.tick(self)
	local now = os.clock()
	local again = false
	if self._confirm ~= nil and now > self._confirm_until then
		self._confirm = nil
		again = true
	end
	local p = self._pending
	if p ~= nil and p.phase ~= "prompt" and now - p.since > Arsenal.WAIT_S then
		self._pending = nil
		self:_say("That's taking a while. If you paid, it's saved and will show up shortly.", MUTED)
		again = true
	end
	if self._note ~= nil and now >= self._note_until then
		self._note = nil
		again = true
	end
	if again then
		self:_refresh()
	end
end

-- ---------------------------------------------------------------------------------------------
-- Open / close / layout
-- ---------------------------------------------------------------------------------------------

--- `focus`: an item key to show (a locked unit pressed in a match); `from`: where it was opened from
--- ("title" / "match" / "locked" / "over" / "offer": the result screen's own offers), for the analytics.
function Arsenal.open(self, focus: string?, from: string?)
	self._focus = if focus ~= nil and Catalog.item(focus) ~= nil then focus else nil
	self._from = from or "title"
	self._confirm = nil
	self._note = nil
	if not self.is_open then
		self.is_open = true
		table.clear(self._viewed)
		self:_report("arsenal_shop", self._from)
		self:set_visible(true)
		self._panel:set_modulate_a(1.0)
		self._dim:set_modulate_a(0.0)
		W.fade(self._dim, 1.0, 0.2)
		UICtx.pop_in(self._panel, 0.0, 0.94, 0.3)
		self.ctx:sfx("open")
	end
	Prices.fetch()
	ArsenalDemo.preload()
	self._sel = Arsenal.pick(self:_inv(), self._focus)
	self:apply_layout()
end

function Arsenal.close(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	self.ctx:sfx("close")
	local t = self:create_tween():set_parallel(true)
	t:tween_property(self._dim, "modulate:a", 0.0, 0.15)
	t:tween_property(self._panel, "modulate:a", 0.0, 0.15)
	t:chain():tween_callback(function()
		if not self.is_open then
			self:set_visible(false)
		end
	end)
	self.closed:Fire()
end

function Arsenal.apply_layout(self)
	local ctx = self.ctx
	local area = ctx:clear_rect()
	local compact = ctx.compact
	-- (phones: slimmer edges, the preview beside the words)
	self._panel:set_padding(
		if compact then 14 else 20,
		if compact then 10 else 16,
		if compact then 14 else 20,
		if compact then 10 else 16
	)
	self._v:set_separation(if compact then 8 else 12)
	self._sub.base_fs = if compact then 10 else 12
	self._sub:set_font_size(math.max(self._sub.base_fs, UITheme.min_font_size))
	local list_w = if compact then Arsenal.LIST_W_PHONE else Arsenal.LIST_W
	local chrome_h = if compact then 34 + 8 + 20 else 40 + 12 + 32
	local body_h = math.floor(area.Height - chrome_h - 8)
	-- (the list's own height: its headings and rows, with their gaps)
	local rows = #Arsenal.GROUPS + #Catalog.ITEMS
	local list_h = #Arsenal.GROUPS * 18
		+ #Catalog.ITEMS * (if compact then Arsenal.ROW_H_PHONE else Arsenal.ROW_H)
		+ (rows - 1) * 4
		+ 6
	local dw, dh
	if compact then
		dw = math.clamp(area.Width - list_w - 14 - 40, 300, 560)
		dh = math.clamp(body_h, 180, 260)
	else
		dw = Arsenal.DETAIL_W
		dh = math.clamp(body_h, 360, math.max(list_h, Arsenal.PREVIEW_H + 238))
	end
	self._detail_size = Vector2.new(dw, dh)
	self._list_host:set_min_size(Vector2.new(list_w, dh))
	self._detail_host:set_min_size(Vector2.new(dw, dh))
	if self.is_open then
		if self._sel == nil then
			self._sel = Arsenal.pick(self:_inv(), self._focus)
		end
		self:_rebuild()
	end
	local sz = self._panel:get_combined_minimum_size()
	local p = area.Min + (Vector2.new(area.Width, area.Height) - sz) * 0.5
	local y = math.max(p.Y, area.Min.Y + 4.0)
	local rp = Vector2.new(math.floor(p.X + 0.5), math.floor(y + 0.5))
	self._panel:set_offsets(rp.X, rp.Y, rp.X, rp.Y)
	self._panel:reset_size()
end

return Arsenal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">ArsenalButton</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The title screen's Arsenal button, left of the crate button (its twin, CrateButton.luau): the
-- Arsenal's shield on a gold glow and slow rays, an ARSENAL pill under it, and a badge with the
-- player's Stars (Data/Stars: what every match pays, spent in the Arsenal). pressed() -> UIRoot opens
-- the Arsenal. A payout makes the badge pop.
local UITheme = require("./UITheme")
local W = require("./Widgets")
local Signal = UITheme.core("Signal")

local IS_ROBLOX = typeof(game) == "Instance"
local TweenService = if IS_ROBLOX then game:GetService("TweenService") else nil

local ArsenalButton = W.class(W.Control)

--- The square, desktop px (phones: PHONE_K of it).
ArsenalButton.SIZE = 132
ArsenalButton.PHONE_K = 0.6

local GOLD = Color3.fromRGB(255, 200, 61)
local GOLD_LIGHT = Color3.fromRGB(255, 232, 160)
local FONT_B = Font.fromId(12187365977, Enum.FontWeight.Heavy)

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	if TweenService ~= nil then
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
			:Play()
	end
end

local function commas(n: number): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	return if string.sub(out, 1, 1) == "," then string.sub(out, 2) else out
end

function ArsenalButton.new(c: any)
	local self = setmetatable({}, ArsenalButton.__mt)
	W.Control._init(self)
	self.ctx = c
	self.pressed = Signal.new()
	self._t = 0.0
	self._k = 1.0
	self._stars = -1
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:_build()
	self:set_process(true)
	return self
end

function ArsenalButton._build(self)
	local art = UITheme.crate_art()
	local root = self.gui
	root.ClipsDescendants = false
	local body = new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
	}, root)
	self._body_scale = new("UIScale", {}, body)
	local function img(name: string, image: string?, z: number, props: any?): ImageLabel
		local p = props or {}
		p.Name = name
		p.BackgroundTransparency = 1
		p.Image = image or ""
		p.AnchorPoint = p.AnchorPoint or Vector2.new(0.5, 0.5)
		p.ZIndex = z
		return new("ImageLabel", p, body)
	end
	self._rays = img("Rays", art.rays, 1, { ImageColor3 = GOLD, ImageTransparency = 0.84 })
	self._glow = img("Glow", art.glow, 2, { ImageColor3 = GOLD, ImageTransparency = 0.5 })
	-- the shield: a dark copy under it for depth
	self._shade =
		img("Shade", UITheme.icon("arsenal"), 3, { ImageColor3 = Color3.fromRGB(60, 34, 0), ImageTransparency = 0.25 })
	self._shield = img("Shield", UITheme.icon("arsenal"), 4, { ImageColor3 = GOLD })
	new(
		"UIGradient",
		{ Color = ColorSequence.new(GOLD_LIGHT, Color3.fromRGB(240, 150, 30)), Rotation = 90 },
		self._shield
	)
	self._shield.ImageColor3 = Color3.new(1, 1, 1)
	self._spark = img("Spark", art.sparkle, 5, { ImageColor3 = GOLD_LIGHT, ImageTransparency = 1 })
	local pill = new(
		"Frame",
		{ Name = "Pill", BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 1), ZIndex = 6 },
		body
	)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, pill)
	new(
		"UIGradient",
		{ Color = ColorSequence.new(Color3.fromRGB(255, 214, 110), Color3.fromRGB(242, 160, 40)), Rotation = 90 },
		pill
	)
	new(
		"UIStroke",
		{
			Color = Color3.fromRGB(70, 40, 6),
			Thickness = 2,
			Transparency = 0.2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		},
		pill
	)
	self._pill = pill
	local pt = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "ARSENAL",
		FontFace = FONT_B,
		TextColor3 = Color3.fromRGB(46, 26, 4),
		TextScaled = true,
		ZIndex = 7,
	}, pill)
	new("UIPadding", {
		PaddingTop = UDim.new(0.2, 0),
		PaddingBottom = UDim.new(0.16, 0),
		PaddingLeft = UDim.new(0.1, 0),
		PaddingRight = UDim.new(0.1, 0),
	}, pt)
	-- the Stars badge (top right of the shield)
	local badge = new("Frame", {
		Name = "Stars",
		BackgroundColor3 = Color3.fromRGB(20, 28, 52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 8,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, badge)
	new("UIStroke", { Color = GOLD, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, badge)
	self._badge_scale = new("UIScale", {}, badge)
	self._badge = badge
	local brow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 9 }, badge)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 3),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, brow)
	self._badge_icon = new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = UITheme.icon("star") or "",
		ImageColor3 = GOLD,
		LayoutOrder = 1,
		ZIndex = 9,
	}, brow)
	self._badge_text = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = "0",
		FontFace = FONT_B,
		TextColor3 = GOLD_LIGHT,
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = 2,
		ZIndex = 9,
	}, brow)
	local hit = new("TextButton", {
		Name = "Hit",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
	}, root)
	self._hover = false
	hit.MouseEnter:Connect(function()
		self._hover = true
		tween(self._body_scale, 0.12, { Scale = 1.06 })
		if not self.ctx.touch then
			self.ctx:sfx("hover", -12.0)
		end
	end)
	hit.MouseLeave:Connect(function()
		self._hover = false
		tween(self._body_scale, 0.12, { Scale = 1 })
	end)
	hit.MouseButton1Down:Connect(function()
		tween(self._body_scale, 0.08, { Scale = 0.94 })
	end)
	hit.MouseButton1Up:Connect(function()
		tween(self._body_scale, 0.12, { Scale = if self._hover then 1.06 else 1 })
	end)
	hit.Activated:Connect(function()
		self.pressed:Fire()
	end)
	self:_size_parts()
end

--- `k`: 1 on desktop, PHONE_K on phones (also follows UITheme.scale: call it from apply_layout).
function ArsenalButton.set_scale(self, k: number)
	if k == self._k and UITheme.scale == self._u then
		return
	end
	self._k = k
	self:_size_parts()
end

--- The control's size in logical px: the square plus the pill's lower half.
function ArsenalButton.size_px(self): Vector2
	local s = ArsenalButton.SIZE * self._k
	return Vector2.new(s, s * 1.08)
end

function ArsenalButton._size_parts(self)
	self._u = UITheme.scale
	local s = ArsenalButton.SIZE * self._k * self._u
	local cy = s * 0.46
	self._s, self._cy = s, cy
	self._rays.Size = UDim2.fromOffset(s * 1.4, s * 1.4)
	self._rays.Position = UDim2.fromOffset(s * 0.5, cy)
	self._glow.Size = UDim2.fromOffset(s * 1.2, s * 1.1)
	self._glow.Position = UDim2.fromOffset(s * 0.5, cy)
	self._shield.Size = UDim2.fromOffset(s * 0.7, s * 0.7)
	self._shade.Size = UDim2.fromOffset(s * 0.7, s * 0.7)
	self._spark.Size = UDim2.fromOffset(s * 0.14, s * 0.14)
	local pw, ph = s * 0.86, math.max(22 * self._u, s * 0.22)
	self._pill.Size = UDim2.fromOffset(pw, ph)
	self._pill.Position = UDim2.fromOffset(s * 0.5, s * 1.08)
	local bh = math.max(20 * self._u, s * 0.2)
	self._badge_h = bh
	self._badge.Position = UDim2.fromOffset(s * 0.78, s * 0.12)
	self._badge_icon.Size = UDim2.fromOffset(bh * 0.6, bh * 0.6)
	self._badge_text.Size = UDim2.fromOffset(0, bh)
	self._badge_text.TextSize = math.floor(bh * 0.62)
	self:_size_badge()
	self:set_min_size(self:size_px())
end

function ArsenalButton._size_badge(self)
	local bh = self._badge_h or 24
	local w = bh * 0.6 + 3 + #self._badge_text.Text * bh * 0.4 + bh * 0.7
	self._badge.Size = UDim2.fromOffset(math.max(bh * 1.8, w), bh)
end

--- Follow the session's inventory (the Stars balance).
function ArsenalButton.bind(self, s: any)
	if s == nil or self._bound == s then
		return
	end
	self._bound = s
	s.inventory_changed:Connect(function()
		self:refresh()
	end)
	self:refresh()
end

function ArsenalButton.refresh(self)
	local s = self.ctx.session
	local inv = if s ~= nil then s.inventory else nil
	local stars = if inv ~= nil then (tonumber(inv.stars) or 0) else 0
	local loaded = inv ~= nil and inv.loaded == true
	self._badge.Visible = loaded
	if stars == self._stars then
		return
	end
	local grew = self._stars >= 0 and stars > self._stars
	self._stars = stars
	self._badge_text.Text = commas(stars)
	self:_size_badge()
	if grew then
		self._badge_scale.Scale = 1.5
		tween(self._badge_scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

function ArsenalButton._process(self, dt: number)
	if not self:is_visible_in_tree() then
		return
	end
	self._t += dt
	local t = self._t
	local s = self._s or 100
	local bob = math.sin(t * 2.0) * s * 0.018
	self._shield.Position = UDim2.fromOffset(s * 0.5, self._cy + bob)
	self._shade.Position = UDim2.fromOffset(s * 0.5, self._cy + bob + s * 0.03)
	self._shield.Rotation = math.sin(t * 1.3) * 3
	self._shade.Rotation = self._shield.Rotation
	self._glow.ImageTransparency = 0.56 - 0.12 * (0.5 + 0.5 * math.sin(t * 3.2))
	self._rays.Rotation = (self._rays.Rotation - dt * 12) % 360
	-- a twinkle on the shield now and then
	local k = (t % 2.6) / 0.9
	if k < 1 then
		local v = math.sin(k * math.pi)
		self._spark.ImageTransparency = 1 - v * 0.9
		self._spark.Rotation = k * 90
		self._spark.Position = UDim2.fromOffset(s * 0.66, self._cy - s * 0.2 + bob)
	else
		self._spark.ImageTransparency = 1
	end
end

return ArsenalButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">ArsenalDemo</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The Arsenal's gameplay previews: each card's art plays a few seconds of what its item does in a
-- match, over and over (2026-10-12: the shop shows gameplay, as too few players were using it).
-- The scene is drawn like the
-- map: the player's land on the left, a nation's on the right with a city, its name and its troops,
-- the structures' plates (Assets/MapSprites, Assets/ArsenalArt). The ground is a piece of a real map
-- drawn the way a match draws it (Assets/ArsenalMaps: terrain, rivers and coasts, the territories
-- blended over them with their borders, a pixel a tile; 2026-10-24: a real map in place of
-- the solid background colours, which looked bad). Flat colours stand in without it.
--
-- What flies and what blows up is drawn art (the same day: real graphics in place of the pixel
-- circles, so that nukes and the other items look better): the shop
-- cards' own renders for the missiles and the bomber (Assets/ArsenalArt.renders), and effects drawn by
-- tools/assets/make_arsenal_fx.py (Assets/ArsenalFx): a fireball flipbook, a mushroom cloud, smoke
-- trails, shockwaves, scorch marks, a beam, tracers, bombs, warheads, a reticle, parachutes. Big hits
-- shake the scene.
--   mega       the missile arcs from the silo onto the city under a reticle: a white flash, a
--              shockwave, a mushroom cloud, the city gone, fallout
--   scatter    the missile splits over the city into five warheads, five fireballs
--   reinforce  three paratroopers drop in (+2.0K each), then the border advances into the nation
--   artillery  the battery fires a tracer every second or so into its range ring
--   airfield   a bomber takes off, crosses a marked spot and drops three bombs on it
--   railgun    it charges, then a beam crosses the whole scene: no range limit
--   stars2x    a payout, and a "2X" stamp doubling it
--   reload2x   two silos, the rapid one firing twice for the other's once
-- Everything is a function of the time into the loop (no state carried between frames), so a demo
-- starts anywhere and always shows a whole loop.
--
--   ArsenalDemo.new(parent, item, size_px, u, phase) -> demo;  demo:step(now);  demo:destroy()
--   ArsenalDemo.preload()  fetches the art once (the Arsenal calls it when it opens)
local IS_ROBLOX = typeof(game) == "Instance"
local function shared(folder: string, name: string): any
	if IS_ROBLOX then
		return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront")[folder][name]) :: any
	end
	return (require :: any)("../../shared/" .. folder .. "/" .. name)
end
local Sprites = shared("Assets", "MapSprites")
local AA = shared("Assets", "ArsenalArt")
local FX: any = (function()
	local ok, m = pcall(shared, "Assets", "ArsenalFx")
	return if ok and type(m) == "table" then m else {}
end)()
--- the ground: pieces of real maps drawn like a match (tools/assets/make_arsenal_maps.py)
local MAPS: any = (function()
	local ok, m = pcall(shared, "Assets", "ArsenalMaps")
	return if ok and type(m) == "table" and type(m.scenes) == "table" then m else nil
end)()

local ArsenalDemo = {}
ArsenalDemo.__index = ArsenalDemo

--- One loop, seconds (Rapid Reload's: two of the normal reload, four of the rapid one).
ArsenalDemo.LOOP_S = 4.2
ArsenalDemo.LOOPS = { reload2x = 5.6 }
--- The nation the player's weapon is shown on, and its troops before it.
ArsenalDemo.ENEMY = "NORTHMARK"
ArsenalDemo.ENEMY_TROOPS = 48000
ArsenalDemo.MY_TROOPS = 18000

local FONT_H = Font.fromId(12187365977, Enum.FontWeight.Heavy)
local FONT_B = Font.fromId(12187365977, Enum.FontWeight.Bold)
local WHITE = Color3.new(1, 1, 1)
local INK = Color3.fromRGB(14, 20, 38)
--- the player's land and the nation's (the map's pastel territories, each with a darker border)
local MINE = Color3.fromRGB(196, 160, 226)
local THEIRS = Color3.fromRGB(128, 204, 132)
local THEIRS_ALT = Color3.fromRGB(232, 150, 140)
local SCORCH = Color3.fromRGB(46, 34, 30)
--- under the map image while it loads
local NIGHT_GROUND = Color3.fromRGB(30, 38, 58)
local FIRE_GLOW = Color3.fromRGB(255, 168, 70)
local RED = Color3.fromRGB(255, 70, 70)
local PURPLE = Color3.fromRGB(176, 120, 255)
local GOLD = Color3.fromRGB(255, 205, 70)
local DUST = Color3.fromRGB(226, 204, 168)

-- structure columns: the map sprites' (city 0, silo 5), the Arsenal's (artillery 0, airfield 1, railgun 2)
local CITY_COL, SILO_COL = 0, 5
--- the renders stand a little tilted (the photographs' roll): turn them back this far when they fly
local RENDER_TILT = 10

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end
local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end
--- 0 before a, 1 after b, eased between.
local function ramp(t: number, a: number, b: number): number
	local x = clamp01((t - a) / (b - a))
	return x * x * (3 - 2 * x)
end
local function dark(c: Color3, k: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), k)
end
local function fmt_k(n: number): string
	if n >= 1000 then
		return string.format("%.1fK", n / 1000)
	end
	return tostring(math.floor(n + 0.5))
end

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

--- A label's fade: its outline goes with it (a UIStroke keeps its own transparency).
local function fade(t: TextLabel, a: number)
	t.TextTransparency = a
	local st = t:FindFirstChildOfClass("UIStroke")
	if st ~= nil then
		st.Transparency = math.max(0.15, a)
	end
end

local preloaded = false
--- Fetches the art (once): the effects and the renders that fly. (By image labels: PreloadAsync given
--- the ids as strings fails for images.)
function ArsenalDemo.preload()
	if preloaded or not IS_ROBLOX then
		return
	end
	preloaded = true
	local labels = {}
	local function add(id: string)
		table.insert(labels, new("ImageLabel", { Image = id }))
	end
	for _, v in FX do
		if type(v) == "table" and type(v.id) == "string" then
			add(v.id)
		end
	end
	if MAPS ~= nil then
		add(MAPS.id)
	end
	for _, k in { "mega", "scatter", "airfield", "reinforce" } do
		local r = AA.renders and AA.renders[k]
		if r ~= nil then
			add(r.id)
		end
	end
	task.spawn(function()
		pcall(function()
			(game :: any):GetService("ContentProvider"):PreloadAsync(labels, function(id: string, status: any)
				-- (into the error report: whether players' clients get the map, 2026-10-24: a phone
				-- drew the previews' ground empty in production)
				if MAPS ~= nil and id == MAPS.id and status ~= Enum.AssetFetchStatus.Success then
					warn(("[Arsenal] the previews' map image did not load: %s"):format(tostring(status)))
				end
			end)
		end)
		for _, l in labels do
			l:Destroy()
		end
	end)
end

--- `under`: where the map ground goes, outside the scene's clipping group (CanvasGroup), the same size
--- and place as the group, `corner` px round; nil: in the scene.
function ArsenalDemo.new(
	parent: Instance,
	item: any,
	size: Vector2,
	u: number,
	phase: number?,
	under: Instance?,
	corner: number?
)
	local self = setmetatable({}, ArsenalDemo)
	self.key = item.key
	self.under, self.corner = under, corner
	self.W, self.H, self.u = size.X, size.Y, u
	self.phase = phase or 0
	self.loop = ArsenalDemo.LOOPS[item.key] or ArsenalDemo.LOOP_S
	self.parts = {}
	self._troops_shown = -1
	self._mine_shown = -1
	self._shake = 0
	--- how far the lands reach past the scene's edges (a shake must not show the card under them)
	self.M = math.ceil(8 * u)
	-- (not clipped: the card's CanvasGroup clips it, and a shaken root must not clip its own edge)
	local root = new("Frame", {
		Name = "Demo",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 5,
	}, parent)
	self.root = root
	local build = ArsenalDemo["_build_" .. item.key]
	if build ~= nil then
		build(self, item)
	else
		self:_land(0.42, THEIRS)
	end
	return self
end

function ArsenalDemo.destroy(self)
	if self.parts.map ~= nil then
		self.parts.map:Destroy()
	end
	self.root:Destroy()
end

-- ---------------------------------------------------------------------------------------------
-- Pieces (px, from fractions of the scene)
-- ---------------------------------------------------------------------------------------------

function ArsenalDemo._px(self, fx: number, fy: number): (number, number)
	return fx * self.W, fy * self.H
end

function ArsenalDemo._text(
	self,
	name: string,
	text: string,
	px: number,
	color: Color3,
	z: number,
	font: Font?
): TextLabel
	local t = new("TextLabel", {
		Name = name,
		BackgroundTransparency = 1,
		Text = text,
		FontFace = font or FONT_H,
		TextSize = math.max(8, math.floor(px)),
		TextColor3 = color,
		AnchorPoint = Vector2.new(0.5, 0.5),
		AutomaticSize = Enum.AutomaticSize.XY,
		ZIndex = z,
	}, self.root)
	new("UIStroke", { Color = INK, Thickness = math.max(1, px * 0.12), Transparency = 0.15 }, t)
	return t
end

--- Place `g` centred at scene fraction (fx, fy), `w` x `h` px.
function ArsenalDemo._at(self, g: GuiObject, fx: number, fy: number, w: number?, h: number?)
	local x, y = self:_px(fx, fy)
	g.Position = UDim2.fromOffset(x, y)
	if w ~= nil then
		g.Size = UDim2.fromOffset(w, h or w)
	end
end

--- An image, hidden until a script shows it.
function ArsenalDemo._img(self, name: string, image: string?, z: number, color: Color3?): ImageLabel
	return new("ImageLabel", {
		Name = name,
		BackgroundTransparency = 1,
		Image = image or "",
		ImageColor3 = color or WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = z,
	}, self.root)
end

--- One of the effects (Assets/ArsenalFx), hidden.
function ArsenalDemo._fx(self, name: string, key: string, z: number, color: Color3?): ImageLabel
	local f = FX[key]
	return self:_img(name, if f ~= nil then f.id else "", z, color)
end

--- Shows `g` at (fx, fy), `w` x `h` px, `a` transparent; nil `w` keeps its size.
function ArsenalDemo._show(self, g: ImageLabel, fx: number, fy: number, w: number?, h: number?, a: number?)
	g.Visible = true
	self:_at(g, fx, fy, w, h)
	g.ImageTransparency = a or 0
end

--- A flipbook (ArsenalFx explosion / mushroom), hidden.
function ArsenalDemo._flip(self, name: string, key: string, z: number): ImageLabel
	local f = FX[key]
	local g = self:_img(name, if f ~= nil then f.id else "", z)
	if f ~= nil then
		g.ImageRectSize = Vector2.new(f.cell, f.cell)
	end
	return g
end

--- Its frame at `k` of the way through (0..1); hidden outside.
function ArsenalDemo._flip_at(
	self,
	g: ImageLabel,
	key: string,
	fx: number,
	fy: number,
	d: number,
	k: number,
	a: number?
)
	local f = FX[key]
	if f == nil or k < 0 or k >= 1 then
		g.Visible = false
		return
	end
	local i = math.min(f.frames - 1, math.floor(k * f.frames))
	g.ImageRectOffset = Vector2.new((i % f.cols) * f.cell, (i // f.cols) * f.cell)
	self:_show(g, fx, fy, d, d, a)
end

--- One of the item renders (the shop cards' pictures), `h` px tall, hidden. `crop`: a part of it
--- (offset, size, in the render's pixels).
function ArsenalDemo._render(self, name: string, key: string, h: number, z: number, crop: { Vector2 }?): ImageLabel
	local r = AA.renders and AA.renders[key]
	local g = self:_img(name, if r ~= nil then r.id else "", z)
	local w, hh = if r ~= nil then r.w else 1, if r ~= nil then r.h else 1
	if crop ~= nil then
		g.ImageRectOffset = crop[1]
		g.ImageRectSize = crop[2]
		w, hh = crop[2].X, crop[2].Y
	end
	g.Size = UDim2.fromOffset(h * math.abs(w) / hh, h)
	return g
end

--- The scene shakes: `amp` px (of u), dying away over `dur` after `t0`.
function ArsenalDemo._kick(self, t: number, t0: number, amp: number, dur: number)
	local k = (t - t0) / dur
	if k >= 0 and k < 1 then
		self._shake = math.max(self._shake, amp * self.u * (1 - k) ^ 2)
	end
end

--- The two lands: the player's up to `split` of the width, the nation's after it, each with a few
--- darker specks (the map's terrain) and a border in its darker shade. They reach M px past the
--- scene's edges, for the shake. Keeps the parts the scripts move (`mine`, `theirs`, the borders).
function ArsenalDemo._land(self, split: number, theirs: Color3)
	if self:_map(split) then
		return
	end
	local p = self.parts
	local W, H, u, M = self.W, self.H, self.u, self.M
	p.theirs_col = theirs
	local function land(name: string, col: Color3): Frame
		return new("Frame", {
			Name = name,
			BackgroundColor3 = col,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 5,
		}, self.root)
	end
	p.mine, p.theirs = land("Mine", MINE), land("Theirs", theirs)
	p.bl = new(
		"Frame",
		{ Name = "BorderMine", BackgroundColor3 = dark(MINE, 0.38), BorderSizePixel = 0, ZIndex = 6 },
		self.root
	)
	p.br = new(
		"Frame",
		{ Name = "BorderTheirs", BackgroundColor3 = dark(theirs, 0.38), BorderSizePixel = 0, ZIndex = 6 },
		self.root
	)
	-- the specks: fixed, across the whole scene for each land (a land shows the ones over it), from
	-- the item's name
	local seed = 0
	for i = 1, #self.key do
		seed = (seed * 31 + string.byte(self.key, i)) % 9973
	end
	local function rnd(): number
		seed = (seed * 1103 + 12345) % 9973
		return seed / 9973
	end
	local sp = math.max(2, math.floor(2.2 * u))
	p.specks = {}
	for i = 1, 36 do
		local on_mine = i % 2 == 0
		local s = new("Frame", {
			Name = "Speck",
			BackgroundColor3 = dark(if on_mine then MINE else theirs, 0.07),
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(sp * (1 + i % 3), sp),
			ZIndex = 5,
		}, if on_mine then p.mine else p.theirs)
		local fx, fy = rnd(), rnd()
		s.Position = UDim2.fromOffset(fx * W + M, fy * H + M)
		if not on_mine then
			table.insert(p.specks, { s = s, x = fx * W, y = fy * H + M })
		end
	end
	self:_split(split)
end

--- The border between the lands at `split` of the width.
function ArsenalDemo._split(self, split: number)
	local p = self.parts
	if p.split == split then
		return
	end
	p.split = split
	local W, H, u, M = self.W, self.H, self.u, self.M
	local x = math.floor(split * W + 0.5)
	local bw = math.max(1, math.floor(1.6 * u))
	p.mine.Position = UDim2.fromOffset(-M, -M)
	p.mine.Size = UDim2.fromOffset(x + M, H + 2 * M)
	p.theirs.Position = UDim2.fromOffset(x, -M)
	p.theirs.Size = UDim2.fromOffset(W - x + M, H + 2 * M)
	for _, sp in p.specks do
		sp.s.Position = UDim2.fromOffset(sp.x - x, sp.y)
	end
	p.bl.Size = UDim2.fromOffset(bw, H + 2 * M)
	p.br.Size = UDim2.fromOffset(bw, H + 2 * M)
	p.bl.Position = UDim2.fromOffset(x - bw, -M)
	p.br.Position = UDim2.fromOffset(x, -M)
end

--- The ground from Assets/ArsenalMaps (false: it has no scene for this item). Its rect is a window of
--- the scene's cell with the scene's shape (whole tiles), placed so the cell's border column lands at
--- `split` of the width.
---   * With `under` (the Arsenal), it lies under the scene's clipping group, rounded itself, and stays
---     put when the scene shakes. In the group, pixelated, it drew nothing on an iPhone in production
---     (v96, 2026-10-24: the Arsenal's map previews were empty in the card) while Studio
---     drew it; the game's other pixelated atlases (the Locker's skins, the map's units) are in no group.
---   * Without, it is in the scene and reaches M px past its edges (for the shake).
function ArsenalDemo._map(self, split: number?): boolean
	local sc = MAPS and MAPS.scenes[self.key]
	if sc == nil then
		return false
	end
	local p = self.parts
	local W, H = self.W, self.H
	local pad = if self.under ~= nil then 0 else self.M
	local cell: Vector2 = MAPS.cell
	local aspect = (W + 2 * pad) / (H + 2 * pad)
	local rw, rh
	if aspect <= cell.X / cell.Y then
		rh = cell.Y
		rw = math.max(1, math.floor(rh * aspect + 0.5))
	else
		rw = cell.X
		rh = math.max(1, math.floor(rw / aspect + 0.5))
	end
	local f = ((split or 0.5) * W + pad) / (W + 2 * pad)
	local rx = math.clamp(math.floor((sc.split or split or 0.5) * cell.X - f * rw + 0.5), 0, cell.X - rw)
	p.map_rect = Vector2.new(rx, (cell.Y - rh) // 2)
	p.map_rw = rw
	p.map_pad = pad
	p.map_scene = sc
	p.map_frame = 1
	p.theirs_col = sc.enemy or THEIRS
	p.map = new("ImageLabel", {
		Name = "Map",
		BackgroundColor3 = NIGHT_GROUND,
		BorderSizePixel = 0,
		Image = MAPS.id,
		ImageRectOffset = sc.frames[1] + p.map_rect,
		ImageRectSize = Vector2.new(rw, rh),
		ResampleMode = Enum.ResamplerMode.Pixelated,
		Position = UDim2.fromOffset(-pad, -pad),
		Size = UDim2.fromOffset(W + 2 * pad, H + 2 * pad),
		ZIndex = if self.under ~= nil then 40 else 5,
	}, self.under or self.root)
	if self.under ~= nil and self.corner ~= nil then
		new("UICorner", { CornerRadius = UDim.new(0, self.corner) }, p.map)
	end
	return true
end

--- Whether the scene's ground is the map (the Arsenal then clears its group's own ground).
function ArsenalDemo.has_map(self): boolean
	return self.parts.map ~= nil
end

--- Reinforcements: the border `push` (0..1) of the way through its advance. Returns where the border
--- now is (of the scene's width).
function ArsenalDemo._advance(self, from: number, to: number, push: number): number
	local p = self.parts
	local sc = p.map_scene
	if sc == nil then
		local split = math.floor((from + (to - from) * push) * 200 + 0.5) / 200
		self:_split(split)
		return split
	end
	if #sc.frames < 2 then
		return from
	end
	local n = #sc.frames
	local k = math.clamp(math.floor(push * (n - 1) + 0.5), 0, n - 1)
	if k + 1 ~= p.map_frame then
		p.map_frame = k + 1
		p.map.ImageRectOffset = sc.frames[k + 1] + p.map_rect
	end
	-- (the cell's border column for this frame, on screen)
	local bx = sc.split * MAPS.cell.X + sc.advance * k / (n - 1)
	local W, pad = self.W, p.map_pad
	return ((bx - p.map_rect.X) / p.map_rw * (W + 2 * pad) - pad) / W
end

--- A structure's plate (as Map/StructureLayer draws it: the whole shape in the rim's colour, the inset
--- shape over it in `fill`, the glyph in white), `d` px wide. `col`: the structure kind, counted from
--- the Arsenal's first (Defs.S_ARTILLERY) when `arsenal`.
function ArsenalDemo._plate(self, name: string, col: number, arsenal: boolean, fill: Color3, d: number): ImageLabel
	local shapes, icons = Sprites.shapes, Sprites.icons
	if arsenal then
		col += 6
	end
	local cell = shapes.cell
	local plate = new("ImageLabel", {
		Name = name,
		BackgroundTransparency = 1,
		Image = shapes.id,
		ImageRectOffset = Vector2.new(col * cell, 0),
		ImageRectSize = Vector2.new(cell, cell),
		ImageColor3 = dark(fill, 0.55),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(d, d),
		ZIndex = 9,
	}, self.root)
	new("ImageLabel", {
		Name = "Fill",
		BackgroundTransparency = 1,
		Image = shapes.id,
		ImageRectOffset = Vector2.new(col * cell, cell),
		ImageRectSize = Vector2.new(cell, cell),
		ImageColor3 = fill,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 9,
	}, plate)
	new("ImageLabel", {
		Name = "Glyph",
		BackgroundTransparency = 1,
		Image = icons.id,
		ImageRectOffset = Vector2.new(col * icons.cell, 0),
		ImageRectSize = Vector2.new(icons.cell, icons.cell),
		ImageColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.62, 0.62),
		ZIndex = 10,
	}, plate)
	return plate
end

--- A structure's plate size for this scene.
function ArsenalDemo._plate_d(self): number
	return math.clamp(self.H * 0.28, 15 * self.u, 32 * self.u)
end

--- The nation: its name and troops over its land, its city. `fx`: where its middle is.
function ArsenalDemo._nation(self, fx: number, city_fx: number, city_fy: number)
	local p = self.parts
	local H, u = self.H, self.u
	local fs = math.clamp(H * 0.13, 9 * u, 15 * u)
	-- (over the blasts)
	p.name = self:_text("Nation", ArsenalDemo.ENEMY, fs, WHITE, 22)
	self:_at(p.name, fx, 0.2)
	p.troops =
		self:_text("Troops", fmt_k(ArsenalDemo.ENEMY_TROOPS), fs * 0.9, Color3.fromRGB(255, 236, 200), 22, FONT_B)
	self:_at(p.troops, fx, 0.2 + fs * 1.05 / H)
	local d = math.clamp(H * 0.3, 16 * u, 34 * u)
	p.city = self:_plate("City", CITY_COL, false, dark(p.theirs_col, 0.3), d)
	self:_at(p.city, city_fx, city_fy)
	p.city_at = Vector2.new(city_fx, city_fy)
	p.pop = self:_text("Pop", "", fs * 0.95, Color3.fromRGB(255, 96, 96), 23)
	p.pop.Visible = false
end

--- The nation's troops at `n`; a loss shows as a red figure rising from (fx, fy) for 0.9 s after `t0`.
function ArsenalDemo._troops(self, n: number, loss: number?, t: number?, t0: number?, fx: number?, fy: number?)
	local p = self.parts
	local shown = math.floor(n / 100)
	if shown ~= self._troops_shown then
		self._troops_shown = shown
		p.troops.Text = fmt_k(n)
	end
	local k = if loss ~= nil and t ~= nil and t0 ~= nil then (t - t0) / 0.9 else -1
	if k >= 0 and k <= 1 then
		p.pop.Visible = true
		p.pop.Text = "-" .. fmt_k(loss :: number)
		fade(p.pop, k * k)
		-- (from the hit, but under the nation's troops, which it would hide)
		self:_at(p.pop, fx or 0.75, math.max(fy or 0.5, 0.52) - 0.12 * k)
	else
		p.pop.Visible = false
	end
end

--- Along an arc from a to b (scene fractions), `lift` of the height at its top; `s` 0..1. Returns
--- the point and the heading on screen (degrees, 0 = right).
function ArsenalDemo._arc(self, a: Vector2, b: Vector2, lift: number, s: number): (number, number, number)
	local x = lerp(a.X, b.X, s)
	local y = lerp(a.Y, b.Y, s) - lift * math.sin(math.pi * s)
	local dx = (b.X - a.X) * self.W
	local dy = ((b.Y - a.Y) - lift * math.pi * math.cos(math.pi * s)) * self.H
	return x, y, math.deg(math.atan2(dy, dx))
end

--- An explosion: a flash, the fireball's flipbook, a shockwave, and the scorch it leaves.
function ArsenalDemo._boom(self, name: string, tint: Color3?): any
	return {
		scorch = self:_fx(name .. "Scorch", "scorch", 7, SCORCH),
		flash = self:_fx(name .. "Flash", "glow", 15, tint or FIRE_GLOW),
		fire = self:_flip(name .. "Fire", "explosion", 16),
		ring = self:_fx(name .. "Ring", "ring", 17, tint),
	}
end

--- It at (fx, fy), `r` px: `since` seconds after it went off (negative: not yet), the fireball lasting
--- `dur`; the scorch stays until the loop's end (`t`, the time into the loop).
function ArsenalDemo._boom_at(self, b: any, fx: number, fy: number, r: number, since: number, dur: number, t: number)
	if since < 0 then
		b.scorch.Visible, b.flash.Visible, b.fire.Visible, b.ring.Visible = false, false, false, false
		return
	end
	-- the flash: big and brief
	local fk = since / 0.3
	if fk < 1 then
		self:_show(b.flash, fx, fy, r * (2.4 + 1.6 * fk), nil, 0.05 + 0.95 * fk * fk)
	else
		b.flash.Visible = false
	end
	self:_flip_at(b.fire, "explosion", fx, fy, r * 2.6, since / dur)
	local rk = since / 0.5
	if rk < 1 then
		local d = r * (0.8 + 2.4 * (1 - (1 - rk) ^ 2))
		self:_show(b.ring, fx, fy, d, d, 0.1 + 0.9 * rk)
	else
		b.ring.Visible = false
	end
	if since > 0.12 then
		self:_show(b.scorch, fx, fy, r * 1.5, r * 1.5, 0.35 + 0.65 * ramp(t, self.loop - 0.4, self.loop))
	else
		b.scorch.Visible = false
	end
end

--- A smoke trail: `n` puffs, each left where the munition passed and fading.
function ArsenalDemo._trail(self, name: string, n: number, tint: Color3?): { ImageLabel }
	local out = {}
	for i = 1, n do
		out[i] = self:_fx(name .. i, "smoke", 10, tint)
	end
	return out
end

--- The trail of a flight from `t0` to `t1` along `path(s) -> (fx, fy)`, puffs `d` px, `life` s each.
function ArsenalDemo._trail_at(
	self,
	puffs: { ImageLabel },
	path: (number) -> (number, number),
	t0: number,
	t1: number,
	t: number,
	d: number,
	life: number
)
	local n = #puffs
	for i, g in puffs do
		local s = (i - 0.5) / n
		local age = t - lerp(t0, t1, s)
		if age < 0 or age > life then
			g.Visible = false
		else
			local k = age / life
			local x, y = path(s)
			self:_show(g, x, y - 0.04 * k, d * (0.55 + 0.9 * k), d * (0.55 + 0.9 * k), 0.2 + 0.8 * k)
			g.Rotation = i * 47 + k * 30
		end
	end
end

--- A puff of smoke at (fx, fy), `since` seconds after it was made, `life` s, `d` px.
function ArsenalDemo._puff_at(self, g: ImageLabel, fx: number, fy: number, d: number, since: number, life: number)
	local k = since / life
	if k < 0 or k >= 1 then
		g.Visible = false
		return
	end
	self:_show(g, fx, fy - 0.08 * k, d * (0.6 + 0.9 * k), d * (0.6 + 0.9 * k), 0.15 + 0.85 * k)
end

--- The loop's clock.
function ArsenalDemo._t(self, now: number): number
	return (now + self.phase) % self.loop
end

function ArsenalDemo.step(self, now: number)
	local f = ArsenalDemo["_step_" .. self.key]
	if f == nil then
		return
	end
	local t = self:_t(now)
	self._shake = 0
	f(self, t)
	local s = self._shake
	self.root.Position = if s > 0.3
		then UDim2.fromOffset(math.sin(t * 91) * s, math.cos(t * 73) * s)
		else UDim2.fromOffset(0, 0)
end

-- ---------------------------------------------------------------------------------------------
-- The scripts
-- ---------------------------------------------------------------------------------------------

-- Mega Nuke: from the silo onto the city under a reticle; a flash, a shockwave, a mushroom cloud.
local MEGA_FLY, MEGA_HIT = 0.35, 1.5
function ArsenalDemo._build_mega(self, _it: any)
	local p = self.parts
	local H = self.H
	self:_land(0.4, THEIRS)
	self:_nation(0.72, 0.72, 0.74)
	p.silo = self:_plate("Silo", SILO_COL, false, dark(MINE, 0.3), self:_plate_d())
	self:_at(p.silo, 0.15, 0.7)
	p.launch = { self:_fx("Launch1", "smoke", 8), self:_fx("Launch2", "smoke", 8) }
	p.fallout = self:_fx("Fallout", "glow", 7, Color3.fromRGB(150, 236, 90))
	p.reticle = self:_fx("Reticle", "reticle", 12, RED)
	p.trail = self:_trail("Trail", 10)
	p.missile = self:_fx("Bijudama", "glow", 13, Color3.fromRGB(219, 81, 255))
	p.boom = self:_boom("Blast")
	p.wave = self:_fx("Wave", "ring", 18)
	p.cloud = self:_flip("Cloud", "mushroom", 19)
	-- (its ground is 86 % of the way down its cell)
	p.cloud.AnchorPoint = Vector2.new(0.5, 0.86)
	p.white = new("Frame", {
		Name = "Flash",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(-self.M, -self.M),
		Size = UDim2.new(1, 2 * self.M, 1, 2 * self.M),
		ZIndex = 21,
	}, self.root)
end

function ArsenalDemo._step_mega(self, t: number)
	local p = self.parts
	local H = self.H
	local a, b = Vector2.new(0.15, 0.62), p.city_at
	local function path(s: number): (number, number)
		local point = a:Lerp(b, s)
		return point.X, point.Y
	end
	-- the launch: smoke at the silo
	for i, g in p.launch do
		self:_puff_at(g, 0.15 + (i - 1.5) * 0.05, 0.7, H * 0.26, t - MEGA_FLY + 0.05 * i, 1.0)
	end
	local s = (t - MEGA_FLY) / (MEGA_HIT - MEGA_FLY)
	if s > 0 and s < 1 then
		local x, y = path(s)
		local size = H * (0.27 + 0.10 * s)
		self:_show(p.missile, x, y, size, size)
		p.missile.Rotation = t * 420
	else
		p.missile.Visible = false
	end
	self:_trail_at(p.trail, path, MEGA_FLY, MEGA_HIT, t, H * 0.2, 1.1)
	-- the reticle on the city while it comes
	if t > 0.15 and t < MEGA_HIT then
		local pulse = 1 + 0.1 * math.sin(t * 14)
		self:_show(p.reticle, b.X, b.Y, H * 0.5 * pulse, H * 0.5 * pulse, 0.1)
		p.reticle.Rotation = t * 40
	else
		p.reticle.Visible = false
	end
	local since = t - MEGA_HIT
	-- the hit: the whole scene goes white for a moment and shakes
	p.white.BackgroundTransparency = if since >= 0 and since < 0.4 then 0.15 + 0.85 * (since / 0.4) else 1
	self:_kick(t, MEGA_HIT, 6, 0.8)
	self:_boom_at(p.boom, b.X, b.Y, H * 0.42, since, 1.0, t)
	local wk = since / 0.75
	if wk >= 0 and wk < 1 then
		local d = H * (0.4 + 2.4 * (1 - (1 - wk) ^ 2))
		self:_show(p.wave, b.X, b.Y, d, d, 0.05 + 0.95 * wk)
	else
		p.wave.Visible = false
	end
	-- the mushroom cloud rises and stays, and goes as the loop ends
	if since >= 0.05 then
		local ck = math.min(0.999, (since - 0.05) / 1.7)
		self:_flip_at(p.cloud, "mushroom", b.X, b.Y + 0.04, H * 0.92, ck, ramp(t, self.loop - 0.5, self.loop))
	else
		p.cloud.Visible = false
	end
	-- the fallout under it
	if since > 0.6 then
		self:_show(p.fallout, b.X, b.Y, H * 1.5, H * 1.2, 0.45 + 0.55 * ramp(t, self.loop - 0.5, self.loop))
	else
		p.fallout.Visible = false
	end
	local loss = 26400
	self:_troops(
		if since >= 0 then ArsenalDemo.ENEMY_TROOPS - loss else ArsenalDemo.ENEMY_TROOPS,
		loss,
		t,
		MEGA_HIT,
		b.X,
		0.42
	)
	-- (the city goes with it)
	p.city.Visible = since < 0.08
end

-- Scattershot: the missile splits over the city into five warheads.
local SCATTER = {
	Vector2.new(-0.14, -0.2),
	Vector2.new(0.12, -0.22),
	Vector2.new(-0.18, 0.12),
	Vector2.new(0.16, 0.14),
	Vector2.new(0.0, 0.0),
}
local SCAT_FLY, SCAT_SPLIT = 0.3, 1.15
function ArsenalDemo._build_scatter(self, _it: any)
	local p = self.parts
	local H = self.H
	self:_land(0.38, THEIRS)
	self:_nation(0.7, 0.7, 0.62)
	p.silo = self:_plate("Silo", SILO_COL, false, dark(MINE, 0.3), self:_plate_d())
	self:_at(p.silo, 0.14, 0.7)
	p.launch = self:_fx("Launch", "smoke", 8)
	p.trail = self:_trail("Trail", 8)
	p.missile = self:_fx("Meteor", "glow", 13, Color3.fromRGB(255, 125, 55))
	p.pop_flash = self:_fx("Split", "glow", 14, Color3.fromRGB(255, 236, 180))
	p.heads, p.booms, p.htrails = {}, {}, {}
	for i = 1, #SCATTER do
		p.heads[i] = self:_fx("Warhead" .. i, "warhead", 13)
		p.htrails[i] = self:_trail("HTrail" .. i, 3)
		p.booms[i] = self:_boom("Blast" .. i)
	end
end

function ArsenalDemo._step_scatter(self, t: number)
	local p = self.parts
	local H = self.H
	local a = Vector2.new(0.14, 0.62)
	local at = Vector2.new(0.52, 0.24)
	local lift = 0.24
	self:_puff_at(p.launch, 0.14, 0.7, H * 0.26, t - SCAT_FLY, 0.9)
	local s = (t - SCAT_FLY) / (SCAT_SPLIT - SCAT_FLY)
	if s > 0 and s < 1 then
		local x, y, h = self:_arc(a, at, lift, s)
		local r = AA.renders and AA.renders.scatter
		local mh = H * 0.34 * (1 + 0.2 * math.sin(math.pi * s))
		self:_show(p.missile, x, y, mh * (if r ~= nil then r.w / r.h else 0.45), mh)
		p.missile.Rotation = h + 90 - RENDER_TILT
	else
		p.missile.Visible = false
	end
	self:_trail_at(p.trail, function(q: number)
		local x, y = self:_arc(a, at, lift, q)
		return x, y
	end, SCAT_FLY, SCAT_SPLIT, t, H * 0.18, 1.0)
	-- the split: a flash where it opens
	local sk = (t - SCAT_SPLIT) / 0.3
	if sk >= 0 and sk < 1 then
		self:_show(p.pop_flash, at.X, at.Y, H * (0.4 + 0.4 * sk), H * (0.4 + 0.4 * sk), sk)
	else
		p.pop_flash.Visible = false
	end
	local c = p.city_at
	local left = ArsenalDemo.ENEMY_TROOPS
	local last_hit, last_loss = -1, 0
	for i, off in SCATTER do
		local tgt = Vector2.new(c.X + off.X * H / self.W * 1.6, c.Y + off.Y)
		local hit = SCAT_SPLIT + 0.32 + i * 0.07
		local hs = (t - SCAT_SPLIT) / (hit - SCAT_SPLIT)
		local head = p.heads[i]
		if hs > 0 and hs < 1 then
			local x, y, h = self:_arc(at, tgt, 0.05, hs)
			self:_show(head, x, y, H * 0.2, H * 0.2)
			head.Rotation = h
		else
			head.Visible = false
		end
		self:_trail_at(p.htrails[i], function(q: number)
			local x, y = self:_arc(at, tgt, 0.05, q)
			return x, y
		end, SCAT_SPLIT, hit, t, H * 0.1, 0.6)
		self:_boom_at(p.booms[i], tgt.X, tgt.Y, H * 0.2, t - hit, 0.85, t)
		self:_kick(t, hit, 3, 0.35)
		if t >= hit then
			left -= 3500
			last_hit, last_loss = hit, 3500
		end
	end
	self:_troops(left, last_loss, t, last_hit, c.X, 0.4)
	p.city.Visible = t < SCAT_SPLIT + 0.32 + 5 * 0.07 + 0.08
end

-- Reinforcements: three paratroopers drop in, each +2.0K, then the border advances.
local REIN_LAND = { 0.85, 1.05, 1.25 }
local REIN_FX = { 0.13, 0.25, 0.37 }
-- (one soldier of the squad's render)
local SOLDIER = { Vector2.new(0, 0), Vector2.new(150, 345) }
function ArsenalDemo._build_reinforce(self, _it: any)
	local p = self.parts
	local H, u = self.H, self.u
	self:_land(0.44, THEIRS_ALT)
	self:_nation(0.78, 0.82, 0.66)
	local fs = math.clamp(H * 0.13, 9 * u, 15 * u)
	p.mine_label =
		self:_text("Mine", fmt_k(ArsenalDemo.MY_TROOPS), fs * 0.95, Color3.fromRGB(255, 236, 200), 22, FONT_B)
	-- (low in the land: the card's sticker has the top left corner)
	self:_at(p.mine_label, 0.17, 0.5)
	p.gain = self:_text("Gain", "+2.0K", fs * 0.9, Color3.fromRGB(120, 255, 150), 23)
	p.gain.Visible = false
	p.men, p.chutes, p.dust = {}, {}, {}
	for i = 1, 3 do
		p.dust[i] = self:_fx("Dust" .. i, "smoke", 8, DUST)
		p.chutes[i] = self:_fx("Chute" .. i, "chute", 12)
		p.men[i] = self:_render("Soldier" .. i, "reinforce", H * 0.3, 11, SOLDIER)
	end
	-- arrows riding the border as it advances
	p.arrows = {}
	for i = 1, 3 do
		p.arrows[i] = self:_img("Arrow" .. i, AA.ui and AA.ui.reinforce or "", 12, WHITE)
	end
end

function ArsenalDemo._step_reinforce(self, t: number)
	local p = self.parts
	local H = self.H
	local landed = 0
	local last_land = -1
	for i, m in p.men do
		local land = REIN_LAND[i]
		local t0 = land - 0.7
		local k = (t - t0) / 0.7
		local fx = REIN_FX[i]
		local ground = 0.8
		local chute = p.chutes[i]
		if k > 0 and t < 2.2 then
			local y = lerp(-0.35, ground, math.min(1, k))
			local sway = if k < 1 then math.sin(t * 6 + i) * 8 else 0
			self:_show(m, fx, y, nil, nil, ramp(t, 1.8, 2.2))
			m.Rotation = sway * 0.6
			-- the canopy above, until it lands and folds
			local ck = (t - land) / 0.3
			if ck < 1 then
				local cw = H * 0.34 * (1 - 0.6 * clamp01(ck))
				self:_show(chute, fx, y - 0.3, cw, H * 0.34 * (1 - clamp01(ck)), clamp01(ck))
				chute.Rotation = sway
			else
				chute.Visible = false
			end
		else
			m.Visible = false
			chute.Visible = false
		end
		self:_puff_at(p.dust[i], fx, ground + 0.08, H * 0.3, t - land, 0.7)
		if t >= land then
			landed += 1
			last_land = land
		end
	end
	local mine = ArsenalDemo.MY_TROOPS + 2000 * landed
	local shown = math.floor(mine / 100)
	if shown ~= self._mine_shown then
		self._mine_shown = shown
		p.mine_label.Text = fmt_k(mine)
	end
	local gk = (t - last_land) / 0.6
	if last_land > 0 and gk >= 0 and gk <= 1 then
		p.gain.Visible = true
		fade(p.gain, gk * gk)
		-- (under the count, rising into it)
		self:_at(p.gain, 0.17, 0.66 - 0.08 * gk)
	else
		p.gain.Visible = false
	end
	-- then the border advances into the nation, which loses troops as it goes
	local push = ramp(t, 1.6, 3.4)
	local split = self:_advance(0.44, 0.6, push)
	for i, g in p.arrows do
		local on = t > 1.5 and t < 3.6
		if on then
			local a = 0.15 + 0.6 * (0.5 + 0.5 * math.sin(t * 9 - i))
			self:_show(g, split + 0.04, 0.3 + i * 0.16, H * 0.2, H * 0.2, a)
			g.Rotation = 90
		else
			g.Visible = false
		end
	end
	local loss = math.floor(5400 * push)
	self:_troops(ArsenalDemo.ENEMY_TROOPS - loss, nil)
	p.name.Position = UDim2.fromOffset((0.78 + 0.05 * push) * self.W, 0.2 * self.H)
	p.troops.Position = UDim2.fromOffset((0.78 + 0.05 * push) * self.W, p.troops.Position.Y.Offset)
end

-- Artillery: the battery fires a tracer into its range ring every second or so.
local SHELLS = {
	{ at = 0.4, tgt = Vector2.new(0.6, 0.52) },
	{ at = 1.3, tgt = Vector2.new(0.7, 0.78) },
	{ at = 2.2, tgt = Vector2.new(0.56, 0.7) },
	{ at = 3.1, tgt = Vector2.new(0.68, 0.6) },
}
local ART_AT = Vector2.new(0.3, 0.55)
function ArsenalDemo._build_artillery(self, _it: any)
	local p = self.parts
	local u = self.u
	self:_land(0.44, THEIRS)
	self:_nation(0.74, 0.86, 0.66)
	p.range = new("Frame", {
		Name = "Range",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 8,
	}, self.root)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, p.range)
	new("UIStroke", { Color = WHITE, Thickness = math.max(1, 1.2 * u), Transparency = 0.5 }, p.range)
	local rr = 0.36 * self.W
	self:_at(p.range, ART_AT.X, ART_AT.Y, 2 * rr, 2 * rr)
	p.battery = self:_plate("Battery", 0, true, dark(MINE, 0.3), self:_plate_d())
	self:_at(p.battery, ART_AT.X, ART_AT.Y)
	p.muzzle = self:_fx("Muzzle", "glow", 11, Color3.fromRGB(255, 220, 140))
	p.shells, p.booms, p.smoke = {}, {}, {}
	for i = 1, #SHELLS do
		p.shells[i] = self:_fx("Shell" .. i, "tracer", 13)
		p.booms[i] = self:_boom("Hit" .. i)
		p.smoke[i] = self:_fx("Smoke" .. i, "smoke", 10)
	end
end

function ArsenalDemo._step_artillery(self, t: number)
	local p = self.parts
	local H = self.H
	local a = Vector2.new(ART_AT.X, ART_AT.Y - 0.05)
	local left = ArsenalDemo.ENEMY_TROOPS
	local last_hit, last_loss, last_at = -1, 0, a
	local kick, muzzle = 0, -1
	for i, sh in ipairs(SHELLS) do
		local hit = sh.at + 0.38
		local s = (t - sh.at) / (hit - sh.at)
		local m = p.shells[i]
		if s > 0 and s < 1 then
			local x, y, h = self:_arc(a, sh.tgt, 0.14, s)
			self:_show(m, x, y, H * 0.3, H * 0.075)
			m.Rotation = h
		else
			m.Visible = false
		end
		self:_puff_at(p.smoke[i], a.X + 0.03, a.Y - 0.04, H * 0.2, t - sh.at, 0.8)
		self:_boom_at(p.booms[i], sh.tgt.X, sh.tgt.Y, H * 0.15, t - hit, 0.7, t)
		self:_kick(t, hit, 1.5, 0.25)
		if t >= hit then
			local loss = math.floor(left * 0.0288)
			left -= loss
			last_hit, last_loss, last_at = hit, loss, sh.tgt
		end
		local k = (t - sh.at) / 0.15
		if k >= 0 and k <= 1 then
			kick = 1 - k
			muzzle = k
		end
	end
	self:_troops(left, last_loss, t, last_hit, last_at.X, last_at.Y - 0.05)
	-- the battery's recoil and its muzzle flash on each shot
	p.battery.Rotation = -6 * kick
	if muzzle >= 0 then
		self:_show(p.muzzle, a.X + 0.04, a.Y - 0.04, H * 0.45, H * 0.45, muzzle)
	else
		p.muzzle.Visible = false
	end
end

-- Air Strike: a bomber takes off, crosses a marked spot and drops three bombs on it.
local AIR_GO, AIR_SPEED = 0.3, 0.62
local AIR_DROPS = { 0.72, 0.8, 0.88 }
local AIR_FALL = 0.32
local AIR_ALT = 0.2
local AIR_GROUND = 0.64
function ArsenalDemo._build_airfield(self, _it: any)
	local p = self.parts
	local H = self.H
	self:_land(0.4, THEIRS)
	self:_nation(0.78, 0.88, 0.7)
	p.airfield = self:_plate("Airfield", 1, true, dark(MINE, 0.3), self:_plate_d())
	self:_at(p.airfield, 0.12, 0.72)
	p.reticle = self:_fx("Reticle", "reticle", 12, RED)
	-- the bomber, nose right (its render faces left: mirrored), and its shadow on the ground
	local r = AA.renders and AA.renders.airfield
	p.jet = self:_render("Jet", "airfield", H * 0.24, 14)
	p.shadow = self:_render("Shadow", "airfield", H * 0.2, 11)
	for _, g in { p.jet, p.shadow } do
		if r ~= nil then
			g.ImageRectOffset = Vector2.new(r.w, 0)
			g.ImageRectSize = Vector2.new(-r.w, r.h)
		end
	end
	p.shadow.ImageColor3 = Color3.new(0, 0, 0)
	p.bombs, p.booms = {}, {}
	for i = 1, #AIR_DROPS do
		p.bombs[i] = self:_fx("Bomb" .. i, "bomb", 13)
		p.booms[i] = self:_boom("Blast" .. i)
	end
end

--- The bomber's x at `t` (scene fraction), and how high it is (0..1 of AIR_ALT).
local function air_x(t: number): (number, number)
	local x = 0.12 + (t - AIR_GO) * AIR_SPEED
	return x, ramp(t, AIR_GO, AIR_GO + 0.45)
end

function ArsenalDemo._step_airfield(self, t: number)
	local p = self.parts
	local H = self.H
	local x, up = air_x(t)
	local flying = t > AIR_GO and x < 1.3
	if flying then
		local alt = AIR_ALT * up
		local r = AA.renders and AA.renders.airfield
		local jh = H * 0.24 * (0.8 + 0.2 * up)
		self:_show(p.jet, x, AIR_GROUND - alt - 0.02, jh * (if r ~= nil then r.w / r.h else 2), jh)
		p.jet.Rotation = -8 * (1 - up) * up * 4
		self:_show(
			p.shadow,
			x + 0.03 * up,
			AIR_GROUND + 0.04,
			jh * 0.85 * (if r ~= nil then r.w / r.h else 2),
			jh * 0.85,
			0.55 + 0.2 * up
		)
	else
		p.jet.Visible = false
		p.shadow.Visible = false
	end
	-- the spot is marked while it comes
	local tgt_x = air_x(AIR_DROPS[2]) + AIR_SPEED * 0.6 * AIR_FALL
	if t > 0.1 and t < AIR_DROPS[3] + AIR_FALL then
		local pulse = 1 + 0.12 * math.sin(t * 12)
		self:_show(p.reticle, tgt_x, AIR_GROUND, H * 0.46 * pulse, H * 0.46 * pulse, 0.1)
		p.reticle.Rotation = -t * 50
	else
		p.reticle.Visible = false
	end
	local left = ArsenalDemo.ENEMY_TROOPS
	local last_hit, last_at = -1, tgt_x
	for i, drop in AIR_DROPS do
		local bx0 = air_x(drop)
		local k = (t - drop) / AIR_FALL
		local bomb = p.bombs[i]
		local bx = bx0 + AIR_SPEED * 0.6 * AIR_FALL * clamp01(k)
		if k >= 0 and k < 1 then
			local y = lerp(AIR_GROUND - AIR_ALT, AIR_GROUND, k * k)
			local d = H * 0.16 * (1 - 0.35 * k)
			self:_show(bomb, bx, y, d, d)
			bomb.Rotation = 20 + 60 * k
		else
			bomb.Visible = false
		end
		local hit = drop + AIR_FALL
		self:_boom_at(p.booms[i], bx, AIR_GROUND, H * 0.2, t - hit, 0.85, t)
		self:_kick(t, hit, 3, 0.35)
		if t >= hit then
			left -= 960
			last_hit, last_at = hit, bx
		end
	end
	self:_troops(
		left,
		if last_hit > 0 then ArsenalDemo.ENEMY_TROOPS - left else nil,
		t,
		last_hit,
		last_at,
		AIR_GROUND - 0.1
	)
end

-- Railgun: it charges, then a beam crosses the whole scene at once.
local RAIL_AT, RAIL_TGT = Vector2.new(0.11, 0.6), Vector2.new(0.9, 0.58)
local RAIL_FIRE = 1.25
function ArsenalDemo._build_railgun(self, _it: any)
	local p = self.parts
	self:_land(0.3, THEIRS)
	self:_nation(0.62, 0.66, 0.64)
	p.charge = self:_fx("Charge", "glow", 8, PURPLE)
	p.gun = self:_plate("Railgun", 2, true, dark(MINE, 0.3), self:_plate_d())
	self:_at(p.gun, RAIL_AT.X, RAIL_AT.Y)
	p.sparks = {}
	for i = 1, 4 do
		p.sparks[i] = self:_fx("Spark" .. i, "spark", 12, Color3.fromRGB(230, 210, 255))
	end
	p.glow_beam = self:_fx("BeamGlow", "beam", 13, PURPLE)
	p.beam = self:_fx("Beam", "beam", 14, Color3.fromRGB(240, 228, 255))
	for _, g in { p.glow_beam, p.beam } do
		g.ScaleType = Enum.ScaleType.Stretch
	end
	p.muzzle = self:_fx("Muzzle", "glow", 15, WHITE)
	p.boom = self:_boom("Hit", PURPLE)
	p.burst = {}
	for i = 1, 5 do
		p.burst[i] = self:_fx("Burst" .. i, "spark", 18, Color3.fromRGB(240, 220, 255))
	end
end

--- A beam from a to b (scene fractions), `thick` px.
function ArsenalDemo._beam_at(self, g: ImageLabel, a: Vector2, b: Vector2, thick: number, alpha: number)
	local x0, y0 = self:_px(a.X, a.Y)
	local x1, y1 = self:_px(b.X, b.Y)
	local len = math.sqrt((x1 - x0) ^ 2 + (y1 - y0) ^ 2)
	g.Visible = true
	-- (centred on its middle: Rotation turns it about its centre)
	g.Position = UDim2.fromOffset((x0 + x1) / 2, (y0 + y1) / 2)
	g.Size = UDim2.fromOffset(len, thick)
	g.Rotation = math.deg(math.atan2(y1 - y0, x1 - x0))
	g.ImageTransparency = alpha
end

function ArsenalDemo._step_railgun(self, t: number)
	local p = self.parts
	local H = self.H
	local a, b = RAIL_AT, RAIL_TGT
	-- charging: a glow grows on the gun, sparks are drawn in
	local ck = ramp(t, 0.2, RAIL_FIRE)
	if t < RAIL_FIRE + 0.1 and t > 0.15 then
		self:_show(p.charge, a.X, a.Y, H * (0.3 + 0.55 * ck), H * (0.3 + 0.55 * ck), 0.75 - 0.6 * ck)
	else
		p.charge.Visible = false
	end
	for i, g in p.sparks do
		local k = ((t * 1.6 + i / 4) % 1)
		if t > 0.2 and t < RAIL_FIRE then
			local ang = i * 1.7 + t
			local rad = 0.32 * (1 - k)
			self:_show(g, a.X + math.cos(ang) * rad * H / self.W, a.Y + math.sin(ang) * rad, H * 0.16, H * 0.16, 1 - k)
		else
			g.Visible = false
		end
	end
	p.gun.Position =
		UDim2.fromOffset(a.X * self.W + (if t < RAIL_FIRE then math.sin(t * 70) * ck * 1.5 * self.u else 0), a.Y * H)
	-- the beam: at once, from the gun to the far end, thinning and fading
	local bk = (t - RAIL_FIRE) / 0.55
	if bk >= 0 and bk < 1 then
		self:_beam_at(p.beam, a, b, H * (0.2 - 0.15 * bk), bk ^ 1.5)
		self:_beam_at(p.glow_beam, a, b, H * (0.55 - 0.3 * bk), 0.25 + 0.75 * bk)
	else
		p.beam.Visible = false
		p.glow_beam.Visible = false
	end
	local mk = (t - RAIL_FIRE) / 0.25
	if mk >= 0 and mk < 1 then
		self:_show(p.muzzle, a.X, a.Y, H * (0.5 + 0.3 * mk), H * (0.5 + 0.3 * mk), mk)
	else
		p.muzzle.Visible = false
	end
	self:_boom_at(p.boom, b.X, b.Y, H * 0.17, t - RAIL_FIRE, 0.8, t)
	self:_kick(t, RAIL_FIRE, 3.5, 0.4)
	for i, g in p.burst do
		local k = (t - RAIL_FIRE) / 0.45
		if k >= 0 and k < 1 then
			local ang = i / #p.burst * math.pi * 2 + 0.4
			local rad = 0.08 + 0.3 * (1 - (1 - k) ^ 2)
			self:_show(g, b.X + math.cos(ang) * rad * H / self.W, b.Y + math.sin(ang) * rad, H * 0.14, H * 0.14, k)
		else
			g.Visible = false
		end
	end
	local loss = 1920
	self:_troops(
		if t >= RAIL_FIRE then ArsenalDemo.ENEMY_TROOPS - loss else ArsenalDemo.ENEMY_TROOPS,
		loss,
		t,
		RAIL_FIRE,
		b.X - 0.05,
		b.Y - 0.08
	)
end

-- 2x Stars: a payout, and then the same payout doubled.
local STAMP_T = 1.3
function ArsenalDemo._build_stars2x(self, _it: any)
	local p = self.parts
	local H, u, M = self.H, self.u, self.M
	local fs = math.clamp(H * 0.22, 12 * u, 24 * u)
	if self:_map(nil) then
		-- the player's land after a match, dimmed under the payout
		p.ground = new("Frame", {
			Name = "Dim",
			BackgroundColor3 = Color3.fromRGB(24, 14, 2),
			BackgroundTransparency = 0.42,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(-M, -M),
			Size = UDim2.new(1, 2 * M, 1, 2 * M),
			ZIndex = 6,
		}, self.root)
	else
		p.ground = new("Frame", {
			Name = "Ground",
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(-M, -M),
			Size = UDim2.new(1, 2 * M, 1, 2 * M),
			ZIndex = 5,
		}, self.root)
		new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(104, 66, 12), Color3.fromRGB(36, 22, 4)),
			Rotation = 90,
		}, p.ground)
	end
	local star = (AA.ui and AA.ui.star) or ""
	p.halo = self:_fx("Halo", "glow", 8, GOLD)
	p.star = self:_img("Star", star, 9, GOLD)
	p.pay = self:_text("Pay", "+1,440", fs, Color3.fromRGB(255, 220, 110), 11)
	p.pay_scale = new("UIScale", {}, p.pay)
	p.label = self:_text("Label", "MATCH PAYOUT", fs * 0.45, WHITE, 11, FONT_B)
	p.stamp = self:_text("Stamp", "2X", fs * 1.25, Color3.fromRGB(255, 255, 255), 14)
	p.stamp_scale = new("UIScale", {}, p.stamp)
	p.stamp_ring = self:_fx("StampRing", "ring", 13, GOLD)
	p.twinkles, p.sparks = {}, {}
	for i = 1, 5 do
		p.twinkles[i] = self:_fx("Twinkle" .. i, "spark", 7, Color3.fromRGB(255, 230, 150))
	end
	for i = 1, 8 do
		p.sparks[i] = self:_img("Spark" .. i, star, 12, Color3.fromRGB(255, 225, 120))
	end
	self:_at(p.label, 0.5, 0.78)
end

local TWINKLE_AT = {
	Vector2.new(0.12, 0.2),
	Vector2.new(0.46, 0.14),
	Vector2.new(0.66, 0.82),
	Vector2.new(0.9, 0.62),
	Vector2.new(0.36, 0.86),
}
function ArsenalDemo._step_stars2x(self, t: number)
	local p = self.parts
	local H = self.H
	local sd = H * 0.42
	self:_show(p.star, 0.27, 0.45, sd, sd)
	p.star.Rotation = math.sin(t * 2) * 6
	local hp = 1 + 0.08 * math.sin(t * 3.2)
	self:_show(p.halo, 0.27, 0.45, sd * 2.2 * hp, sd * 2.2 * hp, 0.35)
	for i, g in p.twinkles do
		local k = ((t * 0.8 + i * 0.37) % 1)
		local v = math.sin(k * math.pi)
		local at = TWINKLE_AT[i]
		self:_show(g, at.X, at.Y, H * 0.16 * v, H * 0.16 * v, 1 - v)
		g.Rotation = k * 90
	end
	local count = ramp(t, STAMP_T + 0.15, STAMP_T + 0.75)
	local n = math.floor((1440 + 1440 * count) / 5 + 0.5) * 5
	local s = tostring(n)
	p.pay.Text = "+" .. (if #s > 3 then string.sub(s, 1, #s - 3) .. "," .. string.sub(s, -3) else s)
	self:_at(p.pay, 0.6, 0.45)
	fade(p.pay, 1 - ramp(t, 0.1, 0.4))
	-- (it swells as it counts)
	p.pay_scale.Scale = 1 + 0.15 * math.sin(math.pi * count)
	-- the stamp slams in
	local k = (t - STAMP_T) / 0.25
	p.stamp.Visible = k >= 0
	if k >= 0 then
		p.stamp_scale.Scale = if k < 1 then lerp(2.4, 1, 1 - (1 - k) ^ 3) else 1
		fade(p.stamp, ramp(t, self.loop - 0.4, self.loop))
		self:_at(p.stamp, 0.84, 0.3)
		p.stamp.Rotation = -12
	end
	self:_kick(t, STAMP_T + 0.2, 3, 0.3)
	local rk = (t - STAMP_T - 0.2) / 0.5
	if rk >= 0 and rk < 1 then
		local d = H * (0.3 + 0.9 * rk)
		self:_show(p.stamp_ring, 0.84, 0.3, d, d, rk)
	else
		p.stamp_ring.Visible = false
	end
	for i, sp in p.sparks do
		local a = i / #p.sparks * math.pi * 2
		local sk = (t - STAMP_T - 0.15) / 0.7
		if sk >= 0 and sk <= 1 then
			local r = 0.1 + 0.3 * (1 - (1 - sk) ^ 2)
			self:_show(sp, 0.84 + math.cos(a) * r * H / self.W * 1.4, 0.3 + math.sin(a) * r, H * 0.12, H * 0.12, sk)
			sp.Rotation = sk * 120
		else
			sp.Visible = false
		end
	end
end

-- Rapid Reload: two silos side by side; the one with Rapid Reload fires twice for the other's once.
-- (Right of the card's sticker, which takes the top left corner.)
local RELOAD_X, RELOAD_HIT = 0.3, 0.86
local RELOAD_FLY = 0.55
function ArsenalDemo._build_reload2x(self, _it: any)
	local p = self.parts
	self:_land(0.68, THEIRS)
	local H, u = self.H, self.u
	local d = math.clamp(H * 0.26, 14 * u, 30 * u)
	local fs = math.clamp(H * 0.1, 8 * u, 12 * u)
	p.rows = {}
	for i, row in { { y = 0.36, label = "NORMAL", period = 2.8 }, { y = 0.78, label = "RAPID", period = 1.4 } } do
		local silo = self:_plate("Silo" .. i, SILO_COL, false, dark(MINE, 0.3), d)
		self:_at(silo, RELOAD_X, row.y)
		local bar_bg = new("Frame", {
			Name = "Bar" .. i,
			BackgroundColor3 = INK,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromOffset((RELOAD_X + 0.08) * self.W, row.y * H),
			Size = UDim2.fromOffset(0.24 * self.W, math.max(4, H * 0.1)),
			ZIndex = 9,
		}, self.root)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, bar_bg)
		local fill = new("Frame", {
			Name = "Fill",
			BackgroundColor3 = if i == 2 then Color3.fromRGB(255, 120, 200) else Color3.fromRGB(200, 200, 210),
			BorderSizePixel = 0,
			Size = UDim2.fromScale(0, 1),
			ZIndex = 10,
		}, bar_bg)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, fill)
		local label =
			self:_text("Label" .. i, row.label, fs, if i == 2 then Color3.fromRGB(255, 170, 225) else WHITE, 11, FONT_B)
		self:_at(label, RELOAD_X + 0.2, row.y - 0.15)
		p.rows[i] = {
			y = row.y,
			period = row.period,
			fill = fill,
			shot = self:_fx("Shot" .. i, "warhead", 13),
			trail = self:_trail("Trail" .. i, 4),
			puff = self:_fx("Puff" .. i, "smoke", 8),
			boom = self:_boom("Hit" .. i),
		}
	end
end

function ArsenalDemo._step_reload2x(self, t: number)
	local p = self.parts
	local H = self.H
	for _, r in p.rows do
		-- (the bars start part full: a shot leaves at period - LEAD, and the loop is a whole number of
		-- both periods, so no shot is cut off by the loop's end)
		local into = (t + 0.6) % r.period
		r.fill.Size = UDim2.fromScale(into / r.period, 1)
		local fired = t + 0.6 >= r.period
		local a, b = Vector2.new(RELOAD_X, r.y), Vector2.new(RELOAD_HIT, r.y)
		local fs = into / RELOAD_FLY
		if fired and fs < 1 then
			local x, y, h = self:_arc(a, b, 0.05, fs)
			self:_show(r.shot, x, y, H * 0.17, H * 0.17)
			r.shot.Rotation = h
		else
			r.shot.Visible = false
		end
		local t0 = t - into
		self:_trail_at(r.trail, function(q: number)
			local x, y = self:_arc(a, b, 0.05, q)
			return x, y
		end, t0, t0 + RELOAD_FLY, if fired then t else -1, H * 0.1, 0.5)
		self:_puff_at(r.puff, RELOAD_X, r.y, H * 0.22, if fired then into else -1, 0.6)
		self:_boom_at(r.boom, RELOAD_HIT, r.y, H * 0.13, if fired then into - RELOAD_FLY else -1, 0.6, t)
		if fired then
			self:_kick(into, RELOAD_FLY, 1.5, 0.25)
		end
	end
end

return ArsenalDemo
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">AttacksPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/attacks_panel.gd (UIAttacksPanel)
-- Active attacks involving you (right side, under the leaderboard): incoming fronts in red with a
-- Focus button, outgoing fronts and expansions with their committed troops and a Retreat button.
-- Phones show only a small chip (icon + count, red when you are attacked); a tap opens the list
-- as a peek that folds itself away again.
--
-- Signals: retreat_requested(aid), toggled(collapsed). Members: panel, collapsed, manual, tray_open.
-- Methods: apply_layout(top, bottom_limit), peek(), bottom_edge(), mark_dirty(), involved(),
-- committed(), refresh(); per frame update(dt).

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local Signal = UITheme.core("Signal")

local AttacksPanel = W.class(W.Control)

AttacksPanel.MAX_ROWS_DESKTOP = 6
AttacksPanel.MAX_ROWS_PHONE = 2
--- Lists this short never get summarised.
AttacksPanel.ALWAYS_ROWS = 2
--- Phones: seconds an opened list stays open after the last touch.
AttacksPanel.PEEK_SECONDS = 8.0

local function msec(): number
	return os.clock() * 1000.0
end

-- ---------------------------------------------------------------------------------------------
-- Row
-- ---------------------------------------------------------------------------------------------

local Row = W.class(W.Panel)
AttacksPanel.Row = Row

function Row.new(c: any)
	local self = setmetatable({}, Row.__mt)
	W.Control._init(self)
	W.Panel._init_panel(self)
	local T = UITheme
	self.ctx = c
	self.aid = 0
	self.incoming = nil
	self.focus_tile = -1
	self.focus_id = 0
	self.retreat = Signal.new()
	self.touched = Signal.new()
	self:set_mouse_filter(W.MOUSE_STOP)
	self._bg_in = T.flat(T.c(T.RED, 0.14), 8, T.c(T.RED, 0.45), 1, 8.0, 3.0)
	self._bg_out = T.flat(T.rgba(1, 1, 1, 0.04), 8, T.rgba(1, 1, 1, 0.06), 1, 8.0, 3.0)
	self:add_theme_stylebox_override("panel", self._bg_out)
	local h = T.hbox(8)
	self:add_child(h)
	self.arrow = T.icon_rect("attack", 13.0, T.AMBER)
	self.arrow.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self.arrow)
	self.sw = T.swatch(T.TEXT, 9.0, 2)
	h:add_child(self.sw)
	self.name_l = T.label("", 13, 600)
	self.name_l.text_overrun_behavior = W.OVERRUN_ELLIPSIS
	self.name_l.size_flags_horizontal = W.EXPAND_FILL
	self.name_l:set_min_size(Vector2.new(40, 0))
	self.name_l.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self.name_l)
	self.troops_l = T.label("", 13, 700)
	T.fix_width(self.troops_l, T.text_width("888.8K", 13, 700) + 2.0, W.ALIGN_RIGHT)
	self.troops_l.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self.troops_l)
	local action = W.Button.new("", "GlassButton")
	action.expand_icon = true
	action:add_theme_constant_override("icon_max_width", 14)
	action:set_font_size(11)
	action:set_min_size(Vector2.new(30, 28))
	for _, st in ipairs(W.BUTTON_STATES) do
		action:add_theme_stylebox_override(
			st,
			T.flat(if st == "normal" then T.FILL else T.FILL_2, 7, T.LINE, 1, 6.0, 4.0)
		)
	end
	action.pressed:Connect(function()
		self:_on_action()
	end)
	self.action = action
	h:add_child(action)
	self.gui_input:Connect(function(e)
		if e.kind == "button" and e.pressed and e.button == 1 then
			-- Roblox also reports presses on the action button to the row: that one is the button's
			local r = self.action:get_global_rect()
			local p = e.global_position
			if p.X >= r.Min.X and p.X <= r.Max.X and p.Y >= r.Min.Y and p.Y <= r.Max.Y then
				return
			end
			self:_focus()
		end
	end)
	return self
end

function Row.set_attack(self, a: any, touch: boolean)
	local ctx = self.ctx
	local T = UITheme
	local s = ctx.state
	self.aid = a.aid
	local incoming = a.target == ctx:me()
	local other = if incoming then a.attacker else a.target
	self.focus_id = other
	self.focus_tile = a.anchor_tile
	-- Expansions into neutral land are routine: draw them quieter than real fronts.
	self:set_modulate_a(if not incoming and other == 0 then 0.72 else 1.0)
	if self.incoming ~= incoming then
		self.incoming = incoming
		self:add_theme_stylebox_override("panel", if incoming then self._bg_in else self._bg_out)
	end
	self.arrow:set_icon(if incoming then "target" else (if other ~= 0 then "attack" else "globe"))
	self.arrow:set_color(if incoming then T.RED else (if other ~= 0 then T.AMBER else T.GREEN))
	self.sw:set_visible(other ~= 0)
	if other ~= 0 then
		T.set_swatch_color(self.sw, s:owner_color(other))
	end
	-- a retreating attack says so and can't be recalled again
	local name = if other ~= 0 then s:owner_name(other) else "Expansion"
	self.name_l:set_text(if a.retreating then name .. " (retreating…)" else name)
	T.set_font_color(self.name_l, if incoming then Color3.new(1.0, 0.82, 0.84) else T.TEXT)
	self.troops_l:set_text(T.fmt_troops(a.troops))
	T.set_font_color(self.troops_l, if incoming then T.RED else T.TEXT)
	self.action:set_min_size(Vector2.new(if touch then 48 else 30, if touch then 44 else 26))
	self.action:set_icon(if incoming then "eye" else "retreat")
	self.action:set_text("")
	self.action:set_disabled(a.retreating == true and not incoming)
end

function Row._on_action(self)
	self.touched:Fire()
	if self.incoming then
		self:_focus()
	else
		self.retreat:Fire(self.aid)
	end
end

function Row._focus(self)
	self.touched:Fire()
	if self.focus_tile >= 0 then
		self.ctx:world_call("focus_tile", { self.focus_tile, -1.0, 0.8 })
	elseif self.focus_id ~= 0 then
		self.ctx:world_call("focus_owner", { self.focus_id })
	end
end

-- ---------------------------------------------------------------------------------------------
-- Panel
-- ---------------------------------------------------------------------------------------------

function AttacksPanel.new(c: any)
	local self = setmetatable({}, AttacksPanel.__mt)
	W.Control._init(self)
	local T = UITheme
	self.ctx = c
	self.retreat_requested = Signal.new()
	self.toggled = Signal.new()
	self._rows = {}
	self._accum = 0.0
	self._dirty = true
	--- Effective state (computed in refresh()).
	self.collapsed = false
	--- Player override: 0 = automatic, 1 = keep open, 2 = keep collapsed (reset when the list empties).
	self.manual = 0
	--- The phone build tray is open (the panel folds to its header so the tray never covers rows).
	self.tray_open = false
	self._bottom_limit = -1.0
	self._peek_msec = 0
	self._chip_key = ""
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self.panel = GlassPanel.new(10.0, 9.0, T.R_LG, true, 16)
	self:add_child(self.panel)
	local v = T.vbox(5)
	self.panel:add_child(v)
	local head = T.hbox(8)
	self._icon = T.icon_rect("attack", 13.0, T.AMBER)
	self._icon.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(self._icon)
	self._title = T.label("ATTACKS", 12, 800, T.TEXT, 2)
	head:add_child(self._title)
	local sp = W.Control.new()
	sp.size_flags_horizontal = W.EXPAND_FILL
	sp:set_mouse_filter(W.MOUSE_IGNORE)
	head:add_child(sp)
	self._count = T.label("", 11, 600, T.TEXT_3)
	T.fix_width(self._count, 90.0, W.ALIGN_RIGHT, false)
	head:add_child(self._count)
	self._chev = T.icon_rect("chevron", 12.0, T.TEXT_3)
	self._chev.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(self._chev)
	-- The whole header toggles the list (phones keep the globe clear with one tap).
	local hb = W.Button.new("", "GhostButton")
	hb:set_flat(true)
	for _, st in ipairs(W.BUTTON_STATES) do
		hb:add_theme_stylebox_override(st, T.empty_box())
	end
	hb:set_min_size(Vector2.new(0, 24))
	local hm = W.Margin.new()
	hm:set_mouse_filter(W.MOUSE_IGNORE)
	hm:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	hm:add_theme_constant_override("margin_left", 4)
	hm:add_theme_constant_override("margin_right", 4)
	hm:add_child(head)
	hb:add_child(hm)
	hb.pressed:Connect(function()
		self.manual = if self.collapsed then 1 else 2
		self._peek_msec = msec()
		self:refresh()
		self.toggled:Fire(self.collapsed)
	end)
	self._head_btn = hb
	v:add_child(hb)
	self._list = T.vbox(4)
	v:add_child(self._list)
	self._more = T.label("", 11, 600, T.TEXT_3)
	self._more.horizontal_alignment = W.ALIGN_CENTER
	v:add_child(self._more)
	self.panel:set_visible(false)
	return self
end

--- `bottom_limit`: the panel must end above this y (the command bar); rows that do not fit are
--- summarised as "+N more".
function AttacksPanel.apply_layout(self, top: number, bottom_limit: number?)
	local ctx = self.ctx
	self._bottom_limit = bottom_limit or -1.0
	local right = 12.0 + ctx.insets.z
	local p = self.panel
	p.anchor_left, p.anchor_right, p.anchor_top, p.anchor_bottom = 1.0, 1.0, 0.0, 0.0
	p.grow_horizontal = W.GROW_BEGIN
	p.grow_vertical = W.GROW_END
	p.offset_left = -right
	p.offset_right = -right
	p.offset_top = top
	p.offset_bottom = top
	self._head_btn:set_min_height(if ctx.touch then 44 else 24)
	self:_fit_chip()
	p:reset_size()
end

--- Keep the phone list open (e.g. after the player used a row).
function AttacksPanel.peek(self)
	self.manual = 1
	self._peek_msec = msec()
end

--- Phones: collapsed = a small chip exactly one touch target tall; open = the list panel.
function AttacksPanel._fit_chip(self)
	local ctx = self.ctx
	local T = UITheme
	local chip = ctx.compact and self.collapsed
	local key = string.format("%s|%s|%s", tostring(ctx.compact), tostring(chip), tostring(T.min_font_size))
	if key == self._chip_key then
		return
	end
	self._chip_key = key
	self._title:set_visible(not chip)
	self._list:set_visible(not chip)
	self.panel:set_min_size(Vector2.new(if chip then 0.0 else (if ctx.compact then 250.0 else 300.0), 0))
	if ctx.compact then
		if chip then
			self.panel:set_padding(6.0, 0.0, 4.0, 0.0)
		else
			self.panel:set_padding(10.0, 2.0, 10.0, 8.0)
		end
	else
		self.panel:set_padding(10.0, 9.0, 10.0, 9.0)
	end
	T.fix_width(self._count, 90.0, W.ALIGN_RIGHT, false)
	self._count:set_font_size(if chip then 12 else 11)
	self:_fit_chip_width()
end

--- Chip: as narrow as its count ("3", "3 · 1 in"); the header button carries that width
--- (margins 4 + icon + gap + count + gap + chevron + margins 4, and a full 44 px at least).
function AttacksPanel._fit_chip_width(self)
	local ctx = self.ctx
	if not (ctx.compact and self.collapsed) then
		self._head_btn:set_min_width(0.0)
		return
	end
	local cw = UITheme.text_width(if self._count.text ~= "" then self._count.text else "8", 12, 700) + 2.0
	self._count:set_min_width(cw)
	self._head_btn:set_min_width(math.max(44.0, 4.0 + 13.0 + 8.0 + cw + 8.0 + 12.0 + 4.0))
end

function AttacksPanel.bottom_edge(self): number
	if self.panel.visible then
		return self.panel:get_rect().Max.Y
	end
	return -1.0
end

function AttacksPanel.mark_dirty(self)
	self._dirty = true
end

--- Attacks involving the local player, incoming first, then by committed troops.
function AttacksPanel.involved(self): { any }
	local out = {}
	local ctx = self.ctx
	local s = ctx.state
	local me = ctx:me()
	if s == nil or me == 0 then
		return out
	end
	for _, a in pairs(s.attacks) do
		if a.attacker == me or a.target == me then
			table.insert(out, a)
		end
	end
	table.sort(out, function(p, q)
		local pi, qi = p.target == me, q.target == me
		if pi ~= qi then
			return pi
		end
		local pe, qe = p.target == 0, q.target == 0
		if pe ~= qe then
			return qe
		end
		if p.troops ~= q.troops then
			return p.troops > q.troops
		end
		return p.aid < q.aid
	end)
	return out
end

--- Phones fold the panel to its header while the build tray is open, and while only expansions
--- into neutral land are running (those are routine, not wars); the player can override by tapping.
function AttacksPanel._want_collapsed(self, list: { any }): boolean
	local ctx = self.ctx
	if #list == 0 then
		self.manual = 0
		return false
	end
	if self.tray_open and ctx.compact then
		return true
	end
	if ctx.compact then
		-- A peek: open only after a tap, and only until the player leaves it alone for a while.
		if self.manual == 1 and msec() - self._peek_msec < AttacksPanel.PEEK_SECONDS * 1000.0 then
			return false
		end
		self.manual = 0
		return true
	end
	if self.manual ~= 0 then
		return self.manual == 2
	end
	return false
end

--- Troops currently committed to our outgoing attacks.
function AttacksPanel.committed(self): number
	local n = 0
	for _, a in ipairs(self:involved()) do
		if a.attacker == self.ctx:me() then
			n += a.troops
		end
	end
	return n
end

function AttacksPanel.refresh(self)
	local ctx = self.ctx
	local T = UITheme
	self._dirty = false
	local list = self:involved()
	local was = self.panel.visible
	self.panel:set_visible(#list > 0 and ctx:alive_player())
	if not self.panel.visible then
		return
	end
	local max_rows = if ctx.compact then AttacksPanel.MAX_ROWS_PHONE else AttacksPanel.MAX_ROWS_DESKTOP
	if self._bottom_limit > 0 then
		local row_h = if ctx.touch then 48.0 else 30.0
		local head_h = self._head_btn.custom_minimum_size.Y + 24.0
		local room = self._bottom_limit - self.panel.offset_top - head_h
		max_rows = math.clamp(math.floor(room / row_h), 0, max_rows)
	end
	-- Short lists are always shown in full; "+N more" only summarises a real overflow.
	max_rows = math.max(max_rows, math.min(AttacksPanel.ALWAYS_ROWS, #list))
	if #list == max_rows + 1 then
		max_rows += 1 -- "+1 more" would take a row anyway
	end
	local was_collapsed = self.collapsed
	self.collapsed = self:_want_collapsed(list)
	if self.collapsed ~= was_collapsed or not was then
		self:_fit_chip()
	end
	local shown = if self.collapsed then 0 else math.min(max_rows, #list)
	self._chev:set_rotation(if self.collapsed then -math.pi * 0.5 else 0.0)
	while #self._rows < shown do
		local r = Row.new(ctx)
		r.retreat:Connect(function(aid: number)
			self.retreat_requested:Fire(aid)
		end)
		r.touched:Connect(function()
			self._peek_msec = msec()
		end)
		table.insert(self._rows, r)
		self._list:add_child(r)
	end
	for i, r in ipairs(self._rows) do
		r:set_visible(i <= shown)
		if i <= shown then
			r:set_attack(list[i], ctx.touch)
		end
	end
	local inc = 0
	for _, a in ipairs(list) do
		if a.target == ctx:me() then
			inc += 1
		end
	end
	local outc = #list - inc
	local parts = {}
	if outc > 0 then
		table.insert(parts, string.format("%d out", outc))
	end
	if inc > 0 then
		table.insert(parts, string.format("%d in", inc))
	end
	local ctext = table.concat(parts, "  ·  ")
	if ctx.compact and self.collapsed then
		ctext = if inc == 0 then tostring(#list) else string.format("%d · %d in", #list, inc)
	end
	self._count:set_text(ctext)
	T.set_font_color(
		self._count,
		if inc > 0 then T.RED else (if self.collapsed and ctx.compact then T.TEXT else T.TEXT_3)
	)
	if ctx.compact and self.collapsed and self._count.text ~= self._count:get_meta("fit", "") then
		self._count:set_meta("fit", self._count.text)
		self:_fit_chip_width()
	end
	self._icon:set_icon(if inc > 0 then "target" else "attack")
	self._icon:set_color(if inc > 0 then T.RED else T.AMBER)
	self._more:set_visible(#list > shown and not self.collapsed)
	self._more:set_text(string.format("+%d more", #list - shown))
	self.panel:reset_size()
	if not was then
		W.pop_in(self.panel, 0.0, 0.96, 0.3)
	end
end

--- Per frame (GDScript _process).
function AttacksPanel.update(self, delta: number)
	self._accum += delta
	if (self._dirty or self._accum >= 0.5) and self:is_visible_in_tree() then
		self._accum = 0.0
		self:refresh()
	end
end

return AttacksPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">Banner</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/banner.gd (UIBanner)
-- Centre-screen moment ("THE WAR BEGINS"): a wide letter-spaced title over a soft band that fades
-- in, holds and fades out, then frees itself.

local UITheme = require("./UITheme")
local W = require("./Widgets")

local Banner = W.class(W.Control)

local BAND = Color3.new(0.01, 0.015, 0.05)
-- vertical gradient: alpha 0 -> 0.62 -> 0
local BAND_SEQ = NumberSequence.new({
	NumberSequenceKeypoint.new(0.0, 1.0),
	NumberSequenceKeypoint.new(0.5, 0.0),
	NumberSequenceKeypoint.new(1.0, 1.0),
})

--- UIBanner.make(ctx, title, sub, col, hold = 1.6, top_y = -1, height = 0, small = false)
--- `top_y` / `height`: the band's placement in logical px (height <= 0 = centred default).
--- Add the returned node to a full-rect layer; it animates and frees itself.
function Banner.make(
	ctx: any,
	title: string,
	sub: string,
	col: any,
	hold: number?,
	top_y: number?,
	height: number?,
	small: boolean?
)
	local b = setmetatable({}, Banner.__mt)
	W.Control._init(b)
	b:set_mouse_filter(W.MOUSE_IGNORE)
	b:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	local hold_s = hold or 1.6
	local ty = top_y or -1.0
	local hh = height or 0.0
	local sm = small == true
	local band = W.ColorRect.new(UITheme.c(BAND, 0.62))
	band:set_mouse_filter(W.MOUSE_IGNORE)
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Transparency = BAND_SEQ
	grad.Parent = band.gui
	local v = UITheme.vbox(6)
	v:set_alignment(W.ALIGN_CENTER)
	for _, c in ipairs({ band, v }) do
		c.anchor_left = 0.0
		c.anchor_right = 1.0
		if ty >= 0 and hh > 0 then
			c.anchor_top = 0.0
			c.anchor_bottom = 0.0
			c.offset_top = ty
			c.offset_bottom = ty + hh
		else
			c.anchor_top = 0.36
			c.anchor_bottom = 0.56
		end
	end
	b:add_child(band)
	b:add_child(v)
	local t = UITheme.label(
		title,
		if sm then 22 else (if not ctx.compact then 40 else 26),
		900,
		UITheme.lerp(col, UITheme.WHITE, 0.25),
		if sm then 4 else (if not ctx.compact then 8 else 5)
	)
	t:set_alignment(W.ALIGN_CENTER)
	t:set_shadow(UITheme.rgba(0, 0, 0, 0.5), 3, 6)
	v:add_child(t)
	if sub ~= "" and not sm then
		local s = UITheme.label(sub, if not ctx.compact then 15 else 12, 600, UITheme.TEXT_2, 1)
		s:set_alignment(W.ALIGN_CENTER)
		v:add_child(s)
	end
	b.title_label = t
	-- The text block (title + subtitle) as its own invisible node: UIRoot registers it as a HUD
	-- control so map labels (the player's own included) step aside while the banner is up.
	local area = W.Control.new()
	area:set_mouse_filter(W.MOUSE_IGNORE)
	local tw = t:get_combined_minimum_size().X
	for _, ch in ipairs(v:get_children()) do
		tw = math.max(tw, ch:get_combined_minimum_size().X)
	end
	local th = v:get_combined_minimum_size().Y
	area.anchor_left = 0.5
	area.anchor_right = 0.5
	area.offset_left = -math.ceil(tw * 0.5) - 8
	area.offset_right = math.ceil(tw * 0.5) + 8
	if ty >= 0 and hh > 0 then
		area.anchor_top = 0.0
		area.anchor_bottom = 0.0
		local cy = ty + hh * 0.5
		area.offset_top = math.floor(cy - th * 0.5) - 4
		area.offset_bottom = math.ceil(cy + th * 0.5) + 4
	else
		area.anchor_top = 0.46
		area.anchor_bottom = 0.46
		area.offset_top = -math.ceil(th * 0.5) - 4
		area.offset_bottom = math.ceil(th * 0.5) + 4
	end
	b:add_child(area)
	b.text_area = area
	b._slide_parts = { band, v, area }
	if ty >= 0 and hh > 0 then
		b._base_top = ty
		b._height = hh
		b._shift = 0.0
		b:set_process(true)
	end
	b:set_modulate_a(0.0)
	W.defer(function()
		if b._freed then
			return
		end
		t:set_scale(1.12)
		local tw = b:create_tween():set_parallel(true)
		tw:tween_property(b, "modulate:a", 1.0, 0.35)
		tw:tween_property(t, "scale", 1.0, 0.9):set_trans(W.TRANS_EXPO):set_ease(W.EASE_OUT)
		tw:chain():tween_interval(hold_s)
		tw:chain():tween_property(b, "modulate:a", 0.0, 0.6)
		tw:chain():tween_callback(function()
			b:queue_free()
		end)
	end)
	return b
end

--- Optional: `avoid` = function() -> Rect? (logical px) the banner's text must not cover (the local
--- player's own label while the camera pushes in); `min_top` / `max_bottom` bound where the band
--- may move. Set by the caller after make() (explicitly placed banners only).
Banner.MARGIN = 10.0

--- Keeps the text block clear of the `avoid` rect: slides the band up above it (or below it when
--- there is no room above) within [min_top, max_bottom], eased. Overlap is judged against the
--- band's own placement, so a clear banner never drifts back and forth.
function Banner._process(self, delta: number)
	local avoid = self.avoid
	if avoid == nil or self._base_top == nil or self._freed then
		return
	end
	local ok, r = pcall(avoid)
	local want = 0.0
	local area = self.text_area
	if ok and typeof(r) == "Rect" and area ~= nil then
		local ar = area:get_global_rect()
		local m = Banner.MARGIN
		local a0, a1 = ar.Min.Y - self._shift, ar.Max.Y - self._shift
		if r.Max.X > ar.Min.X and r.Min.X < ar.Max.X and r.Max.Y > a0 - m and r.Min.Y < a1 + m then
			local up = (r.Min.Y - m) - a1
			local down = (r.Max.Y + m) - a0
			local min_top = self.min_top or -math.huge
			local max_bottom = self.max_bottom or math.huge
			local up_ok = self._base_top + up >= min_top
			local down_ok = self._base_top + self._height + down <= max_bottom
			if up_ok and (not down_ok or -up <= down) then
				want = up
			elseif down_ok then
				want = down
			else
				want = math.max(up, min_top - self._base_top)
			end
		end
	end
	local sh = self._shift
	if math.abs(want - sh) < 0.25 then
		sh = want
	else
		sh += (want - sh) * math.min(1.0, delta * 12.0)
	end
	if sh == self._shift then
		return
	end
	self._shift = sh
	local d = math.floor(sh + 0.5)
	for _, c in ipairs(self._slide_parts) do
		if c._base_top == nil then
			c._base_top, c._base_bottom = c.offset_top, c.offset_bottom
		end
		c.offset_top = c._base_top + d
		c.offset_bottom = c._base_bottom + d
		c:queue_layout()
	end
end

return Banner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">BorderTracker</string>
              <string name="Source"><![CDATA[--!native
-- Port of scripts/ui/border_tracker.gd (class UIBorders)
-- Incrementally tracks the local player's border tiles so the UI can answer "do I border this
-- owner?" and "can a boat reach that coast?" instantly (the Sim still validates everything).

-- Flat maps: the grid size comes from the bound state's map; tiles on an edge simply have
-- fewer neighbours (nothing wraps).
local F_FALLOUT = 1

local BorderTracker = {}
BorderTracker.__index = BorderTracker

function BorderTracker.new()
	local self = setmetatable({}, BorderTracker)
	self.state = nil :: any
	self.me = 0
	--- Local player's tiles that touch at least one tile they do not own (incl. water): set.
	self.border = {} :: { [number]: boolean }
	self._neighbours = {} :: { [number]: boolean }
	self._bodies = {} :: { [number]: boolean }
	self._touches_neutral = false
	self._dirty = true
	self._computed_msec = -100000
	self.W = 1
	self.H = 1
	--- scratch: the 4-neighbours of a tile (count in _nn)
	self._nb = table.create(4, 0)
	self._nn = 0
	return self
end

--- Fills self._nb[1.._nn] with the in-map 4-neighbours of tile i.
function BorderTracker._neighbours4(self: any, i: number)
	local W = self.W
	local x = i % W
	local nb = self._nb
	local n = 0
	if x > 0 then
		n += 1
		nb[n] = i - 1
	end
	if x < W - 1 then
		n += 1
		nb[n] = i + 1
	end
	if i >= W then
		n += 1
		nb[n] = i - W
	end
	if i < W * (self.H - 1) then
		n += 1
		nb[n] = i + W
	end
	self._nn = n
end

local function msec(): number
	return os.clock() * 1000.0
end

-- Owner grid accessor: Core keeps per-tile grids as i32 buffers.
local function owner_at(own: any, i: number): number
	if typeof(own) == "buffer" then
		return buffer.readi32(own, i * 4)
	end
	return own[i] or 0
end

local function u8(grid: any, i: number): number
	if typeof(grid) == "buffer" then
		return buffer.readu8(grid, i)
	end
	return grid[i] or 0
end

--- Water body of a coastal tile (maps store 16-bit bodies; older mirrors a u8 grid).
local function coast_body_of(map: any, i: number): number
	if type(map.coast_body_of) == "function" then
		return map:coast_body_of(i)
	end
	return u8(map.coast_body, i)
end

function BorderTracker.bind(self: any, s: any, owner_id: number)
	self.state = s
	self.me = owner_id
	table.clear(self.border)
	self._dirty = true
	if s ~= nil and s.map ~= nil then
		self.W = s.map.W or s.map.width or 1
		self.H = s.map.H or s.map.height or 1
	end
	local TILE_COUNT = self.W * self.H
	if s == nil or owner_id <= 0 then
		return
	end
	local o = s:get_owner(owner_id)
	if o == nil or (o.tiles or 0) <= 0 then
		return
	end
	local own = s.owner
	local border = self.border
	if typeof(own) == "buffer" then
		for i = 0, TILE_COUNT - 1 do
			if buffer.readi32(own, i * 4) == owner_id and self:_is_border(i) then
				border[i] = true
			end
		end
	else
		for i = 0, TILE_COUNT - 1 do
			if (own[i] or 0) == owner_id and self:_is_border(i) then
				border[i] = true
			end
		end
	end
end

--- `changed` holds packed (tile << 10) | owner values (buffer of i32 or a Luau array).
function BorderTracker.on_tiles_changed(self: any, changed: any)
	if self.state == nil or self.me <= 0 then
		return
	end
	if typeof(changed) == "buffer" then
		local n = buffer.len(changed) // 4
		for k = 0, n - 1 do
			self:_on_change(buffer.readi32(changed, k * 4))
		end
	else
		for _, v in changed do
			self:_on_change(v)
		end
	end
end

function BorderTracker._on_change(self: any, v: number)
	local own = self.state.owner
	local me = self.me
	local border = self.border
	local i = v // 1024
	local nw = v % 1024
	local mine_now = nw == me
	self:_neighbours4(i)
	local nb, nn = self._nb, self._nn
	if not mine_now and not border[i] then
		-- Fast reject: a change between other owners that does not touch our land.
		local touches = false
		for k = 1, nn do
			if owner_at(own, nb[k]) == me then
				touches = true
				break
			end
		end
		if not touches then
			return
		end
	end
	if mine_now then
		if self:_is_border(i) then
			border[i] = true
		else
			border[i] = nil
		end
	else
		border[i] = nil
	end
	-- Neighbours that belong to us may have gained or lost border status.
	self:_neighbours4(i)
	local ns = table.clone(self._nb)
	for k = 1, self._nn do
		self:_recheck(ns[k], own, mine_now)
	end
	self._dirty = true
end

function BorderTracker._recheck(self: any, n: number, own: any, changed_is_mine: boolean)
	if owner_at(own, n) ~= self.me then
		return
	end
	if not changed_is_mine then
		self.border[n] = true
	elseif self.border[n] and not self:_is_border(n) then
		self.border[n] = nil
	end
end

function BorderTracker._is_border(self: any, i: number): boolean
	local own = self.state.owner
	local me = self.me
	self:_neighbours4(i)
	local nb = self._nb
	for k = 1, self._nn do
		if owner_at(own, nb[k]) ~= me then
			return true
		end
	end
	return false
end

function BorderTracker._refresh(self: any)
	if not self._dirty then
		return
	end
	local now = msec()
	if now - self._computed_msec < 400 and next(self._neighbours) ~= nil then
		return
	end
	self._computed_msec = now
	self._dirty = false
	table.clear(self._neighbours)
	table.clear(self._bodies)
	self._touches_neutral = false
	local s = self.state
	if s == nil then
		return
	end
	local own = s.owner
	local map = s.map
	local coastal = map.coastal
	for i in self.border do
		self:_neighbours4(i)
		local nb = self._nb
		for k = 1, self._nn do
			local t = nb[k]
			self:_note(owner_at(own, t), t, map)
		end
		if u8(coastal, i) == 1 then
			self._bodies[coast_body_of(map, i)] = true
		end
	end
end

function BorderTracker._note(self: any, o: number, t: number, map: any)
	if o == self.me then
		return
	end
	if o == 0 then
		if
			not self._touches_neutral
			and map:is_contestable(t)
			and bit32.band(u8(self.state.flags, t), F_FALLOUT) == 0
		then
			self._touches_neutral = true
		end
		return
	end
	self._neighbours[o] = true
end

--- True when we share a land border with `id` (0 = any claimable neutral land).
function BorderTracker.borders_owner(self: any, id: number): boolean
	self:_refresh()
	if id == 0 then
		return self._touches_neutral
	end
	return self._neighbours[id] == true
end

--- Neighbour owner ids, ascending (deterministic order).
function BorderTracker.neighbour_ids(self: any): { number }
	self:_refresh()
	local out = {}
	for k in self._neighbours do
		table.insert(out, k)
	end
	table.sort(out)
	return out
end

function BorderTracker.has_coast(self: any): boolean
	self:_refresh()
	return next(self._bodies) ~= nil
end

--- A transport can sail from our coast to `tile` (coastal land on a water body we touch).
function BorderTracker.can_reach_by_sea(self: any, tile: number): boolean
	local s = self.state
	if s == nil or tile < 0 then
		return false
	end
	self:_refresh()
	local map = s.map
	return u8(map.coastal, tile) == 1 and self._bodies[coast_body_of(map, tile)] == true
end

--- Flood-fills the clicked owner's region from `tile` (bounded) to see whether it touches us
--- by land. Returns 1 = touches, 0 = region fully explored without contact, -1 = budget exhausted.
function BorderTracker.region_touches_me(self: any, tile: number, budget: number?): number
	local s = self.state
	if s == nil or self.me <= 0 or tile < 0 then
		return 0
	end
	local lim = budget or 3000
	local own = s.owner
	local me = self.me
	local target = owner_at(own, tile)
	local map = s.map
	local seen = { [tile] = true }
	local queue = { tile }
	local head = 1
	local ns = table.create(4, 0)
	while head <= #queue do
		if head - 1 >= lim then
			return -1
		end
		local i = queue[head]
		head += 1
		self:_neighbours4(i)
		local cnt = self._nn
		for k = 1, cnt do
			ns[k] = self._nb[k]
		end
		for k = 1, cnt do
			local n = ns[k]
			local o = owner_at(own, n)
			if o == me then
				return 1
			end
			if o == target and not seen[n] and map:is_contestable(n) then
				seen[n] = true
				table.insert(queue, n)
			end
		end
	end
	return 0
end

return BorderTracker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="142">
            <Properties>
              <string name="Name">BuildButton</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/build_button.gd (UIBuildButton)
-- One build / nuke slot of the command bar: icon, cost, hotkey badge, owned count and a clear
-- disabled state. Stays clickable when unavailable so a click can explain why.
-- An Arsenal kind the player hasn't unlocked (UIRules.availability: `arsenal`) wears a gold lock
-- where its cost would be; its card shows what it does and what unlocks it.
--
-- Signals: chosen(kind). Methods as GDScript: set_compact(on, touch), refresh(), is_available(),
-- reason(), deny(), hint_spec(); `active` via set_active(on) (GDScript property setter).

local UITheme = require("./UITheme")
local JutsuGlyph = require("./JutsuGlyph")
local W = require("./Widgets")
local UICtx = require("./UICtx") :: any
local Signal = UITheme.core("Signal")

local _UIRules: any = nil
local function UIRules(): any
	if _UIRules == nil then
		_UIRules = UICtx.mod("UIRules")
	end
	return _UIRules
end

local BuildButton = W.class(W.Button)

function BuildButton.new(c: any, k: string, hk: string)
	local self = setmetatable({}, BuildButton.__mt)
	W.Control._init(self, "TextButton")
	W.Button._init_button(self, "", "GlassButton")
	self.ctx = c
	self.kind = k
	self.gui.Name = "Build_" .. k
	self.hotkey = hk
	self.active = false
	self.icon_px = 28.0
	--- Phones (tray): taller slots with the short name under the icon, since there is no hover.
	self.show_name = false
	self.chosen = Signal.new()
	self._av = { ok = false, locked = true, reason = "", cost = 0 }
	self._owned = 0
	self._flash = 0.0
	self._hint_serial = 0
	self._pressing = false
	self._long = false
	self.flat = true
	self:set_min_size(Vector2.new(54, 60))
	local g = self.gui
	local function text(name: string, z: number): TextLabel
		local t = Instance.new("TextLabel")
		t.Name = name
		t.BackgroundTransparency = 1
		t.BorderSizePixel = 0
		t.AnchorPoint = Vector2.zero
		t.TextYAlignment = Enum.TextYAlignment.Top
		t.ZIndex = z
		t.Active = false
		t.Parent = g
		return t
	end
	local ic = Instance.new("ImageLabel")
	ic.Name = "Glyph"
	ic.BackgroundTransparency = 1
	ic.BorderSizePixel = 0
	ic.AnchorPoint = Vector2.zero
	ic.ScaleType = Enum.ScaleType.Fit
	ic.ZIndex = 4
	ic.Parent = g
	self._glyph = ic
	local lock = Instance.new("ImageLabel")
	lock.Name = "Lock"
	lock.BackgroundTransparency = 1
	lock.BorderSizePixel = 0
	lock.ScaleType = Enum.ScaleType.Fit
	lock.ZIndex = 6
	lock.Visible = false
	lock.Parent = g
	self._lock = lock
	self._cost = text("Cost", 5)
	self._name = text("Name", 5)
	self._hk = text("Hotkey", 5)
	self._own = text("Owned", 5)
	self.pressed:Connect(function()
		self:_on_pressed()
	end)
	self.mouse_entered:Connect(function()
		self:_on_enter()
	end)
	self.mouse_exited:Connect(function()
		self:_on_exit()
	end)
	self.button_down:Connect(function()
		self:_touch_down()
	end)
	self.button_up:Connect(function()
		-- The card stays up until the next tap anywhere (UIInteract hides it).
		self._pressing = false
		self:_redraw()
	end)
	return self
end

function BuildButton.set_active(self, on: boolean)
	self.active = on
	self:_redraw()
end

function BuildButton.set_compact(self, on: boolean, touch: boolean)
	self.show_name = on and touch
	local ms = if on then Vector2.new(46, 46) else Vector2.new(54, 60)
	if touch and not on then
		ms = Vector2.new(56, 62)
	end
	if self.show_name then
		ms = Vector2.new(self.slot_w or 60, 64)
	end
	self:set_min_size(ms)
	self.icon_px = if on then 24.0 else 28.0
	self:_redraw()
end

--- Phone tray: the slot's width when the row is tight (nil: the usual 60).
function BuildButton.set_slot_width(self, w: number?)
	if w == self.slot_w then
		return
	end
	self.slot_w = w
	if self.show_name then
		self:set_min_size(Vector2.new(w or 60, 64))
		self:_redraw()
	end
end

local function av_equal(a, b): boolean
	return a.ok == b.ok
		and a.locked == b.locked
		and a.reason == b.reason
		and a.cost == b.cost
		and a.arsenal == b.arsenal
end

function BuildButton.refresh(self)
	local rules = self.ctx.rules
	if rules == nil then
		return
	end
	local av = rules:availability(self.kind)
	local own = rules:owned(self.kind)
	-- (the reason alone is not drawn, only told by the hint card: "Need 12.3K more gold" changed with
	-- every gold tick and redrew each slot the player could not afford, ~40 writes each, 2026-10-27)
	local old = self._av
	if
		own == self._owned
		and av.ok == old.ok
		and av.locked == old.locked
		and av.cost == old.cost
		and av.arsenal == old.arsenal
		and av.reason ~= old.reason
	then
		old.reason = tostring(av.reason or "")
		return
	end
	if not av_equal(av, self._av) or own ~= self._owned then
		self._av = {
			ok = av.ok == true,
			locked = av.locked == true,
			reason = tostring(av.reason or ""),
			cost = tonumber(av.cost) or 0,
			arsenal = av.arsenal,
		}
		self._owned = own
		self:_redraw()
	end
end

function BuildButton.is_available(self): boolean
	return self._av.ok == true
end

function BuildButton.reason(self): string
	return tostring(self._av.reason or "")
end

--- Short shake + red flash when a disabled slot is used.
function BuildButton.deny(self)
	self._flash = 1.0
	local t = self:create_tween()
	local base = self.position.X
	t:tween_property(self, "position:x", base - 3.0, 0.04)
	t:tween_property(self, "position:x", base + 3.0, 0.06)
	t:tween_property(self, "position:x", base, 0.05)
	self:set_process(true)
end

function BuildButton._process(self, delta: number)
	if self._flash > 0 then
		self._flash = math.max(0, self._flash - delta * 2.5)
		self:_redraw()
	else
		self:set_process(false)
	end
end

function BuildButton._on_pressed(self)
	if self._long then
		self._long = false
		return
	end
	self.ctx:hide_hint(self)
	self.chosen:Fire(self.kind)
end

--- Touch: long-press shows the slot's card (costs, what it does, why it is unavailable).
function BuildButton._touch_down(self)
	self:_redraw()
	if not self.ctx.touch then
		return
	end
	self._pressing = true
	self._long = false
	self._hint_serial += 1
	local serial = self._hint_serial
	W.timer(0.45, function()
		if self._pressing and serial == self._hint_serial and not self._freed then
			self._long = true
			self.ctx:show_hint(self, self:hint_spec(), true)
		end
	end)
end

function BuildButton._on_enter(self)
	self:_redraw()
	self._hint_serial += 1
	local serial = self._hint_serial
	W.timer(0.28, function()
		if self._hover and serial == self._hint_serial and not self._freed then
			self.ctx:show_hint(self, self:hint_spec())
		end
	end)
end

function BuildButton._on_exit(self)
	self._hint_serial += 1
	self._pressing = false
	self:_redraw()
	self.ctx:hide_hint(self)
end

function BuildButton.hint_spec(self): { [string]: any }
	local R = UIRules()
	local c = self._av.cost or 0
	local nuke = R.is_nuke(self.kind)
	local rows: { any } = { { "Cost", if c > 0 then UITheme.fmt_cost(c) .. " gold" else "Free", UITheme.GOLD } }
	if self.kind == "reinforce" then
		local o = self.ctx:my()
		local troops = if o ~= nil
			then UITheme.core("Rules").reinforce_troops(o.troops or 0, o.max_troops or 0)
			else 0
		table.insert(rows, { "Brings", UITheme.fmt_troops(troops) .. " troops", UITheme.TEXT })
	elseif not nuke then
		table.insert(rows, { "Owned", tostring(self._owned), UITheme.TEXT })
	else
		table.insert(rows, { "Blast radius", R.blast_text(self.kind), UITheme.TEXT })
	end
	local item = R.arsenal_item(self.kind)
	if self._av.arsenal ~= nil and item ~= nil then
		-- locked: what unlocks it
		rows = {}
		if item.stars ~= nil then
			table.insert(rows, { "Unlock", UICtx.commas(item.stars) .. " Stars", UITheme.GOLD })
		end
	end
	local spec: { [string]: any } = {
		title = R.TITLES[self.kind] or self.kind,
		badge = if not self.ctx.touch then self.hotkey else "",
		badge_color = UITheme.TEXT_2,
		body = R.blurb(self.kind),
		rows = rows,
	}
	if self._av.arsenal ~= nil then
		spec.hint = "Locked: " .. (if self.ctx.touch then "tap" else "click") .. " to unlock it in the Arsenal"
		spec.hint_color = UITheme.GOLD
		spec.hint_icon = "lock"
	elseif self._av.ok then
		spec.hint = if self.kind == "reinforce"
			then "Click to call them in"
			elseif nuke then "Click, then pick a target"
			else "Click, then choose a spot on your land"
		spec.hint_color = UITheme.CYAN
		spec.hint_icon = "target"
	else
		spec.hint = self:reason()
		spec.hint_color = UITheme.RED
		spec.hint_icon = "info"
	end
	return spec
end

-- Buttons refresh their look from _draw_state (hover / press changes) and _on_geometry.
function BuildButton._draw_state(self)
	self:_redraw()
end

function BuildButton._draw(self)
	self:_redraw()
end

--- A TextLabel positioned by its baseline like Godot draw_string(pos = (x, baseline), width, align).
local function place_text(
	self,
	t: TextLabel,
	x: number,
	baseline: number,
	w: number,
	align,
	size: number,
	weight: number,
	s: string,
	col
)
	local sc = UITheme.scale
	local ts = UITheme.text_size(size)
	t.FontFace = UITheme.font(weight)
	t.TextSize = ts
	t.Text = s
	t.TextXAlignment = align
	local ww = if w > 0 then w else UITheme.measure_text(s, size, weight) + 2
	local top_px = math.floor(baseline * sc + 0.5) - math.floor(ts * UITheme.RBX_BASELINE + 0.5)
	t.Position = UDim2.fromOffset(math.floor(x * sc + 0.5), top_px)
	t.Size = UDim2.fromOffset(math.floor(ww * sc + 0.5), ts)
	t.TextColor3 = UITheme.color3(col)
	t.Visible = true
	self:_part(t, "TextTransparency", UITheme.alpha(col))
end

function BuildButton._redraw(self)
	if self._geo == nil or self.ctx == nil then
		return
	end
	local R = UIRules()
	local size = self.size
	local ok = self._av.ok == true
	local locked = self._av.locked == true
	local arsenal_locked = self._av.arsenal ~= nil
	local nuke = R.is_nuke(self.kind)
	local bg: any = UITheme.rgba(1, 1, 1, 0.035)
	local border: any = UITheme.rgba(1, 1, 1, 0.07)
	if arsenal_locked then
		bg = UITheme.c(UITheme.GOLD, 0.05)
		border = UITheme.c(UITheme.GOLD, 0.28)
	end
	if nuke and ok then
		bg = UITheme.c(UITheme.RED, 0.07)
		border = UITheme.c(UITheme.RED, 0.22)
	end
	if self._hover then
		bg = if not nuke then UITheme.rgba(1, 1, 1, 0.1) else UITheme.c(UITheme.RED, 0.16)
		border = UITheme.LINE_2
	end
	if self.button_pressed or (self._hover and self._down) then
		bg = UITheme.rgba(1, 1, 1, 0.05)
	end
	if self.active then
		bg = UITheme.c(UITheme.AMBER, 0.2)
		border = UITheme.AMBER
	end
	if self._flash > 0 then
		bg = UITheme.lerp(bg, UITheme.c(UITheme.RED, 0.35), self._flash)
		border = UITheme.lerp(border, UITheme.RED, self._flash)
	end
	self._sv:set(UITheme.flat(bg, UITheme.R_MD, border, 1))

	local icol: any = UITheme.TEXT
	if nuke then
		icol = Color3.new(1.0, 0.86, 0.84)
	end
	if not ok then
		icol = UITheme.c(icol, if arsenal_locked then 0.55 elseif locked then 0.2 else 0.5)
	end
	if self.active then
		icol = UITheme.AMBER_HI
	end
	local cy = size.Y * (if size.Y < 50 then 0.4 else 0.42)
	if self.show_name then
		cy = 17.0
	end
	local ip = self.icon_px
	local sc = UITheme.scale
	local g = self._glyph
	if not JutsuGlyph.apply(g, self.kind, 1 - UITheme.alpha(icol)) then
		g.Image = UITheme.icon(self.kind) or ""
	end
	g.ImageColor3 = UITheme.color3(icol)
	self:_part(g, "ImageTransparency", UITheme.alpha(icol))
	local ipx = math.floor(ip * sc + 0.5)
	g.Size = UDim2.fromOffset(ipx, ipx)
	g.Position = UDim2.fromOffset(
		math.floor((size.X * 0.5) * sc + 0.5) - math.floor(ipx / 2),
		math.floor((cy - ip * 0.5) * sc + 0.5)
	)

	local fs = math.max(11, UITheme.min_font_size)
	local c = self._av.cost or 0
	local ctext = if c > 0 then UITheme.fmt_cost(c) elseif c == 0 then "FREE" else "-"
	local ccol: any = UITheme.GOLD
	if locked then
		ccol = UITheme.c(UITheme.TEXT_3, 0.8)
	elseif not ok then
		ccol = UITheme.c(UITheme.RED, 0.95)
	end
	-- a locked Arsenal kind: a gold lock where the cost would be
	local lock = self._lock
	lock.Visible = arsenal_locked
	if arsenal_locked then
		ctext = ""
		local lpx = math.floor(12 * sc + 0.5)
		lock.Image = UITheme.icon("lock") or ""
		lock.ImageColor3 = UITheme.color3(UITheme.GOLD)
		lock.Size = UDim2.fromOffset(lpx, lpx)
		lock.Position = UDim2.fromOffset(
			math.floor(size.X * 0.5 * sc + 0.5) - lpx // 2,
			math.floor((size.Y - (if size.Y < 50 then 4.0 else 6.0)) * sc + 0.5) - lpx
		)
	end
	place_text(
		self,
		self._cost,
		0,
		size.Y - (if size.Y < 50 then 5.0 else 7.0),
		size.X,
		Enum.TextXAlignment.Center,
		fs,
		700,
		ctext,
		ccol
	)
	if self.show_name then
		local ncol = UITheme.c(UITheme.TEXT, if ok then 0.9 else (if locked then 0.45 else 0.7))
		place_text(
			self,
			self._name,
			0,
			42.0,
			size.X,
			Enum.TextXAlignment.Center,
			math.max(12, UITheme.min_font_size),
			600,
			R.SHORT[self.kind] or self.kind,
			ncol
		)
	else
		self._name.Visible = false
	end
	if not self.ctx.touch and self.hotkey ~= "" then
		place_text(
			self,
			self._hk,
			6.0,
			13.0,
			0,
			Enum.TextXAlignment.Left,
			9,
			600,
			self.hotkey,
			UITheme.c(UITheme.TEXT_3, 0.9)
		)
	else
		self._hk.Visible = false
	end
	if self._owned > 0 and not nuke then
		local bfs = if UITheme.min_font_size > 0 then UITheme.min_font_size else 9
		place_text(
			self,
			self._own,
			0,
			4.0 + bfs,
			size.X - 5.0,
			Enum.TextXAlignment.Right,
			bfs,
			600,
			"×" .. tostring(self._owned),
			UITheme.c(UITheme.TEXT_2, 0.9)
		)
	else
		self._own.Visible = false
	end
end

return BuildButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">BusyChip</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/busy_chip.gd (UIBusyChip)
-- Small centred "Deploying a new world…" pill with a spinner, shown while Session builds a match.

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")

local _kit: any = nil
local function kit_assets(): any
	if _kit == nil then
		_kit = {}
		pcall(function()
			local rs = game:GetService("ReplicatedStorage")
			local assets = (rs:WaitForChild("Airfront") :: any):FindFirstChild("Assets")
			local mod = assets and assets:FindFirstChild("UIKit")
			if mod then
				_kit = require(mod) :: any
			end
		end)
	end
	return _kit
end

-- --- Spinner (18 px: faint ring + a rotating amber arc) ------------------------------------------

local Spinner = W.class(W.Control)

function Spinner.new()
	local self = setmetatable({}, Spinner.__mt)
	W.Control._init(self)
	self.t = 0.0
	self:set_min_size(Vector2.new(18, 18))
	self:set_mouse_filter(W.MOUSE_IGNORE)
	local k = kit_assets()
	local function img(id: string?, z: number): ImageLabel
		local i = Instance.new("ImageLabel")
		i.BackgroundTransparency = 1
		i.BorderSizePixel = 0
		i.AnchorPoint = Vector2.new(0.5, 0.5)
		i.Position = UDim2.fromScale(0.5, 0.5)
		i.Size = UDim2.fromScale(1, 1)
		i.Image = id or ""
		i.ZIndex = z
		i.Parent = self.gui
		return i
	end
	self._ring = img(k.spinner_ring, 1)
	self._ring.ImageColor3 = Color3.new(1, 1, 1)
	self:_part(self._ring, "ImageTransparency", 0.14)
	self._arc = img(k.spinner_arc, 2)
	self._arc.ImageColor3 = UITheme.AMBER
	self:_part(self._arc, "ImageTransparency", 1.0)
	return self
end

function Spinner._process(self, delta: number)
	self.t += delta
	self._arc.Rotation = math.deg(self.t * 5.5)
end

-- --- BusyChip -------------------------------------------------------------------------------------------

local BusyChip = W.class(W.Control)
BusyChip.Spinner = Spinner

function BusyChip.new(c: any)
	local self = setmetatable({}, BusyChip.__mt)
	W.Control._init(self)
	self.ctx = c
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._pill = GlassPanel.new(16.0, 9.0, 999, true, 18)
	self._pill:set_mouse_filter(W.MOUSE_IGNORE)
	local h = UITheme.hbox(10)
	self._spin = Spinner.new()
	self._spin.size_flags_vertical = W.SHRINK_CENTER
	h:add_child(self._spin)
	self._label = UITheme.label("", 14, 700, UITheme.TEXT, 1)
	h:add_child(self._label)
	self._pill:add_child(h)
	self:add_child(self._pill)
	self:set_visible(false)
	return self
end

function BusyChip.show_text(self, text: string)
	self._label:set_text(text)
	local p = self._pill
	p.anchor_left, p.anchor_right, p.anchor_top, p.anchor_bottom = 0.5, 0.5, 0.5, 0.5
	p.grow_horizontal = W.GROW_BOTH
	p.grow_vertical = W.GROW_BOTH
	p.offset_left = 0.0
	p.offset_right = 0.0
	p.offset_top = -self.ctx.vp.Y * 0.18
	p.offset_bottom = p.offset_top
	p:reset_size()
	if not self.visible then
		self:set_visible(true)
		self._spin:set_process(true)
		W.pop_in(p, 0.0, 0.94, 0.25)
	end
end

function BusyChip.hide_chip(self)
	if not self.visible then
		return
	end
	self._spin:set_process(false)
	local t = self:create_tween()
	t:tween_property(self, "modulate:a", 0.0, 0.2)
	t:tween_callback(function()
		self:set_visible(false)
		self:set_modulate_a(1.0)
	end)
end

return BusyChip
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">ChestView</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The cosmetic crate's 3D chest in a ViewportFrame (Assets/CrateModel: BedWars' voxel block chest), shared
-- by the opening show (CrateOpening), the title screen's crate button (CrateButton) and the Locker's crate
-- card. build() makes the camera and the parts; pose() places them from a pose table:
--   y (studs), yaw / roll / pitch (radians), sq (squash, + = flat), s (scale), lid (degrees).
-- idle() is the small views' life: a bob, and every `every` seconds a wiggle with the lid cracking.
local IS_ROBLOX = typeof(game) == "Instance"
local Model: any = if IS_ROBLOX
	then require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Assets.CrateModel)
	else (require :: any)("../../shared/Assets/CrateModel")

local ChestView = {}

ChestView.Model = Model
-- the camera (studs): the closed chest takes about 60% of a square viewport's width
ChestView.CAM_FOV = 28
ChestView.CAM_CF = CFrame.lookAt(Vector3.new(0, 6.2, -18), Vector3.new(0, 2.3, 0))
ChestView.BASE_YAW = math.rad(24)
ChestView.AMBIENT = Color3.fromRGB(150, 146, 150)

local function v3(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end
ChestView.v3 = v3

--- A fresh pose (the chest at rest, closed).
function ChestView.rest(): { [string]: number }
	return { y = 0, yaw = 0, roll = 0, pitch = 0, sq = 0, s = 1, lid = 0 }
end

--- The camera and the chest's parts inside `vpf` (its lighting set too). Returns the chest record.
function ChestView.build(vpf: ViewportFrame): any
	vpf.Ambient = ChestView.AMBIENT
	vpf.LightColor = Color3.fromRGB(255, 244, 228)
	vpf.LightDirection = Vector3.new(0.45, -1, 0.55)
	local cam = Instance.new("Camera")
	cam.FieldOfView = ChestView.CAM_FOV
	cam.CFrame = ChestView.CAM_CF
	cam.Parent = vpf
	vpf.CurrentCamera = cam
	local hinge = CFrame.new(v3(Model.hinge))
	local chest = { parts = {}, hinge = hinge, hinge_inv = hinge:Inverse() }
	for _, p in Model.parts do
		local part = Instance.new("Part")
		part.Name = p.name
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Size = v3(p.size)
		part.Color = Color3.fromRGB(163, 162, 165)
		pcall(function()
			part.Material = (Enum.Material :: any)[p.material]
		end)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = p.mesh
		mesh.TextureId = p.tex
		mesh.Scale = v3(p.scale)
		mesh.Parent = part
		part.Parent = vpf
		table.insert(chest.parts, { part = part, mesh = mesh, cf = CFrame.new(table.unpack(p.cf)), lid = p.lid == true, scale = v3(p.scale) })
	end
	return chest
end

function ChestView.root_cf(P: any): CFrame
	return CFrame.new(0, P.y, 0) * CFrame.Angles(0, ChestView.BASE_YAW + P.yaw, 0) * CFrame.Angles(P.pitch, 0, P.roll)
end

--- Place the chest's parts from pose P (squash in the parts' own axes, the lid about its hinge).
function ChestView.pose(chest: any, P: any)
	local sy = (1 - P.sq) * P.s
	local sxz = (1 + P.sq * 0.55) * P.s
	local root = ChestView.root_cf(P)
	local lid = chest.hinge * CFrame.Angles(math.rad(P.lid), 0, 0) * chest.hinge_inv
	for _, rec in chest.parts do
		local rel: CFrame = if rec.lid then lid * rec.cf else rec.cf
		local pos, rot = rel.Position, rel.Rotation
		rec.part.CFrame = root * (CFrame.new(pos.X * sxz, pos.Y * sy, pos.Z * sxz) * rot)
		local ax = math.abs(rot.RightVector.Y) * sy + (1 - math.abs(rot.RightVector.Y)) * sxz
		local ay = math.abs(rot.UpVector.Y) * sy + (1 - math.abs(rot.UpVector.Y)) * sxz
		local az = math.abs(rot.LookVector.Y) * sy + (1 - math.abs(rot.LookVector.Y)) * sxz
		rec.mesh.Scale = rec.scale * Vector3.new(ax, ay, az)
	end
end

--- Viewport px (from its centre, y down) of a chest-space point in pose P, for a square viewport of
--- side `side` px.
function ChestView.project(P: any, p: Vector3, side: number): Vector2
	local c = ChestView.CAM_CF:PointToObjectSpace(ChestView.root_cf(P) * p)
	local th = math.tan(math.rad(ChestView.CAM_FOV / 2))
	local depth = math.max(-c.Z, 0.1)
	local half = side * 0.5
	return Vector2.new(c.X / (depth * th) * half, -c.Y / (depth * th) * half)
end

--- The small views' idle at time t (seconds): a bob, a wiggle with a lid crack every `every` seconds
--- (`strength` 0..1 scales it). Returns how open the lid's crack is (0..1), for a light leak.
function ChestView.idle(P: any, t: number, every: number, strength: number?): number
	local k0 = strength or 1
	P.y = math.sin(t * 2.4) * 0.08
	local phase = t % every
	local k = phase / 0.42
	if k < 1 then
		local wig = math.sin(k * math.pi * 3) * (1 - k) * math.rad(6) * k0
		P.roll = wig
		P.yaw = wig * 0.6
		P.lid = math.sin(k * math.pi) * 8 * k0
		return math.sin(k * math.pi)
	end
	P.roll, P.yaw, P.lid = 0, 0, 0
	return 0
end

return ChestView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="145">
            <Properties>
              <string name="Name">Coach</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/coach.gd (UICoach)
-- First-match coach marks: one short tip at a time with a pulsing arrow to what it talks about
-- (a spot on the globe or a HUD control). Each tip shows once per player; "seen" ids persist in
-- the [ui] settings (tips_seen) and can be reset from the game menu.

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")

local Coach = W.class(W.Control)
local Tut = UICtx.data("Tutorial")
local FLOOR_TIP = string.format(
	"Keep %d%% of your army at home, or neighbours walk right in. In your first %d matches, attacks hold that much back.",
	math.floor(Tut.ROOKIE_FLOOR * 100 + 0.5),
	Tut.ROOKIE_MATCHES
)

--- `again`: shown each time it is offered, not once per player (UIAdvisor paces it).
Coach.TIPS = {
	floor = { icon = "troops", again = true, desktop = FLOOR_TIP, touch = FLOOR_TIP },
	expand = {
		icon = "attack",
		desktop = "Click neutral land next to you to expand. Space does the same under the cursor.",
		touch = "Tap neutral land next to you to expand.",
	},
	ratio = {
		icon = "troops",
		desktop = "The Attack bar sets how many of your troops each click sends. Q / E change it.",
		touch = "Tap a % on the Attack bar to choose how many troops each tap sends.",
	},
	city = {
		icon = "city",
		desktop = "You can afford a City (1). Cities raise your troop cap: place one on your land.",
		touch = "You can afford a City. Open BUILD and place one on your land to raise your troop cap.",
	},
	contact = {
		icon = "alliance",
		desktop = "You now border %s. Click their land to attack, or right-click it to propose an alliance.",
		touch = "You now border %s. Tap their land to size them up, tap again to attack. Long-press for more.",
	},
	boat = {
		icon = "boat",
		desktop = "You reached the sea. Click a distant coast to send a boat invasion.",
		touch = "You reached the sea. Tap a distant coast to send a boat invasion.",
	},
	select = {
		icon = "target",
		desktop = "Target selected. Click it again, or press the big button, to send the order.",
		touch = "Target selected: check their troops, then tap it again or press the big button to attack.",
	},
	tray = {
		icon = "city",
		desktop = "Hover a slot to see what it does.",
		touch = "Hold any slot to see what it does and why it may be locked.",
	},
	attacked = {
		icon = "defense",
		desktop = "You are under attack! Track every front in the Attacks panel. Defense Posts (4) make borders much harder to take.",
		touch = "You are under attack! Track every front in the Attacks panel. Defense Posts make borders much harder to take.",
	},
}
Coach.PRIORITY = { "attacked", "floor", "select", "expand", "contact", "tray", "ratio", "city", "boat" }
Coach.LIFETIME = 16.0
--- Keep-out rects (the YOU label) cost this many times their overlap area, with this margin (px).
Coach.KEEPOUT_WEIGHT = 12.0
Coach.KEEPOUT_MARGIN = 6.0

local function prio(id: string): number
	return table.find(Coach.PRIORITY, id) or 0
end

function Coach.new(c: any)
	local self = setmetatable({}, Coach.__mt)
	W.Control._init(self)
	self.ctx = c
	self.current = ""
	self._target = nil
	self._queue = {}
	self._age = 0.0
	self._t = 0.0
	self._point = Vector2.new(-1, -1)
	self._point_hidden = false
	--- function() -> {Rect}: HUD panels the card should not cover.
	self.blockers = nil
	--- function() -> {Rect}: map content the card must keep clear of (the player's own YOU label):
	--- weighed much higher than panels, never treated as docked panels or hiding the target.
	self.keepout = nil
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	-- Arrow layer (dashed line, head, pulsing ring) under the card.
	self._arrow = UICtx.canvas(self.gui, "CoachArrow")
	self._arrow.ZIndex = 1
	self._dashes = {}
	self._head = UICtx.make("ImageLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(14, 14),
		ImageColor3 = UITheme.AMBER,
		ScaleType = Enum.ScaleType.Stretch,
	}, self._arrow)
	pcall(function()
		local Shapes = require((game:GetService("ReplicatedStorage"):WaitForChild("Airfront") :: any).Assets.UiShapes)
		self._head.Image = Shapes.arrow_head or ""
	end)
	self._pulse = UICtx.ring(self._arrow, Vector2.zero, 8, 2, UITheme.AMBER, 1)
	self._dot = UICtx.circle(self._arrow, Vector2.zero, 4, UITheme.AMBER, 1)
	self._arrow.Visible = false

	local card = GlassPanel.new(14.0, 11.0, UITheme.R_MD, true, 20)
	card:set_accent(UITheme.AMBER)
	card:set_border(UITheme.c(UITheme.AMBER, 0.45))
	card:set_min_size(Vector2.new(320, 0))
	self._card = card
	local h = UITheme.hbox(12)
	card:add_child(h)
	local disc = W.Panel.new()
	self._disc = disc
	disc:set_mouse_filter(W.MOUSE_IGNORE)
	disc:set_min_size(Vector2.new(34, 34))
	disc.size_flags_vertical = W.SHRINK_BEGIN
	disc:add_theme_stylebox_override(
		"panel",
		UITheme.flat(UITheme.c(UITheme.AMBER, 0.16), 17, UITheme.c(UITheme.AMBER, 0.5), 1)
	)
	self._icon = UITheme.icon_rect("info", 17.0, UITheme.AMBER)
	self._icon.size_flags_horizontal = W.SHRINK_CENTER
	self._icon.size_flags_vertical = W.SHRINK_CENTER
	disc:add_child(self._icon)
	h:add_child(disc)
	local v = UITheme.vbox(6)
	v.size_flags_horizontal = W.EXPAND_FILL
	self._v = v
	self._cap = UITheme.caption("Tip", 10, UITheme.AMBER)
	v:add_child(self._cap)
	self._text = UITheme.label("", 13, 500, UITheme.TEXT)
	self._text:set_autowrap(true)
	self._text:set_min_size(Vector2.new(230, 0))
	v:add_child(self._text)
	self._ok = UITheme.button("Got it", "GhostButton", "", 30.0)
	self._ok:set_font_size(12)
	self._ok.size_flags_horizontal = W.SHRINK_END
	self._ok.pressed:Connect(function()
		self:dismiss()
	end)
	v:add_child(self._ok)
	h:add_child(v)
	local x = UITheme.button("", "GhostButton", "close", 44.0)
	x.expand_icon = true
	x.icon_alignment = W.ALIGN_CENTER
	x:add_theme_constant_override("icon_max_width", 12)
	x:set_min_size(Vector2.new(44, 44))
	x.size_flags_vertical = W.SHRINK_CENTER
	x.pressed:Connect(function()
		self:dismiss()
	end)
	x:set_visible(false)
	self._x = x
	h:add_child(x)
	self:add_child(card)
	card:set_visible(false)
	self:set_process(true)
	return self
end

function Coach.apply_layout(self)
	local ctx = self.ctx
	self._ok:set_min_size(Vector2.new(if ctx.touch then 88 else 0, if ctx.touch then 44 else 30))
	if self.current ~= "" then
		self:_place()
	end
end

function Coach.seen(self, id: string): boolean
	local d = self.ctx:setting("tips_seen", {})
	return type(d) == "table" and d[id] == true
end

function Coach._mark_seen(self, id: string)
	local d = self.ctx:setting("tips_seen", {})
	local dict = if type(d) == "table" then table.clone(d) else {}
	dict[id] = true
	self.ctx:set_setting("tips_seen", dict)
end

function Coach.reset(self)
	self.ctx:set_setting("tips_seen", {})
	table.clear(self._queue)
	self:dismiss()
end

--- Queue a tip. `target` returns the screen point to point at (Vector2(-1, -1) = no arrow).
function Coach.offer(self, id: string, target: (() -> Vector2)?, arg: string?)
	-- (the tutorial's steps are the tips while it runs: UI/Tutorial)
	local tip = Coach.TIPS[id]
	if self.muted or tip == nil or id == self.current or (not tip.again and self:seen(id)) then
		return
	end
	for _, q in ipairs(self._queue) do
		if q.id == id then
			return
		end
	end
	table.insert(self._queue, { id = id, target = target, arg = arg or "" })
	table.sort(self._queue, function(a, b)
		return prio(a.id) < prio(b.id)
	end)
	if self.current == "" then
		self:_next()
	end
end

--- The player did what the tip asked: close it (and never offer it again).
function Coach.complete(self, id: string)
	if not self:seen(id) then
		self:_mark_seen(id)
	end
	for i = #self._queue, 1, -1 do
		if self._queue[i].id == id then
			table.remove(self._queue, i)
		end
	end
	if self.current == id then
		self:dismiss()
	end
end

function Coach.dismiss(self)
	if self.current == "" then
		return
	end
	self.current = ""
	self._target = nil
	local t = self._card:create_tween()
	t:tween_property(self._card, "modulate:a", 0.0, 0.2)
	t:tween_callback(function()
		if self.current == "" then
			self._card:set_visible(false)
			self:_draw_arrow()
			self:_next()
		end
	end)
	self:_draw_arrow()
end

function Coach.clear(self)
	table.clear(self._queue)
	self.current = ""
	self._card:set_visible(false)
	self:_draw_arrow()
end

function Coach._next(self)
	if #self._queue == 0 or self.current ~= "" then
		return
	end
	local ctx = self.ctx
	local q = table.remove(self._queue, 1)
	local id = q.id
	local tip = Coach.TIPS[id]
	if not tip.again and self:seen(id) then
		self:_next()
		return
	end
	self.current = id
	self._target = q.target
	local txt = if ctx.touch then tip.touch else tip.desktop
	if string.find(txt, "%s", 1, true) then
		txt = string.format(txt, q.arg)
	end
	self._text:set_text(txt)
	self._icon:set_icon(tip.icon)
	if not tip.again then
		self:_mark_seen(id)
	end
	self._age = 0.0
	local c = ctx.compact
	self._card:set_min_size(Vector2.new(if c then 0 else 320, 0))
	self._text:set_min_size(Vector2.new(if c then 210 else 230, 0))
	self._text:set_font_size(if c then 12 else 13)
	self._cap:set_visible(not c)
	self._ok:set_visible(not c)
	self._x:set_visible(c)
	self._disc:set_min_size(if c then Vector2.new(26, 26) else Vector2.new(34, 34))
	self._disc.size_flags_vertical = if c then W.SHRINK_CENTER else W.SHRINK_BEGIN
	self._icon:set_min_size(if c then Vector2.new(14, 14) else Vector2.new(17, 17))
	self._v.size_flags_vertical = W.SHRINK_CENTER
	self._card:set_padding(
		if c then 10.0 else 14.0,
		if c then 2.0 else 11.0,
		if c then 2.0 else 14.0,
		if c then 2.0 else 11.0
	)
	self._card:set_visible(true)
	self._card:reset_size()
	self:_place()
	UICtx.pop_in(self._card, 0.0, 0.94, 0.35, true)
	ctx:sfx("open", -8.0)
end

function Coach._place(self)
	local ctx = self.ctx
	local vp = ctx.vp
	local ins = ctx.insets
	local sz = self._card:get_combined_minimum_size()
	local blocked = if self.blockers then self.blockers() else {}
	local m = 12.0
	-- Free band for the card: below the top bar, above the panels docked to the bottom edge (the
	-- command bar). On a 361 px phone every spot around a low target overlaps the bar otherwise
	-- (review P1-3; polish over the original, which only weighed overlap).
	local top_lim = 70.0 + ins.y
	local bot_lim = vp.Y - m - ins.w
	for _, b in ipairs(blocked) do
		local docked = b.Max.Y >= vp.Y - ins.w - 40.0 and b.Width >= vp.X * 0.25
		if docked and b.Min.Y - 8.0 - top_lim >= sz.Y then
			bot_lim = math.min(bot_lim, b.Min.Y - 8.0)
		end
	end
	-- A target under a panel (or off the free band) gets no arrow: the card parks in the band.
	local pt = self._point
	local hidden = false
	if pt.X >= 0.0 then
		if pt.Y > bot_lim + m or pt.X < ins.x or pt.X > vp.X - ins.z then
			hidden = true
		else
			for _, b in ipairs(blocked) do
				if UICtx.rect_has_point(b, pt) then
					hidden = true
					break
				end
			end
		end
	end
	self._point_hidden = hidden
	local cands = {}
	if pt.X >= 0.0 and not hidden then
		local gap = 70.0
		table.insert(cands, Vector2.new(pt.X - sz.X * 0.5, pt.Y - sz.Y - gap)) -- above
		table.insert(cands, Vector2.new(pt.X - sz.X - gap, pt.Y - sz.Y * 0.5)) -- left
		table.insert(cands, Vector2.new(pt.X - sz.X * 0.5, pt.Y + gap)) -- below
		table.insert(cands, Vector2.new(pt.X + gap, pt.Y - sz.Y * 0.5)) -- right
	else
		table.insert(cands, Vector2.new((vp.X - sz.X) * 0.5, vp.Y * 0.24))
	end
	-- The player's own label: a card on top of it pushes the YOU label off its land (labels step
	-- around HUD panels), so the card goes beside it (visual review R2-P2-3; polish over the
	-- original, which only weighed the panels).
	local keep = if self.keepout then self.keepout() else nil
	local best = cands[1]
	local best_cost = math.huge
	for i, p in ipairs(cands) do
		local x = math.clamp(p.X, m + ins.x, math.max(m + ins.x, vp.X - sz.X - m - ins.z))
		local y = math.clamp(p.Y, top_lim, math.max(top_lim, bot_lim - sz.Y))
		local r = UICtx.rect_ps(Vector2.new(x, y), sz)
		local cost = (i - 1) * 400.0
		for _, b in ipairs(blocked) do
			cost += UICtx.rect_intersection_area(r, b)
		end
		if keep ~= nil then
			for _, b in ipairs(keep) do
				cost += UICtx.rect_intersection_area(UICtx.rect_grow(r, Coach.KEEPOUT_MARGIN), b) * Coach.KEEPOUT_WEIGHT
			end
		end
		if pt.X >= 0.0 and not hidden and UICtx.rect_has_point(UICtx.rect_grow(r, 8.0), pt) then
			cost += 1e6
		end
		if cost < best_cost then
			best_cost = cost
			best = Vector2.new(x, y)
		end
	end
	local cur = Vector2.new(self._card.offset_left, self._card.offset_top)
	local p = if self._card.modulate_a > 0.5 then cur:Lerp(best, 0.25) else best
	if (p - best).Magnitude < 0.25 then
		p = best
	end
	UICtx.move_node(self._card, p)
end

function Coach._process(self, delta: number)
	if self.current == "" then
		return
	end
	self._t += delta
	self._age += delta
	if self._age > (if self.ctx.compact then Coach.LIFETIME * 0.65 else Coach.LIFETIME) then
		self:dismiss()
		return
	end
	local p = Vector2.new(-1, -1)
	if self._target ~= nil then
		local ok, v = pcall(self._target)
		if ok and typeof(v) == "Vector2" then
			p = v
		end
	end
	self._point = p
	self:_place()
	self:_draw_arrow()
end

--- Dashed line from the card to the target, an arrow head and a pulsing ring (GDScript _draw).
function Coach._draw_arrow(self)
	local arrow = self._arrow
	local card = self._card
	if self.current == "" or self._point.X < 0.0 or self._point_hidden or not card.visible then
		arrow.Visible = false
		return
	end
	-- The whole coach fades while the player aims / uses the radial menu (UIRoot sets its alpha).
	local a = card.modulate_a * (self._eff_a or 1.0)
	if a <= 0.001 then
		arrow.Visible = false
		return
	end
	local r = card:get_global_rect()
	local to = self._point
	local from = Vector2.new(
		math.clamp(to.X, r.Min.X + 18.0, math.max(r.Min.X + 18.0, r.Max.X - 18.0)),
		if to.Y > r.Max.Y then r.Max.Y else r.Min.Y
	)
	local dirv = to - from
	local dist = dirv.Magnitude
	if dist < 24.0 then
		arrow.Visible = false
		return
	end
	self.ctx:fit_canvas(arrow)
	arrow.Visible = true
	local dir = dirv / dist
	local ang = math.deg(math.atan2(dir.Y, dir.X))
	-- Dashed line: 8 px dashes every 14.4 px, 2 px wide.
	local dash = 8.0
	local d = 0.0
	local n = 0
	while d < dist - 16.0 do
		n += 1
		local s0 = from + dir * d
		local s1 = from + dir * math.min(d + dash, dist - 16.0)
		local seg = self._dashes[n]
		if seg == nil then
			seg = UICtx.make("Frame", {
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = UITheme.AMBER,
			}, arrow)
			UICtx.make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, seg)
			self._dashes[n] = seg
		end
		local len = (s1 - s0).Magnitude
		local mid = (s0 + s1) * 0.5
		seg.Visible = true
		seg.Position = UDim2.fromOffset(mid.X, mid.Y)
		seg.Size = UDim2.fromOffset(len, 2)
		seg.Rotation = ang
		seg.BackgroundTransparency = 1 - 0.9 * a
		d += dash * 1.8
	end
	for i = n + 1, #self._dashes do
		self._dashes[i].Visible = false
	end
	-- Arrow head: the 14x14 triangle mask spans tip +10 .. base -4 along the direction.
	local tip_base = to - dir * 16.0
	local centre = tip_base + dir * 3.0
	self._head.Position = UDim2.fromOffset(centre.X, centre.Y)
	self._head.Rotation = ang
	self._head.ImageTransparency = 1 - 0.9 * a
	-- Pulsing ring on the target
	local k = (self._t % 1.2) / 1.2
	UICtx.set_circle(self._pulse, to, 8.0 + 18.0 * k);
	(self._pulse:FindFirstChild("Stroke") :: UIStroke).Transparency = 1 - (1.0 - k) * 0.9 * a
	UICtx.set_circle(self._dot, to, 4.0)
	self._dot.BackgroundTransparency = 1 - a
end

return Coach
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="146">
            <Properties>
              <string name="Name">CommandBar</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/command_bar.gd (UICommandBar)
-- Bottom command bar: nation chip, troops (with cap, growth and fill), the attack-ratio slider, gold
-- (with income, next to the slots it buys) and the ten build / nuke slots. Re-flows between a single
-- row (wide desktop), two rows (laptop / tablet) and a slim phone strip (icons + numbers, a short
-- slider and a Build toggle; the slots live in a tray and the details in a tap-for-info card).
--
-- The Arsenal (Data/Arsenal; 2026-10-04): one gold SHOP slot closes the row and opens the
-- Arsenal; a kind the player has unlocked gets a slot of its own before it, a locked one has none
-- (2026-10-04: the build menu was too big, so only the SHOP button shows and it all stays on one
-- row; the first version had a second row of eight locked slots). The SHOP slot is one gold button
-- that shows, in turn, what the player has yet to get (ShopSlot; 2026-10-12: one button instead of
-- six sub-buttons, the locked units' cards it held from 2026-10-05). On phones the slots
-- narrow a little, then the SHOP button, before the tray takes a second row (TrayFit).
--
-- Signals: build_chosen(kind), cancel_placement(), footprint_changed(), stats_tapped(),
-- arsenal_wanted(key?, from?) (the SHOP button; key: the item it showed).
-- Members read by UIRoot / UIInteract: panel, tray, buttons, _place_chip, _slider, _tray_btn, _flow.
-- Per frame: update(dt) (GDScript _process).

local UICtx = require("./UICtx") :: any
local UITheme = require("./UITheme")
local HudArt = require("./HudArt")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local FillBar = require("./FillBar")
local CountLabel = require("./CountLabel")
local RatioSlider = require("./RatioSlider")
local BuildButton = require("./BuildButton")
local ShopSlot = require("./ShopSlot")
local TrayFit = require("./TrayFit")
local Signal = UITheme.core("Signal")

local _UIRules: any = nil
local function UIRules(): any
	if _UIRules == nil then
		_UIRules = UICtx.mod("UIRules")
	end
	return _UIRules
end

local CommandBar = W.class(W.Control)

CommandBar.Flow = { WIDE = 0, STACKED = 1, COMPACT = 2 }
--- Phone tray: a slot is never narrower than this (then the tray takes a second row).
CommandBar.TRAY_SLOT_MIN = TrayFit.SLOT_MIN
--- The SHOP slot outside the phone tray, with nothing locked to show.
CommandBar.SHOP_W = 58.0
--- Phones: the width of one stop of the Attack bar (a finger's target; the strip is 44 tall).
CommandBar.STOP_TOUCH_W = 38.0
local WIDE, STACKED, COMPACT = 0, 1, 2

local function spacer()
	local sp = W.Control.new()
	sp.size_flags_horizontal = W.EXPAND_FILL
	sp:set_mouse_filter(W.MOUSE_IGNORE)
	return sp
end

function CommandBar.new(c: any)
	local self = setmetatable({}, CommandBar.__mt)
	W.Control._init(self)
	self.ctx = c
	self.build_chosen = Signal.new()
	self.cancel_placement = Signal.new()
	--- The bar's footprint changed (tray opened/closed, placement chip shown/hidden).
	self.footprint_changed = Signal.new()
	--- Phone strip: the troops / gold numbers were tapped (show the details card).
	self.stats_tapped = Signal.new()
	--- The SHOP slot was pressed (key: the locked item whose card was, nil for the slot itself).
	self.arsenal_wanted = Signal.new()
	--- The row gained or lost a slot (an Arsenal kind was unlocked).
	self.slots_changed = Signal.new()
	--- the Arsenal kinds with a slot (the unlocked ones), as last arranged: "artillery,mega"
	self._arsenal_sig = ""
	self.buttons = {} -- kind -> BuildButton
	self._flow = -1
	self._root_box = nil
	self._tray_open = false
	self._placing = ""
	self._rate = 0.0
	--- Whether the troop rate is rising, and the last rate seen (see sample_growth).
	self._rate_up = true
	self._last_growth = nil :: number?
	self._poll = 0.0
	self._buttons_dirty = true
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self.panel = GlassPanel.new(18.0, 12.0, UITheme.R_LG, true, 22)
	self:add_child(self.panel)
	self:_build_sections()
	self:_connect(c.ratio_changed:Connect(function(_r)
		self:_refresh_ratio()
	end))
	return self
end

function CommandBar.apply_scroll_art(self)
	local panel = self.panel
	local scroll = HudArt.add(panel.gui, "scroll", 2)
	if scroll == nil then return end
	scroll.AnchorPoint = Vector2.new(0.5, 0.5)
	scroll.Position = UDim2.fromScale(0.5, 0.5)
	scroll.Size = UDim2.fromScale(1.015, 1.11)
	local backing = Instance.new("Frame")
	backing.Name = "ControlContrast"
	backing.BackgroundColor3 = Color3.fromRGB(35, 15, 20)
	backing.BackgroundTransparency = 0.48
	backing.BorderSizePixel = 0
	backing.Active = false
	backing.Interactable = false
	backing.AnchorPoint = Vector2.new(0.5, 0.5)
	backing.Position = UDim2.fromScale(0.5, 0.5)
	backing.Size = UDim2.fromScale(0.91, 0.72)
	backing.ZIndex = 3
	local corners = Instance.new("UICorner")
	corners.CornerRadius = UDim.new(0, 9)
	corners.Parent = backing
	backing.Parent = panel.gui
	panel._shadow_size = 0
	panel._shadow:set(UITheme.empty_box())
	panel:set_tint(UITheme.CLEAR)
	panel:set_border(UITheme.CLEAR)
	panel:set_sheen(false)
	panel:set_accent(UITheme.CLEAR)
end

function CommandBar._build_sections(self)
	local T = UITheme
	local ctx = self.ctx
	-- Nation chip
	self._nation = T.hbox(10)
	self._swatch = T.swatch(T.AMBER, 14.0, 4)
	self._nation:add_child(self._swatch)
	local nv = T.vbox(0)
	nv.size_flags_vertical = W.SHRINK_CENTER
	local name_row = T.hbox(6)
	self._name = T.label("Commander", 15, 700)
	self._name.text_overrun_behavior = W.OVERRUN_ELLIPSIS
	self._name:set_min_size(Vector2.new(96, 0))
	self._name.size_flags_horizontal = W.EXPAND_FILL
	name_row:add_child(self._name)
	self._crown = T.icon_rect("crown", 14.0, T.GOLD)
	self._crown:set_modulate_a(0.0)
	name_row:add_child(self._crown)
	nv:add_child(name_row)
	self._land = T.label("0.0% of the world", 12, 500, T.TEXT_2)
	nv:add_child(self._land)
	self._nation:add_child(nv)
	self._nation:set_min_size(Vector2.new(150, 0))

	-- Troops
	self._troops_box = T.vbox(3)
	local tr = T.hbox(6)
	tr:add_child(T.icon_rect("troops", 12.0, T.TEXT_3))
	tr:add_child(T.caption("Troops"))
	tr:add_child(spacer())
	self._growth = T.label("+0/s", 11, 700, T.GREEN)
	tr:add_child(self._growth)
	self._troops_box:add_child(tr)
	local tv = T.hbox(5)
	self._troops = CountLabel.new(20, 700, T.TEXT, T.fmt_troops)
	tv:add_child(self._troops)
	self._troops_cap = T.label("/ 0", 13, 500, T.TEXT_3)
	self._troops_cap.size_flags_vertical = W.SHRINK_END
	tv:add_child(self._troops_cap)
	self._troops_box:add_child(tv)
	local brow = T.hbox(6)
	self._troops_bar = FillBar.new(4.0, T.CYAN)
	self._troops_bar:set_min_size(Vector2.new(40, 8))
	self._troops_bar.size_flags_horizontal = W.EXPAND_FILL
	self._troops_bar.size_flags_vertical = W.SHRINK_CENTER
	brow:add_child(self._troops_bar)
	-- Troops committed to attacks: space is always reserved, so showing it never moves anything.
	self._committed = T.label("", 11, 700, T.ORANGE)
	self._committed:set_modulate_a(0.0)
	brow:add_child(self._committed)
	self._troops_box:add_child(brow)
	self._troops_box:set_min_size(Vector2.new(158, 0))

	-- Gold (same shape as troops: caption row carries the rate, the value sits below)
	self._gold_box = T.vbox(3)
	local gr = T.hbox(6)
	gr:add_child(T.icon_rect("gold", 12.0, T.TEXT_3))
	gr:add_child(T.caption("Gold"))
	gr:add_child(spacer())
	self._income = T.label("+0/s", 11, 700, T.GREEN)
	gr:add_child(self._income)
	self._gold_box:add_child(gr)
	local gv = T.hbox(6)
	self._gold = CountLabel.new(20, 700, T.GOLD, T.fmt_num)
	gv:add_child(self._gold)
	self._gold_box:add_child(gv)
	self._gold_box:set_min_size(Vector2.new(118, 0))

	-- Attack ratio
	self._ratio_box = T.vbox(2)
	local rr = T.hbox(6)
	rr:add_child(T.icon_rect("attack", 12.0, T.TEXT_3))
	rr:add_child(T.caption("Attack"))
	rr:add_child(spacer())
	self._ratio_pct = T.label("35%", 13, 800, T.AMBER)
	rr:add_child(self._ratio_pct)
	self._ratio_head = rr
	self._ratio_box:add_child(rr)
	local line = T.hbox(8)
	self._slider = RatioSlider.new(ctx)
	self._slider.size_flags_horizontal = W.EXPAND_FILL
	line:add_child(self._slider)
	-- (the phone strip's readout: "Sends" over the troops an order sends now. The share itself is
	-- the stop lit on the bar; until the bar had stops this line read "35%".)
	self._ratio_inline = T.label("Sends", 12, 600, T.TEXT_3)
	self._ratio_inline.size_flags_vertical = W.SHRINK_CENTER
	self._ratio_inline:set_min_size(Vector2.new(40, 0))
	self._ratio_inline.horizontal_alignment = W.ALIGN_RIGHT
	self._ratio_inline:set_visible(false)
	self._ratio_inline_box = T.vbox(0)
	self._ratio_inline_box.size_flags_vertical = W.SHRINK_CENTER
	self._ratio_inline_box:add_child(self._ratio_inline)
	self._ratio_sends = T.label("", 13, 700, T.TEXT)
	self._ratio_sends.horizontal_alignment = W.ALIGN_RIGHT
	self._ratio_inline_box:add_child(self._ratio_sends)
	line:add_child(self._ratio_inline_box)
	self._ratio_line = line
	self._ratio_box:add_child(line)
	self._ratio_sub = T.label("Sends 0 troops", 11, 500, T.TEXT_3)
	self._ratio_box:add_child(self._ratio_sub)
	self._ratio_box:set_min_size(Vector2.new(176, 0))
	self._ratio_box:set_mouse_filter(W.MOUSE_PASS)

	-- Phone strip: troops and gold as icon + number inside one flat button (tap = details card).
	self._m_stats = W.Button.new("", "GhostButton")
	self._m_stats:set_flat(true)
	for _, st in ipairs(W.BUTTON_STATES) do
		self._m_stats:add_theme_stylebox_override(st, T.empty_box())
	end
	self._m_stats.pressed:Connect(function()
		self.stats_tapped:Fire()
	end)
	self._m_stats.button_down:Connect(function()
		self._m_stats:set_modulate_a(0.7)
	end)
	self._m_stats.button_up:Connect(function()
		self._m_stats:set_modulate_a(1.0)
	end)
	self._m_stats_box = T.hbox(10)
	self._m_stats_box:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._m_stats_box:set_alignment(W.ALIGN_CENTER)
	local mt = T.vbox(1)
	mt.size_flags_vertical = W.SHRINK_CENTER
	local mth = T.hbox(5)
	local ti = T.icon_rect("troops", 14.0, T.TEXT_2)
	ti.size_flags_vertical = W.SHRINK_CENTER
	mth:add_child(ti)
	self._m_troops = CountLabel.new(15, 700, T.TEXT, T.fmt_troops)
	mth:add_child(self._m_troops)
	-- the troop rate, coloured like the desktop label (green while it isn't falling,
	-- orange once it is) — players time their attacks by it
	self._m_growth = T.label("+0/s", 12, 700, T.GREEN)
	self._m_growth.size_flags_vertical = W.SHRINK_CENTER
	mth:add_child(self._m_growth)
	mt:add_child(mth)
	self._m_troops_bar = FillBar.new(3.0, T.CYAN)
	self._m_troops_bar.glow = false
	self._m_troops_bar:set_min_size(Vector2.new(40, 3))
	mt:add_child(self._m_troops_bar)
	self._m_stats_box:add_child(mt)
	local mgh = T.hbox(5)
	mgh.size_flags_vertical = W.SHRINK_CENTER
	local gi = T.icon_rect("gold", 14.0, T.GOLD)
	gi.size_flags_vertical = W.SHRINK_CENTER
	mgh:add_child(gi)
	self._m_gold = CountLabel.new(15, 700, T.GOLD, T.fmt_num)
	mgh:add_child(self._m_gold)
	self._m_stats_box:add_child(mgh)
	self._m_stats:add_child(self._m_stats_box)
	self._m_ratio = T.hbox(6)
	self._m_ratio.size_flags_vertical = W.SHRINK_CENTER

	-- Build slots
	self._builds = T.hbox(4)
	self._builds2 = T.hbox(8)
	self._builds2:set_alignment(W.ALIGN_CENTER)
	self._tray_v = T.vbox(8)
	local R = UIRules()
	for i, k in ipairs(R.ACTIONS) do
		if k == "atom" then
			self._nuke_div = T.vdivider(40.0)
			local wrap = W.Margin.new()
			wrap:set_mouse_filter(W.MOUSE_IGNORE)
			wrap:add_theme_constant_override("margin_left", 6)
			wrap:add_theme_constant_override("margin_right", 6)
			wrap:add_child(self._nuke_div)
			self._nuke_wrap = wrap
			self._builds:add_child(wrap)
		end
		local b = BuildButton.new(ctx, k, R.HOTKEYS[i])
		b.chosen:Connect(function(kind: string)
			self.build_chosen:Fire(kind)
		end)
		self.buttons[k] = b
		self._builds:add_child(b)
	end

	-- The Arsenal: a slot for each of its kinds (in the row only once unlocked, see _arrange_slots)
	-- and the gold SHOP slot that closes the row
	for _, k in ipairs(R.ARSENAL) do
		local b = BuildButton.new(ctx, k, "")
		b.chosen:Connect(function(kind: string)
			self.build_chosen:Fire(kind)
		end)
		self.buttons[k] = b
	end
	local shop = ShopSlot.new(ctx)
	shop.wanted:Connect(function(key: string?, from: string?)
		self.arsenal_wanted:Fire(key, from)
	end)
	self._shop = shop
	self._arsenal_wrap = W.Margin.new()
	self._arsenal_wrap:set_mouse_filter(W.MOUSE_IGNORE)
	self._arsenal_wrap:add_theme_constant_override("margin_left", 6)
	self._arsenal_wrap:add_child(shop)
	self._builds:add_child(self._arsenal_wrap)

	-- Phone tray + toggle, and the touch placement chip.
	self.tray = GlassPanel.new(10.0, 8.0, T.R_LG, true, 18)
	self.tray:set_visible(false)
	self:add_child(self.tray)
	local tb = W.Button.new("BUILD", "GlassButton")
	tb.toggle_mode = true
	tb:set_icon("city")
	tb:add_theme_constant_override("icon_max_width", 18)
	tb:set_font_size(13)
	tb:set_min_size(Vector2.new(88, 44))
	tb:add_theme_stylebox_override("pressed", T.flat(T.c(T.AMBER, 0.22), T.R_MD, T.AMBER, 1, 12.0, 8.0))
	tb:add_theme_stylebox_override("hover_pressed", T.flat(T.c(T.AMBER, 0.28), T.R_MD, T.AMBER, 1, 12.0, 8.0))
	tb:add_theme_color_override("font_pressed_color", T.AMBER_HI)
	tb:add_theme_color_override("icon_pressed_color", T.AMBER_HI)
	tb.toggled:Connect(function(on: boolean)
		self:set_tray(on)
	end)
	self._tray_btn = tb
	self._place_chip = GlassPanel.new(14.0, 6.0, 999, true, 16)
	self._place_chip:set_visible(false)
	local pc = T.hbox(10)
	local pic = T.icon_rect("target", 16.0, T.AMBER)
	pic.size_flags_vertical = W.SHRINK_CENTER
	pc:add_child(pic)
	self._place_text = T.label("", 13, 600)
	self._place_text.size_flags_vertical = W.SHRINK_CENTER
	pc:add_child(self._place_text)
	local cancel = T.button("Cancel", "GlassButton", "close", 44.0)
	cancel:set_font_size(13)
	cancel:add_theme_constant_override("icon_max_width", 12)
	cancel.pressed:Connect(function()
		self.cancel_placement:Fire()
	end)
	pc:add_child(cancel)
	self._place_chip:add_child(pc)
	self:add_child(self._place_chip)
end

-- ---------------------------------------------------------------------------------------------
-- Layout
-- ---------------------------------------------------------------------------------------------

function CommandBar.apply_layout(self)
	local ctx = self.ctx
	local flow = WIDE
	if ctx.compact then
		flow = COMPACT
	elseif not ctx.wide then
		flow = STACKED
	end
	if flow ~= self._flow then
		self._flow = flow
		self:_reflow()
	end
	local bottom = if not ctx.compact then 12.0 + ctx.insets.w else math.max(6.0, ctx.insets.w)
	self:_anchor_bottom_center(self.panel, bottom)
	-- Tray and placement chip sit just above the bar.
	local above = bottom + self.panel:get_combined_minimum_size().Y + 8.0
	self:_anchor_bottom_center(self.tray, above)
	local chip = self._place_chip
	if ctx.compact then
		-- Phones: the placement hint sits top-left under the top bar, clear of the globe's centre.
		chip.anchor_left, chip.anchor_right, chip.anchor_top, chip.anchor_bottom = 0, 0, 0, 0
		chip.grow_horizontal = W.GROW_END
		chip.grow_vertical = W.GROW_END
		chip.offset_left = ctx.insets.x + 12.0
		chip.offset_right = chip.offset_left
		chip.offset_top = ctx.reserved_top_left.Max.Y + 6.0
		chip.offset_bottom = chip.offset_top
		chip:set_padding(12.0, 0.0, 0.0, 0.0)
		chip:reset_size()
	else
		chip:set_padding(14.0, 6.0, 14.0, 6.0)
		self:_anchor_bottom_center(chip, above)
	end
end

function CommandBar._anchor_bottom_center(_self, c, bottom: number)
	c.anchor_left, c.anchor_right, c.anchor_top, c.anchor_bottom = 0.5, 0.5, 1.0, 1.0
	c.grow_horizontal = W.GROW_BOTH
	c.grow_vertical = W.GROW_BEGIN
	c.offset_left = 0.0
	c.offset_right = 0.0
	c.offset_top = -bottom
	c.offset_bottom = -bottom
	c:reset_size()
end

--- Every value in the bar sits in a box sized for its widest possible text (tabular digits), and
--- labels clip rather than grow, so the bar never changes size or shifts as numbers change.
function CommandBar._apply_fixed_widths(self, compact: boolean)
	local T = UITheme
	local small = math.max(11, T.min_font_size)
	local vf = if compact then 17 else 20
	local cf = math.max(if compact then 12 else 13, T.min_font_size)
	for _, l in ipairs({ self._growth, self._income, self._committed, self._ratio_sub }) do
		l:set_font_size(small)
	end
	self._troops_cap:set_font_size(cf)
	local w_val = T.text_width("888.8M", vf, 700) + 2.0
	local w_gold = T.text_width("8888.8M", vf, 700) + 2.0
	local w_cap = T.text_width("/ 888.8M", cf, 500) + 2.0
	local w_rate = T.text_width("+888.8K/s", small, 700) + 2.0
	local w_war = T.text_width("888.8M at war", small, 700) + 2.0
	T.fix_width(self._troops, w_val, W.ALIGN_RIGHT)
	T.fix_width(self._troops_cap, w_cap)
	T.fix_width(self._growth, w_rate, W.ALIGN_RIGHT)
	T.fix_width(self._committed, w_war, W.ALIGN_RIGHT)
	T.fix_width(self._gold, w_gold)
	T.fix_width(self._income, w_rate, W.ALIGN_RIGHT)
	local cap_troops = T.text_width("TROOPS", small, 700) + 6.0
	local cap_gold = T.text_width("GOLD", small, 700) + 4.0
	local troops_w = math.max(w_val + 5.0 + w_cap, 12.0 + 6.0 + cap_troops + 8.0 + w_rate)
	troops_w = math.max(troops_w, 40.0 + 6.0 + w_war)
	self._troops_box:set_min_size(Vector2.new(troops_w, 0))
	self._gold_box:set_min_size(Vector2.new(math.max(w_gold, 12.0 + 6.0 + cap_gold + 8.0 + w_rate), 0))
	local pct_w = T.text_width("100%", 13, 800) + 2.0
	T.fix_width(self._ratio_pct, pct_w, W.ALIGN_RIGHT)
	local inline_w = math.max(T.text_width("Sends", 12, 600), T.text_width("888.8K", 13, 700)) + 2.0
	T.fix_width(self._ratio_inline, inline_w, W.ALIGN_RIGHT)
	T.fix_width(self._ratio_sends, inline_w, W.ALIGN_RIGHT)
	local ratio_w = if compact then 188.0 else 180.0
	self._ratio_box:set_min_size(Vector2.new(ratio_w, 0))
	T.fix_width(self._ratio_sub, ratio_w, W.ALIGN_LEFT, false)
	-- Phone strip numbers: fixed boxes too.
	T.fix_width(self._m_troops, T.text_width("888.8M", 15, 700) + 2.0, W.ALIGN_LEFT)
	T.fix_width(self._m_growth, T.text_width("+888.8K/s", 12, 700) + 2.0, W.ALIGN_LEFT)
	T.fix_width(self._m_gold, T.text_width("888.8M", 15, 700) + 2.0, W.ALIGN_LEFT)
	local name_w = if compact then 84.0 else 118.0
	T.fix_width(self._name, name_w, W.ALIGN_LEFT, false)
	T.fix_width(self._land, name_w + 20.0, W.ALIGN_LEFT, false)
	self._nation:set_min_size(Vector2.new(name_w + 20.0 + 24.0, 0))
end

--- Screen y of the bar's top edge (for stacking the event feed above it).
function CommandBar.top_edge(self): number
	local ctx = self.ctx
	if not (self.panel.visible and self.visible) then
		return ctx.vp.Y - ctx.insets.w
	end
	local y = self.panel:get_position().Y
	if self.tray.visible then
		y = math.min(y, self.tray:get_position().Y)
	end
	if self._place_chip.visible and not ctx.compact then
		y = math.min(y, self._place_chip:get_position().Y)
	end
	return y
end

--- The bar's own top edge, without the build tray or the placement chip: the map's HUD-free band
--- (UILayoutProbe.update_world_safe_area) uses it, so opening the tray never moves the camera
--- (2026-09-29: before, the band shrank and the view slid up).
function CommandBar.base_edge(self): number
	local ctx = self.ctx
	if not (self.panel.visible and self.visible) then
		return ctx.vp.Y - ctx.insets.w
	end
	return self.panel:get_position().Y
end

--- Phone: show / hide the build tray.
function CommandBar.set_tray(self, on: boolean)
	local ctx = self.ctx
	if self._flow ~= COMPACT then
		on = false
	end
	self._tray_open = on
	self._tray_btn:set_pressed_no_signal(on)
	if self._tray_caption ~= nil then
		UITheme.set_font_color(self._tray_caption, if on then UITheme.AMBER_HI else UITheme.TEXT)
	end
	if on == self.tray.visible then
		return
	end
	if on then
		self.tray:set_visible(true)
		self:refresh_buttons()
		W.pop_in(self.tray, 0.0, 0.94, 0.25)
		ctx:sfx("open", -8.0)
		if ctx.coach ~= nil and ctx.touch then
			ctx.coach:offer("tray", function(): Vector2
				local b = self.buttons["city"]
				if b:is_visible_in_tree() then
					local r = b:get_global_rect()
					return Vector2.new((r.Min.X + r.Max.X) * 0.5, (r.Min.Y + r.Max.Y) * 0.5)
				end
				return Vector2.new(-1, -1)
			end)
		end
	else
		self.tray:set_visible(false)
	end
	self.footprint_changed:Fire()
end

--- The Arsenal kinds the player has unlocked, in slot order.
function CommandBar._unlocked_arsenal(self): { string }
	local out = {}
	local rules = self.ctx.rules
	for _, k in ipairs(UIRules().ARSENAL) do
		if rules ~= nil and not rules:arsenal_locked(k) then
			table.insert(out, k)
		end
	end
	return out
end

--- What the single-row bar holds beyond its ten slots, in px: SHOP (wider while there is anything to get)
--- and a slot per unlocked Arsenal kind. UIRoot: how wide the screen must be for the wide flow.
function CommandBar.extra_width(self): number
	local shop = math.max(CommandBar.SHOP_W, TrayFit.shop_width(#self._shop:locked()))
	return 62.0 * #self:_unlocked_arsenal() + shop + 4.0
end

--- Placement feedback: highlights the slot and, on touch, shows "Tap your land… · Cancel".
function CommandBar.set_placing(self, kind: string)
	local ctx = self.ctx
	local R = UIRules()
	self._placing = kind
	self:set_active(kind)
	if kind ~= "" then
		self:set_tray(false)
	end
	local show = kind ~= "" and ctx.touch
	if show then
		local t = R.SHORT[kind] or kind
		local txt = if R.is_nuke(kind)
			then "Tap a target, then ✓ to launch"
			else string.format("Tap your land, then ✓ to build the %s", t)
		if kind == "warship" then
			txt = "Tap water near your port, then ✓"
		end
		self._place_text:set_text(txt)
	end
	local was = self._place_chip.visible
	self._place_chip:set_visible(show)
	if show and not was then
		self._place_chip:reset_size()
		W.pop_in(self._place_chip, 0.0, 0.94, 0.25)
	end
end

--- Nuke slots live either at the end of the build row or on their own second row. The unlocked
--- Arsenal kinds follow them, and the SHOP slot closes whichever row they are in.
function CommandBar._arrange_slots(self, two_rows: boolean)
	local nukes = { self.buttons["atom"], self.buttons["hydrogen"], self.buttons["mirv"] }
	for _, n in ipairs(nukes) do
		self:_detach(n)
	end
	self:_detach(self._nuke_wrap)
	self:_detach(self._arsenal_wrap)
	for _, k in ipairs(UIRules().ARSENAL) do
		self:_detach(self.buttons[k])
	end
	local unlocked = self:_unlocked_arsenal()
	self._arsenal_sig = table.concat(unlocked, ",")
	local row = self._builds
	if two_rows then
		row = self._builds2
	else
		self._builds:add_child(self._nuke_wrap)
	end
	for _, n in ipairs(nukes) do
		row:add_child(n)
	end
	for _, k in ipairs(unlocked) do
		row:add_child(self.buttons[k])
	end
	row:add_child(self._arsenal_wrap)
end

function CommandBar._detach(_self, c)
	if c ~= nil and c.parent ~= nil then
		c.parent:remove_child(c)
	end
end

function CommandBar._reflow(self)
	local T = UITheme
	local ctx = self.ctx
	for _, c in ipairs({
		self._nation,
		self._troops_box,
		self._gold_box,
		self._ratio_box,
		self._builds,
		self._builds2,
		self._tray_btn,
		self._tray_v,
		self._m_stats,
		self._m_ratio,
	}) do
		self:_detach(c)
	end
	-- The slider and its % / sends readout live in the ratio box, or in the phone strip.
	self:_detach(self._slider)
	self:_detach(self._ratio_inline_box)
	local strip_host = if self._flow == COMPACT then self._m_ratio else self._ratio_line
	strip_host:add_child(self._slider)
	strip_host:add_child(self._ratio_inline_box)
	self:_arrange_slots(false)
	self._shop:refresh()
	local shop_want = TrayFit.shop_width(#self._shop:locked())
	if self._root_box ~= nil then
		self.panel:remove_child(self._root_box)
		self._root_box:queue_free()
		self._root_box = nil
	end
	local compact = self._flow == COMPACT
	for _, b in pairs(self.buttons) do
		b:set_compact(compact, ctx.touch)
	end
	self._builds:set_separation(if ctx.touch then 8 else 4)
	self._troops:set_font_size(if compact then 17 else 20)
	self._gold:set_font_size(if compact then 17 else 20)
	self._name:set_font_size(if compact then 13 else 15)
	self:_apply_fixed_widths(compact)
	local ratio_w = self._ratio_box.custom_minimum_size.X
	-- The Attack bar: five stops. Under a finger each is a target STOP_TOUCH_W wide and the strip's
	-- height tall (the slider it replaced was 96 px for the whole range, 1% to 100%).
	local stop_fs = math.max(12, T.min_font_size)
	local stop_w = math.max(CommandBar.STOP_TOUCH_W, T.text_width("75%", stop_fs, 800) + 10.0)
	self._slider:set_min_size(
		Vector2.new(if compact then stop_w * #UICtx.RATIO_STOPS else ratio_w, if ctx.touch then 44 else 26)
	)
	self._slider.track_height = if ctx.touch then 36.0 else 26.0
	self._slider.font_size = stop_fs
	self._slider:queue_redraw()
	self._ratio_sub:set_visible(not compact)
	self._ratio_head:set_visible(not compact)
	self._ratio_inline:set_visible(compact)
	self._ratio_inline_box:set_visible(compact)
	self._ratio_sends:set_visible(compact)
	self._nation:set_visible(not compact)

	self._nuke_div:set_min_size(Vector2.new(1, if compact then 32 else 40))
	-- Phones: a slim strip exactly one touch target tall.
	self.panel:set_padding(
		if compact then 8.0 else 18.0,
		if compact then 4.0 else 17.0,
		if compact then 4.0 else 18.0,
		if compact then 4.0 else 17.0
	)
	-- Icon on top, "Build" underneath, exactly one touch target tall (the caption is a child label
	-- so it does not add to the button's minimum height).
	local tb = self._tray_btn
	tb:set_text("")
	tb.icon_alignment = W.ALIGN_CENTER
	tb.vertical_icon_alignment = W.VALIGN_TOP
	tb.expand_icon = false
	tb:add_theme_constant_override("icon_max_width", 16)
	tb:set_min_size(Vector2.new(52, 44))
	for _, st in ipairs({ "normal", "hover", "disabled" }) do
		tb:add_theme_stylebox_override(st, T.flat(T.rgba(1, 1, 1, 0.05), T.R_MD, T.rgba(1, 1, 1, 0.08), 1, 0.0, 5.0))
	end
	tb:add_theme_stylebox_override("pressed", T.flat(T.c(T.AMBER, 0.22), T.R_MD, T.AMBER, 1, 0.0, 5.0))
	tb:add_theme_stylebox_override("hover_pressed", T.flat(T.c(T.AMBER, 0.28), T.R_MD, T.AMBER, 1, 0.0, 5.0))
	if self._tray_caption == nil then
		local cap = T.label("Build", 12, 700, T.TEXT)
		cap.horizontal_alignment = W.ALIGN_CENTER
		cap:set_anchors_and_offsets_preset(W.PRESET_BOTTOM_WIDE)
		cap.offset_top = -19.0
		cap.offset_bottom = -3.0
		tb:add_child(cap)
		self._tray_caption = cap
	end

	-- (gold last, next to the slots it buys; 2026-10-13: gold and the attack panel swapped places in
	-- the bottom bar, so gold sits next to what it buys, which is more intuitive)
	local stats_order = { self._nation, self._troops_box, self._ratio_box, self._gold_box }
	if self._flow == WIDE then
		local row = T.hbox(16)
		row:set_alignment(W.ALIGN_CENTER)
		self._root_box = row
		for _, c in ipairs(stats_order) do
			row:add_child(c)
			c.size_flags_vertical = W.SHRINK_CENTER
			row:add_child(T.vdivider(44.0))
		end
		row:add_child(self._builds)
		self._builds.size_flags_vertical = W.SHRINK_CENTER
	elseif compact then
		-- Phone: one slim strip (numbers, short slider, Build); the slots live in a tray.
		local one = T.hbox(8)
		one:set_alignment(W.ALIGN_CENTER)
		self._root_box = one
		-- Width from the fixed number boxes (icon + gap + number + gap + rate, then gold, plus the gap
		-- between).
		local w_stats = 14.0
			+ 5.0
			+ self._m_troops.custom_minimum_size.X
			+ 5.0
			+ self._m_growth.custom_minimum_size.X
			+ 10.0
			+ 14.0
			+ 5.0
			+ self._m_gold.custom_minimum_size.X
		self._m_stats:set_min_size(Vector2.new(w_stats + 4.0, 44.0))
		one:add_child(self._m_stats)
		one:add_child(self._m_ratio)
		one:add_child(tb)
		tb.size_flags_vertical = W.SHRINK_CENTER
		self._builds:set_alignment(W.ALIGN_CENTER)
		-- One row when it fits between the safe edges (the ten slots, the unlocked Arsenal kinds and
		-- the SHOP button: the slots narrow a little first, then SHOP), else builds over nukes.
		local avail = ctx.vp.X - ctx.insets.x - ctx.insets.z - 16.0
		local fit = TrayFit.fit(avail, 10 + #self:_unlocked_arsenal(), #self._shop:locked())
		for _, b in pairs(self.buttons) do
			b:set_slot_width(fit.slot_w)
		end
		self._shop:set_block(fit.shop_w, 64.0)
		self._builds:set_separation(fit.sep)
		self._builds2:set_separation(fit.sep)
		self:_arrange_slots(fit.two_rows)
		self._tray_v:add_child(self._builds)
		if fit.two_rows then
			self._tray_v:add_child(self._builds2)
		end
		self.tray:add_child(self._tray_v)
	else
		local col = T.vbox(10)
		self._root_box = col
		local stats = T.hbox(16)
		stats:set_alignment(W.ALIGN_CENTER)
		for _, c in ipairs(stats_order) do
			stats:add_child(c)
			c.size_flags_vertical = W.SHRINK_CENTER
			if c ~= self._gold_box then
				stats:add_child(T.vdivider(40.0))
			end
		end
		col:add_child(stats)
		self._builds:set_alignment(W.ALIGN_CENTER)
		self._builds.size_flags_horizontal = W.SHRINK_CENTER
		col:add_child(self._builds)
	end
	if not compact then
		self:set_tray(false)
		for _, b in pairs(self.buttons) do
			b:set_slot_width(nil)
		end
		self._shop:set_block(math.max(CommandBar.SHOP_W, shop_want), if ctx.touch then 62.0 else 60.0)
	end
	self._root_box:set_mouse_filter(W.MOUSE_IGNORE)
	self.panel:add_child(self._root_box)
end

-- ---------------------------------------------------------------------------------------------
-- Data
-- ---------------------------------------------------------------------------------------------

function CommandBar.refresh(self, animate: boolean?)
	local ctx = self.ctx
	local T = UITheme
	local anim = animate ~= false
	local s = ctx.state
	local o = ctx:my()
	if s == nil or o == nil then
		return
	end
	local Rules = T.core("Rules")
	local Defs = T.core("Defs")
	local col = T.owner_ui_color(o.color)
	T.set_swatch_color(self._swatch, o.color)
	self._name:set_text(o.name)
	local share = s:land_share(o.id)
	self._land:set_text(string.format("%s of the world", T.fmt_pct(share)))
	-- (the leader from one pass, not the whole ranking sorted, 2026-10-27)
	local leader = ctx:leader()
	self._crown:set_modulate_a(if leader ~= nil and leader.id == o.id then 1.0 else 0.0)
	self._troops:set_value(o.troops, anim)
	self._troops_cap:set_text("/ " .. T.fmt_troops(o.max_troops))
	local bar_col = T.lerp(col, T.CYAN, 0.35)
	self._troops_bar.fill_color = bar_col
	self._troops_bar:set_target(o.troops / math.max(o.max_troops, 1.0), not anim)
	self._gold:set_value(o.gold, anim)
	self._m_troops:set_value(o.troops, anim)
	self._m_gold:set_value(o.gold, anim)
	self._m_troops_bar.fill_color = bar_col
	self._m_troops_bar:set_target(o.troops / math.max(o.max_troops, 1.0), not anim)
	self._income:set_text(T.fmt_rate(o.income))
	T.set_font_color(self._income, if o.income > 0 then T.GREEN else T.TEXT_3)
	-- Growth: the troop-rate label — "+{troops gained per second}/s" (NumberFormat clamps
	-- at 0, so a nation above its cap after losing land reads +0/s), green while the rate is not
	-- falling and orange once it is (sample_growth). Attacks spend troops but do not slow it.
	local per_tick = Rules.troop_growth(o.kind, o.troops, math.max(o.max_troops, 1), self:_difficulty())
	self._rate = per_tick * Defs.TICK_RATE
	self._growth:set_text(UIRules().troop_rate_text(self._rate))
	T.set_font_color(self._growth, if self._rate_up then T.GREEN else T.ORANGE)
	self._m_growth:set_text(self._growth.text)
	T.set_font_color(self._m_growth, if self._rate_up then T.GREEN else T.ORANGE)
	local at_war = self:_committed_troops()
	self._committed:set_modulate_a(if at_war > 0 then 1.0 else 0.0)
	self._committed:set_text(if at_war > 0 then string.format("%s at war", T.fmt_troops(at_war)) else "")
	self:_refresh_ratio()
	self:refresh_buttons()
end

--- Coalesced: the slots refresh at most once per frame, however many events ask for it.
function CommandBar.refresh_buttons(self)
	self._buttons_dirty = true
end

function CommandBar._refresh_buttons_now(self)
	self._buttons_dirty = false
	-- an Arsenal kind was unlocked (or the inventory arrived): its slot joins the row, SHOP stops
	-- showing it
	local cards_changed = self._shop:refresh()
	if table.concat(self:_unlocked_arsenal(), ",") ~= self._arsenal_sig or cards_changed then
		self._arsenal_sig = table.concat(self:_unlocked_arsenal(), ",")
		self.slots_changed:Fire() -- (UIRoot lays the HUD out again: the row may need another flow)
		self:_reflow()
		self.footprint_changed:Fire()
	end
	for _, b in pairs(self.buttons) do
		b:refresh()
	end
end

--- Phone details card (the strip shows only numbers): troops, cap, growth, at war, gold, income.
function CommandBar.stats_spec(self): { [string]: any }
	local ctx = self.ctx
	local T = UITheme
	local s = ctx.state
	local o = ctx:my()
	if s == nil or o == nil then
		return {}
	end
	local rows: { any } = {
		{ "Troops", string.format("%s / %s", T.fmt_troops(o.troops), T.fmt_troops(o.max_troops)) },
		{ "Growth", self._growth.text, if self._rate_up then T.GREEN else T.ORANGE },
	}
	local at_war = self:_committed_troops()
	if at_war > 0 then
		table.insert(rows, { "At war", T.fmt_troops(at_war), T.ORANGE })
	end
	table.insert(rows, { "Gold", T.fmt_num(o.gold), T.GOLD })
	table.insert(rows, { "Income", T.fmt_rate(o.income), if o.income > 0 then T.GREEN else T.TEXT_3 })
	table.insert(rows, { "Land", T.fmt_pct(s:land_share(o.id)) })
	local pct = ctx.ratio * 100
	table.insert(rows, {
		"Each order sends",
		string.format(
			"%d%% · %s",
			if pct >= 0 then math.floor(pct + 0.5) else 0,
			T.fmt_troops(ctx:troops_for_ratio())
		),
		T.AMBER,
	})
	return {
		title = o.name,
		swatch = o.color,
		rows = rows,
		footer = "Cities raise your troop cap. More land, more gold.",
	}
end

--- Rect (logical px) of the phone strip's numbers (anchor for the details card).
function CommandBar.stats_rect(self): Rect
	if self._m_stats:is_visible_in_tree() then
		return self._m_stats:get_global_rect()
	end
	return self.panel:get_global_rect()
end

function CommandBar.reset_rate(self)
	self._rate = 0.0
	self._rate_up = true
	self._last_growth = nil
end

function CommandBar._difficulty(self): number
	local session = self.ctx.session
	return if session ~= nil then (tonumber(session.difficulty) or 1) else 1
end

--- Whether the troops/s label shows a rising rate (UIRules.troop_rate_rising), run once per stats
--- update (the server sends stats every 5 ticks). Only new stats count:
--- re-rendering the same numbers must not turn an orange label green.
function CommandBar.sample_growth(self)
	local ctx = self.ctx
	local o = ctx:my()
	if ctx.state == nil or o == nil then
		return
	end
	local Rules = UITheme.core("Rules")
	local rate = Rules.troop_growth(o.kind, o.troops, math.max(o.max_troops, 1), self:_difficulty())
	self._rate_up = UIRules().troop_rate_rising(rate, self._last_growth)
	self._last_growth = rate
end

function CommandBar._committed_troops(self): number
	local ctx = self.ctx
	local s = ctx.state
	local n = 0
	if s == nil then
		return 0
	end
	local me = ctx:me()
	if me == 0 then
		return 0
	end
	for _, a in pairs(s.attacks) do
		if a.attacker == me then
			n += a.troops
		end
	end
	return n
end

function CommandBar.set_active(self, kind: string)
	for k, b in pairs(self.buttons) do
		b:set_active(k == kind)
	end
end

function CommandBar.button(self, kind: string)
	return self.buttons[kind]
end

function CommandBar._refresh_ratio(self)
	local ctx = self.ctx
	local T = UITheme
	local pct = math.floor(ctx.ratio * 100 + 0.5)
	self._ratio_pct:set_text(string.format("%d%%", pct))
	self._ratio_sends:set_text(T.fmt_troops(ctx:troops_for_ratio()))
	self._ratio_sub:set_text(string.format("Sends %s troops", T.fmt_troops(ctx:troops_for_ratio())))
end

--- Per frame (GDScript _process).
function CommandBar.update(self, delta: number)
	self._poll += delta
	if self._poll >= 0.5 then
		self._poll = 0.0
		self._buttons_dirty = true
	end
	if self._buttons_dirty and self:is_visible_in_tree() then
		self:_refresh_buttons_now()
	end
end

--- Sections the current flow does not use are detached (not in the tree): free them with the bar.
function CommandBar.destroy(self)
	local parts = {
		self._nation,
		self._troops_box,
		self._gold_box,
		self._ratio_box,
		self._builds,
		self._builds2,
		self._tray_btn,
		self._tray_v,
		self._m_stats,
		self._m_ratio,
		self._nuke_wrap,
		self._arsenal_wrap,
		self._slider,
		self._ratio_inline_box,
	}
	for _, b in pairs(self.buttons) do
		table.insert(parts, b)
	end
	self:queue_free()
	for _, n in ipairs(parts) do
		if not n._freed and n.parent == nil then
			n:queue_free()
		end
	end
end

return CommandBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="147">
            <Properties>
              <string name="Name">CountLabel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/count_label.gd (UICount)
-- Label that animates between numeric values (troops, gold, percentages). Fixed-width tabular
-- rendering (UITheme.fix_width) keeps the rolling digits from jittering.

local UITheme = require("./UITheme")
local W = require("./Widgets")

local CountLabel = W.class(W.Label)

--- UICount.new(font_size = 18, weight = 700, color = TEXT, fmt = nil)  fmt: (value) -> string
function CountLabel.new(font_size: number?, weight: number?, color: any?, fmt: ((number) -> string)?)
	local self = setmetatable({}, CountLabel.__mt)
	W.Control._init(self)
	W.Label._init_label(self, "")
	self.formatter = fmt
	--- rolling number: fix_width renders it with equal-width digit cells (no jitter)
	self.rolling = true
	self.duration = 0.45
	self.value = 0.0
	self._shown = 0.0
	self._tween = nil
	self._init_done = false
	UITheme.style_label(self, font_size or 18, weight or 700, if color ~= nil then color else UITheme.TEXT)
	self:_refresh()
	return self
end

function CountLabel.set_value(self, v: number, animate: boolean?)
	if self._init_done and math.abs(v - self.value) < 1e-9 then
		return
	end
	self.value = v
	if animate == false or not self._init_done or not self:is_inside_tree() then
		self._init_done = true
		self._shown = v
		self:_refresh()
		return
	end
	if self._tween then
		self._tween:kill()
	end
	self._tween = self:create_tween()
	self._tween
		:tween_method(function(x: number)
			self:_set_shown(x)
		end, self._shown, v, self.duration)
		:set_trans(W.TRANS_CUBIC)
		:set_ease(W.EASE_OUT)
end

function CountLabel._set_shown(self, v: number)
	self._shown = v
	self:_refresh()
end

function CountLabel._refresh(self)
	local t
	if self.formatter then
		t = self.formatter(self._shown)
	else
		local r = self._shown
		t = tostring(if r >= 0 then math.floor(r + 0.5) else -math.floor(-r + 0.5))
	end
	self:set_text(t)
end

return CountLabel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="148">
            <Properties>
              <string name="Name">CrateButton</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The title screen's crate button, top right (2026-09-29: on phones the chest button was hard to
-- notice, so it got more to catch the eye). The 3D chest (ChestView) wiggles on a glow and slow
-- rays with a twinkle or two, a CRATES pill under it, and a badge:
--   a crate waiting (bought, not opened)  a red count, the pill says OPEN, it wiggles more often;
--   the first crate not bought yet        its price (15) with the Robux icon;
--   otherwise                             no badge.
-- Where paid random items are restricted, or everything is owned, it's a calm LOCKER button (no wiggle,
-- no price). pressed() -> UIRoot opens the Locker.
local UITheme = require("./UITheme")
local W = require("./Widgets")
local ChestView = require("./ChestView")
local Signal = UITheme.core("Signal")

local IS_ROBLOX = typeof(game) == "Instance"
local function shared(name: string): any
	if IS_ROBLOX then
		return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data[name]) :: any
	end
	return (require :: any)("../../shared/Data/" .. name)
end
local Products = shared("Products")
local Prices = require("./Prices")
local Cosmetics = shared("Cosmetics")
local TweenService = if IS_ROBLOX then game:GetService("TweenService") else nil

local CrateButton = W.class(W.Control)

--- The chest square, desktop px (phones: PHONE_K of it).
CrateButton.SIZE = 150
CrateButton.PHONE_K = 0.66
CrateButton.WIGGLE_S = 2.4 -- (a crate waiting: WAITING_WIGGLE_S)
CrateButton.WAITING_WIGGLE_S = 1.2

local GOLD = Color3.fromRGB(255, 190, 72)
local GOLD_LIGHT = Color3.fromRGB(255, 226, 150)
local FONT_B = Font.fromId(12187365977, Enum.FontWeight.Heavy)

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	if TweenService ~= nil then
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
			:Play()
	end
end

function CrateButton.new(c: any)
	local self = setmetatable({}, CrateButton.__mt)
	W.Control._init(self)
	self.ctx = c
	self.pressed = Signal.new()
	self._t = 0.0
	self._k = 1.0
	self._state = "calm"
	self._P = ChestView.rest()
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:_build()
	self:set_process(true)
	return self
end

function CrateButton._build(self)
	local art = UITheme.crate_art()
	local root = self.gui
	root.ClipsDescendants = false
	-- everything but the hit area scales together (hover / press)
	local body = new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
	}, root)
	self._body_scale = new("UIScale", {}, body)
	local function img(name: string, image: string?, z: number, props: any?): ImageLabel
		local p = props or {}
		p.Name = name
		p.BackgroundTransparency = 1
		p.Image = image or ""
		p.AnchorPoint = p.AnchorPoint or Vector2.new(0.5, 0.5)
		p.ZIndex = z
		return new("ImageLabel", p, body)
	end
	-- (the chest square is the top of the button; the pill overlaps its bottom)
	self._rays = img("Rays", art.rays, 1, { ImageColor3 = GOLD, ImageTransparency = 0.82 })
	self._glow = img("Glow", art.glow, 2, { ImageColor3 = GOLD, ImageTransparency = 0.5 })
	local vpf = new(
		"ViewportFrame",
		{ Name = "Chest", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 },
		body
	)
	self._vpf = vpf
	self._chest = ChestView.build(vpf)
	self._leak = img("Leak", art.glow, 4, { ImageColor3 = GOLD_LIGHT, ImageTransparency = 1 })
	self._sparks = {}
	for i = 1, 3 do
		self._sparks[i] = {
			img = img("Spark" .. i, art.sparkle, 5, { ImageColor3 = GOLD_LIGHT, ImageTransparency = 1 }),
			t = -i * 0.7,
		}
	end
	-- the pill
	local pill = new("Frame", {
		Name = "Pill",
		BackgroundColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 6,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, pill)
	self._pill_grad = new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 214, 110), Color3.fromRGB(242, 160, 40)),
		Rotation = 90,
	}, pill)
	new(
		"UIStroke",
		{
			Color = Color3.fromRGB(70, 40, 6),
			Thickness = 2,
			Transparency = 0.2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		},
		pill
	)
	self._pill = pill
	self._pill_text = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "CRATES",
		FontFace = FONT_B,
		TextColor3 = Color3.fromRGB(46, 26, 4),
		TextScaled = true,
		ZIndex = 7,
	}, pill)
	new("UIPadding", {
		PaddingTop = UDim.new(0.2, 0),
		PaddingBottom = UDim.new(0.16, 0),
		PaddingLeft = UDim.new(0.12, 0),
		PaddingRight = UDim.new(0.12, 0),
	}, self._pill_text)
	-- the badge (top right of the chest)
	local badge = new("Frame", {
		Name = "Badge",
		BackgroundColor3 = Color3.fromRGB(232, 56, 56),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 8,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, badge)
	new(
		"UIStroke",
		{ Color = Color3.fromRGB(255, 255, 255), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border },
		badge
	)
	self._badge_scale = new("UIScale", {}, badge)
	self._badge = badge
	local brow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 9 }, badge)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 2),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, brow)
	self._badge_icon = new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = "rbxasset://textures/ui/common/robux@3x.png",
		LayoutOrder = 1,
		ZIndex = 9,
	}, brow)
	self._badge_text = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = "",
		FontFace = FONT_B,
		TextColor3 = Color3.new(1, 1, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = 2,
		ZIndex = 9,
	}, brow)
	-- the hit area (above everything)
	local hit = new("TextButton", {
		Name = "Hit",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
	}, root)
	self._hover = false
	hit.MouseEnter:Connect(function()
		self._hover = true
		tween(self._body_scale, 0.12, { Scale = 1.06 })
	end)
	hit.MouseLeave:Connect(function()
		self._hover = false
		tween(self._body_scale, 0.12, { Scale = 1 })
	end)
	hit.MouseButton1Down:Connect(function()
		tween(self._body_scale, 0.08, { Scale = 0.94 })
	end)
	hit.MouseButton1Up:Connect(function()
		tween(self._body_scale, 0.12, { Scale = if self._hover then 1.06 else 1 })
	end)
	hit.Activated:Connect(function()
		self.ctx:sfx("click")
		self.pressed:Fire()
	end)
	self._hit = hit
	self:_size_parts()
end

--- `k`: 1 on desktop, PHONE_K on phones (also follows UITheme.scale: call it from apply_layout).
function CrateButton.set_scale(self, k: number)
	if k == self._k and UITheme.scale == self._u then
		return
	end
	self._k = k
	self:_size_parts()
end

--- The control's size in logical px: the chest square plus the pill's lower half.
function CrateButton.size_px(self): Vector2
	local s = CrateButton.SIZE * self._k
	return Vector2.new(s, s * 1.08)
end

-- (the raw instances inside are sized in px: logical px x UITheme.scale)
function CrateButton._size_parts(self)
	self._u = UITheme.scale
	local s = CrateButton.SIZE * self._k * self._u
	local cy = s * 0.46 -- the chest's centre (from the top)
	self._s, self._cy = s, cy
	self._vpf.Size = UDim2.fromOffset(s, s)
	self._vpf.Position = UDim2.fromOffset(s * 0.5, cy)
	self._rays.Size = UDim2.fromOffset(s * 1.35, s * 1.35)
	self._rays.Position = UDim2.fromOffset(s * 0.5, cy)
	self._glow.Size = UDim2.fromOffset(s * 1.15, s * 1.05)
	self._glow.Position = UDim2.fromOffset(s * 0.5, cy + s * 0.04)
	local pw, ph = s * 0.8, math.max(22 * self._u, s * 0.22)
	self._pill.Size = UDim2.fromOffset(pw, ph)
	self._pill.Position = UDim2.fromOffset(s * 0.5, s * 1.08)
	local bh = math.max(20 * self._u, s * 0.2)
	self._badge_h = bh
	self._badge.Position = UDim2.fromOffset(s * 0.82, s * 0.16)
	self._badge_icon.Size = UDim2.fromOffset(bh * 0.62, bh * 0.62)
	self._badge_text.Size = UDim2.fromOffset(0, bh)
	self._badge_text.TextSize = math.floor(bh * 0.7)
	self:_size_badge()
	for _, sp in self._sparks do
		sp.img.Size = UDim2.fromOffset(s * 0.1, s * 0.1)
	end
	self:set_min_size(self:size_px())
end

function CrateButton._size_badge(self)
	local bh = self._badge_h or 24
	local w = if self._badge_icon.Visible then bh * 0.62 + 4 + #self._badge_text.Text * bh * 0.46 + bh * 0.5 else bh
	self._badge.Size = UDim2.fromOffset(math.max(bh, w), bh)
end

--- Follow the session's inventory and crate credits.
function CrateButton.bind(self, s: any)
	if s == nil or self._bound == s then
		return
	end
	self._bound = s
	-- (and Roblox's price of the first crate, on the badge: UI/Prices)
	for _, sig in { s.inventory_changed, s.credits_changed, Prices.changed } do
		if sig then
			sig:Connect(function()
				self:refresh()
			end)
		end
	end
	Prices.fetch()
	self:refresh()
end

function CrateButton.refresh(self)
	local s = self.ctx.session
	local inv = if s ~= nil and s.inventory ~= nil then s.inventory else nil
	local credits = if s ~= nil and type(s.credits) == "table" then (tonumber(s.credits.crate) or 0) else 0
	local owned = Cosmetics.crate_owned(inv and inv.owned or {})
	local allowed = inv ~= nil and inv.crates_allowed == true
	local all_owned = owned >= #Cosmetics.all()
	-- (Studio diag "crate_btn": a forced look for screenshots)
	local fake = self._fake
	if fake == "waiting" then
		allowed, credits = true, 2
	elseif fake == "first" or fake == "offer" then
		allowed, credits, all_owned = true, 0, false
		inv = { crates_bought = if fake == "first" then 0 else 1 }
	elseif fake == "calm" then
		allowed = false
	end
	local state, text, badge, icon = "calm", "LOCKER", nil, false
	if allowed and credits > 0 then
		state, text, badge = "waiting", "OPEN", tostring(credits)
	elseif allowed and not all_owned then
		state, text = "offer", "CRATES"
		local first = Products.crate_first
		if (inv.crates_bought or 0) <= 0 and first and first.id ~= 0 then
			badge, icon = tostring(Prices.robux("crate_first")), true
		end
	end
	local changed = state ~= self._state or badge ~= self._badge_value
	self._state = state
	self._badge_value = badge
	self._pill_text.Text = text
	self._badge.Visible = badge ~= nil
	self._badge_icon.Visible = icon
	self._badge_text.Text = badge or ""
	self._badge.BackgroundColor3 = if icon then Color3.fromRGB(38, 170, 90) else Color3.fromRGB(232, 56, 56)
	self:_size_badge()
	if changed and badge ~= nil then
		self._badge_scale.Scale = 0.4
		tween(self._badge_scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	self._rays.Visible = state ~= "calm"
end

function CrateButton._process(self, dt: number)
	if not self:is_visible_in_tree() then
		return
	end
	self._t += dt
	local t = self._t
	local P = self._P
	local calm = self._state == "calm"
	local every = if self._state == "waiting" then CrateButton.WAITING_WIGGLE_S else CrateButton.WIGGLE_S
	local crack = if calm then 0 else ChestView.idle(P, t, every, if self._state == "waiting" then 1.3 else 1)
	if calm then
		P.y = math.sin(t * 2.0) * 0.05
	end
	ChestView.pose(self._chest, P)
	local s = self._s or 100
	-- light out of the seam while the lid cracks
	local seam = ChestView.project(P, ChestView.v3(ChestView.Model.seam), s)
	self._leak.Position = UDim2.fromOffset(s * 0.5 + seam.X, self._cy + seam.Y)
	self._leak.Size = UDim2.fromOffset(s * 0.7, s * 0.2)
	self._leak.ImageTransparency = 1 - crack * 0.75
	local pulse = 0.5 + 0.5 * math.sin(t * 3.2)
	self._glow.ImageTransparency = (if calm then 0.72 else 0.55) - 0.12 * pulse
	self._rays.Rotation = (self._rays.Rotation + dt * 14) % 360
	-- a twinkle or two around the chest
	for _, sp in self._sparks do
		sp.t += dt
		if calm then
			sp.img.ImageTransparency = 1
		elseif sp.t >= 0 then
			if not sp.placed then
				sp.placed = true
				local a = math.random() * math.pi * 2
				sp.img.Position = UDim2.fromOffset(s * 0.5 + math.cos(a) * s * 0.36, self._cy + math.sin(a) * s * 0.3)
			end
			local k = sp.t / 0.9
			if k >= 1 then
				sp.t = -(0.4 + math.random() * 1.4)
				sp.placed = false
				sp.img.ImageTransparency = 1
			else
				local v = math.sin(k * math.pi)
				sp.img.ImageTransparency = 1 - v * 0.9
				sp.img.Rotation = k * 90
				sp.img.Size = UDim2.fromOffset(s * 0.1 * (0.5 + v * 0.5), s * 0.1 * (0.5 + v * 0.5))
			end
		end
	end
end

return CrateButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="149">
            <Properties>
              <string name="Name">CrateOpening</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Opening a cosmetic crate: a Clash Royale-style show around a 3D chest (2026-09-29: the first version
-- of opening a crate was not satisfying at all, and it should be super fun; the show was then made
-- 3D, around a ready-made voxel chest).
-- The chest is BedWars' voxel block chest (Assets/CrateModel) in a
-- ViewportFrame; the choreography follows Tribes' drop reveal (the same studio's game).
--   land    the screen dims; the chest falls in stretched past air streaks, lands with a squash, dust,
--           a floor ring and a shake; the title slams in;
--   idle    it bobs; every WIGGLE_EVERY_S it wiggles with a rattle, the lid cracks and light leaks out;
--           "TAP TO OPEN". It never opens by itself (no auto-open: the player has to click or tap
--           it open);
--   build   tapped: distinct rattles, closer together and bigger, while the light turns the item's
--           rarity colour and BedWars' lucky box preview for that rarity plays; the rarer the item, the
--           longer the build (BUILD_S; Epic and Legendary tease with rays); a roll still on its way
--           keeps it rattling (the network wait hides in there);
--   burst   a crouch, then the lid bursts open: a flash in the rarity colour, rays, a light beam and
--           sparks out of the chest, a shockwave ring, a shake;
--   card    the card flies out of the chest face down while the chest steps down; it glows in its
--           rarity colour (CARD_HOLD_S: longer for the rarer ones, a tap hurries it), then flips: the
--           item, NEW!, the rarity, the name, the rarity's sound;
--   choose  WEAR IT · OPEN ANOTHER (a waiting crate, or the next one's price) · DONE.
-- Nothing clips to white: flashes are the rarity colour at part strength.
-- Locker drives it: play(info) as the crate is opened, resolve(item_id) / fail(text) from the server.
-- Signals: wear(item_id), again(), closed(fail_text?), shown(open). `pace` > 1 slows the whole show
-- (frame captures).
local UITheme = require("./UITheme")
local W = require("./Widgets")
local ChestView = require("./ChestView")
local Signal = UITheme.core("Signal")

local IS_ROBLOX = typeof(game) == "Instance"
local Airfront: any = if IS_ROBLOX then (game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront") else nil
local Cosmetics: any = if IS_ROBLOX then require(Airfront.Data.Cosmetics) else (require :: any)("../../shared/Data/Cosmetics")
local Model: any = ChestView.Model
local TweenService = if IS_ROBLOX then game:GetService("TweenService") else nil
local RunService = if IS_ROBLOX then game:GetService("RunService") else nil
local UserInputService = if IS_ROBLOX then game:GetService("UserInputService") else nil

local CrateOpening = W.class(W.Control)

CrateOpening.FALL_S = 0.42
CrateOpening.SETTLE_S = 0.45
CrateOpening.WIGGLE_EVERY_S = 1.1
CrateOpening.BUILD_S = { common = 0.55, rare = 0.8, epic = 1.15, legendary = 1.7 }
--- a build-up rattle's length, and the gap before the next (at the start .. at the end of the build)
CrateOpening.JOLT_S = 0.26
CrateOpening.JOLT_GAP_S = { 0.22, 0.04 }
CrateOpening.CARD_HOLD_S = { common = 0.2, rare = 0.35, epic = 0.6, legendary = 1.0 }
CrateOpening.RESULT_WAIT_S = 12.0
CrateOpening.BURST = { common = 18, rare = 26, epic = 36, legendary = 54 }
CrateOpening.MAX_PARTICLES = 150

local VIEW_K = 1.1 -- the viewport's side, in stage units (S)

-- the chest's own light before the roll shows through
local GOLD = Color3.fromRGB(255, 190, 72)
local GOLD_LIGHT = Color3.fromRGB(255, 226, 150)
local AMBIENT = ChestView.AMBIENT

local FONT_B = Font.fromId(12187365977, Enum.FontWeight.Heavy)
local FONT_M = Font.fromId(12187365977, Enum.FontWeight.Bold)

local function c3(hex: number): Color3
	return Color3.fromRGB((hex // 65536) % 256, (hex // 256) % 256, hex % 256)
end

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	if TweenService == nil then
		return
	end
	TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
		:Play()
end

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

local EASE = {
	linear = function(k: number): number
		return k
	end,
	outQuad = function(k: number): number
		return 1 - (1 - k) * (1 - k)
	end,
	inQuad = function(k: number): number
		return k * k
	end,
	inOutSine = function(k: number): number
		return -(math.cos(math.pi * k) - 1) / 2
	end,
	outBack = function(k: number): number
		local c1 = 1.70158
		return 1 + (c1 + 1) * (k - 1) ^ 3 + c1 * (k - 1) ^ 2
	end,
}

local v3 = ChestView.v3

local function place(g: GuiObject, at: Vector2)
	g.Position = UDim2.fromOffset(at.X, at.Y)
end

function CrateOpening.new(c: any)
	local self = setmetatable({}, CrateOpening.__mt)
	W.Control._init(self)
	self.ctx = c
	self.wear = Signal.new()
	self.again = Signal.new()
	self.closed = Signal.new()
	self.shown = Signal.new() -- (open: boolean) the show starts / ends (the top bar row hides)
	self.is_open = false
	self.pace = 1.0
	self._gen = 0
	self._phase = "off"
	self._item = nil
	self._particles = {}
	self._anims = {}
	-- the chest pose: y (studs), yaw / roll / pitch (radians), sq (squash, + = flat), s (scale), lid
	-- (degrees); hy (the viewport's centre below the stage centre, in S), hs (its scale)
	self._P = { y = 0, yaw = 0, roll = 0, pitch = 0, sq = 0, s = 1, lid = 0, hy = 0, hs = 1 }
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	self:set_visible(false)
	self:_build()
	return self
end

-- ---------------------------------------------------------------------------------------------
-- Build (once)
-- ---------------------------------------------------------------------------------------------

function CrateOpening._build(self)
	local art = UITheme.crate_art()
	local root = self.gui
	-- everything moves together (the screen shake). ZIndex 1: under the kit's buttons row (the kit
	-- numbers its children from 11); the stage's own layers order among themselves
	local stage = new("Frame", { Name = "Stage", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1 }, root)
	self._stage = stage
	local function layer(name: string, z: number): Frame
		return new("Frame", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z }, stage)
	end
	local function img(name: string, image: string, z: number, parent: Instance?, props: any?): ImageLabel
		local p = props or {}
		p.Name = name
		p.BackgroundTransparency = 1
		p.Image = image or ""
		p.ImageTransparency = if p.ImageTransparency ~= nil then p.ImageTransparency else 1
		p.AnchorPoint = p.AnchorPoint or Vector2.new(0.5, 0.5)
		p.ZIndex = z
		return new("ImageLabel", p, parent or stage)
	end
	-- the backdrop: a deep blue, nearly opaque (the chest is the only thing on screen)
	self._dim = new("Frame", {
		Name = "Dim",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(2, 2),
		Position = UDim2.fromScale(-0.5, -0.5),
		ZIndex = 1,
	}, stage)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(4, 6, 18)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(22, 32, 84)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(4, 6, 18)),
		}),
		Rotation = 90,
	}, self._dim)
	-- a wash of the rarity colour behind everything (after the burst)
	self._tint = img("Tint", art.glow, 2)
	-- rays (two counter-rotating layers) + a halo
	local rays = new("Frame", { Name = "Rays", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 }, stage)
	self._rays = rays
	self._rays_scale = new("UIScale", {}, rays)
	self._rays_a = img("RaysA", art.rays, 3, rays, { Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1) })
	self._rays_b = img("RaysB", art.rays, 3, rays, { Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1.25, 1.25) })
	-- a Legendary's rays shimmer through the rainbow
	self._rays_grad = new("UIGradient", { Enabled = false }, self._rays_a)
	self._halo = img("Halo", art.glow, 3, rays, { Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.6, 0.6) })
	self._back_fx = layer("BackFx", 4)
	-- the chest: its floor shadow, a floor ring, the light beam, its glow, the viewport, the leak
	self._shadow = img("Shadow", art.glow, 5, nil, { ImageColor3 = Color3.new(0, 0, 0) })
	self._floor_ring = img("FloorRing", art.ring, 5)
	self._beam = img("Beam", art.beam, 6, nil, { AnchorPoint = Vector2.new(0.5, 1) })
	self._chest_glow = img("ChestGlow", art.glow, 6)
	local holder = new("Frame", { Name = "Chest", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 7 }, stage)
	self._holder = holder
	self._holder_scale = new("UIScale", {}, holder)
	local vpf = new("ViewportFrame", { Name = "View", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 7 }, holder)
	self._vpf = vpf
	self._chest = ChestView.build(vpf)
	-- light out of the open chest, and out of the lid's seam while it cracks (in front of the viewport)
	self._mouth_glow = img("MouthGlow", art.glow, 8)
	self._leak = img("Leak", art.glow, 8)
	self._leak_flare = img("LeakFlare", art.flare, 8)
	-- the card's glow (behind the card)
	self._card_glow = img("CardGlow", art.glow, 9)
	-- the card: a back (the crate's emblem) and a front (the item)
	local card = new("Frame", {
		Name = "Card",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 10,
	}, stage)
	self._card = card
	self._card_scale = new("UIScale", {}, card)
	-- (a UIGradient multiplies the frame's colour: the faces are white under their gradients)
	local back = new("Frame", {
		Name = "Back",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
	}, card)
	new("UICorner", { CornerRadius = UDim.new(0.08, 0) }, back)
	self._back_stroke = new("UIStroke", { Color = Color3.fromRGB(242, 190, 75), Thickness = 4 }, back)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(62, 80, 176), Color3.fromRGB(20, 26, 70)),
		Rotation = 90,
	}, back)
	new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = art.icon or "",
		ImageColor3 = Color3.fromRGB(255, 214, 110),
		ScaleType = Enum.ScaleType.Fit,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.55, 0.55),
		ZIndex = 11,
	}, back)
	self._back = back
	local front = new("Frame", {
		Name = "Front",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ClipsDescendants = true,
		ZIndex = 10,
	}, card)
	new("UICorner", { CornerRadius = UDim.new(0.08, 0) }, front)
	self._front_stroke = new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 4 }, front)
	self._front_grad = new("UIGradient", { Rotation = 90 }, front)
	self._front = front
	self._preview = new("ImageLabel", {
		Name = "Preview",
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.7),
		ZIndex = 11,
	}, front)
	-- a moving shine over the front (Epic, Legendary): a gradient band swept by its offset (a rotated
	-- frame would not be clipped)
	self._shine = new("Frame", {
		Name = "Shine",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 12,
	}, front)
	new("UICorner", { CornerRadius = UDim.new(0.08, 0) }, self._shine)
	self._shine_grad = new("UIGradient", {
		Rotation = 20,
		Offset = Vector2.new(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.42, 1),
			NumberSequenceKeypoint.new(0.5, 0.45),
			NumberSequenceKeypoint.new(0.58, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, self._shine)
	self._new = new("TextLabel", {
		Name = "New",
		BackgroundColor3 = Color3.fromRGB(235, 64, 64),
		Text = "NEW!",
		FontFace = FONT_B,
		TextColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.86, 0.04),
		Size = UDim2.fromScale(0.42, 0.13),
		TextScaled = true,
		Rotation = 12,
		Visible = false,
		ZIndex = 13,
	}, card)
	new("UICorner", { CornerRadius = UDim.new(0.3, 0) }, self._new)
	new("UIStroke", { Color = Color3.fromRGB(120, 20, 20), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, self._new)
	new("UIPadding", {
		PaddingLeft = UDim.new(0.1, 0),
		PaddingRight = UDim.new(0.1, 0),
		PaddingTop = UDim.new(0.12, 0),
		PaddingBottom = UDim.new(0.12, 0),
	}, self._new)
	self._new_scale = new("UIScale", {}, self._new)
	local function label(name: string, font: Font, z: number): TextLabel
		local l = new("TextLabel", {
			Name = name,
			BackgroundTransparency = 1,
			Text = "",
			FontFace = font,
			TextColor3 = Color3.new(1, 1, 1),
			TextTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = z,
		}, stage)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, Transparency = 1 }, l)
		return l
	end
	-- the title (slams in as the chest lands) and the words under the card
	self._title = label("Title", FONT_B, 14)
	self._title_scale = new("UIScale", {}, self._title)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 240, 200), Color3.fromRGB(255, 184, 60)),
		Rotation = 90,
	}, self._title)
	self._subtitle = label("Subtitle", FONT_M, 14)
	self._rarity = label("Rarity", FONT_B, 14)
	self._rarity_scale = new("UIScale", {}, self._rarity)
	self._name = label("ItemName", FONT_B, 14)
	self._kind = label("Kind", FONT_M, 14)
	-- "TAP TO OPEN" in a pill
	local hint = new("Frame", {
		Name = "Hint",
		BackgroundColor3 = Color3.fromRGB(12, 16, 36),
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 14,
	}, stage)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, hint)
	self._hint_stroke = new("UIStroke", { Color = GOLD, Thickness = 2, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, hint)
	self._hint_scale = new("UIScale", {}, hint)
	self._hint_text = new("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Text = "TAP TO OPEN",
		FontFace = FONT_B,
		TextColor3 = Color3.new(1, 1, 1),
		TextTransparency = 1,
		TextScaled = true,
		ZIndex = 15,
	}, hint)
	new("UIPadding", {
		PaddingTop = UDim.new(0.24, 0),
		PaddingBottom = UDim.new(0.24, 0),
		PaddingLeft = UDim.new(0.1, 0),
		PaddingRight = UDim.new(0.1, 0),
	}, self._hint_text)
	self._hint = hint
	self._front_fx = layer("FrontFx", 16)
	self._flash = new("Frame", {
		Name = "Flash",
		BackgroundColor3 = GOLD_LIGHT,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(2, 2),
		Position = UDim2.fromScale(-0.5, -0.5),
		ZIndex = 17,
	}, stage)
	-- taps anywhere open the chest / hurry the card (the buttons row sits above the stage)
	self._catch = new("TextButton", {
		Name = "Tap",
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 18,
	}, stage)
	self._catch.Activated:Connect(function()
		self:_tap()
	end)
	-- the choice (kit buttons in a row, placed in _layout)
	local row = UITheme.hbox(10)
	row:set_alignment(W.ALIGN_CENTER)
	self._row = row
	self._wear_b = UITheme.button("WEAR IT", "PrimaryButton", "check", 48.0)
	self._wear_b.pressed:Connect(function()
		if self._item then
			self.wear:Fire(self._item)
		end
	end)
	row:add_child(self._wear_b)
	self._again_b = UITheme.button("OPEN ANOTHER", "GlassButton", "robux", 48.0)
	self._again_b.pressed:Connect(function()
		if self._phase == "choose" then
			self.again:Fire()
		end
	end)
	row:add_child(self._again_b)
	self._done_b = UITheme.button("DONE", "GlassButton", "", 48.0)
	self._done_b.pressed:Connect(function()
		self:close()
	end)
	row:add_child(self._done_b)
	row:set_visible(false)
	self:add_child(row)
end

-- ---------------------------------------------------------------------------------------------
-- Layout
-- ---------------------------------------------------------------------------------------------

--- The stage unit: the chest, the card and the words scale with it.
function CrateOpening._size(self): number
	local area = self.ctx:clear_rect()
	return math.min(area.Width * 0.7, area.Height * 0.64, 560)
end

-- (the stage's raw instances are sized in px: logical px x UITheme.scale; the kit's buttons row keeps
-- logical px)
function CrateOpening._layout(self)
	local u = UITheme.scale
	local area = self.ctx:clear_rect()
	local SL = self:_size()
	local S = SL * u
	local cx = (area.Min.X + area.Width * 0.5) * u
	local cy = (area.Min.Y + area.Height * 0.5) * u
	self._cx, self._cy, self._S = cx, cy, S
	--- a text size: S-relative, clamped in logical px
	local function ts(k: number, lo: number, hi: number): number
		return math.floor(math.clamp(SL * k, lo, hi) * u)
	end
	local V = S * VIEW_K
	self._V = V
	self._holder.Size = UDim2.fromOffset(V, V)
	self._rays.Size = UDim2.fromOffset(S * 2.2, S * 2.2)
	self._tint.Size = UDim2.fromOffset(S * 3.2, S * 2.4)
	self._tint.Position = UDim2.fromOffset(cx, cy)
	self._title.Size = UDim2.fromOffset(S * 2, S * 0.16)
	self._title.TextSize = ts(0.13, 24, 64)
	self._title.Position = UDim2.fromOffset(cx, cy - S * 0.64)
	self._subtitle.Size = UDim2.fromOffset(S * 2, S * 0.06)
	self._subtitle.TextSize = ts(0.042, 11, 20)
	self._subtitle.Position = UDim2.fromOffset(cx, cy - S * 0.53)
	local hw = math.clamp(SL * 0.5, 150, 240) * u
	self._hint.Size = UDim2.fromOffset(hw, hw * 0.2)
	self._hint.Position = UDim2.fromOffset(cx, cy + S * 0.6)
	-- the card and the words under it
	local cw, ch = S * 0.56, S * 0.74
	local card_y = cy - S * 0.17
	self._card.Size = UDim2.fromOffset(cw, ch)
	self._card_pos = UDim2.fromOffset(cx, card_y)
	self._card_glow.Size = UDim2.fromOffset(cw * 2.2, ch * 1.9)
	self._card_glow.Position = self._card_pos
	-- the words stack under the card by their real sizes (the phone sizes are floored)
	local y = card_y + ch * 0.5 + math.max(6 * u, S * 0.035)
	for _, e in { { self._rarity, 0.075, 15, 36 }, { self._name, 0.1, 20, 50 }, { self._kind, 0.04, 11, 18 } } do
		local l, size = e[1], ts(e[2], e[3], e[4])
		l.TextSize = size
		l.Size = UDim2.fromOffset(S * 1.6, size + 4)
		l.Position = UDim2.fromOffset(cx, y + size * 0.5)
		y += size + 3 * u
	end
	local compact = self.ctx.compact
	local bh = if compact then 42 else 48
	self._wear_b:set_min_size(Vector2.new(if compact then 128 else 165, bh))
	self._again_b:set_min_size(Vector2.new(if compact then 140 else 175, bh))
	self._done_b:set_min_size(Vector2.new(if compact then 96 else 120, bh))
	local rs = self._row:get_combined_minimum_size()
	local ry = math.min(area.Max.Y - rs.Y - 8, y / u + math.max(8, SL * 0.04))
	local rx = cx / u
	self._row:set_offsets(rx - rs.X * 0.5, ry, rx + rs.X * 0.5, ry + rs.Y)
	self._row:reset_size()
end

function CrateOpening.apply_layout(self)
	if self.is_open then
		self:_layout()
		if self._card.Visible and not self._card_flying then
			self._card.Position = self._card_pos
		end
		if self._phase == "card" or self._phase == "choose" then
			self._rays.Position = self._card_pos
		end
	end
end

-- ---------------------------------------------------------------------------------------------
-- The chest: pose, projection, keyframes
-- ---------------------------------------------------------------------------------------------

--- Tween a pose value through segments { {to, seconds, ease}, ... } (replaces what it was doing).
function CrateOpening._animate(self, key: string, segs: { any })
	local list = {}
	for _, s in segs do
		table.insert(list, { to = s[1], dur = s[2], ease = EASE[s[3] or "outQuad"] or EASE.outQuad, t = 0.0 })
	end
	self._anims[key] = list
end

function CrateOpening._step_anims(self, dt: number)
	local P = self._P
	for key, list in self._anims do
		local seg = list[1]
		if seg.from == nil then
			seg.from = P[key]
		end
		seg.t += dt
		local k = math.min(1, seg.t / math.max(seg.dur, 1e-3))
		P[key] = seg.from + (seg.to - seg.from) * seg.ease(k)
		if k >= 1 then
			table.remove(list, 1)
			if #list == 0 then
				self._anims[key] = nil
			end
		end
	end
end

--- Place the chest from the pose (the viewport rides P.hy / P.hs).
function CrateOpening._apply_pose(self)
	local P = self._P
	self._holder.Position = UDim2.fromOffset(self._cx, self._cy + P.hy * (self._S or 300))
	self._holder_scale.Scale = P.hs
	ChestView.pose(self._chest, P)
end

--- Stage px of a chest point (studs, chest space) in the current pose.
function CrateOpening._project(self, p: Vector3): Vector2
	local P = self._P
	local v = ChestView.project(P, p, (self._V or 300) * P.hs)
	return Vector2.new(self._cx + v.X, self._cy + P.hy * (self._S or 300) + v.Y)
end

-- ---------------------------------------------------------------------------------------------
-- The show
-- ---------------------------------------------------------------------------------------------

--- Start a crate: the chest drops in. `info` = { crates, price, can_more, wearing } (the next offer).
function CrateOpening.play(self, info: any)
	self._gen += 1
	local gen = self._gen
	self._info = info or {}
	self._item = nil
	self._rar = nil
	self._fail = nil
	self._tapped = false
	self._hurry = false
	self._card_flying = false
	self._falling = false
	self._idle_st, self._build_st, self._card_hold = nil, nil, nil
	local was_open = self.is_open
	self.is_open = true
	self:set_visible(true)
	if not was_open then
		self.shown:Fire(true)
	end
	self:_layout()
	self:_clear_particles()
	table.clear(self._anims)
	local P = self._P
	P.y, P.yaw, P.roll, P.pitch, P.sq, P.s, P.lid, P.hy, P.hs = 0, math.rad(-14), 0, 0, -0.18, 1, 0, -1.8, 1
	self._t = 0.0
	self._shake = 0.0
	self._rays_spin = 10
	self._light = GOLD_LIGHT
	self._stage.Position = UDim2.new()
	self._dim.BackgroundTransparency = 1
	tween(self._dim, 0.3, { BackgroundTransparency = 0 })
	self._tint.ImageTransparency = 1
	self._rays_a.ImageTransparency, self._rays_b.ImageTransparency, self._halo.ImageTransparency = 1, 1, 1
	self._rays_a.ImageColor3, self._rays_b.ImageColor3, self._halo.ImageColor3 = GOLD_LIGHT, GOLD, GOLD
	self._rays_grad.Enabled = false
	self._rays_scale.Scale = 1
	self._rays.Position = UDim2.fromOffset(self._cx, self._cy)
	for _, g in {
		self._shadow,
		self._floor_ring,
		self._beam,
		self._chest_glow,
		self._mouth_glow,
		self._leak,
		self._leak_flare,
		self._card_glow,
	} do
		g.ImageTransparency = 1
	end
	self._chest_glow.ImageColor3 = GOLD
	self._leak.ImageColor3, self._leak_flare.ImageColor3 = GOLD_LIGHT, GOLD_LIGHT
	self._vpf.ImageTransparency = 0
	self._vpf.Ambient = AMBIENT
	self._holder.Visible = true
	self._card.Visible = false
	self._card.Rotation = 0
	self._new.Visible = false
	self._shine.Visible = false
	self._back_stroke.Color = Color3.fromRGB(242, 190, 75)
	for _, l in { self._title, self._subtitle, self._rarity, self._name, self._kind } do
		l.TextTransparency = 1
		l:FindFirstChildOfClass("UIStroke").Transparency = 1
	end
	self._hint.BackgroundTransparency = 1
	self._hint_text.TextTransparency = 1
	self._hint_stroke.Transparency = 1
	self._row:set_visible(false)
	self._flash.BackgroundTransparency = 1
	self:_apply_pose()
	if self._conn == nil and RunService ~= nil then
		self._conn = RunService.RenderStepped:Connect(function(dt)
			self:_step(dt / math.max(self.pace, 0.05))
		end)
	end
	task.spawn(function()
		self:_run(gen)
	end)
end

--- The server's roll.
function CrateOpening.resolve(self, id: string)
	self._item = id
	local it = Cosmetics.item(id)
	if it then
		self._rar = Cosmetics.rarity(it.rarity)
	end
end

--- The crate couldn't be opened (the server said why): the show ends with a word.
function CrateOpening.fail(self, text: string)
	self._fail = text
	self:close()
end

function CrateOpening._tap(self)
	local ph = self._phase
	if ph == "land" or ph == "idle" then
		self._tapped = true
	elseif ph == "card" then
		self._hurry = true
	end
end

--- Wait `t` show-seconds; false once the show was replaced or closed. `hurry`: a tap ends it early.
function CrateOpening._sleep(self, gen: number, t: number, hurry: boolean?): boolean
	local left = t
	while left > 0 do
		if gen ~= self._gen then
			return false
		end
		if hurry and self._hurry then
			self._hurry = false
			return true
		end
		left -= task.wait() / math.max(self.pace, 0.05)
	end
	return gen == self._gen
end

function CrateOpening._run(self, gen: number)
	if self:_land(gen) and self:_idle(gen) and self:_build_up(gen) and self:_burst(gen) and self:_card_out(gen) then
		self:_reveal(gen)
	end
end

function CrateOpening._land(self, gen: number): boolean
	local S = self._S
	self._phase = "land"
	-- it falls in stretched, turning to face you, past air streaks; its shadow grows
	self:_animate("hy", { { 0.04, CrateOpening.FALL_S, "inQuad" } })
	self:_animate("yaw", { { 0, CrateOpening.FALL_S + 0.25, "outQuad" } })
	self.ctx:sfx("crate_drop", -2)
	self._falling = true
	if not self:_sleep(gen, CrateOpening.FALL_S) then
		return false
	end
	self._falling = false
	-- impact: squash and spring, dust, sparks, a floor ring, a shake, the title
	self.ctx:sfx("crate_land", -3)
	self:_animate("sq", {
		{ 0.3, 0.06, "outQuad" },
		{ -0.12, 0.13, "inOutSine" },
		{ 0.05, 0.12, "inOutSine" },
		{ 0, 0.14, "outQuad" },
	})
	self:_kick(S * 0.04)
	local foot = self:_project(Vector3.new(0, 0, -Model.size[3] * 0.5))
	for _, side in { -1, 1 } do
		self:_emit(7, {
			x = foot.X + side * S * 0.24,
			y = foot.Y,
			jitter = 0.04,
			dir = if side < 0 then 180 else 0,
			spread = 14,
			vmin = 0.5,
			vmax = 1.3,
			kind = "dust",
			size = 0.13,
			grow = 1.6,
			drag = 3.2,
			grav = -0.12,
			life = { 0.5, 0.9 },
			base = 0.55,
			colors = { Color3.fromRGB(190, 176, 150) },
			front = true,
		})
	end
	self:_emit(9, {
		x = foot.X,
		y = foot.Y - S * 0.05,
		jitter = 0.25,
		dir = -90,
		spread = 70,
		vmin = 0.7,
		vmax = 1.6,
		size = 0.05,
		grav = 2.4,
		drag = 1.2,
		life = { 0.4, 0.75 },
		colors = { GOLD_LIGHT, GOLD },
		front = true,
	})
	place(self._floor_ring, self:_project(Vector3.zero))
	self._floor_ring.ImageColor3 = GOLD_LIGHT
	self._floor_ring.Size = UDim2.fromOffset(S * 0.4, S * 0.1)
	self._floor_ring.ImageTransparency = 0.25
	tween(self._floor_ring, 0.55, { Size = UDim2.fromOffset(S * 2.2, S * 0.5), ImageTransparency = 1 }, Enum.EasingStyle.Quart)
	self._rays.Position = UDim2.fromOffset(self._cx, self._cy)
	self._halo.Size = UDim2.fromScale(0.6, 0.6)
	tween(self._halo, 0.5, { ImageTransparency = 0.6 })
	tween(self._chest_glow, 0.5, { ImageTransparency = 0.6 })
	self:_title_in(gen)
	return self:_sleep(gen, CrateOpening.SETTLE_S)
end

function CrateOpening._title_in(self, gen: number)
	local S = self._S
	self._title.Text = "CRATE"
	self._subtitle.Text = "A SKIN OR FLAG · NEVER A DUPLICATE"
	self._title_scale.Scale = 1.8
	tween(self._title_scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	tween(self._title, 0.12, { TextTransparency = 0 })
	tween(self._title:FindFirstChildOfClass("UIStroke"), 0.12, { Transparency = 0.1 })
	local p = UDim2.fromOffset(self._cx, self._cy - S * 0.53)
	self._subtitle.Position = p + UDim2.fromOffset(0, S * 0.03)
	task.delay(0.12, function()
		if gen == self._gen and self._phase ~= "burst" then
			tween(self._subtitle, 0.3, { TextTransparency = 0.1, Position = p }, Enum.EasingStyle.Quint)
			tween(self._subtitle:FindFirstChildOfClass("UIStroke"), 0.3, { Transparency = 0.4 })
		end
	end)
end

function CrateOpening._title_out(self)
	for _, l in { self._title, self._subtitle } do
		tween(l, 0.2, { TextTransparency = 1 })
		tween(l:FindFirstChildOfClass("UIStroke"), 0.2, { Transparency = 1 })
	end
end

function CrateOpening._idle(self, gen: number): boolean
	self._phase = "idle"
	self._idle_st = { t = 0.0, next = 0.3, wt = -1.0 }
	local touch = UserInputService ~= nil and UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	self._hint_text.Text = if touch then "TAP TO OPEN" else "CLICK TO OPEN"
	tween(self._hint, 0.25, { BackgroundTransparency = 0.25 })
	tween(self._hint_text, 0.25, { TextTransparency = 0 })
	tween(self._hint_stroke, 0.25, { Transparency = 0.2 })
	-- (a tap while it was landing opens it as soon as it has settled)
	while not self._tapped do
		if gen ~= self._gen then
			return false
		end
		task.wait()
	end
	self._idle_st = nil
	self:_animate("roll", { { 0, 0.08 } })
	self:_animate("yaw", { { 0, 0.08 } })
	self:_animate("lid", { { 0, 0.08 } })
	self:_animate("y", { { 0, 0.08 } })
	tween(self._hint, 0.15, { BackgroundTransparency = 1 })
	tween(self._hint_text, 0.15, { TextTransparency = 1 })
	tween(self._hint_stroke, 0.15, { Transparency = 1 })
	return true
end

function CrateOpening._build_up(self, gen: number): boolean
	self._phase = "build"
	table.clear(self._anims)
	local P = self._P
	self._build_st = { t = 0.0, k = 0.0, next = 0.0, from = { roll = P.roll, yaw = P.yaw, y = P.y, lid = P.lid } }
	-- BedWars' lucky box preview for the rarity (as soon as the server's roll is in)
	local previewed = false
	local waited = 0.0
	while true do
		local dt = task.wait() / math.max(self.pace, 0.05)
		if gen ~= self._gen then
			return false
		end
		local b = self._build_st
		b.t += dt
		local rid = if self._rar then self._rar.id else nil
		local len = CrateOpening.BUILD_S[rid or "rare"] or 0.8
		if rid ~= nil and not previewed then
			previewed = true
			self.ctx:sfx("crate_preview_" .. rid, -1, 0)
		end
		b.k = math.clamp(b.t / len, 0, 1)
		if b.k >= 1 then
			if self._item ~= nil then
				break
			end
			-- the roll is still on its way: it keeps rattling
			waited += dt
			if waited > CrateOpening.RESULT_WAIT_S then
				self:fail("The crate didn't open. It's saved: try again in a moment.")
				return false
			end
		end
	end
	self._build_st = nil
	return true
end

function CrateOpening._burst(self, gen: number): boolean
	local S = self._S
	local rar = self._rar or Cosmetics.RARITIES[1]
	local rid = rar.id
	local col = c3(rar.color)
	local light = col:Lerp(Color3.new(1, 1, 1), 0.35)
	self._light = light
	self._phase = "burst"
	self:_title_out()
	-- crouch
	self:_animate("roll", { { 0, 0.06 } })
	self:_animate("yaw", { { 0, 0.06 } })
	self:_animate("lid", { { 0, 0.06 } })
	self:_animate("y", { { 0, 0.06 } })
	self:_animate("sq", { { 0.2, 0.1 } })
	if not self:_sleep(gen, 0.1) then
		return false
	end
	-- the lid bursts open
	self:_animate("sq", { { -0.14, 0.1 }, { 0.06, 0.14, "inOutSine" }, { 0, 0.2 } })
	self:_animate("y", { { 0.45, 0.12 }, { 0, 0.26, "inQuad" } })
	self:_animate("lid", { { Model.lid_open or 118, 0.34, "outBack" } })
	self:_animate("s", { { 1.08, 0.1 }, { 1, 0.3 } })
	self.ctx:sfx("crate_open", 0, 0)
	self:_kick(S * (if rid == "legendary" then 0.075 elseif rid == "epic" then 0.055 else 0.04))
	self._flash.BackgroundColor3 = light
	self._flash.BackgroundTransparency = if rid == "legendary" then 0.45 else 0.58
	tween(self._flash, 0.45, { BackgroundTransparency = 1 })
	self._tint.ImageColor3 = col
	self._tint.ImageTransparency = 0.5
	tween(self._tint, 1.2, { ImageTransparency = 0.78 })
	self._vpf.Ambient = AMBIENT:Lerp(light, 0.6)
	tween(self._vpf, 0.6, { Ambient = AMBIENT:Lerp(light, 0.15) })
	-- rays, halo, beam and a shockwave out of the chest's mouth
	local mouth = self:_project(v3(Model.mouth))
	place(self._rays, mouth)
	self._rays_a.ImageColor3 = light
	self._rays_b.ImageColor3 = col
	self._halo.ImageColor3 = col
	self._rays_scale.Scale = if rid == "legendary" then 0.8 else 0.3
	tween(self._rays_scale, 0.55, { Scale = if rid == "legendary" then 1.15 else 1 }, Enum.EasingStyle.Back)
	self._rays_a.ImageTransparency = 0.25
	self._rays_b.ImageTransparency = 0.45
	tween(self._rays_a, 1.1, { ImageTransparency = if rid == "legendary" then 0.35 else 0.5 })
	tween(self._rays_b, 1.1, { ImageTransparency = if rid == "legendary" then 0.5 else 0.7 })
	self._rays_spin = if rid == "legendary" then 70 else 45
	if rid == "legendary" then
		self._rays_a.ImageColor3 = Color3.new(1, 1, 1)
		self._rays_grad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 60)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(120, 230, 90)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 170, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(190, 110, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 90)),
		})
		self._rays_grad.Enabled = true
	end
	self._halo.Size = UDim2.fromScale(0.35, 0.35)
	self._halo.ImageTransparency = 0.2
	tween(self._halo, 0.8, { ImageTransparency = 0.5, Size = UDim2.fromScale(0.7, 0.7) }, Enum.EasingStyle.Quart)
	self._beam.ImageColor3 = light
	place(self._beam, mouth + Vector2.new(0, S * 0.05))
	self._beam.Size = UDim2.fromOffset(S * 0.25, S * 0.6)
	self._beam.ImageTransparency = 0.2
	tween(self._beam, 0.25, { Size = UDim2.fromOffset(S * 0.5, S * 1.5) }, Enum.EasingStyle.Quart)
	task.delay(0.15 * self.pace, function()
		if self._gen == gen then
			tween(self._beam, 0.9 * self.pace, { ImageTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
	end)
	place(self._floor_ring, mouth)
	self._floor_ring.ImageColor3 = light
	self._floor_ring.Size = UDim2.fromOffset(S * 0.3, S * 0.3)
	self._floor_ring.ImageTransparency = 0.15
	tween(self._floor_ring, 0.6, { Size = UDim2.fromOffset(S * 2.8, S * 2.8), ImageTransparency = 1 }, Enum.EasingStyle.Quart)
	self._mouth_glow.ImageColor3 = col
	self._mouth_glow.ImageTransparency = 0.1
	self._chest_glow.ImageColor3 = col
	self._chest_glow.ImageTransparency = 0.3
	tween(self._chest_glow, 0.9, { ImageTransparency = 0.55 })
	local n = CrateOpening.BURST[rid] or 18
	self:_emit(n, {
		x = mouth.X,
		y = mouth.Y,
		jitter = 0.08,
		dir = -90,
		spread = 62,
		vmin = 1.6,
		vmax = 3.2,
		kind = "mix",
		streaks = 0.6,
		size = 0.06,
		grav = 2.0,
		drag = 1.5,
		life = { 0.5, 1.0 },
		colors = { col, light },
		white = 0.25,
		front = true,
	})
	self:_emit(math.floor(n * 0.6), {
		x = mouth.X,
		y = mouth.Y,
		jitter = 0.1,
		dir = -90,
		spread = 80,
		vmin = 0.6,
		vmax = 1.5,
		size = 0.07,
		grav = 1.1,
		drag = 1.4,
		life = { 0.7, 1.3 },
		colors = { light, col },
		front = true,
	})
	return self:_sleep(gen, if rid == "legendary" then 0.7 else 0.5)
end

function CrateOpening._card_out(self, gen: number): boolean
	local rar = self._rar or Cosmetics.RARITIES[1]
	local rid = rar.id
	local col = c3(rar.color)
	self._phase = "card"
	self._hurry = false
	-- the card flies out of the chest, face down and spinning; the chest steps down under it
	local mouth = self:_project(v3(Model.mouth))
	local card = self._card
	card.Visible = true
	self._back.Visible = true
	self._front.Visible = false
	self._new.Visible = false
	card.Position = UDim2.fromOffset(mouth.X, mouth.Y)
	card.Rotation = -200
	self._card_scale.Scale = 0.12
	self._card_flying = true
	tween(card, 0.45, { Position = self._card_pos }, Enum.EasingStyle.Back)
	tween(card, 0.45, { Rotation = 0 }, Enum.EasingStyle.Quad)
	tween(self._card_scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	self.ctx:sfx("card_whoosh")
	self:_animate("hy", { { 0.66, 0.45, "outQuad" } })
	self:_animate("hs", { { 0.5, 0.45, "outQuad" } })
	tween(self._rays, 0.45, { Position = self._card_pos })
	tween(self._mouth_glow, 0.45, { ImageTransparency = 0.5 })
	if not self:_sleep(gen, 0.45) then
		return false
	end
	self._card_flying = false
	-- the back glows in the rarity colour (the rarer, the longer)
	self._back_stroke.Color = col:Lerp(Color3.new(1, 1, 1), 0.2)
	self._card_glow.ImageColor3 = col
	self._card_glow.ImageTransparency = 1
	self._card_glow.Position = self._card_pos
	tween(self._card_glow, 0.25, { ImageTransparency = 0.35 })
	self._card_hold = { t = 0.0, rid = rid }
	if rid == "epic" or rid == "legendary" then
		self.ctx:sfx("crate_shimmer", -3, 0)
	end
	local ok = self:_sleep(gen, CrateOpening.CARD_HOLD_S[rid] or 0.2, true)
	self._card_hold = nil
	card.Rotation = 0
	self._card_scale.Scale = 1
	return ok
end

function CrateOpening._reveal(self, gen: number)
	local it = Cosmetics.item(self._item)
	local rar = self._rar or Cosmetics.RARITIES[1]
	local rid = rar.id
	local col = c3(rar.color)
	local S = self._S
	local card = self._card
	local w = card.Size
	-- the chest leaves the stage to the words and buttons
	self:_animate("hy", { { 1.6, 0.4, "inQuad" } })
	tween(self._vpf, 0.35, { ImageTransparency = 1 })
	for _, g in { self._mouth_glow, self._chest_glow, self._shadow } do
		tween(g, 0.3, { ImageTransparency = 1 })
	end
	-- the flip
	tween(card, 0.12, { Size = UDim2.fromOffset(2, w.Y.Offset) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	self.ctx:sfx("card_flip")
	if not self:_sleep(gen, 0.12) then
		return
	end
	self._back.Visible = false
	self._front.Visible = true
	self._front_stroke.Color = col
	self._front_grad.Color = ColorSequence.new(col:Lerp(Color3.fromRGB(20, 24, 48), 0.35), col:Lerp(Color3.fromRGB(10, 12, 30), 0.8))
	self:_show_item(it)
	tween(card, 0.22, { Size = w }, Enum.EasingStyle.Back)
	self._card_scale.Scale = 1.12
	tween(self._card_scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	self.ctx:sfx("reveal_" .. rid, 0, 0)
	self:_kick(S * (if rid == "legendary" then 0.04 else 0.018))
	self._card_glow.ImageTransparency = 0.15
	tween(self._card_glow, 0.6, { ImageTransparency = 0.45 })
	self:_emit(if rid == "legendary" then 34 elseif rid == "epic" then 22 else 12, {
		x = self._card_pos.X.Offset,
		y = self._card_pos.Y.Offset,
		jitter = 0.15,
		spread = 180,
		vmin = 0.8,
		vmax = 2.0,
		kind = "mix",
		streaks = 0.35,
		size = 0.055,
		grav = 1.2,
		drag = 2,
		life = { 0.5, 1.0 },
		colors = { col, col:Lerp(Color3.new(1, 1, 1), 0.4) },
		white = 0.2,
		front = true,
	})
	if rid == "epic" or rid == "legendary" then
		self._shine.Visible = true
		self._shine_grad.Offset = Vector2.new(-1, 0)
		tween(self._shine_grad, 0.9, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Sine)
	end
	-- NEW! (never a duplicate)
	self._new.Visible = true
	self._new_scale.Scale = 0
	tween(self._new_scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	-- the words
	self._rarity.Text = string.upper(rar.name)
	self._rarity.TextColor3 = col:Lerp(Color3.new(1, 1, 1), 0.15)
	self._rarity_scale.Scale = 1.6
	tween(self._rarity_scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	self._name.Text = if it then it.name else "?"
	self._kind.Text = if it and it.kind == "flag" then "FLAG · SHOWN BY YOUR NAME" else "TERRITORY SKIN"
	for i, l in { self._rarity, self._name, self._kind } do
		local p = l.Position
		l.Position = p + UDim2.fromOffset(0, S * 0.03)
		task.delay(0.08 * i * self.pace, function()
			if gen == self._gen then
				tween(l, 0.3, { TextTransparency = 0, Position = p }, Enum.EasingStyle.Back)
				tween(l:FindFirstChildOfClass("UIStroke"), 0.3, { Transparency = 0.2 })
			end
		end)
	end
	if not self:_sleep(gen, 0.5) then
		return
	end
	self._holder.Visible = false
	self._phase = "choose"
	self:refresh_buttons()
	self._row:set_visible(true)
	self._row:set_modulate_a(0)
	W.fade(self._row, 1.0, 0.25)
end

function CrateOpening._show_item(self, it: any)
	local img = self._preview
	if self.show_item ~= nil then
		-- (the Locker's: skins from the uploaded preview atlas, flags from theirs)
		self.show_item(img, it)
		return
	end
	img.ImageRectOffset = Vector2.zero
	img.ImageRectSize = Vector2.zero
	img.ImageContent = Content.none
	img.Image = ""
	if it == nil then
		return
	end
	if it.kind == "flag" then
		img.ResampleMode = Enum.ResamplerMode.Default
		img.Image = Cosmetics.flag_image(it)
		img.ImageRectOffset = Vector2.new(it.x, it.y)
		img.ImageRectSize = Vector2.new(it.w, it.h)
	elseif self.preview_of ~= nil then
		img.ResampleMode = Enum.ResamplerMode.Pixelated
		local ed = self.preview_of(it)
		if ed ~= nil then
			img.ImageContent = Content.fromObject(ed)
		end
	end
end

--- The buttons under the card: WEAR IT (unless worn) · the next crate · DONE.
function CrateOpening.refresh_buttons(self)
	local info = if self.info_of then self.info_of() else (self._info or {})
	local it = Cosmetics.item(self._item)
	local wearing = it ~= nil and info.wearing ~= nil and info.wearing(it.kind) == it.id
	self._wear_b:set_disabled(wearing)
	self._wear_b:set_text(if wearing then "WEARING" else "WEAR IT")
	self._again_b:set_visible(info.can_more == true)
	if (info.crates or 0) > 0 then
		self._again_b:set_icon("crate")
		self._again_b:set_text(if info.crates > 1 then string.format("OPEN NEXT (%d)", info.crates) else "OPEN NEXT")
	else
		self._again_b:set_icon("robux")
		self._again_b:set_text(string.format("ANOTHER · %d", info.price or 49))
	end
	self:_layout()
end

-- ---------------------------------------------------------------------------------------------
-- Per frame
-- ---------------------------------------------------------------------------------------------

function CrateOpening._kick(self, px: number)
	self._shake = math.max(self._shake or 0, px)
end

function CrateOpening._step(self, dt: number)
	if not self.is_open then
		return
	end
	dt = math.min(dt, 0.1)
	self._t += dt
	local t = self._t
	local S = self._S or 300
	local P = self._P
	self:_step_anims(dt)
	-- idle: bob, and a wiggle now and then with a rattle, the lid cracking and light leaking out
	local id = self._idle_st
	if id ~= nil and self._phase == "idle" then
		id.t += dt
		P.y = math.sin(id.t * 2.4) * 0.08
		if id.t >= id.next and id.wt < 0 then
			id.wt = 0
			self.ctx:sfx("crate_rattle", -4, 0.06)
			local seam = self:_project(v3(Model.seam))
			self:_emit(3, {
				x = seam.X,
				y = seam.Y,
				jitter = 0.12,
				dir = -90,
				spread = 55,
				vmin = 0.3,
				vmax = 0.7,
				size = 0.045,
				grav = 0.4,
				drag = 1.6,
				life = { 0.45, 0.8 },
				colors = { GOLD_LIGHT, GOLD },
				front = true,
			})
		end
		if id.wt >= 0 then
			id.wt += dt
			local k = id.wt / 0.36
			if k >= 1 then
				id.wt = -1
				id.next = id.t + CrateOpening.WIGGLE_EVERY_S
				P.roll, P.yaw, P.lid = 0, 0, 0
			else
				local wig = math.sin(k * math.pi * 3) * (1 - k) * math.rad(5)
				P.roll = wig
				P.yaw = wig * 0.6
				P.lid = math.sin(k * math.pi) * 7
			end
		end
		self._hint_scale.Scale = 1 + 0.04 * (0.5 + 0.5 * math.sin(t * 4.2))
		-- rising sparkles around the chest
		if math.random() < dt * 5 then
			local mid = self:_project(Vector3.new(0, Model.size[2] * 0.4, 0))
			self:_emit(1, {
				x = mid.X,
				y = mid.Y,
				jitter = 0.32,
				dir = -90,
				spread = 15,
				vmin = 0.06,
				vmax = 0.16,
				size = 0.04,
				grav = -0.05,
				drag = 0.2,
				life = { 0.9, 1.6 },
				colors = { GOLD_LIGHT, GOLD },
			})
		end
		self._chest_glow.ImageTransparency = 0.6 - 0.12 * (0.5 + 0.5 * math.sin(t * 4.2))
	end
	-- the build-up: rattles, each a hop with one damped swing and the lid popping (distinct jolts, not a
	-- continuous jitter, which looked glitchy once the chest was tapped open, 2026-09-29), closer
	-- together and bigger as it builds; the chest swells; the light turns the
	-- rarity colour
	local b = self._build_st
	if b ~= nil and self._phase == "build" then
		local k = b.k
		if b.jt == nil and b.t >= (b.next or 0) then
			b.jt = 0.0
			b.dir = -(b.dir or -1)
			self.ctx:sfx("crate_rattle", -4 + 3 * k, 0, 1 + 0.3 * k)
			self:_kick(S * (0.004 + 0.01 * k))
			local seam = self:_project(v3(Model.seam))
			self:_emit(2 + math.floor(4 * k), {
				x = seam.X,
				y = seam.Y,
				jitter = 0.18,
				dir = -90,
				spread = 65,
				vmin = 0.5,
				vmax = 1.2,
				kind = "mix",
				streaks = 0.5,
				size = 0.045,
				grav = 1.0,
				drag = 1.4,
				life = { 0.35, 0.7 },
				colors = { self._light },
				white = 0.2,
				front = true,
			})
		end
		local roll, y, lid, sq = 0.0, 0.0, 0.0, 0.0
		if b.jt ~= nil then
			b.jt += dt
			local q = b.jt / CrateOpening.JOLT_S
			if q >= 1 then
				b.jt = nil
				b.next = b.t + CrateOpening.JOLT_GAP_S[1] + (CrateOpening.JOLT_GAP_S[2] - CrateOpening.JOLT_GAP_S[1]) * k
			else
				local hump = math.sin(q * math.pi)
				roll = math.sin(q * math.pi * 2) * (1 - q) * math.rad(5 + 7 * k) * b.dir
				y = hump * (0.12 + 0.3 * k)
				lid = hump * (6 + 14 * k)
				sq = -0.05 * hump
			end
		end
		-- (eases in from the idle pose over the first frames)
		local e = math.min(1, b.t / 0.1)
		local f = b.from
		P.roll = f.roll + (roll - f.roll) * e
		P.yaw = f.yaw + (roll * 0.5 - f.yaw) * e
		P.y = f.y + (y - f.y) * e
		P.lid = f.lid + (lid - f.lid) * e
		P.sq = sq
		P.s = 1 + 0.07 * k
		local target = if self._rar then c3(self._rar.color):Lerp(Color3.new(1, 1, 1), 0.3) else GOLD_LIGHT
		if k > 0.3 then
			self._light = self._light:Lerp(target, math.min(1, dt * 4))
		end
		self._chest_glow.ImageColor3 = self._light
		self._chest_glow.ImageTransparency = 0.55 - 0.3 * k
		self._leak.ImageColor3, self._leak_flare.ImageColor3 = self._light, self._light
		self._vpf.Ambient = AMBIENT:Lerp(self._light, 0.3 * k)
		if self._rar ~= nil and (self._rar.id == "legendary" or self._rar.id == "epic") then
			-- the rarer ones tease with rays behind the chest
			local legend = self._rar.id == "legendary"
			self._rays_a.ImageColor3 = self._light
			self._rays_b.ImageColor3 = self._light
			self._rays_a.ImageTransparency = 1 - (if legend then 0.55 else 0.35) * k
			self._rays_b.ImageTransparency = 1 - (if legend then 0.35 else 0.2) * k
			self._rays_spin = 10 + 50 * k
		end
	end
	-- falling: air streaks rushing past
	if self._falling and math.random() < dt * 60 then
		local c = self:_project(Vector3.new(0, Model.size[2] * 0.5, 0))
		self:_emit(1, {
			x = c.X,
			y = c.Y,
			jitter = 0.34,
			dir = -90,
			spread = 2,
			vmin = 3.0,
			vmax = 4.6,
			kind = "streak",
			size = 0.14,
			drag = 0,
			life = { 0.12, 0.22 },
			base = 0.55,
			colors = { GOLD_LIGHT },
		})
	end
	-- the card: while it holds face down it glows and (the rarer ones) shakes; then it breathes
	local hold = self._card_hold
	if hold ~= nil then
		hold.t += dt
		local strong = hold.rid == "legendary" or hold.rid == "epic"
		local k = math.clamp(hold.t / (CrateOpening.CARD_HOLD_S[hold.rid] or 0.2), 0, 1)
		if strong then
			self._card.Rotation = math.sin(t * (30 + 20 * k)) * (2 + 5 * k)
			self._card_scale.Scale = 1 + 0.06 * k
		end
		self._card_glow.ImageTransparency = 0.35 - 0.2 * k * (0.5 + 0.5 * math.sin(t * 18))
		if strong and math.random() < dt * 22 then
			self:_emit(1, {
				x = self._card_pos.X.Offset,
				y = self._card_pos.Y.Offset,
				jitter = 0.3,
				dir = -90,
				spread = 40,
				vmin = 0.2,
				vmax = 0.6,
				size = 0.045,
				grav = -0.2,
				drag = 0.8,
				life = { 0.5, 0.9 },
				colors = { self._card_glow.ImageColor3 },
				white = 0.3,
				front = true,
			})
		end
	elseif self._phase == "choose" then
		self._card.Rotation = math.sin(t * 1.6) * 1.2
	end
	-- rays spin (and slow back down after the burst)
	if self._phase ~= "build" then
		self._rays_spin += (10 - self._rays_spin) * math.min(1, dt * 1.2)
	end
	self._rays_a.Rotation = (self._rays_a.Rotation + dt * self._rays_spin) % 360
	self._rays_b.Rotation = (self._rays_b.Rotation - dt * self._rays_spin * 0.6) % 360
	if self._rays_grad.Enabled then
		self._rays_grad.Rotation = (self._rays_grad.Rotation + dt * 90) % 360
	end
	-- the chest and what rides on it: the shadow, the leak at the seam, the light in its mouth
	if self._holder.Visible then
		self:_apply_pose()
		place(self._shadow, self:_project(Vector3.zero) + Vector2.new(0, S * 0.01))
		-- (smaller and fainter while it's still up in the air)
		local near = math.clamp(1 + P.hy / 1.8, 0, 1)
		local sw = S * 0.85 * P.hs * (0.3 + 0.7 * near)
		self._shadow.Size = UDim2.fromOffset(sw, sw * 0.2)
		if self._phase == "land" or self._phase == "idle" or self._phase == "build" or self._phase == "burst" then
			self._shadow.ImageTransparency = 0.92 - 0.52 * near
		end
		local seam = self:_project(v3(Model.seam))
		place(self._leak, seam)
		place(self._leak_flare, seam)
		self._leak.Size = UDim2.fromOffset(S * 0.6 * P.hs, S * 0.16 * P.hs)
		self._leak_flare.Size = UDim2.fromOffset(S * 0.95 * P.hs, S * 0.08 * P.hs)
		local la = if P.lid < 60 then math.clamp(P.lid / 9, 0, 1) else 0
		self._leak.ImageTransparency = 1 - la * 0.75
		self._leak_flare.ImageTransparency = 1 - la * 0.65
		place(self._chest_glow, self:_project(Vector3.new(0, Model.size[2] * 0.42, 0)))
		self._chest_glow.Size = UDim2.fromOffset(S * 1.25 * P.hs, S * 1.05 * P.hs)
		place(self._mouth_glow, self:_project(v3(Model.mouth)))
		self._mouth_glow.Size = UDim2.fromOffset(S * 0.9 * P.hs, S * 0.5 * P.hs)
	end
	self:_step_particles(dt)
	-- the screen shake
	if (self._shake or 0) > 0.3 then
		self._shake *= math.exp(-dt * 8)
		self._stage.Position = UDim2.fromOffset((math.random() - 0.5) * self._shake, (math.random() - 0.5) * self._shake)
	elseif self._stage.Position ~= UDim2.new() then
		self._shake = 0
		self._stage.Position = UDim2.new()
	end
end

-- ---------------------------------------------------------------------------------------------
-- Particles (image sparks: sparkle / streak / dust; speeds and sizes in stage units S)
-- ---------------------------------------------------------------------------------------------

function CrateOpening._emit(self, n: number, o: any)
	local art = UITheme.crate_art()
	local S = self._S or 300
	local parent = if o.front then self._front_fx else self._back_fx
	local cols = o.colors or { GOLD_LIGHT }
	for _ = 1, n do
		if #self._particles >= CrateOpening.MAX_PARTICLES then
			return
		end
		local kind = o.kind or "sparkle"
		if kind == "mix" then
			kind = if math.random() < (o.streaks or 0.5) then "streak" else "sparkle"
		end
		local a = math.rad((o.dir or -90) + (math.random() * 2 - 1) * (o.spread or 180))
		local vmin, vmax = o.vmin or 0.5, o.vmax or 1.0
		local sp = S * (vmin + math.random() * (vmax - vmin))
		local j = (o.jitter or 0) * S
		local x = o.x + (math.random() * 2 - 1) * j
		local y = o.y + (math.random() * 2 - 1) * j * 0.5
		local col = if math.random() < (o.white or 0) then Color3.new(1, 1, 1) else cols[math.random(1, #cols)]
		local size = S * (o.size or 0.05) * (0.7 + math.random() * 0.6)
		local w, h = size, size
		if kind == "streak" then
			w, h = size * 0.3, size * 2.6
		end
		local life = o.life or { 0.6, 1.0 }
		local base = o.base or 0
		local img = new("ImageLabel", {
			BackgroundTransparency = 1,
			Image = (if kind == "dust" then art.glow elseif kind == "streak" then art.streak else art.sparkle) or "",
			ImageColor3 = col,
			ImageTransparency = base,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(w, h),
			Position = UDim2.fromOffset(x, y),
			ZIndex = parent.ZIndex,
		}, parent)
		table.insert(self._particles, {
			img = img,
			x = x,
			y = y,
			vx = math.cos(a) * sp,
			vy = math.sin(a) * sp,
			grav = (o.grav or 0) * S,
			drag = o.drag or 1.5,
			spin = if kind == "sparkle" then (math.random() - 0.5) * 540 else 0,
			align = kind == "streak",
			grow = o.grow or 0,
			w = w,
			h = h,
			base = base,
			life = 0.0,
			ttl = life[1] + math.random() * (life[2] - life[1]),
		})
	end
end

function CrateOpening._step_particles(self, dt: number)
	for i = #self._particles, 1, -1 do
		local p = self._particles[i]
		p.life += dt
		if p.life >= p.ttl then
			p.img:Destroy()
			table.remove(self._particles, i)
		else
			local d = math.exp(-dt * p.drag)
			p.vx *= d
			p.vy = p.vy * d + p.grav * dt
			p.x += p.vx * dt
			p.y += p.vy * dt
			local k = p.life / p.ttl
			local img = p.img
			img.Position = UDim2.fromOffset(p.x, p.y)
			if p.align then
				img.Rotation = math.deg(math.atan2(p.vy, p.vx)) - 90
			elseif p.spin ~= 0 then
				img.Rotation += p.spin * dt
			end
			if p.grow > 0 then
				local g = 1 + p.grow * k
				img.Size = UDim2.fromOffset(p.w * g, p.h * g)
			end
			img.ImageTransparency = p.base + (1 - p.base) * k * k
		end
	end
end

function CrateOpening._clear_particles(self)
	for _, p in self._particles do
		p.img:Destroy()
	end
	table.clear(self._particles)
end

-- ---------------------------------------------------------------------------------------------
-- Close
-- ---------------------------------------------------------------------------------------------

function CrateOpening.close(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	self._gen += 1
	self._phase = "off"
	self._idle_st, self._build_st, self._card_hold = nil, nil, nil
	self._falling = false
	self._row:set_visible(false)
	tween(self._dim, 0.2, { BackgroundTransparency = 1 })
	for _, i in {
		self._rays_a,
		self._rays_b,
		self._halo,
		self._tint,
		self._preview,
		self._card_glow,
		self._chest_glow,
		self._mouth_glow,
		self._shadow,
		self._leak,
		self._leak_flare,
		self._beam,
		self._floor_ring,
	} do
		tween(i, 0.18, { ImageTransparency = 1 })
	end
	tween(self._vpf, 0.18, { ImageTransparency = 1 })
	self._card.Visible = false
	for _, l in { self._rarity, self._name, self._kind, self._title, self._subtitle, self._hint_text } do
		tween(l, 0.15, { TextTransparency = 1 })
		local st = l:FindFirstChildOfClass("UIStroke")
		if st then
			tween(st, 0.15, { Transparency = 1 })
		end
	end
	tween(self._hint, 0.15, { BackgroundTransparency = 1 })
	tween(self._hint_stroke, 0.15, { Transparency = 1 })
	local gen = self._gen
	task.delay(0.22, function()
		if gen == self._gen and not self.is_open then
			self:_clear_particles()
			self:set_visible(false)
			if self._conn then
				self._conn:Disconnect()
				self._conn = nil
			end
		end
	end)
	self.shown:Fire(false)
	self.closed:Fire(self._fail)
end

return CrateOpening
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">EventFeed</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/event_feed.gd (UIEventFeed)
-- Lower-left event feed: stacking toasts coloured by message category that fade on their own,
-- plus actionable alliance cards with an expiry bar: requests (Accept / Decline) and the
-- "about to expire" renewal prompt (Renew / Ignore). Phones show one
-- single-line toast at a time (a newer one replaces it; a tap dismisses it) and one-row cards.
--
-- EventFeed.new(ctx, top_mode = false). Members: _stack, top_mode.
-- Methods: apply_layout(bottom_y), apply_layout_top(y), stack_rect(), clear(),
-- toast(category, text, icon_name?, seconds?), alliance_request(from_id), close_request(from_id),
-- alliance_renewal(other, expires_at, other_asked), close_renewal(other), has_renewal_card(other),
-- close_all_requests(), has_request_card(from_id); per frame update(dt).

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local FillBar = require("./FillBar")

local EventFeed = W.class(W.Control)

EventFeed.TOAST_SECONDS = 6.5
EventFeed.INFO_SECONDS = 4.0
EventFeed.ALERT_SECONDS = 9.0
--- Phones: short lives, one line.
EventFeed.PHONE_INFO_SECONDS = 2.5
EventFeed.PHONE_SECONDS = 3.5
EventFeed.PHONE_ALERT_SECONDS = 5.0
--- Phones: a toast's widest (longer text ends in "…"), its text, and an alliance row's buttons.
--- Smaller since 2026-10-10 ("notifs on mobile should be smaller"): 360 wide, 12 pt and 44 pt buttons
--- made a toast half a small phone's width and an alliance row a seventh of its height.
EventFeed.PHONE_MAX_W = 260.0
EventFeed.PHONE_FONT = 11
EventFeed.PHONE_BUTTON = 32.0

local function msec(): number
	return os.clock() * 1000.0
end

local function Defs(): any
	return UITheme.core("Defs")
end

function EventFeed.new(c: any, top: boolean?)
	local self = setmetatable({}, EventFeed.__mt)
	W.Control._init(self)
	self.ctx = c
	--- Top-centre variant (session notices): grows downwards, visible on every screen.
	self.top_mode = top == true
	self._cards = {} -- from owner id -> request card
	self._recent = {} -- text -> {node, count, msec, badge}
	self._bottom = 120.0
	self._top_limit = 340.0
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._stack = UITheme.vbox(8)
	self._stack:set_alignment(if self.top_mode then W.ALIGN_BEGIN else W.ALIGN_END)
	self:add_child(self._stack)
	return self
end

--- Top-centre placement for notices.
function EventFeed.apply_layout_top(self, y: number)
	local ctx = self.ctx
	local w = if not ctx.compact then 520.0 else 380.0
	local st = self._stack
	st.anchor_left, st.anchor_right, st.anchor_top, st.anchor_bottom = 0.5, 0.5, 0.0, 0.0
	st.grow_horizontal = W.GROW_BOTH
	st.grow_vertical = W.GROW_END
	w = math.min(w, ctx.vp.X - ctx.insets.x - ctx.insets.z - 24.0)
	local dx, yy = ctx:place_top(w, y)
	st.offset_left = dx - w * 0.5
	st.offset_right = dx + w * 0.5
	st.offset_top = yy
	st.offset_bottom = yy
	st:set_min_size(Vector2.new(w, 0))
	self._bottom = ctx.vp.Y
	self._top_limit = 0.0
end

function EventFeed.apply_layout(self, bottom_y: number)
	local ctx = self.ctx
	local st = self._stack
	self._bottom = bottom_y
	if ctx.compact then
		-- Phones: a narrow column under the top bar (top-left), clear of the globe's centre and of
		-- the bottom-left thumb area where target / inspect cards appear.
		local lx = 8.0 + ctx.insets.x
		local cw = 0.0 -- cards and toasts size to their content
		local ty = ctx.airship_bar.Max.Y + 2.0
		st.anchor_left, st.anchor_right, st.anchor_top, st.anchor_bottom = 0.0, 0.0, 0.0, 0.0
		st.grow_vertical = W.GROW_END
		st.grow_horizontal = W.GROW_END
		st:set_alignment(W.ALIGN_BEGIN)
		st.offset_left = lx
		st.offset_right = lx + cw
		st.offset_top = ty
		st.offset_bottom = ty
		st:set_min_size(Vector2.new(cw, 0))
		self._top_limit = ty
		st:queue_layout()
		self:_trim()
		return
	end
	st:set_alignment(W.ALIGN_END)
	local left = if not ctx.compact then 16.0 + ctx.insets.x else 8.0 + ctx.insets.x
	local w = if not ctx.compact then 340.0 else 290.0
	st.anchor_left, st.anchor_right, st.anchor_top, st.anchor_bottom = 0.0, 0.0, 1.0, 1.0
	st.grow_vertical = W.GROW_BEGIN
	st.grow_horizontal = W.GROW_END
	st.offset_left = left
	st.offset_right = left + w
	st.offset_bottom = -(ctx.vp.Y - bottom_y)
	st.offset_top = st.offset_bottom
	st:set_min_size(Vector2.new(w, 0))
	-- Never grow into the reserved top-left area (Roblox top bar / chat).
	local reserved = if not ctx.compact then ctx.reserved_top_left.Max.Y else 64.0
	self._top_limit = reserved + 12.0 + ctx.insets.y
	st:queue_layout()
	self:_trim()
end

function EventFeed.stack_rect(self): Rect
	if self:is_visible_in_tree() then
		return self._stack:get_global_rect()
	end
	return Rect.new(0, 0, 0, 0)
end

function EventFeed.clear(self)
	for _, ch in ipairs(self._stack:get_children()) do
		ch:queue_free()
	end
	table.clear(self._cards)
	table.clear(self._recent)
end

-- ---------------------------------------------------------------------------------------------
-- Toasts
-- ---------------------------------------------------------------------------------------------

function EventFeed.toast(self, category: number, text: string, icon_name: string?, seconds: number?)
	local ctx = self.ctx
	local T = UITheme
	local D = Defs()
	if text == nil or string.match(text, "^%s*$") then
		return
	end
	local icon = icon_name or ""
	local secs = seconds or -1.0
	local now = msec()
	local prev = self._recent[text]
	if prev ~= nil and not prev.node._freed and now - prev.msec < 4000 then
		prev.count += 1
		prev.msec = now
		prev.badge:set_text(string.format("×%d", prev.count))
		prev.badge:set_visible(true)
		prev.node:set_meta(
			"expire",
			now + (if ctx.compact then EventFeed.PHONE_SECONDS else EventFeed.TOAST_SECONDS) * 1000.0
		)
		return
	end
	if ctx.compact and not self.top_mode then
		self:_toast_line(category, text, icon, secs)
		return
	end
	local col = T.msg_color(category)
	local card =
		GlassPanel.new(if not ctx.compact then 12.0 else 10.0, if not ctx.compact then 9.0 else 6.0, T.R_MD, true, 12)
	-- On touch a toast must swallow taps (they would otherwise order an attack underneath).
	card:set_mouse_filter(if ctx.touch then W.MOUSE_STOP else W.MOUSE_IGNORE)
	card:set_accent(col)
	local row = T.hbox(10)
	card:add_child(row)
	row:add_child(
		self:_icon_disc(if icon ~= "" then icon else T.msg_icon(category), col, if not ctx.compact then 26.0 else 22.0)
	)
	local l = T.label(text, if not ctx.compact then 13 else 12, 500, T.TEXT)
	l:set_autowrap(true)
	l.size_flags_horizontal = W.EXPAND_FILL
	l:set_min_size(Vector2.new(200, 0))
	l.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(l)
	local badge = T.label("", 11, 700, col)
	badge:set_visible(false)
	badge.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(badge)
	local life = secs
	if life <= 0 then
		if category == D.MSG_ALERT then
			life = EventFeed.ALERT_SECONDS
		elseif category == D.MSG_INFO then
			life = if not ctx.compact then EventFeed.INFO_SECONDS else 3.0
		else
			life = EventFeed.TOAST_SECONDS
		end
	end
	card:set_meta("expire", now + life * 1000.0)
	card:set_meta("kind", "toast")
	self:_add_toast_node(card)
	self._recent[text] = { node = card, count = 1, msec = now, badge = badge }
	W.pop_in(card, 0.0, 0.94, 0.32)
	self:_trim()
end

--- Phones: one short line at a time. A newer toast replaces the current one, except that routine
--- info never pushes out an alert that has barely been seen. Tap to dismiss.
function EventFeed._toast_line(self, category: number, text: string, icon_name: string, seconds: number)
	local ctx = self.ctx
	local T = UITheme
	local D = Defs()
	local now = msec()
	for _, c in ipairs(self._stack:get_children()) do
		if not c:has_meta("leaving") and c:get_meta("kind", "") == "toast" then
			if
				category == D.MSG_INFO
				and c:get_meta("cat", -1) == D.MSG_ALERT
				and now - c:get_meta("born", 0) < 2000
			then
				return
			end
			self._stack:remove_child(c) -- swap in place: the line never jumps
			c:queue_free()
		end
	end
	local col = T.msg_color(category)
	local card = GlassPanel.new(8.0, 2.0, T.R_MD, true, 10)
	card:set_mouse_filter(if ctx.touch then W.MOUSE_STOP else W.MOUSE_IGNORE)
	card.size_flags_horizontal = W.SHRINK_BEGIN
	card:set_accent(col)
	card.gui_input:Connect(function(e)
		if e.kind == "button" and e.button == 1 and not e.pressed then
			self:_remove(card, true)
		end
	end)
	local fs = EventFeed.PHONE_FONT
	local row = T.hbox(5)
	row:set_min_size(Vector2.new(0, 18))
	card:add_child(row)
	local ic = T.icon_rect(if icon_name ~= "" then icon_name else T.msg_icon(category), 11.0, col)
	ic.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(ic)
	local l = T.label(text, fs, 600, T.TEXT)
	l.text_overrun_behavior = W.OVERRUN_ELLIPSIS
	l:set_min_size(Vector2.new(math.min(T.measure_text(text, fs, 600) + 2.0, EventFeed.PHONE_MAX_W), 0))
	l.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(l)
	local badge = T.label("", fs, 700, col)
	badge:set_visible(false)
	badge.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(badge)
	local life = if seconds > 0
		then seconds
		else (if category == D.MSG_ALERT
			then EventFeed.PHONE_ALERT_SECONDS
			else (if category == D.MSG_INFO then EventFeed.PHONE_INFO_SECONDS else EventFeed.PHONE_SECONDS))
	life = math.min(life, EventFeed.PHONE_ALERT_SECONDS)
	card:set_meta("expire", now + life * 1000.0)
	card:set_meta("kind", "toast")
	card:set_meta("cat", category)
	card:set_meta("born", now)
	self:_add_toast_node(card)
	self._recent[text] = { node = card, count = 1, msec = now, badge = badge }
	W.pop_in(card, 0.0, 0.96, 0.2)
	self:_trim()
end

--- Actionable cards never move under a finger: toasts come and go on the far side of them
--- (above the cards in the bottom-anchored desktop stack, below them in the phone column).
function EventFeed._add_toast_node(self, card)
	self._stack:add_child(card)
	if self.top_mode then
		return
	end
	local first_card = -1
	for i, c in ipairs(self._stack.children) do
		if c:get_meta("kind", "") == "card" then
			first_card = i - 1
			break
		end
	end
	if first_card >= 0 and not self.ctx.compact then
		self._stack:move_child(card, first_card)
	end
end

function EventFeed._add_card_node(self, card)
	self._stack:add_child(card)
	if self.ctx.compact and not self.top_mode then
		-- Phone column grows downward: cards first, toasts after them.
		local last_card = -1
		for i, c in ipairs(self._stack.children) do
			if c ~= card and c:get_meta("kind", "") == "card" then
				last_card = i - 1
			end
		end
		self._stack:move_child(card, last_card + 1)
	end
end

function EventFeed._icon_disc(_self, icon_name: string, col: any, px: number)
	local T = UITheme
	local p = W.Panel.new()
	p:set_mouse_filter(W.MOUSE_IGNORE)
	p:set_min_size(Vector2.new(px, px))
	p.size_flags_vertical = W.SHRINK_CENTER
	p:add_theme_stylebox_override("panel", T.flat(T.c(col, 0.16), math.floor(px * 0.5), T.c(col, 0.4), 1))
	local ic = T.icon_rect(icon_name, px * 0.52, col)
	ic.size_flags_horizontal = W.SHRINK_CENTER
	ic.size_flags_vertical = W.SHRINK_CENTER
	p:add_child(ic)
	return p
end

function EventFeed._remove(_self, node, fast: boolean?)
	if node._freed or node:has_meta("leaving") then
		return
	end
	node:set_meta("leaving", true)
	local t = node:create_tween()
	t:tween_property(node, "modulate:a", 0.0, if fast then 0.12 else 0.35)
	t:tween_callback(function()
		node:queue_free()
	end)
end

function EventFeed._trim(self)
	-- Drop the oldest toasts while the stack would reach into the reserved top-left area.
	local ctx = self.ctx
	local guard = 0
	while guard < 12 do
		guard += 1
		local h = 0.0
		local toasts = {}
		for _, c in ipairs(self._stack.children) do
			if not c:has_meta("leaving") then
				h += c:get_combined_minimum_size().Y + 8.0
				if c:get_meta("kind", "") == "toast" then
					table.insert(toasts, c)
				end
			end
		end
		local limit = self._bottom - self._top_limit
		local max_toasts = 5
		if self.top_mode then
			max_toasts = 3
		elseif ctx.compact then
			max_toasts = 1
		end
		if (h <= limit and #toasts <= max_toasts) or #toasts == 0 then
			return
		end
		self._stack:remove_child(toasts[1])
		toasts[1]:queue_free()
	end
end

-- ---------------------------------------------------------------------------------------------
-- Alliance requests
-- ---------------------------------------------------------------------------------------------

--- An incoming alliance request: Accept / Decline, the bar runs out with the request.
function EventFeed.alliance_request(self, from_id: number)
	local ctx = self.ctx
	self:_ally_card(from_id, from_id, {
		text = "proposes an alliance",
		row_text = "wants an alliance",
		yes = "Accept",
		no = "Decline",
		on_yes = function()
			ctx:send({ type = "ally_reply", target = from_id, accept = true })
		end,
		on_no = function()
			ctx:send({ type = "ally_reply", target = from_id, accept = false })
		end,
		tick_start = ctx:render_tick(),
		span = UITheme.core("Rules").ALLY_REQUEST_TICKS,
	})
end

--- The "about to expire" event: the alliance with `other` is in its last
--- ALLIANCE_EXTEND_WINDOW_TICKS; Renew sends ally_extend (renewed once both asked). The bar runs
--- out with the alliance.
function EventFeed.alliance_renewal(self, other: number, expires_at: number, other_asked: boolean)
	local ctx = self.ctx
	local window = UITheme.core("Rules").ALLIANCE_EXTEND_WINDOW_TICKS
	self:_ally_card(-other, other, {
		text = if other_asked then "wants to renew your alliance" else "alliance is about to expire",
		row_text = if other_asked then "wants to renew" else "alliance expiring",
		yes = "Renew",
		no = "Ignore",
		on_yes = function()
			ctx:send({ type = "ally_extend", target = other })
		end,
		on_no = function() end,
		tick_start = expires_at - window,
		span = window,
	})
end

function EventFeed.close_renewal(self, other: number)
	self:close_request(-other)
end

function EventFeed.has_renewal_card(self, other: number): boolean
	return self._cards[-other] ~= nil
end

function EventFeed._ally_card(self, key: number, owner_id: number, spec: { [string]: any })
	local ctx = self.ctx
	local T = UITheme
	local s = ctx.state
	if s == nil or self._cards[key] ~= nil then
		return
	end
	local o = s:get_owner(owner_id)
	if o == nil then
		return
	end
	if ctx.compact then
		self:_alliance_row(key, o, spec)
		return
	end
	local card =
		GlassPanel.new(if not ctx.compact then 14.0 else 10.0, if not ctx.compact then 12.0 else 8.0, T.R_MD, true, 16)
	card:set_accent(T.VIOLET)
	card:set_border(T.c(T.VIOLET, 0.35))
	card:set_meta("kind", "card")
	local v = T.vbox(if not ctx.compact then 8 else 5)
	card:add_child(v)
	local head = T.hbox(10)
	head:add_child(self:_icon_disc("alliance", T.VIOLET, if not ctx.compact then 30.0 else 24.0))
	local tv = T.vbox(0)
	tv.size_flags_horizontal = W.EXPAND_FILL
	local nr = T.hbox(6)
	nr:add_child(T.swatch(o.color, 10.0, 3))
	local nl = T.label(o.name, 14, 700)
	nl.text_overrun_behavior = W.OVERRUN_ELLIPSIS
	nl.size_flags_horizontal = W.EXPAND_FILL
	nl:set_min_size(Vector2.new(60, 0))
	nr:add_child(nl)
	tv:add_child(nr)
	tv:add_child(T.label(spec.text, 12, 500, T.TEXT_2))
	head:add_child(tv)
	v:add_child(head)
	local bar = FillBar.new(3.0, T.VIOLET)
	bar.glow = false
	bar:set_target(1.0, true)
	v:add_child(bar)
	local btns = T.hbox(8)
	local accept = T.button(spec.yes, "PrimaryButton", "", if not ctx.touch then 34.0 else 44.0)
	accept:set_font_size(13)
	accept.size_flags_horizontal = W.EXPAND_FILL
	local decline = T.button(spec.no, "GlassButton", "", if not ctx.touch then 34.0 else 44.0)
	decline:set_font_size(13)
	decline.size_flags_horizontal = W.EXPAND_FILL
	btns:add_child(accept)
	btns:add_child(decline)
	v:add_child(btns)
	accept.pressed:Connect(function()
		spec.on_yes()
		self:close_request(key)
	end)
	decline.pressed:Connect(function()
		spec.on_no()
		self:close_request(key)
	end)
	card:set_meta("tick_start", spec.tick_start)
	card:set_meta("span", spec.span)
	card:set_meta("owner_name", o.name)
	card:set_meta("bar", bar)
	self._cards[key] = card
	self:_add_card_node(card)
	W.pop_in(card, 0.0, 0.92, 0.36)
	self:_trim()
end

--- Phones: one row: [alliance] ■ Name wants an alliance [✓] [✕], with a thin expiry line.
function EventFeed._alliance_row(self, key: number, o: any, spec: { [string]: any })
	local T = UITheme
	local card = GlassPanel.new(8.0, 2.0, T.R_MD, true, 14)
	card:set_accent(T.VIOLET)
	card:set_border(T.c(T.VIOLET, 0.35))
	card:set_meta("kind", "card")
	card.size_flags_horizontal = W.SHRINK_BEGIN
	local v = T.vbox(0)
	card:add_child(v)
	local fs = EventFeed.PHONE_FONT
	local bs = EventFeed.PHONE_BUTTON
	local row = T.hbox(5)
	local ic = T.icon_rect("alliance", 12.0, T.VIOLET)
	ic.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(ic)
	local sw = T.swatch(o.color, 8.0, 2)
	sw.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(sw)
	local nl = T.label(o.name, fs + 1, 700)
	nl.text_overrun_behavior = W.OVERRUN_ELLIPSIS
	nl:set_min_size(Vector2.new(math.min(T.measure_text(o.name, fs + 1, 700) + 2.0, 100.0), 0))
	nl.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(nl)
	local wl = T.label(spec.row_text, fs, 500, T.TEXT_2)
	wl.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(wl)
	local accept = T.button("", "PrimaryButton", "check", bs)
	accept.name = spec.yes
	accept:set_min_size(Vector2.new(bs, bs))
	local decline = T.button("", "GlassButton", "close", bs)
	decline.name = spec.no
	decline:set_min_size(Vector2.new(bs, bs))
	for _, b in ipairs({ accept, decline }) do
		b.expand_icon = true
		b:add_theme_constant_override("icon_max_width", 14)
		b.icon_alignment = W.ALIGN_CENTER
	end
	-- Icon-only buttons: the theme's wide text margins would leave no room for the icon.
	local acc = T.flat(T.AMBER, T.R_MD, T.CLEAR, 0, 4.0, 4.0)
	acc.bw_bottom = 3
	acc.border = T.to_rgba(T.AMBER_LO)
	local acc_h = T.dup(acc)
	acc_h.bg = T.to_rgba(T.AMBER_HI)
	local dec = T.flat(T.FILL, T.R_MD, T.LINE, 1, 4.0, 4.0)
	local dec_h = T.flat(T.FILL_2, T.R_MD, T.LINE_2, 1, 4.0, 4.0)
	for _, st in ipairs(W.BUTTON_STATES) do
		local hot = st ~= "normal" and st ~= "disabled"
		accept:add_theme_stylebox_override(st, if hot then acc_h else acc)
		decline:add_theme_stylebox_override(st, if hot then dec_h else dec)
	end
	row:add_child(accept)
	row:add_child(decline)
	v:add_child(row)
	local bar = FillBar.new(2.0, T.VIOLET)
	bar.glow = false
	bar:set_target(1.0, true)
	v:add_child(bar)
	accept.pressed:Connect(function()
		spec.on_yes()
		self:close_request(key)
	end)
	decline.pressed:Connect(function()
		spec.on_no()
		self:close_request(key)
	end)
	card:set_meta("tick_start", spec.tick_start)
	card:set_meta("span", spec.span)
	card:set_meta("owner_name", o.name)
	card:set_meta("bar", bar)
	self._cards[key] = card
	self:_add_card_node(card)
	W.pop_in(card, 0.0, 0.94, 0.3)
	self:_trim()
end

function EventFeed.close_request(self, from_id: number)
	local card = self._cards[from_id]
	self._cards[from_id] = nil
	if card ~= nil then
		self:_remove(card)
	end
end

function EventFeed.close_all_requests(self)
	local ids = {}
	for id in pairs(self._cards) do
		table.insert(ids, id)
	end
	for _, id in ipairs(ids) do
		self:close_request(id)
	end
end

function EventFeed.has_request_card(self, from_id: number): boolean
	return self._cards[from_id] ~= nil
end

--- Per frame (GDScript _process + _physics_process).
function EventFeed.update(self, _delta: number)
	local now = msec()
	-- (the stack's own list, not a copy a frame: _remove only starts a fade, the node goes later)
	for _, c in ipairs(self._stack.children) do
		local e = c:get_meta("expire", nil)
		if e ~= nil and now > e then
			self:_remove(c)
		end
	end
	-- Expiry bars on alliance cards (drawn again when they move a pixel, 2026-10-27).
	if next(self._cards) == nil then
		return
	end
	local tick = self.ctx:render_tick()
	local done = nil
	for from_id, card in pairs(self._cards) do
		if card._freed then
			done = done or {}
			table.insert(done, from_id)
		else
			local start = card:get_meta("tick_start", tick)
			local left = 1.0 - (tick - start) / math.max(card:get_meta("span", 1), 1)
			local bar = card:get_meta("bar", nil)
			if bar ~= nil then
				bar:set_instant(left)
			end
			if left <= 0 then
				done = done or {}
				table.insert(done, from_id)
			end
		end
	end
	if done ~= nil then
		for _, id in ipairs(done) do
			self:close_request(id)
		end
	end
end

return EventFeed
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">FillBar</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/fill_bar.gd (UIBar)
-- Rounded progress track with an animated fill, optional goal line and value markers.

local UITheme = require("./UITheme")
local W = require("./Widgets")

local FillBar = W.class(W.Control)

--- UIBar.new(h = 4, c = CYAN)
function FillBar.new(h: number?, c: any?)
	local self = setmetatable({}, FillBar.__mt)
	W.Control._init(self)
	self.value = 0.0 -- 0..1 (animated towards target)
	self.target = 0.0
	self.fill_color = c or UITheme.CYAN
	self.fill_color_2 = UITheme.CLEAR -- optional right-end colour (gradient)
	self.track_color = UITheme.rgba(1, 1, 1, 0.08)
	self.goal = -1.0 -- 0..1 goal line (e.g. 0.8 to win)
	self.goal_color = UITheme.GOLD
	--- {{v: number, color: Color3}} thin vertical ticks (e.g. the leader's share).
	self.markers = {}
	self.glow = true
	self.bar_height = h or 4.0
	self:set_min_size(Vector2.new(40, self.bar_height))
	self:set_mouse_filter(W.MOUSE_IGNORE)
	local g = self.gui
	local function frame(name: string, z: number): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.zero
		f.ZIndex = z
		f.Active = false
		f.Parent = g
		return f
	end
	self._track = frame("Track", 1)
	self._track_c = Instance.new("UICorner")
	self._track_c.Parent = self._track
	self._glow = frame("Glow", 2)
	self._glow_c = Instance.new("UICorner")
	self._glow_c.Parent = self._glow
	self._fill = frame("Fill", 3)
	self._fill_c = Instance.new("UICorner")
	self._fill_c.Parent = self._fill
	self._grad = nil
	self._goal = frame("Goal", 5)
	self._marks = {}
	return self
end

function FillBar.set_target(self, v: number, instant: boolean?)
	self.target = math.clamp(v, 0, 1)
	if instant then
		self.value = self.target
	end
	if math.abs(self.value - self.target) > 1e-6 then
		self:set_process(true)
	end
	self:queue_redraw()
end

--- The fill's pixel edges at the current value (what _redraw's fill and glow depend on; -1: none).
local function fill_px(self): number
	local fw = self.size.X * self.value
	if not (fw > 0.5) then
		return -1
	end
	local frw = math.max(fw, self.bar_height)
	local s = UITheme.scale
	return math.floor(frw * s + 0.5) * 65536 + math.floor((-1.5 + (frw + 3)) * s + 0.5)
end

--- Straight to `v` (as set_target(v, true)), drawn again only when that moves the fill a pixel: for a
--- bar whose colours, goal and markers stay as they are (an alliance card's countdown, set every
--- frame: ~20 writes a draw for a bar that moves a pixel every few frames, 2026-10-27).
function FillBar.set_instant(self, v: number)
	local t = math.clamp(v, 0, 1)
	self.target = t
	self.value = t
	if self._geo ~= nil and self._drawn_px ~= nil and self._drawn_px == fill_px(self) then
		return
	end
	self:queue_redraw()
end

function FillBar._process(self, delta: number)
	if math.abs(self.value - self.target) > 1e-6 then
		self.value = self.value + (self.target - self.value) * (1 - math.exp(-delta * 6.0))
		if math.abs(self.value - self.target) < 0.0005 then
			self.value = self.target
		end
		self:_redraw()
	else
		self:set_process(false)
	end
end

function FillBar._on_geometry(self)
	self:_redraw()
end

function FillBar._restyle(self)
	self:_redraw()
end

local function set_rect(f: GuiObject, x: number, y: number, w: number, h: number)
	local s = UITheme.scale
	local x0 = math.floor(x * s + 0.5)
	local y0 = math.floor(y * s + 0.5)
	local x1 = math.floor((x + w) * s + 0.5)
	local y1 = math.floor((y + h) * s + 0.5)
	f.Position = UDim2.fromOffset(x0, y0)
	f.Size = UDim2.fromOffset(math.max(0, x1 - x0), math.max(0, y1 - y0))
end

function FillBar._redraw(self)
	if self._geo == nil then
		return
	end
	local s = UITheme.scale
	local h = self.bar_height
	local y = (self.size.Y - h) * 0.5
	local w = self.size.X
	local r = h * 0.5
	set_rect(self._track, 0, y, w, h)
	self._track_c.CornerRadius = UDim.new(0, math.floor(math.min(r, h * 0.5) * s + 0.5))
	self._track.BackgroundColor3 = UITheme.color3(self.track_color)
	self:_part(self._track, "BackgroundTransparency", UITheme.alpha(self.track_color))
	local fw = w * self.value
	local show = fw > 0.5
	self._fill.Visible = show
	self._glow.Visible = show and self.glow
	if show then
		local frw = math.max(fw, h)
		local fc = UITheme.to_rgba(self.fill_color)
		if self.glow then
			set_rect(self._glow, -1.5, y - 1.5, frw + 3, h + 3)
			self._glow_c.CornerRadius = UDim.new(0, math.floor((r + 1.5) * s + 0.5))
			self._glow.BackgroundColor3 = fc.color
			self:_part(self._glow, "BackgroundTransparency", 0.22)
		end
		set_rect(self._fill, 0, y, frw, h)
		self._fill.BackgroundColor3 = fc.color
		self:_part(self._fill, "BackgroundTransparency", fc.alpha)
		local c2 = UITheme.to_rgba(self.fill_color_2)
		if c2.alpha > 0 then
			-- gradient fill (Godot draws a square-cornered polygon)
			self._fill_c.CornerRadius = UDim.new(0, 0)
			self._fill.BackgroundColor3 = Color3.new(1, 1, 1)
			if self._grad == nil then
				self._grad = Instance.new("UIGradient")
				self._grad.Parent = self._fill
			end
			self._grad.Color = ColorSequence.new(fc.color, c2.color)
		else
			self._fill_c.CornerRadius = UDim.new(0, math.floor(r * s + 0.5))
			if self._grad then
				self._grad:Destroy()
				self._grad = nil
			end
		end
	end
	if self.goal >= 0 then
		local gx = math.floor(w * self.goal + 0.5)
		self._goal.Visible = true
		set_rect(self._goal, gx - 1, y - 4, 2, h + 8)
		self._goal.BackgroundColor3 = UITheme.color3(self.goal_color)
		self:_part(self._goal, "BackgroundTransparency", UITheme.alpha(self.goal_color))
	else
		self._goal.Visible = false
	end
	for i, m in ipairs(self.markers) do
		local pair = self._marks[i]
		if pair == nil then
			local dark = Instance.new("Frame")
			dark.BorderSizePixel = 0
			dark.AnchorPoint = Vector2.zero
			dark.ZIndex = 6
			dark.BackgroundColor3 = Color3.new(0, 0, 0)
			dark.Parent = self.gui
			local lit = Instance.new("Frame")
			lit.BorderSizePixel = 0
			lit.AnchorPoint = Vector2.zero
			lit.ZIndex = 7
			lit.Parent = self.gui
			pair = { dark, lit }
			self._marks[i] = pair
		end
		local mx = math.floor(w * math.clamp(m.v or 0, 0, 1) + 0.5)
		pair[1].Visible = true
		pair[2].Visible = true
		set_rect(pair[1], mx - 2, y - 3, 4, h + 6)
		self:_part(pair[1], "BackgroundTransparency", 0.6)
		set_rect(pair[2], mx - 1, y - 3, 2, h + 6)
		local mc = UITheme.to_rgba(m.color or UITheme.TEXT)
		pair[2].BackgroundColor3 = mc.color
		self:_part(pair[2], "BackgroundTransparency", mc.alpha)
	end
	for i = #self.markers + 1, #self._marks do
		self._marks[i][1].Visible = false
		self._marks[i][2].Visible = false
	end
	self._drawn_px = fill_px(self)
end

return FillBar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">FlagShop</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The flag shop (2026-10-22: a daily rotating shop of flags for sale; Data/Shop,
-- docs/flag-shop.md): a modal from the title's shop button. A running limited set first (Halloween:
-- the whole set, ENDS IN its clock), then today's flags (Data/Shop.daily, NEW IN the clock to 00:00 UTC).
-- Each card: the flag, its name and rarity, and its button: the price (Roblox's for this player:
-- UI/Prices), WEAR for one owned, WEARING for the one on. A purchase goes like the Locker's: Roblox's
-- prompt, the server stores the flag and puts it on (server/Purchases), the card turns to WEARING.
-- 2026-10-24 (from the analytics suggestions): a section's Legendary gets a FEATURED card two
-- cards wide and two tall, and a set with a bundle (Data/Shop.SETS `bundle`) a banner under its head:
-- all of it for one price, what that saves, flags already owned paying back Stars.
-- Signals: closed.
local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local Prices = require("./Prices")
local Signal = UITheme.core("Signal")

local IS_ROBLOX = typeof(game) == "Instance"
local function shared(name: string): any
	if IS_ROBLOX then
		return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data[name]) :: any
	end
	return (require :: any)("../../shared/Data/" .. name)
end
local Shop = shared("Shop")
local Cosmetics = shared("Cosmetics")
local ShopLayout = require("./ShopLayout")
local Products = shared("Products")

local FlagShop = W.class(W.Control)

--- A card, logical px (phones: CARD_PHONE).
FlagShop.CARD = Vector2.new(150, 178)
FlagShop.CARD_PHONE = Vector2.new(124, 152)
FlagShop.GAP = 10
--- Cards in a row on desktop (the window is as wide as that).
FlagShop.COLS = 4
--- After a purchase, how long the card waits for the server's word before saying it's on its way.
FlagShop.GRANT_WAIT_S = 30
--- The bundle banner's height (logical px).
FlagShop.BANNER_H = 46

local FONT = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Bold)
local FONT_H = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Heavy)
local FONT_M = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Medium)
local ROBUX = "rbxasset://textures/ui/common/robux@3x.png"
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 200, 61)
local PUMPKIN = Color3.fromRGB(255, 140, 40)
local MUTED = Color3.fromRGB(160, 168, 190)

local function c3(hex: number): Color3
	return Color3.fromRGB((hex // 65536) % 256, (hex // 256) % 256, hex % 256)
end

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

--- "5:12:09" under a day, "3d 4h" past it.
function FlagShop.clock(s: number): string
	s = math.max(0, math.floor(s))
	if s >= 86400 then
		return string.format("%dd %dh", s // 86400, (s % 86400) // 3600)
	end
	return string.format("%d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
end

--- Unix time as the server has it (every client agrees on the day).
function FlagShop.now(): number
	if IS_ROBLOX then
		local ok, t = pcall(function()
			return workspace:GetServerTimeNow()
		end)
		if ok and type(t) == "number" then
			return t
		end
	end
	return os.time()
end

--- What the shop shows at `t`: { day, sets = Shop.sets(t), daily = { keys } }.
function FlagShop.contents(t: number): any
	return { day = Shop.day(t), sets = Shop.sets(t), daily = Shop.daily(Shop.day(t)) }
end

--- The shop has something to sell here: a flag whose product exists (Studio: always).
function FlagShop.on_sale(): boolean
	if IS_ROBLOX and game:GetService("RunService"):IsStudio() then
		return #Shop.flags() > 0
	end
	for _, f in Shop.flags() do
		local p = Products["shop_" .. f.key]
		if p ~= nil and p.id ~= 0 then
			return true
		end
	end
	return false
end

function FlagShop.new(c: any)
	local self = setmetatable({}, FlagShop.__mt)
	W.Control._init(self)
	self.ctx = c
	self.closed = Signal.new()
	self.is_open = false
	self._cards = {}
	self._clocks = {}
	self._pending = nil
	self._day = -1
	self:_connect(Prices.changed:Connect(function()
		if self.is_open then
			self:_rebuild()
		end
	end))
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	self:set_visible(false)
	self._dim = W.ColorRect.new(UITheme.rgba(0.01, 0.015, 0.05, 0.78))
	self._dim:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._dim.gui_input:Connect(function(e)
		-- (a press on the window's own ground reaches the dim too: only one outside it closes)
		if e.pressed and not self._panel:has_global_point(e.global_position) then
			self:close()
		end
	end)
	self:add_child(self._dim)
	self._panel = GlassPanel.new(22.0, 18.0, 18, true, 34)
	self._panel:set_tint(UITheme.rgba(0.045, 0.065, 0.13, 0.96))
	self:add_child(self._panel)
	local v = UITheme.vbox(10)
	self._v = v
	self._panel:add_child(v)
	local head = UITheme.hbox(12)
	local title = UITheme.label("FLAG SHOP", 20, 800, UITheme.TEXT, 3)
	title.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(title)
	self._sub = UITheme.label("New flags every day", 13, 600, UITheme.TEXT_2)
	self._sub.size_flags_horizontal = W.EXPAND_FILL
	self._sub.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(self._sub)
	local close = W.Button.new("", "GhostButton")
	close:set_icon("close")
	close.expand_icon = true
	close:set_min_size(Vector2.new(34, 34))
	close:add_theme_constant_override("icon_max_width", 13)
	close:add_theme_stylebox_override("normal", UITheme.empty_box(8, 8))
	close:add_theme_stylebox_override("hover", UITheme.flat(UITheme.FILL, 8, UITheme.CLEAR, 0, 8, 8))
	close.size_flags_vertical = W.SHRINK_CENTER
	close.pressed:Connect(function()
		self:close()
	end)
	head:add_child(close)
	v:add_child(head)
	local host = W.Control.new()
	host:set_mouse_filter(W.MOUSE_PASS)
	self._host = host
	v:add_child(host)
	local sf = Instance.new("ScrollingFrame")
	sf.Name = "FlagShopList"
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.Size = UDim2.fromScale(1, 1)
	sf.ScrollBarThickness = 6
	sf.ScrollBarImageColor3 = WHITE
	sf.ScrollBarImageTransparency = 0.6
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.CanvasSize = UDim2.new(0, 0, 0, 0)
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	sf.ZIndex = 40
	sf.Parent = host.gui
	host:_part(sf, "ScrollBarImageTransparency", 0.4)
	self._sf = sf
	self._list = new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, sf)
	new("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2) }, sf)
	if IS_ROBLOX then
		game:GetService("MarketplaceService").PromptProductPurchaseFinished:Connect(function(_u, product_id, purchased)
			self:_on_prompt_done(product_id, purchased)
		end)
	end
	return self
end

--- The session's inventory (UIRoot.setup, when the session exists).
function FlagShop.bind(self, s: any)
	if s == nil or self._bound == s then
		return
	end
	self._bound = s
	if s.inventory_changed then
		s.inventory_changed:Connect(function()
			self:_on_inventory()
		end)
	end
end

--- A short notice (UIRoot sets this to its toasts).
function FlagShop._toast(_self, _text: string) end

function FlagShop._report(self, a: string, b: any?)
	local s = self.ctx.session
	if s ~= nil and type(s.report) == "function" then
		s:report("flag_shop", a, b)
	end
end

function FlagShop._inv(self): any
	local s = self.ctx.session
	return if s ~= nil and s.inventory ~= nil then s.inventory else { owned = {}, equipped = {} }
end

-- ---------------------------------------------------------------------------------------------
-- Buying and wearing
-- ---------------------------------------------------------------------------------------------

function FlagShop._pressed(self, key: string)
	local id = Shop.item_id(key)
	local inv = self:_inv()
	local se = self.ctx.session
	if inv.owned[id] == true then
		if inv.equipped.flag ~= id and se ~= nil then
			self.ctx:sfx("click")
			se:equip("flag", id)
		end
		return
	end
	if self._pending ~= nil then
		return
	end
	local p = Products["shop_" .. key]
	if p == nil or p.id == 0 or not IS_ROBLOX then
		self.ctx:sfx("deny", -6.0)
		return
	end
	self:_report("clicked", key)
	self.ctx:sfx("click")
	self._pending = { key = key, product = p.id, phase = "prompt", since = os.clock() }
	self:_rebuild()
	local ok = pcall(function()
		game:GetService("MarketplaceService"):PromptProductPurchase(game:GetService("Players").LocalPlayer, p.id)
	end)
	if not ok then
		self:_cancel("Purchases aren't available right now.")
	end
end

--- A set's bundle (Products "shopset_<id>").
function FlagShop._pressed_set(self, sid: string)
	if self._pending ~= nil then
		return
	end
	local p = Products["shopset_" .. sid]
	if p == nil or p.id == 0 or not IS_ROBLOX then
		self.ctx:sfx("deny", -6.0)
		return
	end
	self:_report("clicked_pack", sid)
	self.ctx:sfx("click")
	self._pending = { set = sid, product = p.id, phase = "prompt", since = os.clock() }
	self:_rebuild()
	local ok = pcall(function()
		game:GetService("MarketplaceService"):PromptProductPurchase(game:GetService("Players").LocalPlayer, p.id)
	end)
	if not ok then
		self:_cancel("Purchases aren't available right now.")
	end
end

--- How many of set `sid`'s flags the player owns, of how many.
function FlagShop._set_owned(self, sid: string): (number, number)
	local inv = self:_inv()
	local keys = Shop.set_keys(sid)
	local n = 0
	for _, k in keys do
		if inv.owned[Shop.item_id(k)] == true then
			n += 1
		end
	end
	return n, #keys
end

function FlagShop._cancel(self, message: string?)
	self._pending = nil
	if message then
		self:_toast(message)
	end
	if self.is_open then
		self:_rebuild()
	end
end

function FlagShop._on_prompt_done(self, product_id: number, purchased: boolean)
	local p = self._pending
	if p == nil or p.phase ~= "prompt" or product_id ~= p.product then
		return
	end
	if not purchased then
		self:_cancel(nil)
		return
	end
	-- bought: the server stores the flag and says so (the inventory)
	p.phase = "grant"
	p.since = os.clock()
	self:_on_inventory()
end

function FlagShop._on_inventory(self)
	local p = self._pending
	if p ~= nil and p.phase == "grant" and p.set ~= nil then
		local n, of = self:_set_owned(p.set)
		if n >= of then
			self._pending = nil
			local set = Shop.SETS[p.set]
			self.ctx:sfx("confirm")
			self:_toast(string.format("All %d %s flags are yours.", of, if set then set.name else ""))
		end
	elseif p ~= nil and p.phase == "grant" and self:_inv().owned[Shop.item_id(p.key)] == true then
		self._pending = nil
		local f = Shop.flag(p.key)
		self.ctx:sfx("confirm")
		self:_toast((if f then f.name else "Your flag") .. " is yours: you're wearing it now.")
	end
	if self.is_open then
		self:_rebuild()
	end
end

function FlagShop.tick(self)
	local p = self._pending
	if p ~= nil then
		local limit = if p.phase == "prompt" then 180 else FlagShop.GRANT_WAIT_S
		if os.clock() - p.since > limit then
			self:_cancel(if p.phase == "prompt" then nil else "Your flag is on its way: it shows up in a moment.")
		end
	end
end

-- ---------------------------------------------------------------------------------------------
-- The list
-- ---------------------------------------------------------------------------------------------

function FlagShop._card_size(self): Vector2
	return if self.ctx.compact then FlagShop.CARD_PHONE else FlagShop.CARD
end

function FlagShop._section(self, order: number, title: string, color: Color3, ends: number, label: string)
	local s = UITheme.scale
	local row = new("Frame", {
		Name = "Head",
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Size = UDim2.new(1, -math.floor(12 * s), 0, math.floor(30 * s)),
		ZIndex = 41,
	}, self._sf)
	local t = new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = FONT_H,
		Text = title,
		TextColor3 = color,
		TextSize = math.floor(15 * s),
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.fromScale(0.62, 1),
		ZIndex = 42,
	}, row)
	local clock = new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = FONT,
		Text = "",
		TextColor3 = MUTED,
		TextSize = math.floor(12 * s),
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(0.38, 1),
		ZIndex = 42,
	}, row)
	table.insert(self._clocks, { label = clock, ends = ends, prefix = label })
	self._host:_part(t, "TextTransparency", 1.0)
	self._host:_part(clock, "TextTransparency", 1.0)
	table.insert(self._cards, row)
end

function FlagShop._grid(self, order: number, keys: { string })
	local s = UITheme.scale
	local cs = self:_card_size()
	local gap = FlagShop.GAP
	local list, hero = ShopLayout.order(keys)
	local cells, rows = ShopLayout.place(#list, hero, self._cols or FlagShop.COLS)
	local g = new("Frame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Size = UDim2.new(1, -math.floor(12 * s), 0, math.floor((rows * cs.Y + (rows - 1) * gap + 14) * s)),
		ZIndex = 41,
	}, self._sf)
	for i, key in list do
		local c = cells[i]
		local big = hero and i == 1
		local size = if big then Vector2.new(cs.X * 2 + gap, cs.Y * 2 + gap) else cs
		self:_card(g, key, Vector2.new(c[1] * (cs.X + gap), c[2] * (cs.Y + gap)), size, big)
	end
	table.insert(self._cards, g)
end

--- A set's bundle under its head: ALL 6 HALLOWEEN FLAGS, what it saves at this player's prices, and
--- its price (shown while the player is missing any of the set and its product exists here).
--- Set `sid`'s bundle banner shows: it has a bundle, its product exists here (Studio: always), and the
--- player is missing some of the set.
function FlagShop._bundle_shown(self, sid: string): boolean
	local set = Shop.SETS[sid]
	local p = Products["shopset_" .. sid]
	if set == nil or set.bundle == nil or p == nil then
		return false
	end
	if p.id == 0 and not (IS_ROBLOX and game:GetService("RunService"):IsStudio()) then
		return false
	end
	local have, of = self:_set_owned(sid)
	return have < of
end

function FlagShop._bundle(self, order: number, sid: string)
	if not self:_bundle_shown(sid) then
		return
	end
	local set = Shop.SETS[sid]
	local key = "shopset_" .. sid
	local have, of = self:_set_owned(sid)
	local s = UITheme.scale
	local px = function(v: number): number
		return math.floor(v * s + 0.5)
	end
	local each = 0
	for _, k in Shop.set_keys(sid) do
		each += Prices.robux("shop_" .. k)
	end
	local price = Prices.robux(key)
	local off = if each > 0 then math.floor((1 - price / each) * 100 + 0.5) else 0
	local pending = self._pending ~= nil and self._pending.set == sid
	local h = FlagShop.BANNER_H
	local row = new("Frame", {
		Name = "Bundle",
		BackgroundColor3 = WHITE,
		LayoutOrder = order,
		Size = UDim2.new(1, -px(12), 0, px(h + 10)),
		BackgroundTransparency = 1,
		ZIndex = 41,
	}, self._sf)
	local box = new("Frame", {
		Name = "Box",
		BackgroundColor3 = WHITE,
		Size = UDim2.new(1, 0, 0, px(h)),
		ZIndex = 41,
	}, row)
	new("UICorner", { CornerRadius = UDim.new(0, px(10)) }, box)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(120, 52, 10), Color3.fromRGB(40, 18, 60)),
		Rotation = 0,
	}, box)
	local stroke =
		new("UIStroke", { Color = PUMPKIN, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, box)
	local title = new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = FONT_H,
		Text = string.format("ALL %d %s FLAGS", of, string.upper(set.name)),
		TextColor3 = WHITE,
		TextSize = px(14),
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(px(14), px(6)),
		Size = UDim2.new(1, -px(150), 0, px(18)),
		ZIndex = 42,
	}, box)
	local sub = new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = FONT,
		Text = (if off > 0 then string.format("Save %d%%", off) else "One price")
			.. (if have > 0 then "  ·  ones you own pay back Stars" else ""),
		TextColor3 = Color3.fromRGB(120, 230, 150),
		TextSize = px(11),
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(px(14), px(25)),
		Size = UDim2.new(1, -px(150), 0, px(14)),
		ZIndex = 42,
	}, box)
	local btn = new("TextButton", {
		Name = "BuyAll",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Color3.fromRGB(46, 160, 92),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -px(8), 0.5, 0),
		Size = UDim2.fromOffset(px(124), px(h - 14)),
		ZIndex = 43,
	}, box)
	new("UICorner", { CornerRadius = UDim.new(0, px(8)) }, btn)
	local inner = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 44 }, btn)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, px(4)),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, inner)
	local icon = new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = ROBUX,
		Size = UDim2.fromOffset(px(15), px(15)),
		LayoutOrder = 1,
		Visible = not pending,
		ZIndex = 45,
	}, inner)
	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = FONT_H,
		Text = if pending then "..." else tostring(price),
		TextColor3 = WHITE,
		TextSize = px(15),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, px(h - 14)),
		LayoutOrder = 2,
		ZIndex = 45,
	}, inner)
	local host = self._host
	host:_part(box, "BackgroundTransparency", 1.0)
	host:_part(stroke, "Transparency", 0.8)
	host:_part(title, "TextTransparency", 1.0)
	host:_part(sub, "TextTransparency", 1.0)
	host:_part(btn, "BackgroundTransparency", 1.0)
	host:_part(icon, "ImageTransparency", 1.0)
	host:_part(label, "TextTransparency", 1.0)
	btn.MouseEnter:Connect(function()
		btn.BackgroundColor3 = Color3.fromRGB(58, 186, 110)
	end)
	btn.MouseLeave:Connect(function()
		btn.BackgroundColor3 = Color3.fromRGB(46, 160, 92)
	end)
	btn.Activated:Connect(function()
		self:_pressed_set(sid)
	end)
	table.insert(self._cards, row)
end

function FlagShop._card(self, parent: Instance, key: string, pos: Vector2, size: Vector2, hero: boolean)
	local f = Shop.flag(key)
	local it = Cosmetics.item(Shop.item_id(key))
	if f == nil or it == nil then
		return
	end
	local s = UITheme.scale
	local px = function(v: number): number
		return math.floor(v * s + 0.5)
	end
	local cs = size
	local inv = self:_inv()
	local owned = inv.owned[it.id] == true
	local wearing = inv.equipped.flag == it.id
	local pending = self._pending ~= nil and self._pending.key == key
	local rar = Cosmetics.rarity(f.rarity)
	local rc = c3(rar.color)
	local card = new("Frame", {
		Name = key,
		BackgroundColor3 = WHITE,
		Position = UDim2.fromOffset(px(pos.X), px(pos.Y)),
		Size = UDim2.fromOffset(px(size.X), px(size.Y)),
		ZIndex = 41,
	}, parent)
	new("UICorner", { CornerRadius = UDim.new(0, px(10)) }, card)
	local stroke = new("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = if wearing then UITheme.color3(UITheme.to_rgba(UITheme.AMBER)) else rc,
		Thickness = if wearing or hero then 2 else 1,
	}, card)
	new("UIGradient", {
		Color = ColorSequence.new(rc:Lerp(Color3.new(0, 0, 0), 0.55), Color3.fromRGB(14, 18, 34)),
		Rotation = 90,
	}, card)
	local fw = cs.X - 16
	local fh = math.floor(fw * 2 / 3)
	local img = new("ImageLabel", {
		Name = "Flag",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(px(8), px(8)),
		Size = UDim2.fromOffset(px(fw), px(fh)),
		ZIndex = 42,
	}, card)
	local image, x, y, w, h = Cosmetics.flag_big(it)
	img.Image = image
	img.ImageRectOffset = Vector2.new(x, y)
	img.ImageRectSize = Vector2.new(w, h)
	new("UICorner", { CornerRadius = UDim.new(0, px(6)) }, img)
	local name_size = if hero then (if self.ctx.compact then 15 else 18) else (if self.ctx.compact then 11 else 13)
	local name = new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = if hero then FONT_H else FONT,
		Text = f.name,
		TextColor3 = WHITE,
		TextSize = px(name_size),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(px(8), px(8 + fh + 5)),
		Size = UDim2.fromOffset(px(cs.X - 16), px(name_size + 4)),
		ZIndex = 42,
	}, card)
	local sub = new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = FONT_M,
		Text = string.upper(rar.name),
		TextColor3 = rc,
		TextSize = px(if hero then 12 else 10),
		Position = UDim2.fromOffset(px(8), px(8 + fh + 9 + name_size)),
		Size = UDim2.fromOffset(px(cs.X - 16), px(14)),
		ZIndex = 42,
	}, card)
	if hero then
		-- the FEATURED chip over the flag's corner
		local chip = new("TextLabel", {
			BackgroundColor3 = GOLD,
			FontFace = FONT_H,
			Text = "FEATURED",
			TextColor3 = Color3.fromRGB(40, 24, 0),
			TextSize = px(11),
			Position = UDim2.fromOffset(px(14), px(14)),
			Size = UDim2.fromOffset(px(78), px(20)),
			ZIndex = 44,
		}, card)
		new("UICorner", { CornerRadius = UDim.new(0, px(6)) }, chip)
		self._host:_part(chip, "BackgroundTransparency", 1.0)
		self._host:_part(chip, "TextTransparency", 1.0)
	end
	-- the button: the price, WEAR / WEARING, or a moment's wait
	local bh = if hero then (if self.ctx.compact then 32 else 38) else (if self.ctx.compact then 26 else 30)
	local btn = new("TextButton", {
		Name = "Buy",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = if owned then Color3.fromRGB(46, 54, 80) else Color3.fromRGB(46, 160, 92),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -px(8)),
		Size = UDim2.fromOffset(px(cs.X - 16), px(bh)),
		ZIndex = 43,
	}, card)
	new("UICorner", { CornerRadius = UDim.new(0, px(8)) }, btn)
	local row = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 44,
	}, btn)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, px(4)),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, row)
	local text = if wearing then "WEARING" elseif owned then "WEAR" elseif pending then "..." else nil
	local parts = { btn }
	if text == nil then
		local icon = new("ImageLabel", {
			BackgroundTransparency = 1,
			Image = ROBUX,
			Size = UDim2.fromOffset(px(15), px(15)),
			LayoutOrder = 1,
			ZIndex = 45,
		}, row)
		table.insert(parts, icon)
		text = tostring(Prices.robux("shop_" .. key))
	end
	local label = new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = FONT_H,
		Text = text,
		TextColor3 = if wearing then GOLD else WHITE,
		TextSize = px(if hero then 17 else 14),
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, px(bh)),
		LayoutOrder = 2,
		ZIndex = 45,
	}, row)
	local host = self._host
	host:_part(card, "BackgroundTransparency", 1.0)
	host:_part(stroke, "Transparency", if wearing then 1.0 else 0.55)
	host:_part(img, "ImageTransparency", 1.0)
	host:_part(name, "TextTransparency", 1.0)
	host:_part(sub, "TextTransparency", 1.0)
	host:_part(label, "TextTransparency", 1.0)
	for _, pt in parts do
		if pt:IsA("ImageLabel") then
			host:_part(pt, "ImageTransparency", 1.0)
		else
			host:_part(pt, "BackgroundTransparency", if wearing then 0.6 else 1.0)
		end
	end
	btn.MouseEnter:Connect(function()
		btn.BackgroundColor3 = if owned then Color3.fromRGB(60, 70, 102) else Color3.fromRGB(58, 186, 110)
	end)
	btn.MouseLeave:Connect(function()
		btn.BackgroundColor3 = if owned then Color3.fromRGB(46, 54, 80) else Color3.fromRGB(46, 160, 92)
	end)
	btn.Activated:Connect(function()
		self:_pressed(key)
	end)
end

function FlagShop._rebuild(self)
	for _, b in self._cards do
		self._host:_drop_part(b)
		for _, d in b:GetDescendants() do
			self._host:_drop_part(d)
		end
		b:Destroy()
	end
	table.clear(self._cards)
	table.clear(self._clocks)
	local t = FlagShop.now()
	local c = FlagShop.contents(t)
	self._day = c.day
	local keys = {}
	local order = 0
	for _, set in c.sets do
		order += 1
		self:_section(order, string.upper(set.name) .. "  ·  LIMITED", PUMPKIN, set.ends, "ENDS IN ")
		order += 1
		self:_bundle(order, set.id)
		order += 1
		self:_grid(order, set.keys)
		for _, k in set.keys do
			table.insert(keys, "shop_" .. k)
		end
		table.insert(keys, "shopset_" .. set.id)
	end
	order += 1
	self:_section(order, "TODAY'S FLAGS", WHITE, (c.day + 1) * Shop.DAY_S, "NEW IN ")
	order += 1
	self:_grid(order, c.daily)
	for _, k in c.daily do
		table.insert(keys, "shop_" .. k)
	end
	Prices.fetch_keys(keys)
	self:_tick_clocks(t)
end

function FlagShop._tick_clocks(self, t: number)
	for _, cl in self._clocks do
		cl.label.Text = cl.prefix .. FlagShop.clock(cl.ends - t)
	end
end

function FlagShop._process(self, _dt: number)
	if not self.is_open then
		return
	end
	local t = FlagShop.now()
	if Shop.day(t) ~= self._day then
		self:_rebuild() -- (midnight UTC: the shop turned over)
		return
	end
	self:_tick_clocks(t)
end

-- ---------------------------------------------------------------------------------------------
-- Open / close / layout
-- ---------------------------------------------------------------------------------------------

function FlagShop.open(self)
	if self.is_open then
		return
	end
	self.is_open = true
	self:_report("opened")
	self:set_visible(true)
	self:apply_layout()
	self._panel:set_modulate_a(1.0)
	self._dim:set_modulate_a(0.0)
	W.fade(self._dim, 1.0, 0.2)
	UICtx.pop_in(self._panel, 0.0, 0.94, 0.3)
	self.ctx:sfx("open")
	self:set_process(true)
end

function FlagShop.close(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	self:set_process(false)
	self.ctx:sfx("close")
	local t = self:create_tween():set_parallel(true)
	t:tween_property(self._dim, "modulate:a", 0.0, 0.15)
	t:tween_property(self._panel, "modulate:a", 0.0, 0.15)
	t:chain():tween_callback(function()
		if not self.is_open then
			self:set_visible(false)
		end
	end)
	self.closed:Fire()
end

function FlagShop.apply_layout(self)
	local ctx = self.ctx
	local area = ctx:clear_rect()
	local cs = self:_card_size()
	local cols = if ctx.compact
		then math.max(2, math.floor((area.Width - 90) / (cs.X + FlagShop.GAP)))
		else FlagShop.COLS
	cols = math.min(cols, if ctx.compact then 5 else FlagShop.COLS)
	self._cols = cols
	local gw = cols * cs.X + (cols - 1) * FlagShop.GAP + 14
	-- as tall as everything in it, up to the screen's height less the window's head and edges
	-- (2026-10-22, using more of the screen's height: it stopped at 560, today's flags under
	-- the fold); phones: slimmer edges
	local compact = ctx.compact
	self._panel:set_padding(
		if compact then 14 else 22,
		if compact then 10 else 18,
		if compact then 14 else 22,
		if compact then 10 else 18
	)
	self._v:set_separation(if compact then 6 else 10)
	local chrome = if compact then 34 + 6 + 20 else 34 + 10 + 36
	local gh = math.clamp(math.min(self:_content_height(cols), area.Height - chrome - 8), 140, 4000)
	self._host:set_min_size(Vector2.new(gw, gh))
	self._sub:set_visible(not compact or area.Width > 600)
	if self.is_open then
		self:_rebuild()
	end
	self:_center()
end

--- The list's height (logical px) with `cols` cards a row: each section's head, its rows, the gap
--- under them (as _section / _grid build them).
function FlagShop._content_height(self, cols: number): number
	local cs = self:_card_size()
	local c = FlagShop.contents(FlagShop.now())
	local h = 2
	local function grid(keys: { string })
		local list, hero = ShopLayout.order(keys)
		local _, rows = ShopLayout.place(#list, hero, cols)
		h += 30 + rows * cs.Y + (rows - 1) * FlagShop.GAP + 14
	end
	for _, s in c.sets do
		grid(s.keys)
		if self:_bundle_shown(s.id) then
			h += FlagShop.BANNER_H + 10
		end
	end
	grid(c.daily)
	return h
end

function FlagShop._center(self)
	local area = self.ctx:clear_rect()
	local pn = self._panel
	local sz = pn:get_combined_minimum_size()
	local p = area.Min + (Vector2.new(area.Width, area.Height) - sz) * 0.5
	local y = math.max(p.Y, area.Min.Y + 4.0)
	pn:set_offsets(math.floor(p.X + 0.5), math.floor(y + 0.5), math.floor(p.X + 0.5), math.floor(y + 0.5))
	pn:reset_size()
end

return FlagShop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">FloatText</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/float_text.gd (UIFloatText)
-- Brief confirmation pill that pops near the cursor, drifts up and fades
-- ("Attacking Brazil with 24.5K", "Not enough gold"...).
--
-- FloatText.spawn(parent_node, pos_logical, text, icon_name, col, bounds_rect?)
-- FloatText.bounds_provider: () -> Rect (logical px) -- live area floats must stay inside, re-read
-- every frame (a tray opening later pushes floats above it).

local UITheme = require("./UITheme")
local W = require("./Widgets")

local FloatText = W.class(W.Control)

FloatText.bounds_provider = nil :: (() -> Rect)?

function FloatText.spawn(parent: any, pos: Vector2, text: string, icon_name: string?, col: any, bounds: Rect?)
	if parent == nil or text == nil or text == "" then
		return nil
	end
	local ft = setmetatable({}, FloatText.__mt)
	W.Control._init(ft)
	ft:set_mouse_filter(W.MOUSE_IGNORE)
	ft._rise = 0.0
	ft._fixed_bounds = bounds
	parent:add_child(ft)
	local pill = W.Panel.new()
	pill:set_mouse_filter(W.MOUSE_IGNORE)
	pill:add_theme_stylebox_override(
		"panel",
		UITheme.flat(UITheme.rgba(0.03, 0.045, 0.1, 0.92), 999, UITheme.c(col, 0.55), 1, 12.0, 5.0)
	)
	local row = UITheme.hbox(7)
	if icon_name ~= nil and icon_name ~= "" then
		local ic = UITheme.icon_rect(icon_name, 14.0, col)
		ic.size_flags_vertical = W.SHRINK_CENTER
		row:add_child(ic)
	end
	row:add_child(UITheme.label(text, 13, 700, UITheme.lerp(UITheme.color3(col), UITheme.WHITE, 0.35)))
	pill:add_child(row)
	pill:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	ft:add_child(pill)
	ft._sz = pill:get_combined_minimum_size()
	local p = pos + Vector2.new(-ft._sz.X * 0.5, -ft._sz.Y - 22.0)
	ft._base_y = p.Y
	ft._x = p.X
	ft:_clamp()
	ft:set_scale(0.85)
	ft:set_modulate_a(0.0)
	ft:set_process(true)
	local t = ft:create_tween():set_parallel(true)
	t:tween_property(ft, "modulate:a", 1.0, 0.12)
	t:tween_property(ft, "scale", 1.0, 0.25):set_trans(W.TRANS_BACK):set_ease(W.EASE_OUT)
	t:tween_property(ft, "_rise", 26.0, 1.5):set_trans(W.TRANS_CUBIC):set_ease(W.EASE_OUT)
	t:tween_property(ft, "modulate:a", 0.0, 0.45):set_delay(1.05)
	t:chain():tween_callback(function()
		ft:queue_free()
	end)
	return ft
end

function FloatText._clamp(self)
	local b = self._fixed_bounds
	local prov = FloatText.bounds_provider
	if prov ~= nil then
		local ok, v = pcall(prov)
		if ok and typeof(v) == "Rect" and v.Width > 0 then
			b = v
		end
	end
	if b == nil or b.Width <= 0 then
		local vp = if self.root then self.root.vp else Vector2.new(1600, 900)
		b = Rect.new(0, 0, vp.X, vp.Y)
	end
	local sz = self._sz
	local x = math.clamp(self._x, b.Min.X + 8.0, math.max(b.Min.X + 8.0, b.Max.X - sz.X - 8.0))
	local y = self._base_y - self._rise
	y = math.clamp(y, b.Min.Y + 8.0, math.max(b.Min.Y + 8.0, b.Max.Y - sz.Y - 8.0))
	self.offset_left = x
	self.offset_top = y
	self.offset_right = x + sz.X
	self.offset_bottom = y + sz.Y
	self:_layout_free()
end

function FloatText._process(self, _delta: number)
	self:_clamp()
end

return FloatText
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="154">
            <Properties>
              <string name="Name">GameOver</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/game_over.gd (UIGameOver)
-- Victory / defeat / eliminated / time-up screen with the winner, your match stats and the next
-- steps (play again, spectate, return to title).
-- The Stars the match paid (Data/Stars; server/Rewards answers a moment after the screen opens) count
-- up in a gold pill at the head of the buttons; its card lists what they were for, and a press opens
-- the Arsenal.
-- Under the buttons, once the payout is in, stand what the Stars are for (2026-10-07, to encourage
-- more Robux spending: a day after the Arsenal shipped its unlocks had sold 11
-- times to 27,000 players a day, and the result screen said nothing of them but a number):
--   * the next unlock (Data/Arsenal.next_goal): "MEGA NUKE  4,560 / 20,000", gold and "UNLOCK" once
--     the Stars are there. A press opens the Arsenal on that item, where it sells for Stars or Robux;
--   * 2X STARS, until owned, with what this match would have paid with it.
-- They say what is true and prompt nothing by themselves; they step aside for the takeover offer and
-- on a screen too short for them.

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local TitleScreen = require("./TitleScreen")
local UIRules = require("./UIRules") :: any
local Signal = UITheme.core("Signal")
local Defs = UICtx.core("Defs")

local GameOver = W.class(W.Control)

local function spacer(h: number)
	local g = W.Control.new()
	g:set_mouse_filter(W.MOUSE_IGNORE)
	g:set_min_size(Vector2.new(0, h))
	return g
end

function GameOver.new(c: any)
	local self = setmetatable({}, GameOver.__mt)
	W.Control._init(self)
	self.ctx = c
	self.play_again = Signal.new()
	self.spectate = Signal.new()
	self.to_title = Signal.new()
	--- solo: the TAKE OVER button (Takeover.luau)
	self.take_over = Signal.new()
	--- the Stars pill was pressed
	self.open_arsenal = Signal.new()
	--- the payout shown ({ lines, total, balance }), and the count on its way up to the total
	self._award = nil :: any
	self._stars_shown = 0.0
	self._stars_done = true
	self._take_info = nil
	self.is_open = false
	self._sweep_t = -1.0
	self._kind = ""
	self._next_accum = 0.0
	--- The pill shows the live "Current leader" (not a crowned winner): refreshed while the match runs.
	self._pill_live = false
	self._pill_domination = false
	self._dominated = false
	self._pill_id = 0
	self._pill_text = ""
	self._close_tween = nil
	self._enter_tween = nil
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	self:set_visible(false)
	local dimg = Instance.new("ImageLabel")
	dimg.BackgroundTransparency = 1
	dimg.ScaleType = Enum.ScaleType.Stretch
	dimg.Image = UICtx.shapes().over_dim or ""
	dimg.Active = true
	self._dim = W.wrap(dimg)
	self._dim:set_mouse_filter(W.MOUSE_STOP)
	self._dim:_part(dimg, "ImageTransparency", 1.0)
	self._dim:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:add_child(self._dim)

	self._center = UITheme.vbox(0)
	self._center:set_alignment(W.ALIGN_CENTER)
	self:add_child(self._center)
	self._kicker = UITheme.label("MATCH COMPLETE", 14, 700, UITheme.TEXT_2, 6)
	self._kicker:set_alignment(W.ALIGN_CENTER)
	self._center:add_child(self._kicker)
	local title = TitleScreen.GradientText.new("GAME OVER", 110, 900)
	title.spacing = 10
	title.shadow = { color = Color3.new(0, 0, 0), alpha = 0.5, offset_y = 6, outline = 12 }
	title.shine = 0.35
	title.size_flags_horizontal = W.SHRINK_CENTER
	self._title = title
	self._center:add_child(title)
	self._sub = UITheme.label("", 18, 500, UITheme.TEXT)
	self._sub:set_alignment(W.ALIGN_CENTER)
	self._center:add_child(self._sub)
	self._center:add_child(spacer(14))

	self._winner = W.Panel.new()
	self._winner:set_mouse_filter(W.MOUSE_IGNORE)
	self._winner.size_flags_horizontal = W.SHRINK_CENTER
	self._winner:add_theme_stylebox_override(
		"panel",
		UITheme.flat(UITheme.c(UITheme.GOLD, 0.1), 999, UITheme.c(UITheme.GOLD, 0.45), 1, 16.0, 6.0)
	)
	local wr = UITheme.hbox(8)
	self._crown = UITheme.icon_rect("crown", 16.0, UITheme.GOLD)
	self._crown.size_flags_vertical = W.SHRINK_CENTER
	wr:add_child(self._crown)
	self._winner_sw = UITheme.swatch(UITheme.TEXT, 12.0, 3)
	wr:add_child(self._winner_sw)
	self._winner_name = UITheme.label("", 15, 700)
	wr:add_child(self._winner_name)
	self._winner:add_child(wr)
	self._center:add_child(self._winner)
	self._gap2 = spacer(26)
	self._center:add_child(self._gap2)

	self._stats = UITheme.hbox(12)
	self._stats:set_alignment(W.ALIGN_CENTER)
	self._center:add_child(self._stats)
	self._gap3 = spacer(28)
	self._center:add_child(self._gap3)

	-- take over the nation that conquered you (Takeover.luau; hidden without an offer). 2026-09-29: the
	-- eliminated screen advertised the revive purchase badly, so the offer is the
	-- screen's centrepiece while it shows (the stat cards step aside): the nation's flag (or colour),
	-- TAKE OVER <NATION>, what you get (its land, troops and gold, live), one big gold button with the
	-- price, a glow and a shine sweeping over the button
	self._take = W.Panel.new()
	self._take:set_mouse_filter(W.MOUSE_IGNORE)
	self._take.size_flags_horizontal = W.SHRINK_CENTER
	self._take:add_theme_stylebox_override(
		"panel",
		UITheme.flat(UITheme.rgba(0.11, 0.09, 0.055, 0.96), 18, UITheme.c(UITheme.GOLD, 0.85), 2, 22.0, 18.0)
	)
	local tv = UITheme.vbox(12)
	self._take_v = tv
	self._take:add_child(tv)
	local head = UITheme.hbox(14)
	-- the nation's flag when a flag carries its name (the AI nations are the world's countries), else
	-- its colour
	local flag = Instance.new("ImageLabel")
	flag.BackgroundTransparency = 1
	flag.ScaleType = Enum.ScaleType.Fit
	self._take_flag_img = flag
	self._take_flag = W.wrap(flag)
	self._take_flag:set_mouse_filter(W.MOUSE_IGNORE)
	self._take_flag:_part(flag, "ImageTransparency", 1.0)
	self._take_flag.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(self._take_flag)
	self._take_sw = UITheme.swatch(UITheme.TEXT, 30.0, 8)
	self._take_sw.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(self._take_sw)
	local hv = UITheme.vbox(0)
	hv.size_flags_vertical = W.SHRINK_CENTER
	self._take_kicker = UITheme.label("DON'T GIVE UP", 11, 800, UITheme.GOLD, 3)
	hv:add_child(self._take_kicker)
	self._take_title = UITheme.label("TAKE OVER", 26, 900, UITheme.TEXT, 1)
	hv:add_child(self._take_title)
	-- (phones: what you get as one line here instead of the chips)
	self._take_line = UITheme.label("", 12, 700, UITheme.GOLD, 1)
	self._take_line:set_visible(false)
	hv:add_child(self._take_line)
	head:add_child(hv)
	tv:add_child(head)
	self._take_sub = UITheme.label("", 13, 500, UITheme.TEXT_2)
	self._take_sub:set_autowrap(true)
	tv:add_child(self._take_sub)
	-- what you get
	local chips = UITheme.hbox(8)
	self._take_chips = chips
	self._chip = {}
	self._chip_panels = {}
	for _, c in { { "land", "globe", "LAND", UITheme.AMBER }, { "troops", "troops", "TROOPS", UITheme.CYAN }, { "gold", "gold", "GOLD", UITheme.GOLD } } do
		local chip = W.Panel.new()
		chip:set_mouse_filter(W.MOUSE_IGNORE)
		chip.size_flags_horizontal = W.EXPAND_FILL
		chip:add_theme_stylebox_override("panel", UITheme.flat(UITheme.rgba(1, 1, 1, 0.06), 10, UITheme.rgba(1, 1, 1, 0.1), 1, 10.0, 7.0))
		local ch = UITheme.hbox(8)
		local ic = UITheme.icon_rect(c[2], 18.0, c[4])
		ic.size_flags_vertical = W.SHRINK_CENTER
		ch:add_child(ic)
		local cv = UITheme.vbox(0)
		local value = UITheme.label("", 18, 800)
		cv:add_child(value)
		cv:add_child(UITheme.caption(c[3], 9, UITheme.TEXT_3))
		ch:add_child(cv)
		chip:add_child(ch)
		chips:add_child(chip)
		self._chip[c[1]] = value
		table.insert(self._chip_panels, chip)
	end
	tv:add_child(chips)
	-- the button: TAKE OVER, and the price in a tag on its right
	self._take_btn = UITheme.button("TAKE OVER", "PrimaryButton", "", 60.0)
	self._take_btn:set_font_size(20)
	self._take_btn.pressed:Connect(function()
		self.take_over:Fire()
	end)
	local bg = self._take_btn.gui
	local tag = Instance.new("Frame")
	tag.Name = "Price"
	tag.AnchorPoint = Vector2.new(1, 0.5)
	tag.BackgroundColor3 = Color3.fromRGB(60, 34, 4)
	tag.AutomaticSize = Enum.AutomaticSize.X
	tag.ZIndex = 40
	UICtx.make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, tag)
	local pad = UICtx.make("UIPadding", {}, tag)
	self._take_tag_list = UICtx.make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, tag)
	local rbx = Instance.new("ImageLabel")
	rbx.BackgroundTransparency = 1
	rbx.Image = UITheme.icon("robux") or ""
	rbx.ImageColor3 = Color3.fromRGB(255, 226, 150)
	rbx.LayoutOrder = 1
	rbx.ZIndex = 41
	rbx.Parent = tag
	local price = Instance.new("TextLabel")
	price.BackgroundTransparency = 1
	price.AutomaticSize = Enum.AutomaticSize.X
	price.FontFace = Font.fromId(12187365977, Enum.FontWeight.Heavy)
	price.TextColor3 = Color3.fromRGB(255, 226, 150)
	price.LayoutOrder = 2
	price.ZIndex = 41
	price.Parent = tag
	tag.Parent = bg
	self._take_tag, self._take_tag_pad, self._take_rbx, self._take_price = tag, pad, rbx, price
	self._take_btn:_part(tag, "BackgroundTransparency", 1.0)
	self._take_btn:_part(rbx, "ImageTransparency", 1.0)
	self._take_btn:_part(price, "TextTransparency", 1.0)
	-- a shine sweeping over the button now and then
	local shine = Instance.new("Frame")
	shine.Name = "Shine"
	shine.BackgroundColor3 = Color3.new(1, 1, 1)
	shine.Size = UDim2.fromScale(1, 1)
	shine.ZIndex = 39
	self._take_corner = UICtx.make("UICorner", { CornerRadius = UDim.new(0, 12) }, shine)
	self._take_shine = UICtx.make("UIGradient", {
		Rotation = 20,
		Offset = Vector2.new(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.4, 1),
			NumberSequenceKeypoint.new(0.5, 0.55),
			NumberSequenceKeypoint.new(0.6, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, shine)
	shine.Parent = bg
	self._take_btn:_part(shine, "BackgroundTransparency", 1.0)
	tv:add_child(self._take_btn)
	self._take:set_visible(false)
	self._center:add_child(self._take)
	-- the card's gold glow (a raw image in the column, under the card)
	local glow = Instance.new("ImageLabel")
	glow.Name = "TakeGlow"
	glow.BackgroundTransparency = 1
	glow.Image = UITheme.crate_art().glow or ""
	glow.ImageColor3 = UITheme.color3(UITheme.GOLD)
	glow.ImageTransparency = 1
	glow.ZIndex = 1
	glow.Parent = self._center.gui
	self._take_glow = glow
	self._take_t = 0.0
	self._gap4 = spacer(16)
	self._gap4:set_visible(false)
	self._center:add_child(self._gap4)

	self._buttons = UITheme.hbox(12)
	self._buttons:set_alignment(W.ALIGN_CENTER)
	self._center:add_child(self._buttons)
	-- the Stars this match paid (hidden until the payout arrives)
	local sb = UITheme.button("+0", "GlassButton", "star", 52.0)
	sb:set_min_size(Vector2.new(150, 52))
	sb:add_theme_constant_override("icon_max_width", 18)
	sb:add_theme_color_override("font_color", UITheme.GOLD)
	sb:add_theme_color_override("font_hover_color", UITheme.GOLD)
	sb:add_theme_color_override("icon_normal_color", UITheme.GOLD)
	sb:add_theme_color_override("icon_hover_color", UITheme.GOLD)
	for _, st in ipairs({ "normal", "disabled" }) do
		sb:add_theme_stylebox_override(st, UITheme.flat(UITheme.c(UITheme.GOLD, 0.1), UITheme.R_MD, UITheme.c(UITheme.GOLD, 0.5), 1, 14.0, 8.0))
	end
	sb:add_theme_stylebox_override("hover", UITheme.flat(UITheme.c(UITheme.GOLD, 0.18), UITheme.R_MD, UITheme.GOLD, 1, 14.0, 8.0))
	sb:add_theme_stylebox_override("pressed", UITheme.flat(UITheme.c(UITheme.GOLD, 0.26), UITheme.R_MD, UITheme.GOLD, 1, 14.0, 8.0))
	sb:set_visible(false)
	sb.pressed:Connect(function()
		self.ctx:hide_hint(sb)
		self.open_arsenal:Fire()
	end)
	sb.mouse_entered:Connect(function()
		if self._award ~= nil then
			self.ctx:show_hint(sb, self:_stars_spec())
		end
	end)
	sb.mouse_exited:Connect(function()
		self.ctx:hide_hint(sb)
	end)
	self._stars_btn = sb
	self._buttons:add_child(sb)
	self._again = UITheme.button("PLAY AGAIN", "PrimaryButton", "play", 52.0)
	self._again:set_min_size(Vector2.new(200, 52))
	self._again.pressed:Connect(function()
		self.play_again:Fire()
	end)
	self._buttons:add_child(self._again)
	self._spec = UITheme.button("Spectate", "GlassButton", "eye", 52.0)
	self._spec:set_min_size(Vector2.new(170, 52))
	self._spec.pressed:Connect(function()
		self:close()
		self.spectate:Fire()
	end)
	self._buttons:add_child(self._spec)
	self._home = UITheme.button("Return to title", "GlassButton", "exit", 52.0)
	self._home:set_min_size(Vector2.new(200, 52))
	self._home.pressed:Connect(function()
		self.to_title:Fire()
	end)
	self._buttons:add_child(self._home)
	-- what the Stars are for: the next unlock and 2x Stars (see the header)
	self._gap_offers = spacer(10)
	self._gap_offers:set_visible(false)
	self._center:add_child(self._gap_offers)
	self._offers = UITheme.hbox(10)
	self._offers:set_alignment(W.ALIGN_CENTER)
	self._offers:set_visible(false)
	self._center:add_child(self._offers)
	local function offer_button(icon: string): any
		local b = UITheme.button("", "GlassButton", icon, 40.0)
		b:set_font_size(13)
		b:add_theme_constant_override("icon_max_width", 16)
		b:add_theme_color_override("font_color", UITheme.GOLD)
		b:add_theme_color_override("font_hover_color", UITheme.GOLD)
		b:add_theme_color_override("icon_normal_color", UITheme.GOLD)
		b:add_theme_color_override("icon_hover_color", UITheme.GOLD)
		for _, st in ipairs({ "normal", "disabled" }) do
			b:add_theme_stylebox_override(st, UITheme.flat(UITheme.c(UITheme.GOLD, 0.06), UITheme.R_MD, UITheme.c(UITheme.GOLD, 0.35), 1, 14.0, 6.0))
		end
		b:add_theme_stylebox_override("hover", UITheme.flat(UITheme.c(UITheme.GOLD, 0.16), UITheme.R_MD, UITheme.GOLD, 1, 14.0, 6.0))
		b:add_theme_stylebox_override("pressed", UITheme.flat(UITheme.c(UITheme.GOLD, 0.24), UITheme.R_MD, UITheme.GOLD, 1, 14.0, 6.0))
		b:set_visible(false)
		self._offers:add_child(b)
		return b
	end
	self._goal_key = nil :: string?
	self._goal_btn = offer_button("lock")
	self._goal_btn.pressed:Connect(function()
		if self._goal_key ~= nil then
			self.open_arsenal:Fire(self._goal_key, "offer")
		end
	end)
	self._x2_btn = offer_button("star")
	self._x2_btn.pressed:Connect(function()
		self.open_arsenal:Fire("stars2x", "offer")
	end)
	self._next = UITheme.label("", 13, 600, UITheme.TEXT_2)
	self._next:set_alignment(W.ALIGN_CENTER)
	self._gap_next = spacer(14)
	self._center:add_child(self._gap_next)
	self._center:add_child(self._next)
	self:set_process(true)
	return self
end

--- What the Stars were for: the pill's card.
function GameOver._stars_spec(self): { [string]: any }
	local a = self._award
	local StarsData = UICtx.data("Stars")
	local rows = {}
	for _, l in a.lines do
		table.insert(rows, { StarsData.LABELS[l[1]] or l[1], "+" .. UICtx.commas(l[2]), UITheme.GOLD })
	end
	return {
		title = "Stars earned",
		body = "Stars unlock new weapons in the Arsenal.",
		rows = rows,
		hint = string.format("You have %s Stars", UICtx.commas(a.balance or 0)),
		hint_color = UITheme.GOLD,
		hint_icon = "star",
	}
end

--- The match's payout ({ lines, total, balance }, Session.stars_awarded), or nil: the pill counts up.
function GameOver.set_award(self, award: any)
	if award == nil or (tonumber(award.total) or 0) <= 0 then
		self._award = nil
		self._stars_btn:set_visible(false)
		self:_refresh_offers()
		return
	end
	if self._award == award then
		return
	end
	self._award = award
	self._balance = tonumber(award.balance)
	self._stars_shown = 0.0
	self._stars_done = false
	self._stars_btn:set_text("+0")
	self._stars_btn:set_visible(true)
	self:_refresh_offers()
	if self.is_open then
		UICtx.pop_in(self._stars_btn, 0.0, 0.8, 0.35)
		UICtx.pop_in(self._offers, 0.5, 0.9, 0.35)
		self:apply_layout()
	end
end

--- The offers for the payout shown (hidden without one, and while the takeover offer stands).
function GameOver._refresh_offers(self)
	local sess = self.ctx.session
	local inv = if sess ~= nil then sess.inventory else nil
	local o = UIRules.result_offers(self._award, inv, UICtx.data("Arsenal"), self._balance)
	local goal, x2 = o.goal, o.x2
	self._goal_key = if goal ~= nil then goal.key else nil
	if goal ~= nil then
		self._goal_btn:set_text(goal.text)
		self._goal_btn:set_icon(if goal.ready then "star" else "lock")
	end
	if x2 ~= nil then
		self._x2_btn:set_text(x2.text)
	end
	-- (apply_layout shows them: it knows whether there is room)
	self._goal_wanted = goal ~= nil
	self._x2_wanted = x2 ~= nil
end

--- The inventory changed (something was unlocked): the offers follow, counting with its Stars.
function GameOver.refresh_offers(self)
	local sess = self.ctx.session
	local inv = if sess ~= nil then sess.inventory else nil
	if type(inv) == "table" and type(inv.stars) == "number" then
		self._balance = inv.stars
	end
	self:_refresh_offers()
	if self.is_open then
		self:apply_layout()
	end
end

function GameOver._stat_card(self, icon_name: string, value: string, caption: string, col: Color3)
	if self.ctx.compact then
		-- Phones: one short row per card (icon | value over caption).
		local pc = GlassPanel.new(10.0, 7.0, 12, true, 12)
		pc:set_mouse_filter(W.MOUSE_IGNORE)
		local h = UITheme.hbox(8)
		pc:add_child(h)
		local pic = UITheme.icon_rect(icon_name, 18.0, col)
		pic.size_flags_vertical = W.SHRINK_CENTER
		h:add_child(pic)
		local pv = UITheme.vbox(0)
		pv:add_child(UITheme.label(value, 18, 800))
		pv:add_child(UITheme.caption(caption, 10, UITheme.TEXT_3))
		h:add_child(pv)
		return pc
	end
	local card = GlassPanel.new(16.0, 14.0, 14, true, 16)
	card:set_mouse_filter(W.MOUSE_IGNORE)
	card:set_min_size(Vector2.new(150, 0))
	local v = UITheme.vbox(4)
	card:add_child(v)
	local ic = UITheme.icon_rect(icon_name, 20.0, col)
	ic.size_flags_horizontal = W.SHRINK_CENTER
	v:add_child(ic)
	local vl = UITheme.label(value, 26, 800)
	vl:set_alignment(W.ALIGN_CENTER)
	v:add_child(vl)
	local cl = UITheme.caption(caption, 10, UITheme.TEXT_3)
	cl:set_alignment(W.ALIGN_CENTER)
	v:add_child(cl)
	return card
end

--- kind: "victory", "defeat", "eliminated" or "result" (the match ended while you were not in it).
--- reason: Defs.OVER_* (ignored for "eliminated"). stats: {peak_share, max_troops, kills, duration_s}
function GameOver.open(self, kind: string, winner: number, killer: number, stats: any, reason: number?)
	local ctx = self.ctx
	local s = ctx.state
	local rsn = reason or -1
	-- Already on screen (e.g. ELIMINATED, then the match ends): swap the copy in place. A close
	-- fade still in flight would otherwise hide the new screen when it finishes (review P1-1; the
	-- original game_over.gd has the same latent race).
	local was_shown = self.visible
	if self._close_tween ~= nil then
		self._close_tween:kill()
		self._close_tween = nil
	end
	if self._enter_tween ~= nil then
		self._enter_tween:kill()
		self._enter_tween = nil
	end
	self.is_open = true
	self:set_visible(true)
	self:set_modulate_a(1.0)
	self._kind = kind
	local copy = self:_copy(kind, winner, killer, rsn, tonumber(stats.duration_s) or 0.0)
	self._kicker:set_text(copy.kicker)
	self._title:set_text(copy.title)
	self._sub:set_text(copy.sub)
	self._title:set_colors(copy.top, copy.bottom)
	-- Winner pill: a real winner gets the crown; otherwise it reads "Current leader".
	local real_winner = (kind == "victory" or kind == "defeat" or kind == "result")
		and winner ~= 0
		and (rsn == Defs.OVER_DOMINATION or rsn == Defs.OVER_TIME)
	local pill_id = if real_winner then winner else self:_leader_id()
	-- A domination winner's share is the victory metric (land outside fallout), like the headline.
	self._pill_domination = real_winner and rsn == Defs.OVER_DOMINATION and self._dominated
	self._pill_live = not real_winner
	self._pill_id = -1
	self._pill_text = ""
	self._crown:set_visible(real_winner)
	self._winner:add_theme_stylebox_override(
		"panel",
		if real_winner
			then UITheme.flat(UITheme.c(UITheme.GOLD, 0.1), 999, UITheme.c(UITheme.GOLD, 0.45), 1, 16.0, 6.0)
			else UITheme.flat(UITheme.rgba(1, 1, 1, 0.06), 999, UITheme.LINE_2, 1, 16.0, 6.0)
	)
	self:_set_pill(pill_id)
	for _, ch in ipairs(self._stats:get_children()) do
		ch:queue_free()
	end
	-- Each card sits in a fixed slot so it can settle into place (the HBox ignores offsets).
	local function slot(card)
		local sl = W.Control.new()
		sl:set_mouse_filter(W.MOUSE_IGNORE)
		sl:set_min_size(card:get_combined_minimum_size())
		card:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
		sl:add_child(card)
		sl.card = card
		return sl
	end
	self._stats:add_child(
		slot(self:_stat_card("globe", UITheme.fmt_pct(tonumber(stats.peak_share) or 0.0), "Peak land", UITheme.AMBER))
	)
	self._stats:add_child(
		slot(self:_stat_card("troops", UITheme.fmt_troops(tonumber(stats.max_troops) or 0), "Max troops", UITheme.CYAN))
	)
	self._stats:add_child(
		slot(
			self:_stat_card(
				"skull",
				tostring(math.floor(tonumber(stats.kills) or 0)),
				"Nations eliminated",
				UITheme.RED
			)
		)
	)
	-- The match's length: a result reached after an elimination still reports the whole match
	-- (stats.match_s), not the moment the player fell (review R2-6).
	local secs = UIRules.result_seconds(kind, stats)
	self._stats:add_child(slot(self:_stat_card("clock", UITheme.fmt_time(secs), "Match duration", UITheme.VIOLET)))
	local solo = ctx:mode() == UICtx.MODE_SOLO
	local running = s ~= nil and s.phase == Defs.PHASE_PLAYING
	-- the Stars this match (or this life) paid, if the payout is in already
	local sess = ctx.session
	self:set_award(if sess ~= nil then sess.last_award else nil)
	self._again:set_visible(solo)
	self._spec:set_visible(kind == "eliminated" and running)
	self._spec:set_text("Keep watching")
	self._home:set_text("Return to title")
	self._next:set_visible(ctx:mode() == UICtx.MODE_MULTI and kind ~= "eliminated")
	self:_refresh_next()
	self:_show_takeover()
	self:apply_layout()
	-- Entrance (the dim stays put when the screen was already showing)
	if not was_shown then
		self._dim:set_modulate_a(0.0)
		W.fade(self._dim, 1.0, 0.6)
	elseif self._dim.modulate_a < 1.0 then
		W.fade(self._dim, 1.0, 0.3)
	end
	self._kicker:set_modulate_a(0.0)
	local t = self:create_tween():set_parallel(true)
	self._enter_tween = t
	t:tween_property(self._kicker, "modulate:a", 1.0, 0.5):set_delay(0.15)
	self._title:set_modulate_a(0.0)
	self._title:set_scale(1.35)
	t:tween_property(self._title, "modulate:a", 1.0, 0.45):set_delay(0.2)
	t:tween_property(self._title, "scale", 1.0, 0.9):set_delay(0.2):set_trans(W.TRANS_EXPO):set_ease(W.EASE_OUT)
	self._sub:set_modulate_a(0.0)
	t:tween_property(self._sub, "modulate:a", 1.0, 0.5):set_delay(0.6)
	self._winner:set_modulate_a(0.0)
	t:tween_property(self._winner, "modulate:a", 1.0, 0.5):set_delay(0.75)
	for i, sl in ipairs(self._stats:get_children()) do
		UICtx.pop_in(sl.card, 0.9 + 0.09 * (i - 1), 0.9, 0.45)
	end
	self._buttons:set_modulate_a(0.0)
	t:tween_property(self._buttons, "modulate:a", 1.0, 0.5):set_delay(1.35)
	if self._take.visible then
		UICtx.pop_in(self._take, 0.9, 0.9, 0.45)
		self._take_t = 0.0
	end
	self._sweep_t = 0.0
	ctx:set_world_input(false)
end

--- The takeover offer (Takeover.refresh): {name, color, price, saved, busy} or nil. Kept, and shown
--- on the ELIMINATED screen whenever it is up.
function GameOver.set_takeover(self, info: any)
	self._take_info = info
	if self.is_open then
		self:_show_takeover()
		self:apply_layout()
	end
end

--- Nation names spelled differently from their flag's name (the maps' nations vs the flags' names).
GameOver.FLAG_ALIASES = {
	["united states"] = "__us",
	["dr congo"] = "__cd",
	["dominican rep."] = "__do",
	["turkey"] = "__tr",
}

local _flag_by_name: { [string]: any }? = nil
--- The flag item whose name is `name` (the AI nations are named after the countries), or nil.
local function flag_named(name: string): any
	if _flag_by_name == nil then
		local m = {}
		local ok, Cosmetics = pcall(function()
			if typeof(game) == "Instance" then
				return require((game :: any):GetService("ReplicatedStorage"):WaitForChild("Airfront").Data.Cosmetics)
			end
			return (require :: any)("../../shared/Data/Cosmetics")
		end)
		if ok and type(Cosmetics) == "table" then
			for _, it in Cosmetics.all() do
				if it.kind == "flag" then
					local e = { item = it, image = Cosmetics.flag_image(it) }
					m[string.lower(it.name)] = e
					m["__" .. it.code] = e -- (FLAG_ALIASES by code)
				end
			end
		end
		_flag_by_name = m
	end
	local key = string.lower(name)
	return (_flag_by_name :: any)[GameOver.FLAG_ALIASES[key] or key]
end

function GameOver._show_takeover(self)
	local info = self._take_info
	local show = info ~= nil and self._kind == "eliminated"
	self._take:set_visible(show)
	self._gap4:set_visible(show)
	-- the offer takes the stat cards' place
	self._stats:set_visible(not show)
	-- one gold button at a time: the takeover's (PLAY AGAIN steps back to glass while it shows)
	local again = if show then "GlassButton" else "PrimaryButton"
	if self._again.theme_type_variation ~= again then
		self._again.theme_type_variation = again
		self._again:_theme_changed()
	end
	if not show then
		self._take_glow.ImageTransparency = 1
		return
	end
	local name = tostring(info.name)
	local fl = flag_named(name)
	self._take_flag:set_visible(fl ~= nil)
	self._take_sw:set_visible(fl == nil)
	if fl ~= nil then
		local img = self._take_flag_img
		img.Image = fl.image
		img.ImageRectOffset = Vector2.new(fl.item.x, fl.item.y)
		img.ImageRectSize = Vector2.new(fl.item.w, fl.item.h)
	elseif info.color ~= nil then
		UITheme.set_swatch_color(self._take_sw, info.color)
	end
	self._take_title:set_text("TAKE OVER " .. string.upper(name))
	self._take_btn:set_disabled(info.busy == true)
	local saved = info.saved > 0
	self._take_kicker:set_text(if saved then "YOUR TAKEOVER IS SAVED" else "DON'T GIVE UP")
	self._take_sub:set_text(
		if saved
			then "Use it now: " .. name .. "'s land, army and gold become yours."
			else name .. "'s land, army, gold and buildings become yours. Keep playing from where they stand."
	)
	self._take_btn:set_text(if info.busy then "…" elseif saved then "USE IT NOW" else "TAKE OVER")
	self._take_price.Text = tostring(info.price)
	self._take_tag.Visible = not saved and not info.busy
	self:_refresh_take_chips()
	self:_size_take()
end

--- What the offer gives, live: the nation's land, troops and gold.
function GameOver._refresh_take_chips(self)
	local info = self._take_info
	local s = self.ctx.state
	local o = if info ~= nil and s ~= nil then s:get_owner(info.target) else nil
	if o == nil then
		return
	end
	local land = UITheme.fmt_pct(s:land_share(info.target))
	local troops = UITheme.fmt_troops(tonumber(o.troops) or 0)
	local gold = UITheme.fmt_troops(tonumber(o.gold) or 0)
	self._chip.land:set_text(land)
	self._chip.troops:set_text(troops)
	self._chip.gold:set_text(gold)
	self._take_line:set_text(string.format("%s LAND  ·  %s TROOPS  ·  %s GOLD", land, troops, gold))
end

--- The card's sizes (desktop / phones), the title fitted to the card, the price tag in px.
function GameOver._size_take(self)
	local ctx = self.ctx
	local compact = ctx.compact
	local area = ctx:clear_rect()
	local w = math.min(if compact then 440.0 else 520.0, area.Width - 24.0)
	local pad_h = if compact then 16.0 else 22.0
	self._take:add_theme_stylebox_override(
		"panel",
		UITheme.flat(
			UITheme.rgba(0.11, 0.09, 0.055, 0.96),
			if compact then 14 else 18,
			UITheme.c(UITheme.GOLD, 0.85),
			2,
			pad_h,
			if compact then 12.0 else 18.0
		)
	)
	local inner = w - 2 * pad_h
	self._take_v:set_separation(if compact then 6 else 12)
	self._take_flag:set_min_size(if compact then Vector2.new(42, 28) else Vector2.new(57, 38))
	self._take_sw:set_min_size(if compact then Vector2.new(24, 24) else Vector2.new(30, 30))
	-- the title shrinks to fit next to the flag
	local head_w = inner - (if compact then 42 else 57) - 14
	local text = self._take_title.text or ""
	local px = if compact then 20 else 26
	while px > 14 and UITheme.text_width(text, px, 900, 1) > head_w do
		px -= 2
	end
	self._take_title:set_font_size(px)
	self._take_kicker:set_font_size(if compact then 10 else 11)
	self._take_line:set_font_size(if compact then 11 else 12)
	for _, chip in self._chip_panels do
		chip:add_theme_stylebox_override(
			"panel",
			UITheme.flat(UITheme.rgba(1, 1, 1, 0.06), 10, UITheme.rgba(1, 1, 1, 0.1), 1, if compact then 8.0 else 10.0, if compact then 4.0 else 7.0)
		)
	end
	for _, value in self._chip do
		value:set_font_size(if compact then 15 else 18)
	end
	self._take_sub:set_min_size(Vector2.new(inner, 0))
	self._take_sub:set_font_size(if compact then 12 else 13)
	self._take_btn:set_min_size(Vector2.new(inner, if compact then 50 else 60))
	self._take_btn:set_font_size(if compact then 17 else 20)
	-- (raw instances inside the button: px)
	local u = UITheme.scale
	local th = (if compact then 30 else 36) * u
	self._take_tag.Size = UDim2.fromOffset(0, th)
	self._take_tag.Position = UDim2.new(1, -10 * u, 0.5, 0)
	self._take_tag_pad.PaddingLeft = UDim.new(0, 10 * u)
	self._take_tag_pad.PaddingRight = UDim.new(0, 12 * u)
	self._take_tag_list.Padding = UDim.new(0, 5 * u)
	self._take_rbx.Size = UDim2.fromOffset(th * 0.55, th * 0.55)
	self._take_price.Size = UDim2.fromOffset(0, th)
	self._take_price.TextSize = math.floor(th * 0.62)
	self._take_corner.CornerRadius = UDim.new(0, 12 * u)
	self._take:set_min_size(Vector2.new(w, 0))
end

function GameOver.set_building(self, on: boolean)
	self._again:set_disabled(on)
	self._again:set_text(if on then "DEPLOYING…" else "PLAY AGAIN")
end

--- Fills the winner / leader pill for owner `id` (hidden when there is none, and on VICTORY).
--- Only touches the label when the text changes (called on every live refresh).
function GameOver._set_pill(self, id: number)
	local s = self.ctx.state
	local wo = if s ~= nil and id ~= 0 then s:get_owner(id) else nil
	local show = wo ~= nil and self._kind ~= "victory"
	self._pill_wanted = show
	-- (apply_layout may leave no room for it on a short screen)
	local vis = show and self._pill_room ~= false
	if vis ~= self._winner.visible then
		self._winner:set_visible(vis)
	end
	if wo == nil then
		self._pill_id = id
		return
	end
	local share = if self._pill_domination then self:_win_share(id) else s:land_share(id)
	local prefix = if self._pill_live then "Current leader  ·  " else ""
	local text = string.format("%s%s  ·  %s", prefix, wo.name, UITheme.fmt_pct(share))
	if id ~= self._pill_id then
		UITheme.set_swatch_color(self._winner_sw, wo.color)
	end
	self._pill_id = id
	if text ~= self._pill_text then
		self._pill_text = text
		self._winner_name:set_text(text)
	end
end

--- Share of the land that counts for victory: contestable land outside fallout (the Sim wins a
--- nation at Rules.WIN_SHARE of it). Equals land_share when nothing is irradiated.
function GameOver._win_share(self, id: number): number
	local ctx = self.ctx
	if ctx.win_share ~= nil then
		return ctx:win_share(id)
	end
	local s = ctx.state
	return if s ~= nil then s:land_share(id) else 0.0
end

--- "80.1% of all land" / "80.1% of the land outside fallout": the victory metric, worded so it
--- can never read as short of the 80% goal while fallout shrinks the land that counts (review R2-4).
function GameOver._win_phrase(self, id: number, all_land: string): string
	local s = self.ctx.state
	return UIRules.win_phrase(
		self:_win_share(id),
		if s ~= nil then s:land_share(id) else 0.0,
		if s ~= nil then (tonumber(s.fallout_count) or 0) else 0,
		all_land
	)
end

function GameOver._leader_id(self): number
	local s = self.ctx.state
	if s == nil then
		return 0
	end
	local r = s:ranking()
	return if #r > 0 then r[1].id else 0
end

--- Headline copy for every way a match can end, so the screen never claims something untrue.
function GameOver._copy(self, kind: string, winner: number, killer: number, reason: number, secs: number): any
	local ctx = self.ctx
	local s = ctx.state
	local R = UICtx.core("Rules")
	local wname = if s ~= nil and winner ~= 0 then s:owner_name(winner) else "Nobody"
	local wshare = if s ~= nil and winner ~= 0 then UITheme.fmt_pct(s:land_share(winner)) else "0%"
	-- Domination is decided on the land outside fallout (Sim._check_victory): the copy uses the same
	-- metric, so it always agrees with the 80% goal (review R2-4).
	local dominated = s ~= nil and winner ~= 0 and self:_win_share(winner) >= R.WIN_SHARE - 0.0005
	self._dominated = dominated
	local wdom = if s ~= nil and winner ~= 0 then self:_win_phrase(winner, "") else "0%"
	local lead = self:_leader_id()
	local lname = if s ~= nil and lead ~= 0 then s:owner_name(lead) else "Nobody"
	local lshare = if s ~= nil and lead ~= 0 then UITheme.fmt_pct(s:land_share(lead)) else "0%"
	local gold_top = Color3.new(1.0, 0.97, 0.86)
	local red_top = Color3.new(1.0, 0.85, 0.85)
	local cyan_top = Color3.new(0.92, 0.97, 1.0)
	local c = { kicker = "MATCH COMPLETE", title = "GAME OVER", sub = "", top = cyan_top, bottom = UITheme.CYAN }
	-- a team game: the team won, together
	local wt = if s ~= nil then tonumber(s.winner_team) or 0 else 0
	if kind ~= "eliminated" and wt ~= 0 and ctx.team_share ~= nil then
		local tshare = UITheme.fmt_pct(ctx:team_share(wt))
		local tname = ctx:team_label(wt)
		local the = if string.sub(tname, 1, 5) == "Team " then tname else "The " .. tname
		if reason == Defs.OVER_TIME then
			c.kicker = "TIME LIMIT REACHED"
		end
		if kind == "victory" then
			c.title = "VICTORY"
			c.top = gold_top
			c.bottom = UITheme.GOLD
			c.sub = if reason == Defs.OVER_TIME
				then string.format("Time! Your team holds the most land with %s.", tshare)
				else string.format("Your team won with %s of the land.", tshare)
		else
			c.title = if kind == "defeat" then "DEFEAT" else "MATCH OVER"
			c.top = if kind == "defeat" then red_top else cyan_top
			c.bottom = if kind == "defeat" then UITheme.RED else UITheme.CYAN
			c.sub = if reason == Defs.OVER_TIME
				then string.format("Time! %s holds the most land with %s.", the, tshare)
				else string.format("%s won with %s of the land.", the, tshare)
		end
		return c
	end
	if kind == "eliminated" then
		c.kicker = "YOUR NATION HAS FALLEN"
		c.title = "ELIMINATED"
		c.top = red_top
		c.bottom = UITheme.RED
		c.sub = if s ~= nil and killer ~= 0
			then string.format("Conquered by %s at %s.", s:owner_name(killer), UITheme.fmt_time(secs))
			else string.format("Your last territory fell at %s.", UITheme.fmt_time(secs))
	elseif kind == "victory" then
		c.title = "VICTORY"
		c.top = gold_top
		c.bottom = UITheme.GOLD
		if reason == Defs.OVER_TIME then
			c.kicker = "TIME LIMIT REACHED"
			c.sub = string.format("Time! You hold the most land with %s.", wshare)
		else
			c.sub = string.format(
				"You conquered the world with %s.",
				if s ~= nil and winner ~= 0 then self:_win_phrase(winner, " of all land") else wshare
			)
		end
	elseif kind == "defeat" then
		c.top = red_top
		c.bottom = UITheme.RED
		if reason == Defs.OVER_TIME then
			c.kicker = "TIME LIMIT REACHED"
			c.title = "TIME'S UP"
			c.sub = string.format("Time! %s holds the most land with %s.", wname, wshare)
		elseif dominated then
			c.title = "DEFEAT"
			c.sub = string.format("%s conquered the world (%s).", wname, wdom)
		else
			c.title = "DEFEAT"
			c.sub = string.format("%s won the war with %s of the land.", wname, wshare)
		end
	else
		if reason == Defs.OVER_TIME then
			c.kicker = "TIME LIMIT REACHED"
			c.title = "TIME'S UP"
			c.sub = string.format("Time! %s holds the most land with %s.", wname, wshare)
		elseif reason == Defs.OVER_DOMINATION then
			c.sub = if dominated
				then string.format("%s conquered the world (%s).", wname, wdom)
				else string.format("%s won the war with %s of the land.", wname, wshare)
		elseif reason == Defs.OVER_DEFEATED then
			c.title = "MATCH OVER"
			c.sub = string.format("Every commander has fallen. %s leads with %s.", lname, lshare)
		elseif reason == Defs.OVER_ABANDONED then
			c.title = "MATCH OVER"
			c.sub = string.format("Every commander left the match. %s leads with %s.", lname, lshare)
		else
			c.title = "MATCH OVER"
			c.sub = string.format("%s leads with %s.", lname, lshare)
		end
	end
	return c
end

--- Multiplayer: when the next match starts (results timer, then the lobby countdown).
function GameOver._refresh_next(self)
	if not self._next.visible then
		return
	end
	local ctx = self.ctx
	local lb = ctx:lobby()
	local stage = tostring(lb.stage or "")
	local cd = tonumber(lb.countdown_s) or 0.0
	if stage == "over" then
		local rematch = 12.0
		local sess = ctx.session
		if sess ~= nil and type(sess.REMATCH_COUNTDOWN_SEC) == "number" then
			rematch = sess.REMATCH_COUNTDOWN_SEC
		end
		self._next:set_text(
			string.format(
				"Next match in %s  ·  results close in %s",
				UITheme.fmt_time(math.ceil(cd + rematch)),
				UITheme.fmt_time(math.ceil(cd))
			)
		)
	elseif stage == "lobby" then
		self._next:set_text("Next match in " .. UITheme.fmt_time(math.ceil(cd)))
	else
		self._next:set_text("Stay here for the next match, or return to the title.")
	end
end

function GameOver.close(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	if self._enter_tween ~= nil then
		self._enter_tween:kill()
		self._enter_tween = nil
	end
	local t = self:create_tween()
	self._close_tween = t
	t:tween_property(self, "modulate:a", 0.0, 0.25)
	t:tween_callback(function()
		if self._close_tween == t then
			self._close_tween = nil
		end
		if not self.is_open then
			self:set_visible(false)
			self:set_modulate_a(1.0)
		end
	end)
	self.ctx:set_world_input(true)
end

function GameOver.apply_layout(self)
	local ctx = self.ctx
	local compact = ctx.compact
	local title_px = if compact
		then math.floor(math.clamp(ctx.vp.Y * 0.14, 44.0, 60.0))
		else math.floor(math.clamp(math.min(ctx.vp.X * 0.07, ctx.vp.Y * 0.12), 72.0, 128.0))
	if compact and self._take.visible then
		-- (phones with the takeover offer: a smaller headline keeps the offer's chips on screen)
		title_px = 40
	end
	self._title:set_px(title_px)
	self._title.spacing = if compact then 6 else 10
	self._title:update_minimum_size()
	self._sub:set_font_size(if compact then 14 else 18)
	self._kicker:set_font_size(if compact then 11 else 14)
	for _, b in ipairs({ self._again, self._spec, self._home }) do
		b:set_min_size(Vector2.new(if compact then 150 else 200, if compact then 44 else 52))
	end
	self._stars_btn:set_min_size(Vector2.new(if compact then 110 else 150, if compact then 44 else 52))
	self._gap4:set_min_size(Vector2.new(0, if compact then (if self._take.visible then 6 else 10) else 16))
	local take = self._take.visible
	-- the offers: not beside the takeover offer (one thing to buy at a time)
	local offers = (self._goal_wanted == true or self._x2_wanted == true) and not take
	self._goal_btn:set_visible(self._goal_wanted == true)
	self._x2_btn:set_visible(self._x2_wanted == true)
	for _, b in ipairs({ self._goal_btn, self._x2_btn }) do
		b:set_min_size(Vector2.new(0, if compact then 34 else 40))
		b:set_font_size(if compact then 12 else 13)
	end
	self._gap_offers:set_min_size(Vector2.new(0, if compact then 6 else 10))
	self._offers:set_visible(offers)
	self._gap_offers:set_visible(offers)
	self._sub:set_visible(true)
	self._gap_next:set_visible(self._next.visible)
	if take then
		self:_size_take()
		-- phones: the chips fold into one line under the card's title, the kicker goes
		self._take_sub:set_visible(true)
		self._take_chips:set_visible(not compact)
		self._take_line:set_visible(compact)
		self._take_kicker:set_visible(not compact)
	end
	self._pill_room = true
	self._winner:set_visible(self._pill_wanted == true)
	-- (the offer takes the stat cards' place)
	self._stats:set_visible(not take)
	self._gap3:set_visible(not take)
	self._gap2:set_min_size(Vector2.new(0, if compact then 14 else (if take then 18 else 26)))
	self._gap3:set_min_size(Vector2.new(0, if compact then 14 else (if take then 18 else 28)))
	local sz = self._center:get_combined_minimum_size()
	local area = ctx:clear_rect()
	if sz.Y > area.Height - 8.0 then
		-- Short screens (phones; a screen with the takeover offer): drop the kicker line and tighten
		-- the gaps until it fits.
		self._kicker:set_visible(false)
		self._gap2:set_min_size(Vector2.new(0, 8))
		self._gap3:set_min_size(Vector2.new(0, 8))
		sz = self._center:get_combined_minimum_size()
		-- still too tall with the offers (a phone): the "Current leader" pill gives them its line (the
		-- leaderboard says who leads; a result's winner stays), then the 2x Stars offer goes, then
		-- the next unlock too
		if offers and sz.Y > area.Height - 8.0 and self._pill_live and self._winner.visible then
			self._pill_room = false
			self._winner:set_visible(false)
			sz = self._center:get_combined_minimum_size()
		end
		if offers and sz.Y > area.Height - 8.0 and self._x2_btn.visible and self._goal_btn.visible then
			self._x2_btn:set_visible(false)
			sz = self._center:get_combined_minimum_size()
		end
		if offers and sz.Y > area.Height - 8.0 then
			self._offers:set_visible(false)
			self._gap_offers:set_visible(false)
			-- (and the pill has its line back)
			if not self._pill_room and not take then
				self._pill_room = true
				self._winner:set_visible(self._pill_wanted == true)
			end
			sz = self._center:get_combined_minimum_size()
		end
		-- still too tall with the takeover offer: the leader pill steps aside
		if take and sz.Y > area.Height - 8.0 then
			self._pill_room = false
			self._winner:set_visible(false)
			sz = self._center:get_combined_minimum_size()
		end
		-- then the offer's own extras: its line of copy, then its chips
		if take and sz.Y > area.Height - 8.0 then
			self._take_sub:set_visible(false)
			sz = self._center:get_combined_minimum_size()
		end
		-- ("Conquered by X": the offer names X already)
		if take and sz.Y > area.Height - 8.0 then
			self._sub:set_visible(false)
			sz = self._center:get_combined_minimum_size()
		end
		if take and sz.Y > area.Height - 8.0 and self._take_chips.visible then
			self._take_chips:set_visible(false)
			self._take_line:set_visible(true)
			sz = self._center:get_combined_minimum_size()
		end
	else
		self._kicker:set_visible(true)
	end
	local p = area.Min + (Vector2.new(area.Width, area.Height) - sz) * 0.5
	local y = math.max(p.Y, area.Min.Y + 2.0)
	local rp = Vector2.new(math.floor(p.X + 0.5), math.floor(y + 0.5))
	self._center:set_offsets(rp.X, rp.Y, rp.X + sz.X, rp.Y + sz.Y)
	self._center:reset_size()
	local ts = self._title:get_combined_minimum_size()
	self._title.y0 = ts.Y * 0.2
	self._title.span = ts.Y * 0.62
	self._title:_redraw()
end

--- The offer's life: its glow breathes, a shine sweeps over the button every few seconds.
function GameOver._animate_take(self, delta: number)
	local glow = self._take_glow
	if not self._take.visible then
		if glow.ImageTransparency < 1 then
			glow.ImageTransparency = 1
		end
		return
	end
	self._take_t += delta
	local t = self._take_t
	-- the glow sits under the card (the column's px coordinates)
	local cg, tg = self._center.gui, self._take.gui
	local rel = tg.AbsolutePosition - cg.AbsolutePosition
	local sz = tg.AbsoluteSize
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromOffset(rel.X + sz.X * 0.5, rel.Y + sz.Y * 0.5)
	glow.Size = UDim2.fromOffset(sz.X * 1.75, sz.Y * 2.3)
	local a = (0.5 + 0.15 * math.sin(t * 2.6)) * self._take.modulate_a * self.modulate_a
	glow.ImageTransparency = 1 - a
	local k = (t % 3.2) / 0.9
	self._take_shine.Offset = Vector2.new(if k < 1 then -1 + 2 * k else 1, 0)
end

function GameOver._process(self, delta: number)
	if not self.is_open then
		return
	end
	-- the Stars count up to the payout (a tick for every step, a chime at the end)
	local award = self._award
	if award ~= nil and not self._stars_done and self._buttons.modulate_a > 0.5 then
		local total = award.total
		self._stars_shown = math.min(total, self._stars_shown + math.max(total / 1.1, 60) * delta)
		local k = self._stars_shown / math.max(total, 1)
		self._stars_btn:set_text("+" .. UICtx.commas(math.floor(self._stars_shown)))
		if self._stars_shown >= total then
			self._stars_done = true
			self.ctx:sfx("star_get")
			UICtx.pop_in(self._stars_btn, 0.0, 1.12, 0.3)
		else
			self.ctx:sfx("star_tick", -6.0, 0.0, 0.8 + 0.6 * k)
		end
	end
	self._next_accum += delta
	if self._next_accum >= 0.25 then
		self._next_accum = 0.0
		self:_refresh_next()
		-- ELIMINATED while the war goes on: the "Current leader" pill follows the leaderboard
		-- (review R2-2; the original kept the snapshot taken when the screen opened).
		local s = self.ctx.state
		if self._pill_live and s ~= nil and s.phase == Defs.PHASE_PLAYING then
			self:_set_pill(self:_leader_id())
		end
		if self._take.visible then
			self:_refresh_take_chips()
		end
	end
	self:_animate_take(delta)
	if self._sweep_t < 0.0 then
		return
	end
	self._sweep_t += delta
	local w = self._title.size.X
	self._title.sweep = -200.0 + (w + 400.0) * math.clamp((self._sweep_t - 0.9) / 1.1, 0.0, 1.0)
	self._title:_redraw()
	if self._sweep_t > 2.2 then
		self._sweep_t = -1.0
		self._title.sweep = -10000.0
		self._title:_redraw()
	end
end

return GameOver
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="155">
            <Properties>
              <string name="Name">GeneralButton</string>
              <string name="Source"><![CDATA[--!nonstrict
-- The title screen's RoWorld General button (Data/Subscription; 2026-10-27), under the flag shop's and
-- the starter pack's: a night-blue card edged in gold, a general's three stars on a slowly turning
-- sunburst, GENERAL in gold, a line that cycles through what a General gets, a gold MONTHLY tab on its
-- corner, a gold glow breathing behind it, a light that crosses it every few seconds and a star that
-- glints now and then. The first
-- version (a plain glass button reading ROWORLD GENERAL) was easy to miss. A General sees GENERAL and
-- "Your perks are on". pressed() -> UIRoot opens the window (GeneralOffer). Hidden where the
-- subscription doesn't exist (Subscription.id() == "").
local UITheme = require("./UITheme")
local W = require("./Widgets")
local UICtx = require("./UICtx")
local Signal = UITheme.core("Signal")

local IS_ROBLOX = typeof(game) == "Instance"
local TweenService = if IS_ROBLOX then game:GetService("TweenService") else nil
local Subscription = UICtx.data("Subscription")

local GeneralButton = W.class(W.Control)

--- The card, desktop logical px (phones: PHONE_K of it), as the starter pack's.
GeneralButton.SIZE = Vector2.new(232, 82)
GeneralButton.PHONE_K = 0.72
--- The light crosses it this often; the line under GENERAL changes this often.
GeneralButton.SHINE_S = 3.8
GeneralButton.LINE_S = 2.6

local GOLD = Color3.fromRGB(255, 205, 86)
local GOLD_LIGHT = Color3.fromRGB(255, 238, 178)
local GOLD_DARK = Color3.fromRGB(176, 120, 22)
local INK = Color3.fromRGB(46, 28, 2)
local WHITE = Color3.new(1, 1, 1)
local FONT_H = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Heavy)
local FONT_B = Font.fromId(UITheme.FONT_ID, Enum.FontWeight.Bold)

local function new(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in props do
		(i :: any)[k] = v
	end
	if parent then
		i.Parent = parent
	end
	return i
end

local function tween(inst: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	if TweenService ~= nil then
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
			:Play()
	end
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	props.BackgroundTransparency = 1
	props.FontFace = props.FontFace or FONT_H
	props.TextColor3 = props.TextColor3 or WHITE
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return new("TextLabel", props, parent)
end

--- What a General gets, one line at a time under GENERAL.
function GeneralButton.lines(): { string }
	return {
		"A free crate every day",
		string.format("+%d%% Stars every match", math.floor(Subscription.STARS_BONUS * 100 + 0.5)),
		"A new skin every month",
	}
end

function GeneralButton.new(c: any)
	local self = setmetatable({}, GeneralButton.__mt)
	W.Control._init(self)
	self.ctx = c
	self.pressed = Signal.new()
	self._k = 1.0
	self._t = 0.0
	self._shine_t = GeneralButton.SHINE_S - 1.0
	self._line_t = 0.0
	self._line = 1
	self._on = false
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:_build()
	self:set_visible(Subscription.id() ~= "")
	self:set_process(true)
	return self
end

function GeneralButton._build(self)
	local root = self.gui
	root.ClipsDescendants = false
	local S = GeneralButton.SIZE
	-- built at SIZE and scaled (phones, UITheme.scale, hover / press), anchored at its middle
	local body = new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(S.X, S.Y),
		ZIndex = 1,
	}, root)
	self._scale = new("UIScale", {}, body)
	-- a gold glow behind the card, breathing (_process)
	self._halo = new("ImageLabel", {
		Name = "Halo",
		BackgroundTransparency = 1,
		Image = UITheme.crate_art().glow or "",
		ImageColor3 = GOLD,
		ImageTransparency = 0.7,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.45, 2.1),
		ZIndex = 1,
	}, body)
	local card = new("Frame", {
		Name = "Card",
		BackgroundColor3 = WHITE,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0, 14) }, card)
	new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(34, 48, 92), Color3.fromRGB(8, 12, 30)),
		Rotation = 90,
	}, card)
	-- a gold edge with a highlight that travels round it
	local stroke =
		new("UIStroke", { Color = WHITE, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, card)
	self._edge = new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, GOLD_DARK),
			ColorSequenceKeypoint.new(0.45, GOLD),
			ColorSequenceKeypoint.new(0.5, GOLD_LIGHT),
			ColorSequenceKeypoint.new(0.55, GOLD),
			ColorSequenceKeypoint.new(1, GOLD_DARK),
		}),
	}, stroke)
	-- the insignia: a sunburst, a glow, three stars
	local art = UITheme.crate_art()
	self._rays = new("ImageLabel", {
		Name = "Rays",
		BackgroundTransparency = 1,
		Image = art.rays or "",
		ImageColor3 = GOLD,
		ImageTransparency = 0.72,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(42, 41),
		Size = UDim2.fromOffset(120, 120),
		ZIndex = 3,
	}, card)
	new("ImageLabel", {
		Name = "Glow",
		BackgroundTransparency = 1,
		Image = art.glow or "",
		ImageColor3 = Color3.fromRGB(255, 196, 90),
		ImageTransparency = 0.45,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(42, 41),
		Size = UDim2.fromOffset(92, 84),
		ZIndex = 3,
	}, card)
	local star = UITheme.icon("star") or ""
	local function star_at(x: number, y: number, px: number, rot: number): ImageLabel
		return new("ImageLabel", {
			BackgroundTransparency = 1,
			Image = star,
			ImageColor3 = GOLD,
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(px, px),
			Rotation = rot,
			ZIndex = 4,
		}, card)
	end
	star_at(19, 47, 22, -12)
	star_at(65, 47, 22, 12)
	self._star = star_at(42, 39, 38, 0)
	self._glint = new("ImageLabel", {
		Name = "Glint",
		BackgroundTransparency = 1,
		Image = art.sparkle or "",
		ImageColor3 = WHITE,
		ImageTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(52, 26),
		Size = UDim2.fromOffset(26, 26),
		ZIndex = 5,
	}, card)
	-- the words
	text(card, {
		Text = "ROWORLD",
		FontFace = FONT_B,
		TextSize = 11,
		TextColor3 = GOLD_LIGHT,
		TextTransparency = 0.15,
		Position = UDim2.fromOffset(84, 9),
		Size = UDim2.fromOffset(140, 14),
		ZIndex = 6,
	})
	local title = text(card, {
		Text = "GENERAL",
		TextSize = 25,
		Position = UDim2.fromOffset(83, 21),
		Size = UDim2.fromOffset(140, 28),
		ZIndex = 6,
	})
	new("UIGradient", { Color = ColorSequence.new(GOLD_LIGHT, GOLD), Rotation = 90 }, title)
	new("UIStroke", { Color = INK, Thickness = 1.5, Transparency = 0.2 }, title)
	self._title = title
	self._perk = text(card, {
		Text = GeneralButton.lines()[1],
		FontFace = FONT_B,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(220, 228, 250),
		Position = UDim2.fromOffset(84, 52),
		Size = UDim2.fromOffset(142, 18),
		ZIndex = 6,
	})
	self._shine = new("Frame", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.78,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(-0.2, 0.5),
		Size = UDim2.new(0, 24, 1.8, 0),
		Rotation = 18,
		ZIndex = 7,
	}, card)
	-- the tab, out over the corner
	local tab = new("Frame", {
		Name = "Tab",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = WHITE,
		Position = UDim2.fromOffset(S.X - 30, 1),
		Size = UDim2.fromOffset(64, 20),
		Rotation = 6,
		ZIndex = 9,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, tab)
	new("UIGradient", { Color = ColorSequence.new(GOLD_LIGHT, GOLD), Rotation = 90 }, tab)
	new(
		"UIStroke",
		{ Color = INK, Thickness = 1.5, Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border },
		tab
	)
	self._tab = tab
	self._tab_text = text(tab, {
		Text = "MONTHLY",
		TextSize = 11,
		TextColor3 = INK,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
	})
	-- the hit area
	local hit = new("TextButton", {
		Name = "Hit",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
	}, body)
	local hover = false
	hit.MouseEnter:Connect(function()
		hover = true
		tween(self._scale, 0.12, { Scale = self:_k_px() * 1.05 })
	end)
	hit.MouseLeave:Connect(function()
		hover = false
		tween(self._scale, 0.12, { Scale = self:_k_px() })
	end)
	hit.MouseButton1Down:Connect(function()
		tween(self._scale, 0.08, { Scale = self:_k_px() * 0.95 })
	end)
	hit.MouseButton1Up:Connect(function()
		tween(self._scale, 0.12, { Scale = self:_k_px() * (if hover then 1.05 else 1) })
	end)
	hit.Activated:Connect(function()
		self.ctx:sfx("click")
		self.pressed:Fire()
	end)
end

--- The UIScale for the card's px: the phone factor times UITheme.scale.
function GeneralButton._k_px(self): number
	return self._k * UITheme.scale
end

--- `k`: 1 on desktop, PHONE_K on phones (also follows UITheme.scale: call it from apply_layout).
function GeneralButton.set_scale(self, k: number)
	self._k = k
	self._scale.Scale = self:_k_px()
	self:set_min_size(self:size_px())
end

--- Its size in logical px.
function GeneralButton.size_px(self): Vector2
	return GeneralButton.SIZE * self._k
end

--- Subscribed or not (Session.general): a General's card says so instead of selling.
function GeneralButton.refresh(self)
	local s = self.ctx.session
	local on = s ~= nil and s.general == true
	self:set_visible(Subscription.id() ~= "")
	if on == self._on then
		return
	end
	self._on = on
	self._tab_text.Text = if on then "ACTIVE" else "MONTHLY"
	self._perk.Text = if on then "Your perks are on" else GeneralButton.lines()[self._line]
	self._perk.TextTransparency = 0
end

function GeneralButton._process(self, dt: number)
	if not self.visible then
		return
	end
	self._t += dt
	local t = self._t
	self._rays.Rotation = (t * 12) % 360
	self._star.Size = UDim2.fromOffset(38 + math.sin(t * 2.2) * 2.5, 38 + math.sin(t * 2.2) * 2.5)
	self._edge.Rotation = (t * 70) % 360
	self._halo.ImageTransparency = 0.68 + math.sin(t * 1.8) * 0.12
	self._tab.Rotation = 6 + math.sin(t * 2.4) * 3
	-- a glint on the big star, briefly, every couple of seconds
	local g = (t % 2.3) / 2.3
	self._glint.ImageTransparency = if g < 0.18 then 1 - math.sin(g / 0.18 * math.pi) * 0.9 else 1
	self._glint.Rotation = g * 180
	-- the line under GENERAL: what a General gets, in turn (cross-fading)
	if not self._on then
		self._line_t += dt
		local lines = GeneralButton.lines()
		local left = GeneralButton.LINE_S - self._line_t
		if left <= 0 then
			self._line_t = 0
			self._line = self._line % #lines + 1
			self._perk.Text = lines[self._line]
		end
		local fade = math.min(self._line_t / 0.25, math.max(left, 0) / 0.25, 1)
		self._perk.TextTransparency = 1 - fade
	end
	self._shine_t += dt
	if self._shine_t >= GeneralButton.SHINE_S then
		self._shine_t = 0
		self._shine.Position = UDim2.fromScale(-0.2, 0.5)
		tween(self._shine, 0.7, { Position = UDim2.fromScale(1.2, 0.5) })
	end
end

return GeneralButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">GeneralOffer</string>
              <string name="Source"><![CDATA[--!nonstrict
-- RoWorld General's window (Data/Subscription; 2026-10-27): what the monthly subscription gives, and
-- SUBSCRIBE, which opens Roblox's own prompt (MarketplaceService:PromptSubscriptionPurchase). Roblox
-- bills and renews it; the server hears of it (server/General, OP.GENERAL) and the window then says
-- the player is a General. Opened from the title's General button.
--
--   GeneralOffer.new(ctx)   :bind(session)   :open(from)   :close()   .closed (Signal)   .is_open
local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local Locker = require("./Locker")
local Signal = UITheme.core("Signal")

local IS_ROBLOX = typeof(game) == "Instance"
local Subscription = UICtx.data("Subscription")
local Cosmetics = UICtx.data("Cosmetics")

local GeneralOffer = W.class(W.Control)

--- The columns' widths (logical px): the perks, and the price and SUBSCRIBE; phones: COMPACT_*.
GeneralOffer.LEFT_W = 300
GeneralOffer.SIDE_W = 190
GeneralOffer.COMPACT_LEFT_W = 250
GeneralOffer.COMPACT_SIDE_W = 160
--- After a try to subscribe, the server's word is waited for this long before the button comes back.
GeneralOffer.WAIT_S = 30.0

function GeneralOffer.new(c: any)
	local self = setmetatable({}, GeneralOffer.__mt)
	W.Control._init(self)
	self.ctx = c
	self.closed = Signal.new()
	self.is_open = false
	--- after Roblox's prompt closed with a try to buy: os.clock() then (the server's word is due)
	self._waiting = nil :: number?
	--- Roblox's price for this player: { robux = n } or { text = "..." } (nil: not known yet)
	self._cost = nil
	self._price_asked = false
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	self:set_visible(false)
	self._dim = W.ColorRect.new(UITheme.rgba(0.01, 0.015, 0.05, 0.78))
	self._dim:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._dim.gui_input:Connect(function(e)
		if e.pressed and not self._panel:has_global_point(e.global_position) then
			self:close()
		end
	end)
	self:add_child(self._dim)
	self:_build()
	if IS_ROBLOX then
		pcall(function()
			game:GetService("MarketplaceService").PromptSubscriptionPurchaseFinished:Connect(function(_u, sid, tried)
				if sid == Subscription.id() then
					self:_on_prompt_done(tried == true)
				end
			end)
		end)
	end
	self:set_process(true)
	return self
end

function GeneralOffer._build(self)
	self._panel = GlassPanel.new(24.0, 18.0, 18, true, 34)
	self._panel:set_tint(UITheme.rgba(0.045, 0.065, 0.13, 0.97))
	self._panel:set_border(UITheme.c(UITheme.GOLD, 0.45))
	self:add_child(self._panel)
	local v = UITheme.vbox(10)
	self._v = v
	self._panel:add_child(v)
	-- head: what it is, close
	local head = UITheme.hbox(10)
	local cap = UITheme.caption("MONTHLY SUBSCRIPTION", 11, UITheme.GOLD)
	cap.size_flags_horizontal = W.EXPAND_FILL
	cap.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(cap)
	local close = W.Button.new("", "GhostButton")
	close:set_icon("close")
	close.expand_icon = true
	close:set_min_size(Vector2.new(34, 34))
	close:add_theme_constant_override("icon_max_width", 13)
	close:add_theme_stylebox_override("normal", UITheme.empty_box(8, 8))
	close:add_theme_stylebox_override("hover", UITheme.flat(UITheme.FILL, 8, UITheme.CLEAR, 0, 8, 8))
	close.size_flags_vertical = W.SHRINK_CENTER
	close.pressed:Connect(function()
		self:close()
	end)
	head:add_child(close)
	v:add_child(head)
	-- two columns (2026-10-27: in one, the window ran off a phone's screen): the perks, and the
	-- insignia over the price and SUBSCRIBE
	local body = UITheme.hbox(20)
	v:add_child(body)
	local left = UITheme.vbox(10)
	left.size_flags_vertical = W.SHRINK_CENTER
	body:add_child(left)
	self._title = UITheme.label("ROWORLD GENERAL", 26, 800, UITheme.GOLD, 2)
	left:add_child(self._title)
	self._sub = UITheme.label("Every perk below, every month.", 13, 500, UITheme.TEXT_2)
	self._sub:set_autowrap(true)
	left:add_child(self._sub)
	self._perk_daily = self:_perk(left, UITheme.icon_rect("crate", 20, UITheme.GOLD))
	self._perk_stars = self:_perk(left, UITheme.icon_rect("star", 20, UITheme.GOLD))
	local sw = W.Control.new()
	sw:set_min_size(Vector2.new(24, 24))
	sw:set_mouse_filter(W.MOUSE_IGNORE)
	if IS_ROBLOX then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Size = UDim2.fromScale(1, 1)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = img
		img.Parent = sw.gui
		self._skin_img = img
	end
	self._perk_skin = self:_perk(left, sw)
	local right = UITheme.vbox(8)
	right.size_flags_vertical = W.SHRINK_CENTER
	self._right = right
	body:add_child(right)
	self._insignia = self:_build_insignia()
	right:add_child(self._insignia)
	self._price = UITheme.label("", 20, 800, UITheme.GOLD)
	self._price:set_alignment(W.ALIGN_CENTER)
	right:add_child(self._price)
	self._buy = UITheme.button("SUBSCRIBE", "PrimaryButton", "", 48.0)
	self._buy.pressed:Connect(function()
		self:_subscribe()
	end)
	right:add_child(self._buy)
	self._note = UITheme.label("", 11, 500, UITheme.TEXT_3)
	self._note:set_alignment(W.ALIGN_CENTER)
	self._note:set_autowrap(true)
	right:add_child(self._note)
end

--- A general's three stars on a slowly turning sunburst (the title's General button's insignia).
function GeneralOffer._build_insignia(self): any
	local c = W.Control.new()
	c:set_mouse_filter(W.MOUSE_IGNORE)
	c:set_min_size(Vector2.new(GeneralOffer.SIDE_W, 92))
	if not IS_ROBLOX then
		return c
	end
	local art = UITheme.crate_art()
	local function img(props: { [string]: any }): ImageLabel
		local i = Instance.new("ImageLabel")
		i.BackgroundTransparency = 1
		i.AnchorPoint = Vector2.new(0.5, 0.5)
		i.ScaleType = Enum.ScaleType.Fit
		for k, val in props do
			(i :: any)[k] = val
		end
		i.Parent = c.gui
		return i
	end
	self._rays = img({
		Image = art.rays or "",
		ImageColor3 = UITheme.GOLD,
		ImageTransparency = 0.75,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.0, 1.6),
	})
	img({
		Image = art.glow or "",
		ImageColor3 = Color3.fromRGB(255, 196, 90),
		ImageTransparency = 0.5,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 1.1),
	})
	local star = UITheme.icon("star") or ""
	for _, st in { { 0.27, 0.6, 0.32, -12 }, { 0.73, 0.6, 0.32, 12 }, { 0.5, 0.45, 0.62, 0 } } do
		img({
			Image = star,
			ImageColor3 = UITheme.GOLD,
			Position = UDim2.fromScale(st[1], st[2]),
			Size = UDim2.fromScale(st[3] * 0.62, st[3]),
			Rotation = st[4],
		})
	end
	return c
end

--- A perk's row: `glyph` in a gold disc, a bold line and a muted one under it.
function GeneralOffer._perk(_self, parent: any, glyph: any): any
	local row = UITheme.hbox(12)
	local disc = W.Panel.new()
	disc:set_mouse_filter(W.MOUSE_IGNORE)
	disc:set_min_size(Vector2.new(40, 40))
	disc.size_flags_vertical = W.SHRINK_CENTER
	disc:add_theme_stylebox_override(
		"panel",
		UITheme.flat(UITheme.c(UITheme.GOLD, 0.14), 20, UITheme.c(UITheme.GOLD, 0.5), 1)
	)
	glyph.size_flags_horizontal = W.SHRINK_CENTER
	glyph.size_flags_vertical = W.SHRINK_CENTER
	disc:add_child(glyph)
	row:add_child(disc)
	local col = UITheme.vbox(2)
	col.size_flags_horizontal = W.EXPAND_FILL
	col.size_flags_vertical = W.SHRINK_CENTER
	local head = UITheme.label("", 15, 700, UITheme.TEXT)
	local body = UITheme.label("", 12, 500, UITheme.TEXT_2)
	body:set_autowrap(true)
	col:add_child(head)
	col:add_child(body)
	row:add_child(col)
	parent:add_child(row)
	return { head = head, body = body, disc = disc }
end

function GeneralOffer.bind(self, s: any)
	self.session = s
	if s ~= nil and s.general_changed ~= nil then
		self:_connect(s.general_changed:Connect(function(on: boolean)
			if on then
				self._waiting = nil
			end
			if self.is_open then
				self:refresh()
			end
		end))
	end
end

function GeneralOffer._report(self, kind: string, a: any?)
	local s = self.ctx.session
	if s ~= nil and type(s.report) == "function" then
		s:report("general", kind, a)
	end
end

--- Subscribed, as the server last said.
function GeneralOffer.subscribed(self): boolean
	local s = self.ctx.session
	return s ~= nil and s.general == true
end

--- Roblox's price for this player (MarketplaceService:GetSubscriptionProductInfoAsync), asked once.
function GeneralOffer._fetch_price(self)
	if self._price_asked or not IS_ROBLOX or Subscription.id() == "" then
		return
	end
	self._price_asked = true
	task.spawn(function()
		local ok, info = pcall(function()
			return (game:GetService("MarketplaceService") :: any):GetSubscriptionProductInfoAsync(Subscription.id())
		end)
		if ok and type(info) == "table" then
			local robux = tonumber(info.PriceInRobux)
			if robux ~= nil and robux > 0 then
				self._cost = { robux = robux }
			elseif type(info.DisplayPrice) == "string" and info.DisplayPrice ~= "" then
				self._cost = { text = info.DisplayPrice }
			end
			if self.is_open then
				self:refresh()
			end
		else
			self._price_asked = false -- (asked again next time it opens)
		end
	end)
end

function GeneralOffer.refresh(self)
	local inv = if self.ctx.session ~= nil then self.ctx.session.inventory else nil
	local crates = type(inv) == "table" and inv.crates_allowed == true
	local daily = self._perk_daily
	if crates then
		daily.head:set_text("A free crate every day")
		daily.body:set_text("Play on any day to get it. Never a duplicate.")
	else
		daily.head:set_text(string.format("%s Stars every day", UICtx.commas(Subscription.DAILY_STARS)))
		daily.body:set_text("Play on any day to get them.")
	end
	self._perk_stars.head:set_text(
		string.format("+%d%% Stars every match", math.floor(Subscription.STARS_BONUS * 100 + 0.5))
	)
	self._perk_stars.body:set_text("On top of 2x Stars.")
	local skin = Cosmetics.item(Subscription.skin_for(os.time()))
	self._perk_skin.head:set_text("This month's General skin")
	self._perk_skin.body:set_text(
		(if skin ~= nil then skin.name .. ". " else "") .. "A new one every month, yours to keep."
	)
	if self._skin_img ~= nil and skin ~= nil then
		Locker.show_item(self._skin_img, skin)
	end
	local on = self:subscribed()
	local p = self._cost
	self._price:set_text(
		if p ~= nil and p.text ~= nil
			then p.text .. " / month"
			else string.format("%d Robux / month", if p ~= nil then p.robux else Subscription.ROBUX)
	)
	self._price:set_visible(not on)
	if on then
		self._buy:set_text("YOU'RE A GENERAL")
		self._buy:set_disabled(true)
		self._note:set_text("Thank you! It renews every month. Cancel any time in Roblox's settings.")
	elseif self._waiting ~= nil then
		self._buy:set_text("WAITING FOR ROBLOX…")
		self._buy:set_disabled(true)
		self._note:set_text("")
	else
		self._buy:set_text("SUBSCRIBE")
		self._buy:set_disabled(Subscription.id() == "")
		self._note:set_text("Renews every month. Cancel any time in Roblox's settings.")
	end
	if self.is_open and self.visible then
		self:apply_layout() -- (the lines' heights change with what they say)
	end
end

function GeneralOffer._subscribe(self)
	if self:subscribed() or self._waiting ~= nil or Subscription.id() == "" or not IS_ROBLOX then
		return
	end
	self:_report("clicked")
	local ok = pcall(function()
		(game:GetService("MarketplaceService") :: any):PromptSubscriptionPurchase(
			game:GetService("Players").LocalPlayer,
			Subscription.id()
		)
	end)
	if not ok then
		self._note:set_text("Subscriptions aren't available right now.")
	end
end

--- Roblox's prompt closed; `tried`: the player went ahead (the server's word follows: OP.GENERAL).
function GeneralOffer._on_prompt_done(self, tried: boolean)
	if not tried or self:subscribed() then
		return
	end
	self:_report("prompt_done")
	self._waiting = os.clock()
	if self.is_open then
		self:refresh()
	end
end

function GeneralOffer._process(self, _dt: number)
	if self.is_open and self._rays ~= nil then
		self._rays.Rotation = (os.clock() * 12) % 360
	end
	if self._waiting ~= nil and os.clock() - self._waiting > GeneralOffer.WAIT_S then
		self._waiting = nil
		if self.is_open then
			self:refresh()
		end
	end
end

function GeneralOffer.open(self, from: string?)
	if self.is_open then
		return
	end
	self.is_open = true
	self:_report("opened", from or "button")
	self:_fetch_price()
	self:refresh()
	self:set_visible(true)
	self:apply_layout()
	self._panel:set_modulate_a(1.0)
	self._dim:set_modulate_a(0.0)
	W.fade(self._dim, 1.0, 0.2)
	UICtx.pop_in(self._panel, 0.0, 0.94, 0.3)
	self.ctx:sfx("open")
end

function GeneralOffer.close(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	self.ctx:sfx("close")
	local t = self:create_tween():set_parallel(true)
	t:tween_property(self._dim, "modulate:a", 0.0, 0.15)
	t:tween_property(self._panel, "modulate:a", 0.0, 0.15)
	t:chain():tween_callback(function()
		if not self.is_open then
			self:set_visible(false)
		end
	end)
	self.closed:Fire()
end

function GeneralOffer.apply_layout(self)
	local ctx = self.ctx
	local compact = ctx.compact
	local lw = if compact then GeneralOffer.COMPACT_LEFT_W else GeneralOffer.LEFT_W
	local rw = if compact then GeneralOffer.COMPACT_SIDE_W else GeneralOffer.SIDE_W
	local perks = { self._perk_daily, self._perk_stars, self._perk_skin }
	self._v:set_separation(if compact then 6 else 10)
	self._title:set_font_size(if compact then 20 else 26)
	self._sub:set_min_size(Vector2.new(lw, 0))
	self._note:set_min_size(Vector2.new(rw, 0))
	self._note:set_font_size(if compact then 10 else 11)
	for _, pk in perks do
		pk.head:set_font_size(if compact then 13 else 15)
		pk.body:set_font_size(if compact then 11 else 12)
		pk.body:set_min_size(Vector2.new(lw - 52, 0))
		pk.disc:set_min_size(if compact then Vector2.new(32, 32) else Vector2.new(40, 40))
	end
	self._insignia:set_min_size(Vector2.new(rw, if compact then 64 else 92))
	self._price:set_font_size(if compact then 16 else 20)
	self._buy:set_min_size(Vector2.new(rw, if compact then 40 else 48))
	-- all of it, then (a short phone) what doesn't fit goes, a piece at a time: the line under the
	-- title, the perks' second lines, the insignia, the note
	local area = ctx:clear_rect()
	local pn = self._panel
	local function over(): number
		pn:reset_size()
		return pn:get_combined_minimum_size().Y - (area.Height - 8.0)
	end
	local parts = { { self._sub }, {}, { self._insignia }, { self._note } }
	for _, pk in perks do
		table.insert(parts[2], pk.body)
	end
	for _, group in parts do
		for _, ctl in group do
			ctl:set_visible(true)
		end
	end
	for _, group in parts do
		if over() <= 0 then
			break
		end
		for _, ctl in group do
			ctl:set_visible(false)
		end
	end
	pn:reset_size()
	local sz = pn:get_combined_minimum_size()
	local pos = area.Min + (Vector2.new(area.Width, area.Height) - sz) * 0.5
	local rp = Vector2.new(math.floor(pos.X + 0.5), math.floor(math.max(pos.Y, area.Min.Y + 4.0) + 0.5))
	pn:set_offsets(rp.X, rp.Y, rp.X, rp.Y)
	pn:reset_size()
end

return GeneralOffer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">GlassPanel</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/glass_panel.gd (UIGlass)
-- Frosted-glass panel: navy tint, 1 px light border, a top sheen line and a soft drop shadow.
-- Lays out its children like a PanelContainer (inside the padding).
--
-- Roblox has no backdrop blur, so the glass is drawn as the GDScript no-frost path does (a flat
-- translucent tint, UITheme.GLASS_BOOST more opaque) plus the frost shader's top sheen gradient.
-- Parts: shadow (9-slice, Assets/UIKit shadows) < tint (UICorner + inner UIStroke border)
-- < sheen gradient < sheen line / accent stripe < content.

local UITheme = require("./UITheme")
local W = require("./Widgets")

local GlassPanel = W.class(W.Panel)

-- smoothstep(0, 0.6, y) as a transparency sequence (frost shader: sheen * (1 - smoothstep(0, 0.6, UV.y)))
local SHEEN_SEQ = NumberSequence.new({
	NumberSequenceKeypoint.new(0.0, 0.0),
	NumberSequenceKeypoint.new(0.1, 0.074),
	NumberSequenceKeypoint.new(0.2, 0.259),
	NumberSequenceKeypoint.new(0.3, 0.5),
	NumberSequenceKeypoint.new(0.4, 0.741),
	NumberSequenceKeypoint.new(0.5, 0.926),
	NumberSequenceKeypoint.new(0.6, 1.0),
	NumberSequenceKeypoint.new(1.0, 1.0),
})
-- sheen line: Color(1,1,1,0) -> Color(1,1,1,0.2) -> Color(1,1,1,0) along x
local LINE_SEQ = NumberSequence.new({
	NumberSequenceKeypoint.new(0.0, 1.0),
	NumberSequenceKeypoint.new(0.5, 0.0),
	NumberSequenceKeypoint.new(1.0, 1.0),
})

--- UIGlass.new(pad_h = 16, pad_v = 12, r = R_LG, frost = true, shadow_size = 18)
function GlassPanel.new(pad_h: number?, pad_v: number?, r: number?, frost: boolean?, shadow_size: number?)
	local self = setmetatable({}, GlassPanel.__mt)
	W.Control._init(self)
	W.Panel._init_panel(self)
	self.radius = r or UITheme.R_LG
	self.tint = UITheme.GLASS
	self.border_color = UITheme.LINE
	--- Optional accent stripe on the left edge (alliance cards, alerts...). Alpha 0 = none.
	self.accent = UITheme.CLEAR
	self.accent_width = 3.0
	self.sheen = true
	self._frost = if frost == nil then true else frost
	self._shadow_size = if shadow_size == nil then 18 else shadow_size
	local ph, pv = pad_h or 16.0, pad_v or 12.0
	self._pad4 = { ph, pv, ph, pv }
	self:set_mouse_filter(W.MOUSE_STOP)
	self._shadow = W.StyleView.new(self, 1)
	if self._shadow_size > 0 then
		self._shadow:set(UITheme.shadow_box(self.radius, self._shadow_size, 0.5, 6.0))
	end
	local g = self.gui
	local bg = Instance.new("Frame")
	bg.Name = "Glass"
	bg.BorderSizePixel = 0
	bg.AnchorPoint = Vector2.zero
	bg.ZIndex = 2
	bg.Active = false
	bg.Parent = g
	self._bg = bg
	self._bg_corner = Instance.new("UICorner")
	self._bg_corner.Parent = bg
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	pcall(function()
		(stroke :: any).BorderStrokePosition = Enum.BorderStrokePosition.Inner
	end)
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = bg
	self._stroke = stroke
	local sheen = Instance.new("Frame")
	sheen.Name = "Sheen"
	sheen.BorderSizePixel = 0
	sheen.AnchorPoint = Vector2.zero
	sheen.BackgroundColor3 = Color3.new(1, 1, 1)
	sheen.ZIndex = 3
	sheen.Active = false
	sheen.Parent = g
	local sg = Instance.new("UIGradient")
	sg.Rotation = 90
	sg.Transparency = SHEEN_SEQ
	sg.Parent = sheen
	self._sheen_corner = Instance.new("UICorner")
	self._sheen_corner.Parent = sheen
	self._sheen = sheen
	local line = Instance.new("Frame")
	line.Name = "SheenLine"
	line.BorderSizePixel = 0
	line.AnchorPoint = Vector2.zero
	line.BackgroundColor3 = Color3.new(1, 1, 1)
	line.ZIndex = 4
	line.Active = false
	line.Parent = g
	local lg = Instance.new("UIGradient")
	lg.Transparency = LINE_SEQ
	lg.Parent = line
	self._line = line
	local acc = Instance.new("Frame")
	acc.Name = "Accent"
	acc.BorderSizePixel = 0
	acc.AnchorPoint = Vector2.zero
	acc.ZIndex = 4
	acc.Active = false
	acc.Visible = false
	acc.Parent = g
	self._accent = acc
	self:restyle()
	return self
end

function GlassPanel._pad(self): (number, number, number, number)
	local p = self._pad4
	return p[1], p[2], p[3], p[4]
end

function GlassPanel.set_padding(self, left: number, top: number, right: number, bottom: number)
	self._pad4 = { left, top, right, bottom }
	self:update_minimum_size()
end

function GlassPanel.set_tint(self, c)
	self.tint = c
	self:restyle()
end

function GlassPanel.set_border(self, c)
	self.border_color = c
	local b = UITheme.to_rgba(c)
	self._stroke.Color = b.color
	self:_part(self._stroke, "Transparency", b.alpha)
end

function GlassPanel.set_accent(self, c, width: number?)
	self.accent = c
	if width then
		self.accent_width = width
	end
	self:restyle()
end

function GlassPanel.set_sheen(self, on: boolean)
	self.sheen = on
	self:restyle()
end

--- The panel's content margins changed / tint changed: redraw every part.
function GlassPanel.restyle(self)
	local t = UITheme.to_rgba(self.tint)
	local a = t.alpha
	if self._frost and a < 0.97 then
		a = math.clamp(a + UITheme.GLASS_BOOST, 0, 0.97)
	end
	self._bg.BackgroundColor3 = t.color
	self:_part(self._bg, "BackgroundTransparency", a)
	self:set_border(self.border_color)
	local sheen_on = self.sheen and self._frost
	self._sheen.Visible = sheen_on
	self:_part(self._sheen, "BackgroundTransparency", UITheme.GLASS_SHEEN)
	self._line.Visible = self.sheen
	self:_part(self._line, "BackgroundTransparency", 0.2)
	local acc = UITheme.to_rgba(self.accent)
	self._accent.Visible = acc.alpha > 0
	self._accent.BackgroundColor3 = acc.color
	self:_part(self._accent, "BackgroundTransparency", acc.alpha)
	self:_render()
end

function GlassPanel._on_geometry(self)
	self:_render()
end

function GlassPanel._restyle(self)
	if self._shadow_size > 0 then
		self._shadow:set(UITheme.shadow_box(self.radius, self._shadow_size, 0.5, 6.0))
	end
	self:_render()
end

function GlassPanel._theme_changed(self)
	self:update_minimum_size()
end

function GlassPanel._render(self)
	local w, h = self:px_size()
	if w <= 0 or h <= 0 then
		return
	end
	local s = UITheme.scale
	local rpx = math.min(math.floor(self.radius * s + 0.5), math.floor(math.min(w, h) / 2))
	self._bg.Size = UDim2.fromOffset(w, h)
	self._bg.Position = UDim2.fromOffset(0, 0)
	self._bg_corner.CornerRadius = UDim.new(0, rpx)
	self._stroke.Thickness = math.max(1, math.floor(s + 0.5))
	self._sheen.Size = UDim2.fromOffset(w, h)
	self._sheen.Position = UDim2.fromOffset(0, 0)
	self._sheen_corner.CornerRadius = UDim.new(0, rpx)
	-- sheen line from x = radius to w - radius at y = 1 (logical)
	local lr = math.min(self.radius, math.min(w, h) / s / 2)
	local lx = math.floor(lr * s + 0.5)
	self._line.Visible = self.sheen and w > lx * 2
	self._line.Position = UDim2.fromOffset(lx, math.floor(0.5 * s + 0.5))
	self._line.Size = UDim2.fromOffset(math.max(0, w - 2 * lx), math.max(1, math.floor(s + 0.5)))
	local acc = UITheme.to_rgba(self.accent)
	if acc.alpha > 0 then
		local inset = math.min(self.radius, h / s / 2) * 0.55
		local ah = math.max(h / s - inset * 2, 2)
		self._accent.Position = UDim2.fromOffset(math.floor(s + 0.5), math.floor(inset * s + 0.5))
		self._accent.Size = UDim2.fromOffset(math.floor(self.accent_width * s + 0.5), math.floor(ah * s + 0.5))
	end
	self._shadow:render()
end

return GlassPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">GlobeNotice</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Territory-map notice (review_code.md R2-3). The globe draws territory colours with Editable
-- images / meshes; when the device's editable budget is exhausted, or the experience's Mesh / Image
-- APIs permission is off in a published place, it falls back to the static globe (WorldView
-- territory_status().state == "unavailable"). Instead of a silent console warning the player gets
-- this small card: non-blocking (the game keeps running underneath), styled like the Coach tip
-- card, dismissible, hidden again by itself when territories come back. The place owner (Studio, or
-- the account / group that owns the experience) also sees how to enable the APIs.
--
-- API: GlobeNotice.new(ctx), set_status(status), apply_layout(blockers: { Rect }), card (GlassPanel).

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")

local GlobeNotice = W.class(W.Control)

GlobeNotice.TITLE = "Territory map unavailable"
GlobeNotice.TEXT = {
	memory = "This device is out of graphics memory for territory colours, so nations' land isn't coloured. You can keep playing: the map comes back as soon as memory frees up.",
	disabled = "Territory rendering is unavailable on this server, so nations' land isn't coloured. You can keep playing; everything else works.",
	data = "The globe's map data didn't load, so nations' land isn't coloured. You can keep playing; everything else works.",
}
--- Phones (compact layout): the same, shorter.
GlobeNotice.TEXT_SHORT = {
	memory = "Out of graphics memory for territory colours. Keep playing: the map returns when memory frees up.",
	disabled = "Territory colours can't be drawn on this server. Everything else works.",
	data = "Map data didn't load, so territory colours can't be drawn. Everything else works.",
}
GlobeNotice.OWNER_HINT = {
	disabled = "Owner: enable \u{201C}Mesh / Image APIs\u{201D} for this experience (Game Settings \u{203A} Security).",
	memory = "Owner: other Studio windows share this device's editable memory; close some to test.",
}

local function in_studio(): boolean
	if not UICtx.IS_ROBLOX then
		return false
	end
	local ok, studio = pcall(function()
		return game:GetService("RunService"):IsStudio()
	end)
	return ok and studio == true
end

-- Studio, or the local player owns the experience (user) / holds the owner rank of its group.
local function owner_check(done: (boolean) -> ())
	if not UICtx.IS_ROBLOX then
		done(false)
		return
	end
	if in_studio() then
		done(true)
		return
	end
	task.spawn(function()
		local owner = false
		pcall(function()
			local lp = game:GetService("Players").LocalPlayer
			if game.CreatorType == Enum.CreatorType.User then
				owner = lp ~= nil and lp.UserId == game.CreatorId
			elseif game.CreatorType == Enum.CreatorType.Group then
				owner = lp ~= nil and lp:GetRankInGroup(game.CreatorId) >= 255
			end
		end)
		done(owner)
	end)
end

function GlobeNotice.new(c: any)
	local self = setmetatable({}, GlobeNotice.__mt)
	W.Control._init(self)
	self.ctx = c
	self.status = nil
	self.dismissed_reason = nil
	self.is_owner = false
	self.in_studio = in_studio()
	self:set_mouse_filter(W.MOUSE_IGNORE)
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	local T = UITheme
	local card = GlassPanel.new(14.0, 11.0, T.R_MD, true, 20)
	card:set_accent(T.ORANGE)
	card:set_border(T.c(T.ORANGE, 0.45))
	self.card = card
	local h = T.hbox(12)
	card:add_child(h)
	local disc = W.Panel.new()
	disc:set_mouse_filter(W.MOUSE_IGNORE)
	disc:set_min_size(Vector2.new(34, 34))
	disc.size_flags_vertical = W.SHRINK_BEGIN
	disc:add_theme_stylebox_override("panel", T.flat(T.c(T.ORANGE, 0.16), 17, T.c(T.ORANGE, 0.5), 1))
	local icon = T.icon_rect("globe", 18.0, T.ORANGE)
	icon.size_flags_horizontal = W.SHRINK_CENTER
	icon.size_flags_vertical = W.SHRINK_CENTER
	disc:add_child(icon)
	self._disc = disc
	self._icon = icon
	h:add_child(disc)
	local v = T.vbox(5)
	v.size_flags_horizontal = W.EXPAND_FILL
	self._v = v
	self._cap = T.caption(GlobeNotice.TITLE, 10, T.ORANGE)
	v:add_child(self._cap)
	self._text = T.label("", 13, 500, T.TEXT)
	self._text:set_autowrap(true)
	v:add_child(self._text)
	self._hint = T.label("", 12, 600, T.AMBER_HI)
	self._hint:set_autowrap(true)
	self._hint:set_visible(false)
	v:add_child(self._hint)
	h:add_child(v)
	-- the leaderboard's close button (small margins so the icon fits a compact button)
	local x = W.Button.new("", "GhostButton")
	x:set_icon("close")
	x.expand_icon = true
	x.icon_alignment = W.ALIGN_CENTER
	x:add_theme_constant_override("icon_max_width", 11)
	x:add_theme_stylebox_override("normal", T.empty_box(6, 6))
	x:add_theme_stylebox_override("hover", T.flat(T.FILL, 6, T.CLEAR, 0, 6, 6))
	x:add_theme_stylebox_override("pressed", T.flat(T.FILL, 6, T.CLEAR, 0, 6, 6))
	x:set_min_size(Vector2.new(26, 26))
	x.size_flags_vertical = W.SHRINK_BEGIN
	x.pressed:Connect(function()
		self:dismiss()
	end)
	self._x = x
	h:add_child(x)
	self:add_child(card)
	card:set_visible(false)
	owner_check(function(owner: boolean)
		self.is_owner = owner
		if self.status ~= nil then
			self:_refresh(false)
		end
	end)
	return self
end

--- WorldView.territory_status_changed: show the card while territories can't be drawn.
function GlobeNotice.set_status(self, status: any)
	local was = self.status
	self.status = status
	if status == nil or status.state ~= "unavailable" then
		self.dismissed_reason = nil
		self:_hide()
		return
	end
	-- a different reason after a dismissal is news again
	local fresh = was == nil or was.state ~= "unavailable" or was.reason ~= status.reason
	self:_refresh(fresh)
end

function GlobeNotice.dismiss(self)
	if self.status ~= nil then
		self.dismissed_reason = self.status.reason
	end
	self.ctx:sfx("close", -8.0)
	self:_hide()
end

function GlobeNotice.shown(self): boolean
	return self.card.visible and self.card.modulate_a > 0.01
end

function GlobeNotice._hide(self)
	local card = self.card
	if not card.visible then
		return
	end
	local t = card:create_tween()
	t:tween_property(card, "modulate:a", 0.0, 0.2)
	t:tween_callback(function()
		if self.status == nil or self.status.state ~= "unavailable" or self.dismissed_reason ~= nil then
			card:set_visible(false)
			card:set_modulate_a(1.0)
		end
	end)
end

function GlobeNotice._refresh(self, animate: boolean)
	local st = self.status
	if st == nil or st.state ~= "unavailable" or self.dismissed_reason == st.reason then
		return
	end
	local reason = if GlobeNotice.TEXT[st.reason] then st.reason else "memory"
	local texts = if self.ctx.compact then GlobeNotice.TEXT_SHORT else GlobeNotice.TEXT
	self._text:set_text(texts[reason])
	-- the memory hint is about Studio (windows share the budget); the permission hint is for owners
	local hint = if reason == "memory"
		then (if self.in_studio then GlobeNotice.OWNER_HINT.memory else nil)
		elseif self.is_owner then GlobeNotice.OWNER_HINT[reason]
		else nil
	self._hint:set_text(hint or "")
	self._hint:set_visible(hint ~= nil)
	local was_visible = self.card.visible
	self.card:set_visible(true)
	self.card:set_modulate_a(1.0)
	self:apply_layout(self._blockers)
	if animate or not was_visible then
		UICtx.pop_in(self.card, 0.0, 0.94, 0.35, true)
		self.ctx:sfx("toast", -6.0)
	end
end

--- Top-left, under the top-bar buttons; below any `blockers` (kit nodes that may reach into that
--- corner: the status pill / spawn banner on phones, the title wordmark on the phone title screen).
function GlobeNotice.apply_layout(self, blockers: { any }?)
	self._blockers = blockers
	local ctx = self.ctx
	local c = ctx.compact
	if c ~= self._compact then
		self._compact = c
		if self.card.visible then
			self:_refresh(false)
			return
		end
	end
	local w = if c then 280.0 else 340.0
	local xw = if ctx.touch then 44.0 else 26.0
	local tw = w - 28 - 34 - 12 - 12 - xw
	self._text:set_min_size(Vector2.new(tw, 0))
	self._hint:set_min_size(Vector2.new(tw, 0))
	self._text:set_font_size(if c then 12 else 13)
	self._hint:set_font_size(if c then 11 else 12)
	self._x:set_min_size(Vector2.new(xw, xw))
	local card = self.card
	card:set_min_size(Vector2.new(w, 0))
	card:reset_size()
	local ins = ctx.insets
	local x = 12.0 + ins.x
	local y = math.max(70.0 + ins.y, ctx.reserved_top_left.Max.Y + 10.0)
	local sz = card:get_combined_minimum_size()
	for _, n in ipairs(blockers or {}) do
		if n ~= nil and n:is_visible_in_tree() then
			local b = n:get_global_rect()
			if b.Width > 0 and b.Min.X < x + sz.X and b.Max.X > x and b.Min.Y < y + sz.Y and b.Max.Y > y then
				y = b.Max.Y + 10.0
			end
		end
	end
	card.anchor_left, card.anchor_right, card.anchor_top, card.anchor_bottom = 0, 0, 0, 0
	card.grow_horizontal = W.GROW_END
	card.grow_vertical = W.GROW_END
	card.offset_left = x
	card.offset_right = x
	card.offset_top = y
	card.offset_bottom = y
	card:reset_size()
end

return GlobeNotice
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="159">
            <Properties>
              <string name="Name">HelpOverlay</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Port of scripts/ui/help_overlay.gd (UIHelpOverlay)
-- "How to play" overlay: illustrated sections (spawn, expand & attack, boats, economy, nukes,
-- alliances, victory) and the mouse/keyboard and touch controls. Scrolls on small screens.
--
-- Also defines two small containers the kit does not ship: Scroll (ScrollContainer, vertical)
-- and Grid (GridContainer), both with Godot layout semantics.

local UITheme = require("./UITheme")
local W = require("./Widgets")
local GlassPanel = require("./GlassPanel")
local UICtx = require("./UICtx")
local UIRules = require("./UIRules")
local Signal = UITheme.core("Signal")
local Defs = UICtx.core("Defs")

local HelpOverlay = W.class(W.Control)

-- =============================================================================================
-- Grid (GridContainer: columns, h_separation, v_separation)
-- =============================================================================================

local Grid = W.class(W.Control)
HelpOverlay.Grid = Grid

function Grid.new(columns: number, hsep: number?, vsep: number?)
	local self = setmetatable({}, Grid.__mt)
	W.Control._init(self)
	self._is_container = true
	self.columns = columns
	self.hsep = hsep or 4
	self.vsep = vsep or 4
	self:set_mouse_filter(W.MOUSE_IGNORE)
	return self
end

function Grid._cells(self): { any }
	local out = {}
	for _, c in ipairs(self.children) do
		if c.visible then
			table.insert(out, c)
		end
	end
	return out
end

function Grid._metrics(self): ({ number }, { number }, { boolean })
	local cells = self:_cells()
	local cols = math.max(1, self.columns)
	local cw, rh, cexp = {}, {}, {}
	for i, c in ipairs(cells) do
		local col = (i - 1) % cols + 1
		local row = (i - 1) // cols + 1
		local m = c:get_combined_minimum_size()
		cw[col] = math.max(cw[col] or 0, m.X)
		rh[row] = math.max(rh[row] or 0, m.Y)
		if bit32.band(c.size_flags_horizontal, W.EXPAND) ~= 0 then
			cexp[col] = true
		end
	end
	for col = 1, cols do
		cw[col] = cw[col] or 0
	end
	return cw, rh, cexp
end

function Grid._get_minimum_size(self): Vector2
	local cw, rh = self:_metrics()
	local w, h = 0, 0
	local nc, nr = 0, 0
	for _, v in ipairs(cw) do
		w += v
		nc += 1
	end
	for _, v in ipairs(rh) do
		h += v
		nr += 1
	end
	return Vector2.new(w + math.max(0, nc - 1) * self.hsep, h + math.max(0, nr - 1) * self.vsep)
end

function Grid._sort_children(self)
	local cells = self:_cells()
	local cols = math.max(1, self.columns)
	local cw, rh, cexp = self:_metrics()
	-- Expanding columns share the spare width (Godot: remaining space split between them).
	local total = 0
	local nexp = 0
	for col = 1, cols do
		total += cw[col]
		if cexp[col] then
			nexp += 1
		end
	end
	local spare = self.size.X - total - (cols - 1) * self.hsep
	if nexp > 0 and spare > 0 then
		for col = 1, cols do
			if cexp[col] then
				cw[col] += spare / nexp
			end
		end
	end
	local y = 0
	for row = 1, #rh do
		local x = 0
		for col = 1, cols do
			local c = cells[(row - 1) * cols + col]
			if c then
				self:fit_child_in_rect(c, Vector2.new(x, y), Vector2.new(cw[col], rh[row]))
			end
			x += cw[col] + self.hsep
		end
		y += rh[row] + self.vsep
	end
end

-- =============================================================================================
-- Scroll (ScrollContainer, vertical only)
-- =============================================================================================

local Scroll = W.class(W.Control)
HelpOverlay.Scroll = Scroll

function Scroll.new()
	local self = setmetatable({}, Scroll.__mt)
	W.Control._init(self, "ScrollingFrame")
	self._is_container = true
	local g = self.gui :: ScrollingFrame
	g.ScrollingDirection = Enum.ScrollingDirection.Y
	g.ScrollBarThickness = 6
	g.ScrollBarImageColor3 = Color3.new(1, 1, 1)
	g.ScrollBarImageTransparency = 0.82
	g.TopImage = "rbxasset://textures/ui/Scroll/scroll-middle.png"
	g.BottomImage = "rbxasset://textures/ui/Scroll/scroll-middle.png"
	g.VerticalScrollBarInset = Enum.ScrollBarInset.None
	g.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
	g.CanvasSize = UDim2.fromOffset(0, 0)
	g.ScrollingEnabled = true
	g.Active = true
	self:set_mouse_filter(W.MOUSE_PASS)
	return self
end

function Scroll._get_minimum_size(self): Vector2
	local w = 0
	for _, c in ipairs(self.children) do
		if c.visible then
			w = math.max(w, c:get_combined_minimum_size().X)
		end
	end
	return Vector2.new(w, 0)
end

function Scroll._sort_children(self)
	local h = 0
	for _, c in ipairs(self.children) do
		if c.visible then
			-- Width first (autowrapped labels compute their height from it), then the height.
			c:_apply_rect(Vector2.zero, Vector2.new(self.size.X, c:get_combined_minimum_size().Y))
			local m = c:get_combined_minimum_size()
			c:_apply_rect(Vector2.zero, Vector2.new(self.size.X, math.max(m.Y, 0)))
			h = math.max(h, m.Y)
		end
	end
	self._content_h = h;
	(self.gui :: ScrollingFrame).CanvasSize = UDim2.fromOffset(0, math.floor(h * UITheme.scale + 0.5))
end

--- How far the content is scrolled, in logical px (Control.get_global_position subtracts it).
function Scroll._canvas_offset(self): Vector2
	return (self.gui :: ScrollingFrame).CanvasPosition / UITheme.scale
end

function Scroll.scroll_by(self, px: number)
	local g = self.gui :: ScrollingFrame
	local s = UITheme.scale
	local max_y = math.max(0, (self._content_h or 0) * s - g.AbsoluteWindowSize.Y)
	g.CanvasPosition = Vector2.new(0, math.clamp(g.CanvasPosition.Y + px * s, 0, max_y))
end

-- =============================================================================================
-- Help content
-- =============================================================================================

local function Rules()
	return UICtx.core("Rules")
end

--- Numbers in the help text come from Rules, so the text follows balance changes.
function HelpOverlay._fill_rules(text: string): string
	local R = Rules()
	return UIRules.format(text, {
		traitor_s = tostring(Defs.round(R.TRAITOR_TICKS / R.TICK_RATE)),
		traitor_def = tostring(Defs.round(R.TRAITOR_DEFENSE_DEBUFF * 100.0)),
		spacing = tostring(Defs.round(R.STRUCT_MIN_DIST)),
		def_mag = tostring(Defs.round(R.DEFENSE_POST_MAG)),
		def_cost = tostring(Defs.round(R.DEFENSE_POST_COST)),
		sam_r = tostring(Defs.round(R.sam_range(1))),
		ws_retreat = tostring(
			Defs.round((tonumber(UIRules.rules_const("WARSHIP_RETREAT_FRAC", 0.75)) or 0.75) * 100.0)
		),
		post_shoot = if UIRules.rules_const("DEFENSE_POST_SHOOTS", false) == true
			then " Defense Posts also fire on enemy boats in range."
			else "",
		win = tostring(Defs.round(R.WIN_SHARE * 100.0)),
	})
end

HelpOverlay.SECTIONS = {
	{
		icon = "target",
		color = "amber",
		title = "Pick your start",
		text = "Click any unclaimed land to place your capital. Solo games deploy 5 seconds after you choose; until then you can move it.",
	},
	{
		icon = "attack",
		color = "orange",
		title = "Expand & attack",
		text = "Click neutral land beside you to expand, or a nation you border to attack it. The Attack bar sets the share of troops you send (Q / E, or Shift + wheel). Troops regrow on their own, fastest well below your cap.",
	},
	{
		icon = "boat",
		color = "cyan",
		title = "Boats",
		text = "Click a coast you can't reach by land and a transport sails from your nearest shore, landing troops for a beachhead. Warships (built from a Port) patrol where you send them: they hit transports first, then warships, then trade ships, which they capture for gold. Below {ws_retreat}% health a warship returns to port and heals near your ports; kills earn it veterancy. Click one of yours, then the sea, to move it.{post_shoot}",
	},
	{
		icon = "alliance",
		color = "violet",
		title = "Alliances & betrayal",
		text = "Right-click a nation to propose an alliance. Allies can't attack each other and can donate troops. Breaking an alliance brands you a Traitor for {traitor_s} s: everyone knows, and attacks against you cost only {traitor_def}% of the troops and land faster.",
	},
	{
		icon = "city",
		color = "gold",
		title = "Build your economy",
		builds = true,
		wide = true,
		text = "Gold flows from your land, factories and trade. Structures get pricier the more you own and need room ({spacing} tiles apart); place them on your own land with the command bar (1 – 7) or the action menu. Land near a Defense Post costs attackers {def_mag}× the troops and {def_cost}× the time.",
	},
	{
		icon = "atom",
		color = "red",
		title = "Nukes & SAMs",
		text = "A Chakra Shrine lets you cast Rasengan, Planetary Devastation and the Multi Shadow Clone Technique. Unlock Bijūdama and Tengai Shinsei with Stars. Large impacts destroy troops and structures and leave unstable land. A Sealing Barrier intercepts incoming jutsu aimed within {sam_r} tiles.",
	},
	{
		icon = "crown",
		color = "gold",
		title = "Win at 80%",
		text = "Hold {win}% of the world's land to win (fallout doesn't count). Multiplayer matches end after 40 minutes and the largest nation wins. Lose all your land and you're out.",
	},
}
--- The "Credits & licence" card, last: the AGPL's Appropriate Legal Notices (a copyright notice, no
--- warranty, that the game may be shared under the licence, where the licence is) and the credits
--- (2026-10-25: the AGPL licence and its notices and the copyright notice; the flags, map icons, sprites
--- and effects are RoWorld's own or public domain since that day, and the World map since 2026-10-26).
--- NOTICE.md and LICENSE in the source have the full text.
HelpOverlay.LEGAL = {
	"RoWorld is a modified version of OpenFront. © OpenFront and Contributors. Changes © 2026 Snick Co.",
	"RoWorld is free software: you can redistribute it and/or modify it under the terms of the GNU Affero General Public License, version 3, with the additional terms in its LICENSE file. It comes with ABSOLUTELY NO WARRANTY. The licence comes with RoWorld's source code.",
	"Maps made with Natural Earth and NOAA ETOPO1 data (public domain). Country flags from Wikimedia Commons (public domain). Music by Rodrigo Flores.",
	"RoWorld is not affiliated with or endorsed by OpenFront.",
}
--- Where the source lives, under the credits: plain text with the GitHub mark, since Roblox games
--- can't link off-platform (2026-10-25: "Source <github logo> <repo>" at the bottom; the public repo is
--- lukechatton/roworld, lukechatton/rofront is private).
HelpOverlay.SOURCE_REPO = "lukechatton/roworld"
--- The card that pops up over the repo name when it's pressed (2026-10-25), and how long it stays.
HelpOverlay.SOURCE_TIP = {
	title = "Source code",
	body = "Source available on the github website under " .. HelpOverlay.SOURCE_REPO,
}
HelpOverlay.SOURCE_TIP_S = 4.0

-- Roblox: Esc opens Roblox's own menu (games never receive it), so cancel is X or right-click;
-- Backspace (retreat) and WASD / +- are Roblox-port keys the original's list didn't show (review P2-4).
HelpOverlay.KEYS_DESKTOP = {
	{ "Click", "Expand, attack or send a boat" },
	{ "Right-click", "Action menu" },
	{ "Drag", "Rotate the globe" },
	{ "WASD / Arrows", "Pan the globe" },
	{ "Wheel / + −", "Zoom" },
	{ "1 – 0", "Build & nukes" },
	{ "Q / E", "Attack share −/+" },
	{ "Space", "Attack at cursor" },
	{ "Backspace", "Retreat your latest attack" },
	{ "X / Right-click", "Cancel" },
	{ "H", "This help" },
	{ "Tab", "Leaderboard" },
	{ "M", "Music" },
	{ "Home", "Center on your nation" },
	{ "Click a warship", "Then click the sea to move it" },
}
HelpOverlay.KEYS_TOUCH = {
	{ "Tap", "Expand, attack or send a boat" },
	{ "Long-press", "Action menu" },
	{ "Drag", "Rotate the globe" },
	{ "Pinch", "Zoom" },
	{ "Tap a slot", "Tap the globe, then ✓" },
	{ "Tap your land", "Inspect" },
	{ "Tap a warship", "Then tap the sea to move it" },
	{ "Tap an ally", "Donate or break the alliance" },
}

local COLORS = {
	amber = "AMBER",
	orange = "ORANGE",
	cyan = "CYAN",
	gold = "GOLD",
	red = "RED",
	violet = "VIOLET",
}

local function col(name: string): Color3
	local k = COLORS[name]
	return if k then UITheme[k] else UITheme.TEXT
end

function HelpOverlay.new(c: any)
	local self = setmetatable({}, HelpOverlay.__mt)
	W.Control._init(self)
	self.ctx = c
	self.closed = Signal.new()
	self.is_open = false
	self._built_compact = -1
	self._scroll = nil
	self:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self:set_mouse_filter(W.MOUSE_STOP)
	self:set_visible(false)
	-- Input sink (Godot mouse_filter STOP while open; RadialMenu's Blocker): Active frames don't stop a
	-- click reaching a button behind them, only a button on top does (2026-10-25: a click on the window
	-- pressed the title's Play Solo / JOIN underneath). Under the dim and the window (kit children are
	-- ZIndex 11+), so the dim still sees presses outside the window.
	UICtx.make("TextButton", {
		Name = "Blocker",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		Active = true,
		Selectable = false,
		ZIndex = 1,
	}, self.gui)
	self._dim = W.ColorRect.new(UITheme.rgba(0.01, 0.015, 0.05, 0.72))
	self._dim:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	self._dim:set_mouse_filter(W.MOUSE_STOP)
	self._dim.gui_input:Connect(function(e)
		-- (a press on the window's own ground reaches the dim too: only one outside it closes)
		if e.pressed and not self._panel:has_global_point(e.global_position) then
			self:close()
		end
	end)
	self:add_child(self._dim)
	self._panel = GlassPanel.new(0.0, 0.0, 18, true, 34)
	self._panel:set_tint(UITheme.rgba(0.045, 0.065, 0.13, 0.94))
	self:add_child(self._panel)
	return self
end

function HelpOverlay._build(self)
	for _, ch in ipairs(self._panel:get_children()) do
		ch:queue_free()
	end
	local ctx = self.ctx
	local compact = ctx.compact
	self._built_compact = if compact then 1 else 0
	local v = UITheme.vbox(0)
	self._panel:add_child(v)
	-- Header
	local hm = W.Margin.new()
	hm:set_mouse_filter(W.MOUSE_IGNORE)
	for _, side in ipairs({ "left", "right" }) do
		hm:add_theme_constant_override("margin_" .. side, if not compact then 28 else 16)
	end
	hm:add_theme_constant_override("margin_top", if not compact then 22 else 12)
	hm:add_theme_constant_override("margin_bottom", if not compact then 14 else 8)
	local head = UITheme.hbox(14)
	hm:add_child(head)
	local hic = UITheme.icon_rect("help", if not compact then 28.0 else 22.0, UITheme.AMBER)
	hic.size_flags_vertical = W.SHRINK_CENTER
	head:add_child(hic)
	local tv = UITheme.vbox(2)
	tv.size_flags_horizontal = W.EXPAND_FILL
	tv.size_flags_vertical = W.SHRINK_CENTER
	tv:add_child(UITheme.label("HOW TO PLAY", if not compact then 24 else 18, 800, UITheme.TEXT, 3))
	local paused = ctx:mode() == UICtx.MODE_SOLO and ctx:in_match()
	tv:add_child(
		UITheme.label(
			"Conquer the real world in seven ideas." .. (if paused then "  ·  Game paused" else ""),
			13,
			500,
			UITheme.TEXT_2
		)
	)
	head:add_child(tv)
	local close_b = UITheme.button("", "GlassButton", "close", 44.0)
	close_b.expand_icon = true
	close_b.icon_alignment = W.ALIGN_CENTER
	close_b:add_theme_constant_override("icon_max_width", 14)
	close_b:set_min_size(Vector2.new(44, 44))
	close_b.size_flags_vertical = W.SHRINK_CENTER
	close_b.pressed:Connect(function()
		self:close()
	end)
	head:add_child(close_b)
	v:add_child(hm)
	v:add_child(UITheme.hdivider())

	local scroll = Scroll.new()
	scroll.size_flags_vertical = W.EXPAND_FILL
	self._scroll = scroll
	v:add_child(scroll)
	local body_m = W.Margin.new()
	body_m:set_mouse_filter(W.MOUSE_IGNORE)
	body_m.size_flags_horizontal = W.EXPAND_FILL
	for _, side2 in ipairs({ "left", "right" }) do
		body_m:add_theme_constant_override("margin_" .. side2, if not compact then 24 else 12)
	end
	body_m:add_theme_constant_override("margin_top", if not compact then 18 else 10)
	body_m:add_theme_constant_override("margin_bottom", if not compact then 22 else 12)
	scroll:add_child(body_m)
	local body = UITheme.vbox(18)
	body.size_flags_horizontal = W.EXPAND_FILL
	body_m:add_child(body)
	-- Two cards per row on wide screens; "wide" sections span the full row.
	local row = nil
	for i, d in ipairs(HelpOverlay.SECTIONS) do
		local card = self:_section(i, d)
		if compact or d.wide then
			body:add_child(card)
			row = nil
			continue
		end
		if row == nil then
			row = UITheme.hbox(14)
			row.size_flags_horizontal = W.EXPAND_FILL
			body:add_child(row)
		end
		row:add_child(card)
		if row:get_child_count() >= 2 then
			row = nil
		end
	end
	body:add_child(self:_controls())
	body:add_child(self:_legal())
	body:add_child(self:_source())
end

local function card_panel(mh: number, mv: number)
	local card = W.Panel.new()
	card:set_mouse_filter(W.MOUSE_IGNORE)
	card:add_theme_stylebox_override(
		"panel",
		UITheme.flat(UITheme.rgba(1, 1, 1, 0.035), 12, UITheme.rgba(1, 1, 1, 0.07), 1, mh, mv)
	)
	return card
end

function HelpOverlay._section(self, n: number, d: any)
	local ctx = self.ctx
	local c = col(d.color)
	local card = card_panel(16.0, 14.0)
	card.size_flags_horizontal = W.EXPAND_FILL
	local h = UITheme.hbox(14)
	card:add_child(h)
	h:add_child(self:_medallion(d.icon, c))
	local v = UITheme.vbox(5)
	v.size_flags_horizontal = W.EXPAND_FILL
	local tr = UITheme.hbox(8)
	local num = UITheme.label(string.format("%02d", n), 12, 800, c, 1)
	num.size_flags_vertical = W.SHRINK_CENTER
	tr:add_child(num)
	tr:add_child(UITheme.label(d.title, 16, 700))
	v:add_child(tr)
	local body = HelpOverlay._fill_rules(d.text)
	if ctx.touch then
		body = body:gsub("Right%-click", "Long-press"):gsub("Click", "Tap"):gsub("click", "tap")
		body = body:gsub(" %(Q / E, or Shift %+ wheel%)", ""):gsub(" with the command bar %(1 – 7%)", " with BUILD")
	end
	local t = UITheme.label(body, 13, 500, UITheme.TEXT_2)
	t:set_autowrap(true)
	t:set_min_size(Vector2.new(220, 0))
	v:add_child(t)
	if d.builds then
		local g = Grid.new(if ctx.compact then 1 else 2, 18, 8)
		g.size_flags_horizontal = W.EXPAND_FILL
		for _, k in ipairs(UIRules.BUILD_KINDS) do
			local item = UITheme.hbox(10)
			item.size_flags_horizontal = W.EXPAND_FILL
			local chip = W.Panel.new()
			chip:set_mouse_filter(W.MOUSE_IGNORE)
			chip:set_min_size(Vector2.new(30, 30))
			chip.size_flags_vertical = W.SHRINK_BEGIN
			chip:add_theme_stylebox_override(
				"panel",
				UITheme.flat(UITheme.c(UITheme.GOLD, 0.1), 8, UITheme.c(UITheme.GOLD, 0.3), 1)
			)
			local ic = UITheme.icon_rect(k, 16.0, UITheme.GOLD)
			ic.size_flags_horizontal = W.SHRINK_CENTER
			ic.size_flags_vertical = W.SHRINK_CENTER
			chip:add_child(ic)
			item:add_child(chip)
			local tv = UITheme.vbox(0)
			tv.size_flags_horizontal = W.EXPAND_FILL
			tv:add_child(UITheme.label(UIRules.TITLES[k], 13, 700))
			local bl = UITheme.label(UIRules.blurb(k), 12, 500, UITheme.TEXT_3)
			bl:set_autowrap(true)
			bl:set_min_size(Vector2.new(180, 0))
			tv:add_child(bl)
			item:add_child(tv)
			g:add_child(item)
		end
		v:add_child(g)
	end
	h:add_child(v)
	return card
end

--- Round icon medallion with a coloured glow (StyleBoxFlat shadow in the section colour).
function HelpOverlay._medallion(self, icon_name: string, c: Color3)
	local wrap = W.Control.new()
	wrap:set_mouse_filter(W.MOUSE_IGNORE)
	wrap.size_flags_vertical = W.SHRINK_BEGIN
	wrap:set_min_size(Vector2.new(52, 52))
	local glow = UICtx.make("ImageLabel", {
		Name = "Glow",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(72 / 52, 72 / 52),
		Image = UICtx.shapes().disc_glow or "",
		ImageColor3 = c,
		ZIndex = 1,
	}, wrap.gui)
	wrap:_part(glow, "ImageTransparency", 0.18)
	local p = W.Panel.new()
	p:set_mouse_filter(W.MOUSE_IGNORE)
	p:set_anchors_and_offsets_preset(W.PRESET_FULL_RECT)
	p:add_theme_stylebox_override("panel", UITheme.flat(UITheme.c(c, 0.14), 26, UITheme.c(c, 0.55), 1))
	local ic = UITheme.icon_rect(icon_name, 26.0, c)
	ic.size_flags_horizontal = W.SHRINK_CENTER
	ic.size_flags_vertical = W.SHRINK_CENTER
	p:add_child(ic)
	wrap:add_child(p)
	return wrap
end

function HelpOverlay._controls(self)
	local ctx = self.ctx
	local card = card_panel(18.0, 16.0)
	local v = UITheme.vbox(12)
	card:add_child(v)
	local hr = UITheme.hbox(10)
	local lic = UITheme.icon_rect("layers", 18.0, UITheme.CYAN)
	lic.size_flags_vertical = W.SHRINK_CENTER
	hr:add_child(lic)
	hr:add_child(UITheme.label("CONTROLS", 14, 800, UITheme.TEXT, 2))
	v:add_child(hr)
	local cols = if ctx.compact then UITheme.vbox(16) else UITheme.hbox(32)
	v:add_child(cols)
	cols:add_child(self:_key_list("Mouse & keyboard", HelpOverlay.KEYS_DESKTOP))
	cols:add_child(self:_key_list("Touch", HelpOverlay.KEYS_TOUCH))
	return card
end

function HelpOverlay._legal(self)
	local card = card_panel(18.0, 16.0)
	local v = UITheme.vbox(8)
	card:add_child(v)
	v:add_child(UITheme.label("CREDITS & LICENCE", 14, 800, UITheme.TEXT, 2))
	for _, para in ipairs(HelpOverlay.LEGAL) do
		local t = UITheme.label(para, 12, 500, UITheme.TEXT_3)
		t:set_autowrap(true)
		t:set_min_size(Vector2.new(220, 0))
		t.size_flags_horizontal = W.EXPAND_FILL
		v:add_child(t)
	end
	return card
end

--- "Source  [<GitHub mark> lukechatton/roworld]", centred below the credits card. Games can't open web
--- links, so pressing the repo name pops up where to find it instead (SOURCE_TIP).
function HelpOverlay._source(self)
	local row = UITheme.hbox(4)
	row.size_flags_horizontal = W.SHRINK_CENTER
	local cap = UITheme.label("Source", 13, 500, UITheme.TEXT_3)
	cap.size_flags_vertical = W.SHRINK_CENTER
	row:add_child(cap)
	local b = UITheme.button(HelpOverlay.SOURCE_REPO, "GhostButton", "github", 40.0)
	b:set_font_size(13)
	b:add_theme_constant_override("icon_max_width", 18)
	b.size_flags_vertical = W.SHRINK_CENTER
	b.pressed:Connect(function()
		self:_show_source_tip(b)
	end)
	row:add_child(b)
	return row
end

--- The tooltip card above the repo name (forced, so taps show it too); it hides after SOURCE_TIP_S,
--- or with the window (the card drops an anchor that is no longer visible).
function HelpOverlay._show_source_tip(self, b: any)
	self.ctx:show_hint(b, HelpOverlay.SOURCE_TIP, true)
	self._tip_serial = (self._tip_serial or 0) + 1
	local serial = self._tip_serial
	task.delay(HelpOverlay.SOURCE_TIP_S, function()
		if self._tip_serial == serial then
			self.ctx:hide_hint(b)
		end
	end)
end

--- Key cap: StyleBoxFlat(white 0.09, r 6, border white 0.2, 1 px, 2 px bottom border).
local function keycap(text: string)
	local cap = W.Panel.new()
	cap:set_mouse_filter(W.MOUSE_IGNORE)
	local sb = UITheme.flat(UITheme.rgba(1, 1, 1, 0.09), 6, UITheme.rgba(1, 1, 1, 0.2), 1, 8.0, 2.0)
	sb.margin = { 8.0, 2.0, 8.0, 3.0 }
	cap:add_theme_stylebox_override("panel", sb)
	cap.size_flags_horizontal = W.SHRINK_BEGIN
	local lip = UICtx.make("Frame", {
		Name = "Lip",
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(1, 1, 1),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -1),
		Size = UDim2.new(1, -8, 0, 1),
		ZIndex = 5,
	}, cap.gui)
	cap:_part(lip, "BackgroundTransparency", 0.2)
	cap:add_child(UITheme.label(text, 11, 700, UITheme.TEXT))
	return cap
end

function HelpOverlay._key_list(self, title: string, keys: any)
	local v = UITheme.vbox(7)
	v.size_flags_horizontal = W.EXPAND_FILL
	v:add_child(UITheme.caption(title, 11, UITheme.TEXT_3))
	local g = Grid.new(2, 12, 6)
	for _, k in ipairs(keys) do
		g:add_child(keycap(k[1]))
		local d = UITheme.label(k[2], 13, 500, UITheme.TEXT_2)
		d.size_flags_vertical = W.SHRINK_CENTER
		g:add_child(d)
	end
	v:add_child(g)
	return v
end

function HelpOverlay.apply_layout(self)
	if self.is_open and self._built_compact ~= (if self.ctx.compact then 1 else 0) then
		self:_build()
	end
	self:_place()
end

function HelpOverlay._place(self)
	local ctx = self.ctx
	local area = ctx:clear_rect()
	local margin_x = if not ctx.compact then 24.0 else 8.0
	local margin_y = if not ctx.compact then 28.0 else 6.0
	local w = math.min(1080.0, area.Width - margin_x * 2.0)
	local h = math.min(820.0, area.Height - margin_y * 2.0)
	local p = area.Min + (Vector2.new(area.Width, area.Height) - Vector2.new(w, h)) * 0.5
	p = Vector2.new(math.floor(p.X + 0.5), math.floor(p.Y + 0.5))
	self._panel:set_min_size(Vector2.new(w, h))
	self._panel:set_offsets(p.X, p.Y, p.X + w, p.Y + h)
	self._panel:reset_size()
end

function HelpOverlay.open(self)
	if self.is_open then
		return
	end
	self.is_open = true
	self:_build()
	self:_place()
	self:set_visible(true)
	self:set_modulate_a(1.0)
	self._panel:set_modulate_a(1.0)
	self._dim:set_modulate_a(0.0)
	W.fade(self._dim, 1.0, 0.25)
	UICtx.pop_in(self._panel, 0.0, 0.95, 0.35)
	self.ctx:sfx("open")
end

function HelpOverlay.close(self)
	if not self.is_open then
		return
	end
	self.is_open = false
	self.ctx:sfx("close")
	local t = self:create_tween():set_parallel(true)
	t:tween_property(self._dim, "modulate:a", 0.0, 0.2)
	t:tween_property(self._panel, "modulate:a", 0.0, 0.18)
	t:chain():tween_callback(function()
		if not self.is_open then
			self:set_visible(false)
		end
	end)
	self.closed:Fire()
end

function HelpOverlay.scroll_by(self, px: number)
	if self._scroll ~= nil then
		self._scroll:scroll_by(px)
	end
end

return HelpOverlay
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="160">
            <Properties>
              <string name="Name">HoldRing</string>
              <string name="Source"><![CDATA[-- Touch: a ring that closes in around a finger held on the map until the long-press menu opens
-- (2026-09-29: the press-and-hold quick build menu felt inconsistent on phones). It shows that the
-- hold is counting (keep still) and when it will open. Driven each frame by UIRoot from
-- MapInput.hold_state(); drawn on a raw logical-px canvas (UICtx.canvas), input-transparent.
local UICtx = require("./UICtx") :: any

local HoldRing = {}
HoldRing.__index = HoldRing

--- The ring appears once a hold is this far along (a tap never flashes it).
HoldRing.SHOW_FROM = 0.2
HoldRing.SIZE = 58.0 -- logical px, the closed ring's diameter

function HoldRing.new(c: any)
	local self = setmetatable({}, HoldRing)
	self.ctx = c
	local canvas = UICtx.canvas(nil, "HoldRing")
	canvas.Visible = false
	self.gui = canvas
	local ring = UICtx.make("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(HoldRing.SIZE, HoldRing.SIZE),
		ZIndex = 2,
	}, canvas)
	UICtx.make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, ring)
	self._stroke = UICtx.make("UIStroke", {
		Color = Color3.fromRGB(255, 214, 120),
		Thickness = 3,
		Transparency = 1,
	}, ring)
	self._ring = ring
	-- a soft fill that brightens as it closes
	local fill = UICtx.make("Frame", {
		Name = "Fill",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(255, 214, 120),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1,
	}, ring)
	UICtx.make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, fill)
	self._fill = fill
	return self
end

--- pos: the finger (logical px) or nil; k: the hold's progress 0..1.
function HoldRing.set(self: any, pos: Vector2?, k: number)
	if pos == nil or k < HoldRing.SHOW_FROM or k >= 1 then
		if self.gui.Visible then
			self.gui.Visible = false
		end
		return
	end
	if not self.gui.Visible then
		self.ctx:fit_canvas(self.gui)
		self.gui.Visible = true
	end
	local q = (k - HoldRing.SHOW_FROM) / (1 - HoldRing.SHOW_FROM)
	local e = 1 - (1 - q) * (1 - q)
	local d = HoldRing.SIZE * (1.9 - 0.9 * e)
	self._ring.Position = UDim2.fromOffset(pos.X, pos.Y)
	self._ring.Size = UDim2.fromOffset(d, d)
	self._stroke.Transparency = 0.85 - 0.7 * e
	self._stroke.Thickness = 2 + 2 * e
	self._fill.BackgroundTransparency = 0.95 - 0.25 * e
end

return HoldRing
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="161">
            <Properties>
              <string name="Name">HudArt</string>
              <string name="Source"><![CDATA[-- Builds bundled transparent artwork into Roblox images without remote asset IDs.
local HudArt = {}
local images = {}

function HudArt.texture(key)
	local dataModule = script.Parent:WaitForChild("HudArtPixels")
	local row = require(dataModule)[key]
	local editable = images[key]
	if editable == false then return nil, row end
	if editable == nil then
		local ok, result = pcall(function()
			local pieces = table.create(#row.parts)
			for i, name in row.parts do
				pieces[i] = require(dataModule:WaitForChild(name))
			end
			local core = game:GetService("ReplicatedStorage"):WaitForChild("Airfront"):WaitForChild("Core")
			local codec = require(core:WaitForChild("MapCodec"))
			local size = Vector2.new(row.width, row.height)
			local pixels = codec.b64decode_luau(table.concat(pieces))
			assert(buffer.len(pixels) == row.width * row.height * 4, "Invalid HUD image size")
			local texture = game:GetService("AssetService"):CreateEditableImage({ Size = size })
			if texture ~= nil then
				texture:WritePixelsBuffer(Vector2.zero, size, pixels)
			end
			return texture
		end)
		if not ok or result == nil then
			warn("[Shinobi Front] HUD image unavailable: " .. key)
			images[key] = false
			return nil, row
		end
		editable = result
		images[key] = editable
	end
	return editable, row
end

function HudArt.add(parent, key, z)
	local editable, row = HudArt.texture(key)
	if editable == nil then return nil, 0 end
	local label = Instance.new("ImageLabel")
	label.Name = key
	label.BackgroundTransparency = 1
	label.ImageContent = Content.fromObject(editable)
	label.Active = false
	label.Interactable = false
	label.ZIndex = z
	label.Parent = parent
	return label, row.width / row.height
end

function HudArt.corners(parent)
	local layer = Instance.new("Frame")
	layer.Name = "CornerClouds"
	layer.BackgroundTransparency = 1
	layer.Size = UDim2.fromScale(1, 1)
	layer.Interactable = false
	layer.ZIndex = 0
	layer.Parent = parent
	for _, corner in {
		{ "topLeft", 0, 0 }, { "topRight", 1, 0 },
		{ "bottomLeft", 0, 1 }, { "bottomRight", 1, 1 },
	} do
		local img, aspect = HudArt.add(layer, corner[1], 1)
		if img ~= nil then
			img.AnchorPoint = Vector2.new(corner[2], corner[3])
			img.Position = UDim2.fromScale(corner[2], corner[3])
			img.Size = UDim2.fromScale(0.23, 0.2)
			img.ImageTransparency = 0.14
			local constraint = Instance.new("UIAspectRatioConstraint")
			constraint.AspectRatio = aspect
			constraint.DominantAxis = Enum.DominantAxis.Width
			constraint.AspectType = Enum.AspectType.ScaleWithParentSize
			constraint.Parent = img
			local cap = Instance.new("UISizeConstraint")
			cap.MaxSize = Vector2.new(425, 160)
			cap.Parent = img
		end
	end
end

return HudArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="162">
            <Properties>
              <string name="Name">HudArtPixels</string>
              <string name="Source"><![CDATA[-- Transparent RGBA artwork supplied for the title and match HUD.
return {
    symbols = { width = 384, height = 384, parts = { "symbols_1", "symbols_2", "symbols_3", "symbols_4", "symbols_5", "symbols_6", "symbols_7", "symbols_8", "symbols_9" } },
    scroll = { width = 864, height = 190, parts = { "scroll_1", "scroll_2", "scroll_3", "scroll_4", "scroll_5", "scroll_6", "scroll_7", "scroll_8", "scroll_9", "scroll_10" } },
    topLeft = { width = 312, height = 74, parts = { "topLeft_1", "topLeft_2" } },
    topRight = { width = 312, height = 76, parts = { "topRight_1", "topRight_2" } },
    bottomLeft = { width = 312, height = 111, parts = { "bottomLeft_1", "bottomLeft_2", "bottomLeft_3" } },
    bottomRight = { width = 312, height = 118, parts = { "bottomRight_1", "bottomRight_2", "bottomRight_3" } },
    logo = { width = 512, height = 348, parts = { "logo_1", "logo_2", "logo_3", "logo_4", "logo_5", "logo_6", "logo_7", "logo_8", "logo_9", "logo_10", "logo_11" } },
}
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="163">
              <Properties>
                <string name="Name">bottomLeft_1</string>
                <string name="Source">return ""</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="164">
              <Properties>
                <string name="Name">bottomLeft_2</string>
                <string name="Source">return ""</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="165">
              <Properties>
                <string name="Name">bottomLeft_3</string>
                <string name="Source">return ""</string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="166">
