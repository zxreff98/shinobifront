        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">MapFx</string>
            <string name="Source"><![CDATA[-- GENERATED by tools/assets/make_map_fx.py. Do not edit.
-- Rofront's own map effects (pixel art, a pixel a map tile): rows of one atlas, frames left to right.
-- banner: the flag's cloth in white and greys, drawn under `flag` tinted the conqueror's colour.
-- fire, smoke, big_smoke, smoke_fire: the debris a nuke leaves, looping (the last frame runs into the first).
return {
	id = "rbxassetid://125969402823728",
	nuke = { x = 0, y = 0, w = 60, h = 60, frames = 12 },
	flag = { x = 0, y = 60, w = 24, h = 24, frames = 10 },
	banner = { x = 0, y = 84, w = 24, h = 24, frames = 10 },
	sam = { x = 0, y = 108, w = 48, h = 38, frames = 9 },
	building = { x = 0, y = 146, w = 17, h = 15, frames = 10 },
	fire = { x = 0, y = 161, w = 7, h = 13, frames = 6 },
	smoke = { x = 0, y = 174, w = 11, h = 12, frames = 4 },
	big_smoke = { x = 0, y = 186, w = 24, h = 16, frames = 5 },
	smoke_fire = { x = 0, y = 202, w = 24, h = 16, frames = 5 },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">MapSprites</string>
            <string name="Source"><![CDATA[-- GENERATED by tools/assets/make_map_sprites.py — do not edit by hand.
-- The 2D map's sprites, RoWorld's own art: structure plates and glyphs, unit sprites and the
-- status icons over the players' names.
return {
	--- 9 white glyphs of 64 x 64, a column per structure kind (Defs.S_*): City, Port, Factory, Defense
	--- Post, SAM Launcher, Missile Silo, Artillery, Airfield, Railgun
	icons = { id = "rbxassetid://133641248662839", cell = 64, cols = 9 },
	--- structure plates: the same 9 columns x 2 rows (0 whole shape -> rim colour, 1 inset
	--- shape -> fill colour), 112 px cells
	shapes = { id = "rbxassetid://71160094597181", cell = 112, cols = 9 },
	--- `shapes` with its two rows in ONE image (the fill white to grey, the rim a darker grey: one
	--- tint gives both), for a plate of one ImageLabel
	shapes_one = { id = "rbxassetid://114493667084920", cell = 112, cols = 9 },
	--- per structure kind (index kind + 1): the plate's size (x StructureLayer.ICON_SIZE) and the share
	--- of it the glyph spans (icon_fill / shape_scale of the plate)
	shape_scale = { 1, 1, 1.12, 1.1, 1.15, 1.3, 1.2, 1.35, 1.25 },
	icon_fill = { 0.78, 0.74, 0.74, 0.74, 0.8, 0.76, 0.82, 0.8, 0.86 },
	--- unit sprites 13 x 13, 12 columns (transport, trade, warship, atom, hydrogen, mirv, sam, shell,
	--- warhead, train, carriage, carriage_loaded) x 2 rows:
	--- 0 territory colour, 1 border colour
	units = { id = "rbxassetid://109273810501791", cell = 13, cols = 12 },
	--- `units` with both rows in ONE image (territory pixels white, border pixels grey)
	units_one = { id = "rbxassetid://110885235536298", cell = 13, cols = 12 },
	--- status icons, full colour, 256 px cells (pad 16), 3 columns: crown, traitor, disconnected,
	--- alliance, allianceRequest, target, embargo, nukeRed, nukeWhite, allianceFaded, doomsdayClock,
	--- verified
	status = { id = "rbxassetid://96713612537356", cell = 256, cols = 3, pad = 16 },
	--- white 128 px masks of the same glyphs for the interface (UITheme.icon names; they take the
	--- place of Assets/UiIcons' and ArsenalArt.ui's for these keys)
	ui = {
		city = "rbxassetid://87231117419360",
		port = "rbxassetid://95035713905738",
		factory = "rbxassetid://133968282899567",
		defense = "rbxassetid://105328690138999",
		sam = "rbxassetid://121184602615632",
		silo = "rbxassetid://93768208808207",
		artillery = "rbxassetid://86334393988502",
		airfield = "rbxassetid://135560915268137",
		railgun = "rbxassetid://70667309006887",
		warship = "rbxassetid://93540822426797",
		atom = "rbxassetid://137002846499250",
		hydrogen = "rbxassetid://71488611908523",
		mirv = "rbxassetid://136042443998636",
		boat = "rbxassetid://127144656838563",
	},
}
]]></string>
          </Properties>
        </Item>
